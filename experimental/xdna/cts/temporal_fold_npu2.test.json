{
  "version": 1,
  "cases": [
    {
      "name": "wide temporal fold first-copy preserves negative-zero bits across ring wrap and CFG exits on NPU2",
      "steps": [
        {
          "name": "fixtures",
          "run": {"tool": "generate-cases", "args": ["first-copy", "{tmp}/fixtures"]}
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/testdata/temporal_fold.loom",
              "--root=@temporal_fold_first_copy",
              "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
              "--output={tmp}/fold.xdna"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-xdna-run",
            "args": [
              "--image={tmp}/fold.xdna",
              "--columns=1",
              "--entry=temporal_fold_first_copy",
              "--invocation_count=3",
              "--binding_memory=system",
              "--binding={tmp}/fixtures/input.bin",
              "--binding={tmp}/fixtures/output.bin",
              "--output=0={tmp}/input-readback.bin",
              "--output=1={tmp}/output-readback.bin"
            ]
          },
          "files": [
            {"path": "{tmp}/input-readback.bin", "equals": "{tmp}/fixtures/input.bin"},
            {"path": "{tmp}/output-readback.bin", "equals": "{tmp}/fixtures/expected.bin"}
          ]
        }
      ]
    },
