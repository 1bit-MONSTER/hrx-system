load("//experimental/xdna:build_defs.bzl", "xdna_cc_library", "xdna_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

xdna_cc_library(
    name = "execution_fixture",
    testonly = True,
    hdrs = ["execution_fixture.h"],
    deps = [
        "//experimental/xdna:direct_binding",
        "//libamdf:headers",
        "//libamdf/cts/xdna:xdna_device_fixture",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:shm",
        "//runtime/src/iree/base/internal:span",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/xdna:executable_storage",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/aie2p:npu2",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testing:image_fixture",
        "//runtime/src/iree/testing:gtest",
    ],
)

[
    xdna_cc_test(
        name = "execution_test" + suffix,
        srcs = ["execution_test.cc"],
        args = ["--amdf_native_lifetime=" + lifetime],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "@platforms//os:windows": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            ":execution_fixture",
            "//libamdf:headers",
            "//libamdf/cts/util:device_cache",
            "//libamdf/cts/util:linked_test_main",
            "//runtime/src/iree/base",
            "//runtime/src/iree/testing:gtest",
        ],
    )
    for lifetime, suffix in [
        ("process", ""),
        ("instance", "_instance"),
    ]
]

[
    xdna_cc_test(
        name = "shared_mapping_process_test" + suffix,
        srcs = ["shared_mapping_process_test.cc"],
        args = ["--amdf_native_lifetime=" + lifetime],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "@platforms//os:windows": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            ":execution_fixture",
            "//libamdf:headers",
            "//libamdf/cts/util:device_cache",
            "//libamdf/cts/util:provider_headers",
            "//libamdf/cts/util:static_provider",
            "//runtime/src/iree/async",
            "//runtime/src/iree/async:platform",
            "//runtime/src/iree/async/util:local_stream",
            "//runtime/src/iree/base",
            "//runtime/src/iree/base/internal:shm",
            "//runtime/src/iree/testing:coordinated_test",
            "//runtime/src/iree/testing:coordinated_test_main",
            "//runtime/src/iree/testing:gtest",
        ],
    )
    for lifetime, suffix in [
        ("process", ""),
        ("instance", "_instance"),
    ]
]
