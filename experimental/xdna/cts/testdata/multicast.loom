// Logical shifts and word operations implement modulo-2^32 xorshift state.
// The 64..4096 input-dependent transitions contribute to every output word.
// LSHL with a negative shift count is a logical right shift.
low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume_record() asm {
  %a = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %b = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %zero = mov.short 0
  %one = mov.short 1
  %word_bytes = mov.short 4
  %record_bytes = mov.short 64
  %count_mask = mov.short 63
  %count_shift = mov.short 6
  %left13 = mov.short 13
  %right17 = mov.short -17
  %left5 = mov.short 5
  %a_count = lda %a, 0
  %b_count = lda %b, 0
  %mixed_count = xor %a_count, %b_count
  %bounded_count = and %mixed_count, %count_mask
  %positive_count = add.rr %bounded_count, %one
  %iterations = lshl %positive_count, %count_shift
  %a_seed = lda %a, 4
  %b_seed = lda %b, 4
  %seed = xor %a_seed, %b_seed
  low.br ^work(%zero: reg<aie2p.er>, %seed: reg<aie2p.er>)
^work(%iteration: reg<aie2p.er>, %state: reg<aie2p.er>):
  %remaining = lt %iteration, %iterations
  low.cond_br %remaining, ^transition, ^write_begin : reg<aie2p.er>
^transition:
  %shift13 = lshl %state, %left13
  %first = xor %state, %shift13
  %shift17 = lshl %first, %right17
  %second = xor %first, %shift17
  %shift5 = lshl %second, %left5
  %next_state = xor %second, %shift5
  %next_iteration = add.rr %iteration, %one
  low.br ^work(%next_iteration: reg<aie2p.er>, %next_state: reg<aie2p.er>)
^write_begin:
  low.br ^write(%zero: reg<aie2p.er>)
^write(%position: reg<aie2p.er>):
  %more_words = lt %position, %record_bytes
  low.cond_br %more_words, ^write_word, ^done : reg<aie2p.er>
^write_word:
  %index = mov.address-index %position
  %a_word = lda.i32.index %a, %index
  %b_word = lda.i32.index %b, %index
  %sum = add.rr %a_word, %b_word
  %result = xor %sum, %state
  st.i32.index %result, %output, %index
  %next_position = add.rr %position, %word_bytes
  low.br ^write(%next_position: reg<aie2p.er>)
^done:
  return
}
