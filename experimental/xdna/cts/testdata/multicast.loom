// Eight A streams feed pairs of consumers; two distinct B streams each feed
// eight consumers. Receiver rings retain independent capacities and credits.
low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @multicast_packets() asm {
  %worker_count = constant.u32 16 : reg<aie2p.array.scalar : index>
