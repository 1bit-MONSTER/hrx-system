{
  "version": 1,
  "cases": [
    {
      "name": "DMA wrap admission and exact native transfers across all tile families",
      "steps": [
        {
          "name": "enumerate",
          "run": {
            "tool": "amdf-enumerate"
          },
          "stdout": {
            "save": "{tmp}/inventory.txt"
          }
        },
        {
          "name": "check-geometry",
          "run": {
            "tool": "check-geometry",
            "args": [
              "--compiler={tool:loom-compile}",
              "--runner={tool:iree-xdna-run}",
              "--inventory={tmp}/inventory.txt",
              "--directory={tmp}/geometry"
            ]
          }
        }
      ]
    }
  ]
}
