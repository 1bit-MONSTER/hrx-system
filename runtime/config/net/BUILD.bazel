load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# Native registration and queue resources do not require a host carrier.
bool_flag(
    name = "rdma",
    build_setting_default = False,
)

config_setting(
    name = "rdma_enabled",
    flag_values = {":rdma": "true"},
)
