load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_cmake_extra_content(
    content = "set(IREE_CXX_STANDARD 20)",
)

iree_runtime_cc_test(
    name = "memory_reservation_test",
    srcs = ["memory_reservation_test.cc"],
    cxxopts = select({
        "@platforms//os:windows": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    features = select({
        "@platforms//os:windows": ["-default_cpp_std"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libamdf:amdf_static",
        "//libamdf:headers",
        "//libamdf/cts/gpu/sdma/encoding:commands",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/drivers/amd/fabric",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory_backend",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/hal/memory:host_memory_backend",
        "//runtime/src/iree/hal/memory:tlsf_pool",
        "//runtime/src/iree/hal/testing:mock_device",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
