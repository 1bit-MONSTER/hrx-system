load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

RDMA_COMPATIBILITY = ["@platforms//os:linux"] + select({
    "//runtime/config/net:rdma_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_BACKEND_DEPS = [
    "//runtime/src/iree/async",
    "//runtime/src/iree/base",
    "//runtime/src/iree/net/carrier/rdma:factory",
    "//runtime/src/iree/net/cts:transport_backend",
    "//runtime/src/iree/net/rdma:context",
    "//runtime/src/iree/net/rdma:region",
    "//runtime/src/iree/net/rdma:test_context",
]

iree_runtime_cc_library(
    name = "backend",
    testonly = True,
    srcs = ["backend.cc"],
    target_compatible_with = RDMA_COMPATIBILITY,
    deps = _BACKEND_DEPS,
    alwayslink = True,
)

iree_runtime_cc_library(
    name = "backend_unbatched",
    testonly = True,
    srcs = ["backend.cc"],
    defines = ["IREE_NET_RDMA_CTS_POST_BATCH_SIZE=1"],
    target_compatible_with = RDMA_COMPATIBILITY,
    deps = _BACKEND_DEPS,
    alwayslink = True,
)

iree_runtime_cc_library(
    name = "backend_segmented",
    testonly = True,
    srcs = ["backend.cc"],
    defines = ["IREE_NET_RDMA_CTS_MAX_REQUEST_LENGTH=257"],
    target_compatible_with = RDMA_COMPATIBILITY,
    deps = _BACKEND_DEPS,
    alwayslink = True,
)

