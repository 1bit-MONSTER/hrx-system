load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "backend",
    testonly = True,
    srcs = ["backend.cc"],
    deps = [
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
    alwayslink = True,
)

iree_runtime_cc_test(
    name = "collective_trial_tests",
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/async/cts/util:test_main",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:collective_trial_tests",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_test(
    name = "collective_trial_stress_tests",
    tags = [
        "manual",
        "stress",
    ],
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/async/cts/util:test_main",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:collective_trial_stress_tests",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_test(
    name = "transfer_trial_tests",
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/async/cts/util:test_main",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:transfer_trial_tests",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_test(
    name = "transport_tests",
    deps = [
        ":backend",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:transport_backend",
        "//runtime/src/iree/net/cts:transport_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "collective_benchmarks",
    args = ["--benchmark_filter=^(TensorAllReduce/.*/ranks:2/tensor_bytes:8192/block_bytes:4096/window:1/rounds:32/|Pipeline/.*/stages:2/activation_bytes:8192/block_bytes:4096/window:1/microbatches:32/depth:1/)"],
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:benchmark_main",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:collective_benchmarks",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_benchmark(
    name = "expert_benchmarks",
    args = ["--benchmark_filter=^ExpertRoundTrip/.*/ranks:4/tokens:1/"],
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:benchmark_main",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:expert_benchmarks",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_benchmark(
    name = "gather_benchmarks",
    args = ["--benchmark_filter=^RetainedGather/.*/ranks:2/shard_bytes:8192/block_bytes:4096/window:1/depth:1/gathers:16/"],
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:benchmark_main",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:gather_benchmarks",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_benchmark(
    name = "pipeline_round_trip_benchmarks",
    args = ["--benchmark_filter=^BidirectionalPipeline/.*/stages:2/activation_bytes:8192/gradient_bytes:4096/block_bytes:4096/window:1/depth:1/microbatches:16/"],
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:benchmark_main",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:pipeline_round_trip_benchmarks",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_benchmark(
    name = "transfer_benchmarks",
    args = ["--benchmark_filter=^CheckedTransfer/.*/peers:1/bytes:64/batch:32/window:128/sg:1/records:2048/"],
    deps = [
        ":backend",
        "//runtime/src/iree/async/cts/util:benchmark_main",
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:transfer_benchmarks",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
)

iree_runtime_cc_test(
    name = "receive_tests",
    deps = [
        ":backend",
        "//runtime/src/iree/net/cts:receive_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "placement_backend",
    testonly = True,
    srcs = ["backend.cc"],
    defines = ["IREE_NET_CTS_TCP_RECEIVE_PLACEMENT=1"],
    deps = [
        "//runtime/src/iree/net/carrier/tcp:connection",
        "//runtime/src/iree/net/carrier/tcp:factory",
        "//runtime/src/iree/net/cts:transport_backend",
    ],
    alwayslink = True,
)

iree_runtime_cc_test(
    name = "receive_placement_tests",
    deps = [
        ":placement_backend",
        "//runtime/src/iree/net/cts:receive_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "transport_placement_tests",
    deps = [
        ":placement_backend",
        "//runtime/src/iree/net/cts:transport_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
