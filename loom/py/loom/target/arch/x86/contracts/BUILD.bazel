load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "contracts",
    srcs = [
        "__init__.py",
        "avx2.py",
        "avx512.py",
        "float_narrowing.py",
        "floating_reduction.py",
        "integer_division.py",
        "memory.py",
        "packed_dot.py",
        "scalar.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/buffer",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/scf",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/target/arch/x86:descriptors",
        "//loom/py/loom/target/contracts",
        "//loom/py/loom/target/emit:float_narrowing",
    ],
)

iree_py_test(
    name = "float_narrowing_test",
    srcs = [
        "float_narrowing_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.x86.contracts.float_narrowing_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":contracts",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/target/arch/x86:descriptors",
        "//loom/py/loom/target/contracts",
    ],
)
