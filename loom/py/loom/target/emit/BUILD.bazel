load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "package",
    srcs = ["__init__.py"],
    deps = ["//loom/py/loom/target:package"],
)

iree_py_library(
    name = "float_narrowing",
    srcs = ["float_narrowing.py"],
    deps = [
        "//loom/py/loom/target:low_descriptors",
        "//loom/py/loom/target/contracts",
    ],
)

iree_py_test(
    name = "float_narrowing_test",
    srcs = [
        "float_narrowing_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.emit.float_narrowing_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":float_narrowing",
        "//loom/py/loom/target:low_descriptors",
    ],
)
