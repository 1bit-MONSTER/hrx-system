// Independent commutative updates can retire in either order. The ready
// update fills the producer's latency instead of waiting for the first update.
// RUN: with-checks emit low-schedule-json @ready_update strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @ready_update(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %slow = test.event.slow.i32 %lhs, %rhs
  %first = test.state.update.i32 %slow
  %ready = test.state.update.i32 %lhs
  return %first, %ready
}

// ----
CHECK: *"scheduled_node_indices":[*2,*1,3],*
CHECK-NOT: *"kind":"state"*

// ====

// A certified assignment affects only its own class, even though its generic
// trait is UNKNOWN_EFFECTS. The independent update class remains commutative.
// RUN: with-checks emit low-schedule-json @independent_assignment strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_assignment(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.schedule_state.update.i32 %value
  test.state.assign.i32.immediate 12
  %second = test.schedule_state.update.i32 %value
  return %first, %second
}

// ----
CHECK: *"node_count":4,*
CHECK-NOT: *"kind":"state"*

// ====

// Ordinary readers do not serialize each other when there are no writers.
// RUN: with-checks emit low-schedule-json @read_only_state strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @read_only_state(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.read.i32 %value
  %second = test.state.read.i32 %value
  return %first, %second
}

// ----
CHECK: *"node_count":3,*
CHECK-NOT: *"kind":"state"*

// ====

// The first writer retires the reader list. Its WAW edge must still prevent
// the second update from moving before the original observation.
// RUN: with-checks emit low-schedule-json @reader_before_updates strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reader_before_updates(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %observed = test.state.read.i32 %value
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  return %observed, %first, %second
}

// ----
CHECK: *"from":0,"to":1,"kind":"state",*
CHECK: *"from":1,"to":2,"kind":"state",*

// ====

// RUN: with-checks emit low-schedule-json @reader_between_updates strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reader_between_updates(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %observed = test.state.read.i32 %value
  %second = test.state.update.i32 %value
  return %observed, %first, %second
}

// ----
CHECK: *"from":0,"to":1,"kind":"state",*
CHECK: *"from":0,"to":2,"kind":"state",*
CHECK: *"from":1,"to":2,"kind":"state",*

// ====

// The final reader depends on the last source writer, so all earlier updates
// must remain connected to that writer.
// RUN: with-checks emit low-schedule-json @reader_after_updates strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reader_after_updates(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  %observed = test.state.read.i32 %value
  return %observed, %first, %second
}

// ----
CHECK: *"from":0,"to":1,"kind":"state",*
CHECK: *"from":1,"to":2,"kind":"state",*

// ====

// Replacement is not a commutative update to the same state.
// RUN: with-checks emit low-schedule-json @replacement_between_updates strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @replacement_between_updates(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  test.state.assign.i32.immediate 0
  %second = test.state.update.i32 %value
  return %first, %second
}

// ----
CHECK: *"from":0,"to":1,"kind":"state",*
CHECK: *"from":1,"to":2,"kind":"state",*

// ====

// Structural operands observe architectural state even without descriptor
// STATE_READ rows. The ordinary-data snapshot survives subsequent updates.
// RUN: with-checks emit low-schedule-json @explicit_state_operand strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @explicit_state_operand(%state: reg<test.special>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %snapshot = copy %state : reg<test.special> -> reg<test.i32>
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  return %snapshot, %first, %second
}

// ----
CHECK: *"from":0,"to":1,"kind":"state",*
CHECK: *"from":1,"to":2,"kind":"state",*

// ====

// An explicit state result denotes a particular snapshot rather than only an
// implicit accumulated effect, so its class keeps source-order writes.
// RUN: with-checks emit low-schedule-json @explicit_state_result strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @explicit_state_result(%state_lhs: reg<test.schedule_state>, %state_rhs: reg<test.schedule_state>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %snapshot = test.add.schedule_state %state_lhs, %state_rhs
  %first = test.schedule_state.update.i32 %value
  %second = test.schedule_state.update.i32 %value
  return %first, %second
}

// ----
CHECK: *"from":1,"to":2,"kind":"state",*

// ====

// An opaque descriptor does not promise complete architectural-state effects.
// RUN: with-checks emit low-schedule-json @opaque_descriptor strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @opaque_descriptor(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %effect = test.projectable_effect.i32 %value
  %second = test.state.update.i32 %value
  return %first, %effect, %second
}

// ----
CHECK: *"from":0,"to":2,"kind":"state",*

// ====

// Call purity does not promise preservation of architectural configuration.
// RUN: with-checks emit low-schedule-json @pure_call_boundary strategy=resource-stall
test.target<low_core> @target

low.func.decl pure target<test.low.core>(@target) @helper()

low.func.def target<test.low.core>(@target) @pure_call_boundary(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  low.func.call pure @helper() : ()
  %second = test.state.update.i32 %value
  return %first, %second
}

// ----
CHECK: *"from":0,"to":2,"kind":"state",*

// ====

// RUN: with-checks emit low-schedule-json @unknown_call_boundary strategy=resource-stall
test.target<low_core> @target

low.func.decl target<test.low.core>(@target) @helper()

low.func.def target<test.low.core>(@target) @unknown_call_boundary(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  low.func.call @helper() : ()
  %second = test.state.update.i32 %value
  return %first, %second
}

// ----
CHECK: *"from":0,"to":2,"kind":"state",*

// ====

// RUN: with-checks emit low-schedule-json @convergent_boundary strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @convergent_boundary(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %participating = test.convergent.i32 %value
  %second = test.state.update.i32 %value
  return %first, %participating, %second
}

// ----
CHECK: *"from":0,"to":2,"kind":"state",*

// ====

// A local block index does not inspect the effects of nested regions.
// RUN: with-checks emit low-schedule-json @nested_region_boundary strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @nested_region_boundary(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  low.scf.if %condition {
    test.state.assign.i32.immediate 0
  } else {
    test.state.assign.i32.immediate 1
  }
  %second = test.state.update.i32 %value
  return %first, %second
}

// ----
CHECK: *"from":0,"to":2,"kind":"state",*

// ====

// A scheduling fence still partitions source ranges without inventing state
// observations or restoring an otherwise unnecessary WAW edge.
// RUN: with-checks emit low-schedule-json @fenced_updates strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fenced_updates(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %slow = test.event.slow.i32 %lhs, %rhs
  %first = test.state.update.i32 %slow
  low.schedule.fence
  %ready = test.state.update.i32 %lhs
  return %first, %ready
}

// ----
CHECK: *"source_order_boundaries":[2,4],*
CHECK: *"scheduled_node_indices":[0,1,2,3,4],*
CHECK-NOT: *"kind":"state"*

// ====

// RUN: with-checks emit low-schedule-json @locked_updates strategy=resource-stall
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @locked_updates(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %slow = test.event.slow.i32 %lhs, %rhs
  %first = test.state.update.i32 %slow
  %ready = test.state.update.i32 %lhs
  return %first, %ready
}

// ----
CHECK: *"source_order_boundaries":[0,1,2,3],*
CHECK: *"scheduled_node_indices":[0,1,2,3],*
CHECK-NOT: *"kind":"state"*

// ====

// A reader in the predecessor block does not inhibit later-block commutation.
// The later block still begins after the existing control boundary.
// RUN: with-checks emit low-schedule-json @block_local_observations strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @block_local_observations(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %observed = test.state.read.i32 %lhs
  %before0 = test.state.update.i32 %lhs
  %before1 = test.state.update.i32 %rhs
  low.br ^next
^next:
  %slow = test.event.slow.i32 %lhs, %rhs
  %after0 = test.state.update.i32 %slow
  %after1 = test.state.update.i32 %lhs
  return %observed, %before0, %before1, %after0, %after1
}

// ----
CHECK: *"from":1,"to":2,"kind":"state",*
CHECK: *"scheduled_node_indices":[0,1,2,3,*6,*5,7],*
CHECK-NOT: *"from":5,"to":6,"kind":"state",*

// ====

// Explicit state carried across a block with updates cannot preserve its old
// value. The existing state-clobber diagnostic still owns this rejection.
// RUN: emit low-schedule-json @state_live_out_clobber output=none
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_live_out_clobber(%state: reg<test.special>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  low.br ^updates
^updates:
  // ERROR@+1: BACKEND/048 {value_name="state", clobber_packet="test.state.update.i32"}
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  low.br ^observe
^observe:
  %snapshot = copy %state : reg<test.special> -> reg<test.i32>
  return %snapshot, %first, %second
}
