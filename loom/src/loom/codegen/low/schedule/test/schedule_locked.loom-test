// ====

// RUN: emit low-schedule-query @locked_kernel_cfg strategy=resource-stall order=0,1,2,4,5

test.target<low_core> @target

// Both blocks retain their own authored order, including structural transport.
low.kernel.def schedule(locked) target<test.low.core>(@target) @locked_kernel_cfg(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) asm {
  %loaded = test.load.v4i32 %pointer
  %used = test.add.v4i32 %loaded, %loaded
  %independent = test.add.i32 %lhs, %rhs
  low.br ^exit(%used: reg<test.i32 x4>, %independent: reg<test.i32>)
^exit(%value: reg<test.i32 x4>, %offset: reg<test.i32>):
  %product = test.mul.i32 %offset, %lhs
  %wide_sum = test.add.v4i32 %value, %value
  return
}

// ----
block 0 order: 0, 1, 2
block 1 order: 4, 5
