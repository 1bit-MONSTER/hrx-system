// RUN: emit low-schedule-query @independent_scopes kind=order strategy=resource-stall consumer=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_scopes(%pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32 x4>) asm {
  low.schedule.begin
  %first = test.load.v4i32 %pointer
  low.schedule.phase
  %first_sum = test.add.v4i32 %first, %first
  low.schedule.end
  low.schedule.begin
  %second = test.load.v4i32 %pointer
  low.schedule.phase
  %second_sum = test.add.v4i32 %second, %second
  low.schedule.end
  return %first_sum, %second_sum
}

// ----
node 1 <- 0
node 2 <- 0, 1
node 3 <- 2
node 4 <- 2, 3
node 6 <- 5
node 7 <- 5, 6
node 8 <- 7
node 9 <- 7, 8

// ====
// RUN: emit low-schedule-query @nested_scopes kind=order strategy=resource-stall consumer=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @nested_scopes(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.schedule.begin
  low.schedule.phase
  low.schedule.begin
  %sum = test.add.i32 %lhs, %rhs
  low.schedule.phase
  low.schedule.end
  low.schedule.phase
  %product = test.mul.i32 %lhs, %rhs
  low.schedule.end
  return %sum, %product
}

// ----
node 1 <- 0
node 2 <- 1
node 3 <- 2
node 4 <- 2, 3
node 5 <- 1, 4
node 6 <- 1, 5
node 7 <- 6
node 8 <- 6, 7

// ====
// RUN: emit low-schedule-query @scope_across_cfg kind=order strategy=resource-stall consumer=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @scope_across_cfg(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  low.schedule.begin
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  low.schedule.phase
  %sum = test.add.i32 %lhs, %rhs
  low.br ^join(%sum: reg<test.i32>)
^right:
  %product = test.mul.i32 %lhs, %rhs
  low.schedule.phase
  low.br ^join(%product: reg<test.i32>)
^join(%result: reg<test.i32>):
  low.schedule.end
  return %result
}

// ----
node 1 <- 0
node 3 <- 2
node 4 <- 2
node 6 <- 5
node 7 <- 6

// ====
// RUN: verify

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @step_without_scope() asm {
  // ERROR@+1: STRUCTURE/054 {reason_key="outside-scope"}
  low.schedule.phase
  return
}

// ====
// RUN: verify

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @unclosed_scope() asm {
  low.schedule.begin
  // ERROR@+1: STRUCTURE/054 {reason_key="unclosed-scope"}
  return
}

// ====
// RUN: emit low-schedule-query @function_phases kind=order strategy=resource-stall consumer=*

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @function_phases(%pointer: reg<test.ptr>) -> (reg<test.i32 x4>) asm {
  %first = test.load.v4i32 %pointer
  %sum = test.add.v4i32 %first, %first
  low.schedule.phase
  %second = test.load.v4i32 %pointer
  %result = test.add.v4i32 %sum, %second
  return %result
}

