// ====

// Required scratch setup must not displace wider private arithmetic that its
// consumer still needs. EXEC readers also precede the restore, so their extra
// dependency prevents the single-successor setup order from serializing them.
// RUN: emit low-schedule-query @private_arithmetic strategy=resource-stall amdgpu.vgpr=4 required-register-values=%address per-user-placement-values=%left,%right order=* scheduled-pressure=amdgpu.vgpr

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @private_arithmetic(%input: reg<amdgpu.vgpr x2>, %held: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %saved_exec = s_mov_b64_exec_read
  %storage = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  %left = v_mul_f64 %input, %input
  %right = v_mul_f64 %input, %held
  %address = storage_address %storage : low.storage<private> -> reg<amdgpu.vgpr>
  %sum = v_add_f64 %left, %right
  scratch_store_b64_vaddr %address, %sum
  s_mov_b64_exec %saved_exec
  return %input, %held
}

// ----
block 0 order: 0, 1, 2, 3, 5, 4, 6, 7, 8
scheduled pressure amdgpu.vgpr: peak-live-units=8 peak-live-values=4

// ====

// Private setup can need two leaves before either makes a consumer ready.
// Both fit while the singleton transaction is pinned. Finish that transaction
// before unrelated arithmetic instead of deferring every non-killing leaf.
// RUN: emit low-schedule-query @private_completion_leaves strategy=resource-stall per-user-placement-values=%left,%right order=0,1,2,3,4,5,6,7,8

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @private_completion_leaves(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %fixed = copy %condition : reg<test.i32> -> reg<test.fixed.r0>
  low.schedule.fence
  %unrelated = test.add.i32 %lhs, %rhs
  %left = test.const.i32 1
  %right = test.const.i32 2
  %delta = test.add.i32 %left, %right
  %updated = test.fixed.update.i32 %fixed, %delta
  %result = copy %updated : reg<test.fixed.r0> -> reg<test.i32>
  return %result, %unrelated
}

