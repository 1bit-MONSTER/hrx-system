// RUN: emit low-allocation-query @fixed_concat_sources spill-count values=%first,%second,%third,%fourth,%tuple fixed=%first:physical_register:0:1 fixed=%second:physical_register:2:1 fixed=%third:physical_register:1:1 fixed=%fourth:physical_register:4:1

test.target<low_core> @target

// Fixed sources whose physical order differs from their tuple order cannot be
// exempted from a speculative result reservation. The tuple instead receives
// independent storage while its retained sources keep their required locations.
low.func.def target<test.low.core>(@target) @fixed_concat_sources(%first: reg<test.phys>, %second: reg<test.phys>, %third: reg<test.phys>, %fourth: reg<test.phys>) -> (reg<test.phys x4>, reg<test.phys>, reg<test.phys>) asm {
  %tuple = concat(%first, %second, %third, %fourth) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  return %tuple, %second, %third
}

