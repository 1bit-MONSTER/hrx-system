test.target<low_core> @target

// A destructive consumer cannot overwrite a source retained after the tuple.
low.func.def target<test.low.core>(@target) @partial_concat_preserves_tied_source(%low: reg<test.i32 x2>, %high: reg<test.i32 x2>) -> (reg<test.i32 x4>, reg<test.i32 x2>) asm {
  %tuple = concat(%low, %high) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %result = test.early_tied.v4i32 %tuple
  return %result, %low
}

