// RUN: emit low-allocation-json @copy_input_at_early_tie

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @copy_input_at_early_tie(%source: reg<test.i32 x8>) -> (reg<test.i32 x8>) asm {
  %copy = copy %source : reg<test.i32 x8> -> reg<test.i32 x8>
  %result = test.accumulate.v8i32 %source, %source, %copy
  return %result
}

