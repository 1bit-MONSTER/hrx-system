// ====

// A nested concat preserves a live component at its first packing boundary.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%low: reg<test.i32>, %next: reg<test.i32>, %high: reg<test.i32 x2>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %pair = concat(%low, %next) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %tuple = concat(%pair, %high) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %result = test.early_tied.v4i32 %tuple
  return %result, %low
}

