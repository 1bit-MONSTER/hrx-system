// ====

// Slicing retains the original low units after the packed value is consumed.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%source: reg<test.i32 x4>, %tail: reg<test.i32 x2>) -> (reg<test.i32 x4>, reg<test.i32 x2>) asm {
  %part = slice %source[0] : reg<test.i32 x4> -> reg<test.i32 x2>
  %tuple = concat(%part, %tail) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %result = test.early_tied.v4i32 %tuple
  %preserved = slice %source[0] : reg<test.i32 x4> -> reg<test.i32 x2>
  return %result, %preserved
}

