// ====

// An identity between packing and consumption preserves the same obligation.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%low: reg<test.i32 x2>, %high: reg<test.i32 x2>) -> (reg<test.i32 x4>, reg<test.i32 x2>) asm {
  %tuple = concat(%low, %high) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %alias = low.assume %tuple [range(%tuple, 0, 1024)] : reg<test.i32 x4>
  %result = test.early_tied.v4i32 %alias
  return %result, %high
}

