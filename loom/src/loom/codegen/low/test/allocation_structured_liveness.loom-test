// RUN: with-checks emit low-allocation @if_live_out diagnostics=placement-decisions

test.target<low_core> @target

// A yield does not consume an external value needed after the enclosing if.
low.func.def target<test.low.core>(@target) @if_live_out(%condition: reg<test.i32>, %captured: reg<test.i32>, %alternate: reg<test.i32>) -> (reg<test.i32>) asm {
  %chosen = low.scf.if %condition -> (reg<test.i32>) {
    // REMARK@+1: BACKEND/043 {source_value_name="captured", result_value_name="chosen", decision="rejected"}
    low.scf.yield %captured : reg<test.i32>
  } else {
    // REMARK@+1: BACKEND/043 {source_value_name="alternate", result_value_name="chosen", decision="accepted"}
    low.scf.yield %alternate : reg<test.i32>
  }
  %result = test.add.i32 %chosen, %captured
  return %result
}

// ----
CHECK: spills: 0

// ====

// RUN: with-checks emit low-allocation @while_capture diagnostics=placement-decisions

test.target<low_core> @target

// The before region's capture must survive both regions and the backedge.
low.func.def target<test.low.core>(@target) @while_capture(%condition: reg<test.i32>, %captured: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="seed", result_value_name="before", decision="accepted"}
  %result = low.scf.while(%before = %seed : reg<test.i32>) -> (reg<test.i32>) {
    %chosen = low.scf.if %condition -> (reg<test.i32>) {
      // REMARK@+1: BACKEND/043 {source_value_name="captured", result_value_name="chosen", decision="rejected"}
      low.scf.yield %captured : reg<test.i32>
    } else {
      // REMARK@+1: BACKEND/043 {source_value_name="before", result_value_name="chosen", decision="accepted"}
      low.scf.yield %before : reg<test.i32>
    }
    // REMARK@+2: BACKEND/043 {source_value_name="chosen", result_value_name="body", decision="accepted"}
    // REMARK@+1: BACKEND/043 {source_value_name="chosen", result_value_name="result", decision="accepted"}
    low.scf.condition %condition, %chosen : reg<test.i32>, reg<test.i32>
  } do(%body: reg<test.i32>) {
    // REMARK@+1: BACKEND/043 {source_value_name="body", result_value_name="before", decision="accepted"}
    low.scf.yield %body : reg<test.i32>
  }
  return %result
}

// ----
CHECK: spills: 0

// ====

// RUN: with-checks emit low-allocation @while_condition_capture diagnostics=placement-decisions

test.target<low_core> @target

// Forwarding an invariant through condition must not let the after region
// overwrite it before the next condition evaluation. The unused before-region
// argument requires no placement relation or storage.
low.func.def target<test.low.core>(@target) @while_condition_capture(%condition: reg<test.i32>, %captured: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.while(%before = %seed : reg<test.i32>) -> (reg<test.i32>) {
    // REMARK@+2: BACKEND/043 {source_value_name="captured", result_value_name="body", decision="rejected"}
    // REMARK@+1: BACKEND/043 {source_value_name="captured", result_value_name="result", decision="rejected"}
    low.scf.condition %condition, %captured : reg<test.i32>, reg<test.i32>
  } do(%body: reg<test.i32>) {
    low.scf.yield %body : reg<test.i32>
  }
  return %result
}

// ----
CHECK: spills: 0
