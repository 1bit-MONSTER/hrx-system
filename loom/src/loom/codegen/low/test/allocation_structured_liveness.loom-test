// RUN: with-checks emit low-allocation @counter_survives_yield diagnostics=placement-decisions

test.target<low_core> @target

// The implicit increment still reads the counter after the nested branch.
// The carried state can still share storage with the branch result.
low.func.def target<test.low.core>(@target) @counter_survives_yield(%lo: reg<test.i32>, %hi: reg<test.i32>, %step: reg<test.i32>, %condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="seed", result_value_name="state", decision="accepted"}
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%seed: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %state: reg<test.i32>) {
    %chosen = low.scf.if %condition -> (reg<test.i32>) {
      // REMARK@+1: BACKEND/043 {source_value_name="iv", result_value_name="chosen", decision="rejected"}
      low.scf.yield %iv : reg<test.i32>
    } else {
      // REMARK@+1: BACKEND/043 {source_value_name="state", result_value_name="chosen", decision="accepted"}
      low.scf.yield %state : reg<test.i32>
    }
    // REMARK@+2: BACKEND/043 {source_value_name="chosen", result_value_name="state", decision="accepted"}
    // REMARK@+1: BACKEND/043 {source_value_name="chosen", result_value_name="result", decision="accepted"}
    low.scf.yield %chosen : reg<test.i32>
  }
  return %result
}

// ----
CHECK: spills: 0

// ====

// RUN: emit low-allocation-json @type_reference_preserves_edge_source fixed=%source:target_id:0:1 fixed=%packed:target_id:1:1 fixed=%clobber:target_id:1:1 output=none

test.target<low_core> @target

low.func.decl target<test.low.core>(@target) @make_dependent(%width: reg<test.i32 : index>) -> (reg<test.i32 : vector<[%width]xf32>>)

low.func.decl target<test.low.core>(@target) @consume_dependent(%width: reg<test.i32 : index>, %value: reg<test.i32 : vector<[%width]xf32>>)

low.func.def target<test.low.core>(@target) @type_reference_preserves_edge_source(%source: reg<test.i32 : index>) -> (reg<test.i32>) asm {
  // ERROR@+1: BACKEND/050 {value_name="packed", location_kind="target_id", location_base="1", location_count="1"}
  %packed = concat(%source) : (reg<test.i32 : index>) -> reg<test.i32 : index>
  %dependent = low.func.call @make_dependent(%packed) : (reg<test.i32 : index>) -> (reg<test.i32 : vector<[%packed]xf32>>)
  %clobber = test.const.i32 3
  low.br ^join(%packed: reg<test.i32 : index>, %dependent: reg<test.i32 : vector<[%packed]xf32>>)
^join(%width: reg<test.i32 : index>, %value: reg<test.i32 : vector<[%width]xf32>>):
  low.func.call @consume_dependent(%width, %value) : (reg<test.i32 : index>, reg<test.i32 : vector<[%width]xf32>>)
  return %clobber
}

// ====

// RUN: with-checks emit low-allocation @upper_survives_yield diagnostics=placement-decisions

test.target<low_core> @target

// The upper bound is read again when deciding whether to enter the next iteration.
// The carried state can still share storage with the branch result.
low.func.def target<test.low.core>(@target) @upper_survives_yield(%lo: reg<test.i32>, %hi: reg<test.i32>, %step: reg<test.i32>, %condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="seed", result_value_name="state", decision="accepted"}
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%seed: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %state: reg<test.i32>) {
    %chosen = low.scf.if %condition -> (reg<test.i32>) {
      // REMARK@+1: BACKEND/043 {source_value_name="hi", result_value_name="chosen", decision="rejected"}
      low.scf.yield %hi : reg<test.i32>
    } else {
      // REMARK@+1: BACKEND/043 {source_value_name="state", result_value_name="chosen", decision="accepted"}
      low.scf.yield %state : reg<test.i32>
    }
    // REMARK@+2: BACKEND/043 {source_value_name="chosen", result_value_name="state", decision="accepted"}
    // REMARK@+1: BACKEND/043 {source_value_name="chosen", result_value_name="result", decision="accepted"}
    low.scf.yield %chosen : reg<test.i32>
  }
  return %result
}

// ----
CHECK: spills: 0

