// RUN: with-checks emit low-allocation @step_survives_yield diagnostics=placement-decisions

test.target<low_core> @target

// The step remains an input to every implicit counter increment.
// The carried state can still share storage with the branch result.
low.func.def target<test.low.core>(@target) @step_survives_yield(%lo: reg<test.i32>, %hi: reg<test.i32>, %step: reg<test.i32>, %condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="seed", result_value_name="state", decision="accepted"}
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%seed: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %state: reg<test.i32>) {
    %chosen = low.scf.if %condition -> (reg<test.i32>) {
      // REMARK@+1: BACKEND/043 {source_value_name="step", result_value_name="chosen", decision="rejected"}
      low.scf.yield %step : reg<test.i32>
    } else {
      // REMARK@+1: BACKEND/043 {source_value_name="state", result_value_name="chosen", decision="accepted"}
      low.scf.yield %state : reg<test.i32>
    }
    // REMARK@+2: BACKEND/043 {source_value_name="chosen", result_value_name="state", decision="accepted"}
    // REMARK@+1: BACKEND/043 {source_value_name="chosen", result_value_name="result", decision="accepted"}
    low.scf.yield %chosen : reg<test.i32>
  }
  return %result
}

