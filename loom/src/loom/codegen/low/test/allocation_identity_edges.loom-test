// Wide required aliases use the indexed active storage path without fixed slots.
// RUN: emit low-allocation-json @wide_identity

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @wide_identity(%condition: reg<test.i32>, %seed: reg<test.i32 x32>) -> (reg<test.i32 x32>) asm {
  low.br ^loop(%seed: reg<test.i32 x32>)
^loop(%current: reg<test.i32 x32>):
  %alias = low.assume %current [range(%current, 0, 1024)] : reg<test.i32 x32>
  %first = slice %alias[0] : reg<test.i32 x32> -> reg<test.i32 x16>
  %second = slice %current[16] : reg<test.i32 x32> -> reg<test.i32 x16>
  %same = concat(%first, %second) : (reg<test.i32 x16>, reg<test.i32 x16>) -> reg<test.i32 x32>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%same: reg<test.i32 x32>)
^exit:
  return %current
}

