// RUN: with-checks emit low-allocation-json @copy_declared_pair fixed=%source:physical_register:5:2

test.target<low_core> @target

// Physical ID 5 names l1 (r1,r3); it is not an unaligned linear pair.
low.func.def target<test.low.core>(@target) @copy_declared_pair(%source: reg<test.explicit32 x2>) -> (reg<test.explicit32 x2>) asm {
  %result = copy %source : reg<test.explicit32 x2> -> reg<test.explicit32 x2>
  return %result
}

// ----
CHECK: *"coalesced_copy_count":1,"materialized_copy_count":0,*"name":"source"*"location":{"kind":"physical_register","base":5,"count":2}*"name":"result"*"location":{"kind":"physical_register","base":5,"count":2}*

// ====

// RUN: with-checks emit low-allocation-json @join_preserves_loop_storage fixed=%initial:physical_register:4:2

test.target<low_core> @target

// The fresh pair occupies l1 while the loop state occupies l0. The join
// retains l0 for its backedge instead of adopting its first incoming l1.
low.func.def target<test.low.core>(@target) @join_preserves_loop_storage(%condition: reg<test.i32>, %initial: reg<test.explicit32 x2>) -> (reg<test.explicit32 x2>) asm {
  low.br ^loop(%initial: reg<test.explicit32 x2>)
^loop(%state: reg<test.explicit32 x2>):
  %low = test.const.explicit32 11
  %high = test.const.explicit32 23
  %fresh = concat(%low, %high) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  low.cond_br %condition, ^replace, ^keep : reg<test.i32>
^replace:
  low.br ^join(%fresh: reg<test.explicit32 x2>)
^keep:
  low.br ^join(%state: reg<test.explicit32 x2>)
^join(%merged: reg<test.explicit32 x2>):
  low.cond_br %condition, ^repeat, ^exit : reg<test.i32>
^repeat:
  low.br ^loop(%merged: reg<test.explicit32 x2>)
^exit:
  return %merged
}

// ----
CHECK: *"spill_count":0,*"name":"state"*"location":{"kind":"physical_register","base":4,"count":2}*"name":"fresh"*"location":{"kind":"physical_register","base":5,"count":2}*"name":"merged"*"location":{"kind":"physical_register","base":4,"count":2}*

// ====

// RUN: with-checks emit low-allocation-json @atomic_storage_defines_domains

test.target<low_core> @target

// atomic.narrow names l0, whose storage aliases the otherwise distinctly
// named r0 and r2 candidates of explicit32.
low.func.def target<test.low.core>(@target) @atomic_storage_defines_domains(%broad: reg<test.explicit32>, %narrow: reg<test.atomic.narrow>) -> (reg<test.explicit32>, reg<test.atomic.narrow>) asm {
  return %broad, %narrow
}

// ----
CHECK: *"name":"broad"*"base":1,*"name":"narrow"*"base":4,*

// ====

// RUN: with-checks emit low-allocation-json @equal_atomic_domains_combine_demand

test.target<low_core> @target

// packed.narrow and alias.narrow use different physical names for the same
// atomic storage. Their simultaneous demand reserves both narrow candidates.
low.func.def target<test.low.core>(@target) @equal_atomic_domains_combine_demand(%broad: reg<test.explicit32>, %left: reg<test.packed.narrow>, %right: reg<test.alias.narrow>) -> (reg<test.explicit32>, reg<test.packed.narrow>, reg<test.alias.narrow>) asm {
  return %broad, %left, %right
}

// ----
CHECK: *"spill_count":0,*"name":"broad"*"base":2,*"name":"left"*"base":0,*"name":"right"*"base":8,*

// ====

// RUN: with-checks emit low-allocation-json @reuse_idle_restricted_domain

test.target<low_core> @target

// Three short broad lifetimes initially compete with one persistent broad
// lifetime. Later r2/r3-only values need both restricted candidates after the
// short lifetimes end.
low.func.def target<test.low.core>(@target) @reuse_idle_restricted_domain(%short0: reg<test.explicit32>, %short1: reg<test.explicit32>, %short2: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.coindexed.partner>, reg<test.coindexed.partner>) asm {
  %long = test.const.explicit32 1
  %dead0 = copy %short0 : reg<test.explicit32> -> reg<test.explicit32>
  %dead1 = copy %short1 : reg<test.explicit32> -> reg<test.explicit32>
  %dead2 = copy %short2 : reg<test.explicit32> -> reg<test.explicit32>
  %narrow_source0 = test.const.explicit32 2
  %restricted0 = copy %narrow_source0 : reg<test.explicit32> -> reg<test.coindexed.partner>
  %narrow_source1 = test.const.explicit32 3
  %restricted1 = copy %narrow_source1 : reg<test.explicit32> -> reg<test.coindexed.partner>
  return %long, %restricted0, %restricted1
}

// ----
CHECK: *"spill_count":0,*"name":"short0"*"base":2,*"name":"short1"*"base":3,*"name":"short2"*"base":0,*"name":"long"*"base":1,*"name":"restricted0"*"base":2,*"name":"restricted1"*"base":3,*

// ====

// RUN: with-checks emit low-allocation-json @later_restricted_value

test.target<low_core> @target

// The persistent broad value stays in general storage, leaving the restricted
// domain available to the later narrow value.
low.func.def target<test.low.core>(@target) @later_restricted_value(%persistent: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %restricted = test.const.packed.narrow 7
  return %persistent, %restricted
}

// ----
CHECK: *"spill_count":0,*"name":"persistent"*"base":2,*"name":"restricted"*"base":0,*

// ====

// RUN: with-checks emit low-allocation-json @copy_keeps_general_storage fixed=%source:physical_register:2:1

test.target<low_core> @target

// The source is already in general-only storage while one narrow candidate is
// idle. Preserve the copy affinity because it does not consume the candidate
// reserved for the overlapping restricted value.
low.func.def target<test.low.core>(@target) @copy_keeps_general_storage(%source: reg<test.explicit32>, %peer0: reg<test.explicit32>, %peer1: reg<test.explicit32>, %restricted: reg<test.packed.narrow>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %result = copy %source : reg<test.explicit32> -> reg<test.explicit32>
  return %result, %peer0, %peer1, %restricted
}

// ----
CHECK: *"coalesced_copy_count":1,"materialized_copy_count":0,*"name":"source"*"base":2,*"name":"result"*"base":2,*

// ====

// RUN: with-checks emit low-allocation-json @future_fixed_copy fixed=%result:physical_register:2:1

test.target<low_core> @target

// The later result location is known before interval assignment. Preserve that
// copy affinity instead of moving the source through idle narrower storage.
low.func.def target<test.low.core>(@target) @future_fixed_copy(%source: reg<test.explicit32>, %peer0: reg<test.explicit32>, %peer1: reg<test.explicit32>, %restricted: reg<test.packed.narrow>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %result = copy %source : reg<test.explicit32> -> reg<test.explicit32>
  return %result, %peer0, %peer1, %restricted
}

// ----
CHECK: *"coalesced_copy_count":1,"materialized_copy_count":0,*"name":"source"*"base":2,*"name":"result"*"base":2,*

// ====

// RUN: with-checks emit low-allocation-json @loop_initializer_keeps_future_domain_available

test.target<low_core> @target

// The initializer ends before the restricted value starts. Its loop affinity
// carries the state lifetime through one general candidate, leaving the
// restricted domain available inside the loop.
low.func.def target<test.low.core>(@target) @loop_initializer_keeps_future_domain_available(%condition: reg<test.i32>) -> (reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %initial = test.const.explicit32 1
  low.br ^loop(%initial: reg<test.explicit32>)
^loop(%state: reg<test.explicit32>):
  %restricted = test.const.packed.narrow 7
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%state: reg<test.explicit32>)
^exit:
  return %state, %restricted
}

// ----
CHECK: *"spill_count":0,*"name":"initial"*"base":2,*"name":"state"*"base":2,*"name":"restricted"*"base":0,*

// ====

// RUN: with-checks emit low-allocation-json @equal_restricted_domains_remain_preferred

test.target<low_core> @target

// Both producers can already occupy their consumer's domain. Equal-domain
// competitors require distinct registers, not an intermediate broad register.
low.func.def target<test.low.core>(@target) @equal_restricted_domains_remain_preferred(%first: reg<test.explicit32>, %second: reg<test.explicit32>) -> (reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %narrow_first = copy %first : reg<test.explicit32> -> reg<test.packed.narrow>
  %narrow_second = copy %second : reg<test.explicit32> -> reg<test.packed.narrow>
  return %narrow_first, %narrow_second
}

// ----
CHECK: *"coalesced_copy_count":2,"materialized_copy_count":0,*"name":"first"*"base":0,*"name":"second"*"base":1,*"name":"narrow_first"*"base":0,*"name":"narrow_second"*"base":1,*

