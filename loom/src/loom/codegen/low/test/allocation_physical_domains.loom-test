low.func.def target<test.low.core>(@target) @semantic_candidates_use_physical_identity(%source: reg<test.packed.wide>) -> (reg<test.coindexed.partner>) asm {
  %result = copy %source : reg<test.packed.wide> -> reg<test.coindexed.partner>
  return %result
}

