// RUN: with-checks compile-report source-to-low{control-flow=structured-low},low-dce

test.target<low_core> @target

// The condition executes five times, the body four times, and the exit once.
// Each addition emits one Low op, including those in nested regions.
func.def target(@target) @condition_body_exit_counts(%value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %terminal, %total = scf.while(%before = %begin : index, %accumulator = %value : i32) -> (index, i32) {
    %header = scalar.addi %accumulator, %value : i32
    %more = index.cmp slt, %before, %end : index
    scf.condition %more, %before, %header : i1, index, i32
  } do(%position: index, %carried: i32) {
    %body = scalar.addi %carried, %value : i32
    %next = index.add %position, %step : index
    scf.yield %next, %body : index, i32
  }
  %result = scalar.addi %total, %value : i32
  func.return %result : i32
}

// ----
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.addi * selected_ops=3 emitted_ops=3 exact_dynamic_ops=3 unknown_dynamic_ops=0 dynamic_selected_ops=10 dynamic_emitted_ops=10
CHECK: COMPILE-REPORT: source_low[*] * source_op=scalar.addi * emitted_ops=1 execution_count=5
CHECK: COMPILE-REPORT: source_low[*] * source_op=scalar.addi * emitted_ops=1 execution_count=4

// ====
// RUN: with-checks compile-report scf-to-cfg,source-to-low,low-dce

test.target<low_core> @target

// CFG lowering preserves the same condition/body/exit multiplicities.
func.def target(@target) @cfg_condition_body_exit_counts(%value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %terminal, %total = scf.while(%before = %begin : index, %accumulator = %value : i32) -> (index, i32) {
    %header = scalar.addi %accumulator, %value : i32
    %more = index.cmp slt, %before, %end : index
    scf.condition %more, %before, %header : i1, index, i32
  } do(%position: index, %carried: i32) {
    %body = scalar.addi %carried, %value : i32
    %next = index.add %position, %step : index
    scf.yield %next, %body : index, i32
  }
  %result = scalar.addi %total, %value : i32
  func.return %result : i32
}

// ----
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.addi * selected_ops=3 emitted_ops=3 exact_dynamic_ops=3 unknown_dynamic_ops=0 dynamic_selected_ops=10 dynamic_emitted_ops=10
CHECK: COMPILE-REPORT: source_low[*] * source_op=scalar.addi * emitted_ops=1 execution_count=5
CHECK: COMPILE-REPORT: source_low[*] * source_op=scalar.addi * emitted_ops=1 execution_count=4

// ====
// RUN: with-checks compile-report source-to-low{control-flow=structured-low},low-dce

test.target<low_core> @target

// Loop multiplicities do not prove branch entry in either nesting order.
func.def target(@target) @conditional_loop_counts(%enabled: i1, %value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %first = scf.for %iteration = [%begin to %end step %step](%accumulator = %value : i32) -> (i32) {
    %unconditional = scalar.addi %accumulator, %value : i32
    %sum = scf.if %enabled -> (i32) {
      %conditional = scalar.addi %unconditional, %value : i32
      scf.yield %conditional : i32
    } else {
      scf.yield %unconditional : i32
    }
    scf.yield %sum : i32
  }
  %result = scf.if %enabled -> (i32) {
    %terminal, %total = scf.while(%before = %begin : index, %accumulator = %first : i32) -> (index, i32) {
      %more = index.cmp slt, %before, %end : index
      scf.condition %more, %before, %accumulator : i1, index, i32
    } do(%position: index, %carried: i32) {
      %sum = scalar.addi %carried, %value : i32
      %next = index.add %position, %step : index
      scf.yield %next, %sum : index, i32
    }
    scf.yield %total : i32
  } else {
    scf.yield %first : i32
  }
  func.return %result : i32
}

// ----
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.addi * selected_ops=3 emitted_ops=3 exact_dynamic_ops=1 unknown_dynamic_ops=2 dynamic_selected_ops=4 dynamic_emitted_ops=4

// ====
// RUN: with-checks compile-report scf-to-cfg,source-to-low,low-dce

test.target<low_core> @target

// Case selection controls whether an addition executes once or four times.
func.def target(@target) @switch_loop_counts(%selector: index, %value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %result = scf.switch %selector -> (i32) {
    case 0 {
      %total = scf.for %iteration = [%begin to %end step %step](%accumulator = %value : i32) -> (i32) {
        %sum = scalar.addi %accumulator, %value : i32
        scf.yield %sum : i32
      }
      scf.yield %total : i32
    }
    default {
      %sum = scalar.addi %value, %value : i32
      scf.yield %sum : i32
    }
  }
  func.return %result : i32
}

// ----
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.addi * selected_ops=2 emitted_ops=2 exact_dynamic_ops=0 unknown_dynamic_ops=2 dynamic_selected_ops=0 dynamic_emitted_ops=0

// ====
// RUN: with-checks compile-report source-to-low,low-dce

test.target<low_core> @target

// Runtime selection stays unknown in the diamond arms, but does not obscure
// the exact four-trip loop after both paths reconverge.
func.def target(@target) @diamond_then_counted_loop(%enabled: i1, %value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  cfg.cond_br %enabled, ^enabled, ^disabled
^enabled:
  %incremented = scalar.addi %value, %value : i32
  cfg.br ^join(%incremented: i32)
^disabled:
  %decremented = scalar.subi %value, %value : i32
  cfg.br ^join(%decremented: i32)
^join(%selected: i32):
  cfg.br ^header(%begin: index, %selected: i32)
^header(%position: index, %accumulator: i32):
  %more = index.cmp slt, %position, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %product = scalar.muli %accumulator, %value : i32
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index, %product: i32)
^exit:
  func.return %accumulator : i32
}

// ----
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.addi * exact_dynamic_ops=0 unknown_dynamic_ops=1 dynamic_selected_ops=0 dynamic_emitted_ops=0
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.subi * exact_dynamic_ops=0 unknown_dynamic_ops=1 dynamic_selected_ops=0 dynamic_emitted_ops=0
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.muli * exact_dynamic_ops=1 unknown_dynamic_ops=0 dynamic_selected_ops=4 dynamic_emitted_ops=4
CHECK: COMPILE-REPORT: source_low[*] * source_op=scalar.muli * execution_count=4

// ====
// RUN: with-checks compile-report source-to-low,low-dce

test.target<low_core> @target

// Runtime selection inside a fixed loop obscures only the selected arms. The
// common latch still executes exactly once for each of the four iterations.
func.def target(@target) @counted_loop_with_inner_diamond(%enabled: i1, %value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  cfg.br ^header(%begin: index, %value: i32)
^header(%position: index, %accumulator: i32):
  %more = index.cmp slt, %position, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  cfg.cond_br %enabled, ^enabled, ^disabled
^enabled:
  %incremented = scalar.addi %accumulator, %value : i32
  cfg.br ^latch(%incremented: i32)
^disabled:
  %decremented = scalar.subi %accumulator, %value : i32
  cfg.br ^latch(%decremented: i32)
^latch(%selected: i32):
  %product = scalar.muli %selected, %value : i32
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index, %product: i32)
^exit:
  func.return %accumulator : i32
}

// ----
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.addi * exact_dynamic_ops=0 unknown_dynamic_ops=1 dynamic_selected_ops=0 dynamic_emitted_ops=0
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.subi * exact_dynamic_ops=0 unknown_dynamic_ops=1 dynamic_selected_ops=0 dynamic_emitted_ops=0
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=scalar.muli * exact_dynamic_ops=1 unknown_dynamic_ops=0 dynamic_selected_ops=4 dynamic_emitted_ops=4
CHECK: COMPILE-REPORT: source_low[*] * source_op=scalar.muli * execution_count=4
