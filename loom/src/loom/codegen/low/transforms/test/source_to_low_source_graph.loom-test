// RUN: pass source-to-low,low-dce

test.target<low_core> @test_target

func.def target(@test_target) @folds_exact_compare_branch(%value: index) -> (index) {
  %equal = index.cmp eq, %value, %value : index
  cfg.cond_br %equal, ^equal, ^unequal
^equal:
  func.return %value : index
^unequal:
  func.return %value : index
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @folds_exact_compare_branch(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^equal
^equal:
  return %value
^unequal:
  return %value
}
