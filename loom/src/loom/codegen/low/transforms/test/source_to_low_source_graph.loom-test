// RUN: pass source-to-low,low-dce

test.target<low_core> @test_target {contract_feature_bits = 1}

func.def target(@test_target) @fuses_native_compare_branch(%lhs: index, %rhs: index) -> (index) {
  %less = index.cmp slt, %lhs, %rhs : index
  cfg.cond_br %less, ^less, ^greater_equal
^less:
  func.return %lhs : index
^greater_equal:
  func.return %rhs : index
}

// ----
test.target<low_core> @test_target {contract_feature_bits = 1}

low.func.def target<test.low.core>(@test_target) abi(object_function) @fuses_native_compare_branch(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  low.op.cond_br<test.native.cond_br.i32>(%lhs, %rhs) {predicate = 2}, ^less, ^greater_equal : (reg<test.i32>, reg<test.i32>)
^less:
  return %lhs
^greater_equal:
  return %rhs
}

