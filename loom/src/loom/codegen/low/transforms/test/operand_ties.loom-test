// RUN: pass low-select-operand-forms,low-select-operand-forms

// Repeated preparation is idempotent. Copies preserve independent ownership;
// the allocator chooses whether their storage can later coalesce.

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @preserve_source(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %result = test.tied.any %source : reg<test.i32>
  return %source, %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @preserve_source(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %source_copy = copy %source : reg<test.i32> -> reg<test.i32>
  %result = test.tied.any %source_copy
  return %source, %result
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dead_source(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>) asm {
  %result = test.tied.any %source : reg<test.i64 : i64>
  return %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dead_source(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>) asm {
  %source_copy = copy %source : reg<test.i64 : i64> -> reg<test.i64 : i64>
  %result = test.tied.any %source_copy
  return %result
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @owned_source(%source: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = test.tied.any %source
  return %result
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @destructive_source(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i64 : i64>) asm {
  %result = test.destructive.any %source
  return %source, %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @destructive_source(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i64 : i64>) asm {
  %source_copy = copy %source : reg<test.i64 : i64> -> reg<test.i64 : i64>
  %result = test.destructive.any %source_copy : %source_copy as reg<test.i64 : i64>
  return %source, %result
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @owned_destructive_source(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>) asm {
  %result = test.destructive.any %source : %source as reg<test.i64 : i64>
  return %result
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_pair(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>, reg<test.i32 : i32>, reg<test.i64 : i64>) asm {
  %first, %second = test.tied.pair %left, %right : reg<test.i64 : i64>, reg<test.i32 : i32>
  return %first, %second, %left, %right
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_pair(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>, reg<test.i32 : i32>, reg<test.i64 : i64>) asm {
  %left_copy = copy %left : reg<test.i32 : i32> -> reg<test.i32 : i32>
  %right_copy = copy %right : reg<test.i64 : i64> -> reg<test.i64 : i64>
  %first, %second = test.tied.pair %left_copy, %right_copy
  return %first, %second, %left, %right
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @partially_owned_pair(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>, reg<test.i32 : i32>) asm {
  %first, %second = test.tied.pair %left, %right : %right as reg<test.i64 : i64>, reg<test.i32 : i32>
  return %first, %second, %left
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @partially_owned_pair(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>, reg<test.i32 : i32>) asm {
  %left_copy = copy %left : reg<test.i32 : i32> -> reg<test.i32 : i32>
  %first, %second = test.tied.pair %left_copy, %right
  return %first, %second, %left
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @repeated_source(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first, %second = test.tied.pair %source, %source : reg<test.i32>, reg<test.i32>
  return %first, %second, %source
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @repeated_source(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %source_copy$6 = copy %source : reg<test.i32> -> reg<test.i32>
  %source_copy$7 = copy %source : reg<test.i32> -> reg<test.i32>
  %first, %second = test.tied.pair %source_copy$6, %source_copy$7
  return %first, %second, %source
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @source_alias(%source: reg<test.i32 x2>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  %alias = slice %source[1] : reg<test.i32 x2> -> reg<test.i32>
  %result = test.tied.any %alias : reg<test.i32>
  return %source, %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @source_alias(%source: reg<test.i32 x2>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  %alias = slice %source[1] : reg<test.i32 x2> -> reg<test.i32>
  %alias_copy = copy %alias : reg<test.i32> -> reg<test.i32>
  %result = test.tied.any %alias_copy
  return %source, %result
}

// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_carried_source(%source: reg<test.i32>, %condition: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.br ^loop(%source: reg<test.i32>)
^loop(%current: reg<test.i32>):
  %next = test.tied.any %current : reg<test.i32>
  low.cond_br %condition, ^again, ^exit : reg<test.i32>
^again:
  low.br ^loop(%next: reg<test.i32>)
^exit:
  return %current, %next
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_carried_source(%source: reg<test.i32>, %condition: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.br ^loop(%source: reg<test.i32>)
^loop(%current: reg<test.i32>):
  %current_copy = copy %current : reg<test.i32> -> reg<test.i32>
  %next = test.tied.any %current_copy
  low.cond_br %condition, ^again, ^exit : reg<test.i32>
^again:
  low.br ^loop(%next: reg<test.i32>)
^exit:
  return %current, %next
}

