// RUN: with-checks pass target-legalize{mode=eager},dce,canonicalize

test.target<low_core> @test_target

func.def target(@test_target) @scalarizes_multidimensional_gather_scatter(%input: buffer, %output: buffer, %origin: index, %offsets: vector<2x2xindex>, %value: vector<2x2xf32>) -> (vector<2x2xf32>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<64xf32>
  %gathered = vector.gather %input_view[%origin][%offsets] {cache_scope = device, cache_temporal = non_temporal} : view<64xf32>, vector<2x2xindex> -> vector<2x2xf32>
  vector.scatter %value, %output_view[%origin][%offsets] {cache_scope = system, cache_temporal = writeback} : vector<2x2xf32>, view<64xf32>, vector<2x2xindex>
  func.return %gathered : vector<2x2xf32>
}

// ----
CHECK: * = view.load %input_view[*] {cache_scope = device, cache_temporal = non_temporal} : view<64xf32> -> f32
CHECK: * = view.load %input_view[*] {cache_scope = device, cache_temporal = non_temporal} : view<64xf32> -> f32
CHECK: * = view.load %input_view[*] {cache_scope = device, cache_temporal = non_temporal} : view<64xf32> -> f32
CHECK: * = view.load %input_view[*] {cache_scope = device, cache_temporal = non_temporal} : view<64xf32> -> f32
CHECK: %gathered = vector.from_elements * : vector<2x2xf32>
CHECK: view.store * %output_view[*] {cache_scope = system, cache_temporal = writeback} : f32, view<64xf32>
CHECK: view.store * %output_view[*] {cache_scope = system, cache_temporal = writeback} : f32, view<64xf32>
CHECK: view.store * %output_view[*] {cache_scope = system, cache_temporal = writeback} : f32, view<64xf32>
CHECK: view.store * %output_view[*] {cache_scope = system, cache_temporal = writeback} : f32, view<64xf32>

