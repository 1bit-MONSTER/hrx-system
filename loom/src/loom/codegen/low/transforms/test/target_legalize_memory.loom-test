// RUN: with-checks pass target-legalize{mode=eager},dce,canonicalize

test.target<low_core> @test_target

func.def target(@test_target) @scalarizes_masked_dense_and_compress_expand(%input: buffer, %output: buffer, %origin: index, %mask: vector<2xi1>, %passthrough: vector<2xi32>, %value: vector<2xi32>) -> (vector<2xi32>, vector<2xi32>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  %masked = vector.load.mask %input_view[%origin], %mask, %passthrough : view<64xi32>, vector<2xi1>, vector<2xi32>
  vector.store.mask %value, %output_view[%origin], %mask : vector<2xi32>, view<64xi32>, vector<2xi1>
  %expanded = vector.load.expand %input_view[%origin], %mask, %passthrough : view<64xi32>, vector<2xi1>, vector<2xi32>
  vector.store.compress %value, %output_view[%origin], %mask : vector<2xi32>, view<64xi32>, vector<2xi1>
  func.return %masked, %expanded : vector<2xi32>, vector<2xi32>
}

// ----
CHECK-NOT: vector.load.mask
CHECK-NOT: vector.store.mask
CHECK-NOT: vector.load.expand
CHECK-NOT: vector.store.compress
CHECK: %masked = vector.from_elements * : vector<2xi32>
CHECK: %expanded = vector.from_elements * : vector<2xi32>
CHECK: view.store * %output_view[*] : i32, view<64xi32>
CHECK: view.store * %output_view[*] : i32, view<64xi32>
