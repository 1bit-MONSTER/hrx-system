// RUN: pass target-legalize{mode=eager,policy=reference-only}

test.target<low_core> @target {subgroup_size = 8}

kernel.def target(@target) @dynamic_logical_width() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%value: i32, %offset: i32, %width: i32) {
  %indexed, %indexed_valid = kernel.subgroup.shuffle<index> %value, %offset, %width : i32, i32, i32
  %xor, %xor_valid = kernel.subgroup.shuffle<xor> %indexed, %offset, %width : i32, i32, i32
  %up, %up_valid = kernel.subgroup.shuffle<up> %xor, %offset, %width : i32, i32, i32
  %down, %down_valid = kernel.subgroup.shuffle<down> %up, %offset, %width : i32, i32, i32
  test.use %down, %indexed_valid, %xor_valid, %up_valid, %down_valid : i32, i1, i1, i1, i1
  kernel.return
}

