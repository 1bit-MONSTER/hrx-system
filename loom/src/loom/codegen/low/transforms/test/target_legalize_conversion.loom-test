func.def target(@test_target) @fp8_vectors(%words: vector<3xi16>, %bytes: vector<4xi8>, %e4m3: vector<3xf8E4M3>, %e5m2: vector<4xf8E5M2>) -> (vector<3xf8E4M3>, vector<4xf8E5M2>, vector<3xi32>, vector<4xi16>) {
  %237 = vector.uitofp %words : vector<3xi16> to vector<3xf32>
  %saturated = vector.fptrunc %237 : vector<3xf32> to vector<3xf8E4M3>
  %235 = vector.sitofp %bytes : vector<4xi8> to vector<4xf32>
  %rounded = vector.fptrunc %235 : vector<4xf32> to vector<4xf8E5M2>
  %233 = vector.extf %e4m3 : vector<3xf8E4M3> to vector<3xf32>
  %signed = vector.fptosi %233 : vector<3xf32> to vector<3xi32>
  %231 = vector.extf %e5m2 : vector<4xf8E5M2> to vector<4xf32>
  %unsigned = vector.fptoui %231 : vector<4xf32> to vector<4xi16>
  func.return %saturated, %rounded, %signed, %unsigned : vector<3xf8E4M3>, vector<4xf8E5M2>, vector<3xi32>, vector<4xi16>
}

// ====

// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @scalar_integer_widths(%flag: i1, %wide: i64) -> (bf16, f16, f8E4M3, f8E5M2) {
  %signed_flag = scalar.sitofp %flag : i1 to bf16
  %unsigned_flag = scalar.uitofp %flag : i1 to f16
  %signed_wide = scalar.sitofp %wide : i64 to f8E4M3
  %unsigned_wide = scalar.uitofp %wide : i64 to f8E5M2
  func.return %signed_flag, %unsigned_flag, %signed_wide, %unsigned_wide : bf16, f16, f8E4M3, f8E5M2
}

func.def target(@test_target) @vector_integer_widths(%flags: vector<4xi1>, %wide: vector<3xi64>) -> (vector<4xbf16>, vector<4xf16>, vector<3xf8E4M3>, vector<3xf16>) {
  %signed_flags = vector.sitofp %flags : vector<4xi1> to vector<4xbf16>
  %unsigned_flags = vector.uitofp %flags : vector<4xi1> to vector<4xf16>
  %signed_wide = vector.sitofp %wide : vector<3xi64> to vector<3xf8E4M3>
  %unsigned_wide = vector.uitofp %wide : vector<3xi64> to vector<3xf16>
  func.return %signed_flags, %unsigned_flags, %signed_wide, %unsigned_wide : vector<4xbf16>, vector<4xf16>, vector<3xf8E4M3>, vector<3xf16>
}

