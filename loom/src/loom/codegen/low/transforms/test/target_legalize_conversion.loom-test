  %26 = scalar.sitofp %flag : i1 to f32
  %signed_flag = scalar.fptrunc %26 : f32 to bf16
  %24 = scalar.uitofp %flag : i1 to f32
  %unsigned_flag = scalar.fptrunc %24 : f32 to f16
  %22 = scalar.sitofp %wide : i64 to f32
  %signed_wide = scalar.fptrunc %22 : f32 to f8E4M3
  %20 = scalar.uitofp %wide : i64 to f32
  %unsigned_wide = scalar.fptrunc %20 : f32 to f8E5M2
  func.return %signed_flag, %unsigned_flag, %signed_wide, %unsigned_wide : bf16, f16, f8E4M3, f8E5M2
}

func.def target(@test_target) @vector_integer_widths(%flags: vector<4xi1>, %wide: vector<3xi64>) -> (vector<4xbf16>, vector<4xf16>, vector<3xf8E4M3>, vector<3xf16>) {
  %34 = vector.sitofp %flags : vector<4xi1> to vector<4xf32>
