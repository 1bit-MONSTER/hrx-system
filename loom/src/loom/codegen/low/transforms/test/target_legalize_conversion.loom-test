  %unsigned_flags = vector.fptrunc %32 : vector<4xf32> to vector<4xf16>
  %30 = vector.sitofp %wide : vector<3xi64> to vector<3xf32>
  %signed_wide = vector.fptrunc %30 : vector<3xf32> to vector<3xf8E4M3>
  %28 = vector.uitofp %wide : vector<3xi64> to vector<3xf32>
  %unsigned_wide = vector.fptrunc %28 : vector<3xf32> to vector<3xf16>
  func.return %signed_flags, %unsigned_flags, %signed_wide, %unsigned_wide : vector<4xbf16>, vector<4xf16>, vector<3xf8E4M3>, vector<3xf16>
