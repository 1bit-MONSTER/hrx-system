test.target<low_core> @test_target

func.def target(@test_target) @signed_narrow_integer(%byte: i8, %word: i16) -> (bf16, f16) {
  %84 = scalar.sitofp %byte : i8 to f32
  %bfloat = scalar.fptrunc %84 : f32 to bf16
  %82 = scalar.sitofp %word : i16 to f32
  %half = scalar.fptrunc %82 : f32 to f16
  func.return %bfloat, %half : bf16, f16
}

func.def target(@test_target) @unsigned_narrow_integer(%byte: i8, %word: i16) -> (f16, bf16) {
  %88 = scalar.uitofp %byte : i8 to f32
  %half = scalar.fptrunc %88 : f32 to f16
  %86 = scalar.uitofp %word : i16 to f32
  %bfloat = scalar.fptrunc %86 : f32 to bf16
  func.return %half, %bfloat : f16, bf16
}

