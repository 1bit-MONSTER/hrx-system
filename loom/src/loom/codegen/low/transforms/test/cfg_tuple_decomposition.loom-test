test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_lane_captures(%initial: reg<test.i32 x2>) -> (reg<test.i32>, reg<test.i32>) asm {
  %10 = slice %initial[0] : reg<test.i32 x2> -> reg<test.i32>
  %11 = slice %initial[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^join(%10: reg<test.i32>, %11: reg<test.i32>)
^join(%8: reg<test.i32>, %9: reg<test.i32>):
  %first = slice %8[0] : reg<test.i32> -> reg<test.i32>
  %second = slice %8[0] : reg<test.i32> -> reg<test.i32>
  %first_changed = test.tied.any %first
  %second_changed = test.tied.any %second
  return %first_changed, %second_changed
}

