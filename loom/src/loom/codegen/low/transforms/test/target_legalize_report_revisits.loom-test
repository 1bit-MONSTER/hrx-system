// RUN: with-checks compile-report target-legalize

test.target<low_core> @test_target

func.def target(@test_target) @counts_original_sources_in_nested_regions(%condition: i1, %a: vector<2xf32>, %b: vector<2xf32>) -> (vector<2xf32>) {
  %unused = index.constant 47 : index
  %result = scf.if %condition -> (vector<2xf32>) {
    %selected = scf.select %condition, %a, %b : vector<2xf32>
    scf.yield %selected : vector<2xf32>
  } else {
    %selected = scf.select %condition, %b, %a : vector<2xf32>
    scf.yield %selected : vector<2xf32>
  }
  func.return %result : vector<2xf32>
}

