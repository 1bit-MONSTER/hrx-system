// RUN: with-checks compile-report target-legalize

test.target<low_core> @test_target

func.def target(@test_target) @counts_distinct_selections_once_after_dce(%condition: i1, %a: vector<2xf32>, %b: vector<2xf32>) -> (vector<2xf32>, vector<2xf32>) {
  // Removing this unused operation forces another greedy iteration.
  %unused = index.constant 47 : index
  %selected = scf.select %condition, %a, %b : vector<2xf32>
  %second = scf.select %condition, %b, %a : vector<2xf32>
  func.return %selected, %second : vector<2xf32>, vector<2xf32>
}

