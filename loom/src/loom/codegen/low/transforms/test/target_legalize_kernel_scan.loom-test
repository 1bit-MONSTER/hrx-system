// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only}

test.target<low_core> @target {subgroup_size = 64}

kernel.def target(@target) @wide_forward_inclusive() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%value: i32) {
  %prefix = kernel.subgroup.scan<addi> %value {cluster_size = 4, direction = forward, mode = inclusive} : i32
  test.use %prefix : i32
  kernel.return
}

