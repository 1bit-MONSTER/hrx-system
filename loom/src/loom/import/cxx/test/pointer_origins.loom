// Exercise C++ pointer origins through the ordinary linked callable ABI. The
// target implementation comes from pointer_origins.cxx; the Loom oracle uses
// direct logical coordinates over the same rooted tensors.

func.decl @read(%pointer: buffer, %pointer_byte_offset: offset) -> (i32)

func.decl @read_zero(%pointer: buffer, %pointer_byte_offset: offset) -> (i32)

func.decl @read_next(%pointer: buffer, %pointer_byte_offset: offset) -> (i32)

func.decl @read_previous(%pointer: buffer, %pointer_byte_offset: offset) -> (i32)

func.decl @read_at(%pointer: buffer, %pointer_byte_offset: offset, %index: i32) -> (i32)

func.decl @read_member(%pointer: buffer, %pointer_byte_offset: offset) -> (i32)

func.decl @read_helper(%pointer: buffer, %pointer_byte_offset: offset) -> (i32)

func.decl @exchange(%pointer: buffer, %pointer_byte_offset: offset, %index: i32, %replacement: i32) -> (i32)

// Derive a nonzero pointer origin, a signed read coordinate in [-2, 2], and a
// signed exchange coordinate in [-4, 4].
func.def inline @pointer_origin_parameters(%ordinal: index) -> (offset, i32, i32) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 8)] : index
  %origin_element = index.add %bounded_ordinal, %c4 : index
  %origin_bytes = index.mul %origin_element, %c4 : index
  %origin = index.cast %origin_bytes : index to offset
  %read_remainder = index.rem %bounded_ordinal, %c5 : index
  %read_coordinate = index.sub %read_remainder, %c2 : index
  %exchange_coordinate = index.sub %bounded_ordinal, %c4 : index
  %read_coordinate_i32 = index.cast %read_coordinate : index to i32
  %exchange_coordinate_i32 = index.cast %exchange_coordinate : index to i32
  func.return %origin, %read_coordinate_i32, %exchange_coordinate_i32 : offset, i32, i32
}

func.def @pointer_origin_observations(%ordinal: index, %replacement_bits: i64, %read_storage: buffer, %exchange_storage: buffer, %output: buffer) {
  %origin, %read_coordinate, %exchange_coordinate = func.call @pointer_origin_parameters(%ordinal) : (index) -> (offset, i32, i32)
  %replacement = scalar.trunci %replacement_bits : i64 to i32
  %direct = func.call @read(%read_storage, %origin) : (buffer, offset) -> (i32)
  %zero = func.call @read_zero(%read_storage, %origin) : (buffer, offset) -> (i32)
  %next = func.call @read_next(%read_storage, %origin) : (buffer, offset) -> (i32)
  %previous = func.call @read_previous(%read_storage, %origin) : (buffer, offset) -> (i32)
  %selected = func.call @read_at(%read_storage, %origin, %read_coordinate) : (buffer, offset, i32) -> (i32)
  %member = func.call @read_member(%read_storage, %origin) : (buffer, offset) -> (i32)
  %helper = func.call @read_helper(%read_storage, %origin) : (buffer, offset) -> (i32)
  %exchanged = func.call @exchange(%exchange_storage, %origin, %exchange_coordinate, %replacement) : (buffer, offset, i32, i32) -> (i32)
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<8xi32>
  view.store %direct, %results[0] : i32, view<8xi32>
  view.store %zero, %results[1] : i32, view<8xi32>
  view.store %next, %results[2] : i32, view<8xi32>
  view.store %previous, %results[3] : i32, view<8xi32>
  view.store %selected, %results[4] : i32, view<8xi32>
  view.store %member, %results[5] : i32, view<8xi32>
  view.store %helper, %results[6] : i32, view<8xi32>
  view.store %exchanged, %results[7] : i32, view<8xi32>
  func.return
}

func.def @pointer_origin_oracle(%ordinal: index, %replacement_bits: i64, %read_storage: buffer, %exchange_storage: buffer, %output: buffer) {
  %origin, %read_coordinate, %exchange_coordinate = func.call @pointer_origin_parameters(%ordinal) : (index) -> (offset, i32, i32)
  %replacement = scalar.trunci %replacement_bits : i64 to i32
  %base = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %origin_index = index.cast %origin : offset to index
  %origin_element = index.div %origin_index, %c4 : index
  %read_coordinate_index = index.cast %read_coordinate : i32 to index
  %exchange_coordinate_index = index.cast %exchange_coordinate : i32 to index
  %read_element = index.add %origin_element, %read_coordinate_index : index
  %exchange_element = index.add %origin_element, %exchange_coordinate_index : index
  %next_element = index.add %origin_element, %c1 : index
  %previous_element = index.sub %origin_element, %c1 : index
  %helper_element = index.add %origin_element, %c2 : index
  %read_values = buffer.view %read_storage[%base] : buffer -> view<24xi32>
  %exchange_values = buffer.view %exchange_storage[%base] : buffer -> view<24xi32>
  %results = buffer.view %output[%base] : buffer -> view<8xi32>
  %direct = view.load %read_values[%origin_element] : view<24xi32> -> i32
  %next = view.load %read_values[%next_element] : view<24xi32> -> i32
  %previous = view.load %read_values[%previous_element] : view<24xi32> -> i32
  %selected = view.load %read_values[%read_element] : view<24xi32> -> i32
  %helper = view.load %read_values[%helper_element] : view<24xi32> -> i32
  %exchanged = view.load %exchange_values[%exchange_element] : view<24xi32> -> i32
  view.store %replacement, %exchange_values[%exchange_element] : i32, view<24xi32>
  view.store %direct, %results[0] : i32, view<8xi32>
  view.store %direct, %results[1] : i32, view<8xi32>
  view.store %next, %results[2] : i32, view<8xi32>
  view.store %previous, %results[3] : i32, view<8xi32>
  view.store %selected, %results[4] : i32, view<8xi32>
  view.store %next, %results[5] : i32, view<8xi32>
  view.store %helper, %results[6] : i32, view<8xi32>
  view.store %exchanged, %results[7] : i32, view<8xi32>
  func.return
}

check.scenario @pointer_origin_values {
  check.trial[9](%trial: index, %entropy: check.entropy) {
    %replacement_bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %read_storage = check.generate.iota offset(-1009) step(37) : tensor<32xi32>
    %read_baseline = check.generate.iota offset(-1009) step(37) : tensor<32xi32>
    %exchange_storage = check.generate.iota offset(7001) step(-53) : tensor<32xi32>
    %exchange_baseline = check.generate.iota offset(7001) step(-53) : tensor<32xi32>
    %output_storage = check.generate.fill value(-559038737) : tensor<16xi32>
    %read = check.tensor.view %read_storage offset(16) : tensor<32xi32> -> tensor<24xi32>
    %exchange = check.tensor.view %exchange_storage offset(16) : tensor<32xi32> -> tensor<24xi32>
    %exchange_prefix = check.tensor.view %exchange_storage offset(0) : tensor<32xi32> -> tensor<4xi32>
    %exchange_suffix = check.tensor.view %exchange_storage offset(112) : tensor<32xi32> -> tensor<4xi32>
    %exchange_baseline_prefix = check.tensor.view %exchange_baseline offset(0) : tensor<32xi32> -> tensor<4xi32>
    %exchange_baseline_suffix = check.tensor.view %exchange_baseline offset(112) : tensor<32xi32> -> tensor<4xi32>
    %output = check.tensor.view %output_storage offset(16) : tensor<16xi32> -> tensor<8xi32>
    %output_prefix = check.tensor.view %output_storage offset(0) : tensor<16xi32> -> tensor<4xi32>
    %output_suffix = check.tensor.view %output_storage offset(48) : tensor<16xi32> -> tensor<4xi32>
    %output_guard = check.generate.fill value(-559038737) : tensor<4xi32>
    check.compare<@pointer_origin_observations, @pointer_origin_oracle>(%trial, %replacement_bits, %read, %exchange, %output) : (index, i64, tensor<24xi32>, tensor<24xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%read_storage) expected(%read_storage) : tensor<32xi32>
      check.expect.bitwise actual(%read_storage) expected(%read_baseline) : tensor<32xi32>
      check.expect.bitwise actual(%exchange_storage) expected(%exchange_storage) : tensor<32xi32>
      check.expect.bitwise actual(%exchange_prefix) expected(%exchange_baseline_prefix) : tensor<4xi32>
      check.expect.bitwise actual(%exchange_suffix) expected(%exchange_baseline_suffix) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
      check.expect.bitwise actual(%output_prefix) expected(%output_guard) : tensor<4xi32>
      check.expect.bitwise actual(%output_suffix) expected(%output_guard) : tensor<4xi32>
    }
  }
  check.return
}
