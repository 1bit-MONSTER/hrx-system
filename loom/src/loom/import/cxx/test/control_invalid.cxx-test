// RUN: verify
// Structured iteration exits remain valid only inside a loop.
// ERROR@+1: LOWERING/059 "unsupported statement: continue-statement"
void entry() { continue; }

// ====
// Structured iteration exits remain valid only inside a loop.
// ERROR@+1: LOWERING/059 "unsupported statement: break-statement"
void entry() { break; }

// ====
// Structured iteration exits do not admit unsupported switch conditions.
void entry(unsigned count) {
  while (count) {
    // ERROR@+1: LOWERING/059 "unsupported statement: switch-statement"
    switch (count) {
      case 1:
        continue;
      default:
        --count;
    }
  }
}

// ====
// Continue does not admit other unsupported transfers or conditions.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "returns inside loops require a structured loop-exit projection"
  while (count) {
    if (--count) {
      continue;
    }
    return count;
  }
  return 0;
}

// ====
// Rejects incomplete returns and unprojected exit joins.
// ERROR@+1: LOWERING/059 "non-void function can reach its end without returning a value"
int entry(int x) {
  if (x) {
    return 1;
  }
// WARNING@+1: PARSE/036 "non-void function does not return a value of type 'int' on every path"
}

// ====
// Rejects incomplete returns and unprojected exit joins.
// ERROR@+1: PARSE/036 "non-void function must return a value of type 'int'"
int entry() { return; }

// ====
// Rejects incomplete returns and unprojected exit joins.
// ERROR@+1: PARSE/036 "void function should not return a value"
void entry() { return 1; }

// ====
// Rejects incomplete returns and unprojected exit joins.
int entry(int x, int y) {
  // ERROR@+1: LOWERING/059 "conditional returns require at most one fallthrough arm; shared continuations need a scoped exit projection"
  if (x) {
    if (y) {
      return 1;
    }
    x = 2;
  }
  return x;
}

// ====
// Rejects incomplete returns and unprojected exit joins.
int entry(int x) {
  // ERROR@+1: LOWERING/059 "returns inside loops require a structured loop-exit projection"
  while (x) {
    return x;
  }
  return 0;
}

// ====
// Rejects incomplete returns and unprojected exit joins.
int entry(int x) {
  // ERROR@+1: LOWERING/059 "returns inside loops require a structured loop-exit projection"
  do {
    return x;
  } while (x);
}

// ====
// Rejects incomplete returns and unprojected exit joins.
int entry() {
  // ERROR@+1: LOWERING/059 "returns inside loops require a structured loop-exit projection"
  for (unsigned i = 0; i < 4u; ++i) {
    return 1;
  }
  return 0;
}
