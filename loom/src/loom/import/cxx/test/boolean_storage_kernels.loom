// Boolean objects keep one-byte layout through pointers, records and workgroup storage.
kernel.decl @boolean_objects() launch(%input: buffer, %output: buffer, %number: i32)

kernel.decl @boolean_records() launch(%input: buffer, %output: buffer)

kernel.decl @boolean_shared() launch(%input: buffer, %output: buffer)

check.case @objects_false {
  %input = check.generate.fill value(0) : tensor<1xi8>
  %output = check.generate.fill value(37) : tensor<6xi8>
  %number = check.literal value(0) : i32
  kernel.launch @boolean_objects(%input, %output, %number) : (tensor<1xi8>, tensor<6xi8>, i32)
  %expected_input = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<1xi8>
  %region_0 = check.tensor.view %output offset(0) : tensor<6xi8> -> tensor<1xi8>
  %expected_0 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_0) expected(%expected_0) : tensor<1xi8>
  %region_1 = check.tensor.view %output offset(1) : tensor<6xi8> -> tensor<1xi8>
  %expected_1 = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%region_1) expected(%expected_1) : tensor<1xi8>
  %region_2 = check.tensor.view %output offset(2) : tensor<6xi8> -> tensor<1xi8>
  %expected_2 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_2) expected(%expected_2) : tensor<1xi8>
  %region_3 = check.tensor.view %output offset(3) : tensor<6xi8> -> tensor<2xi8>
  %expected_3 = check.generate.fill value(0) : tensor<2xi8>
  check.expect.bitwise actual(%region_3) expected(%expected_3) : tensor<2xi8>
  %region_5 = check.tensor.view %output offset(5) : tensor<6xi8> -> tensor<1xi8>
  %expected_5 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_5) expected(%expected_5) : tensor<1xi8>
  check.return
}

check.case @objects_true {
  %input = check.generate.fill value(1) : tensor<1xi8>
  %output = check.generate.fill value(37) : tensor<6xi8>
  %number = check.literal value(256) : i32
  kernel.launch @boolean_objects(%input, %output, %number) : (tensor<1xi8>, tensor<6xi8>, i32)
  %expected_input = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<1xi8>
  %region_0 = check.tensor.view %output offset(0) : tensor<6xi8> -> tensor<1xi8>
  %expected_0 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_0) expected(%expected_0) : tensor<1xi8>
  %region_1 = check.tensor.view %output offset(1) : tensor<6xi8> -> tensor<1xi8>
  %expected_1 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_1) expected(%expected_1) : tensor<1xi8>
  %region_2 = check.tensor.view %output offset(2) : tensor<6xi8> -> tensor<2xi8>
  %expected_2 = check.generate.fill value(0) : tensor<2xi8>
  check.expect.bitwise actual(%region_2) expected(%expected_2) : tensor<2xi8>
  %region_4 = check.tensor.view %output offset(4) : tensor<6xi8> -> tensor<1xi8>
  %expected_4 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_4) expected(%expected_4) : tensor<1xi8>
  %region_5 = check.tensor.view %output offset(5) : tensor<6xi8> -> tensor<1xi8>
  %expected_5 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_5) expected(%expected_5) : tensor<1xi8>
  check.return
}

check.case @records_false {
  %input = check.generate.fill value(0) : tensor<14xi8>
  %output = check.generate.fill value(37) : tensor<14xi8>
  kernel.launch @boolean_records(%input, %output) : (tensor<14xi8>, tensor<14xi8>)
  %expected_input = check.generate.fill value(0) : tensor<14xi8>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<14xi8>
  %region_0 = check.tensor.view %output offset(0) : tensor<14xi8> -> tensor<8xi8>
  %expected_0 = check.generate.fill value(37) : tensor<8xi8>
  check.expect.bitwise actual(%region_0) expected(%expected_0) : tensor<8xi8>
  %region_8 = check.tensor.view %output offset(8) : tensor<14xi8> -> tensor<1xi8>
  %expected_8 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_8) expected(%expected_8) : tensor<1xi8>
  %region_9 = check.tensor.view %output offset(9) : tensor<14xi8> -> tensor<2xi8>
  %expected_9 = check.generate.fill value(0) : tensor<2xi8>
  check.expect.bitwise actual(%region_9) expected(%expected_9) : tensor<2xi8>
  %region_11 = check.tensor.view %output offset(11) : tensor<14xi8> -> tensor<2xi8>
  %expected_11 = check.generate.fill value(1) : tensor<2xi8>
  check.expect.bitwise actual(%region_11) expected(%expected_11) : tensor<2xi8>
  %region_13 = check.tensor.view %output offset(13) : tensor<14xi8> -> tensor<1xi8>
  %expected_13 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_13) expected(%expected_13) : tensor<1xi8>
  check.return
}

check.case @records_true {
  %input = check.generate.fill value(1) : tensor<14xi8>
  %output = check.generate.fill value(37) : tensor<14xi8>
  kernel.launch @boolean_records(%input, %output) : (tensor<14xi8>, tensor<14xi8>)
  %expected_input = check.generate.fill value(1) : tensor<14xi8>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<14xi8>
  %region_0 = check.tensor.view %output offset(0) : tensor<14xi8> -> tensor<8xi8>
  %expected_0 = check.generate.fill value(37) : tensor<8xi8>
  check.expect.bitwise actual(%region_0) expected(%expected_0) : tensor<8xi8>
  %region_8 = check.tensor.view %output offset(8) : tensor<14xi8> -> tensor<1xi8>
  %expected_8 = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%region_8) expected(%expected_8) : tensor<1xi8>
  %region_9 = check.tensor.view %output offset(9) : tensor<14xi8> -> tensor<2xi8>
  %expected_9 = check.generate.fill value(1) : tensor<2xi8>
  check.expect.bitwise actual(%region_9) expected(%expected_9) : tensor<2xi8>
  %region_11 = check.tensor.view %output offset(11) : tensor<14xi8> -> tensor<1xi8>
  %expected_11 = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%region_11) expected(%expected_11) : tensor<1xi8>
  %region_12 = check.tensor.view %output offset(12) : tensor<14xi8> -> tensor<1xi8>
  %expected_12 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_12) expected(%expected_12) : tensor<1xi8>
  %region_13 = check.tensor.view %output offset(13) : tensor<14xi8> -> tensor<1xi8>
  %expected_13 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_13) expected(%expected_13) : tensor<1xi8>
  check.return
}

check.case @shared_false {
  %input = check.generate.fill value(0) : tensor<1xi8>
  %output = check.generate.fill value(37) : tensor<4xi8>
  kernel.launch @boolean_shared(%input, %output) : (tensor<1xi8>, tensor<4xi8>)
  %expected_input = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<1xi8>
  %region_0 = check.tensor.view %output offset(0) : tensor<4xi8> -> tensor<1xi8>
  %expected_0 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_0) expected(%expected_0) : tensor<1xi8>
  %region_1 = check.tensor.view %output offset(1) : tensor<4xi8> -> tensor<1xi8>
  %expected_1 = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%region_1) expected(%expected_1) : tensor<1xi8>
  %region_2 = check.tensor.view %output offset(2) : tensor<4xi8> -> tensor<1xi8>
  %expected_2 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_2) expected(%expected_2) : tensor<1xi8>
  %region_3 = check.tensor.view %output offset(3) : tensor<4xi8> -> tensor<1xi8>
  %expected_3 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_3) expected(%expected_3) : tensor<1xi8>
  check.return
}

check.case @shared_true {
  %input = check.generate.fill value(1) : tensor<1xi8>
  %output = check.generate.fill value(37) : tensor<4xi8>
  kernel.launch @boolean_shared(%input, %output) : (tensor<1xi8>, tensor<4xi8>)
  %expected_input = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<1xi8>
  %region_0 = check.tensor.view %output offset(0) : tensor<4xi8> -> tensor<1xi8>
  %expected_0 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_0) expected(%expected_0) : tensor<1xi8>
  %region_1 = check.tensor.view %output offset(1) : tensor<4xi8> -> tensor<1xi8>
  %expected_1 = check.generate.fill value(1) : tensor<1xi8>
  check.expect.bitwise actual(%region_1) expected(%expected_1) : tensor<1xi8>
  %region_2 = check.tensor.view %output offset(2) : tensor<4xi8> -> tensor<1xi8>
  %expected_2 = check.generate.fill value(0) : tensor<1xi8>
  check.expect.bitwise actual(%region_2) expected(%expected_2) : tensor<1xi8>
  %region_3 = check.tensor.view %output offset(3) : tensor<4xi8> -> tensor<1xi8>
  %expected_3 = check.generate.fill value(37) : tensor<1xi8>
  check.expect.bitwise actual(%region_3) expected(%expected_3) : tensor<1xi8>
  check.return
}
