// RUN: roundtrip
#include <loomcxx/vector.h>

using Shorts2 = unsigned short __attribute__((ext_vector_type(2)));
using Floats4 = float __attribute__((ext_vector_type(4)));

Shorts2 load_packet(const unsigned short* input,
                    loom::type::size_type index) {
  auto source = loom::buffer::view<1024>(
      input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load<Shorts2>(source, {index});
}

void store_row(Floats4 value, float* output, loom::type::size_type row,
               loom::type::size_type column) {
  auto destination = loom::buffer::view<16, 32>(
      output, {}, loom::encoding::layout::dense<2>());
  loom::vector::store(value, destination, {row, column});
}

Floats4 load_dynamic_view(const float* input, loom::type::size_type rows,
                          loom::type::size_type row,
                          loom::type::size_type column) {
  auto source = loom::buffer::view<loom::type::dynamic, 32>(
      input, {rows}, loom::encoding::layout::dense<2>());
  return loom::vector::load<Floats4>(source, {row, column});
}

Floats4 load_volatile(const volatile float* input,
                      loom::type::size_type index) {
  auto source = loom::buffer::view<64>(
      input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load<Floats4>(source, {index});
}

// ----
func.def public @load_packet(%input: buffer, %input_byte_offset: offset, %index: i64) -> (vector<2xi16>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<1024xi16, %source_layout>
  %6 = index.cast %index : i64 to index
  %7 = vector.load %source[%6] : view<1024xi16, %source_layout> -> vector<2xi16>
  func.return %7 : vector<2xi16>
}

func.def public @store_row(%value: vector<4xf32>, %output: buffer, %output_byte_offset: offset, %row: i64, %column: i64) {
  %destination_layout = encoding.layout.dense : encoding<layout>
  %destination = buffer.view %output[%output_byte_offset] : buffer -> view<16x32xf32, %destination_layout>
  %15 = index.cast %row : i64 to index
  %16 = index.cast %column : i64 to index
  vector.store %value, %destination[%15, %16] : vector<4xf32>, view<16x32xf32, %destination_layout>
  func.return
}

func.def public @load_dynamic_view(%input: buffer, %input_byte_offset: offset, %rows: i64, %row: i64, %column: i64) -> (vector<4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source_dim0 = index.cast %rows : i64 to index
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<[%source_dim0]x32xf32, %source_layout>
  %26 = index.cast %row : i64 to index
  %27 = index.cast %column : i64 to index
  %28 = vector.load %source[%26, %27] : view<[%source_dim0]x32xf32, %source_layout> -> vector<4xf32>
  func.return %28 : vector<4xf32>
}

func.def public @load_volatile(%input: buffer, %input_byte_offset: offset, %index: i64) -> (vector<4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<64xf32, %source_layout>
  %35 = index.cast %index : i64 to index
  %36 = vector.load<volatile> %source[%35] : view<64xf32, %source_layout> -> vector<4xf32>
  func.return %36 : vector<4xf32>
}
