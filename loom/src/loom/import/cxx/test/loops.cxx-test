  %depth = scalar.constant 1 : i32
  %total$2 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %4 = index.cast %index : i32 to offset
  %5 = scalar.constant 4 : i32
  %6 = index.cast %5 : i32 to offset
  %7 = index.constant 1 : offset
  %8 = scalar.extui %depth : i32 to i64
  %9 = index.cast %8 : i64 to index
  %total$12 = scf.for %index = [%4 to %6 step %7](%total$11 = %total$2 : i32) -> (i32) pipeline(%9) unroll schedule(recurrence) {
    %13 = index.cast %index : offset to i32
    %total$14 = scalar.addi %total$11, %13 : i32
    scf.yield %total$14 : i32
  }
  func.return %total$12 : i32
}

// ====
// RUN: roundtrip
// Wide loop comparison retains induction wraparound.
unsigned entry(unsigned long long upper) {
  unsigned sum = 0;
  for (unsigned i = 0; i < upper; ++i) {
    sum += i;
  }
  return sum;
}
