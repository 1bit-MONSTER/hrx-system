// ====
// RUN: roundtrip
// Bare unroll and constant expressions retain loop schedules.
int entry() {
  constexpr unsigned depth = 1;
  int total = 0;
  [[using loom: unroll, pipeline(depth), schedule("recurrence")]]
  for (unsigned index = 0; index < 4u; ++index) {
    total += (int)index;
  }
  return total;
}
// ----
func.def public @entry() -> (i32) {
  %depth = scalar.constant 1 : i32
  %total$2 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %4 = index.cast %index : i32 to offset
  %5 = scalar.constant 4 : i32
  %6 = index.cast %5 : i32 to offset
  %7 = index.constant 1 : offset
  %8 = scalar.extui %depth : i32 to i64
  %9 = index.cast %8 : i64 to index
  %total$12 = scf.for %index = [%4 to %6 step %7](%total$11 = %total$2 : i32) -> (i32) pipeline(%9) unroll schedule(recurrence) {
    %13 = index.cast %index : offset to i32
    %total$14 = scalar.addi %total$11, %13 : i32
    scf.yield %total$14 : i32
  }
  func.return %total$12 : i32
}

// ====
// RUN: roundtrip
// Wide loop comparison retains induction wraparound.
unsigned entry(unsigned long long upper) {
  unsigned sum = 0;
  for (unsigned i = 0; i < upper; ++i) {
    sum += i;
  }
  return sum;
}
// ----
func.def public @entry(%upper: i64) -> (i32) {
  %sum$2 = scalar.constant 0 : i32
  %i$3 = scalar.constant 0 : i32
  %i$8, %sum$9 = scf.while(%i = %i$3 : i32, %sum = %sum$2 : i32) -> (i32, i32) {
    %10 = scalar.extui %i : i32 to i64
    %11 = scalar.cmpi ult, %10, %upper : i64
    scf.condition %11, %i, %sum : i1, i32, i32
  } do(%i$6: i32, %sum$7: i32) {
    %sum$12 = scalar.addi %sum$7, %i$6 : i32
    %13 = scalar.constant 1 : i32
    %i$14 = scalar.addi %i$6, %13 : i32
    scf.yield %i$14, %sum$12 : i32, i32
  }
  func.return %sum$9 : i32
}
