    %48, %total$49 = scf.if %47 -> (i1, i32) {
      %50 = scalar.constant 0 : i1
      scf.yield %50, %total$39 : i1, i32
    } else {
      %total = scalar.addi %total$39, %index : i32
      %52 = scalar.constant 1 : i1
      scf.yield %52, %total : i1, i32
    }
    scf.yield %index, %total$49 : i32, i32
  }
  %total$57, %index$58 = scf.while(%total$53 = %total$41 : i32, %index$54 = %index$40 : i32) -> (i32, i32) {
    %59 = scalar.andi %index$54, %choose : i32
