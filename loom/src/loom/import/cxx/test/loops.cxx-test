// ====
// RUN: roundtrip
// A break in an otherwise counted for loop uses an early-exit while and skips
// the source step.
unsigned entry(unsigned count, unsigned stop) {
  unsigned total = 0;
  for (unsigned index = 0; index < count; ++index) {
    total += index;
    if (index == stop) {
      break;
    }
  }
  return total;
}
