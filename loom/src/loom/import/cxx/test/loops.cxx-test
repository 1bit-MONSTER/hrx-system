// ====
// RUN: roundtrip
// A do break suppresses its trailing condition while continue evaluates it.
unsigned entry(unsigned count, unsigned stop) {
  unsigned value = 0;
  unsigned checks = 0;
  do {
    ++value;
    if (value == stop) {
      break;
    }
    if (value & 1u) {
      continue;
    }
    value += 10u;
  } while (++checks < count);
  return value * 100u + checks;
}
