      %30 = index.cast %29 : i64 to offset
      %31 = buffer.view %input[%30] : buffer -> view<1xi32>
      %32 = view.load %31[0] : view<1xi32> -> i32
      %total = scalar.addi %total$15, %32 : i32
      %34 = scalar.constant 1 : i1
      scf.yield %34, %total : i1, i32
    }
    scf.yield %total$22 : i32
  }
  %index$35 = scalar.constant 0 : i32
  %index$40, %total$41 = scf.while(%index$36 = %index$35 : i32, %total = %total$16 : i32) -> (i32, i32) {
    %42 = scalar.constant 1 : i32
