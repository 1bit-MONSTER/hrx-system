// RUN: with-checks roundtrip
// The discarded switch is valid C++ but has no importer projection.
int entry(int value) {
  if constexpr (false) {
    switch (value) {
      case 1: return 20;
      default: return 30;
    }
  }
  if constexpr (true) return value + 1;
  else return value - 1;
}
// ----
// CHECK: func.def public @entry(%value: i32) -> (i32) {
// CHECK: *scalar.addi*
// CHECK-NOT: *scf.if*
// CHECK-NOT: *scalar.subi*

// ====
// A constant initializer can supply the selection after substitution.
template <unsigned Bias>
static unsigned select(unsigned value) {
  if constexpr (const unsigned bias = Bias; bias > 3) return value + bias;
  else return value - bias;
}
unsigned entry(unsigned value) { return select<5>(value) + select<2>(value); }
// ----
// CHECK: func.def public @entry(%value: i32) -> (i32) {
// CHECK: *scalar.addi*
// CHECK: *scalar.subi*
// CHECK-NOT: *scf.if*

// ====
// Discarded dependent expressions need no implementation for this source type.
template <class T>
static auto select(T value) {
  if constexpr (sizeof(T) == sizeof(int)) return value + 1;
  else return value.missing();
}
int entry(int value) { return select(value); }
// ----
// CHECK: func.def public @entry(%value: i32) -> (i32) {
// CHECK: *scalar.addi*
// CHECK-NOT: *scf.if*

// ====
// Concrete return types can differ between specializations.
template <bool Floating>
static auto select(int value) {
  if constexpr (Floating) return float(value);
  else return value;
}
float floating(int value) { return select<true>(value); }
int integer(int value) { return select<false>(value); }
// ----
// CHECK: func.def public @floating(%value: i32) -> (f32) {
// CHECK: func.def public @integer(%value: i32) -> (i32) {
// CHECK: *scalar.sitofp*
// CHECK-NOT: *scf.if*

// ====
// Discarded writes and exits do not prevent a scheduled counted loop.
unsigned entry(unsigned count) {
  unsigned total = 0;
  [[loom::unroll(2)]]
  for (unsigned index = 0; index < count; ++index) {
    if constexpr (false) {
      --count;
      return 100;
    }
    if constexpr (true) {
      if (index & 1u) continue;
    }
    total += index;
  }
  return total;
}
// ----
// CHECK: func.def public @entry(%count: i32) -> (i32) {
// CHECK: *scf.for*unroll(*)*
// CHECK-NOT: *scf.while*
// CHECK-NOT: *scalar.subi*

// ====
// Initializer bindings participate in runtime regions just like outer locals.
unsigned entry(unsigned value, bool selected) {
  if (unsigned original = value++; selected) value += original;
  return value;
}
// ----
// CHECK: func.def public @entry(*, %selected: i1) -> (i32) {
// CHECK: *scf.if %selected*
// CHECK: *scalar.addi*

