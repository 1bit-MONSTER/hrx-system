// RUN: with-checks roundtrip
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void update(unsigned* output, unsigned value) { output[0] = value; }
LOOM_CHECK_CASE(resource_values) {
  loom::check::require("hal.amdgpu.descriptor_set", "descriptor_set", "amdgpu.rdna3_5.core");
  const auto storage = loom::check::fill<unsigned, 4>(37u);
  const auto alias = storage;
  const auto selected = loom::check::slice<2>(alias, 1);
  loom::check::launch<update>(selected, 13u);
  loom::check::expect_bitwise(loom::check::slice<1>(storage, 1),
                            loom::check::fill<unsigned, 1>(13u));
}
LOOM_CHECK_BENCHMARK(resource_benchmark, resource_values);
// ----
CHECK: check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.rdna3_5.core"}
CHECK: * = check.generate.fill value(37) : tensor<4xi32>
CHECK: %selected = check.tensor.view * offset(4) : tensor<4xi32> -> tensor<2xi32>
CHECK: kernel.launch @update(%selected, *) : (tensor<2xi32>, i32)
CHECK: check.expect.bitwise actual(*) expected(*) : tensor<1xi32>
CHECK: check.benchmark<@resource_values> @resource_benchmark

// ====
// RUN: verify
#include <loomcxx/check.h>
unsigned runtime_value() { return 7; }
LOOM_CHECK_CASE(runtime_fill) {
  // ERROR@+1: LOWERING/059 "check attributes require pure scalar constants"
  const auto storage = loom::check::fill<unsigned, 1>(runtime_value());
}

// ====
// RUN: verify
#include <loomcxx/check.h>
unsigned runtime_value() { return 0; }
LOOM_CHECK_CASE(runtime_offset) {
  const auto storage = loom::check::fill<unsigned, 4>(7u);
  // ERROR@+1: LOWERING/059 "check tensor slice must select an in-bounds constant element range"
  const auto selected = loom::check::slice<1>(storage, runtime_value());
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(past_end) {
  const auto storage = loom::check::fill<unsigned, 4>(7u);
  // ERROR@+1: LOWERING/059 "check tensor slice must select an in-bounds constant element range"
  const auto selected = loom::check::slice<2>(storage, 3);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(negative_offset) {
  const auto storage = loom::check::fill<unsigned, 4>(7u);
  // ERROR@+1: LOWERING/059 "check tensor slice must select an in-bounds constant element range"
  const auto selected = loom::check::slice<1>(storage, -1);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
void ordinary(unsigned* output) { output[0] = 7; }
LOOM_CHECK_CASE(not_a_kernel) {
  const auto storage = loom::check::fill<unsigned, 1>(0u);
  // ERROR@+1: LOWERING/059 "kernel.launch requires a kernel as its first template argument"
  loom::check::launch<ordinary>(storage);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel]] void update(unsigned* output, unsigned value) { output[0] = value; }
LOOM_CHECK_CASE(wrong_argument_count) {
  const auto storage = loom::check::fill<unsigned, 1>(0u);
  // ERROR@+1: LOWERING/059 "kernel.launch arguments must match the kernel signature"
  loom::check::launch<update>(storage);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel]] void update(unsigned* output, unsigned value) { output[0] = value; }
LOOM_CHECK_CASE(wrong_scalar_type) {
  const auto storage = loom::check::fill<unsigned, 1>(0u);
  // ERROR@+1: LOWERING/059 "kernel.launch scalar arguments must match the kernel parameter types"
  loom::check::launch<update>(storage, 7.0f);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel]] void update(unsigned* output) { output[0] = 7; }
LOOM_CHECK_CASE(late_launch) {
  const auto storage = loom::check::fill<unsigned, 1>(0u);
  loom::check::expect_bitwise(storage, storage);
  // ERROR@+1: LOWERING/059 "check expectations must be terminal"
  loom::check::launch<update>(storage);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(unpaired_metadata) {
  // ERROR@+1: LOWERING/059 "check metadata requires a provider followed by name/value pairs"
  loom::check::require("provider", "missing_value");
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(duplicate_metadata) {
  // ERROR@+1: LOWERING/059 "duplicate check metadata attribute"
  loom::check::require("provider", "count", 1, "count", 2);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
unsigned runtime_value() { return 7; }
LOOM_CHECK_CASE(runtime_metadata) {
  // ERROR@+1: LOWERING/059 "check attributes require pure scalar constants"
  loom::check::require("provider", "count", runtime_value());
}

// ====
// RUN: verify
#include <loomcxx/check.h>
void ordinary() {
  // ERROR@+1: LOWERING/059 "check declarations cannot be called from ordinary functions"
  const auto storage = loom::check::fill<unsigned, 1>(0u);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(boolean_elements) {
  // ERROR@+1: LOWERING/059 "tensor elements require unqualified non-boolean scalar types"
  const auto storage = loom::check::fill<bool, 1>(true);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(qualified_elements) {
  // ERROR@+1: LOWERING/059 "tensor elements require unqualified non-boolean scalar types"
  const auto storage = loom::check::fill<const unsigned, 1>(7u);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(overflowing_byte_length) {
  // ERROR@+1: LOWERING/059 "tensor extent requires a nonnegative constant with a representable byte length"
  const auto storage = loom::check::fill<unsigned long long, 0x2000000000000000ULL>(7ULL);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
// ERROR@+1: LOWERING/059 "check operation requires a tensor handle"
[[loom::op("check.generate.fill")]] unsigned bad_fill(unsigned value);

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(metadata_name) {
  // ERROR@+1: LOWERING/059 "check metadata requires string names and scalar or string values"
  loom::check::require("provider", 1, 2);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
const char* provider_name();
LOOM_CHECK_CASE(metadata_provider) {
  // ERROR@+1: LOWERING/059 "check attributes require a string literal"
  loom::check::require(provider_name(), "count", 0);
}

// ====
// RUN: with-checks roundtrip
#include <loomcxx/check.h>
LOOM_CHECK_CASE(typed_metadata) {
  loom::check::require("custom", "enabled", true, "rate", 0.5, "mode", "one");
}
// ----
CHECK: check.requires<custom> {enabled = true, mode = "one", rate = 0.5}
