// RUN: roundtrip
#include <loomcxx/check.h>
#include <loomcxx/view.h>

unsigned long long combine(loom::check::ordinal configuration,
                           loom::check::ordinal trial,
                           unsigned long long entropy) {
  return configuration + trial + entropy;
}

unsigned long long identity(unsigned long long value) { return value; }

unsigned long long identity_oracle(unsigned long long value) { return value; }

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]] void
write_value(unsigned* output, unsigned value) {
  output[0] = value;
}

void write_value_oracle(loom::type::buffer<unsigned> output, unsigned value) {
  auto values =
      loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  loom::view::store(value, values, 0);
}

[[loom::check_scenario(3)]]
void configured(loom::check::ordinal configuration,
                loom::check::entropy scenario_entropy) {
  loom::check::trial<2>(
      [&](loom::check::ordinal trial, loom::check::entropy trial_entropy) {
        const auto stream = loom::check::fork(trial_entropy, "input");
        const auto word = loom::check::read(stream, trial);
        const auto input =
            loom::check::generate<combine>(configuration, trial, word);
        loom::check::compare<identity, identity_oracle>(
            input, [](unsigned long long actual,
                      unsigned long long expected) {
              loom::check::expect_equal(actual, expected);
            });
      });
}

LOOM_CHECK_BENCHMARK(configured_benchmark, configured);

LOOM_CHECK_SCENARIO(tensor_actions) {
  loom::check::trial<1>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        const auto storage = loom::check::fill<1, unsigned>(0u);
        loom::check::compare<write_value, write_value_oracle>(storage, 7u, [&] {
          loom::check::expect_bitwise(storage, storage);
        });
      });
  loom::check::trial<1>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        const auto storage = loom::check::fill<1, unsigned>(0u);
        loom::check::invoke<write_value>(storage, 11u);
      });
}

loom::type::index runtime_element_count(loom::check::ordinal trial) {
  return loom::index::cast((unsigned long long)trial + 3ull);
}

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]] void
copy_first(const int* input, int* output) {
  output[0] = input[0];
}

LOOM_CHECK_SCENARIO(dynamic_tensor_actions) {
  loom::check::trial<2>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        const auto element_count =
            loom::check::generate<runtime_element_count>(trial);
        const auto input = loom::check::iota(element_count, -100, 37, 5);
        const auto filled = loom::check::fill(element_count, 9);
        const auto storage = loom::check::fill<39, int>(-123);
        const auto output = loom::check::slice(storage, 16, element_count);
        loom::check::compare<copy_first>(input, output, [&] {
          loom::check::expect_bitwise(input, input);
          loom::check::expect_bitwise(filled, filled);
          loom::check::expect_bitwise(output, output);
        });
      });
}

// ----
func.def public @combine(%configuration: index, %trial: index, %entropy: i64) -> (i64) {
  %4 = index.cast %configuration : index to i64
  %5 = index.cast %trial : index to i64
  %6 = scalar.addi %4, %5 : i64
  %7 = scalar.addi %6, %entropy : i64
  func.return %7 : i64
}

func.def public @identity(%value: i64) -> (i64) {
  func.return %value : i64
}

func.def public @identity_oracle(%value: i64) -> (i64) {
  func.return %value : i64
}

kernel.def @write_value() {
  %14 = index.constant 1 : index
  %15 = index.constant 1 : index
  %16 = index.constant 1 : index
  %17 = index.constant 1 : index
  %18 = index.constant 1 : index
  %19 = index.constant 1 : index
  kernel.launch.config workgroups(%14, %15, %16) workgroup_size(%17, %18, %19) : index
} launch(%output: buffer, %value: i32) {
  %output_byte_offset = index.constant 0 : offset
  %21 = scalar.constant 0 : i32
  %22 = scalar.extsi %21 : i32 to i64
  %23 = scalar.constant 4 : i64
  %24 = scalar.muli %22, %23 : i64
  %25 = index.cast %output_byte_offset : offset to i64
  %26 = scalar.addi %25, %24 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %28 = index.cast %27 : i64 to offset
  %29 = buffer.view %output[%28] : buffer -> view<1xi32>
  view.store %value, %29[0] : i32, view<1xi32>
  kernel.return
}

func.def public @write_value_oracle(%output: buffer, %value: i32) {
  %values_layout = encoding.layout.dense : encoding<layout>
  %33 = index.constant 0 : offset
  %values = buffer.view %output[%33] : buffer -> view<1xi32, %values_layout>
  %35 = scalar.constant 0 : i32
  %36 = index.cast %35 : i32 to index
  view.store %value, %values[%36] : i32, view<1xi32, %values_layout>
  func.return
}

check.scenario public @configured configure[3](%configuration: index, %scenario_entropy: check.entropy) {
  check.trial[2](%trial: index, %trial_entropy: check.entropy) {
    %stream = check.entropy.fork %trial_entropy name("input") : check.entropy
    %word = check.entropy.read %stream[%trial] : check.entropy -> i64
    %input = check.generate<@combine>(%configuration, %trial, %word) : (index, index, i64) -> (i64)
    check.compare<@identity, @identity_oracle>(%input) : (i64) -> [actual(%actual: i64), expected(%expected: i64)] {
      check.expect.equal actual(%actual) expected(%expected) : i64
    }
  }
  check.return
}

check.scenario public @tensor_actions {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(0) : tensor<1xi32>
    %49 = check.literal value(7) : i32
    check.compare<@write_value, @write_value_oracle>(%storage, %49) : (tensor<1xi32>, i32) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<1xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(0) : tensor<1xi32>
    %53 = check.literal value(11) : i32
    check.invoke<@write_value>(%storage, %53) : (tensor<1xi32>, i32) -> ()
  }
  check.return
}

func.def public @runtime_element_count(%trial: index) -> (index) {
  %56 = index.cast %trial : index to i64
  %57 = scalar.constant 3 : i64
  %58 = scalar.addi %56, %57 : i64
  %59 = index.cast %58 : i64 to index
  func.return %59 : index
}

kernel.def @copy_first() {
  %62 = index.constant 1 : index
  %63 = index.constant 1 : index
  %64 = index.constant 1 : index
  %65 = index.constant 1 : index
  %66 = index.constant 1 : index
  %67 = index.constant 1 : index
  kernel.launch.config workgroups(%62, %63, %64) workgroup_size(%65, %66, %67) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : offset
  %output_byte_offset = index.constant 0 : offset
  %70 = scalar.constant 0 : i32
  %71 = scalar.extsi %70 : i32 to i64
  %72 = scalar.constant 4 : i64
  %73 = scalar.muli %71, %72 : i64
  %74 = index.cast %input_byte_offset : offset to i64
  %75 = scalar.addi %74, %73 : i64
  %76 = scalar.assume %75 [range(%75, 0, 9223372036854775807)] : i64
  %77 = index.cast %76 : i64 to offset
  %78 = buffer.view %input[%77] : buffer -> view<1xi32>
  %79 = view.load %78[0] : view<1xi32> -> i32
  %80 = scalar.constant 0 : i32
  %81 = scalar.extsi %80 : i32 to i64
  %82 = scalar.constant 4 : i64
  %83 = scalar.muli %81, %82 : i64
  %84 = index.cast %output_byte_offset : offset to i64
  %85 = scalar.addi %84, %83 : i64
  %86 = scalar.assume %85 [range(%85, 0, 9223372036854775807)] : i64
  %87 = index.cast %86 : i64 to offset
  %88 = buffer.view %output[%87] : buffer -> view<1xi32>
  view.store %79, %88[0] : i32, view<1xi32>
  kernel.return
}

check.scenario public @dynamic_tensor_actions {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %element_count = check.generate<@runtime_element_count>(%trial) : (index) -> (index)
    %input = check.generate.iota offset(-100) step(37) period(5) : tensor<[%element_count]xi32>
    %filled = check.generate.fill value(9) : tensor<[%element_count]xi32>
    %storage = check.generate.fill value(-123) : tensor<39xi32>
    %output = check.tensor.view %storage offset(64) : tensor<39xi32> -> tensor<[%element_count]xi32>
    check.compare<@copy_first>(%input, %output) : (tensor<[%element_count]xi32>, tensor<[%element_count]xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%element_count]xi32>
      check.expect.bitwise actual(%filled) expected(%filled) : tensor<[%element_count]xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<[%element_count]xi32>
    }
  }
  check.return
}

check.benchmark<@configured> @configured_benchmark
