// RUN: pass canonicalize,cse,dce
// Repeated observations survive cleanup even when their values are discarded.
unsigned observations(const volatile unsigned* input, volatile unsigned* output) {
  input[0];
  static_cast<void>(input[0]);
  (void)*input;
  (void(*input));
  unsigned first = input[0];
  unsigned second = input[0];
  output[0] = first;
  output[0] = second;
  return first + second;
}
// ----
func.def public @observations(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) -> (i32) {
  %9 = index.cast %input_byte_offset : offset to i64
  %11 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %12 = index.cast %11 : i64 to offset
  %13 = buffer.view %input[%12] : buffer -> view<1xi32>
  %14 = view.load<volatile> %13[0] : view<1xi32> -> i32
  %24 = view.load<volatile> %13[0] : view<1xi32> -> i32
  %25 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi32>
  %26 = view.load<volatile> %25[0] : view<1xi32> -> i32
  %28 = view.load<volatile> %25[0] : view<1xi32> -> i32
  %first = view.load<volatile> %13[0] : view<1xi32> -> i32
  %second = view.load<volatile> %13[0] : view<1xi32> -> i32
  %53 = index.cast %output_byte_offset : offset to i64
  %55 = scalar.assume %53 [range(%53, 0, 9223372036854775807)] : i64
  %56 = index.cast %55 : i64 to offset
  %57 = buffer.view %output[%56] : buffer -> view<1xi32>
  view.store<volatile> %first, %57[0] : i32, view<1xi32>
  view.store<volatile> %second, %57[0] : i32, view<1xi32>
  %67 = scalar.addi %first, %second : i32
  func.return %67 : i32
}

// ====
// Ordinary reads still coalesce and unused reads disappear.
unsigned ordinary(const unsigned* input, unsigned* output) {
  input[0];
  static_cast<void>(input[0]);
  (void)*input;
  (void(*input));
  unsigned first = input[0];
  unsigned second = input[0];
  output[0] = first;
  output[0] = second;
  return first + second;
}
// ----
func.def public @ordinary(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) -> (i32) {
  %33 = index.cast %input_byte_offset : offset to i64
  %35 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
  %36 = index.cast %35 : i64 to offset
  %37 = buffer.view %input[%36] : buffer -> view<1xi32>
  %first = view.load %37[0] : view<1xi32> -> i32
  %53 = index.cast %output_byte_offset : offset to i64
  %55 = scalar.assume %53 [range(%53, 0, 9223372036854775807)] : i64
  %56 = index.cast %55 : i64 to offset
  %57 = buffer.view %output[%56] : buffer -> view<1xi32>
  view.store %first, %57[0] : i32, view<1xi32>
  view.store %first, %57[0] : i32, view<1xi32>
  %67 = scalar.addi %first, %first : i32
  func.return %67 : i32
}

// ====
// Pointer members and helper boundaries preserve the pointee qualifier.
struct Source { const volatile unsigned* data; };
static unsigned read(Source source) { return source.data[1]; }
unsigned through_helper(const unsigned* input) {
  Source source{input};
  return read(source);
}
// ----
func.def public @through_helper(%input: buffer, %input_byte_offset: offset) -> (i32) {
  %3 = func.call @read(%input, %input_byte_offset) : (buffer, offset) -> (i32)
  func.return %3 : i32
}

func.def @read(%source_data: buffer, %source_data_byte_offset: offset) -> (i32) {
  %17 = scalar.constant 4 : i64
  %11 = index.cast %source_data_byte_offset : offset to i64
  %12 = scalar.addi %11, %17 : i64
  %13 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = buffer.view %source_data[%14] : buffer -> view<1xi32>
  %16 = view.load<volatile> %15[0] : view<1xi32> -> i32
  func.return %16 : i32
}

// ====
// Whole-vector observations retain every lane even with a scalar result.
using Words = unsigned __attribute__((vector_size(16)));
unsigned vector_observations(const volatile Words* input, volatile Words* output) {
  *input;
  Words value = input[0];
  output[0] = value;
  output[0] = value;
  return value[2];
}
// ----
func.def public @vector_observations(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) -> (i32) {
  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<4xi32>
  %6 = vector.load<volatile> %5[0] : view<4xi32> -> vector<4xi32>
  %11 = index.cast %input_byte_offset : offset to i64
  %13 = scalar.assume %11 [range(%11, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = buffer.view %input[%14] : buffer -> view<4xi32>
  %value = vector.load<volatile> %15[0] : view<4xi32> -> vector<4xi32>
  %21 = index.cast %output_byte_offset : offset to i64
  %23 = scalar.assume %21 [range(%21, 0, 9223372036854775807)] : i64
  %24 = index.cast %23 : i64 to offset
  %25 = buffer.view %output[%24] : buffer -> view<4xi32>
  vector.store<volatile> %value, %25[0] : vector<4xi32>, view<4xi32>
  vector.store<volatile> %value, %25[0] : vector<4xi32>, view<4xi32>
  %38 = vector.extract %value[2] : vector<4xi32> -> i32
  func.return %38 : i32
}

// ====
// Workgroup allocation supplies real storage for volatile scalar elements.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void shared_observations(unsigned* output, unsigned value) {
  [[loom::workgroup]] volatile unsigned table[4];
  table[2] = value;
  table[2];
  output[0] = table[2];
}
// ----
kernel.def @shared_observations() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%output: buffer, %value: i32) {
  %9 = index.constant 16 : offset
  %table = buffer.alloca<workgroup> align(4) %9 : buffer
  %table_byte_offset = index.constant 0 : offset
  %table_view = buffer.view %table[%table_byte_offset] : buffer -> view<4xi32>
  %39 = index.constant 2 : index
  view.store<volatile> %value, %table_view[%39] : i32, view<4xi32>
  %21 = view.load<volatile> %table_view[%39] : view<4xi32> -> i32
  %26 = view.load<volatile> %table_view[%39] : view<4xi32> -> i32
  %35 = buffer.view %output[%table_byte_offset] : buffer -> view<1xi32>
  view.store %26, %35[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: with-checks roundtrip
// A volatile scalar workgroup object retains every source observation.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void shared_scalar(unsigned* output, unsigned value) {
  [[loom::workgroup]] volatile unsigned slot;
  slot = value;
  static_cast<void>(slot);
  output[0] = slot;
}
// ----
CHECK: *buffer.alloca<workgroup>*
CHECK: *view.store<volatile> %value*
CHECK: *view.load<volatile>*
CHECK: *view.load<volatile>*

// ====
// Void returns share the discarded-value path without rereading assignments.
void discarded_return(volatile unsigned* output) {
  return static_cast<void>(*output = 7);
}
// ----
func.def public @discarded_return(%output: buffer, %output_byte_offset: offset) {
  %2 = scalar.constant 7 : i32
  %3 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %2, %3[0] : i32, view<1xi32>
  func.return
}

// ====
// INPUT: cxx std=c23
// C discarded reads and stores use the same object qualification.
unsigned c_observations(const volatile unsigned* input, volatile unsigned* output) {
  (void)*input;
  unsigned value = *input;
  *output = value;
  return value;
}
// ----
func.def public @c_observations(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) -> (i32) {
  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi32>
  %6 = view.load<volatile> %5[0] : view<1xi32> -> i32
  %value = view.load<volatile> %5[0] : view<1xi32> -> i32
  %9 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %value, %9[0] : i32, view<1xi32>
  func.return %value : i32
}
