load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_config_compatible_with")

package(default_visibility = ["//visibility:public"])

loom_cc_binary(
    name = "loom-import-cxx",
    srcs = ["loom-import-cxx.c"],
    deps = [
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/bytecode:writer",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/import/cxx",
        "//loom/src/loom/pass:builtin_registry",
        "//loom/src/loom/pass:tooling",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/configured:provider_set",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/context",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/transforms/cleanup:configured",
        "//loom/src/loom/transforms/cleanup:pass_environment",
        "//loom/src/loom/transforms/cleanup:patterns",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:stream",
    ],
)

iree_execution_test_suite(
    name = "execution_test",
    data = glob(["testdata/*"]) + [
        "//loom/src/loom/import/cxx:include/hip/hip_fp16.h",
        "//loom/src/loom/import/cxx:include/hip/hip_runtime.h",
        "//loom/src/loom/import/cxx:include/loomcxx/atomic.h",
        "//loom/src/loom/import/cxx:include/loomcxx/kernel.h",
        "//loom/src/loom/import/cxx:include/loomcxx/math.h",
        "//loom/src/loom/import/cxx:include/loomcxx/scalar.h",
        "//loom/src/loom/import/cxx:include/loomcxx/view.h",
    ],
    manifests = ["loom-import-cxx.test.json"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    tools = {
        "loom-format": "//loom/src/loom/tools/loom-format",
        "loom-import-cxx": ":loom-import-cxx",
    },
)
