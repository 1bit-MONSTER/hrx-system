kernel.def @increment() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<1xi32>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %increment = scalar.constant 1 : i32
  %result = scalar.addi %value, %increment : i32
  view.store %result, %output_view[0] : i32, view<1xi32>
  kernel.return
}

check.case @increment_case {
  %input = check.generate.fill value(41) : tensor<1xi32>
  %output = check.generate.fill value(0) : tensor<1xi32>
  %expected = check.generate.fill value(42) : tensor<1xi32>
  kernel.launch @increment(%input, %output) : (tensor<1xi32>, tensor<1xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<1xi32>
  check.return
}

check.benchmark<@increment_case> @increment_case_latency

check.scenario @increment_scenario {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(41) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<1xi32>
    check.invoke<@increment>(%input, %output) : (tensor<1xi32>, tensor<1xi32>) -> ()
  }
  check.return
}

check.benchmark<@increment_scenario> @increment_scenario_latency
