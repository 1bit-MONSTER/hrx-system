{
  "version": 1,
  "cases": [
    {
      "name": "legacy template directives are rejected",
      "steps": [
        {
          "name": "fixture",
          "write": {
            "path": "{tmp}/fixture.loom-test",
            "text": "// TEMPLATE: shared.loom-test\n// RUN: roundtrip\n\nfunc.def @alpha() {\n}\n"
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "loom-check",
            "args": [
              "{tmp}/fixture.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "contains": [
              "TEMPLATE directives are no longer supported"
            ]
          }
        }
      ]
    },
    {
      "name": "ordinary execution rejects multiple files",
      "run": {
        "tool": "loom-check",
        "args": [
          "first.loom-test",
          "second.loom-test"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "at most one input file"
        ]
      }
    }
  ]
}
