load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_binary",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target/wasm:execution_profiles.bzl", "WASM_NODE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_TARGET_COPTS = iree_select({
    "//loom/config/execute:amdgpu_hal": [
        "-DIREE_TEST_LOOM_HAVE_AMDGPU=1",
    ],
    "//conditions:default": [],
})

_AMDGPU_TARGET_DEPS = iree_select({
    "//loom/config/execute:amdgpu_hal": [
        "//loom/src/loom/target/arch/amdgpu:provider",
        "//loom/src/loom/tooling/target/amdgpu:device_provider",
        "//loom/src/loom/tooling/target/amdgpu:testbench_requirements",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_TARGET_COPTS = iree_select({
    "//loom/config/execute:spirv_vulkan_hal": [
        "-DIREE_TEST_LOOM_HAVE_SPIRV=1",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_TARGET_DEPS = iree_select({
    "//loom/config/execute:spirv_vulkan_hal": [
        "//loom/src/loom/target/arch/spirv:provider",
        "//loom/src/loom/tooling/target/spirv:device_provider",
        "//loom/src/loom/tooling/target/spirv:testbench_requirements",
    ],
    "//conditions:default": [],
})

_VM_TARGET_COPTS = iree_select({
    "//loom/config/target/arch:vm": ["-DIREE_TEST_LOOM_HAVE_VM=1"],
    "//conditions:default": [],
})

_VM_TARGET_DEPS = iree_select({
    "//loom/config/target/arch:vm": [
        "//loom/src/loom/target/arch/vm:provider",
        "//loom/src/loom/tooling/target/vm:testbench",
    ],
    "//conditions:default": [],
})

_WASM_TARGET_COPTS = iree_select({
    "//loom/config/target:wasm_artifacts": [
        "-DIREE_TEST_LOOM_HAVE_WASM=1",
    ],
    "//conditions:default": [],
})

_WASM_TARGET_DEPS = iree_select({
    "//loom/config/target:wasm_artifacts": [
        "//loom/src/loom/target/arch/wasm:provider",
        "//loom/src/loom/tooling/target/wasm:testbench",
    ],
    "//conditions:default": [],
})

_IREE_TEST_LOOM_TARGET_COPTS = (
    _AMDGPU_TARGET_COPTS +
    _SPIRV_VULKAN_TARGET_COPTS +
    _VM_TARGET_COPTS +
    _WASM_TARGET_COPTS
)

_IREE_TEST_LOOM_TARGET_DEPS = (
    _AMDGPU_TARGET_DEPS +
    _SPIRV_VULKAN_TARGET_DEPS +
    _VM_TARGET_DEPS +
    _WASM_TARGET_DEPS
)

loom_cc_library(
    name = "library_linker",
    srcs = ["library_linker.c"],
    hdrs = ["library_linker.h"],
    deps = [
        "//loom/src/loom/error:source",
        "//loom/src/loom/link:linker",
        "//loom/src/loom/tooling/execution:session",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/io:source",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "library_linker_test",
    srcs = ["library_linker_test.cc"],
    tags = ["requires-filesystem"],
    deps = [
        ":library_linker",
        "//loom/src/loom/error:source",
        "//loom/src/loom/tooling/execution:session",
        "//loom/src/loom/tooling/io:file",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

loom_cc_library(
    name = "main",
    srcs = [
        "main.c",
    ],
    hdrs = [
        "main.h",
    ],
    deps = [
        ":library_linker",
        "//loom/src/loom/sanitizer:options",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target:selection",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/config",
        "//loom/src/loom/tooling/context",
        "//loom/src/loom/tooling/execution:session",
        "//loom/src/loom/tooling/execution/hal:device_provider",
        "//loom/src/loom/tooling/execution/hal:scenario_profile",
        "//loom/src/loom/tooling/execution/hal:testbench_actual",
        "//loom/src/loom/tooling/input:flags",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/testbench:device_event",
        "//loom/src/loom/tooling/testbench:executor",
        "//loom/src/loom/tooling/testbench:invocation",
        "//loom/src/loom/tooling/testbench:issue_report",
        "//loom/src/loom/tooling/testbench:reference",
        "//loom/src/loom/tooling/testbench:requirements",
        "//loom/src/loom/tooling/testbench/scenario:entropy",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//loom/src/loom/tooling/testbench/scenario:values",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:stream",
    ],
)

loom_cc_binary(
    name = "iree-test-loom",
    srcs = ["iree-test-loom.c"],
    copts = _IREE_TEST_LOOM_TARGET_COPTS,
    deps = [
        ":main",
        "//loom/src/loom/tooling/execution:execution_provider",
        "//loom/src/loom/tooling/input:configured",
        "//loom/src/loom/transforms/cleanup:configured",
        "//runtime/src/iree/base",
    ] + _IREE_TEST_LOOM_TARGET_DEPS,
)

loom_cc_binary(
    name = "scenario_failure_test_tool",
    testonly = True,
    srcs = ["scenario_failure_test.c"],
    deps = [
        ":main",
        "//loom/src/loom/ir",
        "//loom/src/loom/tooling/execution:execution_provider",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_execution_test_suite(
    name = "execution_test",
    data = [
        "testdata/library_cases.loom",
        "testdata/linked_input_cases.loom",
        "testdata/requirement_cases.loom",
        "testdata/scalar_cases.loom",
        "//loom/src/loom/tooling/input:testdata/duplicate_symbols.loom-test",
    ],
    manifests = ["iree-test-loom.test.json"],
    tags = ["hostonly"],
    tools = {
        "iree-test-loom": ":iree-test-loom",
        "loom-link": "//loom/src/loom/tools/loom-link",
    },
)

iree_execution_test_suite(
    name = "scenario_execution_test",
    data = ["testdata/scenario_cases.loom"],
    manifests = ["scenario_execution.test.json"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/target/arch:vm"]),
    tools = {
        "iree-test-loom": ":iree-test-loom",
    },
)

loom_test(
    name = "wasm_scenario_product_test",
    srcs = ["testdata/scenario_cases.loom"],
    execution_profiles = [WASM_NODE_PROFILE],
)

iree_execution_test_suite(
    name = "scenario_failure_test",
    data = ["testdata/scenario_failures.loom"],
    manifests = ["scenario_failure.test.json"],
    tags = ["hostonly"],
    tools = {
        "scenario-failure-test": ":scenario_failure_test_tool",
    },
)
