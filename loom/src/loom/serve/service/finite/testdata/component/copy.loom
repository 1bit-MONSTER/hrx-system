target.decl @device

kernel.def target(@device) @copy(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  scf.for %i = [%c0 to %c4 step %c1] {
    %value = view.load %input_view[%i] : view<4xf32> -> f32
    view.store %value, %output_view[%i] : f32, view<4xf32>
  }
  kernel.return
}
