// A tuple carrier establishes the complete eq relation on the true edge.
func.decl @observe(%left: i32, %right: i32) -> (i32)

func.def @implied_relation_eq(%left: i32, %right: i32, %other: i1) -> (i32) {
  %known_left, %known_right = scalar.assume %left, %right [eq(%left, %right)] : i32, i32
  %ordered = scalar.cmpi eq, %known_left, %known_right : i32
  %condition = scalar.andi %other, %ordered : i1
  %result = scf.if %condition -> (i32) {
    %observed = func.call @observe(%known_left, %known_right) : (i32, i32) -> (i32)
    scf.yield %observed : i32
  } else {
    scf.yield %known_right : i32
  }
  func.return %result : i32
}

