// RUN: pass combine

// An explicit exclusion survives nested false-edge refinement for i1.
func.decl @observe(%value: i1) -> (i1)

func.def @excluded_literal_i1(%input: i1, %other: i1) -> (i1) {
  %known = scalar.assume %input [ne(%input, 1)] : i1
  %excluded = scalar.constant 1 : i1
  %single = scalar.cmpi eq, %known, %excluded : i1
  %condition = scalar.ori %other, %single : i1
  %result = scf.if %condition -> (i1) {
    scf.yield %excluded : i1
  } else {
    %observed = func.call @observe(%known) : (i1) -> (i1)
    scf.yield %observed : i1
  }
  func.return %result : i1
}

// ----
func.decl @observe(%value: i1) -> (i1)

func.def @excluded_literal_i1(%input: i1, %other: i1) -> (i1) {
  %known = scalar.constant false : i1
  %excluded = scalar.constant 1 : i1
  %result = scf.if %other -> (i1) {
    scf.yield %excluded : i1
  } else {
    %observed = func.call @observe(%known) : (i1) -> (i1)
    scf.yield %observed : i1
  }
  func.return %result : i1
}

