// ====

// A stronger edge relation remains explicit even with an existing carrier.
func.decl @observe(%left: i32, %right: i32) -> (i32)

func.def @stronger_edge_relation(%left: i32, %right: i32, %other: i1) -> (i32) {
  %known_left, %known_right = scalar.assume %left, %right [le(%left, %right)] : i32, i32
  %strict = scalar.cmpi slt, %known_left, %known_right : i32
  %condition = scalar.andi %other, %strict : i1
  %result = scf.if %condition -> (i32) {
    %observed = func.call @observe(%known_left, %known_right) : (i32, i32) -> (i32)
    scf.yield %observed : i32
  } else {
    scf.yield %known_right : i32
  }
  func.return %result : i32
}

// ----
func.decl @observe(%left: i32, %right: i32) -> (i32)

func.def @stronger_edge_relation(%left: i32, %right: i32, %other: i1) -> (i32) {
  %known_left, %known_right = scalar.assume %left, %right [le(%left, %right)] : i32, i32
  %strict = scalar.cmpi slt, %known_left, %known_right : i32
  %condition = scalar.andi %other, %strict : i1
  %result = scf.if %condition -> (i32) {
    %14 = scalar.assume %known_right [gt(%known_right, %known_left)] : i32
    %13 = scalar.assume %known_left [lt(%known_left, %known_right)] : i32
    %observed = func.call @observe(%13, %14) : (i32, i32) -> (i32)
    scf.yield %observed : i32
  } else {
    scf.yield %known_right : i32
  }
  func.return %result : i32
}

// ====

// Signed and unsigned order remain distinct on the same input aliases.
func.decl @observe(%left: i32, %right: i32) -> (i32)

func.def @distinct_edge_domain(%left: i32, %right: i32, %other: i1) -> (i32) {
  %known_left, %known_right = scalar.assume %left, %right [lt(%left, %right)] : i32, i32
  %ordered = scalar.cmpi ult, %known_left, %known_right : i32
  %condition = scalar.andi %other, %ordered : i1
  %result = scf.if %condition -> (i32) {
    %observed = func.call @observe(%known_left, %known_right) : (i32, i32) -> (i32)
    scf.yield %observed : i32
  } else {
    scf.yield %known_right : i32
  }
  func.return %result : i32
}

// ----
func.decl @observe(%left: i32, %right: i32) -> (i32)

func.def @distinct_edge_domain(%left: i32, %right: i32, %other: i1) -> (i32) {
  %known_left, %known_right = scalar.assume %left, %right [lt(%left, %right)] : i32, i32
  %ordered = scalar.cmpi ult, %known_left, %known_right : i32
  %condition = scalar.andi %other, %ordered : i1
  %result = scf.if %condition -> (i32) {
    %observed = func.call @observe(%known_left, %known_right) : (i32, i32) -> (i32)
    scf.yield %observed : i32
  } else {
    scf.yield %known_right : i32
  }
  func.return %result : i32
}

// ====

// Default edges retain only exclusions not already carried by the selector.
func.decl @observe(%value: index) -> (index)

func.def @switch_exclusions(%input: index) -> (index) {
  %known = index.assume %input [ne(%input, 1)] : index
  %result = scf.switch %known -> (index) {
    case 1 {
      %excluded = index.constant 1 : index
      scf.yield %excluded : index
    }
    case 2 {
      %other_case = index.constant 2 : index
      scf.yield %other_case : index
    }
    default {
      %observed = func.call @observe(%known) : (index) -> (index)
      scf.yield %observed : index
    }
  }
  func.return %result : index
}

// ----
func.decl @observe(%value: index) -> (index)

func.def @switch_exclusions(%input: index) -> (index) {
  %known = index.assume %input [ne(%input, 1)] : index
  %result = scf.switch %known -> (index) {
    case 1 {
      %excluded = index.constant 1 : index
      scf.yield %excluded : index
    }
    case 2 {
      %other_case = index.constant 2 : index
      scf.yield %other_case : index
    }
    default {
      %9 = index.assume %known [ne(%known, 2)] : index
      %observed = func.call @observe(%9) : (index) -> (index)
      scf.yield %observed : index
    }
  }
  func.return %result : index
}
