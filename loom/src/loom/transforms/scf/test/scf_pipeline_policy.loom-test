func.def @queue_operand_limit(%input: view<64xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %depth = index.constant 65535 : index
  // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="pipeline state and bounds fitting the SCF operand limit"}
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %first = view.load %input[%i] : view<64xf32> -> f32
    %second = view.load %input[%i] : view<64xf32> -> f32
    %both = scalar.addf %first, %second : f32
    %next = scalar.addf %sum, %both : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

