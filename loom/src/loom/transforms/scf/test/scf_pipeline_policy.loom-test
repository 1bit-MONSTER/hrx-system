    %value = view.load %input[%i] : view<64xf32> -> f32
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="workgroup-only stores and barriers in the ordered consumer"}
    view.store %sum, %input[%i] : f32, view<64xf32>
    scf.yield %value : f32
  }
  func.return %result : f32
}

// ====
// RUN: pass pipeline-scf-for

func.def @while_control_is_not_moved(%input: view<64xf32>, %initial: f32, %condition: i1) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="body operations with only scf.if/scf.for regions and no successors"}
    %next = scf.while(%before = %value : f32) -> (f32) {
      scf.condition %condition, %before : i1, f32
    } do(%body: f32) {
      scf.yield %body : f32
    }
    scf.yield %next : f32
  }
  func.return %result : f32
}

