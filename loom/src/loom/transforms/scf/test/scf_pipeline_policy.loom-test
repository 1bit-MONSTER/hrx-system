func.def @varying_queue_type(%input: view<64xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="iteration-invariant types for values carried between pipeline stages"}
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %extent = index.add %i, %step : index
    %values = vector.load %input[%i] : view<64xf32> -> vector<[%extent]xf32>
    %value = vector.extract %values[0] : vector<[%extent]xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

