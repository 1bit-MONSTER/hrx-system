// RUN: pass pipeline-scf-for

func.def @tied_carried_storage(%input: view<64xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="loop results without consuming operand storage ties"}
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (%initial as f32) pipeline(%depth) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

