// RUN: pass pipeline-scf-for

func.def @carried_address_dependency(%input: view<64xf32>, %initial: index) -> (index) {
  %seed = scalar.constant 0.0 : f32
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result, %last_value = scf.for %i = [%begin to %end step %step](%sum = %initial : index, %last = %seed : f32) -> (index, f32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="read-ahead prerequisites independent of loop-carried state"}
    %position = index.add %sum, %i : index
    %value = view.load %input[%position] : view<64xf32> -> f32
    %next = index.add %sum, %step : index
    scf.yield %next, %value : index, f32
  }
  func.return %result : index
}

