// RUN: pass loop-fusion

func.def @fuses_independent_pure_loops(%n: index, %a: i32, %b: i32) -> (i32, i32) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %sum_a = scf.for %i = [%loop_begin to %n step %loop_step](%acc = %a : i32) -> (i32) {
    %next = test.addi %acc, %b : i32
    scf.yield %next : i32
  }
  %sum_b = scf.for %j = [%loop_begin to %n step %loop_step](%acc = %b : i32) -> (i32) {
    %next = test.addi %acc, %a : i32
    scf.yield %next : i32
  }
  func.return %sum_a, %sum_b : i32, i32
}

// ----
func.def @fuses_independent_pure_loops(%n: index, %a: i32, %b: i32) -> (i32, i32) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %sum_a, %sum_b = scf.for %17 = [%loop_begin to %n step %loop_step](%18 = %a : i32, %19 = %b : i32) -> (i32, i32) {
    %next = test.addi %18, %b : i32
    %14 = test.addi %19, %a : i32
    scf.yield %next, %14 : i32, i32
  }
  func.return %sum_a, %sum_b : i32, i32
}

// ====

func.def @fuses_equal_constant_domains(%a: i32, %b: i32) -> (i32, i32) {
  %loop_a_begin = index.constant 0 : index
  %loop_b_begin = index.constant 0 : index
  %loop_a_end = index.constant 4 : index
  %loop_b_end = index.constant 4 : index
  %loop_a_step = index.constant 1 : index
  %loop_b_step = index.constant 1 : index
  %sum_a = scf.for %i = [%loop_a_begin to %loop_a_end step %loop_a_step](%acc = %a : i32) -> (i32) {
    %next = test.addi %acc, %b : i32
    scf.yield %next : i32
  }
  %sum_b = scf.for %j = [%loop_b_begin to %loop_b_end step %loop_b_step](%acc = %b : i32) -> (i32) {
    %next = test.addi %acc, %a : i32
    scf.yield %next : i32
  }
  func.return %sum_a, %sum_b : i32, i32
}

// ----
func.def @fuses_equal_constant_domains(%a: i32, %b: i32) -> (i32, i32) {
  %loop_a_begin = index.constant 0 : index
  %loop_b_begin = index.constant 0 : index
  %loop_a_end = index.constant 4 : index
  %loop_b_end = index.constant 4 : index
  %loop_a_step = index.constant 1 : index
  %loop_b_step = index.constant 1 : index
  %sum_a, %sum_b = scf.for %20 = [%loop_a_begin to %loop_a_end step %loop_a_step](%21 = %a : i32, %22 = %b : i32) -> (i32, i32) {
    %next = test.addi %21, %b : i32
    %17 = test.addi %22, %a : i32
    scf.yield %next, %17 : i32, i32
  }
  func.return %sum_a, %sum_b : i32, i32
}

// ====

// loop-fusion is deliberately limited to counted scf.for loops. scf.while has
// no counted domain, so adjacent while ops are left unchanged.
func.def @does_not_fuse_while(%cond: i1, %a: i32, %b: i32) -> (i32, i32) {
  %sum_a = scf.while(%before = %a : i32) -> (i32) {
    scf.condition %cond, %before : i1, i32
  } do(%body: i32) {
    %next = test.addi %body, %b : i32
    scf.yield %next : i32
  }
  %sum_b = scf.while(%before = %b : i32) -> (i32) {
    scf.condition %cond, %before : i1, i32
  } do(%body: i32) {
    %next = test.addi %body, %a : i32
    scf.yield %next : i32
  }
  func.return %sum_a, %sum_b : i32, i32
}

// ====

func.def @fuses_dynamic_result_type_references(%n: index, %buffer: buffer, %offset: offset) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %base_layout = encoding.layout.dense : encoding<layout>
  %base_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %base_layout>
  %left_layout, %left_view = scf.for %i = [%loop_begin to %n step %loop_step](%layout_acc = %base_layout : encoding<layout>, %view_acc = %base_view : view<4xf32, %base_layout>) -> (encoding<layout>, view<4xf32, %left_layout>) {
    %dense = encoding.layout.dense : encoding<layout>
    %view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %dense>
    scf.yield %dense, %view : encoding<layout>, view<4xf32, %dense>
  }
  %right_layout, %right_view = scf.for %j = [%loop_begin to %n step %loop_step](%layout_acc = %base_layout : encoding<layout>, %view_acc = %base_view : view<4xf32, %base_layout>) -> (encoding<layout>, view<4xf32, %right_layout>) {
    %dense = encoding.layout.dense : encoding<layout>
    %view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %dense>
    scf.yield %dense, %view : encoding<layout>, view<4xf32, %dense>
  }
  test.use %left_view : view<4xf32, %left_layout>
  test.use %right_view : view<4xf32, %right_layout>
  func.return
}

// ----
func.def @fuses_dynamic_result_type_references(%n: index, %buffer: buffer, %offset: offset) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %base_layout = encoding.layout.dense : encoding<layout>
  %base_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %base_layout>
  %left_layout, %left_view, %right_layout, %right_view = scf.for %25 = [%loop_begin to %n step %loop_step](%26 = %base_layout : encoding<layout>, %27 = %base_view : view<4xf32, %base_layout>, %28 = %base_layout : encoding<layout>, %29 = %base_view : view<4xf32, %base_layout>) -> (encoding<layout>, view<4xf32, %left_layout>, encoding<layout>, view<4xf32, %right_layout>) {
    %dense = encoding.layout.dense : encoding<layout>
    %view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %dense>
    %19 = encoding.layout.dense : encoding<layout>
    %20 = buffer.view %buffer[%offset] : buffer -> view<4xf32, %19>
    scf.yield %dense, %view, %19, %20 : encoding<layout>, view<4xf32, %dense>, encoding<layout>, view<4xf32, %19>
  }
  test.use %left_view : view<4xf32, %left_layout>
  test.use %right_view : view<4xf32, %right_layout>
  func.return
}

// ====

func.def @fuses_load_then_lane_local_compute(%n: index, %buffer: buffer, %byte_offset: offset, %origin: index, %seed: vector<[%n]xf32>, %old: vector<[%n]xf32>) -> (vector<[%n]xf32>, vector<[%n]xf32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%byte_offset] : buffer -> view<[%n]xf32, %layout>
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %loaded = scf.for %i = [%loop_begin to %n step %loop_step](%acc = %seed : vector<[%n]xf32>) -> (vector<[%n]xf32>) {
    %address = index.add %origin, %i : index
    %lane = view.load %view[%address] : view<[%n]xf32, %layout> -> f32
    %next = vector.insert %lane into %acc[%i] : f32, vector<[%n]xf32>
    scf.yield %next : vector<[%n]xf32>
  }
  %doubled = scf.for %j = [%loop_begin to %n step %loop_step](%acc = %old : vector<[%n]xf32>) -> (vector<[%n]xf32>) {
    %lane = vector.extract %loaded[%j] : vector<[%n]xf32> -> f32
    %twice = scalar.addf %lane, %lane : f32
    %next = vector.insert %twice into %acc[%j] : f32, vector<[%n]xf32>
    scf.yield %next : vector<[%n]xf32>
  }
  func.return %loaded, %doubled : vector<[%n]xf32>, vector<[%n]xf32>
}

// ----
func.def @fuses_load_then_lane_local_compute(%n: index, %buffer: buffer, %byte_offset: offset, %origin: index, %seed: vector<[%n]xf32>, %old: vector<[%n]xf32>) -> (vector<[%n]xf32>, vector<[%n]xf32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%byte_offset] : buffer -> view<[%n]xf32, %layout>
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %loaded, %doubled = scf.for %26 = [%loop_begin to %n step %loop_step](%27 = %seed : vector<[%n]xf32>, %28 = %old : vector<[%n]xf32>) -> (vector<[%n]xf32>, vector<[%n]xf32>) {
    %address = index.add %origin, %26 : index
    %lane = view.load %view[%address] : view<[%n]xf32, %layout> -> f32
    %next = vector.insert %lane into %27[%26] : f32, vector<[%n]xf32>
    %21 = vector.extract %next[%26] : vector<[%n]xf32> -> f32
    %22 = scalar.addf %21, %21 : f32
    %23 = vector.insert %22 into %28[%26] : f32, vector<[%n]xf32>
    scf.yield %next, %23 : vector<[%n]xf32>, vector<[%n]xf32>
  }
  func.return %loaded, %doubled : vector<[%n]xf32>, vector<[%n]xf32>
}

// ====

func.def @fuses_masked_lane_local_compute(%n: index, %mask: vector<[%n]xi1>, %seed: vector<[%n]xi32>, %old: vector<[%n]xi32>, %one_i32: i32) -> (vector<[%n]xi32>, vector<[%n]xi32>) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %selected = scf.for %i = [%loop_begin to %n step %loop_step](%acc = %seed : vector<[%n]xi32>) -> (vector<[%n]xi32>) {
    %m = vector.extract %mask[%i] : vector<[%n]xi1> -> i1
    %lane = scf.if %m -> (i32) {
      scf.yield %one_i32 : i32
    } else {
      %old_lane = vector.extract %seed[%i] : vector<[%n]xi32> -> i32
      scf.yield %old_lane : i32
    }
    %next = vector.insert %lane into %acc[%i] : i32, vector<[%n]xi32>
    scf.yield %next : vector<[%n]xi32>
  }
  %incremented = scf.for %j = [%loop_begin to %n step %loop_step](%acc = %old : vector<[%n]xi32>) -> (vector<[%n]xi32>) {
    %lane = vector.extract %selected[%j] : vector<[%n]xi32> -> i32
    %next_lane = test.addi %lane, %one_i32 : i32
    %next = vector.insert %next_lane into %acc[%j] : i32, vector<[%n]xi32>
    scf.yield %next : vector<[%n]xi32>
  }
  func.return %selected, %incremented : vector<[%n]xi32>, vector<[%n]xi32>
}

// ----
func.def @fuses_masked_lane_local_compute(%n: index, %mask: vector<[%n]xi1>, %seed: vector<[%n]xi32>, %old: vector<[%n]xi32>, %one_i32: i32) -> (vector<[%n]xi32>, vector<[%n]xi32>) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %selected, %incremented = scf.for %24 = [%loop_begin to %n step %loop_step](%25 = %seed : vector<[%n]xi32>, %26 = %old : vector<[%n]xi32>) -> (vector<[%n]xi32>, vector<[%n]xi32>) {
    %m = vector.extract %mask[%24] : vector<[%n]xi1> -> i1
    %lane = scf.if %m -> (i32) {
      scf.yield %one_i32 : i32
    } else {
      %old_lane = vector.extract %seed[%24] : vector<[%n]xi32> -> i32
      scf.yield %old_lane : i32
    }
    %next = vector.insert %lane into %25[%24] : i32, vector<[%n]xi32>
    %19 = vector.extract %next[%24] : vector<[%n]xi32> -> i32
    %20 = test.addi %19, %one_i32 : i32
    %21 = vector.insert %20 into %26[%24] : i32, vector<[%n]xi32>
    scf.yield %next, %21 : vector<[%n]xi32>, vector<[%n]xi32>
  }
  func.return %selected, %incremented : vector<[%n]xi32>, vector<[%n]xi32>
}

// ====

func.def @rejects_non_lane_local_forwarding(%n: index, %seed: vector<[%n]xi32>, %old: vector<[%n]xi32>, %lane_value: i32) -> (vector<[%n]xi32>, vector<[%n]xi32>) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %built = scf.for %i = [%loop_begin to %n step %loop_step](%acc = %seed : vector<[%n]xi32>) -> (vector<[%n]xi32>) {
    %next = vector.insert %lane_value into %acc[%i] : i32, vector<[%n]xi32>
    scf.yield %next : vector<[%n]xi32>
  }
  %broadcast_first = scf.for %j = [%loop_begin to %n step %loop_step](%acc = %old : vector<[%n]xi32>) -> (vector<[%n]xi32>) {
    %first_lane = vector.extract %built[%loop_begin] : vector<[%n]xi32> -> i32
    %next = vector.insert %first_lane into %acc[%j] : i32, vector<[%n]xi32>
    scf.yield %next : vector<[%n]xi32>
  }
  func.return %built, %broadcast_first : vector<[%n]xi32>, vector<[%n]xi32>
}

// ====

func.def @rejects_write_effect_hazard(%n: index, %pool: pool, %tile: tile<4xf32>, %a: i32, %b: i32) -> (i32) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  scf.for %i = [%loop_begin to %n step %loop_step] {
    test.write_resource %pool, %tile : pool, tile<4xf32>
  }
  %sum = scf.for %j = [%loop_begin to %n step %loop_step](%acc = %a : i32) -> (i32) {
    %next = test.addi %acc, %b : i32
    scf.yield %next : i32
  }
  func.return %sum : i32
}

// ----
func.def @rejects_write_effect_hazard(%n: index, %pool: pool, %tile: tile<4xf32>, %a: i32, %b: i32) -> (i32) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  scf.for %i = [%loop_begin to %n step %loop_step] {
    test.write_resource %pool, %tile : pool, tile<4xf32>
  }
  %sum = scf.for %j = [%loop_begin to %n step %loop_step](%acc = %a : i32) -> (i32) {
    %next = test.addi %acc, %b : i32
    scf.yield %next : i32
  }
  func.return %sum : i32
}

// ====

func.def @preserves_pipeline_intent(%input: view<64xf32>, %end: index, %depth: index, %initial: f32) -> (f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  %second = scf.for %j = [%begin to %end step %step](%sum = %initial : f32) -> (f32) {
    %next = scalar.addf %sum, %initial : f32
    scf.yield %next : f32
  }
  func.return %first, %second : f32, f32
}

// ====

func.def @preserves_unroll_factor_intent(%input: view<64xf32>, %end: index, %depth: index, %initial: f32) -> (f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll(%depth) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  %second = scf.for %j = [%begin to %end step %step](%sum = %initial : f32) -> (f32) {
    %next = scalar.addf %sum, %initial : f32
    scf.yield %next : f32
  }
  func.return %first, %second : f32, f32
}

// ====

func.def @preserves_bare_unroll_intent(%input: view<64xf32>, %end: index, %depth: index, %initial: f32) -> (f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  %second = scf.for %j = [%begin to %end step %step](%sum = %initial : f32) -> (f32) {
    %next = scalar.addf %sum, %initial : f32
    scf.yield %next : f32
  }
  func.return %first, %second : f32, f32
}

// ====

// Equivalent domains can retain different local refinements of the same value.
func.def @fuses_refined_domains(%n: index, %a: i32, %b: i32) -> (i32, i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bounded = index.assume %n [range(%n, 1, 1023)] : index
  %sum_a = scf.for %i = [%begin to %n step %step](%acc = %a : i32) -> (i32) {
    %next = test.addi %acc, %b : i32
    scf.yield %next : i32
  }
  %sum_b = scf.for %j = [%begin to %bounded step %step](%acc = %b : i32) -> (i32) {
    %next = test.addi %acc, %a : i32
    scf.yield %next : i32
  }
  func.return %sum_a, %sum_b : i32, i32
}

// ----
func.def @fuses_refined_domains(%n: index, %a: i32, %b: i32) -> (i32, i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bounded = index.assume %n [range(%n, 1, 1023)] : index
  %sum_a, %sum_b = scf.for %18 = [%begin to %n step %step](%19 = %a : i32, %20 = %b : i32) -> (i32, i32) {
    %next = test.addi %19, %b : i32
    %15 = test.addi %20, %a : i32
    scf.yield %next, %15 : i32, i32
  }
  func.return %sum_a, %sum_b : i32, i32
}
