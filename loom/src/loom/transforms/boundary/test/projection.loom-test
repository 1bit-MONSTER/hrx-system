    %21 = scalar.constant 0 : i32
    %body_at = scalar.cmpi ne, %body_at_word, %21 : i32
    %next = index.add %body_i, %c1 : index
    scf.yield %next : index
  }
  %23 = scalar.constant 0 : i32
  %at_limit = scalar.cmpi ne, %at_limit_word, %23 : i32
  test.use %terminal, %at_limit : index, i1
  kernel.return
}

