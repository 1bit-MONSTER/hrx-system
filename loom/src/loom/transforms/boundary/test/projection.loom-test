kernel.def target(@carrier_target) @condition_predicate_payload() {
  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %limit = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %terminal, %at_limit = scf.while(%i = %c0 : index) -> (index, i1) {
    %continue = index.cmp ult, %i, %limit : index
    %at = index.cmp eq, %i, %limit : index
    scf.condition %continue, %i, %at : i1, index, i1
  } do(%body_i: index, %body_at: i1) {
    %next = index.add %body_i, %c1 : index
    scf.yield %next : index
  }
  test.use %terminal, %at_limit : index, i1
  kernel.return
}

