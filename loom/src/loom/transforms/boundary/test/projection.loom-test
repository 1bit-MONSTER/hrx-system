  %terminal, %at_limit_word = scf.while(%i = %c0 : index) -> (index, i32) {
    %continue = index.cmp ult, %i, %limit : index
    %at = index.cmp eq, %i, %limit : index
    %18 = scalar.constant 1 : i32
    %19 = scalar.constant 0 : i32
    %20 = scf.select %at, %18, %19 : i32
    scf.condition %continue, %i, %20 : i1, index, i32
