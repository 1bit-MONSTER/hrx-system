test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @recurring_predicate() {
  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %limit = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %disabled = scalar.constant false : i1
  %15 = scalar.constant 1 : i32
  %16 = scalar.constant 0 : i32
  %17 = scf.select %disabled, %15, %16 : i32
  %terminal, %last_word = scf.while(%i = %c0 : index, %flag_word = %17 : i32) -> (index, i32) {
    %27 = scalar.constant 0 : i32
    %flag = scalar.cmpi ne, %flag_word, %27 : i32
    %continue = index.cmp ult, %i, %limit : index
    scf.condition %continue, %i, %flag_word : i1, index, i32
  } do(%body_i: index, %body_flag_word: i32) {
    %29 = scalar.constant 0 : i32
    %body_flag = scalar.cmpi ne, %body_flag_word, %29 : i32
    %next = index.add %body_i, %c1 : index
    %at_limit = index.cmp eq, %next, %limit : index
    %24 = scalar.constant 1 : i32
    %25 = scalar.constant 0 : i32
    %26 = scf.select %at_limit, %24, %25 : i32
    scf.yield %next, %26 : index, i32
  }
  %31 = scalar.constant 0 : i32
  %last = scalar.cmpi ne, %last_word, %31 : i32
  test.use %terminal, %last : index, i1
  kernel.return
}

// ====
// A static multi-rank predicate vector uses the same-shaped word carrier. The
// target's existing mask select and payload comparison perform the two
// representation conversions without flattening the vector shape.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @recurring_predicate_vector() {
  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %limit = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %disabled = vector.constant false : vector<1x2xi1>
  %terminal, %last = scf.while(%i = %c0 : index, %flags = %disabled : vector<1x2xi1>) -> (index, vector<1x2xi1>) {
    %continue = index.cmp ult, %i, %limit : index
    scf.condition %continue, %i, %flags : i1, index, vector<1x2xi1>
  } do(%body_i: index, %body_flags: vector<1x2xi1>) {
    %next = index.add %body_i, %c1 : index
    %at_limit = index.cmp eq, %next, %limit : index
    %before_limit = index.cmp ult, %next, %limit : index
    %next_flags = vector.from_elements %at_limit, %before_limit : vector<1x2xi1>
    scf.yield %next, %next_flags : index, vector<1x2xi1>
  }
  test.use %terminal, %last : index, vector<1x2xi1>
  kernel.return
}

// ----
test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @recurring_predicate_vector() {
  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %limit = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %disabled = vector.constant false : vector<1x2xi1>
  %17 = vector.constant 1 : vector<1x2xi32>
  %18 = vector.constant 0 : vector<1x2xi32>
  %19 = vector.select %disabled, %17, %18 : vector<1x2xi32>
  %terminal, %last_word = scf.while(%i = %c0 : index, %flags_word = %19 : vector<1x2xi32>) -> (index, vector<1x2xi32>) {
    %29 = vector.constant 0 : vector<1x2xi32>
    %flags = vector.cmpi ne, %flags_word, %29 : vector<1x2xi32> -> vector<1x2xi1>
    %continue = index.cmp ult, %i, %limit : index
    scf.condition %continue, %i, %flags_word : i1, index, vector<1x2xi32>
  } do(%body_i: index, %body_flags_word: vector<1x2xi32>) {
    %31 = vector.constant 0 : vector<1x2xi32>
    %body_flags = vector.cmpi ne, %body_flags_word, %31 : vector<1x2xi32> -> vector<1x2xi1>
    %next = index.add %body_i, %c1 : index
    %at_limit = index.cmp eq, %next, %limit : index
    %before_limit = index.cmp ult, %next, %limit : index
    %next_flags = vector.from_elements %at_limit, %before_limit : vector<1x2xi1>
    %26 = vector.constant 1 : vector<1x2xi32>
    %27 = vector.constant 0 : vector<1x2xi32>
    %28 = vector.select %next_flags, %26, %27 : vector<1x2xi32>
    scf.yield %next, %28 : index, vector<1x2xi32>
  }
  %33 = vector.constant 0 : vector<1x2xi32>
  %last = vector.cmpi ne, %last_word, %33 : vector<1x2xi32> -> vector<1x2xi1>
  test.use %terminal, %last : index, vector<1x2xi1>
  kernel.return
}

// ====
// The target carrier bound is inclusive: the largest supported vector is
// projected while the first larger vector remains in its logical form.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @predicate_vector_carrier_bound() {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %within_bound = vector.constant false : vector<4x8xi1>
  %above_bound = vector.constant false : vector<3x11xi1>
  %within_result, %above_result = scf.for %i = [%c0 to %c1 step %c1](%within = %within_bound : vector<4x8xi1>, %above = %above_bound : vector<3x11xi1>) -> (vector<4x8xi1>, vector<3x11xi1>) {
    scf.yield %within, %above : vector<4x8xi1>, vector<3x11xi1>
  }
  test.use %within_result, %above_result : vector<4x8xi1>, vector<3x11xi1>
  func.return
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @predicate_vector_carrier_bound() {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %within_bound = vector.constant false : vector<4x8xi1>
  %above_bound = vector.constant false : vector<3x11xi1>
  %9 = vector.constant 1 : vector<4x8xi32>
  %10 = vector.constant 0 : vector<4x8xi32>
  %11 = vector.select %within_bound, %9, %10 : vector<4x8xi32>
  %within_result_word, %above_result = scf.for %i = [%c0 to %c1 step %c1](%within_word = %11 : vector<4x8xi32>, %above = %above_bound : vector<3x11xi1>) -> (vector<4x8xi32>, vector<3x11xi1>) {
    %17 = vector.constant 0 : vector<4x8xi32>
    %within = vector.cmpi ne, %within_word, %17 : vector<4x8xi32> -> vector<4x8xi1>
    scf.yield %within_word, %above : vector<4x8xi32>, vector<3x11xi1>
  }
  %19 = vector.constant 0 : vector<4x8xi32>
  %within_result = vector.cmpi ne, %within_result_word, %19 : vector<4x8xi32> -> vector<4x8xi1>
  test.use %within_result, %above_result : vector<4x8xi1>, vector<3x11xi1>
  func.return
}

// ====
// Unknown distribution is not a uniformity proof. A loop block argument may
// need native lane-mask storage and therefore uses the durable carrier.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @unknown_predicate_uses_word(%limit: index, %seed: i1) -> (i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last = scf.for %i = [%c0 to %limit step %c1](%flag = %seed : i1) -> (i1) {
    scf.yield %flag : i1
  }
  func.return %last : i1
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @unknown_predicate_uses_word(%limit: index, %seed: i1) -> (i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %8 = scalar.constant 1 : i32
  %9 = scalar.constant 0 : i32
  %10 = scf.select %seed, %8, %9 : i32
  %last_word = scf.for %i = [%c0 to %limit step %c1](%flag_word = %10 : i32) -> (i32) {
    %14 = scalar.constant 0 : i32
    %flag = scalar.cmpi ne, %flag_word, %14 : i32
    scf.yield %flag_word : i32
  }
  %16 = scalar.constant 0 : i32
  %last = scalar.cmpi ne, %last_word, %16 : i32
  func.return %last : i1
}

