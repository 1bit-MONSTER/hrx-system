  %6 = scalar.extf %5 : f8E4M3 to f32
  %7 = vector.extract %scale[0] : vector<1xi32> -> i32
  %8 = scalar.constant 255 : i32
  %9 = scalar.andi %7, %8 : i32
  %10 = scalar.constant 23 : i32
  %11 = scalar.shli %9, %10 : i32
  %12 = scalar.constant 0 : i32
  %13 = scalar.cmpi eq, %9, %12 : i32
  %14 = scalar.constant 4194304 : i32
  %15 = scf.select %13, %14, %11 : i32
  %16 = scalar.constant 255 : i32
  %17 = scalar.cmpi eq, %9, %16 : i32
  %18 = scalar.constant 2143289344 : i32
  %19 = scf.select %17, %18, %15 : i32
  %20 = scalar.bitcast %19 : i32 to f32
  %21 = scalar.mulf %6, %20 : f32
  %22 = scalar.fptrunc %21 : f32 to f16
  %decoded = vector.splat %22 : vector<1xf16>
  func.return %decoded : vector<1xf16>
