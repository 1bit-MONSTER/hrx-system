  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=2, scale_format=f8e4m3, scale_group_elements=2, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %decoded = vector.decode %payload using %schema {scale = %scale : vector<1xf8E4M3>} : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
  func.return %decoded : vector<2xf32>
}

