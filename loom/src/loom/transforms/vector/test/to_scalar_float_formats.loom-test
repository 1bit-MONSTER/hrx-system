// ====

func.def @decode_e4m3fn(%payload: vector<2xf8E4M3>) -> (vector<2xf32>) {
  %schema = encoding.define #encoding.f8e4m3fn<payload_elements=2> : encoding<schema>
  %decoded = vector.decode %payload using %schema : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
  func.return %decoded : vector<2xf32>
}

// ----
func.def @decode_e4m3fn(%payload: vector<2xf8E4M3>) -> (vector<2xf32>) {
  %4 = vector.extract %payload[0] : vector<2xf8E4M3> -> f8E4M3
  %5 = scalar.extf %4 : f8E4M3 to f32
  %6 = vector.extract %payload[1] : vector<2xf8E4M3> -> f8E4M3
  %7 = scalar.extf %6 : f8E4M3 to f32
  %decoded = vector.from_elements %5, %7 : vector<2xf32>
  func.return %decoded : vector<2xf32>
}

// ====

func.def @encode_e4m3fn(%source: vector<2xf32>) -> (vector<2xf8E4M3>) {
