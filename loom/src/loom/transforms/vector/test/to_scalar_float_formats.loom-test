}

// ----
func.def @decode_scale_e4m3fn(%payload: vector<2xf8E4M3>, %scale: vector<1xf8E4M3>) -> (vector<2xf32>) {
  %5 = vector.extract %payload[0] : vector<2xf8E4M3> -> f8E4M3
  %6 = scalar.extf %5 : f8E4M3 to f32
  %7 = vector.extract %scale[0] : vector<1xf8E4M3> -> f8E4M3
  %8 = scalar.extf %7 : f8E4M3 to f32
  %9 = scalar.mulf %6, %8 : f32
  %10 = vector.extract %payload[1] : vector<2xf8E4M3> -> f8E4M3
  %11 = scalar.extf %10 : f8E4M3 to f32
  %12 = vector.extract %scale[0] : vector<1xf8E4M3> -> f8E4M3
  %13 = scalar.extf %12 : f8E4M3 to f32
  %14 = scalar.mulf %11, %13 : f32
  %decoded = vector.from_elements %9, %14 : vector<2xf32>
  func.return %decoded : vector<2xf32>
}

// ====

func.def @encode_scale_e4m3fn(%source: vector<2xf32>, %scale: vector<1xf8E4M3>) -> (vector<2xf8E4M3>) {
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=2, scale_format=f8e4m3fn, scale_group_elements=2, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %encoded = vector.encode %source using %schema {scale = %scale : vector<1xf8E4M3>} : vector<2xf32>, encoding<schema> -> vector<2xf8E4M3>
  func.return %encoded : vector<2xf8E4M3>
}

// ----
func.def @encode_scale_e4m3fn(%source: vector<2xf32>, %scale: vector<1xf8E4M3>) -> (vector<2xf8E4M3>) {
  %5 = vector.extract %source[0] : vector<2xf32> -> f32
  %6 = vector.extract %scale[0] : vector<1xf8E4M3> -> f8E4M3
  %7 = scalar.extf %6 : f8E4M3 to f32
  %8 = scalar.divf %5, %7 : f32
  %9 = scalar.fptrunc %8 : f32 to f8E4M3
  %10 = vector.extract %source[1] : vector<2xf32> -> f32
  %11 = vector.extract %scale[0] : vector<1xf8E4M3> -> f8E4M3
  %12 = scalar.extf %11 : f8E4M3 to f32
  %13 = scalar.divf %10, %12 : f32
  %14 = scalar.fptrunc %13 : f32 to f8E4M3
  %encoded = vector.from_elements %9, %14 : vector<2xf8E4M3>
  func.return %encoded : vector<2xf8E4M3>
}

