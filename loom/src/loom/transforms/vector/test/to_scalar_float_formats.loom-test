func.def @encode_e4m3fn(%source: vector<2xf32>) -> (vector<2xf8E4M3>) {
  %4 = vector.extract %source[0] : vector<2xf32> -> f32
  %5 = scalar.fptrunc %4 : f32 to f8E4M3
  %6 = vector.extract %source[1] : vector<2xf32> -> f32
  %7 = scalar.fptrunc %6 : f32 to f8E4M3
  %encoded = vector.from_elements %5, %7 : vector<2xf8E4M3>
  func.return %encoded : vector<2xf8E4M3>
}

