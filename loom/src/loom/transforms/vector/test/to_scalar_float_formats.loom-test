// ====

func.def @matrix_e4m3_ieee(%lhs_data: vector<1xf8E4M3>, %rhs_data: vector<1xf8E4M3>, %init_data: vector<1xf32>) -> (vector<1xf32>) {
  %unit = index.constant 1 : index
  %schema = encoding.define #encoding.f8e4m3 : encoding<schema>
  %lhs = vector.fragment<lhs> %lhs_data shape [%unit, %unit] using {schema = %schema : encoding<schema>} : vector<1xf8E4M3>
  %rhs = vector.fragment<rhs> %rhs_data shape [%unit, %unit] using {schema = %schema : encoding<schema>} : vector<1xf8E4M3>
  %init = vector.fragment<init> %init_data shape [%unit, %unit] : vector<1xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<1xf8E4M3>, vector<1xf8E4M3>, vector<1xf32>
  func.return %result : vector<1xf32>
}

// ----
func.def @matrix_e4m3_ieee(%lhs_data: vector<1xf8E4M3>, %rhs_data: vector<1xf8E4M3>, %init_data: vector<1xf32>) -> (vector<1xf32>) {
  %unit = index.constant 1 : index
  %schema = encoding.define #encoding.f8e4m3 : encoding<schema>
  %lhs = vector.fragment<lhs> %lhs_data shape [%unit, %unit] using {schema = %schema : encoding<schema>} : vector<1xf8E4M3>
  %rhs = vector.fragment<rhs> %rhs_data shape [%unit, %unit] using {schema = %schema : encoding<schema>} : vector<1xf8E4M3>
  %init = vector.fragment<init> %init_data shape [%unit, %unit] : vector<1xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<1xf8E4M3>, vector<1xf8E4M3>, vector<1xf32>
  func.return %result : vector<1xf32>
}
