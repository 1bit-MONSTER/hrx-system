// RUN: pass vector-to-scalar,canonicalize

// Payload and scale formats retain their interpretation independently of the
// scalar type carrying their bits.

func.def @decode_e4m3_ieee(%payload: vector<2xf8E4M3>) -> (vector<2xf32>) {
  %schema = encoding.define #encoding.f8e4m3<payload_elements=2> : encoding<schema>
  %decoded = vector.decode %payload using %schema : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
  func.return %decoded : vector<2xf32>
}

