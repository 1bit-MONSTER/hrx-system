// Nested feedback carries an equality discovered after dependent forwarding components were first distinguished.
func.def @nested_feedback_preserves_correlated_identity(%storage: buffer, %raw: index, %bound_raw: index, %choice_0: i1, %choice_1: i1, %choice_2: i1) -> (index) {
  %base = index.constant 0 : offset
  %step = index.constant 1 : index
  %element_bytes = index.constant 4 : index
  %start = index.constant 0 : index
  %limit = index.constant 2 : index
  %origin = index.assume %raw [range(%raw, 0, 3)] : index
  %bound = index.assume %bound_raw [range(%bound_raw, 1, 4)] : index
  cfg.br ^choose_0
^choose_0:
  cfg.cond_br %choice_0, ^left_0, ^right_0
^left_0:
  cfg.br ^header_0(%start: index, %origin: index, %origin: index, %bound: index)
^right_0:
  cfg.br ^header_0(%start: index, %bound: index, %bound: index, %bound: index)
^header_0(%iteration_0: index, %a_0: index, %b_0: index, %carry_0: index):
  %again_0 = index.cmp slt, %iteration_0, %limit : index
  cfg.cond_br %again_0, ^choose_1, ^exit
^choose_1:
  cfg.cond_br %choice_1, ^left_1, ^right_1
^left_1:
  cfg.br ^header_1(%start: index, %a_0: index, %b_0: index, %bound: index)
^right_1:
  cfg.br ^header_1(%start: index, %b_0: index, %a_0: index, %bound: index)
^header_1(%iteration_1: index, %a_1: index, %b_1: index, %carry_1: index):
  %again_1 = index.cmp slt, %iteration_1, %limit : index
  cfg.cond_br %again_1, ^choose_2, ^leave_1
^choose_2:
  cfg.cond_br %choice_2, ^left_2, ^right_2
^left_2:
  cfg.br ^header_2(%start: index, %a_0: index, %a_1: index)
^right_2:
  cfg.br ^header_2(%start: index, %bound: index, %bound: index)
^header_2(%iteration_2: index, %a_2: index, %b_2: index):
  %again_2 = index.cmp slt, %iteration_2, %limit : index
  cfg.cond_br %again_2, ^guard, ^leave_2
^guard:
  %fits = index.cmp slt, %a_2, %bound : index
  cfg.cond_br %fits, ^access, ^advance_2
^access:
  %byte_origin = index.mul %b_2, %element_bytes : index
  %byte_bound = index.mul %bound, %element_bytes : index
  %view = buffer.view %storage[%base] : buffer -> view<[%byte_bound]xi8>
  %loaded = vector.load %view[%byte_origin] : view<[%byte_bound]xi8> -> vector<4xi8>
  test.use %loaded : vector<4xi8>
  cfg.br ^advance_2
^advance_2:
  %next_2 = index.add %iteration_2, %step : index
  cfg.br ^header_2(%next_2: index, %b_2: index, %a_2: index)
^leave_2:
  cfg.br ^advance_1(%a_2: index)
^advance_1(%feedback_1: index):
  %next_1 = index.add %iteration_1, %step : index
  cfg.br ^header_1(%next_1: index, %b_1: index, %a_1: index, %feedback_1: index)
^leave_1:
  cfg.br ^advance_0(%carry_1: index)
^advance_0(%feedback_0: index):
  %next_0 = index.add %iteration_0, %step : index
  cfg.br ^header_0(%next_0: index, %b_0: index, %a_0: index, %feedback_0: index)
^exit:
  func.return %carry_0 : index
}

