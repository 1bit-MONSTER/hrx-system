// RUN: pass vector-memory-footprint

// A guard on the translated endpoints must keep using their raw SSA relation
// even when both arithmetic summaries have nonconstant materializations.
func.def @translated_endpoint_guard_keeps_raw_relation(%storage: buffer, %base_raw: index, %lane_raw: index, %word_count: i32, %value: i32) {
  %origin = index.constant 0 : offset
  %header_words = index.constant 4 : index
  %base = index.assume %base_raw [range(%base_raw, 0, 992), mul(%base_raw, 32)] : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %count_input = index.cast %word_count : i32 to offset
  %count = index.assume %count_input [range(%count_input, 1, 1024)] : offset
  %limit = index.cast %count : offset to index
  %record_count = index.add %limit, %header_words : index
  %record = buffer.view %storage[%origin] : buffer -> view<[%record_count]xi32>
  %element = index.add %base, %lane : index
  %record_element = index.add %element, %header_words : index
  %in_bounds = index.cmp ult, %record_element, %record_count : index
  cfg.cond_br %in_bounds, ^store, ^exit
^store:
  view.store %value, %record[%record_element] : i32, view<[%record_count]xi32>
  cfg.br ^exit
^exit:
  func.return
}

