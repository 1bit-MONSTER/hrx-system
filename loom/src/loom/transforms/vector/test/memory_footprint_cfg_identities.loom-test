// At element == limit - 1, adding 5 selects the exclusive record endpoint.
func.def @compound_record_rejects_extra_word(%storage: buffer, %base_raw: index, %lane_raw: index, %word_count: i32, %value: i32) {
  %origin = index.constant 0 : offset
