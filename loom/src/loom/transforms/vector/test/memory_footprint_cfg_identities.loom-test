  %count_input = index.cast %word_count : i32 to offset
  %count = index.assume %count_input [range(%count_input, 1, 1024)] : offset
  %limit = index.cast %count : offset to index
  %record_count = index.add %limit, %header_words : index
  %record = buffer.view %storage[%origin] : buffer -> view<[%record_count]xi32>
  %element = index.add %base, %lane : index
  %in_bounds = index.cmp ult, %element, %limit : index
  cfg.cond_br %in_bounds, ^store, ^exit
^store:
  %record_element = index.add %element, %extra_header_words : index
  // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
  view.store %value, %record[%record_element] : i32, view<[%record_count]xi32>
  cfg.br ^exit
^exit:
  func.return
}

