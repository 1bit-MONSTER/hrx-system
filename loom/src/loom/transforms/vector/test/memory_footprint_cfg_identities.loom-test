// ====

// RUN: pass vector-memory-footprint

// For element=4294967291 and limit=4294967292, the guard is true but the
// translated i32 payloads widen to origin=4294967295 and extent=0. Unsigned
// widening establishes nonnegative coordinates; it cannot undo the wrap.
func.def @record_translation_rejects_modular_wrap(%storage: buffer, %element_raw: index, %limit_raw: index, %value: i32) {
  %origin = index.constant 0 : offset
  %element = index.assume %element_raw [range(%element_raw, 0, 4294967291)] : index
  %limit = index.assume %limit_raw [range(%limit_raw, 1, 4294967295)] : index
  %header_words = scalar.constant 4 : i32
  %element_payload = index.cast %element : index to i32
  %limit_payload = index.cast %limit : index to i32
  %record_element_payload = scalar.addi %element_payload, %header_words : i32
  %record_count_payload = scalar.addi %limit_payload, %header_words : i32
  %record_element_wide = scalar.extui %record_element_payload : i32 to i64
  %record_count_wide = scalar.extui %record_count_payload : i32 to i64
  %record_element = index.cast %record_element_wide : i64 to index
  %record_count = index.cast %record_count_wide : i64 to index
  %record = buffer.view %storage[%origin] : buffer -> view<[%record_count]xi32>
  %in_bounds = index.cmp ult, %element, %limit : index
  cfg.cond_br %in_bounds, ^store, ^exit
^store:
  // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
  view.store %value, %record[%record_element] : i32, view<[%record_count]xi32>
  cfg.br ^exit
^exit:
  func.return
}
