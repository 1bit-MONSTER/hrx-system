// RUN: pass vector-memory-footprint

// Equal negative translations preserve the order. The input domains also
// establish that the translated origin and extent are nonnegative.
func.def @compound_record_negative_translation(%storage: buffer, %base_raw: index, %lane_raw: index, %word_count: i32, %value: i32) {
  %origin = index.constant 0 : offset
  %header_words = index.constant 4 : index
  %base = index.assume %base_raw [range(%base_raw, 4, 992)] : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %count_input = index.cast %word_count : i32 to offset
  %count = index.assume %count_input [range(%count_input, 4, 1024)] : offset
  %limit = index.cast %count : offset to index
  %record_count = index.sub %limit, %header_words : index
  %record = buffer.view %storage[%origin] : buffer -> view<[%record_count]xi32>
  %element = index.add %base, %lane : index
  %in_bounds = index.cmp ult, %element, %limit : index
  cfg.cond_br %in_bounds, ^store, ^exit
^store:
  %record_element = index.sub %element, %header_words : index
  view.store %value, %record[%record_element] : i32, view<[%record_count]xi32>
  cfg.br ^exit
^exit:
  func.return
}

