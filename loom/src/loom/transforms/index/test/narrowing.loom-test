// RUN: pass combine,combine

test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

test.target<low_core> @wide

func.def target(@narrow) @native_origin(%origin: offset, %position: i32) -> (offset) {
  %position_wide = scalar.extsi %position : i32 to i64
  %element_bytes = scalar.constant 4 : i64
  %displacement = scalar.muli %position_wide, %element_bytes : i64
  %origin_wide = index.cast %origin : offset to i64
  %sum = scalar.addi %origin_wide, %displacement : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @unsigned_half(%input: i32) -> (offset) {
  %word = scalar.assume %input [range(%input, 0, 2147483647)] : i32
  %extended = scalar.extui %word : i32 to i64
  %bias = scalar.constant 2147483648 : i64
  %sum = scalar.addi %extended, %bias : i64
  %result = index.cast %sum : i64 to offset
  func.return %result : offset
}

func.def target(@wide) @wide_origin(%input: i32, %origin: i64) -> (offset) {
  %extended = scalar.extui %input : i32 to i64
  %sum = scalar.addi %origin, %extended : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

func.def @unselected_origin(%input: i32, %origin: i64) -> (offset) {
  %extended = scalar.extui %input : i32 to i64
  %sum = scalar.addi %origin, %extended : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @unproven_origin(%input: i32, %origin: i64) -> (offset) {
  %extended = scalar.extui %input : i32 to i64
  %sum = scalar.addi %origin, %extended : i64
  %result = index.cast %sum : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @too_large_origin(%input: i32) -> (offset) {
  %extended = scalar.extui %input : i32 to i64
  %bias = scalar.constant 4294967296 : i64
  %sum = scalar.addi %extended, %bias : i64
  %result = index.cast %sum : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @leaf(%input: i64) -> (offset) {
  %bounded = scalar.assume %input [range(%input, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @wide_leaves(%left: i64, %right: i64) -> (offset) {
  %sum = scalar.addi %left, %right : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @wide_consumer(%input: i32, %right: i64) -> (offset, i64) {
  %left = scalar.extsi %input : i32 to i64
  %sum = scalar.addi %left, %right : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result, %sum : offset, i64
}

func.def target(@narrow) @shared_assumption(%input: i32, %right: i64) -> (offset, i64) {
  %left = scalar.extsi %input : i32 to i64
  %sum = scalar.addi %left, %right : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result, %bounded : offset, i64
}

func.def target(@narrow) @attribute_consumer(%input: i32, %right: i64, %other: i64) -> (offset, i64) {
  %left = scalar.extsi %input : i32 to i64
  %sum = scalar.addi %left, %right : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %other_bounded = scalar.assume %other [mul(%sum, 16)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result, %other_bounded : offset, i64
}

func.def target(@narrow) @attribute_consumer_earlier(%input: i32, %right: i64, %other: i64) -> (offset, i64) {
  %left = scalar.extsi %input : i32 to i64
  %sum = scalar.addi %left, %right : i64
  %other_bounded = scalar.assume %other [mul(%sum, 16), mul(%other, 8)] : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result, %other_bounded : offset, i64
}

func.def target(@narrow) @assumption_attribute_consumer(%input: i32, %right: i64, %other: i64) -> (offset, i64) {
  %left = scalar.extsi %input : i32 to i64
  %sum = scalar.addi %left, %right : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %other_bounded = scalar.assume %other [mul(%bounded, 16), mul(%other, 8)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result, %other_bounded : offset, i64
}

func.def target(@narrow) @stronger_assumption(%left: i32, %right: i32) -> (offset) {
  %left_wide = scalar.extsi %left : i32 to i64
  %right_wide = scalar.extsi %right : i32 to i64
  %sum = scalar.addi %left_wide, %right_wide : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 128), mul(%sum, 8)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

func.def target(@narrow) @bounded_operand(%input: i64) -> (offset) {
  %bounded = scalar.assume %input [range(%input, 0, 128), mul(%input, 8)] : i64
  %prefix = scalar.constant 16 : i64
  %sum = scalar.addi %bounded, %prefix : i64
  %result = index.cast %sum : i64 to offset
  func.return %result : offset
}

