test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

test.target<low_core> @wide

func.def target(@narrow) @native_origin(%origin: offset, %position: i32) -> (offset) {
  %113 = index.cast %origin : offset to i32
  %119 = scalar.constant 2 : i32
  %120 = scalar.shli %position, %119 : i32
  %sum = scalar.addi %113, %120 : i32
  %result = index.cast %sum : i32 to offset
  func.return %result : offset
}

