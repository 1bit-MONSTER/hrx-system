kernel.def @while_barrier_rejects_unknown_guard() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%arg: i32) {
  // test.cast has no fact transfer, so this guard has no proven distribution.
  %unknown = test.cast %arg : i32 to f32
  %threshold = scalar.constant 0.0 : f32
  scf.while {
    %continuing = scalar.cmpf ogt, %unknown, %threshold : f32
    scf.condition %continuing : i1
  } do {
    // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="subgroup", control_kind="loop_condition", control_value="continuing", control_op_name="scf.while", control_distribution="unknown"}
    kernel.barrier<global> scope(subgroup) ordering(acq_rel)
    scf.yield
  }
  kernel.return
}

