  // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="workgroup", control_kind="cfg_selector", control_value="is_first_subgroup", control_op_name="cfg.cond_br", control_distribution="subgroup"}
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  cfg.br ^join
^other_subgroups:
  cfg.br ^join
^join:
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  kernel.return
}

