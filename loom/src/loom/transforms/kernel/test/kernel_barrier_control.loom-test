  %limit = scalar.constant 4 : i32
  scf.if %active {
    %final_counter = scf.while(%counter = %c0 : i32) -> (i32) {
      %remaining = scalar.cmpi ult, %counter, %limit : i32
      scf.condition %remaining, %counter : i1, i32
