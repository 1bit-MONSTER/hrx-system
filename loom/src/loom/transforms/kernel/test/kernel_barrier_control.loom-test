// RUN: pass inline-callables,kernel-synchronization-legality

// Barrier convergence depends on the selected, expanded kernel and its value
// facts. It is checked once at kernel synchronization legalization instead of
// during generic operation verification.

kernel.def @split_barrier_wait_rejects_lane_predicated_branch() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %limit = index.constant 32 : index
  %lane = kernel.workitem.id<x> : index
  %active = index.cmp ult, %lane, %limit : index
  %phase = kernel.barrier.arrive<workgroup> scope(workgroup) ordering(acq_rel) -> kernel.barrier.phase
  scf.if %active {
    // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier.wait", required_uniform_scope="workgroup", control_kind="region_selector", control_value="active", control_op_name="scf.if", control_distribution="lane_predicate"}
    kernel.barrier.wait %phase : kernel.barrier.phase
  }
  kernel.return
}

// ====

kernel.def @workgroup_barrier_accepts_uniform_branch() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %first_workgroup = index.constant 0 : index
  %workgroup = kernel.workgroup.id<x> : index
  %is_first_workgroup = index.cmp eq, %workgroup, %first_workgroup : index
  scf.if %is_first_workgroup {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}

