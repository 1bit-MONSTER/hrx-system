// ====

// Required inlining exposes lane-varying control returned by a helper before
// synchronization legality decides whether the barrier converges.
func.def inline @is_first_lane() -> (i1) {
  %first = index.constant 0 : index
  %lane = kernel.workitem.id<x> : index
  %active = index.cmp eq, %lane, %first : index
