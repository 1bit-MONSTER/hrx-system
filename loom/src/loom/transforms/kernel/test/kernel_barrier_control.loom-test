  %view = buffer.view %header[%base] : buffer -> view<1xi32>
  %word = view.load %view[0] : view<1xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %word, %c0 : i32
  func.return %enabled : i1
}

kernel.def @barrier_accepts_inlined_uniform_header_control() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
