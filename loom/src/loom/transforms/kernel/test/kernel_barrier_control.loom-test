// A common initial condition does not prove participation on later visits.
// The lane-dependent increment makes the carried counter and guard varying.
kernel.def @while_condition_barrier_rejects_divergent_backedge() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %limit = scalar.constant 64 : i32
  %lane = kernel.workitem.id<x> : index
  %lane_word = index.cast %lane : index to i32
  %step = scalar.addi %lane_word, %c1 : i32
  %final_counter = scf.while(%counter = %c0 : i32) -> (i32) {
    %remaining = scalar.cmpi ult, %counter, %limit : i32
    // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="subgroup", control_kind="loop_condition", control_value="remaining", control_op_name="scf.while", control_distribution="lane_predicate"}
    kernel.barrier<global> scope(subgroup) ordering(acq_rel)
    scf.condition %remaining, %counter : i1, i32
  } do(%counter: i32) {
    %next_counter = scalar.addi %counter, %step : i32
    scf.yield %next_counter : i32
  }
  kernel.return
}

