// Explicit CFG reconvergence restores workgroup-uniform execution even when
// the predecessor arms were selected independently by each invocation.
kernel.def @workgroup_barrier_accepts_reconverged_cfg_join() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %limit = index.constant 32 : index
  %lane = kernel.workitem.id<x> : index
  %active = index.cmp ult, %lane, %limit : index
  cfg.cond_br %active, ^active_arm, ^inactive_arm
^active_arm:
  cfg.br ^join
^inactive_arm:
  cfg.br ^join
^join:
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  kernel.return
}

