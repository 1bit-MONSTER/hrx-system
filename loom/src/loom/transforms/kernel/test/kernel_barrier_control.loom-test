config.decl @runtime.valid_token_count : %value: index where [range(%value, 1, 131072)]

test.target<low_core> @test_target

kernel.def target(@test_target) @workgroup_barrier_accepts_config_derived_loop_bound() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %tile_rounding_bias = index.constant 15 : index
  %tile_size = index.constant 16 : index
  %valid_token_count = config.get @runtime.valid_token_count : index
  %rounded_token_count = index.add %valid_token_count, %tile_rounding_bias : index
  %tile_count = index.div %rounded_token_count, %tile_size : index
  scf.for %tile = [%loop_begin to %tile_count step %loop_step] {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}

// ====

// The continuation depends only on the uniform counter and bound. A separate
// carried lane value must not weaken that proof in either loop region.
kernel.def @while_barriers_accept_uniform_recurrence_with_varying_data() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%limit: i32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %lane = kernel.workitem.id<x> : index
  %lane_word = index.cast %lane : index to i32
  %final_counter, %final_data = scf.while(%counter = %c0 : i32, %data = %lane_word : i32) -> (i32, i32) {
    %remaining = scalar.cmpi ult, %counter, %limit : i32
    kernel.barrier<global> scope(workgroup) ordering(acq_rel)
    scf.condition %remaining, %counter, %data : i1, i32, i32
  } do(%counter: i32, %data: i32) {
    kernel.barrier<global> scope(workgroup) ordering(acq_rel)
    %next_counter = scalar.addi %counter, %c1 : i32
    %next_data = scalar.addi %data, %lane_word : i32
    scf.yield %next_counter, %next_data : i32, i32
  }
  kernel.return
}

// ====

test.target<low_core> @test_target {abi = hal_kernel, subgroup_size = 32}

// The two subgroups take different iteration counts, but each subgroup has a
// uniform continuation. A workgroup barrier would join different iterations.
kernel.def target(@test_target) @while_barrier_scope_distinguishes_subgroup_guard() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %subgroup = kernel.subgroup.id : index
  %limit = index.add %subgroup, %c1 : index
  %final_counter = scf.while(%counter = %c0 : index) -> (index) {
    %remaining = index.cmp ult, %counter, %limit : index
    kernel.barrier<global> scope(subgroup) ordering(acq_rel)
    scf.condition %remaining, %counter : i1, index
  } do(%counter: index) {
    kernel.barrier<global> scope(subgroup) ordering(acq_rel)
    // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="workgroup", control_kind="loop_condition", control_value="remaining", control_op_name="scf.while", control_distribution="subgroup"}
    kernel.barrier<global> scope(workgroup) ordering(acq_rel)
    %next_counter = index.add %counter, %c1 : index
    scf.yield %next_counter : index
  }
  kernel.return
}

