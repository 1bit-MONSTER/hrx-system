      // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="subgroup", control_kind="region_selector", control_value="active", control_op_name="scf.if", control_distribution="lane_predicate"}
      kernel.barrier<global> scope(subgroup) ordering(acq_rel)
      %next_counter = scalar.addi %counter, %c1 : i32
      scf.yield %next_counter : i32
    }
  }
  kernel.return
}

