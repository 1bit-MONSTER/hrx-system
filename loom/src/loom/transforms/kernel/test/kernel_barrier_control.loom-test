// ====

// A barrier authored in a helper inherits control from its expanded call site.
// Checking the helper in isolation would miss this caller-dependent divergence.
func.def inline @synchronize_workgroup() {
  // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="workgroup", control_kind="region_selector", control_value="active", control_op_name="scf.if", control_distribution="lane_predicate"}
