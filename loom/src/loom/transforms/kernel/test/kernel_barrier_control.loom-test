// A loop header is reached uniformly once, but a varying continuation makes
// later dynamic executions non-uniform and therefore cannot contain a barrier.
kernel.def @workgroup_barrier_rejects_lane_divergent_cfg_loop() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %limit = index.constant 32 : index
  %lane = kernel.workitem.id<x> : index
  %active = index.cmp ult, %lane, %limit : index
  cfg.br ^header
^header:
  // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="workgroup", control_kind="cfg_selector", control_value="active", control_op_name="cfg.cond_br", control_distribution="lane_predicate"}
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  cfg.cond_br %active, ^header, ^exit
^exit:
  kernel.return
}

