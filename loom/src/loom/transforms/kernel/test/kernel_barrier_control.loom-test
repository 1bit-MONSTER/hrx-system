// ====

// The first active lane advances as earlier lanes exit. The broadcast is
// uniform per dynamic execution, but each exiting lane observes its own ID.
kernel.def @cfg_temporal_broadcast_barrier() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %lane_i32 = index.cast %lane : index to i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  cfg.br ^header(%c0: index)
^header(%counter: index):
  %observed = kernel.subgroup.broadcast.first %lane_i32 : i32
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %c1 : index
  cfg.br ^header(%next: index)
^exit:
  %c0_i32 = scalar.constant 0 : i32
  %is_first = scalar.cmpi eq, %observed, %c0_i32 : i32
  cfg.cond_br %is_first, ^active, ^done
^active:
  // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="subgroup", control_kind="cfg_selector", control_value="is_first", control_op_name="cfg.cond_br", control_distribution="lane_predicate"}
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  cfg.br ^done
^done:
  kernel.return
}
