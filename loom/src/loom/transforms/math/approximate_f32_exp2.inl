// Splits the input into an integral exponent and a bounded residual using the
// 1.5 * 2^23 magic bias.
LOOM_MATH_APPROXIMATE_F32_UNARY(VALUE_BITS, BITCAST_I32, VALUE)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(MAGNITUDE_MASK, I32, F32_MAGNITUDE_MASK)
LOOM_MATH_APPROXIMATE_F32_BINARY(MAGNITUDE_BITS, ANDI, VALUE_BITS,
                                 MAGNITUDE_MASK)
LOOM_MATH_APPROXIMATE_F32_UNARY(MAGNITUDE, BITCAST_F32, MAGNITUDE_BITS)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SHIFT, F32, MAGIC_ROUND_BIAS)
LOOM_MATH_APPROXIMATE_F32_BINARY(BIASED, ADDF, VALUE, SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(INTEGRAL, SUBF, BIASED, SHIFT)
LOOM_MATH_APPROXIMATE_F32_UNARY(BIASED_BITS, BITCAST_I32, BIASED)
LOOM_MATH_APPROXIMATE_F32_UNARY(SHIFT_BITS, BITCAST_I32, SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(INTEGRAL_INTEGER, SUBI, BIASED_BITS,
                                 SHIFT_BITS)
LOOM_MATH_APPROXIMATE_F32_BINARY(RESIDUAL, SUBF, VALUE, INTEGRAL)

// Approximates 2^residual - 1 with an Estrin-scheduled FMA polynomial.
LOOM_MATH_APPROXIMATE_F32_BINARY(SQUARED, MULF, RESIDUAL, RESIDUAL)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C0, F32, EXP2_COEFFICIENT_0)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C1, F32, EXP2_COEFFICIENT_1)
LOOM_MATH_APPROXIMATE_F32_TERNARY(PAIR01, FMAF, C0, RESIDUAL, C1)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C2, F32, EXP2_COEFFICIENT_2)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C3, F32, EXP2_COEFFICIENT_3)
LOOM_MATH_APPROXIMATE_F32_TERNARY(PAIR23_INITIAL, FMAF, C2, RESIDUAL, C3)
LOOM_MATH_APPROXIMATE_F32_TERNARY(PAIR23, FMAF, PAIR01, SQUARED, PAIR23_INITIAL)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C4, F32, EXP2_COEFFICIENT_4)
LOOM_MATH_APPROXIMATE_F32_BINARY(LINEAR, MULF, RESIDUAL, C4)
LOOM_MATH_APPROXIMATE_F32_TERNARY(POLYNOMIAL, FMAF, PAIR23, SQUARED, LINEAR)

// Synthesizes the ordinary-range scale directly in exponent bits.
LOOM_MATH_APPROXIMATE_F32_CONSTANT(EXPONENT_SHIFT, I32, EXPONENT_SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(EXPONENT_BITS, SHLI, INTEGRAL_INTEGER,
                                 EXPONENT_SHIFT)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(EXPONENT_BIAS_BITS, I32, F32_ONE)
LOOM_MATH_APPROXIMATE_F32_BINARY(SCALE_BITS, ADDI, EXPONENT_BITS,
                                 EXPONENT_BIAS_BITS)
LOOM_MATH_APPROXIMATE_F32_UNARY(SCALE, BITCAST_F32, SCALE_BITS)
LOOM_MATH_APPROXIMATE_F32_TERNARY(ORDINARY, FMAF, SCALE, POLYNOMIAL, SCALE)

// Uses two normal scale factors near underflow and overflow, then selects the
// full-domain zero, infinity, and NaN behavior without exceptional
// intermediates.
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SIGN_MASK, I32, F32_SIGN_MASK)
LOOM_MATH_APPROXIMATE_F32_BINARY(SIGN_BITS, ANDI, VALUE_BITS, SIGN_MASK)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SIGN_TAIL_SHIFT, I32, I32_SIX)
LOOM_MATH_APPROXIMATE_F32_BINARY(SIGN_TAIL, SHRUI, SIGN_BITS, SIGN_TAIL_SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(SPECIAL_OFFSET, ORI, SIGN_BITS, SIGN_TAIL)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SCALE1_BIAS_BITS, I32, EXP2_SPLIT_BIAS_BITS)
LOOM_MATH_APPROXIMATE_F32_BINARY(SCALE1_BITS, ADDI, SPECIAL_OFFSET,
                                 SCALE1_BIAS_BITS)
LOOM_MATH_APPROXIMATE_F32_BINARY(SCALE2_BITS, SUBI, EXPONENT_BITS,
                                 SPECIAL_OFFSET)
LOOM_MATH_APPROXIMATE_F32_UNARY(SCALE1, BITCAST_F32, SCALE1_BITS)
LOOM_MATH_APPROXIMATE_F32_UNARY(SCALE2, BITCAST_F32, SCALE2_BITS)
LOOM_MATH_APPROXIMATE_F32_TERNARY(SCALE2_POLYNOMIAL, FMAF, SCALE2, POLYNOMIAL,
                                  SCALE2)
LOOM_MATH_APPROXIMATE_F32_BINARY(SPLIT, MULF, SCALE2_POLYNOMIAL, SCALE1)
LOOM_MATH_APPROXIMATE_F32_BINARY(FAR_RESULT, MULF, SCALE1, SCALE1)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SPECIAL_BOUND, F32, EXP2_ORDINARY_BOUND)
LOOM_MATH_APPROXIMATE_F32_COMPARE(ORDINARY_RANGE, CMPF, OLT, MAGNITUDE,
                                  SPECIAL_BOUND)
LOOM_MATH_APPROXIMATE_F32_TERNARY(BOUNDED_RESULT, SELECT_F32, ORDINARY_RANGE,
                                  ORDINARY, SPLIT)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(FAR_BOUND, F32, EXP2_FAR_BOUND)
LOOM_MATH_APPROXIMATE_F32_COMPARE(FAR_RANGE, CMPF, OGT, MAGNITUDE, FAR_BOUND)
LOOM_MATH_APPROXIMATE_F32_TERNARY(RESULT, SELECT_F32, FAR_RANGE, FAR_RESULT,
                                  BOUNDED_RESULT)
