// Recovers exact quarter-turn cardinals from significand bits for large finite
// inputs whose fractional bits are no longer representable.
LOOM_MATH_APPROXIMATE_F32_UNARY(VALUE_BITS, BITCAST_I32, TURNS)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(MAGNITUDE_MASK, I32, F32_MAGNITUDE_MASK)
LOOM_MATH_APPROXIMATE_F32_BINARY(MAGNITUDE_BITS, ANDI, VALUE_BITS,
                                 MAGNITUDE_MASK)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SIGNIFICAND_MASK, I32,
                                   SIGNIFICAND_FRACTION_MASK)
LOOM_MATH_APPROXIMATE_F32_BINARY(SIGNIFICAND_FRACTION, ANDI, MAGNITUDE_BITS,
                                 SIGNIFICAND_MASK)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(HIDDEN_BIT, I32, SIGNIFICAND_HIDDEN_BIT)
LOOM_MATH_APPROXIMATE_F32_BINARY(SIGNIFICAND, ORI, SIGNIFICAND_FRACTION,
                                 HIDDEN_BIT)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C3_I32, I32, I32_THREE)
LOOM_MATH_APPROXIMATE_F32_BINARY(QUARTER_LOW, ANDI, SIGNIFICAND, C3_I32)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C1_I32, I32, I32_ONE)
LOOM_MATH_APPROXIMATE_F32_BINARY(QUARTER_BIT, ANDI, SIGNIFICAND, C1_I32)
LOOM_MATH_APPROXIMATE_F32_BINARY(QUARTER_MIDDLE, SHLI, QUARTER_BIT, C1_I32)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C0_I32, I32, ZERO_BITS)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(MIDDLE_BITS, I32, TRIG_MIDDLE_BOUND_BITS)
LOOM_MATH_APPROXIMATE_F32_COMPARE(BELOW_MIDDLE, CMPI, ULT, MAGNITUDE_BITS,
                                  MIDDLE_BITS)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(UPPER_BITS, I32, TRIG_UPPER_BOUND_BITS)
LOOM_MATH_APPROXIMATE_F32_COMPARE(BELOW_UPPER, CMPI, ULT, MAGNITUDE_BITS,
                                  UPPER_BITS)
LOOM_MATH_APPROXIMATE_F32_TERNARY(UPPER_QUARTER, SELECT_I32, BELOW_UPPER,
                                  QUARTER_MIDDLE, C0_I32)
LOOM_MATH_APPROXIMATE_F32_TERNARY(QUARTER, SELECT_I32, BELOW_MIDDLE,
                                  QUARTER_LOW, UPPER_QUARTER)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SIGN_MASK, I32, F32_SIGN_MASK)
LOOM_MATH_APPROXIMATE_F32_BINARY(INPUT_SIGN, ANDI, VALUE_BITS, SIGN_MASK)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C2_I32, I32, I32_TWO)
LOOM_MATH_APPROXIMATE_F32_BINARY(QUARTER_PHASE, ANDI, QUARTER, C2_I32)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(PHASE_SHIFT, I32, QUARTER_PHASE_SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(CARDINAL_PHASE_SIGN, SHLI, QUARTER_PHASE,
                                 PHASE_SHIFT)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(UNIT_BITS, I32, F32_ONE)
LOOM_MATH_APPROXIMATE_F32_BINARY(CARDINAL_UNIT_SIGNED, XORI, UNIT_BITS,
                                 CARDINAL_PHASE_SIGN)
LOOM_MATH_APPROXIMATE_F32_BINARY(QUARTER_PARITY, ANDI, QUARTER, C1_I32)
LOOM_MATH_APPROXIMATE_F32_BINARY(CARDINAL_UNIT_BITS, XORI, CARDINAL_UNIT_SIGNED,
                                 INPUT_SIGN)
LOOM_MATH_APPROXIMATE_F32_COMPARE(CARDINAL_ZERO, CMPI, EQ, QUARTER_PARITY,
                                  C0_I32)
LOOM_MATH_APPROXIMATE_F32_TERNARY(CARDINAL_BITS, SELECT_I32, CARDINAL_ZERO,
                                  INPUT_SIGN, CARDINAL_UNIT_BITS)
LOOM_MATH_APPROXIMATE_F32_UNARY(CARDINAL, BITCAST_F32, CARDINAL_BITS)

// Reduces ordinary turns to a signed residual in [-0.5, 0.5].
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C2_F32, F32, F32_TWO)
LOOM_MATH_APPROXIMATE_F32_BINARY(DOUBLED, MULF, TURNS, C2_F32)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SHIFT, F32, MAGIC_ROUND_BIAS)
LOOM_MATH_APPROXIMATE_F32_BINARY(BIASED, ADDF, DOUBLED, SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(INTEGRAL, SUBF, BIASED, SHIFT)
LOOM_MATH_APPROXIMATE_F32_UNARY(BIASED_BITS, BITCAST_I32, BIASED)
LOOM_MATH_APPROXIMATE_F32_UNARY(SHIFT_BITS, BITCAST_I32, SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(INTEGRAL_INTEGER, SUBI, BIASED_BITS,
                                 SHIFT_BITS)
LOOM_MATH_APPROXIMATE_F32_BINARY(RESIDUAL, SUBF, DOUBLED, INTEGRAL)

// Approximates sin(pi * residual) with an Estrin-scheduled odd polynomial.
LOOM_MATH_APPROXIMATE_F32_BINARY(SQUARED, MULF, RESIDUAL, RESIDUAL)
LOOM_MATH_APPROXIMATE_F32_BINARY(FOURTH, MULF, SQUARED, SQUARED)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C0, F32, SINE_COEFFICIENT_0)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C1, F32, SINE_COEFFICIENT_1)
LOOM_MATH_APPROXIMATE_F32_TERNARY(PAIR01, FMAF, C1, SQUARED, C0)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C2, F32, SINE_COEFFICIENT_2)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C3, F32, SINE_COEFFICIENT_3)
LOOM_MATH_APPROXIMATE_F32_TERNARY(PAIR23, FMAF, C3, SQUARED, C2)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C4, F32, SINE_COEFFICIENT_4)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C5, F32, SINE_COEFFICIENT_5)
LOOM_MATH_APPROXIMATE_F32_TERNARY(PAIR45, FMAF, C5, SQUARED, C4)
LOOM_MATH_APPROXIMATE_F32_TERNARY(UPPER, FMAF, PAIR45, FOURTH, PAIR23)
LOOM_MATH_APPROXIMATE_F32_TERNARY(POLYNOMIAL, FMAF, UPPER, FOURTH, PAIR01)
LOOM_MATH_APPROXIMATE_F32_BINARY(MAGNITUDE, MULF, RESIDUAL, POLYNOMIAL)

// Restores the quadrant sign and exact signed-zero and half-turn results.
LOOM_MATH_APPROXIMATE_F32_UNARY(MAGNITUDE_RESULT_BITS, BITCAST_I32, MAGNITUDE)
LOOM_MATH_APPROXIMATE_F32_BINARY(INTEGRAL_PARITY, ANDI, INTEGRAL_INTEGER,
                                 C1_I32)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(SIGN_SHIFT, I32, SIGN_SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(POLYNOMIAL_PHASE_SIGN, SHLI, INTEGRAL_PARITY,
                                 SIGN_SHIFT)
LOOM_MATH_APPROXIMATE_F32_BINARY(POLYNOMIAL_BITS, XORI, MAGNITUDE_RESULT_BITS,
                                 POLYNOMIAL_PHASE_SIGN)
LOOM_MATH_APPROXIMATE_F32_UNARY(POLYNOMIAL_RESULT, BITCAST_F32, POLYNOMIAL_BITS)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(C0_F32, F32, ZERO_BITS)
LOOM_MATH_APPROXIMATE_F32_COMPARE(RESIDUAL_ZERO, CMPF, OEQ, RESIDUAL, C0_F32)
LOOM_MATH_APPROXIMATE_F32_UNARY(ABSOLUTE_RESIDUAL, ABSF, RESIDUAL)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(HALF, F32, F32_HALF)
LOOM_MATH_APPROXIMATE_F32_COMPARE(RESIDUAL_HALF, CMPF, OEQ, ABSOLUTE_RESIDUAL,
                                  HALF)
LOOM_MATH_APPROXIMATE_F32_UNARY(RESIDUAL_BITS, BITCAST_I32, RESIDUAL)
LOOM_MATH_APPROXIMATE_F32_BINARY(RESIDUAL_SIGN, ANDI, RESIDUAL_BITS, SIGN_MASK)
LOOM_MATH_APPROXIMATE_F32_BINARY(ORDINARY_UNIT_PHASE, XORI, UNIT_BITS,
                                 POLYNOMIAL_PHASE_SIGN)
LOOM_MATH_APPROXIMATE_F32_BINARY(ORDINARY_UNIT_BITS, XORI, ORDINARY_UNIT_PHASE,
                                 RESIDUAL_SIGN)
LOOM_MATH_APPROXIMATE_F32_UNARY(ORDINARY_UNIT, BITCAST_F32, ORDINARY_UNIT_BITS)
LOOM_MATH_APPROXIMATE_F32_UNARY(SIGNED_ZERO, BITCAST_F32, INPUT_SIGN)
LOOM_MATH_APPROXIMATE_F32_TERNARY(NONZERO_ORDINARY, SELECT_F32, RESIDUAL_HALF,
                                  ORDINARY_UNIT, POLYNOMIAL_RESULT)
LOOM_MATH_APPROXIMATE_F32_TERNARY(ORDINARY, SELECT_F32, RESIDUAL_ZERO,
                                  SIGNED_ZERO, NONZERO_ORDINARY)

// Selects the large finite cardinal result and a canonical nonfinite result.
LOOM_MATH_APPROXIMATE_F32_CONSTANT(LARGE_BITS, I32, TRIG_CARDINAL_BOUND_BITS)
LOOM_MATH_APPROXIMATE_F32_COMPARE(LARGE, CMPI, UGE, MAGNITUDE_BITS, LARGE_BITS)
LOOM_MATH_APPROXIMATE_F32_TERNARY(FINITE, SELECT_F32, LARGE, CARDINAL, ORDINARY)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(NONFINITE_BITS, I32, F32_INFINITY_BITS)
LOOM_MATH_APPROXIMATE_F32_COMPARE(NONFINITE, CMPI, UGE, MAGNITUDE_BITS,
                                  NONFINITE_BITS)
LOOM_MATH_APPROXIMATE_F32_CONSTANT(QUIET_NAN_BITS, I32, F32_QUIET_NAN_BITS)
LOOM_MATH_APPROXIMATE_F32_UNARY(QUIET_NAN, BITCAST_F32, QUIET_NAN_BITS)
LOOM_MATH_APPROXIMATE_F32_TERNARY(RESULT, SELECT_F32, NONFINITE, QUIET_NAN,
                                  FINITE)
