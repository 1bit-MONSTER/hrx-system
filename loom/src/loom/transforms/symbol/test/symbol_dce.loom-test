// RUN: pass cfg-simplify,dce,symbol-dce

test.target<low_core> @test_target

func.decl @add_i32(%lhs: i32, %rhs: i32) -> (i32)

func.def public @entry(%lhs: i32, %rhs: i32) -> (i32) {
  %use_primary = scalar.constant 1 : i1
  cfg.cond_br %use_primary, ^primary, ^fallback
^primary:
  %primary_sum = low.invoke @primary_add(%lhs, %rhs) : (i32, i32) -> (i32)
  cfg.br ^join(%primary_sum: i32)
^fallback:
  %fallback_sum = low.invoke @fallback_add(%lhs, %rhs) : (i32, i32) -> (i32)
  cfg.br ^join(%fallback_sum: i32)
^join(%sum: i32):
  func.return %sum : i32
}

low.func.def target<test.low.core>(@test_target) @primary_add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

low.func.def target<test.low.core>(@test_target) @fallback_add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

// ----
test.target<low_core> @test_target

func.def public @entry(%lhs: i32, %rhs: i32) -> (i32) {
  %primary_sum = low.invoke @primary_add(%lhs, %rhs) : (i32, i32) -> (i32)
  func.return %primary_sum : i32
}

low.func.def target<test.low.core>(@test_target) @primary_add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

// ====

// RUN: pass symbol-dce

test.target<low_core> @test_target

func.decl @add_i32(%lhs: i32, %rhs: i32) -> (i32)

func.def public @entry(%lhs: i32, %rhs: i32) -> (i32) {
  %sum = low.invoke @live_add(%lhs, %rhs) : (i32, i32) -> (i32)
  func.return %sum : i32
}

func.def @dead_wrapper(%lhs: i32, %rhs: i32) -> (i32) {
  %sum = low.invoke @dead_add(%lhs, %rhs) : (i32, i32) -> (i32)
  func.return %sum : i32
}

low.func.def target<test.low.core>(@test_target) @live_add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

low.func.def target<test.low.core>(@test_target) @dead_add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

// ----
test.target<low_core> @test_target

func.def public @entry(%lhs: i32, %rhs: i32) -> (i32) {
  %sum = low.invoke @live_add(%lhs, %rhs) : (i32, i32) -> (i32)
  func.return %sum : i32
}

low.func.def target<test.low.core>(@test_target) @live_add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

// ====

// RUN: pass symbol-dce

test.target<low_core> @test_target

func.def retain @retained_wrapper(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def @dead_wrapper(%value: i32) -> (i32) {
  func.return %value : i32
}

low.func.def retain target<test.low.core>(@test_target) @retained_low(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

low.func.def target<test.low.core>(@test_target) @dead_low(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

func.def public @entry(%value: i32) -> (i32) {
  func.return %value : i32
}

// ----
test.target<low_core> @test_target

func.def retain @retained_wrapper(%value: i32) -> (i32) {
  func.return %value : i32
}

low.func.def retain target<test.low.core>(@test_target) @retained_low(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

func.def public @entry(%value: i32) -> (i32) {
  func.return %value : i32
}

// ====

// RUN: pass symbol-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @dead_add(%lhs: reg<test.i32>) -> (reg<test.i32>) {
  low.return %lhs : reg<test.i32>
}

func.def public @entry(%lhs: i32) -> (i32) {
  // ERROR@+1: SYMBOL/002 "missing_low"
  %sum = low.invoke @missing_low(%lhs) : (i32) -> (i32)
  func.return %sum : i32
}

// ====

// Target-low kernel entries also export under their symbol name.
// RUN: pass symbol-dce

test.target<low_core> @test_target

low.kernel.def target<test.low.core>(@test_target) @implicit_export() asm {
  return
}

low.func.def target<test.low.core>(@test_target) @dead_helper() asm {
  return
}

// ----
test.target<low_core> @test_target

low.kernel.def target<test.low.core>(@test_target) @implicit_export() asm {
  return
}

// ====

// RUN: pass symbol-dce

// A declaration's own predicates disappear when its unreachable symbol dies.
config.decl @unused_width : %width: index where [range(%width, 1, 1024), mul(%width, 16)]

func.def public @entry() {
  func.return
}

// ----
func.def public @entry() {
  func.return
}

// ====

// RUN: pass symbol-dce

// Availability arrays do not keep private definitions alive.
test.record @required

func.decl @available()

func.decl @unused()

func.def public @entry() {
  test.symbol_array_attrs [@required, @required] using [@available, @available]
  func.return
}

// ----
test.record @required

func.def public @entry() {
  test.symbol_array_attrs [@required, @required] using [@available, @available]
  func.return
}

// ====

// RUN: pass symbol-dce

// Nested type references belong to the defining function, not the module.
func.decl @required()

func.decl @unused()

func.def @dead(%values: test.array<i32, metadata = {callee = @unused}>) {
  func.return
}

func.def public @entry(%values: test.array<i32, metadata = {callee = @required}>) {
  test.use %values : test.array<i32, metadata = {callee = @required}>
  func.return
}

// ----
func.decl @required()

func.def public @entry(%values: test.array<i32, metadata = {callee = @required}>) {
  test.use %values : test.array<i32, metadata = {callee = @required}>
  func.return
}

// ====

// RUN: pass symbol-dce

// Reciprocal placement constraints keep their definition cluster intact.
global.rodata.def @table = conflicts([@peer]) bytes("00112233")

global.rodata.def @peer = conflicts([@table]) bytes("44556677")

func.def public @entry() -> (buffer) {
  %table = global.load @table : buffer
  func.return %table : buffer
}

// ----
global.rodata.def @table = conflicts([@peer]) bytes("00112233")

global.rodata.def @peer = conflicts([@table]) bytes("44556677")

func.def public @entry() -> (buffer) {
  %table = global.load @table : buffer
  func.return %table : buffer
}
