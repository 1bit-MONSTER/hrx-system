// RUN: verify

// Undefined global reference.
func.def @undefined_load() {
  // ERROR@+1: SYMBOL/002 "missing"
  %v = global.load @missing : f32
  func.return
}

// ====

// Loading from a function symbol is a kind mismatch.
func.def @callee(%x: f32) -> (f32) {
  func.return %x : f32
}

func.def @load_from_function() {
  // ERROR@+1: SYMBOL/003 "expected global"
  %v = global.load @callee : f32
  func.return
}

// ====

// Extra co-results that are not referenced by the loaded value type are invalid.
global.constant @pi : f32

func.def @load_extra_result() {
  // ERROR@+1: STRUCTURE/002
  %v, %extra = global.load @pi : f32
  func.return
}

// ====

// Global structural equality must survive at the load site.
global.variable @square : tile<[%n]x[%n]xf32>

func.def @load_square_mismatch() {
  // ERROR@+1: TYPE/001 "loaded value"
  %tile, %m, %k = global.load @square : tile<[%m]x[%k]xf32>
  func.return
}

// ====

// Equal dim refs count as one co-result.
global.variable @square_ok : tile<[%n]x[%n]xf32>

func.def @load_square_ok() {
  %tile, %n = global.load @square_ok : tile<[%n]x[%n]xf32>
  func.return
}

// ====

// Storing a rectangular value to a square global is invalid.
global.variable @square_store : tile<[%n]x[%n]xf32>

func.def @store_square_mismatch(%m: index, %k: index, %value: tile<[%m]x[%k]xf32>) {
  // ERROR@+1: TYPE/001 "stored value"
  global.store %value, @square_store : tile<[%m]x[%k]xf32>
  func.return
}

// ====

// Inline initializers are scalar-only in this format.
// ERROR@+1: TYPE/004 "scalar"
global.constant @weights_with_initializer : tile<4xf32> = [1, 2, 3, 4]

// ====

// Float globals require float literal initializers.
// ERROR@+1: TYPE/005 "initializer"
global.constant @pi_bad_initializer : f32 = 1

// ====

// i1 integer initializers must be 0 or 1.
// ERROR@+1: TYPE/005 "initializer"
global.variable @bad_flag : i1 = 2

// ====

// Read-only artifact alignment must be either absent or a positive power of two.
// ERROR@+1: STRUCTURE/014 "alignment" "3" "positive power-of-two byte alignment"
global.rodata.def @bad_rodata_alignment = align(3) bytes("00")

// ====

// Empty conflict sets use the absent optional form.
// ERROR@+1: STRUCTURE/014 "bank_conflicts" "0" "non-empty symbol set"
global.rodata.def @empty_conflicts = conflicts([]) bytes("00")

// ====

// A definition cannot conflict with itself.
// ERROR@+1: SYMBOL/006 "bank_conflicts" "self_conflict" "self_conflict" "cannot conflict with itself"
global.rodata.def @self_conflict = conflicts([@self_conflict]) bytes("00")

// ====

// Bank-conflict relations must be reciprocal.
// ERROR@+1: SYMBOL/006 "bank_conflicts" "one_sided" "unconstrained" "does not reciprocate"
global.rodata.def @one_sided = conflicts([@unconstrained]) bytes("00")
global.rodata.def @unconstrained = bytes("00")

// ====

// Externally supplied data has no compiler-owned bank placement.
global.rodata.decl @external_data
// ERROR@+1: SYMBOL/006 "bank_conflicts" "conflicts_with_decl" "external_data" "not a read-only data definition"
global.rodata.def @conflicts_with_decl = conflicts([@external_data]) bytes("00")

// ====

// Read-only data materializes as exactly one buffer root.
global.rodata.def @message = bytes("6c6f6f6d")

func.def @load_rodata_wrong_type() {
  // ERROR@+1: TYPE/004 "result 0" "f32" "buffer"
  %message = global.load @message : f32
  func.return
}

// ====

global.rodata.def @message_with_extra_result = bytes("6c6f6f6d")

func.def @load_rodata_extra_result() {
  // ERROR@+1: STRUCTURE/002
  %message, %extra = global.load @message_with_extra_result : buffer
  func.return
}

// ====

// Read-only data is not a value-global store target.
global.rodata.def @immutable_message = bytes("6c6f6f6d")

func.def @store_rodata(%value: buffer) {
  // ERROR@+1: SYMBOL/003 "expected global"
  global.store %value, @immutable_message : buffer
  func.return
}

// ====

// Dynamic vector globals match structurally; declaration-local dim names do not
// need to be the same SSA ids as use-site co-results.
global.variable @vec_state : vector<[%n]xf32>

func.def @vector_global_load() {
  %vec, %m = global.load @vec_state : vector<[%m]xf32>
  func.return
}

// ====

// View globals use the same structural dim/layout matching path.
global.variable @view_state : view<[%n]xf32, %layout>

func.def @view_global_load() {
  %view, %m, %layout = global.load @view_state : view<[%m]xf32, %layout>
  func.return
}

// ====

// Global predicates constrain declaration-local dynamic dimensions in their
// retained index domain.
// ERROR@+1: TYPE/003 "predicates[0].arg[0]" "index" "floating-point scalar"
global.constant @bad_dimension_predicate : tile<[%n]xf32> where [finite(%n)]

// ====

// The first predicate value identifies the dynamic dimension whose facts are
// transported to each load.
// ERROR@+1: STRUCTURE/032 {op_name="global.variable", field_name="predicates[0].arg[0]", required_origin="a declaration-local dynamic dimension"}
global.variable @constant_first_predicate : tile<[%n]xf32> where [eq(4, %n)]

// ====

global.constant @valid_dimension_predicate : tile<[%m]x[%n]xf32> where [range(%m, 1, 4096), le(%m, %n)]
