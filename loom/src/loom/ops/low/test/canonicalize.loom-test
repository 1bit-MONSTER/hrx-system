// RUN: pass canonicalize

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @tied_result_capture_before_write(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.tied.any %source
  %saved = slice %first[0] : reg<test.i32> -> reg<test.i32>
  %second = test.tied.any %first
  return %saved, %second
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @tied_result_capture_before_write(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.tied.any %source
  %saved = slice %first[0] : reg<test.i32> -> reg<test.i32>
  %second = test.tied.any %first
  return %saved, %second
}

