low.func.def target<test.low.core>(@test_target) @consume_alias_capture_independently(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %alias = low.assume %source [range(%source, 0, 1024)] : reg<test.i32>
