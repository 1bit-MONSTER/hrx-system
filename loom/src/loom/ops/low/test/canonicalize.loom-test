// ====

// Even an identity-width slice preserves the value before a destructive use.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @identity_capture_before_write(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %saved = slice %source[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %source
  return %saved, %changed
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @identity_capture_before_write(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %saved = slice %source[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %source
  return %saved, %changed
}

