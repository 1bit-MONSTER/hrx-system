// ====

// Signedness is independent of the register class or its payload type.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @unsigned_counter(%lower: reg<test.i32>, %upper: reg<test.i32>, %step: reg<test.i32>, %initial: reg<test.i32>) -> (reg<test.i32>) asm {
  %last = low.scf.for unsigned [%lower to %upper step %step] iter_args(%initial: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %previous: reg<test.i32>) {
    low.scf.yield %iv : reg<test.i32>
  }
  return %last
}
