// RUN: roundtrip

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @void_if(%condition: reg<test.i32>) {
  low.scf.if %condition {
    low.scf.yield
  }
  low.return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @void_if(%condition: reg<test.i32>) asm {
  low.scf.if %condition {
  }
  return
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @if_single_result(%condition: reg<test.i32>, %then_value: reg<test.i32>, %else_value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.if %condition -> (reg<test.i32>) {
    low.scf.yield %then_value : reg<test.i32>
  } else {
    low.scf.yield %else_value : reg<test.i32>
  }
  return %result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @if_multi_result(%condition: reg<test.i32>, %then_i32: reg<test.i32>, %else_i32: reg<test.i32>, %then_ptr: reg<test.ptr>, %else_ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.ptr>) asm {
  %i32_result, %ptr_result = low.scf.if %condition -> (reg<test.i32>, reg<test.ptr>) {
    low.scf.yield %then_i32, %then_ptr : reg<test.i32>, reg<test.ptr>
  } else {
    low.scf.yield %else_i32, %else_ptr : reg<test.i32>, reg<test.ptr>
  }
  return %i32_result, %ptr_result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @for_carried(%lower: reg<test.i32>, %upper: reg<test.i32>, %step: reg<test.i32>, %init: reg<test.i32>, %factor: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%init: reg<test.i32>) -> (reg<test.i32>) unroll(%factor) do(%iv: reg<test.i32>, %acc: reg<test.i32>) {
    low.scf.yield %acc : reg<test.i32>
  }
  return %result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @while_carried(%condition: reg<test.i32>, %init: reg<test.i32>, %bias: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.while(%before = %init : reg<test.i32>) -> (reg<test.i32>) {
    %forwarded = test.add.i32 %before, %bias
    low.scf.condition %condition, %forwarded : reg<test.i32>, reg<test.i32>
  } do(%body: reg<test.i32>) {
    low.scf.yield %body : reg<test.i32>
  }
  return %result
}

// ====

test.target<low_core> @test_target

// The condition can construct a wider body/result tuple than the state fed
// back into the next condition evaluation.
low.func.def target<test.low.core>(@test_target) @while_condition_payload(%condition: reg<test.i32>, %init: reg<test.i32>, %bias: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %state, %payload = low.scf.while(%before = %init : reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) {
    %forwarded = test.add.i32 %before, %bias
    low.scf.condition %condition, %before, %forwarded : reg<test.i32>, reg<test.i32>, reg<test.i32>
  } do(%body_state: reg<test.i32>, %body_payload: reg<test.i32>) {
    %next = test.add.i32 %body_state, %body_payload
    low.scf.yield %next : reg<test.i32>
  }
  return %state, %payload
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @while_condition_only_payload(%condition: reg<test.i32>, %payload: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.while -> (reg<test.i32>) {
    low.scf.condition %condition, %payload : reg<test.i32>, reg<test.i32>
  } do(%body: reg<test.i32>) {
    low.scf.yield
  }
  return %result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @while_header_only_state(%condition: reg<test.i32>, %init: reg<test.i32>) asm {
  low.scf.while(%before = %init : reg<test.i32>) {
    low.scf.condition %condition : reg<test.i32>
  } do {
    low.scf.yield %init : reg<test.i32>
  }
  return
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @for_bare_unroll(%lower: reg<test.i32>, %upper: reg<test.i32>, %step: reg<test.i32>) {
  low.scf.for signed [%lower to %upper step %step] unroll do(%iv: reg<test.i32>) {
    low.scf.yield
  }
  low.return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @for_bare_unroll(%lower: reg<test.i32>, %upper: reg<test.i32>, %step: reg<test.i32>) asm {
  low.scf.for signed [%lower to %upper step %step] unroll do(%iv: reg<test.i32>) {
  }
  return
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @asm_nested_if(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.if %condition -> (reg<test.i32>) {
    %then_sum = test.add.i32 %lhs, %rhs
    low.scf.yield %then_sum : reg<test.i32>
  } else {
    %else_sum = test.add.i32 %rhs, %lhs
    low.scf.yield %else_sum : reg<test.i32>
  }
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @asm_nested_if(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.if %condition -> (reg<test.i32>) {
    %then_sum = test.add.i32 %lhs, %rhs
    low.scf.yield %then_sum : reg<test.i32>
  } else {
    %else_sum = test.add.i32 %rhs, %lhs
    low.scf.yield %else_sum : reg<test.i32>
  }
  return %result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @asm_nested_for(%lower: reg<test.i32>, %upper: reg<test.i32>, %step: reg<test.i32>, %init: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%init: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %acc: reg<test.i32>) {
    %next = test.add.i32 %acc, %iv
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

