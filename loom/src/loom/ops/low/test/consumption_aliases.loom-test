low.func.def target<test.low.core>(@target) @exclusive_consumers(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %alias = low.assume %seed [range(%seed, 0, 1024)] : reg<test.i32>
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %left_changed = test.tied.any %seed
  return %left_changed
^right:
  %right_changed = test.tied.any %alias
  return %right_changed
}

