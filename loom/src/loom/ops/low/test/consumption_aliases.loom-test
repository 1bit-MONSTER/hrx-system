// ====

// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @exclusive_structured_alias_consumers(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %alias = low.assume %seed [range(%seed, 0, 1024)] : reg<test.i32>
  %result = low.scf.if %condition -> (reg<test.i32>) {
    %left = test.tied.any %seed
    low.scf.yield %left : reg<test.i32>
  } else {
    %right = test.tied.any %alias
    low.scf.yield %right : reg<test.i32>
  }
  return %result
}

