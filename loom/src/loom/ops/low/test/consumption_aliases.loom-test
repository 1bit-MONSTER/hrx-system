  low.scf.for signed [%lower to %upper step %step] do(%iv: reg<test.i32>) {
    %owner = copy %seed : reg<test.i32> -> reg<test.i32>
    %alias = low.assume %owner [range(%owner, 0, 1024)] : reg<test.i32>
    %changed = test.tied.any %alias
  }
  return
}

// ====
// Variadic identities keep each corresponding owner independent.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @distinct_result_owners(%first: reg<test.i32>, %second: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %left, %right = low.assume %first, %second [] : reg<test.i32>, reg<test.i32>
  %changed = test.tied.any %left
  return %changed, %right
}

// ====
// Repeated operands publish two members of the same owner, not separate owners.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @repeated_result_owner(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %left, %right = low.assume %seed, %seed [] : reg<test.i32>, reg<test.i32>
  %changed = test.tied.any %left
  // ERROR@+1: DOMINANCE/002 {value_name="right"}
  return %right
}

// ====
// Moved results consume the same alias family as destructive tied results.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @move_consumes_alias_family(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %alias = low.assume %seed [] : reg<test.i32>
  %moved = move %alias : reg<test.i32> -> reg<test.i32>
  // ERROR@+1: DOMINANCE/002 {value_name="seed"}
  return %seed
}

// ====
// A moved result starts a fresh owner even when physical storage is reused.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @move_creates_owner(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %alias = low.assume %seed [] : reg<test.i32>
  %moved = move %alias : reg<test.i32> -> reg<test.i32>
  %fresh = low.assume %moved [] : reg<test.i32>
  %changed = test.tied.any %fresh
  return %changed
}

// ====
// A dead consumer cannot invalidate an observation on the live path, even
// when the dead block has an edge to the live observer.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @unreachable_consumer(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %alias = low.assume %seed [] : reg<test.i32>
  low.br ^live
^live:
  return %seed
^dead:
  %changed = test.tied.any %alias
  low.br ^live
}

// ====
// Both DFS orders of disjoint consumers and observations are valid.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @disjoint_observer_first(%condition: reg<test.i32>, %first: reg<test.i32>, %second: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %left, %right = low.assume %first, %second [] : reg<test.i32>, reg<test.i32>
  low.cond_br %condition, ^observe, ^consume_first : reg<test.i32>
^observe:
  return %first, %second
^consume_first:
  %changed_first = test.tied.any %left
  low.br ^consume_second
^consume_second:
  %changed_second = test.tied.any %right
  return %changed_first, %changed_second
}

// ====
// A structurally invalid alias is diagnosed before publishing its owner.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @unavailable_alias_source(%condition: reg<test.i32>, %seed: reg<test.i32>) asm {
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %independent = copy %seed : reg<test.i32> -> reg<test.i32>
  return
^right:
  // ERROR@+1: DOMINANCE/001 {value_name="independent"}
  %alias = low.assume %independent [] : reg<test.i32>
  return
}
