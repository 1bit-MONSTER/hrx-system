low.func.def target<test.low.core>(@target) @nested_recreation_across_cfg_backedge(%condition: reg<test.i32>, %seed: reg<test.i32>) asm {
  low.br ^loop
^loop:
  %owner = copy %seed : reg<test.i32> -> reg<test.i32>
  low.scf.if %condition {
    %changed = move %owner : reg<test.i32> -> reg<test.i32>
  }
  low.cond_br %condition, ^loop, ^exit : reg<test.i32>
^exit:
  return
}
