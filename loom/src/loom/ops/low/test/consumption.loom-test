low.func.def target<test.low.core>(@target) @while_carried_owners(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.while(%before = %seed : reg<test.i32>) -> (reg<test.i32>) {
    %forwarded = test.tied.any %before
    low.scf.condition %condition, %forwarded : reg<test.i32>, reg<test.i32>
  } do(%body: reg<test.i32>) {
    %changed = move %body : reg<test.i32> -> reg<test.i32>
    low.scf.yield %changed : reg<test.i32>
  }
  return %result
}

