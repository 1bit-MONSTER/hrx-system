// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @nested_consume_excludes_cfg_sibling(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %result = low.scf.if %condition -> (reg<test.i32>) {
    %changed = test.tied.any %seed
    low.scf.yield %changed : reg<test.i32>
  } else {
    low.scf.yield %seed : reg<test.i32>
  }
  return %result
^right:
  return %seed
}

