// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @direct_reuse(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %changed = test.tied.any %seed
  // ERROR@+1: DOMINANCE/002 {value_name="seed"}
  return %seed
}

// ====

// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @exclusive_structured_consumers(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.if %condition -> (reg<test.i32>) {
    %left = test.tied.any %seed
    low.scf.yield %left : reg<test.i32>
  } else {
    %right = test.tied.any %seed
    low.scf.yield %right : reg<test.i32>
  }
  return %result
}

