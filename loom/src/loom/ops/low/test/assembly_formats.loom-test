// RUN: format bytecode

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_extent(%extent: reg<test.i32>) -> (reg<test.ptr>, reg<test.ptr>) asm {
  %fixed = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<test.ptr>
  %dynamic = resource<hal_binding> extent(%extent) {index = 1, source_type = hal.buffer} : reg<test.ptr>
  return %fixed, %dynamic
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @register_aliases() -> (reg<test.i32>) asm {
  %input = live_in<test.arg0> {} : reg<test.i32>
  %pair = concat(%input, %input) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lane = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  %copied = copy %lane {detached = true} : reg<test.i32> -> reg<test.i32>
  %moved = move %copied : reg<test.i32> -> reg<test.i32>
  return %moved
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @storage_aliases() -> (reg<test.ptr>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 16} : low.storage<workgroup>
  %window = storage_view %storage {byte_length = 8, offset = 4} : low.storage<workgroup> -> low.storage<workgroup>
  %address = storage_address %window : low.storage<workgroup> -> reg<test.ptr>
  return %address
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @empty_return() asm {
  return
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @canonical_return(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.return %value : reg<test.i32>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @canonical_return(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

// ====
// RUN: verify

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compact_return_annotation(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  // ERROR@+1: PARSE/003
  return %value : reg<test.i32>
}

// ====
// RUN: format bytecode

// Full register types, including semantic payloads, come from the tied input.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @inherited_scalar_type(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>) asm {
  %result = test.tied.any %source
  return %result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @inherited_vector_type(%source: reg<test.i32 x4 : vector<4xi32>>) -> (reg<test.i32 x4 : vector<4xi32>>) asm {
  %result = test.early_tied.v4i32 %source
  return %result
}

// ====

// Destructive register reuse inherits the type but does not consume ownership.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @destructive_without_ownership(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i64 : i64>) asm {
  %result = test.destructive.any %source
  return %result, %source
}

// ====

// Authored ownership is retained even when the descriptor has no default tie.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @destructive_with_ownership(%source: reg<test.i64 : i64>) -> (reg<test.i64 : i64>) asm {
  %result = test.destructive.any %source : %source as reg<test.i64 : i64>
  return %result
}

// ====

// Default tie rows are deliberately not in result order in the descriptor.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @reordered_default_ties(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>) asm {
  %first, %second = test.tied.pair %left, %right : %right as reg<test.i64 : i64>, %left as reg<test.i32 : i32>
  return %first, %second
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @reordered_default_ties(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>) asm {
  %first, %second = test.tied.pair %left, %right
  return %first, %second
}

// ====

// Explicit ownership replaces the whole default set; it is not merged with it.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @partially_owned_results(%left: reg<test.i32 : i32>, %right: reg<test.i64 : i64>) -> (reg<test.i64 : i64>, reg<test.i32 : i32>, reg<test.i32 : i32>) asm {
  %first, %second = test.tied.pair %left, %right : %right as reg<test.i64 : i64>, reg<test.i32 : i32>
  return %first, %second, %left
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @replaced_ownership(%left: reg<test.i32 : i32>, %right: reg<test.i32 : i32>) -> (reg<test.i32 : i32>, reg<test.i32 : i32>) asm {
  %first, %second = test.tied.pair %left, %right : %left as reg<test.i32 : i32>, %right as reg<test.i32 : i32>
  return %first, %second
}
