// RUN: roundtrip

// scf.for: minimal counted loop, no iter_args, no results.
func.def @simple_loop(%lo: index, %hi: index, %step: index) {
  scf.for %iv = [%lo to %hi step %step] {
    scf.yield
  }
  func.return
}

// ----
func.def @simple_loop(%lo: index, %hi: index, %step: index) {
  scf.for %iv = [%lo to %hi step %step] {
  }
  func.return
}

// ====

// Physical byte ranges use the offset domain without narrowing to index.
func.def @offset_loop(%lo: offset, %hi: offset, %step: offset) {
  scf.for %byte_offset = [%lo to %hi step %step] {
    test.use %byte_offset : offset
  }
  func.return
}

// ====

// scf.for with a single iter_arg accumulating a constant.
func.def @sum_loop(%lo: index, %hi: index, %step: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ====

// scf.for with multiple iter_args of different types.
func.def @multi_iter(%lo: index, %hi: index, %step: index, %a: f32, %b: i32) -> (f32, i32) {
  %x, %y = scf.for %iv = [%lo to %hi step %step](%fa = %a : f32, %fb = %b : i32) -> (f32, i32) {
    scf.yield %fa, %fb : f32, i32
  }
  func.return %x, %y : f32, i32
}

// ====

// scf.for with bare local unroll policy.
func.def @bare_unroll_policy(%lo: index, %hi: index, %step: index) {
  scf.for %iv = [%lo to %hi step %step] unroll {
    scf.yield
  }
  func.return
}

// ----
func.def @bare_unroll_policy(%lo: index, %hi: index, %step: index) {
  scf.for %iv = [%lo to %hi step %step] unroll {
  }
  func.return
}

// ====

// scf.for with an SSA unroll factor policy after the loop signature.
func.def @dynamic_unroll_policy(%lo: index, %hi: index, %step: index, %factor: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) unroll(%factor) {
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ====

// scf.for with an explicit unroll materialization schedule.
func.def @dynamic_unroll_interleaved_schedule(%lo: index, %hi: index, %step: index, %factor: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) unroll(%factor) schedule(interleaved) {
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ====

// scf.for with an explicit linear schedule prints the requested schedule rather
// than relying on the absent-attribute default.
func.def @dynamic_unroll_linear_schedule(%lo: index, %hi: index, %step: index, %factor: index) {
  scf.for %iv = [%lo to %hi step %step] unroll(%factor) schedule(linear) {
  }
  func.return
}

// ====

// scf.for with a recurrence-aware materialization schedule.
func.def @dynamic_unroll_recurrence_schedule(%lo: index, %hi: index, %step: index, %factor: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) unroll(%factor) schedule(recurrence) {
    %next = scalar.addf %acc, %acc : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

// Compile-time scheduling fences round-trip without operands or attributes.
func.def @schedule_fence() {
  scf.schedule.fence
  func.return
}

// ====

// scf.for also accepts grouped iter_arg type lists, then prints the canonical
// per-binding type form.
func.def @multi_vector_iter_grouped_types(%lo: index, %hi: index, %step: index, %gate_zero: vector<1xf32>, %up_zero: vector<1xf32>) -> (vector<1xf32>, vector<1xf32>) {
  %gate, %up = scf.for %hidden = [%lo to %hi step %step](%gate_acc = %gate_zero, %up_acc = %up_zero : vector<1xf32>, vector<1xf32>) -> (vector<1xf32>, vector<1xf32>) {
    scf.yield %gate_acc, %up_acc : vector<1xf32>, vector<1xf32>
  }
  func.return %gate, %up : vector<1xf32>, vector<1xf32>
}

// ----
func.def @multi_vector_iter_grouped_types(%lo: index, %hi: index, %step: index, %gate_zero: vector<1xf32>, %up_zero: vector<1xf32>) -> (vector<1xf32>, vector<1xf32>) {
  %gate, %up = scf.for %hidden = [%lo to %hi step %step](%gate_acc = %gate_zero : vector<1xf32>, %up_acc = %up_zero : vector<1xf32>) -> (vector<1xf32>, vector<1xf32>) {
    scf.yield %gate_acc, %up_acc : vector<1xf32>, vector<1xf32>
  }
  func.return %gate, %up : vector<1xf32>, vector<1xf32>
}

// ====

// scf.for body containing a non-trivial inner op.
func.def @loop_body_op(%lo: index, %hi: index, %step: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    %next = scalar.addf %acc, %acc : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

// scf.while without loop-carried values.
func.def @void_while(%cond: i1) {
  scf.while {
    scf.condition %cond : i1
  } do {
    scf.yield
  }
  func.return
}

// ====

// scf.while with one loop-carried value. The before region uses a binding list
// for the current value, while the after region spells its block args directly.
func.def @count_while(%init: index, %limit: index, %one: index) -> (index) {
  %result = scf.while(%before = %init : index) -> (index) {
    %keep_going = index.cmp slt, %before, %limit : index
    scf.condition %keep_going, %before : i1, index
  } do(%body: index) {
    %next = index.add %body, %one : index
    scf.yield %next : index
  }
  func.return %result : index
}

// ====

// RUN: format bytecode

// The condition entry and body/results each own their dependent type scheme.
// Both argument lists can refer forward to peer arguments declared later in
// the same list.
func.def @dependent_while(%condition: i1, %extent: index, %layout: encoding<layout>, %input: view<[%extent]xf32, %layout>) {
  %result_view, %result_extent, %result_layout = scf.while(%before_view = %input : view<[%before_extent]xf32, %before_layout>, %before_extent = %extent : index, %before_layout = %layout : encoding<layout>) -> (view<[%result_extent]xf32, %result_layout>, index, encoding<layout>) {
    scf.condition %condition, %before_view, %before_extent, %before_layout : i1, view<[%before_extent]xf32, %before_layout>, index, encoding<layout>
  } do(%body_view: view<[%body_extent]xf32, %body_layout>, %body_extent: index, %body_layout: encoding<layout>) {
    scf.yield %body_view, %body_extent, %body_layout : view<[%body_extent]xf32, %body_layout>, index, encoding<layout>
  }
  test.use %result_view, %result_extent, %result_layout : view<[%result_extent]xf32, %result_layout>, index, encoding<layout>
  func.return
}

// ====

// Reusing one incoming SSA value for distinct tuple roles must not collapse
// the role-local header or result identities used by dependent types.
func.def @duplicate_initial_roles(%condition: i1, %extent: index, %input: view<[%extent]xf32>) {
  %result_view, %result_left, %result_right = scf.while(%before_view = %input : view<[%before_left]xf32>, %before_left = %extent : index, %before_right = %extent : index) -> (view<[%result_right]xf32>, index, index) {
    scf.condition %condition, %before_view, %before_left, %before_left : i1, view<[%before_left]xf32>, index, index
  } do(%body_view: view<[%body_right]xf32>, %body_left: index, %body_right: index) {
    scf.yield %input, %extent, %extent : view<[%extent]xf32>, index, index
  }
  func.return
}

// ====

// Header state and the condition-forwarded body/result tuple may have
// different arities. The payload is computed only at the condition point, so
// the loop needs no artificial initial or backedge payload.
func.def @condition_payload(%input: view<8xi32>, %initial: index, %limit: index, %initial_sum: i32) -> (index, i32, i32) {
  %c1 = index.constant 1 : index
  %result_position, %result_sum, %result_payload = scf.while(%before_position = %initial : index, %before_sum = %initial_sum : i32) -> (index, i32, i32) {
    %keep_going = index.cmp ult, %before_position, %limit : index
    %payload = view.load %input[%before_position] : view<8xi32> -> i32
    scf.condition %keep_going, %before_position, %before_sum, %payload : i1, index, i32, i32
  } do(%body_position: index, %body_sum: i32, %body_payload: i32) {
    %next_position = index.add %body_position, %c1 : index
    %next_sum = scalar.addi %body_sum, %body_payload : i32
    scf.yield %next_position, %next_sum : index, i32
  }
  func.return %result_position, %result_sum, %result_payload : index, i32, i32
}

// ====

// A condition may produce the complete result without any backedge state.
func.def @condition_only_payload(%condition: i1, %payload: i32) -> (i32) {
  %result = scf.while -> (i32) {
    scf.condition %condition, %payload : i1, i32
  } do(%body: i32) {
    scf.yield
  }
  func.return %result : i32
}

// ====

// Header state need not be exposed by the condition or the loop result.
func.def @header_only_state(%condition: i1, %initial: i32) {
  scf.while(%before = %initial : i32) {
    scf.condition %condition : i1
  } do {
    scf.yield %initial : i32
  }
  func.return
}

// ====

// scf.if without results and without an else region.
func.def @void_if_no_else(%cond: i1) {
  scf.if %cond {
    scf.yield
  }
  func.return
}

// ----
func.def @void_if_no_else(%cond: i1) {
  scf.if %cond {
  }
  func.return
}

// ====

// scf.if without results and with both branches present.
func.def @void_if(%cond: i1) {
  scf.if %cond {
    scf.yield
  } else {
    scf.yield
  }
  func.return
}

// ----
func.def @void_if(%cond: i1) {
  scf.if %cond {
  } else {
  }
  func.return
}

// ====

// scf.if with a single result.
func.def @if_single(%cond: i1, %a: f32, %b: f32) -> (f32) {
  %r = scf.if %cond -> (f32) {
    scf.yield %a : f32
  } else {
    scf.yield %b : f32
  }
  func.return %r : f32
}

// ====

// scf.if with multiple heterogeneous results.
func.def @if_multi(%cond: i1, %a: f32, %b: f32, %x: i32, %y: i32) -> (f32, i32) {
  %fr, %ir = scf.if %cond -> (f32, i32) {
    scf.yield %a, %x : f32, i32
  } else {
    scf.yield %b, %y : f32, i32
  }
  func.return %fr, %ir : f32, i32
}

// ====

// scf.lookup selects a whole row of SSA values from sorted explicit cases or
// the default row.
func.def @lookup_dispatch(%variant: index, %gemm0: index, %gemm1: index, %fallback: index, %x0: index, %x1: index, %x2: index, %xf: index, %y0: index, %y1: index, %y2: index, %yf: index, %z0: index, %z1: index, %z2: index, %zf: index) -> (index, index, index, index) {
  %ordinal, %wgx, %wgy, %wgz = scf.lookup %variant {
    0 = (%gemm0, %x0, %y0, %z0),
    1 = (%gemm1, %x1, %y1, %z1),
    2 = (%gemm1, %x2, %y2, %z2)
  } default(%fallback, %xf, %yf, %zf) : index, index, index, index
  func.return %ordinal, %wgx, %wgy, %wgz : index, index, index, index
}

// ====

// scf.switch selects a whole region by sorted explicit cases or the mandatory
// default region.
func.def @switch_dispatch(%variant: index, %a: index, %b: index, %fallback: index) -> (index) {
  %result = scf.switch %variant -> (index) {
    case 0 {
      scf.yield %a : index
    }
    case 1 {
      scf.yield %b : index
    }
    default {
      scf.yield %fallback : index
    }
  }
  func.return %result : index
}

// ====

// scf.if with side-effecting body ops in branches.
func.def @if_with_body(%cond: i1, %a: f32) -> (f32) {
  %r = scf.if %cond -> (f32) {
    %doubled = scalar.addf %a, %a : f32
    scf.yield %doubled : f32
  } else {
    %negated = scalar.negf %a : f32
    scf.yield %negated : f32
  }
  func.return %r : f32
}

// ====

// Nested scf.for inside scf.for accumulating across both loops.
func.def @nested_for(%lo: index, %hi: index, %step: index, %init: f32) -> (f32) {
  %outer = scf.for %i = [%lo to %hi step %step](%a = %init : f32) -> (f32) {
    %inner = scf.for %j = [%lo to %hi step %step](%b = %a : f32) -> (f32) {
      scf.yield %b : f32
    }
    scf.yield %inner : f32
  }
  func.return %outer : f32
}

// ====

// scf.if nested inside scf.for body.
func.def @if_in_for(%lo: index, %hi: index, %step: index, %cond: i1, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    %next = scf.if %cond -> (f32) {
      %doubled = scalar.addf %acc, %acc : f32
      scf.yield %doubled : f32
    } else {
      scf.yield %acc : f32
    }
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

// scf.for nested inside scf.if branches.
func.def @for_in_if(%cond: i1, %lo: index, %hi: index, %step: index, %init: f32) -> (f32) {
  %r = scf.if %cond -> (f32) {
    %sum = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
      scf.yield %acc : f32
    }
    scf.yield %sum : f32
  } else {
    scf.yield %init : f32
  }
  func.return %r : f32
}

// ====

func.def @independent_ssa_pipeline_and_unroll(%begin: index, %end: index, %step: index, %depth: index, %factor: index, %initial: f32) -> (f32) {
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    scf.yield %sum : f32
  }
  func.return %result : f32
}

// ====

func.def @pipeline_then_full_unroll(%begin: index, %end: index, %step: index, %depth: index, %initial: f32) -> (f32) {
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) unroll schedule(interleaved) {
    scf.yield %sum : f32
  }
  func.return %result : f32
}
