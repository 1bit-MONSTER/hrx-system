// ====

// An aligned total invocation count does not establish X alignment.
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @unaligned_multidimensional_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 16 : index
  %y = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %y, %unit) : index
} launch() {
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %subgroup_hi = test.fact_range_hi %subgroup : index -> i64
  %count_lo = test.fact_range_lo %count : index -> i64
  %count_hi = test.fact_range_hi %count : index -> i64
  test.use %count, %subgroup_hi, %count_lo, %count_hi : index, i64, i64, i64
  kernel.return
}

