// ====

// Partial subgroups may leave holes among active lane IDs.
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @partial_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %lane_hi = test.fact_range_hi %lane : index -> i64
  %subgroup_hi = test.fact_range_hi %subgroup : index -> i64
  %count_lo = test.fact_range_lo %count : index -> i64
  %count_hi = test.fact_range_hi %count : index -> i64
  test.use %lane_hi, %subgroup_hi, %count_lo, %count_hi : i64, i64, i64, i64
  kernel.return
}

