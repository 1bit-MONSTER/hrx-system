// ====

// Width one has no inactive holes, independently of a packing guarantee.
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 1}

kernel.def target(@device) @scalar_subgroups() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %count = kernel.subgroup.count : index
  test.use %lane, %count : index, index
  kernel.return
}

// ----
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 1}

kernel.def target(@device) @scalar_subgroups() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %lane = index.constant 0 : index
  %count = index.constant 3 : index
  test.use %lane, %count : index, index
  kernel.return
}

// ====

// Full subgroups follow X alignment, including multidimensional launches.
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @aligned_multidimensional_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 64 : index
  %other = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %other, %other) : index
} launch() {
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %subgroup_hi = test.fact_range_hi %subgroup : index -> i64
  test.use %count, %subgroup_hi : index, i64
  kernel.return
}

// ----
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @aligned_multidimensional_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 64 : index
  %other = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %other, %other) : index
} launch() {
  %count = index.constant 8 : index
  %subgroup_hi = scalar.constant 7 : i64
  test.use %count, %subgroup_hi : index, i64
  kernel.return
}

