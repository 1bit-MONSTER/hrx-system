// ====

// An aligned launch still needs an execution guarantee from its target.
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@device) @unspecified_aligned_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %count = kernel.subgroup.count : index
  %count_lo = test.fact_range_lo %count : index -> i64
  %count_hi = test.fact_range_hi %count : index -> i64
  test.use %count, %count_lo, %count_hi : index, i64, i64
  kernel.return
}

// ----
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@device) @unspecified_aligned_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %count = kernel.subgroup.count : index
  %count_lo = scalar.constant 2 : i64
  %count_hi = scalar.constant 128 : i64
  test.use %count, %count_lo, %count_hi : index, i64, i64
  kernel.return
}
