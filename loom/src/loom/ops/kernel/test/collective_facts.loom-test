// ====

// A fixed subgroup width bounds active ranks, not an exact active population.
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @rank_and_count() {
  %c1 = index.constant 1 : index
  %c67 = index.constant 67 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c67, %c1, %c1) : index
} launch() {
  %c1_i32 = scalar.constant 1 : i32
  %count = kernel.subgroup.reduce<addi> %c1_i32 : i32
  %rank = kernel.subgroup.scan<addi> %c1_i32 {direction = forward, mode = exclusive} : i32
  %reverse_rank = kernel.subgroup.scan<addi> %c1_i32 {direction = reverse, mode = exclusive} : i32
  %prefix = kernel.subgroup.scan<addi> %c1_i32 {direction = forward, mode = inclusive} : i32
  %reverse_prefix = kernel.subgroup.scan<addi> %c1_i32 {direction = reverse, mode = inclusive} : i32
  %workgroup_count = kernel.workgroup.reduce<addi> %c1_i32 : i32
  %workgroup_rank = kernel.workgroup.scan<addi> %c1_i32 {direction = reverse, mode = exclusive} : i32
  %workgroup_prefix = kernel.workgroup.scan<addi> %c1_i32 {direction = forward, mode = inclusive} : i32
  %workgroup_count_lo = test.fact_range_lo %workgroup_count : i32 -> i64
  %workgroup_count_hi = test.fact_range_hi %workgroup_count : i32 -> i64
  %count_lo = test.fact_range_lo %count : i32 -> i64
  %count_hi = test.fact_range_hi %count : i32 -> i64
  %rank_lo = test.fact_range_lo %rank : i32 -> i64
  %rank_hi = test.fact_range_hi %rank : i32 -> i64
  %reverse_rank_hi = test.fact_range_hi %reverse_rank : i32 -> i64
  %prefix_lo = test.fact_range_lo %prefix : i32 -> i64
  %prefix_hi = test.fact_range_hi %prefix : i32 -> i64
  %reverse_prefix_hi = test.fact_range_hi %reverse_prefix : i32 -> i64
  %workgroup_rank_hi = test.fact_range_hi %workgroup_rank : i32 -> i64
  %workgroup_prefix_lo = test.fact_range_lo %workgroup_prefix : i32 -> i64
  %workgroup_prefix_hi = test.fact_range_hi %workgroup_prefix : i32 -> i64
  test.use %count_lo, %count_hi, %rank_lo, %rank_hi, %reverse_rank_hi, %prefix_lo, %prefix_hi, %reverse_prefix_hi, %workgroup_count_lo, %workgroup_count_hi, %workgroup_rank_hi, %workgroup_prefix_lo, %workgroup_prefix_hi : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  kernel.return
}

// ----
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @rank_and_count() {
  %c1 = index.constant 1 : index
  %c67 = index.constant 67 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c67, %c1, %c1) : index
} launch() {
  %c1_i32 = scalar.constant 1 : i32
  %count = kernel.subgroup.reduce<addi> %c1_i32 : i32
  %rank = kernel.subgroup.scan<addi> %c1_i32 {direction = forward, mode = exclusive} : i32
  %reverse_rank = kernel.subgroup.scan<addi> %c1_i32 {direction = reverse, mode = exclusive} : i32
  %prefix = kernel.subgroup.scan<addi> %c1_i32 {direction = forward, mode = inclusive} : i32
  %reverse_prefix = kernel.subgroup.scan<addi> %c1_i32 {direction = reverse, mode = inclusive} : i32
  %workgroup_count = kernel.workgroup.reduce<addi> %c1_i32 : i32
  %workgroup_rank = kernel.workgroup.scan<addi> %c1_i32 {direction = reverse, mode = exclusive} : i32
  %workgroup_prefix = kernel.workgroup.scan<addi> %c1_i32 {direction = forward, mode = inclusive} : i32
  %workgroup_count_lo = scalar.constant 67 : i64
  %workgroup_count_hi = scalar.constant 67 : i64
  %count_lo = scalar.constant 1 : i64
  %count_hi = scalar.constant 32 : i64
  %rank_lo = scalar.constant 0 : i64
  %rank_hi = scalar.constant 31 : i64
  %reverse_rank_hi = scalar.constant 31 : i64
  %prefix_lo = scalar.constant 1 : i64
  %prefix_hi = scalar.constant 32 : i64
  %reverse_prefix_hi = scalar.constant 32 : i64
  %workgroup_rank_hi = scalar.constant 66 : i64
  %workgroup_prefix_lo = scalar.constant 1 : i64
  %workgroup_prefix_hi = scalar.constant 67 : i64
  test.use %count_lo, %count_hi, %rank_lo, %rank_hi, %reverse_rank_hi, %prefix_lo, %prefix_hi, %reverse_prefix_hi, %workgroup_count_lo, %workgroup_count_hi, %workgroup_rank_hi, %workgroup_prefix_lo, %workgroup_prefix_hi : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  kernel.return
}

// ====

kernel.def @clustered_negative_sums() {
  %c1 = index.constant 1 : index
  %c96 = index.constant 96 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c96, %c1, %c1) : index
} launch() {
  %contribution = scalar.constant -2 : i16
  %sum = kernel.subgroup.reduce<addi> %contribution {cluster_size = 8, cluster_stride = 2} : i16
  %prefix = kernel.subgroup.scan<addi> %contribution {cluster_size = 8, cluster_stride = 2, direction = reverse, mode = exclusive} : i16
  %sum_lo = test.fact_range_lo %sum : i16 -> i64
  %sum_hi = test.fact_range_hi %sum : i16 -> i64
  %sum_divisor = test.fact_divisor %sum : i16 -> i64
  %prefix_lo = test.fact_range_lo %prefix : i16 -> i64
  %prefix_hi = test.fact_range_hi %prefix : i16 -> i64
  %prefix_divisor = test.fact_divisor %prefix : i16 -> i64
  test.use %sum_lo, %sum_hi, %sum_divisor, %prefix_lo, %prefix_hi, %prefix_divisor : i64, i64, i64, i64, i64, i64
  kernel.return
}

// ----
kernel.def @clustered_negative_sums() {
  %c1 = index.constant 1 : index
  %c96 = index.constant 96 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c96, %c1, %c1) : index
} launch() {
  %contribution = scalar.constant -2 : i16
  %sum = kernel.subgroup.reduce<addi> %contribution {cluster_size = 8, cluster_stride = 2} : i16
  %prefix = kernel.subgroup.scan<addi> %contribution {cluster_size = 8, cluster_stride = 2, direction = reverse, mode = exclusive} : i16
  %sum_lo = scalar.constant -16 : i64
  %sum_hi = scalar.constant -2 : i64
  %sum_divisor = scalar.constant 2 : i64
  %prefix_lo = scalar.constant -14 : i64
  %prefix_hi = scalar.constant 0 : i64
  %prefix_divisor = scalar.constant 2 : i64
  test.use %sum_lo, %sum_hi, %sum_divisor, %prefix_lo, %prefix_hi, %prefix_divisor : i64, i64, i64, i64, i64, i64
  kernel.return
}

// ====

// The sum of varying multiples of two is not necessarily a multiple of 16.
kernel.def @mixed_sign_sums() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch() {
  %workitem = kernel.workitem.id<x> : index
  %item = index.cast %workitem : index to i32
  %c4 = scalar.constant 4 : i32
  %c2 = scalar.constant 2 : i32
  %centered = scalar.subi %item, %c4 : i32
  %contribution = scalar.muli %centered, %c2 : i32
  %sum = kernel.workgroup.reduce<addi> %contribution : i32
  %prefix = kernel.workgroup.scan<addi> %contribution {direction = forward, mode = exclusive} : i32
  %sum_lo = test.fact_range_lo %sum : i32 -> i64
  %sum_hi = test.fact_range_hi %sum : i32 -> i64
  %sum_divisor = test.fact_divisor %sum : i32 -> i64
  %prefix_lo = test.fact_range_lo %prefix : i32 -> i64
  %prefix_hi = test.fact_range_hi %prefix : i32 -> i64
  test.use %sum_lo, %sum_hi, %sum_divisor, %prefix_lo, %prefix_hi : i64, i64, i64, i64, i64
  kernel.return
}

// ----
kernel.def @mixed_sign_sums() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch() {
  %workitem = kernel.workitem.id<x> : index
  %item = index.cast %workitem : index to i32
  %22 = scalar.constant -4 : i32
  %centered = scalar.addi %item, %22 : i32
  %20 = scalar.constant 1 : i32
  %contribution = scalar.shli %centered, %20 : i32
  %sum = kernel.workgroup.reduce<addi> %contribution : i32
  %prefix = kernel.workgroup.scan<addi> %contribution {direction = forward, mode = exclusive} : i32
  %sum_lo = scalar.constant -64 : i64
  %sum_hi = scalar.constant 48 : i64
  %sum_divisor = scalar.constant 2 : i64
  %prefix_lo = scalar.constant -56 : i64
  %prefix_hi = scalar.constant 42 : i64
  test.use %sum_lo, %sum_hi, %sum_divisor, %prefix_lo, %prefix_hi : i64, i64, i64, i64, i64
  kernel.return
}

// ====

// Neither fixed-width wrapping nor checked host overflow establishes a range.
kernel.def @wrapping_sums() {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c3, %c1, %c1) : index
} launch() {
  %contribution_i8 = scalar.constant 100 : i8
  %contribution_i16 = scalar.constant -20000 : i16
  %contribution_i32 = scalar.constant 1073741824 : i32
  %contribution_i64 = scalar.constant 9223372036854775807 : i64
  %sum_i8 = kernel.workgroup.reduce<addi> %contribution_i8 : i8
  %sum_i16 = kernel.workgroup.reduce<addi> %contribution_i16 : i16
  %sum_i32 = kernel.workgroup.reduce<addi> %contribution_i32 : i32
  %sum_i64 = kernel.workgroup.reduce<addi> %contribution_i64 : i64
  %sum_i8_lo = test.fact_range_lo %sum_i8 : i8 -> i64
  %sum_i8_hi = test.fact_range_hi %sum_i8 : i8 -> i64
  %sum_i16_lo = test.fact_range_lo %sum_i16 : i16 -> i64
  %sum_i16_hi = test.fact_range_hi %sum_i16 : i16 -> i64
  %sum_i32_lo = test.fact_range_lo %sum_i32 : i32 -> i64
  %sum_i32_hi = test.fact_range_hi %sum_i32 : i32 -> i64
  %sum_i64_lo = test.fact_range_lo %sum_i64 : i64 -> i64
  %sum_i64_hi = test.fact_range_hi %sum_i64 : i64 -> i64
  test.use %sum_i8_lo, %sum_i8_hi, %sum_i16_lo, %sum_i16_hi, %sum_i32_lo, %sum_i32_hi, %sum_i64_lo, %sum_i64_hi : i64, i64, i64, i64, i64, i64, i64, i64
  kernel.return
}

// ----
kernel.def @wrapping_sums() {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c3, %c1, %c1) : index
} launch() {
  %contribution_i8 = scalar.constant 100 : i8
  %contribution_i16 = scalar.constant -20000 : i16
  %contribution_i32 = scalar.constant 1073741824 : i32
  %contribution_i64 = scalar.constant 9223372036854775807 : i64
  %sum_i8 = kernel.workgroup.reduce<addi> %contribution_i8 : i8
  %sum_i16 = kernel.workgroup.reduce<addi> %contribution_i16 : i16
  %sum_i32 = kernel.workgroup.reduce<addi> %contribution_i32 : i32
  %sum_i64 = kernel.workgroup.reduce<addi> %contribution_i64 : i64
  %sum_i8_lo = scalar.constant -128 : i64
  %sum_i8_hi = scalar.constant 127 : i64
  %sum_i16_lo = scalar.constant -32768 : i64
  %sum_i16_hi = scalar.constant 32767 : i64
  %sum_i32_lo = scalar.constant -2147483648 : i64
  %sum_i32_hi = scalar.constant 2147483647 : i64
  %sum_i64_lo = scalar.constant -9223372036854775808 : i64
  %sum_i64_hi = scalar.constant 9223372036854775807 : i64
  test.use %sum_i8_lo, %sum_i8_hi, %sum_i16_lo, %sum_i16_hi, %sum_i32_lo, %sum_i32_hi, %sum_i64_lo, %sum_i64_hi : i64, i64, i64, i64, i64, i64, i64, i64
  kernel.return
}

// ====

// The only exclusive prefix in a singleton group is empty, for any input.
kernel.def @singleton_exclusive() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: i64) {
  %prefix = kernel.subgroup.scan<addi> %input {direction = forward, mode = exclusive} : i64
  %workgroup_prefix = kernel.workgroup.scan<addi> %input {direction = reverse, mode = exclusive} : i64
  %prefix_lo = test.fact_range_lo %prefix : i64 -> i64
  %prefix_hi = test.fact_range_hi %prefix : i64 -> i64
  %workgroup_prefix_lo = test.fact_range_lo %workgroup_prefix : i64 -> i64
  %workgroup_prefix_hi = test.fact_range_hi %workgroup_prefix : i64 -> i64
  test.use %prefix_lo, %prefix_hi, %workgroup_prefix_lo, %workgroup_prefix_hi : i64, i64, i64, i64
  kernel.return
}

// ----
kernel.def @singleton_exclusive() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: i64) {
  %prefix = kernel.subgroup.scan<addi> %input {direction = forward, mode = exclusive} : i64
  %workgroup_prefix = kernel.workgroup.scan<addi> %input {direction = reverse, mode = exclusive} : i64
  %prefix_lo = scalar.constant 0 : i64
  %prefix_hi = scalar.constant 0 : i64
  %workgroup_prefix_lo = scalar.constant 0 : i64
  %workgroup_prefix_hi = scalar.constant 0 : i64
  test.use %prefix_lo, %prefix_hi, %workgroup_prefix_lo, %workgroup_prefix_hi : i64, i64, i64, i64
  kernel.return
}
