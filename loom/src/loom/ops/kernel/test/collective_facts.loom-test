  %sum_i32 = kernel.subgroup.reduce<addi> %c1_i32 : i32
  %sum_i64 = kernel.subgroup.reduce<addi> %c1_i64 : i64
  %boolean_lo = scalar.constant 0 : i64
  %boolean_hi = scalar.constant 1 : i64
  %count_i8_lo = scalar.constant 1 : i64
  %count_i8_hi = scalar.constant 3 : i64
  %count_i16_lo = scalar.constant 1 : i64
  %count_i16_hi = scalar.constant 3 : i64
