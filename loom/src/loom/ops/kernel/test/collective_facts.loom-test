// RUN: pass canonicalize

// Population bounds do not require dense lane IDs. The I1 sum may wrap.
kernel.def @partial_integer_widths() {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c3, %c1, %c1) : index
} launch() {
  %c1_i1 = scalar.constant true : i1
  %c1_i8 = scalar.constant 1 : i8
  %c1_i16 = scalar.constant 1 : i16
  %c1_i32 = scalar.constant 1 : i32
  %c1_i64 = scalar.constant 1 : i64
  %sum_i1 = kernel.subgroup.reduce<addi> %c1_i1 : i1
  %sum_i8 = kernel.subgroup.reduce<addi> %c1_i8 : i8
  %sum_i16 = kernel.subgroup.reduce<addi> %c1_i16 : i16
  %sum_i32 = kernel.subgroup.reduce<addi> %c1_i32 : i32
  %sum_i64 = kernel.subgroup.reduce<addi> %c1_i64 : i64
  %boolean_lo = test.fact_range_lo %sum_i1 : i1 -> i64
  %boolean_hi = test.fact_range_hi %sum_i1 : i1 -> i64
  %count_i8_lo = test.fact_range_lo %sum_i8 : i8 -> i64
  %count_i8_hi = test.fact_range_hi %sum_i8 : i8 -> i64
  %count_i16_lo = test.fact_range_lo %sum_i16 : i16 -> i64
  %count_i16_hi = test.fact_range_hi %sum_i16 : i16 -> i64
  %count_i32_lo = test.fact_range_lo %sum_i32 : i32 -> i64
  %count_i32_hi = test.fact_range_hi %sum_i32 : i32 -> i64
  %count_i64_lo = test.fact_range_lo %sum_i64 : i64 -> i64
  %count_i64_hi = test.fact_range_hi %sum_i64 : i64 -> i64
  test.use %boolean_lo, %boolean_hi, %count_i8_lo, %count_i8_hi, %count_i16_lo, %count_i16_hi, %count_i32_lo, %count_i32_hi, %count_i64_lo, %count_i64_hi : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  kernel.return
}

