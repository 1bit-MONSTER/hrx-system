// RUN: pass canonicalize

// A sanitizer assertion is removed only when incoming facts already prove every
// predicate. The checked result is replaced with the original value.
func.def @proven_assertion_folds(%n: index) -> (index) {
  %known = index.assume %n [range(%n, 0, 4096), multiple_of(%n, 16)] : index
  %checked = sanitizer.assert.value %known [range(%known, 0, 4096), multiple_of(%known, 8)] : index
  func.return %checked : index
}

// ----
func.def @proven_assertion_folds(%n: index) -> (index) {
  %known = index.assume %n [range(%n, 0, 4096), multiple_of(%n, 16)] : index
  func.return %known : index
}

// ====

// A stronger checked alias proves a later weaker assertion, so only the first
// executable boundary remains.
func.def @weaker_dominated_assertion_folds(%n: index) -> (index) {
  %strong = sanitizer.assert.value %n [range(%n, 1, 1024), ne(%n, 0), power_of_two(%n), multiple_of(%n, 64)] : index
  %weak = sanitizer.assert.value %strong [range(%strong, 0, 2048), ne(%strong, 0), multiple_of(%strong, 8)] : index
  func.return %weak : index
}

// ----
func.def @weaker_dominated_assertion_folds(%n: index) -> (index) {
  %strong = sanitizer.assert.value %n [range(%n, 1, 1024), ne(%n, 0), power_of_two(%n), multiple_of(%n, 64)] : index
  func.return %strong : index
}

// ====

// A stronger dominated assertion is still a runtime assertion. It cannot be
// folded into a weaker checked alias.
func.def @stronger_dominated_assertion_survives(%n: index) -> (index) {
  %weak = sanitizer.assert.value %n [range(%n, 0, 2048), multiple_of(%n, 8)] : index
  %strong = sanitizer.assert.value %weak [range(%weak, 1, 1024), ne(%weak, 0), power_of_two(%weak), multiple_of(%weak, 64)] : index
  func.return %strong : index
}

// ----
func.def @stronger_dominated_assertion_survives(%n: index) -> (index) {
  %weak = sanitizer.assert.value %n [range(%n, 0, 2048), multiple_of(%n, 8)] : index
  %strong = sanitizer.assert.value %weak [range(%weak, 1, 1024), ne(%weak, 0), power_of_two(%weak), multiple_of(%weak, 64)] : index
  func.return %strong : index
}

// ====

// Exact float facts prove matching float assertions, so no runtime boundary is
// needed.
func.def @proven_exact_float_assertion_folds() -> (f32) {
  %c2 = scalar.constant 2.0 : f32
  %checked = sanitizer.assert.value %c2 [finite(%c2)] : f32
  func.return %checked : f32
}

// ----
func.def @proven_exact_float_assertion_folds() -> (f32) {
  %c2 = scalar.constant 2.0 : f32
  func.return %c2 : f32
}

// ====

// Exact carrier facts prove unsigned relations across the sign bit without an
// executable assertion.
func.def @proven_unsigned_assertion_folds() -> (i32, i32) {
  %lhs = scalar.constant 1 : i32
  %rhs = scalar.constant -1 : i32
  %lhs_checked, %rhs_checked = sanitizer.assert.value %lhs, %rhs [ult(%lhs, %rhs), ule(%lhs, %rhs), ugt(%rhs, %lhs), uge(%rhs, %lhs)] : i32, i32
  func.return %lhs_checked, %rhs_checked : i32, i32
}

// ----
func.def @proven_unsigned_assertion_folds() -> (i32, i32) {
  %lhs = scalar.constant 1 : i32
  %rhs = scalar.constant -1 : i32
  func.return %lhs, %rhs : i32, i32
}

// ====

// finite implies not_nan, so a later weaker dominated assertion folds.
func.def @weaker_dominated_float_assertion_folds(%x: f32) -> (f32) {
  %finite = sanitizer.assert.value %x [finite(%x)] : f32
  %not_inf = sanitizer.assert.value %finite [not_inf(%finite)] : f32
  %not_nan = sanitizer.assert.value %not_inf [not_nan(%not_inf)] : f32
  func.return %not_nan : f32
}

// ----
func.def @weaker_dominated_float_assertion_folds(%x: f32) -> (f32) {
  %finite = sanitizer.assert.value %x [finite(%x)] : f32
  func.return %finite : f32
}

// ====

// not_nan does not imply finite because infinities are still allowed.
func.def @stronger_dominated_float_assertion_survives(%x: f32) -> (f32) {
  %not_nan = sanitizer.assert.value %x [not_nan(%x)] : f32
  %finite = sanitizer.assert.value %not_nan [finite(%not_nan)] : f32
  func.return %finite : f32
}

// ----
func.def @stronger_dominated_float_assertion_survives(%x: f32) -> (f32) {
  %not_nan = sanitizer.assert.value %x [not_nan(%x)] : f32
  %finite = sanitizer.assert.value %not_nan [finite(%not_nan)] : f32
  func.return %finite : f32
}

// ====

// Separate not_nan and not_inf facts together prove finite.
func.def @finite_assertion_folds_from_weaker_float_facts(%x: f32) -> (f32) {
  %not_nan = sanitizer.assert.value %x [not_nan(%x)] : f32
  %not_inf = sanitizer.assert.value %not_nan [not_inf(%not_nan)] : f32
  %finite = sanitizer.assert.value %not_inf [finite(%not_inf)] : f32
  func.return %finite : f32
}

// ----
func.def @finite_assertion_folds_from_weaker_float_facts(%x: f32) -> (f32) {
  %not_nan = sanitizer.assert.value %x [not_nan(%x)] : f32
  %not_inf = sanitizer.assert.value %not_nan [not_inf(%not_nan)] : f32
  func.return %not_inf : f32
}

// ====

// Exact result facts are allowed to flow through an unproven assertion, but the
// assertion remains as the executable trap/report boundary.
func.def @unproven_exact_assertion_survives(%n: index) -> (index, index) {
  %checked = sanitizer.assert.value %n [eq(%n, 42)] : index
  %sum = index.add %checked, %checked : index
  func.return %checked, %sum : index, index
}

// ----
func.def @unproven_exact_assertion_survives(%n: index) -> (index, index) {
  %checked = sanitizer.assert.value %n [eq(%n, 42)] : index
  %sum = index.constant 84 : index
  func.return %checked, %sum : index, index
}

// ====

// Operation assertions have no checked aliases, so proven predicates erase the
// trap/report site directly.
func.def @proven_op_assertion_folds(%n: index) -> (index) {
  %known = index.assume %n [range(%n, 0, 4096), multiple_of(%n, 16)] : index
  sanitizer.assert.op %known [range(%known, 0, 4096), multiple_of(%known, 8)] : index
  func.return %known : index
}

// ----
func.def @proven_op_assertion_folds(%n: index) -> (index) {
  %known = index.assume %n [range(%n, 0, 4096), multiple_of(%n, 16)] : index
  func.return %known : index
}

// ====

// Alias-local relations and literal holes are retained facts, so repeated
// executable checks fold without walking the defining assumptions.
func.def @retained_relation_assertions_fold(%a: index, %b: index) -> (index, index) {
  %related_a, %related_b = index.assume %a, %b [lt(%a, %b), ne(%a, 42)] : index, index
  %checked_a, %checked_b = sanitizer.assert.value %related_a, %related_b [lt(%related_a, %related_b), ne(%related_a, 42)] : index, index
  func.return %checked_a, %checked_b : index, index
}

// ----
func.def @retained_relation_assertions_fold(%a: index, %b: index) -> (index, index) {
  %related_a, %related_b = index.assume %a, %b [lt(%a, %b), ne(%a, 42)] : index, index
  func.return %related_a, %related_b : index, index
}

// ====

// Unproven operation assertions stay as executable boundaries.
func.def @unproven_op_assertion_survives(%n: index) -> (index) {
  sanitizer.assert.op %n [eq(%n, 42)] : index
  func.return %n : index
}

// ----
func.def @unproven_op_assertion_survives(%n: index) -> (index) {
  sanitizer.assert.op %n [eq(%n, 42)] : index
  func.return %n : index
}
