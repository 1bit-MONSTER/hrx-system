// ====

test.target<quirky> @mixed_width

// All original arithmetic fits, but neither combined constant fits INDEX32.
func.def target(@mixed_width) @index32_combined_constant_overflow(%negative_input: index, %positive_input: index) -> (index, index) {
  %negative_root = index.assume %negative_input [range(%negative_input, -2, -1)] : index
  %positive_root = index.assume %positive_input [range(%positive_input, 1, 2)] : index
  %upper_limit = index.constant 2147483647 : index
  %lower_limit = index.constant -2147483648 : index
  %upper_boundary_step = index.constant 1 : index
  %lower_boundary_step = index.constant -1 : index
  %upper_inner = index.add %negative_root, %upper_limit : index
  %upper_outer = index.add %upper_inner, %upper_boundary_step : index
  %lower_inner = index.add %positive_root, %lower_limit : index
  %lower_outer = index.add %lower_inner, %lower_boundary_step : index
  func.return %upper_outer, %lower_outer : index, index
}
// ----
