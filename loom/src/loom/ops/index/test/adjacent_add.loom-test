  %upper_limit = index.constant 9223372036854775807 : index
  %lower_limit = index.constant -9223372036854775808 : index
  %upper_boundary_step = index.constant 1 : index
  %lower_boundary_step = index.constant -1 : index
  %upper_inner = index.add %negative_root, %upper_limit : index
  %upper_outer = index.add %upper_inner, %upper_boundary_step : index
  %lower_inner = index.add %positive_root, %lower_limit : index
  %lower_outer = index.add %lower_inner, %lower_boundary_step : index
  func.return %upper_outer, %lower_outer : index, index
}

// ====

test.target<low_core> @wide

// The typed combined constant is OFFSET 384, not INDEX 384.
func.def target(@wide) @offset64_permutations(%byte_offset_input: offset) -> (offset, offset, offset, offset) {
  %byte_offset = index.assume %byte_offset_input [range(%byte_offset_input, 4294967296, 4294967311)] : offset
  %inner_step = index.constant 128 : offset
  %outer_step = index.constant 256 : offset
  %left = index.add %byte_offset, %inner_step : offset
  %right = index.add %inner_step, %byte_offset : offset
  %left_left = index.add %left, %outer_step : offset
  %left_right = index.add %outer_step, %left : offset
  %right_left = index.add %right, %outer_step : offset
  %right_right = index.add %outer_step, %right : offset
  func.return %left_left, %left_right, %right_left, %right_right : offset, offset, offset, offset
}
// ----
test.target<low_core> @wide

func.def target(@wide) @offset64_permutations(%byte_offset_input: offset) -> (offset, offset, offset, offset) {
  %byte_offset = index.assume %byte_offset_input [range(%byte_offset_input, 4294967296, 4294967311)] : offset
  %20 = index.constant 384 : offset
  %left_left = index.add %byte_offset, %20 : offset
  %18 = index.constant 384 : offset
  %left_right = index.add %byte_offset, %18 : offset
  %16 = index.constant 384 : offset
  %right_left = index.add %byte_offset, %16 : offset
  %14 = index.constant 384 : offset
  %right_right = index.add %byte_offset, %14 : offset
  func.return %left_left, %left_right, %right_left, %right_right : offset, offset, offset, offset
}

// ====

test.target<low_core> @wide

// The source domain ends at INT64_MAX even with an unsigned 64-bit carrier.
func.def target(@wide) @offset64_source_bound(%safe_input: offset, %overflow_input: offset) -> (offset, offset) {
  %safe_root = index.assume %safe_input [range(%safe_input, 9223372036854775804, 9223372036854775805)] : offset
  %overflow_root = index.assume %overflow_input [range(%overflow_input, 9223372036854775805, 9223372036854775806)] : offset
  %boundary_step = index.constant 1 : offset
  %cross_boundary_step = index.constant 2 : offset
  %safe_inner = index.add %safe_root, %boundary_step : offset
  %safe_outer = index.add %safe_inner, %boundary_step : offset
  %overflow_inner = index.add %overflow_root, %boundary_step : offset
  %overflow_outer = index.add %overflow_inner, %cross_boundary_step : offset
  func.return %safe_outer, %overflow_outer : offset, offset
}
// ----
test.target<low_core> @wide

func.def target(@wide) @offset64_source_bound(%safe_input: offset, %overflow_input: offset) -> (offset, offset) {
  %safe_root = index.assume %safe_input [range(%safe_input, 9223372036854775804, 9223372036854775805)] : offset
  %overflow_root = index.assume %overflow_input [range(%overflow_input, 9223372036854775805, 9223372036854775806)] : offset
  %boundary_step = index.constant 1 : offset
  %cross_boundary_step = index.constant 2 : offset
  %12 = index.constant 2 : offset
  %safe_outer = index.add %safe_root, %12 : offset
  %overflow_inner = index.add %overflow_root, %boundary_step : offset
  %overflow_outer = index.add %overflow_inner, %cross_boundary_step : offset
  func.return %safe_outer, %overflow_outer : offset, offset
}

// ====

test.target<low_core> @wide

// A retained exact OFFSET fact also supplies a correctly typed constant.
func.def target(@wide) @offset64_exact_fact_constant(%byte_offset_input: offset, %inner_step_input: offset) -> (offset) {
  %byte_offset, %inner_step = index.assume %byte_offset_input, %inner_step_input [range(%byte_offset_input, 0, 256), range(%inner_step_input, 128, 128)] : offset, offset
  %outer_step = index.constant 256 : offset
  %inner = index.add %byte_offset, %inner_step : offset
  %outer = index.add %inner, %outer_step : offset
  func.return %outer : offset
}
// ----
test.target<low_core> @wide

func.def target(@wide) @offset64_exact_fact_constant(%byte_offset_input: offset, %inner_step_input: offset) -> (offset) {
  %byte_offset, %inner_step = index.assume %byte_offset_input, %inner_step_input [range(%byte_offset_input, 0, 256), range(%inner_step_input, 128, 128)] : offset, offset
  %8 = index.constant 384 : offset
  %outer = index.add %byte_offset, %8 : offset
  func.return %outer : offset
}

// ====

// The same snapshot selects INDEX32 and OFFSET64 independently.
test.target<quirky> @mixed_width

func.def target(@mixed_width) @independent_address_widths(%coordinate_input: index, %byte_offset_input: offset) -> (index, offset) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 4294967296, 4294967311)] : index
  %byte_offset = index.assume %byte_offset_input [range(%byte_offset_input, 4294967296, 4294967311)] : offset
  %coordinate_inner_step = index.constant 1 : index
  %coordinate_outer_step = index.constant 2 : index
  %byte_inner_step = index.constant 1 : offset
  %byte_outer_step = index.constant 2 : offset
  %coordinate_inner = index.add %coordinate, %coordinate_inner_step : index
  %coordinate_outer = index.add %coordinate_inner, %coordinate_outer_step : index
  %bytes_inner = index.add %byte_offset, %byte_inner_step : offset
  %bytes_outer = index.add %bytes_inner, %byte_outer_step : offset
  func.return %coordinate_outer, %bytes_outer : index, offset
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @independent_address_widths(%coordinate_input: index, %byte_offset_input: offset) -> (index, offset) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 4294967296, 4294967311)] : index
  %byte_offset = index.assume %byte_offset_input [range(%byte_offset_input, 4294967296, 4294967311)] : offset
  %coordinate_inner_step = index.constant 1 : index
  %coordinate_outer_step = index.constant 2 : index
  %coordinate_inner = index.add %coordinate, %coordinate_inner_step : index
  %coordinate_outer = index.add %coordinate_inner, %coordinate_outer_step : index
  %14 = index.constant 3 : offset
  %bytes_outer = index.add %byte_offset, %14 : offset
  func.return %coordinate_outer, %bytes_outer : index, offset
}

