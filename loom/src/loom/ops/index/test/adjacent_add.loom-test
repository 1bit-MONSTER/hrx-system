// RUN: pass canonicalize

// Selected carriers: signed INDEX32 and unsigned OFFSET64.
test.target<quirky> @mixed_width

// All four operand orders produce coordinate + 8.
func.def target(@mixed_width) @index32_permutations(%coordinate_input: index) -> (index, index, index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -32, 32)] : index
  %inner_step = index.constant 3 : index
  %outer_step = index.constant 5 : index
  %left = index.add %coordinate, %inner_step : index
  %right = index.add %inner_step, %coordinate : index
  %left_left = index.add %left, %outer_step : index
  %left_right = index.add %outer_step, %left : index
  %right_left = index.add %right, %outer_step : index
  %right_right = index.add %outer_step, %right : index
  func.return %left_left, %left_right, %right_left, %right_right : index, index, index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_permutations(%coordinate_input: index) -> (index, index, index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -32, 32)] : index
  %20 = index.constant 8 : index
  %left_left = index.add %coordinate, %20 : index
  %18 = index.constant 8 : index
  %left_right = index.add %coordinate, %18 : index
  %16 = index.constant 8 : index
  %right_left = index.add %coordinate, %16 : index
  %14 = index.constant 8 : index
  %right_right = index.add %coordinate, %14 : index
  func.return %left_left, %left_right, %right_left, %right_right : index, index, index, index
}

// ====

// Selected carriers: signed INDEX32 and unsigned OFFSET64.
test.target<quirky> @mixed_width

// The results become coordinate - 14, coordinate - 5, and coordinate.
func.def target(@mixed_width) @index32_signed_combinations(%coordinate_input: index) -> (index, index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -100, 100)] : index
  %inner_step = index.constant -9 : index
  %negative_step = index.constant -5 : index
  %forward_step = index.constant 4 : index
  %reverse_step = index.constant 9 : index
  %inner = index.add %coordinate, %inner_step : index
  %negative = index.add %inner, %negative_step : index
  %mixed = index.add %inner, %forward_step : index
  %cancelled = index.add %inner, %reverse_step : index
  func.return %negative, %mixed, %cancelled : index, index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_signed_combinations(%coordinate_input: index) -> (index, index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -100, 100)] : index
  %15 = index.constant -14 : index
  %negative = index.add %coordinate, %15 : index
  %13 = index.constant -5 : index
  %mixed = index.add %coordinate, %13 : index
  func.return %negative, %mixed, %coordinate : index, index, index
}

// ====

// Selected carriers: signed INDEX32 and unsigned OFFSET64.
test.target<quirky> @mixed_width

// The original coordinate + 7 stays observable beside coordinate + 18.
func.def target(@mixed_width) @index32_multiple_users(%coordinate_input: index) -> (index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -100, 100)] : index
  %inner_step = index.constant 7 : index
  %outer_step = index.constant 11 : index
  %inner = index.add %coordinate, %inner_step : index
  %outer = index.add %inner, %outer_step : index
  func.return %inner, %outer : index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_multiple_users(%coordinate_input: index) -> (index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -100, 100)] : index
  %inner_step = index.constant 7 : index
  %inner = index.add %coordinate, %inner_step : index
  %8 = index.constant 18 : index
  %outer = index.add %coordinate, %8 : index
  func.return %inner, %outer : index, index
}

// ====

// Selected carriers: signed INDEX32 and unsigned OFFSET64.
test.target<quirky> @mixed_width

// Ordinary greedy revisiting combines this chain to coordinate + 15.
func.def target(@mixed_width) @index32_chain(%coordinate_input: index) -> (index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 100)] : index
  %first_step = index.constant 3 : index
  %middle_step = index.constant 5 : index
  %last_step = index.constant 7 : index
  %first = index.add %coordinate, %first_step : index
  %second = index.add %first, %middle_step : index
  %third = index.add %second, %last_step : index
  func.return %third : index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_chain(%coordinate_input: index) -> (index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 100)] : index
  %11 = index.constant 15 : index
  %third = index.add %coordinate, %11 : index
  func.return %third : index
}

// ====

// Selected carriers: signed INDEX32 and unsigned OFFSET64.
test.target<quirky> @mixed_width

// The producer cannot be wholly constant-folded: coordinate is not exact.
// The outer add becomes coordinate + 10 using the exact inner_step fact.
func.def target(@mixed_width) @index32_exact_fact_constant(%coordinate_input: index, %inner_step_input: index) -> (index) {
  %coordinate, %inner_step = index.assume %coordinate_input, %inner_step_input [range(%coordinate_input, -10, 10), range(%inner_step_input, 7, 7)] : index, index
  %outer_step = index.constant 3 : index
  %inner = index.add %coordinate, %inner_step : index
  %outer = index.add %inner, %outer_step : index
  func.return %outer : index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_exact_fact_constant(%coordinate_input: index, %inner_step_input: index) -> (index) {
  %coordinate, %inner_step = index.assume %coordinate_input, %inner_step_input [range(%coordinate_input, -10, 10), range(%inner_step_input, 7, 7)] : index, index
  %8 = index.constant 10 : index
  %outer = index.add %coordinate, %8 : index
  func.return %outer : index
}

// ====

test.target<quirky> @mixed_width

// Inclusive signed limits are valid: both outer additions fold.
func.def target(@mixed_width) @index32_inclusive_bounds(%upper_input: index, %lower_input: index) -> (index, index) {
  %upper_root = index.assume %upper_input [range(%upper_input, 2147483644, 2147483645)] : index
  %lower_root = index.assume %lower_input [range(%lower_input, -2147483646, -2147483645)] : index
  %upper_step = index.constant 1 : index
  %lower_step = index.constant -1 : index
  %upper_inner = index.add %upper_root, %upper_step : index
  %upper_outer = index.add %upper_inner, %upper_step : index
  %lower_inner = index.add %lower_root, %lower_step : index
  %lower_outer = index.add %lower_inner, %lower_step : index
  func.return %upper_outer, %lower_outer : index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_inclusive_bounds(%upper_input: index, %lower_input: index) -> (index, index) {
  %upper_root = index.assume %upper_input [range(%upper_input, 2147483644, 2147483645)] : index
  %lower_root = index.assume %lower_input [range(%lower_input, -2147483646, -2147483645)] : index
  %14 = index.constant 2 : index
  %upper_outer = index.add %upper_root, %14 : index
  %12 = index.constant -2 : index
  %lower_outer = index.add %lower_root, %12 : index
  func.return %upper_outer, %lower_outer : index, index
}

// ====

test.target<quirky> @mixed_width

// Final cancellation fits, but each original intermediate can cross a bound.
func.def target(@mixed_width) @index32_intermediate_overflow(%upper_input: index, %lower_input: index) -> (index, index) {
  %upper_root = index.assume %upper_input [range(%upper_input, 2147483646, 2147483647)] : index
  %lower_root = index.assume %lower_input [range(%lower_input, -2147483648, -2147483647)] : index
  %upper_step = index.constant 2 : index
  %lower_step = index.constant -2 : index
  %upper_inner = index.add %upper_root, %upper_step : index
  %upper_outer = index.add %upper_inner, %lower_step : index
  %lower_inner = index.add %lower_root, %lower_step : index
  %lower_outer = index.add %lower_inner, %upper_step : index
  func.return %upper_outer, %lower_outer : index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_intermediate_overflow(%upper_input: index, %lower_input: index) -> (index, index) {
  %upper_root = index.assume %upper_input [range(%upper_input, 2147483646, 2147483647)] : index
  %lower_root = index.assume %lower_input [range(%lower_input, -2147483648, -2147483647)] : index
  %upper_step = index.constant 2 : index
  %lower_step = index.constant -2 : index
  %upper_inner = index.add %upper_root, %upper_step : index
  %upper_outer = index.add %upper_inner, %lower_step : index
  %lower_inner = index.add %lower_root, %lower_step : index
  %lower_outer = index.add %lower_inner, %upper_step : index
  func.return %upper_outer, %lower_outer : index, index
}

