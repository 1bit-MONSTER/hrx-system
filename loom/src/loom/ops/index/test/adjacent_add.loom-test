// ====

test.target<quirky> @mixed_width

// Neither a varying increment nor a different arithmetic op is an add chain.
func.def target(@mixed_width) @index32_nonmatching_operations(%coordinate_input: index, %increment_input: index) -> (index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -10, 10)] : index
  %varying_increment = index.assume %increment_input [range(%increment_input, 1, 9)] : index
  %subtracted_step = index.constant 3 : index
  %outer_step = index.constant 5 : index
  %varying_inner = index.add %coordinate, %varying_increment : index
  %varying_outer = index.add %varying_inner, %outer_step : index
  %subtracted = index.sub %coordinate, %subtracted_step : index
  %after_subtraction = index.add %subtracted, %outer_step : index
  func.return %varying_outer, %after_subtraction : index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_nonmatching_operations(%coordinate_input: index, %increment_input: index) -> (index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -10, 10)] : index
  %varying_increment = index.assume %increment_input [range(%increment_input, 1, 9)] : index
  %subtracted_step = index.constant 3 : index
  %outer_step = index.constant 5 : index
  %varying_inner = index.add %coordinate, %varying_increment : index
  %varying_outer = index.add %varying_inner, %outer_step : index
  %subtracted = index.sub %coordinate, %subtracted_step : index
  %after_subtraction = index.add %subtracted, %outer_step : index
  func.return %varying_outer, %after_subtraction : index, index
}

// ====

test.target<quirky> @mixed_width

// The local match does not cross an address-domain cast.
func.def target(@mixed_width) @cast_separates_additions(%coordinate_input: index) -> (offset) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 10)] : index
  %coordinate_step = index.constant 3 : index
  %byte_step = index.constant 5 : offset
  %inner = index.add %coordinate, %coordinate_step : index
  %byte_offset = index.cast %inner : index to offset
  %outer = index.add %byte_offset, %byte_step : offset
  func.return %outer : offset
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @cast_separates_additions(%coordinate_input: index) -> (offset) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 10)] : index
  %coordinate_step = index.constant 3 : index
  %byte_step = index.constant 5 : offset
  %inner = index.add %coordinate, %coordinate_step : index
  %byte_offset = index.cast %inner : index to offset
  %outer = index.add %byte_offset, %byte_step : offset
  func.return %outer : offset
}

// ====

// No target binding: bounded values alone do not select a carrier width.
func.def @targetless_bounded_addresses(%coordinate_input: index, %byte_offset_input: offset) -> (index, index, offset) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -10, 10)] : index
  %byte_offset = index.assume %byte_offset_input [range(%byte_offset_input, 0, 10)] : offset
  %coordinate_inner_step = index.constant 3 : index
  %coordinate_outer_step = index.constant 5 : index
  %coordinate_reverse_step = index.constant -3 : index
  %byte_inner_step = index.constant 3 : offset
  %byte_outer_step = index.constant 5 : offset
  %coordinate_inner = index.add %coordinate, %coordinate_inner_step : index
  %coordinate_outer = index.add %coordinate_inner, %coordinate_outer_step : index
  %coordinate_cancelled = index.add %coordinate_inner, %coordinate_reverse_step : index
  %bytes_inner = index.add %byte_offset, %byte_inner_step : offset
  %bytes_outer = index.add %bytes_inner, %byte_outer_step : offset
  func.return %coordinate_outer, %coordinate_cancelled, %bytes_outer : index, index, offset
}
// ----
func.def @targetless_bounded_addresses(%coordinate_input: index, %byte_offset_input: offset) -> (index, index, offset) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -10, 10)] : index
  %byte_offset = index.assume %byte_offset_input [range(%byte_offset_input, 0, 10)] : offset
  %coordinate_inner_step = index.constant 3 : index
  %coordinate_outer_step = index.constant 5 : index
  %coordinate_reverse_step = index.constant -3 : index
  %byte_inner_step = index.constant 3 : offset
  %byte_outer_step = index.constant 5 : offset
  %coordinate_inner = index.add %coordinate, %coordinate_inner_step : index
  %coordinate_outer = index.add %coordinate_inner, %coordinate_outer_step : index
  %coordinate_cancelled = index.add %coordinate_inner, %coordinate_reverse_step : index
  %bytes_inner = index.add %byte_offset, %byte_inner_step : offset
  %bytes_outer = index.add %bytes_inner, %byte_outer_step : offset
  func.return %coordinate_outer, %coordinate_cancelled, %bytes_outer : index, index, offset
}
