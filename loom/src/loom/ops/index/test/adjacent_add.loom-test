// ====

test.target<quirky> @mixed_width

// A valid replacement cannot erase an unrepresentable original operand.
func.def target(@mixed_width) @index32_original_operand_outside_carrier(%negative_input: index, %high_input: index) -> (index, index) {
  %negative_root = index.assume %negative_input [range(%negative_input, -2, -1)] : index
  %high_root = index.assume %high_input [range(%high_input, 2147483648, 2147483649)] : index
  %outside_carrier_step = index.constant 2147483648 : index
  %constant_correction = index.constant -1 : index
  %root_correction = index.constant -3 : index
  %root_final_step = index.constant 1 : index
  %constant_inner = index.add %negative_root, %outside_carrier_step : index
  %constant_outer = index.add %constant_inner, %constant_correction : index
  %root_inner = index.add %high_root, %root_correction : index
  %root_outer = index.add %root_inner, %root_final_step : index
  func.return %constant_outer, %root_outer : index, index
}
// ----
test.target<quirky> @mixed_width

func.def target(@mixed_width) @index32_original_operand_outside_carrier(%negative_input: index, %high_input: index) -> (index, index) {
  %negative_root = index.assume %negative_input [range(%negative_input, -2, -1)] : index
  %high_root = index.assume %high_input [range(%high_input, 2147483648, 2147483649)] : index
  %outside_carrier_step = index.constant 2147483648 : index
  %constant_correction = index.constant -1 : index
  %root_correction = index.constant -3 : index
  %root_final_step = index.constant 1 : index
  %constant_inner = index.add %negative_root, %outside_carrier_step : index
  %constant_outer = index.add %constant_inner, %constant_correction : index
  %root_inner = index.add %high_root, %root_correction : index
  %root_outer = index.add %root_inner, %root_final_step : index
  func.return %constant_outer, %root_outer : index, index
}

// ====

// Both selected address carriers are 64 bits.
test.target<low_core> @wide

// All four orders fold to coordinate + 4 above the signed 32-bit range.
func.def target(@wide) @index64_permutations(%coordinate_input: index) -> (index, index, index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 4294967296, 4294967311)] : index
  %inner_step = index.constant -9 : index
  %outer_step = index.constant 13 : index
  %left = index.add %coordinate, %inner_step : index
  %right = index.add %inner_step, %coordinate : index
  %left_left = index.add %left, %outer_step : index
  %left_right = index.add %outer_step, %left : index
  %right_left = index.add %right, %outer_step : index
  %right_right = index.add %outer_step, %right : index
  func.return %left_left, %left_right, %right_left, %right_right : index, index, index, index
}
// ----
test.target<low_core> @wide

func.def target(@wide) @index64_permutations(%coordinate_input: index) -> (index, index, index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 4294967296, 4294967311)] : index
  %20 = index.constant 4 : index
  %left_left = index.add %coordinate, %20 : index
  %18 = index.constant 4 : index
  %left_right = index.add %coordinate, %18 : index
  %16 = index.constant 4 : index
  %right_left = index.add %coordinate, %16 : index
  %14 = index.constant 4 : index
  %right_right = index.add %coordinate, %14 : index
  func.return %left_left, %left_right, %right_left, %right_right : index, index, index, index
}

// ====

// Both selected address carriers are 64 bits.
test.target<low_core> @wide

// Negative 64-bit roots admit negative increments and safe cancellation.
func.def target(@wide) @index64_negative_and_cancellation(%coordinate_input: index) -> (index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -4294967311, -4294967296)] : index
  %inner_step = index.constant -9 : index
  %negative_step = index.constant -5 : index
  %reverse_step = index.constant 9 : index
  %inner = index.add %coordinate, %inner_step : index
  %negative = index.add %inner, %negative_step : index
  %cancelled = index.add %inner, %reverse_step : index
  func.return %negative, %cancelled : index, index
}
// ----
test.target<low_core> @wide

func.def target(@wide) @index64_negative_and_cancellation(%coordinate_input: index) -> (index, index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, -4294967311, -4294967296)] : index
  %10 = index.constant -14 : index
  %negative = index.add %coordinate, %10 : index
  func.return %negative, %coordinate : index, index
}

