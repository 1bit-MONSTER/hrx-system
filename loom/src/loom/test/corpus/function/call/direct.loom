func.def noinline @swap(%a: i64, %b: i64) -> (i64, i64) {
  func.return %b, %a : i64, i64
}

func.def noinline @nested_swap(%a: i64, %b: i64) -> (i64, i64) {
  %first, %second = func.call @swap(%a, %b) : (i64, i64) -> (i64, i64)
  func.return %first, %second : i64, i64
}

func.def public @entry(%a: i64, %b: i64) -> (i64, i64, i64, i64) {
  %first, %second = func.call @nested_swap(%a, %b) : (i64, i64) -> (i64, i64)
  %third, %fourth = func.call @swap(%second, %first) : (i64, i64) -> (i64, i64)
  func.return %a, %b, %third, %fourth : i64, i64, i64, i64
}

check.case @preserve_caller {
  %a = check.literal value(4294967297) : i64
  %b = check.literal value(-3) : i64
  %original_a, %original_b, %swapped_a, %swapped_b = func.call @entry(%a, %b) : (i64, i64) -> (i64, i64, i64, i64)
  check.expect.equal actual(%original_a) expected(%a) : i64
  check.expect.equal actual(%original_b) expected(%b) : i64
  check.expect.equal actual(%swapped_a) expected(%b) : i64
  check.expect.equal actual(%swapped_b) expected(%a) : i64
  check.return
}

func.def public @partial_results(%a: i64, %b: i64) -> (i64) {
  %first, %second = func.call @swap(%a, %b) : (i64, i64) -> (i64, i64)
  func.return %first : i64
}

check.case @unused_result {
  %a = check.literal value(4294967297) : i64
  %b = check.literal value(-3) : i64
  %first = func.call @partial_results(%a, %b) : (i64, i64) -> (i64)
  check.expect.equal actual(%first) expected(%b) : i64
  check.return
}

func.def public noinline @factorial(%n: i32) -> (i32) {
  %c1 = scalar.constant 1 : i32
  %done = scalar.cmpi sle, %n, %c1 : i32
  %result = scf.if %done -> (i32) {
    scf.yield %c1 : i32
  } else {
    %previous = scalar.subi %n, %c1 : i32
    %partial = func.call @factorial(%previous) : (i32) -> (i32)
    %product = scalar.muli %n, %partial : i32
    scf.yield %product : i32
  }
  func.return %result : i32
}

check.case @recursive_call {
  %n = check.literal value(7) : i32
  %result = func.call @factorial(%n) : (i32) -> (i32)
  %expected = check.literal value(5040) : i32
  check.expect.equal actual(%result) expected(%expected) : i32
  check.return
}

func.def public @loop_calls(%count: i32, %a: i64, %b: i64) -> (i32, i64, i64) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %remaining, %first, %second = scf.while(%before = %count : i32, %left = %a : i64, %right = %b : i64) -> (i32, i64, i64) {
    %condition = scalar.cmpi sgt, %before, %c0 : i32
    scf.condition %condition, %before, %left, %right : i1, i32, i64, i64
  } do(%current: i32, %x: i64, %y: i64) {
    %next = scalar.subi %current, %c1 : i32
    %swapped_x, %swapped_y = func.call @swap(%x, %y) : (i64, i64) -> (i64, i64)
    scf.yield %next, %swapped_x, %swapped_y : i32, i64, i64
  }
  func.return %count, %first, %second : i32, i64, i64
}

check.case @call_in_loop {
  %count = check.param.choice values([1, 3, 7]) : i32
  %a = check.literal value(4294967297) : i64
  %b = check.literal value(-3) : i64
  %original_count, %first, %second = func.call @loop_calls(%count, %a, %b) : (i32, i64, i64) -> (i32, i64, i64)
  check.expect.equal actual(%original_count) expected(%count) : i32
  check.expect.equal actual(%first) expected(%b) : i64
  check.expect.equal actual(%second) expected(%a) : i64
  check.return
}

// A wide result tuple is only partly consumed. Original arguments must remain
// live beside the kept results, including values from both ends of the tuple.
func.def noinline @rotate16(%v0: i64, %v1: i64, %v2: i64, %v3: i64, %v4: i64, %v5: i64, %v6: i64, %v7: i64, %v8: i64, %v9: i64, %v10: i64, %v11: i64, %v12: i64, %v13: i64, %v14: i64, %v15: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  func.return %v15, %v0, %v1, %v2, %v3, %v4, %v5, %v6, %v7, %v8, %v9, %v10, %v11, %v12, %v13, %v14 : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}

func.def public @wide_call(%a: i64, %b: i64) -> (i64, i64, i64, i64, i64) {
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15 = func.call @rotate16(%a, %b, %a, %b, %a, %b, %a, %b, %a, %b, %a, %b, %a, %b, %a, %b) : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
  func.return %a, %b, %r0, %r8, %r15 : i64, i64, i64, i64, i64
}

check.case @wide_call_result_subset {
  %a = check.literal value(4294967297) : i64
  %b = check.literal value(-3) : i64
  %original_a, %original_b, %first, %middle, %last = func.call @wide_call(%a, %b) : (i64, i64) -> (i64, i64, i64, i64, i64)
  check.expect.equal actual(%original_a) expected(%a) : i64
  check.expect.equal actual(%original_b) expected(%b) : i64
  check.expect.equal actual(%first) expected(%b) : i64
  check.expect.equal actual(%middle) expected(%b) : i64
  check.expect.equal actual(%last) expected(%a) : i64
  check.return
}

func.def noinline @consume(%a: i64) {
  func.return
}

func.def noinline @produce() -> (i64, i64, i64) {
  %c1 = scalar.constant 1 : i64
  %c2 = scalar.constant 2 : i64
  %c3 = scalar.constant 3 : i64
  func.return %c1, %c2, %c3 : i64, i64, i64
}

func.def public @unequal_call_prefixes(%a: i64) -> (i64, i64, i64, i64) {
  func.call @consume(%a) : (i64)
  %r0, %r1, %r2 = func.call @produce() : () -> (i64, i64, i64)
  func.return %a, %r0, %r1, %r2 : i64, i64, i64, i64
}

check.case @empty_arguments_and_results {
  %a = check.literal value(-4294967297) : i64
  %original_a, %first, %second, %third = func.call @unequal_call_prefixes(%a) : (i64) -> (i64, i64, i64, i64)
  %c1 = check.literal value(1) : i64
  %c2 = check.literal value(2) : i64
  %c3 = check.literal value(3) : i64
  check.expect.equal actual(%original_a) expected(%a) : i64
  check.expect.equal actual(%first) expected(%c1) : i64
  check.expect.equal actual(%second) expected(%c2) : i64
  check.expect.equal actual(%third) expected(%c3) : i64
  check.return
}
