// Values cross both sides of the direct-register window without changing bits.
func.def public noinline @wide_reverse(%a0: i64, %a1: i64, %a2: i64, %a3: i64, %a4: i64, %a5: i64, %a6: i64, %a7: i64, %a8: i64, %a9: i64, %a10: i64, %a11: i64, %a12: i64, %a13: i64, %a14: i64, %a15: i64, %a16: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  func.return %a16, %a15, %a14, %a13, %a12, %a11, %a10, %a9, %a8, %a7, %a6, %a5, %a4, %a3, %a2, %a1, %a0 : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}

check.case @wide_reverse_case {
  %seed = check.param.choice values([-9, 4294967297]) : i64
  %v1 = check.literal value(1) : i64
  %v2 = check.literal value(2) : i64
  %v3 = check.literal value(3) : i64
  %v4 = check.literal value(4) : i64
  %v5 = check.literal value(5) : i64
  %v6 = check.literal value(6) : i64
  %v7 = check.literal value(7) : i64
  %v8 = check.literal value(8) : i64
  %v9 = check.literal value(9) : i64
  %v10 = check.literal value(10) : i64
  %v11 = check.literal value(11) : i64
  %v12 = check.literal value(12) : i64
  %v13 = check.literal value(13) : i64
  %v14 = check.literal value(14) : i64
  %v15 = check.literal value(15) : i64
  %v16 = check.literal value(16) : i64
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16 = func.call @wide_reverse(%seed, %v1, %v2, %v3, %v4, %v5, %v6, %v7, %v8, %v9, %v10, %v11, %v12, %v13, %v14, %v15, %v16) : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
  check.expect.equal actual(%r0) expected(%v16) : i64
  check.expect.equal actual(%r1) expected(%v15) : i64
  check.expect.equal actual(%r2) expected(%v14) : i64
  check.expect.equal actual(%r3) expected(%v13) : i64
  check.expect.equal actual(%r4) expected(%v12) : i64
  check.expect.equal actual(%r5) expected(%v11) : i64
  check.expect.equal actual(%r6) expected(%v10) : i64
  check.expect.equal actual(%r7) expected(%v9) : i64
  check.expect.equal actual(%r8) expected(%v8) : i64
  check.expect.equal actual(%r9) expected(%v7) : i64
  check.expect.equal actual(%r10) expected(%v6) : i64
  check.expect.equal actual(%r11) expected(%v5) : i64
  check.expect.equal actual(%r12) expected(%v4) : i64
  check.expect.equal actual(%r13) expected(%v3) : i64
  check.expect.equal actual(%r14) expected(%v2) : i64
  check.expect.equal actual(%r15) expected(%v1) : i64
  check.expect.equal actual(%r16) expected(%seed) : i64
  check.return
}

// The retained call must preserve the original inputs and a computed live value.
func.def public @wide_call_preserves_values(%first: i64, %last: i64) -> (i64, i64, i64) {
  %held = scalar.addi %first, %last : i64
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16 = func.call @wide_reverse(%last, %first, %last, %first, %last, %first, %last, %first, %last, %first, %last, %first, %last, %first, %last, %first, %last) : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
  %sum1 = scalar.addi %r0, %r1 : i64
  %sum2 = scalar.addi %sum1, %r2 : i64
  %sum3 = scalar.addi %sum2, %r3 : i64
  %sum4 = scalar.addi %sum3, %r4 : i64
  %sum5 = scalar.addi %sum4, %r5 : i64
  %sum6 = scalar.addi %sum5, %r6 : i64
  %sum7 = scalar.addi %sum6, %r7 : i64
  %sum8 = scalar.addi %sum7, %r8 : i64
  %sum9 = scalar.addi %sum8, %r9 : i64
  %sum10 = scalar.addi %sum9, %r10 : i64
  %sum11 = scalar.addi %sum10, %r11 : i64
  %sum12 = scalar.addi %sum11, %r12 : i64
  %sum13 = scalar.addi %sum12, %r13 : i64
  %sum14 = scalar.addi %sum13, %r14 : i64
  %sum15 = scalar.addi %sum14, %r15 : i64
  %sum16 = scalar.addi %sum15, %r16 : i64
  func.return %sum16, %held, %first : i64, i64, i64
}

check.case @wide_call_negative_case {
  %first = check.literal value(-3) : i64
  %last = check.literal value(9) : i64
  %total, %held, %preserved = func.call @wide_call_preserves_values(%first, %last) : (i64, i64) -> (i64, i64, i64)
  %expected_total = check.literal value(57) : i64
  %expected_held = check.literal value(6) : i64
  check.expect.equal actual(%total) expected(%expected_total) : i64
  check.expect.equal actual(%held) expected(%expected_held) : i64
  check.expect.equal actual(%preserved) expected(%first) : i64
  check.return
}

check.case @wide_call_wide_case {
  %first = check.literal value(4294967297) : i64
  %last = check.literal value(-9) : i64
  %total, %held, %preserved = func.call @wide_call_preserves_values(%first, %last) : (i64, i64) -> (i64, i64, i64)
  %expected_total = check.literal value(34359738295) : i64
  %expected_held = check.literal value(4294967288) : i64
  check.expect.equal actual(%total) expected(%expected_total) : i64
  check.expect.equal actual(%held) expected(%expected_held) : i64
  check.expect.equal actual(%preserved) expected(%first) : i64
  check.return
}

// Reference fields do not advance the value-bank ordinal. Narrow and wide
// floating bits cross the boundary without conversion or byte packing.
func.def noinline @mixed_overflow(%a0: i64, %storage: buffer, %a1: i64, %a2: i64, %a3: i64, %a4: i64, %a5: i64, %a6: i64, %a7: i64, %a8: i64, %a9: i64, %a10: i64, %a11: i64, %a12: i64, %a13: i64, %a14: i64, %a15: i64, %small: f32, %wide: f64, %tag: i32) -> (f32, f64, i32, buffer, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  func.return %small, %wide, %tag, %storage, %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7, %a8, %a9, %a10, %a11, %a12, %a13, %a14, %a15 : f32, f64, i32, buffer, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}

func.def public @mixed_overflow_call(%seed: i64, %small_bits: i32, %wide_bits: i64, %tag: i32) -> (i64, i32, i64, i32, i64) {
  %length = index.constant 8 : offset
  %storage = buffer.alloca<private> align(8) %length : buffer
  %small = scalar.bitcast %small_bits : i32 to f32
  %wide = scalar.bitcast %wide_bits : i64 to f64
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16, %r17, %r18, %r19 = func.call @mixed_overflow(%seed, %storage, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %seed, %small, %wide, %tag) : (i64, buffer, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, f32, f64, i32) -> (f32, f64, i32, buffer, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
  %returned_small = scalar.bitcast %r0 : f32 to i32
  %returned_wide = scalar.bitcast %r1 : f64 to i64
  %returned_length = buffer.length %r3
  %length_value = index.cast %returned_length : offset to i64
  func.return %r19, %returned_small, %returned_wide, %r2, %length_value : i64, i32, i64, i32, i64
}

check.case @mixed_overflow_bits {
  %seed = check.param.choice values([-9, 4294967297]) : i64
  %small_bits = check.param.choice values([-2147483648, 1069547520]) : i32
  %wide_bits = check.param.choice values([-9223372036854775808, 4609434218613702656]) : i64
  %tag = check.literal value(-123) : i32
  %seed_result, %small_result, %wide_result, %tag_result, %length_result = func.call @mixed_overflow_call(%seed, %small_bits, %wide_bits, %tag) : (i64, i32, i64, i32) -> (i64, i32, i64, i32, i64)
  %length = check.literal value(8) : i64
  check.expect.equal actual(%seed_result) expected(%seed) : i64
  check.expect.equal actual(%small_result) expected(%small_bits) : i32
  check.expect.equal actual(%wide_result) expected(%wide_bits) : i64
  check.expect.equal actual(%tag_result) expected(%tag) : i32
  check.expect.equal actual(%length_result) expected(%length) : i64
  check.return
}

// Result-only overflow and a branch join use the same source-order tuple.
func.def noinline @wide_branches(%a: i64, %b: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  %negative = scalar.cmpi slt, %a, %c0 : i64
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16 = scf.if %negative -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
    scf.yield %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %b : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  } else {
    scf.yield %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %a : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  }
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16 : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}

func.def public @wide_branch_call(%a: i64, %b: i64) -> (i64, i64, i64) {
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16 = func.call @wide_branches(%a, %b) : (i64, i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
  func.return %r0, %r16, %a : i64, i64, i64
}

check.case @wide_branch_negative {
  %a = check.literal value(-9) : i64
  %b = check.literal value(4294967297) : i64
  %first, %last, %original = func.call @wide_branch_call(%a, %b) : (i64, i64) -> (i64, i64, i64)
  check.expect.equal actual(%first) expected(%a) : i64
  check.expect.equal actual(%last) expected(%b) : i64
  check.expect.equal actual(%original) expected(%a) : i64
  check.return
}

check.case @wide_branch_positive {
  %a = check.literal value(4294967297) : i64
  %b = check.literal value(-9) : i64
  %first, %last, %original = func.call @wide_branch_call(%a, %b) : (i64, i64) -> (i64, i64, i64)
  check.expect.equal actual(%first) expected(%b) : i64
  check.expect.equal actual(%last) expected(%a) : i64
  check.expect.equal actual(%original) expected(%a) : i64
  check.return
}

// Unused direct and overflow fields retain their positions in the signature.
func.def public noinline @sparse_arguments(%input0: i64, %input1: i64, %input2: i64, %input3: i64, %input4: i64, %input5: i64, %input6: i64, %input7: i64, %input8: i64, %input9: i64, %input10: i64, %input11: i64, %input12: i64, %input13: i64, %input14: i64, %input15: i64, %input16: i64, %input17: i64) -> (i64, i64) {
  func.return %input0, %input17 : i64, i64
}

check.case @sparse_arguments_case {
  %first = check.param.choice values([-9, 4294967297]) : i64
  %last = check.param.choice values([7, -4294967297]) : i64
  %unused = check.literal value(123) : i64
  %actual_first, %actual_last = func.call @sparse_arguments(%first, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %unused, %last) : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64, i64)
  check.expect.equal actual(%actual_first) expected(%first) : i64
  check.expect.equal actual(%actual_last) expected(%last) : i64
  check.return
}
