func.def @create_host_buffer(%byte_length: i64, %pattern: i32) -> (buffer) {
  %byte_length_input = scalar.assume %byte_length [range(%byte_length, 0, 4294967295)] : i64
  %length = index.cast %byte_length_input : i64 to offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<private> align(1) %length : buffer
  buffer.fill %pattern, %storage[%origin], %length : i32
  func.return %storage : buffer
}

func.def @host_buffer_length(%storage: buffer) -> (i64) {
  %length = buffer.length %storage
  %result = index.cast %length : offset to i64
  func.return %result : i64
}

func.def @host_buffer_aliases(%storage: buffer, %tag: i32) -> (buffer, i32, buffer) {
  func.return %storage, %tag, %storage : buffer, i32, buffer
}

func.def @host_buffer_store(%storage: buffer, %position: i64, %value: i32) {
  %position_input = scalar.assume %position [range(%position, 0, 4294967295)] : i64
  %offset = index.cast %position_input : i64 to offset
  buffer.store.i8 %value, %storage[%offset]
  func.return
}

func.def @host_buffer_load(%storage: buffer, %position: i64) -> (i32) {
  %position_input = scalar.assume %position [range(%position, 0, 4294967295)] : i64
  %offset = index.cast %position_input : i64 to offset
  %result = buffer.load.i8.u %storage[%offset]
  func.return %result : i32
}

// Each call crosses a callable boundary. Both returned aliases and the original
// binding must see writes after the producer's invocation has finished.
func.def @host_buffer_swap(%left: buffer, %right: buffer) -> (buffer, buffer) {
  func.return %right, %left : buffer, buffer
}

// Observes buffer lengths, alias preservation, mutation, and buffer-valued
// argument/result swaps behind one target boundary.
func.def @buffer_argument_observations(%control: i64, %value_entropy: i64, %output: buffer) {
  %position_mask = scalar.constant 7 : i64
  %position = scalar.andi %control, %position_mask : i64
  %pattern = scalar.trunci %value_entropy : i64 to i32
  %changed_entropy = scalar.xori %control, %value_entropy : i64
  %changed = scalar.trunci %changed_entropy : i64 to i32
  %length = scalar.constant 8 : i64
  %storage = func.call @create_host_buffer(%length, %pattern) : (i64, i32) -> (buffer)
  %tag = scalar.trunci %control : i64 to i32
  %left_alias, %returned_tag, %right_alias = func.call @host_buffer_aliases(%storage, %tag) : (buffer, i32) -> (buffer, i32, buffer)
  %before = func.call @host_buffer_load(%right_alias, %position) : (buffer, i64) -> (i32)
  func.call @host_buffer_store(%left_alias, %position, %changed) : (buffer, i64, i32)
  %alias_value = func.call @host_buffer_load(%right_alias, %position) : (buffer, i64) -> (i32)
  %original_value = func.call @host_buffer_load(%storage, %position) : (buffer, i64) -> (i32)
  %values = vector.from_elements %before, %alias_value, %original_value, %returned_tag : vector<4xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  vector.store %values, %results[0] : vector<4xi32>, view<4xi32>
  func.return
}

func.def @buffer_extent_observations(%trial: index, %control: i64, %value_entropy: i64, %word_output: buffer, %wide_output: buffer) {
  %length = index.cast %trial : index to i64
  %pattern = scalar.trunci %value_entropy : i64 to i32
  %changed = scalar.trunci %control : i64 to i32
  %storage = func.call @create_host_buffer(%length, %pattern) : (i64, i32) -> (buffer)
  %actual_length = func.call @host_buffer_length(%storage) : (buffer) -> (i64)
  %short_length = scalar.constant 3 : i64
  %long_length = scalar.constant 13 : i64
  %first = func.call @create_host_buffer(%short_length, %pattern) : (i64, i32) -> (buffer)
  %second = func.call @create_host_buffer(%long_length, %changed) : (i64, i32) -> (buffer)
  %swapped_left, %swapped_right = func.call @host_buffer_swap(%first, %second) : (buffer, buffer) -> (buffer, buffer)
  %left_length = func.call @host_buffer_length(%swapped_left) : (buffer) -> (i64)
  %right_length = func.call @host_buffer_length(%swapped_right) : (buffer) -> (i64)
  %swap_position = scalar.constant 1 : i64
  func.call @host_buffer_store(%swapped_left, %swap_position, %changed) : (buffer, i64, i32)
  %first_value = func.call @host_buffer_load(%first, %swap_position) : (buffer, i64) -> (i32)
  %second_value = func.call @host_buffer_load(%second, %swap_position) : (buffer, i64) -> (i32)
  %word_values = vector.from_elements %first_value, %second_value : vector<2xi32>
  %wide_values = vector.from_elements %actual_length, %left_length, %right_length : vector<3xi64>
  %origin = index.constant 0 : offset
  %word_results = buffer.view %word_output[%origin] : buffer -> view<2xi32>
  %wide_results = buffer.view %wide_output[%origin] : buffer -> view<3xi64>
  vector.store %word_values, %word_results[0] : vector<2xi32>, view<2xi32>
  vector.store %wide_values, %wide_results[0] : vector<3xi64>, view<3xi64>
  func.return
}

check.scenario @buffer_argument_values {
  check.trial[128](%trial: index, %entropy: check.entropy) {
    %control_source = check.entropy.fork %entropy name("control") : check.entropy
    %value_source = check.entropy.fork %entropy name("value") : check.entropy
    %control = check.entropy.read %control_source[%trial] : check.entropy -> i64
    %value = check.entropy.read %value_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@buffer_argument_observations>(%control, %value, %output) : (i64, i64, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

check.scenario @buffer_extent_values {
  check.trial[65](%trial: index, %entropy: check.entropy) {
    %control_source = check.entropy.fork %entropy name("control") : check.entropy
    %value_source = check.entropy.fork %entropy name("value") : check.entropy
    %control = check.entropy.read %control_source[%trial] : check.entropy -> i64
    %value = check.entropy.read %value_source[%trial] : check.entropy -> i64
    %word_output = check.generate.fill value(0) : tensor<2xi32>
    %wide_output = check.generate.fill value(0) : tensor<3xi64>
    check.compare<@buffer_extent_observations>(%trial, %control, %value, %word_output, %wide_output) : (index, i64, i64, tensor<2xi32>, tensor<3xi64>) -> () {
      check.expect.bitwise actual(%word_output) expected(%word_output) : tensor<2xi32>
      check.expect.bitwise actual(%wide_output) expected(%wide_output) : tensor<3xi64>
    }
  }
  check.return
}
