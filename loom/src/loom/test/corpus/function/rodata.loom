global.rodata.def @table = align(64) bytes("1122334480ff007e")

// Sixteen words follow 7 + 3 * index across two 32-byte table blocks.
global.rodata.def @gather_words = align(32) bytes("070000000a0000000d000000100000001300000016000000190000001c0000001f0000002200000025000000280000002b0000002e0000003100000034000000")

global.rodata.def @empty = bytes("")

global.rodata.def @suffix = align(2) bytes("aabbcc")

func.def @rodata_table() -> (buffer) {
  %table = global.load @table : buffer
  func.return %table : buffer
}

func.def @rodata_byte(%table: buffer, %position: i64) -> (i32) {
  %position_input = scalar.assume %position [range(%position, 0, 4294967295)] : i64
  %offset = index.cast %position_input : i64 to offset
  %value = buffer.load.i8.u %table[%offset]
  func.return %value : i32
}

// The returned immutable root crosses a callable boundary before it is indexed.
// No pointer into the compiler module or its transient emission storage survives.
// Masked byte indices cross both 32-byte table blocks. The callable boundary
// keeps the packed input dynamic while the immutable table remains explicit.
func.def @rodata_word_gather(%packed_indices: i32) -> (i32, i32, i32, i32) {
  %packed = vector.splat %packed_indices : vector<4xi32>
  %bytes = vector.bitcast %packed : vector<4xi32> to vector<16xi8>
  %index_mask = vector.constant 15 : vector<16xi8>
  %bounded = vector.andi %bytes, %index_mask : vector<16xi8>
  %indices = vector.extui %bounded : vector<16xi8> to vector<16xi32>
  %table = global.load @gather_words : buffer
  %origin = index.constant 0 : offset
  %table_view = buffer.view %table[%origin] : buffer -> view<16xi32>
  %values = vector.gather %table_view[0][%indices] : view<16xi32>, vector<16xi32> -> vector<16xi32>
  %first = vector.extract %values[0] : vector<16xi32> -> i32
  %lower_end = vector.extract %values[1] : vector<16xi32> -> i32
  %upper_begin = vector.extract %values[2] : vector<16xi32> -> i32
  %last = vector.extract %values[3] : vector<16xi32> -> i32
  func.return %first, %lower_end, %upper_begin, %last : i32, i32, i32, i32
}

func.def @rodata_copy(%start: i64, %count: i64) -> (i32, i32) {
  %source = global.load @table : buffer
  %start_input = scalar.assume %start [range(%start, 0, 4294967295)] : i64
  %offset = index.cast %start_input : i64 to offset
  %count_input = scalar.assume %count [range(%count, 0, 4294967295)] : i64
  %length = index.cast %count_input : i64 to offset
  %target_offset = index.constant 0 : offset
  %target = buffer.alloca<private> align(8) %length : buffer
  buffer.copy %source[%offset], %target[%target_offset], %length
  %equal = buffer.compare %source[%offset], %target[%target_offset], %length
  %pattern = scalar.constant 0 : i8
  buffer.fill %pattern, %target[%target_offset], %length : i8
  %original = buffer.load.i8.u %source[%offset]
  func.return %equal, %original : i32, i32
}

func.def @rodata_extents() -> (buffer, buffer) {
  %empty = global.load @empty : buffer
  %suffix = global.load @suffix : buffer
  func.return %empty, %suffix : buffer, buffer
}

func.def @rodata_length(%data: buffer) -> (i64) {
  %length = buffer.length %data
  %result = index.cast %length : offset to i64
  func.return %result : i64
}

// Observes immutable bytes, gathers, copies, zero-length data, and alignment-
// independent extents through ordinary callable boundaries.
func.def @rodata_observations(%entropy: i64, %output: buffer) {
  %position_mask = scalar.constant 7 : i64
  %position = scalar.andi %entropy, %position_mask : i64
  %table = func.call @rodata_table() : () -> (buffer)
  %byte = func.call @rodata_byte(%table, %position) : (buffer, i64) -> (i32)
  %values = vector.from_elements %byte : vector<1xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<1xi32>
  vector.store %values, %results[0] : vector<1xi32>, view<1xi32>
  func.return
}

func.def @rodata_gather_observations(%entropy: i64, %output: buffer) {
  %packed_indices = scalar.trunci %entropy : i64 to i32
  %gather0, %gather1, %gather2, %gather3 = func.call @rodata_word_gather(%packed_indices) : (i32) -> (i32, i32, i32, i32)
  %values = vector.from_elements %gather0, %gather1, %gather2, %gather3 : vector<4xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  vector.store %values, %results[0] : vector<4xi32>, view<4xi32>
  func.return
}

func.def @rodata_copy_observations(%first_entropy: i64, %second_entropy: i64, %output: buffer) {
  %copy_mask = scalar.constant 3 : i64
  %copy_start = scalar.andi %first_entropy, %copy_mask : i64
  %copy_count = scalar.andi %second_entropy, %copy_mask : i64
  %copy_equal, %copy_original = func.call @rodata_copy(%copy_start, %copy_count) : (i64, i64) -> (i32, i32)
  %values = vector.from_elements %copy_equal, %copy_original : vector<2xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %values, %results[0] : vector<2xi32>, view<2xi32>
  func.return
}

func.def @rodata_extent_observations(%output: buffer) {
  %empty, %suffix = func.call @rodata_extents() : () -> (buffer, buffer)
  %empty_length = func.call @rodata_length(%empty) : (buffer) -> (i64)
  %suffix_length = func.call @rodata_length(%suffix) : (buffer) -> (i64)
  %values = vector.from_elements %empty_length, %suffix_length : vector<2xi64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi64>
  vector.store %values, %results[0] : vector<2xi64>, view<2xi64>
  func.return
}

check.scenario @rodata_values {
  check.trial[128](%trial: index, %entropy: check.entropy) {
    %value_source = check.entropy.fork %entropy name("value") : check.entropy
    %value = check.entropy.read %value_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<1xi32>
    check.compare<@rodata_observations>(%value, %output) : (i64, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}

check.scenario @rodata_gather_values {
  check.trial[128](%trial: index, %entropy: check.entropy) {
    %value_source = check.entropy.fork %entropy name("value") : check.entropy
    %value = check.entropy.read %value_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@rodata_gather_observations>(%value, %output) : (i64, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

check.scenario @rodata_copy_values {
  check.trial[128](%trial: index, %entropy: check.entropy) {
    %first_source = check.entropy.fork %entropy name("first") : check.entropy
    %second_source = check.entropy.fork %entropy name("second") : check.entropy
    %first = check.entropy.read %first_source[%trial] : check.entropy -> i64
    %second = check.entropy.read %second_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<2xi32>
    check.compare<@rodata_copy_observations>(%first, %second, %output) : (i64, i64, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}

check.scenario @rodata_extent_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0) : tensor<2xi64>
    check.compare<@rodata_extent_observations>(%output) : (tensor<2xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi64>
    }
  }
  check.return
}
