// Branch facts choose the valid distance implementation. Both applications
// have identical operands, but moving either outside its branch loses proof.
template.decl @ordered_distance(%left: i32, %right: i32) -> (i32)

template.def<@ordered_distance> @ascending(%left: i32, %right: i32) -> (i32) where [lt(%left, %right)] {
  %distance = scalar.subi %right, %left : i32
  template.return %distance : i32
}

template.def<@ordered_distance> @descending(%left: i32, %right: i32) -> (i32) where [ge(%left, %right)] {
  %distance = scalar.subi %left, %right : i32
  template.return %distance : i32
}

func.def public @contextual_distance(%left: i32, %right: i32) -> (i32) {
  %ascending = scalar.cmpi slt, %left, %right : i32
  %distance = scf.if %ascending -> (i32) {
    %result = template.apply<@ordered_distance>(%left, %right) : (i32, i32) -> (i32)
    scf.yield %result : i32
  } else {
    %result = template.apply<@ordered_distance>(%left, %right) : (i32, i32) -> (i32)
    scf.yield %result : i32
  }
  func.return %distance : i32
}

check.case @direct_applications_keep_branch_facts {
  %low = check.literal value(-4) : i32
  %high = check.literal value(9) : i32
  %expected = check.literal value(13) : i32
  %zero = check.literal value(0) : i32
  %ascending = func.call @contextual_distance(%low, %high) : (i32, i32) -> (i32)
  %descending = func.call @contextual_distance(%high, %low) : (i32, i32) -> (i32)
  %equal = func.call @contextual_distance(%low, %low) : (i32, i32) -> (i32)
  check.expect.equal actual(%ascending) expected(%expected) : i32
  check.expect.equal actual(%descending) expected(%expected) : i32
  check.expect.equal actual(%equal) expected(%zero) : i32
  check.return
}

template.decl @distance_wrapper(%left: i32, %right: i32) -> (i32)

template.def<@distance_wrapper> @exact_distance(%left: i32, %right: i32) -> (i32) {
  %distance = template.apply<@ordered_distance>(%left, %right) : (i32, i32) -> (i32)
  template.return %distance : i32
}

func.def public @wrapped_distance(%left: i32, %right: i32) -> (i32) {
  %ascending = scalar.cmpi slt, %left, %right : i32
  %distance = scf.if %ascending -> (i32) {
    %result = template.call @exact_distance(%left, %right) : (i32, i32) -> (i32)
    scf.yield %result : i32
  } else {
    %result = template.call @exact_distance(%left, %right) : (i32, i32) -> (i32)
    scf.yield %result : i32
  }
  func.return %distance : i32
}

check.case @exact_wrappers_keep_branch_facts {
  %low = check.literal value(-4) : i32
  %high = check.literal value(9) : i32
  %expected = check.literal value(13) : i32
  %zero = check.literal value(0) : i32
  %ascending = func.call @wrapped_distance(%low, %high) : (i32, i32) -> (i32)
  %descending = func.call @wrapped_distance(%high, %low) : (i32, i32) -> (i32)
  %equal = func.call @wrapped_distance(%low, %low) : (i32, i32) -> (i32)
  check.expect.equal actual(%ascending) expected(%expected) : i32
  check.expect.equal actual(%descending) expected(%expected) : i32
  check.expect.equal actual(%equal) expected(%zero) : i32
  check.return
}

func.def inline @inline_distance(%left: i32, %right: i32) -> (i32) {
  %distance = template.apply<@ordered_distance>(%left, %right) : (i32, i32) -> (i32)
  func.return %distance : i32
}

func.def public @called_distance(%left: i32, %right: i32) -> (i32) {
  %ascending = scalar.cmpi slt, %left, %right : i32
  %distance = scf.if %ascending -> (i32) {
    %result = func.call @inline_distance(%left, %right) : (i32, i32) -> (i32)
    scf.yield %result : i32
  } else {
    %result = func.call @inline_distance(%left, %right) : (i32, i32) -> (i32)
    scf.yield %result : i32
  }
  func.return %distance : i32
}

check.case @inline_wrappers_keep_branch_facts {
  %low = check.literal value(-4) : i32
  %high = check.literal value(9) : i32
  %expected = check.literal value(13) : i32
  %zero = check.literal value(0) : i32
  %ascending = func.call @called_distance(%low, %high) : (i32, i32) -> (i32)
  %descending = func.call @called_distance(%high, %low) : (i32, i32) -> (i32)
  %equal = func.call @called_distance(%low, %low) : (i32, i32) -> (i32)
  check.expect.equal actual(%ascending) expected(%expected) : i32
  check.expect.equal actual(%descending) expected(%expected) : i32
  check.expect.equal actual(%equal) expected(%zero) : i32
  check.return
}
