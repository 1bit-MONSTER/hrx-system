// Advisory CU cache hints cannot narrow the authored atomic coherence scope.
// Each lane publishes to its neighbor in one converged subgroup. Global and
// LDS payloads are independent of the atomic flags and their returned values.
kernel.def @subgroup_atomic_handoff() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<2x32xi32>
  %flag = buffer.view %signal[%origin] : buffer -> view<32xi32>
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %generic_flag = buffer.view %generic[%origin] : buffer -> view<32xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<32xi32>
  %results = buffer.view %output[%origin] : buffer -> view<6x32xi32>
  %lane = kernel.workitem.id<x> : index
  %step = index.constant 1 : index
  %neighbor = index.xori %lane, %step : index
  %ordinal = index.cast %lane : index to i32
  %bias = scalar.constant 65536 : i32
  %value = scalar.addi %ordinal, %bias : i32
  %unpublished = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  view.store %value, %data[%lane] : i32, view<32xi32>
  view.store %value, %local[0, %lane] : i32, view<2x32xi32>
  view.atomic.store %increment, %flag[%lane] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = subgroup} : i32, view<32xi32>
  %observed = view.atomic.load %flag[%neighbor] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acquire, scope = subgroup} : view<32xi32> -> i32
  %failed = view.atomic.cmpxchg %unpublished, %unpublished, %generic_flag[%neighbor] {cache_scope = workgroup, cache_temporal = non_temporal, failure_ordering = acquire, scope = subgroup, success_ordering = acq_rel} : i32, view<32xi32> -> i32
  view.atomic.store %unpublished, %local[1, %lane] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = relaxed, scope = subgroup} : i32, view<2x32xi32>
  %old = view.atomic.rmw<addi> %increment, %local[1, %lane] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acq_rel, scope = subgroup} : i32, view<2x32xi32> -> i32
  view.atomic.reduce<addi> %increment, %local[1, %lane] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = subgroup} : i32, view<2x32xi32>
  buffer.fence scope(subgroup) ordering(release)
  %local_flag = view.atomic.load %local[1, %neighbor] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = relaxed, scope = subgroup} : view<2x32xi32> -> i32
  buffer.fence scope(subgroup) ordering(acquire)
  %global_value = view.load %data[%neighbor] : view<32xi32> -> i32
  %local_value = view.load %local[0, %neighbor] : view<2x32xi32> -> i32
  view.store %global_value, %results[0, %neighbor] : i32, view<6x32xi32>
  view.store %local_value, %results[1, %neighbor] : i32, view<6x32xi32>
  view.store %observed, %results[2, %lane] : i32, view<6x32xi32>
  view.store %failed, %results[3, %lane] : i32, view<6x32xi32>
  view.store %old, %results[4, %lane] : i32, view<6x32xi32>
  view.store %local_flag, %results[5, %lane] : i32, view<6x32xi32>
  kernel.return
}

// Thread scope retains every observation and the full 64-bit old value.
kernel.def @thread_atomic_sequence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xi64>
  %word = buffer.view %signal[%origin] : buffer -> view<1xi64>
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %generic_word = buffer.view %generic[%origin] : buffer -> view<1xi64>
  %results = buffer.view %output[%origin] : buffer -> view<4xi64>
  %initial = scalar.constant 4294967297 : i64
  %increment = scalar.constant 1 : i64
  view.atomic.store %initial, %word[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = seq_cst, scope = thread} : i64, view<1xi64>
  %discarded = view.atomic.load %word[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = relaxed, scope = thread} : view<1xi64> -> i64
  %observed = view.atomic.load %word[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = seq_cst, scope = thread} : view<1xi64> -> i64
  %old = view.atomic.rmw<addi> %increment, %generic_word[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acq_rel, scope = thread} : i64, view<1xi64> -> i64
  view.atomic.reduce<addi> %increment, %word[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = thread} : i64, view<1xi64>
  view.atomic.store %initial, %local[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = thread} : i64, view<1xi64>
  %exchanged = view.atomic.cmpxchg %initial, %increment, %local[0] {cache_scope = workgroup, cache_temporal = non_temporal, failure_ordering = acquire, scope = thread, success_ordering = seq_cst} : i64, view<1xi64> -> i64
  buffer.fence scope(thread) ordering(seq_cst)
  %final = view.atomic.load %generic_word[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acquire, scope = thread} : view<1xi64> -> i64
  view.store %observed, %results[0] : i64, view<4xi64>
  view.store %old, %results[1] : i64, view<4xi64>
  view.store %exchanged, %results[2] : i64, view<4xi64>
  view.store %final, %results[3] : i64, view<4xi64>
  kernel.return
}

// Broader authored scopes on LDS retain workgroup publication and acquisition,
// including payloads in global memory and acquisition on a failed compare.
kernel.def @lds_broad_scope() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  %unpublished = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %value = scalar.constant 65537 : i32
  view.store %value, %data[0] : i32, view<1xi32>
  view.atomic.store %increment, %flag[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = system} : i32, view<1xi32>
  %observed = view.atomic.load %flag[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acquire, scope = device} : view<1xi32> -> i32
  %failed = view.atomic.cmpxchg %unpublished, %unpublished, %flag[0] {cache_scope = workgroup, cache_temporal = non_temporal, failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %acquired = view.load %data[0] : view<1xi32> -> i32
  view.atomic.reduce<addi> %increment, %flag[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = device} : i32, view<1xi32>
  %old = view.atomic.rmw<addi> %increment, %flag[0] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = seq_cst, scope = system} : i32, view<1xi32> -> i32
  view.store %observed, %results[0] : i32, view<4xi32>
  view.store %failed, %results[1] : i32, view<4xi32>
  view.store %old, %results[2] : i32, view<4xi32>
  view.store %acquired, %results[3] : i32, view<4xi32>
  kernel.return
}

func.def @subgroup_atomic_handoff_oracle(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %flags = buffer.view %signal[%origin] : buffer -> view<32xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<32xi32>
  %results = buffer.view %output[%origin] : buffer -> view<6x32xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %bias = scalar.constant 65536 : i32
  %observed = scalar.constant 1 : i32
  %old = scalar.constant 0 : i32
  %local_flag = scalar.constant 2 : i32
  scf.for %lane = [%begin to %end step %step] {
    %ordinal = index.cast %lane : index to i32
    %value = scalar.addi %ordinal, %bias : i32
    view.store %observed, %flags[%lane] : i32, view<32xi32>
    view.store %value, %data[%lane] : i32, view<32xi32>
    view.store %value, %results[0, %lane] : i32, view<6x32xi32>
    view.store %value, %results[1, %lane] : i32, view<6x32xi32>
    view.store %observed, %results[2, %lane] : i32, view<6x32xi32>
    view.store %observed, %results[3, %lane] : i32, view<6x32xi32>
    view.store %old, %results[4, %lane] : i32, view<6x32xi32>
    view.store %local_flag, %results[5, %lane] : i32, view<6x32xi32>
  }
  func.return
}

check.scenario @subgroup_atomic_handoff_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signal = check.generate.fill value(-1) : tensor<32xi32>
    %payload = check.generate.fill value(-1) : tensor<32xi32>
    %output = check.generate.fill value(-1) : tensor<192xi32>
    check.compare<@subgroup_atomic_handoff, @subgroup_atomic_handoff_oracle>(%signal, %payload, %output) : (tensor<32xi32>, tensor<32xi32>, tensor<192xi32>) -> () {
      check.expect.bitwise actual(%signal) expected(%signal) : tensor<32xi32>
      check.expect.bitwise actual(%payload) expected(%payload) : tensor<32xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi32>
    }
  }
  check.return
}

func.def @thread_atomic_sequence_oracle(%signal: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %word = buffer.view %signal[%origin] : buffer -> view<1xi64>
  %results = buffer.view %output[%origin] : buffer -> view<4xi64>
  %initial = scalar.constant 4294967297 : i64
  %final = scalar.constant 4294967299 : i64
  view.store %final, %word[0] : i64, view<1xi64>
  view.store %initial, %results[0] : i64, view<4xi64>
  view.store %initial, %results[1] : i64, view<4xi64>
  view.store %initial, %results[2] : i64, view<4xi64>
  view.store %final, %results[3] : i64, view<4xi64>
  func.return
}

check.scenario @thread_atomic_sequence_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signal = check.generate.fill value(-1) : tensor<1xi64>
    %output = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@thread_atomic_sequence, @thread_atomic_sequence_oracle>(%signal, %output) : (tensor<1xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%signal) expected(%signal) : tensor<1xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.return
}

func.def @lds_broad_scope_oracle(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %data = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  %observed = scalar.constant 1 : i32
  %old = scalar.constant 2 : i32
  %value = scalar.constant 65537 : i32
  view.store %value, %data[0] : i32, view<1xi32>
  view.store %observed, %results[0] : i32, view<4xi32>
  view.store %observed, %results[1] : i32, view<4xi32>
  view.store %old, %results[2] : i32, view<4xi32>
  view.store %value, %results[3] : i32, view<4xi32>
  func.return
}

check.scenario @lds_broad_scope_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %payload = check.generate.fill value(-1) : tensor<1xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@lds_broad_scope, @lds_broad_scope_oracle>(%payload, %output) : (tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%payload) expected(%payload) : tensor<1xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
