// Duplicate active addresses must return distinct old values. Disabled lanes
// preserve their passthrough and leave the corresponding guard cells untouched.
kernel.def @masked_duplicate_atomic() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<4xi32>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %output_global[%base] : buffer -> view<4xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled, %enabled, %disabled : vector<4xi1>
  %index0 = index.constant 0 : index
  %index2 = index.constant 2 : index
  %index3 = index.constant 3 : index
  %offsets = vector.from_elements %index0, %index2, %index0, %index3 : vector<4xindex>
  %increment = vector.constant 1 : vector<4xi32>
  %passthrough = vector.constant -101 : vector<4xi32>
  %old = vector.atomic.rmw.mask<addi> %increment, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<4xi32>, view<4xi32>, vector<4xindex>, vector<4xi1>, vector<4xi32>
  %first = vector.extract %old[0] : vector<4xi32> -> i32
  %second = vector.extract %old[2] : vector<4xi32> -> i32
  %lower = scalar.minsi %first, %second : i32
  %upper = scalar.maxsi %first, %second : i32
  %inactive1 = vector.extract %old[1] : vector<4xi32> -> i32
  %inactive3 = vector.extract %old[3] : vector<4xi32> -> i32
  view.store %lower, %results[0] : i32, view<4xi32>
  view.store %upper, %results[1] : i32, view<4xi32>
  view.store %inactive1, %results[2] : i32, view<4xi32>
  view.store %inactive3, %results[3] : i32, view<4xi32>
  kernel.return
}

check.case public @masked_duplicate_active {
  %flag = check.literal value(1) : i32
  %memory = check.generate.fill value(7) : tensor<4xi32>
  %output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @masked_duplicate_atomic(%flag, %memory, %output) : (i32, tensor<4xi32>, tensor<4xi32>)
  %old = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<2xi32>
  %inactive = check.tensor.view %output offset(8) : tensor<4xi32> -> tensor<2xi32>
  %updated = check.tensor.view %memory offset(0) : tensor<4xi32> -> tensor<1xi32>
  %guards = check.tensor.view %memory offset(4) : tensor<4xi32> -> tensor<3xi32>
  %expected_old = check.generate.iota offset(7) step(1) : tensor<2xi32>
  %expected_inactive = check.generate.fill value(-101) : tensor<2xi32>
  %expected_updated = check.generate.fill value(9) : tensor<1xi32>
  %expected_guards = check.generate.fill value(7) : tensor<3xi32>
  check.expect.bitwise actual(%old) expected(%expected_old) : tensor<2xi32>
  check.expect.bitwise actual(%inactive) expected(%expected_inactive) : tensor<2xi32>
  check.expect.bitwise actual(%updated) expected(%expected_updated) : tensor<1xi32>
  check.expect.bitwise actual(%guards) expected(%expected_guards) : tensor<3xi32>
  check.return
}

check.case public @masked_duplicate_inactive {
  %flag = check.literal value(0) : i32
  %memory = check.generate.fill value(7) : tensor<4xi32>
  %output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @masked_duplicate_atomic(%flag, %memory, %output) : (i32, tensor<4xi32>, tensor<4xi32>)
  %expected_memory = check.generate.fill value(7) : tensor<4xi32>
  %expected_output = check.generate.fill value(-101) : tensor<4xi32>
  check.expect.bitwise actual(%memory) expected(%expected_memory) : tensor<4xi32>
  check.expect.bitwise actual(%output) expected(%expected_output) : tensor<4xi32>
  check.return
}

// An inactive offset may lie outside the view and must not become an access.
kernel.def @masked_outside_view() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<1xi32>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %output_global[%base] : buffer -> view<2xi32>
  %c0 = index.constant 0 : index
  %outside = index.constant -100 : index
  %offsets = vector.from_elements %c0, %outside : vector<2xindex>
  %enabled = scalar.constant true : i1
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %increment = vector.constant 1 : vector<2xi32>
  %passthrough = vector.constant -101 : vector<2xi32>
  %old = vector.atomic.rmw.mask<addi> %increment, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<2xi32>, view<1xi32>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  vector.store %old, %results[0] : vector<2xi32>, view<2xi32>
  kernel.return
}

check.case public @inactive_offset_outside_view {
  %memory = check.generate.fill value(7) : tensor<1xi32>
  %output = check.generate.fill value(0) : tensor<2xi32>
  kernel.launch @masked_outside_view(%memory, %output) : (tensor<1xi32>, tensor<2xi32>)
  %expected_memory = check.generate.fill value(8) : tensor<1xi32>
  %expected_output = check.generate.iota offset(7) step(-108) : tensor<2xi32>
  check.expect.bitwise actual(%memory) expected(%expected_memory) : tensor<1xi32>
  check.expect.bitwise actual(%output) expected(%expected_output) : tensor<2xi32>
  check.return
}

// NaN payloads in old values and passthrough lanes are transported as bits.
// The active lane uses the target's scalar floating-point atomic recipe.
kernel.def @masked_float_old_bits() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %output_global[%base] : buffer -> view<2xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %index0 = index.constant 0 : index
  %index1 = index.constant 1 : index
  %offsets = vector.iota %index0 step %index1 : vector<2xindex>
  %value = vector.constant 1.0 : vector<2xf32>
  %passthrough_bits = vector.constant 2143311480 : vector<2xi32>
  %passthrough = vector.bitcast %passthrough_bits : vector<2xi32> to vector<2xf32>
  %old = vector.atomic.rmw.mask<minnumf> %value, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  %old_bits = vector.bitcast %old : vector<2xf32> to vector<2xi32>
  vector.store %old_bits, %results[0] : vector<2xi32>, view<2xi32>
  kernel.return
}

check.case public @float_old_and_passthrough_nan_payloads {
  %flag = check.literal value(1) : i32
  %memory = check.generate.fill value(2143294004) : tensor<2xi32>
  %output = check.generate.fill value(0) : tensor<2xi32>
  kernel.launch @masked_float_old_bits(%flag, %memory, %output) : (i32, tensor<2xi32>, tensor<2xi32>)
  %active = check.tensor.view %memory offset(0) : tensor<2xi32> -> tensor<1xi32>
  %inactive = check.tensor.view %memory offset(4) : tensor<2xi32> -> tensor<1xi32>
  %expected_active = check.generate.fill value(1065353216) : tensor<1xi32>
  %expected_inactive = check.generate.fill value(2143294004) : tensor<1xi32>
  %expected_output = check.generate.iota offset(2143294004) step(17476) : tensor<2xi32>
  check.expect.bitwise actual(%active) expected(%expected_active) : tensor<1xi32>
  check.expect.bitwise actual(%inactive) expected(%expected_inactive) : tensor<1xi32>
  check.expect.bitwise actual(%output) expected(%expected_output) : tensor<2xi32>
  check.return
}

// Reversing destinations makes an early update alias a later input lane.
// Every update must still consume the snapshot captured by the vector load.
kernel.def @atomic_input_snapshot() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xi32>
  %captured = vector.load %view[0] : view<2xi32> -> vector<2xi32>
  %origin = index.constant 1 : index
  %stride = index.constant -1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  vector.atomic.reduce<addi> %captured, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi32>, view<2xi32>, vector<2xindex>
  kernel.return
}

check.case public @vector_atomic_input_snapshot {
  %memory = check.generate.iota offset(2) step(1) : tensor<2xi32>
  kernel.launch @atomic_input_snapshot(%memory) : (tensor<2xi32>)
  %expected = check.generate.fill value(5) : tensor<2xi32>
  check.expect.bitwise actual(%memory) expected(%expected) : tensor<2xi32>
  check.return
}

// Both words of every old value survive reduction, exchange and CAS.
kernel.def @vector_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xi64>
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %increment = vector.constant 4294967297 : vector<2xi64>
  vector.atomic.reduce<addi> %increment, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi64>, view<2xi64>, vector<2xindex>
  %old = vector.atomic.rmw<xchgi> %increment, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi64>, view<2xi64>, vector<2xindex>
  %observed = vector.atomic.cmpxchg %increment, %old, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xi64>, view<2xi64>, vector<2xindex> -> vector<2xi64>
  vector.store %old, %results[0] : vector<2xi64>, view<4xi64>
  vector.store %observed, %results[2] : vector<2xi64>, view<4xi64>
  kernel.return
}

check.case public @vector_atomic_i64_high_words {
  %memory = check.generate.fill value(4294967295) : tensor<2xi64>
  %output = check.generate.fill value(0) : tensor<4xi64>
  kernel.launch @vector_atomic_i64(%memory, %output) : (tensor<2xi64>, tensor<4xi64>)
  %old = check.tensor.view %output offset(0) : tensor<4xi64> -> tensor<2xi64>
  %observed = check.tensor.view %output offset(16) : tensor<4xi64> -> tensor<2xi64>
  %expected_old = check.generate.fill value(8589934592) : tensor<2xi64>
  %expected_observed = check.generate.fill value(4294967297) : tensor<2xi64>
  check.expect.bitwise actual(%old) expected(%expected_old) : tensor<2xi64>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<2xi64>
  check.expect.bitwise actual(%memory) expected(%expected_old) : tensor<2xi64>
  check.return
}

// Compare-exchange compares floating-point encodings, including zero signs and
// NaNs. Equal NaN payloads succeed; unequal zero signs fail.
kernel.def @vector_atomic_float_cmpxchg() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %mismatch_bits = scalar.constant -2147483648 : i32
  %match_bits = scalar.constant 0 : i32
  %expected_bits = vector.from_elements %mismatch_bits, %match_bits : vector<2xi32>
  %expected = vector.bitcast %expected_bits : vector<2xi32> to vector<2xf32>
  %nan_bits = vector.constant 2143294004 : vector<2xi32>
  %nan = vector.bitcast %nan_bits : vector<2xi32> to vector<2xf32>
  %replacement = vector.constant 1.0 : vector<2xf32>
  %old = vector.atomic.cmpxchg %expected, %nan, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xf32>, view<2xf32>, vector<2xindex> -> vector<2xf32>
  %observed = vector.atomic.cmpxchg %nan, %replacement, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xf32>, view<2xf32>, vector<2xindex> -> vector<2xf32>
  %old_bits = vector.bitcast %old : vector<2xf32> to vector<2xi32>
  %observed_bits = vector.bitcast %observed : vector<2xf32> to vector<2xi32>
  vector.store %old_bits, %results[0] : vector<2xi32>, view<4xi32>
  vector.store %observed_bits, %results[2] : vector<2xi32>, view<4xi32>
  kernel.return
}

check.case public @vector_atomic_float_bitwise_comparison {
  %memory = check.generate.fill value(0) : tensor<2xi32>
  %output = check.generate.fill value(-1) : tensor<4xi32>
  kernel.launch @vector_atomic_float_cmpxchg(%memory, %output) : (tensor<2xi32>, tensor<4xi32>)
  %old = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<2xi32>
  %observed = check.tensor.view %output offset(8) : tensor<4xi32> -> tensor<2xi32>
  %expected_old = check.generate.fill value(0) : tensor<2xi32>
  %expected_observed = check.generate.iota offset(0) step(2143294004) : tensor<2xi32>
  %expected_memory = check.generate.iota offset(0) step(1065353216) : tensor<2xi32>
  check.expect.bitwise actual(%old) expected(%expected_old) : tensor<2xi32>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<2xi32>
  check.expect.bitwise actual(%memory) expected(%expected_memory) : tensor<2xi32>
  check.return
}

// Two updates per workitem contend on the same cell across two workgroups.
// Returned tickets form 0..255 regardless of lane or workgroup scheduling.
kernel.def @contended_vector_atomic() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%memory: buffer, %old_sum: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<1xi32>
  %sum_global = buffer.assume.memory_space<global> %old_sum : buffer
  %sum_view = buffer.view %sum_global[%base] : buffer -> view<1xi32>
  %offsets = vector.constant 0 : vector<2xi32>
  %increment = vector.constant 1 : vector<2xi32>
  %old = vector.atomic.rmw<addi> %increment, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi32>, view<1xi32>, vector<2xi32>
  %first = vector.extract %old[0] : vector<2xi32> -> i32
  %second = vector.extract %old[1] : vector<2xi32> -> i32
  %sum = scalar.addi %first, %second : i32
  view.atomic.reduce<addi> %sum, %sum_view[0] {ordering = relaxed, scope = device} : i32, view<1xi32>
  kernel.return
}

check.case public @vector_atomic_contended_tickets {
  %memory = check.generate.fill value(0) : tensor<1xi32>
  %old_sum = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @contended_vector_atomic(%memory, %old_sum) : (tensor<1xi32>, tensor<1xi32>)
  %expected_memory = check.generate.fill value(256) : tensor<1xi32>
  %expected_sum = check.generate.fill value(32640) : tensor<1xi32>
  check.expect.bitwise actual(%memory) expected(%expected_memory) : tensor<1xi32>
  check.expect.bitwise actual(%old_sum) expected(%expected_sum) : tensor<1xi32>
  check.return
}
