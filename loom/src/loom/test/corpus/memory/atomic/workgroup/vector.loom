// Exercise every vector atomic form against the same LDS cells, including a
// successful compare-exchange and an unequal comparison that leaves memory alone.
kernel.def @workgroup_vector_atomics() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<2xi32>
  %results = buffer.view %output[%base] : buffer -> view<6xi32>
  %initial = vector.constant 7 : vector<2xi32>
  vector.store %initial, %view[0] : vector<2xi32>, view<2xi32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %increment = vector.constant 1 : vector<2xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  vector.atomic.reduce<addi> %increment, %view[0][%offsets] {ordering = release, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>
  vector.atomic.reduce.mask<subi> %increment, %view[0][%offsets], %mask {ordering = relaxed, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>, vector<2xi1>
  %old = vector.atomic.rmw<addi> %increment, %view[0][%offsets] {ordering = acq_rel, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>
  %masked = vector.atomic.rmw.mask<xchgi> %increment, %view[0][%offsets], %mask, %old {ordering = acquire, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  %observed = vector.atomic.cmpxchg %increment, %old, %view[0][%offsets] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : vector<2xi32>, view<2xi32>, vector<2xindex> -> vector<2xi32>
  %final = vector.load %view[0] : view<2xi32> -> vector<2xi32>
  vector.store %masked, %results[0] : vector<2xi32>, view<6xi32>
  vector.store %observed, %results[2] : vector<2xi32>, view<6xi32>
  vector.store %final, %results[4] : vector<2xi32>, view<6xi32>
  kernel.return
}

check.case public @workgroup_vector_atomic_values {
  %flag = check.literal value(1) : i32
  %output = check.generate.fill value(0) : tensor<6xi32>
  kernel.launch @workgroup_vector_atomics(%flag, %output) : (i32, tensor<6xi32>)
  %masked = check.tensor.view %output offset(0) : tensor<6xi32> -> tensor<2xi32>
  %observed = check.tensor.view %output offset(8) : tensor<6xi32> -> tensor<2xi32>
  %final = check.tensor.view %output offset(16) : tensor<6xi32> -> tensor<2xi32>
  %expected_masked = check.generate.fill value(8) : tensor<2xi32>
  %expected_observed = check.generate.iota offset(1) step(8) : tensor<2xi32>
  %expected_final = check.generate.iota offset(7) step(2) : tensor<2xi32>
  check.expect.bitwise actual(%masked) expected(%expected_masked) : tensor<2xi32>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<2xi32>
  check.expect.bitwise actual(%final) expected(%expected_final) : tensor<2xi32>
  check.return
}
