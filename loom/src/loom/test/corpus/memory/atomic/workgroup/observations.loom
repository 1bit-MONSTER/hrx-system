// Mixed integer and floating observations preserve bits and neighboring cells.
kernel.def @lds_observations_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i32, %replacement: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %whole = buffer.view %scratch[%origin] : buffer -> view<4xi32>
  %integers = view.subview %whole[1] : view<4xi32> -> view<2xi32>
  %float_whole = buffer.view %scratch[%origin] : buffer -> view<4xf32>
  %floats = view.subview %float_whole[1] : view<4xf32> -> view<2xf32>
  %results = buffer.view %output[%origin] : buffer -> view<5xi32>
  %float_replacement = scalar.bitcast %replacement : i32 to f32
  view.store %initial, %whole[0] : i32, view<4xi32>
  view.store %initial, %whole[3] : i32, view<4xi32>
  view.atomic.store %initial, %integers[0] {ordering = relaxed, scope = workgroup} : i32, view<2xi32>
  %unused = view.atomic.load %integers[0] {ordering = relaxed, scope = workgroup} : view<2xi32> -> i32
  %relaxed = view.atomic.load %floats[0] {ordering = relaxed, scope = workgroup} : view<2xf32> -> f32
  view.atomic.store %float_replacement, %floats[1] {ordering = release, scope = workgroup} : f32, view<2xf32>
  %acquired = view.atomic.load %integers[1] {ordering = acquire, scope = workgroup} : view<2xi32> -> i32
  view.atomic.store %initial, %integers[0] {ordering = seq_cst, scope = workgroup} : i32, view<2xi32>
  %sequential = view.atomic.load %floats[0] {ordering = seq_cst, scope = workgroup} : view<2xf32> -> f32
  %relaxed_bits = scalar.bitcast %relaxed : f32 to i32
  %sequential_bits = scalar.bitcast %sequential : f32 to i32
  %before = view.load %whole[0] : view<4xi32> -> i32
  %after = view.load %whole[3] : view<4xi32> -> i32
  view.store %relaxed_bits, %results[0] : i32, view<5xi32>
  view.store %acquired, %results[1] : i32, view<5xi32>
  view.store %sequential_bits, %results[2] : i32, view<5xi32>
  view.store %before, %results[3] : i32, view<5xi32>
  view.store %after, %results[4] : i32, view<5xi32>
  kernel.return
}

// Mixed integer and floating observations preserve bits and neighboring cells.
kernel.def @lds_observations_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i64, %replacement: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %whole = buffer.view %scratch[%origin] : buffer -> view<4xi64>
  %integers = view.subview %whole[1] : view<4xi64> -> view<2xi64>
  %float_whole = buffer.view %scratch[%origin] : buffer -> view<4xf64>
  %floats = view.subview %float_whole[1] : view<4xf64> -> view<2xf64>
  %results = buffer.view %output[%origin] : buffer -> view<5xi64>
  %float_replacement = scalar.bitcast %replacement : i64 to f64
  view.store %initial, %whole[0] : i64, view<4xi64>
  view.store %initial, %whole[3] : i64, view<4xi64>
  view.atomic.store %initial, %integers[0] {ordering = relaxed, scope = workgroup} : i64, view<2xi64>
  %unused = view.atomic.load %integers[0] {ordering = relaxed, scope = workgroup} : view<2xi64> -> i64
  %relaxed = view.atomic.load %floats[0] {ordering = relaxed, scope = workgroup} : view<2xf64> -> f64
  view.atomic.store %float_replacement, %floats[1] {ordering = release, scope = workgroup} : f64, view<2xf64>
  %acquired = view.atomic.load %integers[1] {ordering = acquire, scope = workgroup} : view<2xi64> -> i64
  view.atomic.store %initial, %integers[0] {ordering = seq_cst, scope = workgroup} : i64, view<2xi64>
  %sequential = view.atomic.load %floats[0] {ordering = seq_cst, scope = workgroup} : view<2xf64> -> f64
  %relaxed_bits = scalar.bitcast %relaxed : f64 to i64
  %sequential_bits = scalar.bitcast %sequential : f64 to i64
  %before = view.load %whole[0] : view<4xi64> -> i64
  %after = view.load %whole[3] : view<4xi64> -> i64
  view.store %relaxed_bits, %results[0] : i64, view<5xi64>
  view.store %acquired, %results[1] : i64, view<5xi64>
  view.store %sequential_bits, %results[2] : i64, view<5xi64>
  view.store %before, %results[3] : i64, view<5xi64>
  view.store %after, %results[4] : i64, view<5xi64>
  kernel.return
}

// A NaN payload and negative zero retain their exact integer representations.
check.case public @lds_observation_bits_i32 {
  %initial = check.literal value(2139169605) : i32
  %replacement = check.literal value(-2147483648) : i32
  %output = check.generate.fill value(37) : tensor<5xi32>
  kernel.launch @lds_observations_i32(%initial, %replacement, %output) : (i32, i32, tensor<5xi32>)
  %first = check.tensor.view %output offset(0) : tensor<5xi32> -> tensor<1xi32>
  %second = check.tensor.view %output offset(4) : tensor<5xi32> -> tensor<1xi32>
  %tail = check.tensor.view %output offset(8) : tensor<5xi32> -> tensor<3xi32>
  %expected_first = check.generate.fill value(2139169605) : tensor<1xi32>
  %expected_second = check.generate.fill value(-2147483648) : tensor<1xi32>
  %expected_tail = check.generate.fill value(2139169605) : tensor<3xi32>
  check.expect.bitwise actual(%first) expected(%expected_first) : tensor<1xi32>
  check.expect.bitwise actual(%second) expected(%expected_second) : tensor<1xi32>
  check.expect.bitwise actual(%tail) expected(%expected_tail) : tensor<3xi32>
  check.return
}

// A NaN payload and negative zero retain their exact integer representations.
check.case public @lds_observation_bits_i64 {
  %initial = check.literal value(9218888453225749180) : i64
  %replacement = check.literal value(-9223372036854775808) : i64
  %output = check.generate.fill value(37) : tensor<5xi64>
  kernel.launch @lds_observations_i64(%initial, %replacement, %output) : (i64, i64, tensor<5xi64>)
  %first = check.tensor.view %output offset(0) : tensor<5xi64> -> tensor<1xi64>
  %second = check.tensor.view %output offset(8) : tensor<5xi64> -> tensor<1xi64>
  %tail = check.tensor.view %output offset(16) : tensor<5xi64> -> tensor<3xi64>
  %expected_first = check.generate.fill value(9218888453225749180) : tensor<1xi64>
  %expected_second = check.generate.fill value(-9223372036854775808) : tensor<1xi64>
  %expected_tail = check.generate.fill value(9218888453225749180) : tensor<3xi64>
  check.expect.bitwise actual(%first) expected(%expected_first) : tensor<1xi64>
  check.expect.bitwise actual(%second) expected(%expected_second) : tensor<1xi64>
  check.expect.bitwise actual(%tail) expected(%expected_tail) : tensor<3xi64>
  check.return
}

// Two lanes in different waves hand off ordinary global and LDS payloads.
// The initial barrier publishes flag initialization; later rounds synchronize
// through atomic observations and publications in both directions.
kernel.def @lds_publication_i32() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<2xi32>
  %global = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %results = buffer.view %output[%origin] : buffer -> view<32xi32>
  %acknowledged = scalar.constant 0 : i32
  %published = scalar.constant 1 : i32
  %bias = scalar.constant 65536 : i32
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %reader_lane = index.constant 64 : index
  %lane = kernel.workitem.id<x> : index
  %writer = index.cmp eq, %lane, %begin : index
  %reader = index.cmp eq, %lane, %reader_lane : index
  scf.if %writer {
    view.store %acknowledged, %local[0] : i32, view<2xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %writer {
    scf.for %iteration = [%begin to %end step %step] {
      scf.while {
        %ack = view.atomic.load %local[0] {ordering = acquire, scope = workgroup} : view<2xi32> -> i32
        %pending = scalar.cmpi ne, %ack, %acknowledged : i32
        scf.condition %pending : i1
      } do {
        scf.yield
      }
      %ordinal = index.cast %iteration : index to i32
      %value = scalar.addi %ordinal, %bias : i32
      view.store %value, %global[0] : i32, view<1xi32>
      view.store %value, %local[1] : i32, view<2xi32>
      view.atomic.store %published, %local[0] {ordering = release, scope = workgroup} : i32, view<2xi32>
    }
  }
  scf.if %reader {
    scf.for %iteration = [%begin to %end step %step] {
      scf.while {
        %ready = view.atomic.load %local[0] {ordering = acquire, scope = workgroup} : view<2xi32> -> i32
        %pending = scalar.cmpi ne, %ready, %published : i32
        scf.condition %pending : i1
      } do {
        scf.yield
      }
      %global_value = view.load %global[0] : view<1xi32> -> i32
      %local_value = view.load %local[1] : view<2xi32> -> i32
      %local_index = index.add %iteration, %end : index
      view.store %global_value, %results[%iteration] : i32, view<32xi32>
      view.store %local_value, %results[%local_index] : i32, view<32xi32>
      view.atomic.store %acknowledged, %local[0] {ordering = release, scope = workgroup} : i32, view<2xi32>
    }
  }
  kernel.return
}

check.case public @lds_publication_values_i32 {
  %payload = check.generate.fill value(-1) : tensor<1xi32>
  %output = check.generate.fill value(-1) : tensor<32xi32>
  kernel.launch @lds_publication_i32(%payload, %output) : (tensor<1xi32>, tensor<32xi32>)
  %global_values = check.tensor.view %output offset(0) : tensor<32xi32> -> tensor<16xi32>
  %local_values = check.tensor.view %output offset(64) : tensor<32xi32> -> tensor<16xi32>
  %expected = check.generate.iota offset(65536) step(1) : tensor<16xi32>
  check.expect.bitwise actual(%global_values) expected(%expected) : tensor<16xi32>
  check.expect.bitwise actual(%local_values) expected(%expected) : tensor<16xi32>
  check.return
}

// Two lanes in different waves hand off ordinary global and LDS payloads.
// The initial barrier publishes flag initialization; later rounds synchronize
