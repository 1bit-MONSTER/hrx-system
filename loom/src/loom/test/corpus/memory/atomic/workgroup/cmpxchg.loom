// Compare-exchange must distinguish expected from replacement, preserve memory
// on failure, and return the original value in both cases.
kernel.def @workgroup_atomic_cmpxchg() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i32, %replacement: i32, %other: i32, %output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %cell = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %global[%base] : buffer -> view<4xi32>
  view.store %initial, %cell[0] : i32, view<1xi32>
  %success_old = view.atomic.cmpxchg %initial, %replacement, %cell[0] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : i32, view<1xi32> -> i32
  %success_value = view.load %cell[0] : view<1xi32> -> i32
  %failure_old = view.atomic.cmpxchg %initial, %other, %cell[0] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : i32, view<1xi32> -> i32
  %failure_value = view.load %cell[0] : view<1xi32> -> i32
  view.store %success_old, %results[0] : i32, view<4xi32>
  view.store %success_value, %results[1] : i32, view<4xi32>
  view.store %failure_old, %results[2] : i32, view<4xi32>
  view.store %failure_value, %results[3] : i32, view<4xi32>
  kernel.return
}

check.case public @workgroup_atomic_cmpxchg_values {
  %initial = check.literal value(7) : i32
  %replacement = check.literal value(9) : i32
  %other = check.literal value(11) : i32
  %output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @workgroup_atomic_cmpxchg(%initial, %replacement, %other, %output) : (i32, i32, i32, tensor<4xi32>)
  %expected_old = check.generate.fill value(7) : tensor<1xi32>
  %expected_replaced = check.generate.fill value(9) : tensor<3xi32>
  %success_old = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<1xi32>
  %replaced = check.tensor.view %output offset(4) : tensor<4xi32> -> tensor<3xi32>
  check.expect.bitwise actual(%success_old) expected(%expected_old) : tensor<1xi32>
  check.expect.bitwise actual(%replaced) expected(%expected_replaced) : tensor<3xi32>
  check.return
}
