// Each update crosses a 32-bit boundary. The same operations use bounded
// global addresses and generic pointers, retaining both words of old values.
kernel.def @integer_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%global_storage: buffer, %generic_storage: buffer, %output: buffer, %value: i64, %initial: i64) {
  %base = index.constant 8 : offset
  %output_base = index.constant 16 : offset
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %global_whole = buffer.view %global[%base] : buffer -> view<14xi64>
  %generic_whole = buffer.view %generic[%base] : buffer -> view<14xi64>
  %global_view = view.subview %global_whole[1] : view<14xi64> -> view<12xi64>
  %generic_view = view.subview %generic_whole[1] : view<14xi64> -> view<12xi64>
  %results = buffer.view %output[%output_base] : buffer -> view<2x12xi64>
  view.atomic.reduce<addi> %value, %global_view[0] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_addi = view.atomic.rmw<addi> %value, %global_view[0] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_addi, %results[0, 0] : i64, view<2x12xi64>
  view.atomic.reduce<subi> %value, %global_view[1] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_subi = view.atomic.rmw<subi> %value, %global_view[1] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_subi, %results[0, 1] : i64, view<2x12xi64>
  view.atomic.reduce<minsi> %value, %global_view[2] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_minsi = view.atomic.rmw<minsi> %value, %global_view[2] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_minsi, %results[0, 2] : i64, view<2x12xi64>
  view.atomic.reduce<maxsi> %value, %global_view[3] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_maxsi = view.atomic.rmw<maxsi> %value, %global_view[3] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_maxsi, %results[0, 3] : i64, view<2x12xi64>
  view.atomic.reduce<minui> %value, %global_view[4] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_minui = view.atomic.rmw<minui> %value, %global_view[4] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_minui, %results[0, 4] : i64, view<2x12xi64>
  view.atomic.reduce<maxui> %value, %global_view[5] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_maxui = view.atomic.rmw<maxui> %value, %global_view[5] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_maxui, %results[0, 5] : i64, view<2x12xi64>
  view.atomic.reduce<andi> %value, %global_view[6] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_andi = view.atomic.rmw<andi> %value, %global_view[6] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_andi, %results[0, 6] : i64, view<2x12xi64>
  view.atomic.reduce<ori> %value, %global_view[7] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_ori = view.atomic.rmw<ori> %value, %global_view[7] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_ori, %results[0, 7] : i64, view<2x12xi64>
  view.atomic.reduce<xori> %value, %global_view[8] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %global_xori = view.atomic.rmw<xori> %value, %global_view[8] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_xori, %results[0, 8] : i64, view<2x12xi64>
  %global_swap = view.atomic.rmw<xchgi> %value, %global_view[9] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %global_swap, %results[0, 9] : i64, view<2x12xi64>
  %global_cas_10 = view.atomic.cmpxchg %initial, %value, %global_view[10] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<12xi64> -> i64
  view.store %global_cas_10, %results[0, 10] : i64, view<2x12xi64>
  %global_cas_11 = view.atomic.cmpxchg %value, %value, %global_view[11] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<12xi64> -> i64
  view.store %global_cas_11, %results[0, 11] : i64, view<2x12xi64>
  view.atomic.reduce<addi> %value, %generic_view[0] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_addi = view.atomic.rmw<addi> %value, %generic_view[0] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_addi, %results[1, 0] : i64, view<2x12xi64>
  view.atomic.reduce<subi> %value, %generic_view[1] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_subi = view.atomic.rmw<subi> %value, %generic_view[1] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_subi, %results[1, 1] : i64, view<2x12xi64>
  view.atomic.reduce<minsi> %value, %generic_view[2] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_minsi = view.atomic.rmw<minsi> %value, %generic_view[2] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_minsi, %results[1, 2] : i64, view<2x12xi64>
  view.atomic.reduce<maxsi> %value, %generic_view[3] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_maxsi = view.atomic.rmw<maxsi> %value, %generic_view[3] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_maxsi, %results[1, 3] : i64, view<2x12xi64>
  view.atomic.reduce<minui> %value, %generic_view[4] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_minui = view.atomic.rmw<minui> %value, %generic_view[4] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_minui, %results[1, 4] : i64, view<2x12xi64>
  view.atomic.reduce<maxui> %value, %generic_view[5] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_maxui = view.atomic.rmw<maxui> %value, %generic_view[5] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_maxui, %results[1, 5] : i64, view<2x12xi64>
  view.atomic.reduce<andi> %value, %generic_view[6] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_andi = view.atomic.rmw<andi> %value, %generic_view[6] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_andi, %results[1, 6] : i64, view<2x12xi64>
  view.atomic.reduce<ori> %value, %generic_view[7] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_ori = view.atomic.rmw<ori> %value, %generic_view[7] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_ori, %results[1, 7] : i64, view<2x12xi64>
  view.atomic.reduce<xori> %value, %generic_view[8] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %generic_xori = view.atomic.rmw<xori> %value, %generic_view[8] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_xori, %results[1, 8] : i64, view<2x12xi64>
  %generic_swap = view.atomic.rmw<xchgi> %value, %generic_view[9] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %generic_swap, %results[1, 9] : i64, view<2x12xi64>
  %generic_cas_10 = view.atomic.cmpxchg %initial, %value, %generic_view[10] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<12xi64> -> i64
  view.store %generic_cas_10, %results[1, 10] : i64, view<2x12xi64>
  %generic_cas_11 = view.atomic.cmpxchg %value, %value, %generic_view[11] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<12xi64> -> i64
  view.store %generic_cas_11, %results[1, 11] : i64, view<2x12xi64>
  kernel.return
}

// ====
// LDS reductions and returning updates preserve both words, signed ordering,
// and neighboring cells. Each operation starts from the same source value.
kernel.def @workgroup_integer_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %value: i64, %initial: i64) {
  %base = index.constant 0 : offset
  %bytes = index.constant 88 : offset
  %storage = buffer.alloca<workgroup> align(8) %bytes : buffer
  %whole = buffer.view %storage[%base] : buffer -> view<11xi64>
  %cells = view.subview %whole[1] : view<11xi64> -> view<9xi64>
  %results = buffer.view %output[%base] : buffer -> view<20xi64>
  view.store %initial, %whole[0] : i64, view<11xi64>
  view.store %initial, %whole[10] : i64, view<11xi64>
  view.store %initial, %cells[0] : i64, view<9xi64>
  view.atomic.reduce<addi> %value, %cells[0] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %addi_old = view.atomic.rmw<addi> %value, %cells[0] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %addi_final = view.load %cells[0] : view<9xi64> -> i64
  view.store %addi_old, %results[0] : i64, view<20xi64>
  view.store %addi_final, %results[9] : i64, view<20xi64>
  view.store %initial, %cells[1] : i64, view<9xi64>
  view.atomic.reduce<subi> %value, %cells[1] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %subi_old = view.atomic.rmw<subi> %value, %cells[1] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %subi_final = view.load %cells[1] : view<9xi64> -> i64
  view.store %subi_old, %results[1] : i64, view<20xi64>
  view.store %subi_final, %results[10] : i64, view<20xi64>
  view.store %initial, %cells[2] : i64, view<9xi64>
  view.atomic.reduce<minsi> %value, %cells[2] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %minsi_old = view.atomic.rmw<minsi> %value, %cells[2] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %minsi_final = view.load %cells[2] : view<9xi64> -> i64
  view.store %minsi_old, %results[2] : i64, view<20xi64>
  view.store %minsi_final, %results[11] : i64, view<20xi64>
  view.store %initial, %cells[3] : i64, view<9xi64>
  view.atomic.reduce<maxsi> %value, %cells[3] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %maxsi_old = view.atomic.rmw<maxsi> %value, %cells[3] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %maxsi_final = view.load %cells[3] : view<9xi64> -> i64
  view.store %maxsi_old, %results[3] : i64, view<20xi64>
  view.store %maxsi_final, %results[12] : i64, view<20xi64>
  view.store %initial, %cells[4] : i64, view<9xi64>
  view.atomic.reduce<minui> %value, %cells[4] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %minui_old = view.atomic.rmw<minui> %value, %cells[4] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %minui_final = view.load %cells[4] : view<9xi64> -> i64
  view.store %minui_old, %results[4] : i64, view<20xi64>
  view.store %minui_final, %results[13] : i64, view<20xi64>
  view.store %initial, %cells[5] : i64, view<9xi64>
  view.atomic.reduce<maxui> %value, %cells[5] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %maxui_old = view.atomic.rmw<maxui> %value, %cells[5] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %maxui_final = view.load %cells[5] : view<9xi64> -> i64
  view.store %maxui_old, %results[5] : i64, view<20xi64>
  view.store %maxui_final, %results[14] : i64, view<20xi64>
  view.store %initial, %cells[6] : i64, view<9xi64>
  view.atomic.reduce<andi> %value, %cells[6] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %andi_old = view.atomic.rmw<andi> %value, %cells[6] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %andi_final = view.load %cells[6] : view<9xi64> -> i64
  view.store %andi_old, %results[6] : i64, view<20xi64>
  view.store %andi_final, %results[15] : i64, view<20xi64>
  view.store %initial, %cells[7] : i64, view<9xi64>
  view.atomic.reduce<ori> %value, %cells[7] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %ori_old = view.atomic.rmw<ori> %value, %cells[7] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %ori_final = view.load %cells[7] : view<9xi64> -> i64
  view.store %ori_old, %results[7] : i64, view<20xi64>
  view.store %ori_final, %results[16] : i64, view<20xi64>
  view.store %initial, %cells[8] : i64, view<9xi64>
  view.atomic.reduce<xori> %value, %cells[8] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %xori_old = view.atomic.rmw<xori> %value, %cells[8] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %xori_final = view.load %cells[8] : view<9xi64> -> i64
  view.store %xori_old, %results[8] : i64, view<20xi64>
  view.store %xori_final, %results[17] : i64, view<20xi64>
  %before = view.load %whole[0] : view<11xi64> -> i64
  %after = view.load %whole[10] : view<11xi64> -> i64
  view.store %before, %results[18] : i64, view<20xi64>
  view.store %after, %results[19] : i64, view<20xi64>
  kernel.return
}

// Returned values, final memory, and untouched boundary guards are checked
// independently across all three memory spaces.
check.case public @integer_atomic_i64_values {
  %initial = check.literal value(-4294967297) : i64
  %value = check.literal value(4294967299) : i64
  %global = check.generate.fill value(-4294967297) : tensor<16xi64>
  %generic = check.generate.fill value(-4294967297) : tensor<16xi64>
  %output = check.generate.fill value(37) : tensor<28xi64>
  %workgroup_output = check.generate.fill value(37) : tensor<20xi64>
  kernel.launch @workgroup_integer_atomic_i64(%workgroup_output, %value, %initial) : (tensor<20xi64>, i64, i64)
  kernel.launch @integer_atomic_i64(%global, %generic, %output, %value, %initial) : (tensor<16xi64>, tensor<16xi64>, tensor<28xi64>, i64, i64)
  %old_0 = check.generate.fill value(2) : tensor<1xi64>
  %final_0 = check.generate.fill value(4294967301) : tensor<1xi64>
  %workgroup_old_0 = check.tensor.view %workgroup_output offset(0) : tensor<20xi64> -> tensor<1xi64>
  %workgroup_final_0 = check.tensor.view %workgroup_output offset(72) : tensor<20xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%workgroup_old_0) expected(%old_0) : tensor<1xi64>
  check.expect.bitwise actual(%workgroup_final_0) expected(%final_0) : tensor<1xi64>
  %global_old_0 = check.tensor.view %output offset(16) : tensor<28xi64> -> tensor<1xi64>
  %global_final_0 = check.tensor.view %global offset(16) : tensor<16xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%global_old_0) expected(%old_0) : tensor<1xi64>
  check.expect.bitwise actual(%global_final_0) expected(%final_0) : tensor<1xi64>
  %generic_old_0 = check.tensor.view %output offset(112) : tensor<28xi64> -> tensor<1xi64>
  %generic_final_0 = check.tensor.view %generic offset(16) : tensor<16xi64> -> tensor<1xi64>
