// Input and output subnormals must survive the arithmetic path. Returned old
// values remain bit-exact independently of the addition result.
kernel.def @global_atomic_add_f32_subnormal() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%increment_bits: i32, %accumulator: buffer, %old_value: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %accumulator : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %old_global = buffer.assume.memory_space<global> %old_value : buffer
  %old_view = buffer.view %old_global[%base] : buffer -> view<1xi32>
  %increment = scalar.bitcast %increment_bits : i32 to f32
  %old = view.atomic.rmw<addf, noftz> %increment, %view[0] {ordering = relaxed, scope = device} : f32, view<2xf32> -> f32
  view.atomic.reduce<addf, noftz> %increment, %view[1] {ordering = relaxed, scope = device} : f32, view<2xf32>
  %old_bits = scalar.bitcast %old : f32 to i32
  view.store %old_bits, %old_view[0] : i32, view<1xi32>
  kernel.return
}

check.case public @global_atomic_add_f32_subnormal_values {
  %accumulator = check.generate.fill value(1) : tensor<2xi32>
  %old_value = check.generate.fill value(0) : tensor<1xi32>
  %increment = check.literal value(2) : i32
  kernel.launch @global_atomic_add_f32_subnormal(%increment, %accumulator, %old_value) : (i32, tensor<2xi32>, tensor<1xi32>)
  %expected = check.generate.fill value(3) : tensor<2xi32>
  %expected_old = check.generate.fill value(1) : tensor<1xi32>
  check.expect.bitwise actual(%accumulator) expected(%expected) : tensor<2xi32>
  check.expect.bitwise actual(%old_value) expected(%expected_old) : tensor<1xi32>
  check.return
}

// Workgroup aliases share an integer carrier when explicit preservation selects
// a CAS loop. Masked lanes retain their old value without issuing an update.
kernel.def @workgroup_atomic_add_f32_subnormal() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial_bits: i32, %increment_bits: i32, %flag: i32, %output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<2xf32>
  %alias = buffer.view %scratch[%base] : buffer -> view<2xf32>
  %results = buffer.view %output[%base] : buffer -> view<4xf32>
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %increment = scalar.bitcast %increment_bits : i32 to f32
  %initials = vector.from_elements %initial, %initial : vector<2xf32>
  %increments = vector.from_elements %increment, %increment : vector<2xf32>
  vector.store %initials, %view[0] : vector<2xf32>, view<2xf32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  vector.atomic.reduce<addf, noftz> %increments, %view[0][%offsets] {ordering = relaxed, scope = workgroup} : vector<2xf32>, view<2xf32>, vector<2xindex>
  %old = vector.atomic.rmw.mask<addf, noftz> %increments, %alias[0][%offsets], %mask, %initials {ordering = relaxed, scope = workgroup} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  %final = vector.load %view[0] : view<2xf32> -> vector<2xf32>
  vector.store %old, %results[0] : vector<2xf32>, view<4xf32>
  vector.store %final, %results[2] : vector<2xf32>, view<4xf32>
  kernel.return
}

check.case public @workgroup_atomic_add_f32_subnormal_values {
  %initial = check.literal value(1) : i32
  %increment = check.literal value(2) : i32
  %flag = check.literal value(1) : i32
  %output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @workgroup_atomic_add_f32_subnormal(%initial, %increment, %flag, %output) : (i32, i32, i32, tensor<4xi32>)
  %old = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<2xi32>
  %final = check.tensor.view %output offset(8) : tensor<4xi32> -> tensor<2xi32>
  %expected_old = check.generate.iota offset(3) step(-2) : tensor<2xi32>
  %expected_final = check.generate.iota offset(5) step(-2) : tensor<2xi32>
  check.expect.bitwise actual(%old) expected(%expected_old) : tensor<2xi32>
  check.expect.bitwise actual(%final) expected(%expected_final) : tensor<2xi32>
  check.return
}
