func.def public @atomic_storage(%initial: i32) -> (buffer) {
  %length = index.constant 64 : offset
  %start = index.constant 0 : offset
  %storage = buffer.alloca<private> align(8) %length : buffer
  buffer.fill %initial, %storage[%start], %length : i32
  func.return %storage : buffer
}

// The nonzero base and varying index exercise the retained view address plan.
// Returning old values also distinguishes failed and successful exchanges.
func.def public @atomic_i32(%storage: buffer, %position: i64, %increment: i32, %replacement: i32) -> (i32, i32, i32, i32, i32) {
  %base = index.constant 8 : offset
  %index_input = index.cast %position : i64 to index
  %index = index.assume %index_input [range(%index_input, 0, 7)] : index
  %view = buffer.view %storage[%base] : buffer -> view<8xi32>
  view.atomic.reduce<addi> %increment, %view[%index] {ordering = release, scope = system} : i32, view<8xi32>
  %old = view.atomic.rmw<addi> %increment, %view[%index] {ordering = acquire, scope = device} : i32, view<8xi32> -> i32
  %wrong = scalar.constant -935 : i32
  %failed = view.atomic.cmpxchg %wrong, %replacement, %view[%index] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i32, view<8xi32> -> i32
  %expected = scalar.addi %old, %increment : i32
  %succeeded = view.atomic.cmpxchg %expected, %replacement, %view[%index] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : i32, view<8xi32> -> i32
  %final = view.load %view[%index] : view<8xi32> -> i32
  %head_offset = index.constant 0 : offset
  %head = buffer.view %storage[%head_offset] : buffer -> view<1xi32>
  %untouched = view.load %head[0] : view<1xi32> -> i32
  func.return %old, %failed, %succeeded, %final, %untouched : i32, i32, i32, i32, i32
}

check.case @atomic_i32_case {
  %initial = check.literal value(7) : i32
  %storage = func.call @atomic_storage(%initial) : (i32) -> (buffer)
  %position = check.param.choice values([0, 2, 7]) : i64
  %increment = check.literal value(3) : i32
  %replacement = check.literal value(123) : i32
  %old, %failed, %succeeded, %final, %untouched = func.call @atomic_i32(%storage, %position, %increment, %replacement) : (buffer, i64, i32, i32) -> (i32, i32, i32, i32, i32)
  %expected_old = check.literal value(10) : i32
  %expected_exchanged = check.literal value(13) : i32
  check.expect.equal actual(%old) expected(%expected_old) : i32
  check.expect.equal actual(%failed) expected(%expected_exchanged) : i32
  check.expect.equal actual(%succeeded) expected(%expected_exchanged) : i32
  check.expect.equal actual(%final) expected(%replacement) : i32
  check.expect.equal actual(%untouched) expected(%initial) : i32
  check.return
}

// High halves are nonzero so truncating an atomic to i32 cannot pass.
func.def public @atomic_i64(%storage: buffer, %position: i64, %initial: i64, %increment: i64, %replacement: i64) -> (i64, i64, i64) {
  %base = index.constant 0 : offset
  %index_input = index.cast %position : i64 to index
  %index = index.assume %index_input [range(%index_input, 0, 5)] : index
  %whole = buffer.view %storage[%base] : buffer -> view<8xi64>
  %view = view.subview %whole[1] : view<8xi64> -> view<6xi64>
  view.store %initial, %view[%index] : i64, view<6xi64>
  view.atomic.reduce<addi> %increment, %view[%index] {ordering = relaxed, scope = thread} : i64, view<6xi64>
  %old = view.atomic.rmw<addi> %increment, %view[%index] {ordering = acq_rel, scope = system} : i64, view<6xi64> -> i64
  %expected = scalar.addi %old, %increment : i64
  %exchanged = view.atomic.cmpxchg %expected, %replacement, %view[%index] {failure_ordering = relaxed, scope = device, success_ordering = release} : i64, view<6xi64> -> i64
  %final = view.load %view[%index] : view<6xi64> -> i64
  func.return %old, %exchanged, %final : i64, i64, i64
}

check.case @atomic_i64_case {
  %zero = check.literal value(0) : i32
  %storage = func.call @atomic_storage(%zero) : (i32) -> (buffer)
  %position = check.param.choice values([0, 2, 5]) : i64
  %initial = check.literal value(4294967303) : i64
  %increment = check.literal value(4294967299) : i64
  %replacement = check.literal value(-4294967321) : i64
  %old, %exchanged, %final = func.call @atomic_i64(%storage, %position, %initial, %increment, %replacement) : (buffer, i64, i64, i64, i64) -> (i64, i64, i64)
  %expected_old = check.literal value(8589934602) : i64
  %expected_exchanged = check.literal value(12884901901) : i64
  check.expect.equal actual(%old) expected(%expected_old) : i64
  check.expect.equal actual(%exchanged) expected(%expected_exchanged) : i64
  check.expect.equal actual(%final) expected(%replacement) : i64
  check.return
}

func.def public @atomic_f32(%storage: buffer, %initial: f32, %increment: f32, %replacement: f32) -> (f32, f32, f32) {
  %base = index.constant 12 : offset
  %view = buffer.view %storage[%base] : buffer -> view<1xf32>
  view.store %initial, %view[0] : f32, view<1xf32>
  view.atomic.reduce<addf> %increment, %view[0] {ordering = relaxed, scope = device} : f32, view<1xf32>
  %old = view.atomic.rmw<addf> %increment, %view[0] {ordering = seq_cst, scope = system} : f32, view<1xf32> -> f32
  %expected = scalar.addf %old, %increment : f32
  %exchanged = view.atomic.cmpxchg %expected, %replacement, %view[0] {failure_ordering = acquire, scope = device, success_ordering = acquire} : f32, view<1xf32> -> f32
  %final = view.load %view[0] : view<1xf32> -> f32
  func.return %old, %exchanged, %final : f32, f32, f32
}

check.case @atomic_f32_case {
  %zero = check.literal value(0) : i32
  %storage = func.call @atomic_storage(%zero) : (i32) -> (buffer)
  %initial = check.literal value(1.25) : f32
  %increment = check.literal value(0.5) : f32
  %replacement = check.literal value(-9.5) : f32
  %old, %exchanged, %final = func.call @atomic_f32(%storage, %initial, %increment, %replacement) : (buffer, f32, f32, f32) -> (f32, f32, f32)
  %expected_old = check.literal value(1.75) : f32
  %expected_exchanged = check.literal value(2.25) : f32
  check.expect.equal actual(%old) expected(%expected_old) : f32
  check.expect.equal actual(%exchanged) expected(%expected_exchanged) : f32
  check.expect.equal actual(%final) expected(%replacement) : f32
  check.return
}

// f64 additions retain low mantissa bits that would be lost through f32.
func.def public @atomic_f64(%storage: buffer, %initial: f64, %increment: f64, %replacement: f64) -> (f64, f64, f64) {
  %base = index.constant 16 : offset
  %view = buffer.view %storage[%base] : buffer -> view<1xf64>
  view.store %initial, %view[0] : f64, view<1xf64>
  view.atomic.reduce<addf> %increment, %view[0] {ordering = seq_cst, scope = system} : f64, view<1xf64>
  %old = view.atomic.rmw<addf> %increment, %view[0] {ordering = relaxed, scope = thread} : f64, view<1xf64> -> f64
  %expected = scalar.addf %old, %increment : f64
  %exchanged = view.atomic.cmpxchg %expected, %replacement, %view[0] {failure_ordering = relaxed, scope = thread, success_ordering = relaxed} : f64, view<1xf64> -> f64
  %final = view.load %view[0] : view<1xf64> -> f64
  func.return %old, %exchanged, %final : f64, f64, f64
}

check.case @atomic_f64_case {
  %zero = check.literal value(0) : i32
  %storage = func.call @atomic_storage(%zero) : (i32) -> (buffer)
  %initial = check.literal value(4294967296.25) : f64
  %increment = check.literal value(0.5) : f64
  %replacement = check.literal value(-4294967296.75) : f64
  %old, %exchanged, %final = func.call @atomic_f64(%storage, %initial, %increment, %replacement) : (buffer, f64, f64, f64) -> (f64, f64, f64)
  %expected_old = check.literal value(4294967296.75) : f64
  %expected_exchanged = check.literal value(4294967297.25) : f64
  check.expect.equal actual(%old) expected(%expected_old) : f64
  check.expect.equal actual(%exchanged) expected(%expected_exchanged) : f64
  check.expect.equal actual(%final) expected(%replacement) : f64
  check.return
}

// Compare-exchange uses payload equality, not floating-point comparison:
// equal NaN bits match, while opposite signed zeros do not.
func.def public @atomic_float_bits(%storage: buffer, %initial_bits: i32, %expected_bits: i32, %replacement_bits: i32) -> (i32, i32) {
  %base = index.constant 0 : offset
  %view = buffer.view %storage[%base] : buffer -> view<1xf32>
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %expected = scalar.bitcast %expected_bits : i32 to f32
  %replacement = scalar.bitcast %replacement_bits : i32 to f32
  view.store %initial, %view[0] : f32, view<1xf32>
  %old = view.atomic.cmpxchg %expected, %replacement, %view[0] {failure_ordering = relaxed, scope = thread, success_ordering = relaxed} : f32, view<1xf32> -> f32
  %final = view.load %view[0] : view<1xf32> -> f32
  %old_bits = scalar.bitcast %old : f32 to i32
  %final_bits = scalar.bitcast %final : f32 to i32
  func.return %old_bits, %final_bits : i32, i32
}

check.case @atomic_float_equal_payload {
  %zero = check.literal value(0) : i32
  %storage = func.call @atomic_storage(%zero) : (i32) -> (buffer)
  %initial = check.param.choice values([0, -2147483648, 2143289345, 2139095041]) : i32
  %replacement = check.literal value(1065353216) : i32
  %old, %final = func.call @atomic_float_bits(%storage, %initial, %initial, %replacement) : (buffer, i32, i32, i32) -> (i32, i32)
  check.expect.equal actual(%old) expected(%initial) : i32
  check.expect.equal actual(%final) expected(%replacement) : i32
  check.return
}

check.case @atomic_float_distinct_payload {
  %zero = check.literal value(0) : i32
  %storage = func.call @atomic_storage(%zero) : (i32) -> (buffer)
  %initial = check.literal value(0) : i32
  %expected = check.literal value(-2147483648) : i32
  %replacement = check.literal value(1065353216) : i32
  %old, %final = func.call @atomic_float_bits(%storage, %initial, %expected, %replacement) : (buffer, i32, i32, i32) -> (i32, i32)
  check.expect.equal actual(%old) expected(%initial) : i32
  check.expect.equal actual(%final) expected(%initial) : i32
  check.return
}
