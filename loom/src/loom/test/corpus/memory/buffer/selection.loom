// A selected reference retains the ordinary buffer result ABI.
func.def @choose_buffer(%first: buffer, %second: buffer, %choose_first: i1) -> (buffer) {
  %selected = scf.select %choose_first, %first, %second : buffer
  func.return %selected : buffer
}

// A selected reference remains a buffer for both reads and writes.
func.def @exchange_selected_byte(%first: buffer, %second: buffer, %choose_first: i1, %position_input: offset, %replacement: i32) -> (i32) {
  %position = index.assume %position_input [range(%position_input, 0, 1024)] : offset
  %selected = scf.select %choose_first, %first, %second : buffer
  %previous = buffer.load.i8.u %selected[%position]
  buffer.store.i8 %replacement, %selected[%position]
  func.return %previous : i32
}

// Canonicalization may select the components independently, but both selections
// retain the same condition and therefore the same complete coordinate.
func.def @selected_buffer_coordinate(%first: buffer, %second: buffer, %first_origin_input: offset, %second_origin_input: offset, %choose_first: i1) -> (i32) {
  %first_origin = index.assume %first_origin_input [range(%first_origin_input, 0, 1024)] : offset
  %second_origin = index.assume %second_origin_input [range(%second_origin_input, 0, 1024)] : offset
  %selected, %origin = scf.if %choose_first -> (buffer, offset) {
    scf.yield %first, %first_origin : buffer, offset
  } else {
    scf.yield %second, %second_origin : buffer, offset
  }
  %value = buffer.load.i8.u %selected[%origin]
  func.return %value : i32
}

// Rotating a reference and its origin carries both values over the same edge.
func.def @rotate_buffer_coordinates(%first: buffer, %second: buffer, %first_origin_input: offset, %second_origin_input: offset, %count: index) -> (i32) {
  %first_origin = index.assume %first_origin_input [range(%first_origin_input, 0, 1024)] : offset
  %second_origin = index.assume %second_origin_input [range(%second_origin_input, 0, 1024)] : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %selected, %origin, %unused_buffer, %unused_origin = scf.for %i = [%begin to %count step %step](%current = %first : buffer, %current_origin = %first_origin : offset, %other = %second : buffer, %other_origin = %second_origin : offset) -> (buffer, offset, buffer, offset) {
    scf.yield %other, %other_origin, %current, %current_origin : buffer, offset, buffer, offset
  }
  %value = buffer.load.i8.u %selected[%origin]
  func.return %value : i32
}

// Each ordinal selects one allocation, mutates one byte, reads independently
// selected coordinates, and rotates a complete buffer/origin pair.
func.def @buffer_selection_observations(%ordinal: index, %first: buffer, %second: buffer, %output: buffer) {
  %c0 = index.constant 0 : offset
  %c8 = index.constant 8 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %position_index = index.rem %bounded_ordinal, %c128 : index
  %position = index.cast %position_index : index to offset
  %choose_first = index.cmp uge, %bounded_ordinal, %c128 : index
  %position_word = index.cast %position_index : index to i32
  %replacement_bias = scalar.constant 101 : i32
  %replacement = scalar.addi %position_word, %replacement_bias : i32

  %selected = func.call @choose_buffer(%first, %second, %choose_first) : (buffer, buffer, i1) -> (buffer)
  %previous = func.call @exchange_selected_byte(%first, %second, %choose_first, %position, %replacement) : (buffer, buffer, i1, offset, i32) -> (i32)
  %selected_value = buffer.load.i8.u %selected[%position]
  %second_origin_index = index.sub %c127, %position_index : index
  %second_origin = index.cast %second_origin_index : index to offset
  %coordinate = func.call @selected_buffer_coordinate(%first, %second, %position, %second_origin, %choose_first) : (buffer, buffer, offset, offset, i1) -> (i32)
  %rotation_count = index.rem %bounded_ordinal, %c8 : index
  %rotated = func.call @rotate_buffer_coordinates(%first, %second, %position, %second_origin, %rotation_count) : (buffer, buffer, offset, offset, index) -> (i32)

  %results = buffer.view %output[%c0] : buffer -> view<5xi32>
  view.store %previous, %results[0] : i32, view<5xi32>
  view.store %selected_value, %results[1] : i32, view<5xi32>
  view.store %coordinate, %results[2] : i32, view<5xi32>
  view.store %rotated, %results[3] : i32, view<5xi32>
  view.store %replacement, %results[4] : i32, view<5xi32>
  func.return
}

check.scenario @buffer_selection_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %first_storage = check.generate.fill value(17) : tensor<136xi8>
    %second_storage = check.generate.fill value(93) : tensor<136xi8>
    %first = check.tensor.view %first_storage offset(4) : tensor<136xi8> -> tensor<128xi8>
    %second = check.tensor.view %second_storage offset(4) : tensor<136xi8> -> tensor<128xi8>
    %first_prefix = check.tensor.view %first_storage offset(0) : tensor<136xi8> -> tensor<4xi8>
    %first_suffix = check.tensor.view %first_storage offset(132) : tensor<136xi8> -> tensor<4xi8>
    %second_prefix = check.tensor.view %second_storage offset(0) : tensor<136xi8> -> tensor<4xi8>
    %second_suffix = check.tensor.view %second_storage offset(132) : tensor<136xi8> -> tensor<4xi8>
    %first_guard = check.generate.fill value(17) : tensor<4xi8>
    %second_guard = check.generate.fill value(93) : tensor<4xi8>
    %output = check.generate.fill value(-1) : tensor<5xi32>
    check.compare<@buffer_selection_observations>(%trial, %first, %second, %output) : (index, tensor<128xi8>, tensor<128xi8>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%first_storage) expected(%first_storage) : tensor<136xi8>
      check.expect.bitwise actual(%second_storage) expected(%second_storage) : tensor<136xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
      check.expect.bitwise actual(%first_prefix) expected(%first_guard) : tensor<4xi8>
      check.expect.bitwise actual(%first_suffix) expected(%first_guard) : tensor<4xi8>
      check.expect.bitwise actual(%second_prefix) expected(%second_guard) : tensor<4xi8>
      check.expect.bitwise actual(%second_suffix) expected(%second_guard) : tensor<4xi8>
    }
  }
  check.return
}
