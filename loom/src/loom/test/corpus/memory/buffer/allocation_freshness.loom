// Callee entry buffers remain independent of scratch created by that callee,
// even when the caller supplies another local allocation.
func.def noinline @read_entry_with_scratch(%input: buffer, %replacement: i32) -> (i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %iteration = [%begin to %end step %step](%previous = %initial : i32) -> (i32) {
    %value = view.load %input_view[0] : view<1xi32> -> i32
    view.store %replacement, %scratch_view[0] : i32, view<1xi32>
    scf.yield %value : i32
  }
  func.return %result : i32
}

// Derived aliases of a local allocation observe writes to that allocation.
// Two iterations distinguish the updated value from an incorrectly hoisted load.
func.def noinline @read_scratch_alias(%replacement: i32) -> (i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %initial = scalar.constant 17 : i32
  view.store %initial, %scratch_view[0] : i32, view<1xi32>
  %part = view.subview %scratch_view[0] : view<1xi32> -> view<1xi32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %end step %step](%previous = %initial : i32) -> (i32) {
    %value = view.load %part[0] : view<1xi32> -> i32
    view.store %replacement, %scratch_view[0] : i32, view<1xi32>
    scf.yield %value : i32
  }
  func.return %result : i32
}

// Selecting an entry view or a local-allocation view preserves both the
// materializing buffer and its root-relative offset. Two iterations distinguish
// the local choice by observing the previous iteration's write.
func.def noinline @read_selected_with_scratch(%input: buffer, %use_input: i1, %replacement: i32) -> (i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %initial = scalar.constant 17 : i32
  view.store %initial, %scratch_view[0] : i32, view<1xi32>
  %selected = scf.select %use_input, %input_view, %scratch_view : view<1xi32>
  %part = view.subview %selected[0] : view<1xi32> -> view<1xi32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %end step %step](%previous = %initial : i32) -> (i32) {
    %value = view.load %part[0] : view<1xi32> -> i32
    view.store %replacement, %scratch_view[0] : i32, view<1xi32>
    scf.yield %value : i32
  }
  func.return %result : i32
}

func.def @allocation_aliases(%initial: i32, %replacement: i32) -> (i32, i32, i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %input = buffer.alloca<private> align(4) %bytes : buffer
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  view.store %initial, %view[0] : i32, view<1xi32>
  %entry = func.call @read_entry_with_scratch(%input, %replacement) : (buffer, i32) -> (i32)
  %aliased = func.call @read_scratch_alias(%replacement) : (i32) -> (i32)
  %after = view.load %view[0] : view<1xi32> -> i32
  func.return %entry, %aliased, %after : i32, i32, i32
}

func.def @allocation_selection(%initial: i32, %replacement: i32, %use_input: i1) -> (i32, i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %input = buffer.alloca<private> align(4) %bytes : buffer
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  view.store %initial, %view[0] : i32, view<1xi32>
  %selected = func.call @read_selected_with_scratch(%input, %use_input, %replacement) : (buffer, i1, i32) -> (i32)
  %after = view.load %view[0] : view<1xi32> -> i32
  func.return %selected, %after : i32, i32
}

func.def @allocation_freshness_observations(%initial_entropy: i64, %replacement_entropy: i64, %ordinal: index, %output: buffer) {
  %initial = scalar.trunci %initial_entropy : i64 to i32
  %replacement = scalar.trunci %replacement_entropy : i64 to i32
  %c0 = index.constant 0 : index
  %use_input = index.cmp ne, %ordinal, %c0 : index
  %entry, %aliased, %alias_after = func.call @allocation_aliases(%initial, %replacement) : (i32, i32) -> (i32, i32, i32)
  %selected, %selection_after = func.call @allocation_selection(%initial, %replacement, %use_input) : (i32, i32, i1) -> (i32, i32)
  %values = vector.from_elements %entry, %aliased, %alias_after, %selected, %selection_after : vector<5xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<5xi32>
  vector.store %values, %results[0] : vector<5xi32>, view<5xi32>
  func.return
}

check.scenario @allocation_freshness_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %initial_source = check.entropy.fork %entropy name("initial") : check.entropy
    %replacement_source = check.entropy.fork %entropy name("replacement") : check.entropy
    %initial = check.entropy.read %initial_source[%trial] : check.entropy -> i64
    %replacement = check.entropy.read %replacement_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<5xi32>
    check.compare<@allocation_freshness_observations>(%initial, %replacement, %trial, %output) : (i64, i64, index, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  check.return
}
