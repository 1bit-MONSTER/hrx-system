// A partial pattern repeats its little-endian bytes. Adjacent canaries and
// independent byte observations detect both overrun and wrong tail handling.
// Copying disjoint ranges of one root is legal; overlapping ranges are not.
func.def public @partial_pattern_copy(%pattern: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %c2 = index.constant 2 : offset
  %c3 = index.constant 3 : offset
  %c5 = index.constant 5 : offset
  %c6 = index.constant 6 : offset
  %c10 = index.constant 10 : offset
  %c11 = index.constant 11 : offset
  %length = index.constant 12 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %canary = scalar.constant 85 : i8
  buffer.fill %canary, %storage[%c0], %length : i8
  buffer.fill %pattern, %storage[%c0], %c5 : i32
  %byte0 = buffer.load.i8.u %storage[%c0]
  %byte1 = buffer.load.i8.u %storage[%c1]
  %byte2 = buffer.load.i8.u %storage[%c2]
  %byte3 = buffer.load.i8.u %storage[%c3]
  buffer.copy %storage[%c0], %storage[%c6], %c5
  %replacement = scalar.constant 0 : i32
  buffer.store.i8 %replacement, %storage[%c0]
  %copied_first = buffer.load.i8.u %storage[%c6]
  %copied_last = buffer.load.i8.u %storage[%c10]
  %middle_canary = buffer.load.i8.u %storage[%c5]
  %last_canary = buffer.load.i8.u %storage[%c11]
  func.return %byte0, %byte1, %byte2, %byte3, %copied_first, %copied_last, %middle_canary, %last_canary : i32, i32, i32, i32, i32, i32, i32, i32
}

check.case @partial_pattern_copy_case {
  // 0x12345678 repeats as 78 56 34 12 78, followed by an untouched 55.
  %pattern = check.literal value(305419896) : i32
  %byte0, %byte1, %byte2, %byte3, %copied_first, %copied_last, %middle_canary, %last_canary = func.call @partial_pattern_copy(%pattern) : (i32) -> (i32, i32, i32, i32, i32, i32, i32, i32)
  %expected0 = check.literal value(120) : i32
  %expected1 = check.literal value(86) : i32
  %expected2 = check.literal value(52) : i32
  %expected3 = check.literal value(18) : i32
  %canary = check.literal value(85) : i32
  check.expect.equal actual(%byte0) expected(%expected0) : i32
  check.expect.equal actual(%byte1) expected(%expected1) : i32
  check.expect.equal actual(%byte2) expected(%expected2) : i32
  check.expect.equal actual(%byte3) expected(%expected3) : i32
  check.expect.equal actual(%copied_first) expected(%expected0) : i32
  check.expect.equal actual(%copied_last) expected(%expected0) : i32
  check.expect.equal actual(%middle_canary) expected(%canary) : i32
  check.expect.equal actual(%last_canary) expected(%canary) : i32
  check.return
}

// Only the final byte differs. Lexicographic order is unsigned and canonical,
// while signed and unsigned interpretations retain their distinct meanings.
func.def public @last_byte_order(%a: i32, %b: i32) -> (i32, i32, i32, i32) {
  %c0 = index.constant 0 : offset
  %last = index.constant 4 : offset
  %length = index.constant 5 : offset
  %left = buffer.alloca<private> align(1) %length : buffer
  %right = buffer.alloca<private> align(1) %length : buffer
  %prefix = scalar.constant 42 : i8
  buffer.fill %prefix, %left[%c0], %length : i8
  buffer.fill %prefix, %right[%c0], %length : i8
  buffer.store.i8 %a, %left[%last]
  buffer.store.i8 %b, %right[%last]
  %forward = buffer.compare %left[%c0], %right[%c0], %length
  %reverse = buffer.compare %right[%c0], %left[%c0], %length
  %unsigned = buffer.load.i8.u %left[%last]
  %narrow = scalar.trunci %unsigned : i32 to i8
  %signed = scalar.extsi %narrow : i8 to i32
  func.return %forward, %reverse, %signed, %unsigned : i32, i32, i32, i32
}

check.case @last_byte_order_unsigned {
  %a = check.param.choice values([255, 511, -1]) : i32
  %b = check.literal value(127) : i32
  %forward, %reverse, %signed, %unsigned = func.call @last_byte_order(%a, %b) : (i32, i32) -> (i32, i32, i32, i32)
  %less = check.literal value(-1) : i32
  %greater = check.literal value(1) : i32
  %maximum_byte = check.literal value(255) : i32
  check.expect.equal actual(%forward) expected(%greater) : i32
  check.expect.equal actual(%reverse) expected(%less) : i32
  check.expect.equal actual(%signed) expected(%less) : i32
  check.expect.equal actual(%unsigned) expected(%maximum_byte) : i32
  check.return
}

// The invalid address belongs to a non-taken branch and must never be read.
func.def public @guarded_byte_load(%position: i64) -> (i32) {
  %c0 = index.constant 0 : offset
  %length = index.constant 1 : offset
  %storage = buffer.alloca<private> align(1) %length : buffer
  %payload = scalar.constant 55 : i32
  buffer.store.i8 %payload, %storage[%c0]
  %limit = scalar.constant 1 : i64
  %in_bounds = scalar.cmpi ult, %position, %limit : i64
  %result = scf.if %in_bounds -> (i32) {
    %offset = index.cast %position : i64 to offset
    %byte = buffer.load.i8.u %storage[%offset]
    scf.yield %byte : i32
  } else {
    %other = scalar.constant 77 : i32
    scf.yield %other : i32
  }
  func.return %result : i32
}

check.case @guarded_byte_load_valid {
  %position = check.literal value(0) : i64
  %result = func.call @guarded_byte_load(%position) : (i64) -> (i32)
  %expected = check.literal value(55) : i32
  check.expect.equal actual(%result) expected(%expected) : i32
  check.return
}

check.case @guarded_byte_load_not_taken {
  %position = check.param.choice values([1, 16, 4294967296, -1]) : i64
  %result = func.call @guarded_byte_load(%position) : (i64) -> (i32)
  %expected = check.literal value(77) : i32
  check.expect.equal actual(%result) expected(%expected) : i32
  check.return
}

// Combining these reads must preserve their snapshot before the overlapping
// overwrite. Observing raw bits covers signed zero, subnormals and NaN payloads.
func.def public @adjacent_half_snapshot(%left_bits: i32, %right_bits: i32, %overwrite: i32) -> (i32, i32, i32) {
  %byte_base = index.constant 0 : offset
  %length = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %integer_view = buffer.view %storage[%byte_base] : buffer -> view<2xi16>
  %left_value = scalar.trunci %left_bits : i32 to i16
  %right_value = scalar.trunci %right_bits : i32 to i16
  view.store %left_value, %integer_view[0] : i16, view<2xi16>
  view.store %right_value, %integer_view[1] : i16, view<2xi16>
  %view = buffer.view %storage[%byte_base] : buffer -> view<2xf16>
  %wide_view = buffer.view %storage[%byte_base] : buffer -> view<1xi32>
  %left = view.load %view[0] : view<2xf16> -> f16
  %right = view.load %view[1] : view<2xf16> -> f16
  view.store %overwrite, %wide_view[0] : i32, view<1xi32>
  %left_raw = scalar.bitcast %left : f16 to i16
  %right_raw = scalar.bitcast %right : f16 to i16
  %left_result = scalar.extui %left_raw : i16 to i32
  %right_result = scalar.extui %right_raw : i16 to i32
  %after = view.load %wide_view[0] : view<1xi32> -> i32
  func.return %left_result, %right_result, %after : i32, i32, i32
}

check.case @adjacent_half_snapshot_bits {
  %left_bits = check.param.choice values([0, 32768, 1, 31745, 32257, 65535]) : i32
  %right_bits = check.param.choice values([15360, 64512]) : i32
  %overwrite = check.literal value(305419896) : i32
  %left, %right, %after = func.call @adjacent_half_snapshot(%left_bits, %right_bits, %overwrite) : (i32, i32, i32) -> (i32, i32, i32)
  check.expect.equal actual(%left) expected(%left_bits) : i32
  check.expect.equal actual(%right) expected(%right_bits) : i32
  check.expect.equal actual(%after) expected(%overwrite) : i32
  check.return
}

func.def public @vector_input_buffer(%a: i32, %b: i32, %c: i32, %d: i32) -> (buffer) {
  %length = index.constant 24 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %sentinel = scalar.constant 12345 : i32
  view.store %sentinel, %view[0] : i32, view<6xi32>
  view.store %a, %view[1] : i32, view<6xi32>
  view.store %b, %view[2] : i32, view<6xi32>
  view.store %c, %view[3] : i32, view<6xi32>
  view.store %d, %view[4] : i32, view<6xi32>
  view.store %sentinel, %view[5] : i32, view<6xi32>
  func.return %storage : buffer
}

// Loads skip the leading canary. Unequal lanes distinguish concat/shuffle order;
// stores overwrite exactly the middle four words, preserving both canaries.
func.def public @vector_memory_transform(%storage: buffer, %bias: i32) -> (i32, i32, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %loaded = vector.load %view[1] : view<6xi32> -> vector<4xi32>
  %reverse = vector.shuffle<[3, 2, 1, 0]> %loaded : vector<4xi32>
  %head = vector.slice %reverse[0] : vector<4xi32> -> vector<2xi32>
  %tail = vector.slice %reverse[2] : vector<4xi32> -> vector<2xi32>
  %rotated = vector.concat<0> %tail, %head : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %biases = vector.splat %bias : vector<4xi32>
  %result = vector.addi %rotated, %biases : vector<4xi32>
  vector.store %result, %view[1] : vector<4xi32>, view<6xi32>
  %before = view.load %view[0] : view<6xi32> -> i32
  %r0 = view.load %view[1] : view<6xi32> -> i32
  %r1 = view.load %view[2] : view<6xi32> -> i32
  %r2 = view.load %view[3] : view<6xi32> -> i32
  %r3 = view.load %view[4] : view<6xi32> -> i32
  %after = view.load %view[5] : view<6xi32> -> i32
  func.return %before, %r0, %r1, %r2, %r3, %after : i32, i32, i32, i32, i32, i32
}

check.case @vector_memory_transform_case {
  %a = check.literal value(-7) : i32
  %b = check.literal value(11) : i32
  %c = check.literal value(23) : i32
  %d = check.literal value(-29) : i32
  %storage = func.call @vector_input_buffer(%a, %b, %c, %d) : (i32, i32, i32, i32) -> (buffer)
  %bias = check.literal value(3) : i32
  %before, %r0, %r1, %r2, %r3, %after = func.call @vector_memory_transform(%storage, %bias) : (buffer, i32) -> (i32, i32, i32, i32, i32, i32)
  %sentinel = check.literal value(12345) : i32
  %e0 = check.literal value(14) : i32
  %e1 = check.literal value(-4) : i32
  %e2 = check.literal value(-26) : i32
  %e3 = check.literal value(26) : i32
  check.expect.equal actual(%before) expected(%sentinel) : i32
  check.expect.equal actual(%r0) expected(%e0) : i32
  check.expect.equal actual(%r1) expected(%e1) : i32
  check.expect.equal actual(%r2) expected(%e2) : i32
  check.expect.equal actual(%r3) expected(%e3) : i32
  check.expect.equal actual(%after) expected(%sentinel) : i32
  check.return
}

// The scalar write happens after the vector snapshot and cannot change it.
func.def public @vector_snapshot_before_write(%storage: buffer, %replacement: i32) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %loaded = vector.load %view[1] : view<6xi32> -> vector<2xi32>
  view.store %replacement, %view[2] : i32, view<6xi32>
  %swapped = vector.shuffle<[1, 0]> %loaded : vector<2xi32>
  vector.store %swapped, %view[1] : vector<2xi32>, view<6xi32>
  %a = view.load %view[1] : view<6xi32> -> i32
  %b = view.load %view[2] : view<6xi32> -> i32
  func.return %a, %b : i32, i32
}

check.case @vector_snapshot_before_write_case {
  %a = check.literal value(-7) : i32
  %b = check.literal value(11) : i32
  %storage = func.call @vector_input_buffer(%a, %b, %a, %b) : (i32, i32, i32, i32) -> (buffer)
  %replacement = check.literal value(99) : i32
  %r0, %r1 = func.call @vector_snapshot_before_write(%storage, %replacement) : (buffer, i32) -> (i32, i32)
  check.expect.equal actual(%r0) expected(%b) : i32
  check.expect.equal actual(%r1) expected(%a) : i32
  check.return
}

// Writing the first payload must not change the second lane's captured mask.
func.def public @store_mask_snapshot(%first_mask: i32, %second_mask: i32, %a: i32, %b: i32) -> (i32, i32) {
  %length = index.constant 12 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<3xi32>
  %canary = scalar.constant 55 : i32
  view.store %first_mask, %view[0] : i32, view<3xi32>
  view.store %second_mask, %view[1] : i32, view<3xi32>
  view.store %canary, %view[2] : i32, view<3xi32>
  %loaded = vector.load %view[0] : view<3xi32> -> vector<2xi32>
  %c0 = scalar.constant 0 : i32
  %zeros = vector.splat %c0 : vector<2xi32>
  %mask = vector.cmpi ne, %loaded, %zeros : vector<2xi32> -> vector<2xi1>
  %values = vector.from_elements %a, %b : vector<2xi32>
  vector.store.mask %values, %view[1], %mask : vector<2xi32>, view<3xi32>, vector<2xi1>
  %left = view.load %view[1] : view<3xi32> -> i32
  %right = view.load %view[2] : view<3xi32> -> i32
  func.return %left, %right : i32, i32
}

check.case @inactive_lane_mask_survives_overwrite {
  %first_mask = check.param.choice values([-1, 1, 7]) : i32
  %second_mask = check.literal value(0) : i32
  %a = check.param.choice values([3, 99]) : i32
  %b = check.literal value(77) : i32
  %left, %right = func.call @store_mask_snapshot(%first_mask, %second_mask, %a, %b) : (i32, i32, i32, i32) -> (i32, i32)
  %canary = check.literal value(55) : i32
  check.expect.equal actual(%left) expected(%a) : i32
  check.expect.equal actual(%right) expected(%canary) : i32
  check.return
}

check.case @active_lane_mask_survives_zero_overwrite {
  %first_mask = check.literal value(1) : i32
  %second_mask = check.param.choice values([-1, 1, 7]) : i32
  %a = check.literal value(0) : i32
  %b = check.param.choice values([77, -9]) : i32
  %left, %right = func.call @store_mask_snapshot(%first_mask, %second_mask, %a, %b) : (i32, i32, i32, i32) -> (i32, i32)
  check.expect.equal actual(%left) expected(%a) : i32
  check.expect.equal actual(%right) expected(%b) : i32
  check.return
}

// Offsets [1, 0] swap the destinations. The first write overwrites the second
// offset's storage, but must not redirect the second write to a canary.
func.def public @scatter_offset_snapshot(%a: i32, %b: i32) -> (i32, i32, i32, i32) {
  %length = index.constant 16 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<4xi32>
  %c1 = scalar.constant 1 : i32
  %c0 = scalar.constant 0 : i32
  %canary = scalar.constant 55 : i32
  view.store %c1, %view[0] : i32, view<4xi32>
  view.store %c0, %view[1] : i32, view<4xi32>
  view.store %canary, %view[2] : i32, view<4xi32>
  view.store %canary, %view[3] : i32, view<4xi32>
  %offsets = vector.load %view[0] : view<4xi32> -> vector<2xi32>
  %offset_mask = scalar.constant 3 : i32
  %offset_masks = vector.splat %offset_mask : vector<2xi32>
  %bounded_offsets = vector.andi %offsets, %offset_masks : vector<2xi32>
  %values = vector.from_elements %a, %b : vector<2xi32>
  vector.scatter %values, %view[0][%bounded_offsets] : vector<2xi32>, view<4xi32>, vector<2xi32>
  %left = view.load %view[0] : view<4xi32> -> i32
  %right = view.load %view[1] : view<4xi32> -> i32
  %after0 = view.load %view[2] : view<4xi32> -> i32
  %after1 = view.load %view[3] : view<4xi32> -> i32
  func.return %left, %right, %after0, %after1 : i32, i32, i32, i32
}

check.case @scatter_offsets_survive_overwrite {
  %a = check.param.choice values([2, 3]) : i32
  %b = check.param.choice values([-9, 77]) : i32
  %left, %right, %after0, %after1 = func.call @scatter_offset_snapshot(%a, %b) : (i32, i32) -> (i32, i32, i32, i32)
  %canary = check.literal value(55) : i32
  check.expect.equal actual(%left) expected(%b) : i32
  check.expect.equal actual(%right) expected(%a) : i32
  check.expect.equal actual(%after0) expected(%canary) : i32
  check.expect.equal actual(%after1) expected(%canary) : i32
  check.return
}

func.def noinline @overwrite_lane(%storage: buffer, %value: i32) {
  %position = index.constant 0 : offset
  %view = buffer.view %storage[%position] : buffer -> view<2xi32>
  view.store %value, %view[1] : i32, view<2xi32>
  func.return
}

func.def public @captured_lane(%a: i32, %b: i32, %replacement: i32) -> (i32, i32, i32) {
  %length = index.constant 8 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<2xi32>
  view.store %a, %view[0] : i32, view<2xi32>
  view.store %b, %view[1] : i32, view<2xi32>
  %captured = vector.load %view[0] : view<2xi32> -> vector<2xi32>
  func.call @overwrite_lane(%storage, %replacement) : (buffer, i32)
  %left = vector.extract %captured[0] : vector<2xi32> -> i32
  %right = vector.extract %captured[1] : vector<2xi32> -> i32
  %after = view.load %view[1] : view<2xi32> -> i32
  func.return %left, %right, %after : i32, i32, i32
}

check.case @captured_lane_survives_call {
  %a = check.param.choice values([-2147483648, -7, 0, 2147483647]) : i32
  %b = check.param.choice values([-11, 13]) : i32
  %replacement = check.literal value(99) : i32
  %left, %right, %after = func.call @captured_lane(%a, %b, %replacement) : (i32, i32, i32) -> (i32, i32, i32)
  check.expect.equal actual(%left) expected(%a) : i32
  check.expect.equal actual(%right) expected(%b) : i32
  check.expect.equal actual(%after) expected(%replacement) : i32
  check.return
}
