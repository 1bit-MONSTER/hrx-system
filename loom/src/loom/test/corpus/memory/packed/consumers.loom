// Packed indices cover both signed-byte halves and distinct lanes in every word.

kernel.def @packed_word_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi32>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %packed = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %bytes = vector.bitcast %packed : vector<4xi32> to vector<16xi8>
  %indices = vector.extui %bytes : vector<16xi8> to vector<16xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<16xi32> -> vector<16xi32>
  vector.store %values, %output_view[0] : vector<16xi32>, view<16xi32>
  kernel.return
}

kernel.def @packed_byte_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %packed = vector.load %input_view[0] : view<16xi8> -> vector<16xi8>
  %indices = vector.extui %packed : vector<16xi8> to vector<16xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<16xi32> -> vector<16xi32>
  vector.store %values, %output_view[0] : vector<16xi32>, view<16xi32>
  kernel.return
}

kernel.def @packed_halfword_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<8xi16>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<8xi32>
  %packed = vector.load %input_view[0] : view<8xi16> -> vector<8xi16>
  %wide = vector.extui %packed : vector<8xi16> to vector<8xi32>
  %mask = vector.constant 255 : vector<8xi32>
  %indices = vector.andi %wide, %mask : vector<8xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<8xi32> -> vector<8xi32>
  vector.store %values, %output_view[0] : vector<8xi32>, view<8xi32>
  kernel.return
}

kernel.def @packed_signed_byte_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %packed = vector.load %input_view[0] : view<16xi8> -> vector<16xi8>
  %signed = vector.extsi %packed : vector<16xi8> to vector<16xi32>
  %bias = vector.constant 128 : vector<16xi32>
  %indices = vector.addi %signed, %bias : vector<16xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<16xi32> -> vector<16xi32>
  vector.store %values, %output_view[0] : vector<16xi32>, view<16xi32>
  kernel.return
}

check.case public @packed_word_lookup_nonuniform {
  %input = check.generate.iota offset(-128) step(17) : tensor<16xi8>
  %table = check.generate.iota offset(7) step(3) : tensor<256xi32>
  %output = check.generate.fill value(-99) : tensor<16xi32>
  kernel.launch @packed_word_lookup(%input, %table, %output) : (tensor<16xi8>, tensor<256xi32>, tensor<16xi32>)
  %expected_low = check.generate.iota offset(391) step(51) : tensor<8xi32>
  %expected_high = check.generate.iota offset(31) step(51) : tensor<8xi32>
  %low = check.tensor.view %output offset(0) : tensor<16xi32> -> tensor<8xi32>
  %high = check.tensor.view %output offset(32) : tensor<16xi32> -> tensor<8xi32>
  check.expect.equal actual(%low) expected(%expected_low) : tensor<8xi32>
  check.expect.equal actual(%high) expected(%expected_high) : tensor<8xi32>
  check.return
}

check.case public @packed_byte_lookup_nonuniform {
  %input = check.generate.iota offset(-128) step(17) : tensor<16xi8>
  %table = check.generate.iota offset(7) step(3) : tensor<256xi32>
  %output = check.generate.fill value(-99) : tensor<16xi32>
  kernel.launch @packed_byte_lookup(%input, %table, %output) : (tensor<16xi8>, tensor<256xi32>, tensor<16xi32>)
  %expected_low = check.generate.iota offset(391) step(51) : tensor<8xi32>
  %expected_high = check.generate.iota offset(31) step(51) : tensor<8xi32>
  %low = check.tensor.view %output offset(0) : tensor<16xi32> -> tensor<8xi32>
  %high = check.tensor.view %output offset(32) : tensor<16xi32> -> tensor<8xi32>
  check.expect.equal actual(%low) expected(%expected_low) : tensor<8xi32>
  check.expect.equal actual(%high) expected(%expected_high) : tensor<8xi32>
  check.return
}

check.case public @packed_halfword_lookup_nonuniform {
  %input = check.generate.iota offset(256) step(17) : tensor<8xi16>
  %table = check.generate.iota offset(7) step(3) : tensor<256xi32>
  %output = check.generate.fill value(-99) : tensor<8xi32>
  kernel.launch @packed_halfword_lookup(%input, %table, %output) : (tensor<8xi16>, tensor<256xi32>, tensor<8xi32>)
  %expected = check.generate.iota offset(7) step(51) : tensor<8xi32>
  check.expect.equal actual(%output) expected(%expected) : tensor<8xi32>
  check.return
}

check.case public @packed_signed_byte_lookup_nonuniform {
  %input = check.generate.iota offset(-128) step(17) : tensor<16xi8>
  %table = check.generate.iota offset(7) step(3) : tensor<256xi32>
  %output = check.generate.fill value(-99) : tensor<16xi32>
  kernel.launch @packed_signed_byte_lookup(%input, %table, %output) : (tensor<16xi8>, tensor<256xi32>, tensor<16xi32>)
  %expected = check.generate.iota offset(7) step(51) : tensor<16xi32>
  check.expect.equal actual(%output) expected(%expected) : tensor<16xi32>
