// Predicate tables keep their packed representation while selecting both true
// and false values at alternating runtime indices.
func.def device inline @compute_lookup_predicates(%table_input: buffer, %index_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %table_view = buffer.view %table_input[%base] : buffer -> view<2xi32>
  %index_view = buffer.view %index_input[%base] : buffer -> view<8xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<8xi32>
  %table_words = vector.load %table_view[0] : view<2xi32> -> vector<2xi32>
  %c0 = vector.constant 0 : vector<2xi32>
  %table = vector.cmpi slt, %table_words, %c0 : vector<2xi32> -> vector<2xi1>
  %indices = vector.load %index_view[0] : view<8xi32> -> vector<8xi32>
  %selected = vector.table.lookup %table[%indices] : vector<2xi1>, vector<8xi32> -> vector<8xi1>
  %selected_words = vector.extui %selected : vector<8xi1> to vector<8xi32>
  vector.store %selected_words, %output_view[0] : vector<8xi32>, view<8xi32>
  func.return
}

kernel.def @lookup_predicates() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%table_input: buffer, %index_input: buffer, %output: buffer) {
  func.call @compute_lookup_predicates(%table_input, %index_input, %output) : (buffer, buffer, buffer)
  kernel.return
}

func.def @lookup_predicates_oracle(%table_input: buffer, %index_input: buffer, %output: buffer) {
  func.call @compute_lookup_predicates(%table_input, %index_input, %output) : (buffer, buffer, buffer)
  func.return
}

check.scenario @predicate_lookup_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %table = check.generate.iota offset(-1) step(2) : tensor<2xi32>
    %indices = check.generate.iota offset(0) step(1) period(2) : tensor<8xi32>
    %output = check.generate.fill value(91) : tensor<8xi32>
    check.compare<@lookup_predicates, @lookup_predicates_oracle>(%table, %indices, %output) : (tensor<2xi32>, tensor<8xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%table) expected(%table) : tensor<2xi32>
      check.expect.bitwise actual(%indices) expected(%indices) : tensor<8xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}
