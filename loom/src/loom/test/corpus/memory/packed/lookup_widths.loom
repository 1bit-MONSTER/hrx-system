  %base = index.constant 0 : offset
  %thread = kernel.workitem.id<x> : index
  %start = index.cast %thread : index to i8
  %step = scalar.constant 1 : i8
  %raw = vector.iota %start step %step : vector<5xi8>
  %short_table_view = buffer.view %short_table[%base] : buffer -> view<4xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<16xi8>
  %short_output_view = buffer.view %short_output[%base] : buffer -> view<85xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<85xi8>
  %short_mask = vector.constant 3 : vector<5xi8>
  %mask = vector.constant 15 : vector<5xi8>
  %short_indices = vector.andi %raw, %short_mask : vector<5xi8>
  %indices = vector.andi %raw, %mask : vector<5xi8>
  %short_entries = vector.load %short_table_view[0] : view<4xi8> -> vector<4xi8>
  %entries = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %short_values = vector.table.lookup %short_entries[%short_indices] : vector<4xi8>, vector<5xi8> -> vector<5xi8>
  %values = vector.table.lookup %entries[%indices] : vector<16xi8>, vector<5xi8> -> vector<5xi8>
  %origin = scalar.constant 0 : i32
  %stride = scalar.constant 17 : i32
  %offsets = vector.iota %origin step %stride : vector<5xi32>
  vector.scatter %short_values, %short_output_view[%thread][%offsets] : vector<5xi8>, view<85xi8>, vector<5xi32>
  vector.scatter %values, %output_view[%thread][%offsets] : vector<5xi8>, view<85xi8>, vector<5xi32>
  kernel.return
}

check.scenario @computed_lookup_5_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %short_table = check.generate.iota offset(-127) step(64) : tensor<4xi8>
    %table = check.generate.iota offset(-127) step(16) : tensor<16xi8>
    %short_output = check.generate.fill value(91) : tensor<85xi8>
    %output = check.generate.fill value(91) : tensor<85xi8>
    check.compare<@lookup_computed_5, @repeat_two_tables>(%short_table, %table, %short_output, %output) : (tensor<4xi8>, tensor<16xi8>, tensor<85xi8>, tensor<85xi8>) -> () {
      check.expect.bitwise actual(%short_table) expected(%short_table) : tensor<4xi8>
      check.expect.bitwise actual(%table) expected(%table) : tensor<16xi8>
      check.expect.bitwise actual(%short_output) expected(%short_output) : tensor<85xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<85xi8>
    }
  }
  check.return
}

