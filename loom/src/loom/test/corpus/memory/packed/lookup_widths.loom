// A 64-lane packed lookup remains one native producer while its conversion and
// store consume target-sized packets.
kernel.def @lookup_nibbles_64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<32xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<16xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<64xf32>
  %packed = vector.load %input_view[0] : view<32xi8> -> vector<32xi8>
  %indices = vector.bitunpacku<4> %packed : vector<32xi8> -> vector<64xi8>
  %entries = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %values = vector.table.lookup %entries[%indices] : vector<16xi8>, vector<64xi8> -> vector<64xi8>
  %converted = vector.sitofp %values : vector<64xi8> to vector<64xf32>
  vector.store %converted, %output_view[0] : vector<64xf32>, view<64xf32>
  kernel.return
}

func.def @lookup_nibbles_64_oracle(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<32xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<16xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<64xf32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %elements_per_byte = index.constant 2 : index
  %nibble_bit_count = index.constant 4 : index
  %nibble_mask = scalar.constant 15 : i32
  scf.for %position = [%begin to %end step %step] {
    %packed_position = index.div %position, %elements_per_byte : index
    %nibble_position = index.rem %position, %elements_per_byte : index
    %packed_byte = view.load %input_view[%packed_position] : view<32xi8> -> i8
    %packed_word = scalar.extui %packed_byte : i8 to i32
    %bit_position_index = index.mul %nibble_position, %nibble_bit_count : index
    %bit_position = index.cast %bit_position_index : index to i32
    %shifted = scalar.shrui %packed_word, %bit_position : i32
    %table_position_word = scalar.andi %shifted, %nibble_mask : i32
    %table_position = index.cast %table_position_word : i32 to index
    %bounded_table_position = index.assume %table_position [range(%table_position, 0, 16)] : index
    %value = view.load %table_view[%bounded_table_position] : view<16xi8> -> i8
    %converted = scalar.sitofp %value : i8 to f32
    view.store %converted, %output_view[%position] : f32, view<64xf32>
  }
  func.return
}

check.scenario @nibble_lookup_64_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1985229328) step(-2004318072) period(2) : tensor<8xi32>
    %table = check.generate.iota offset(-127) step(16) : tensor<16xi8>
    %output = check.generate.fill value(91.0) : tensor<64xf32>
    check.compare<@lookup_nibbles_64, @lookup_nibbles_64_oracle>(%input, %table, %output) : (tensor<8xi32>, tensor<16xi8>, tensor<64xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8xi32>
      check.expect.bitwise actual(%table) expected(%table) : tensor<16xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xf32>
    }
  }
  check.return
}

// Seventeen workitems exercise every table entry at every vector position.
// Transposed stores are disjoint; 17 is one modulo both table sizes, so their
// flattened results form simple periodic iotas.
// Computed scatter layouts cover every output byte exactly once. Since the
// stride is one modulo either table width, the semantic result is the table
// repeated across the dense output span.
func.def @repeat_table_bytes(%table: buffer, %output: buffer) {
  %table_length_offset = buffer.length %table
  %output_length_offset = buffer.length %output
  %bounded_table_length = index.assume %table_length_offset [range(%table_length_offset, 0, 9223372036854775807)] : offset
  %bounded_output_length = index.assume %output_length_offset [range(%output_length_offset, 0, 9223372036854775807)] : offset
  %table_length = index.cast %bounded_table_length : offset to index
  %output_length = index.cast %bounded_output_length : offset to index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %output_length step %step] {
    %table_position = index.rem %position, %table_length : index
    %bounded_table_position = index.assume %table_position [range(%table_position, 0, 9223372036854775807)] : index
    %bounded_output_position = index.assume %position [range(%position, 0, 9223372036854775807)] : index
    %table_offset = index.cast %bounded_table_position : index to offset
    %output_offset = index.cast %bounded_output_position : index to offset
    %value = buffer.load.i8.u %table[%table_offset]
    buffer.store.i8 %value, %output[%output_offset]
  }
  func.return
}

func.def @repeat_two_tables(%short_table: buffer, %table: buffer, %short_output: buffer, %output: buffer) {
  func.call @repeat_table_bytes(%short_table, %short_output) : (buffer, buffer)
  func.call @repeat_table_bytes(%table, %output) : (buffer, buffer)
  func.return
}

kernel.def @lookup_computed_1() {
  %unit = index.constant 1 : index
  %threads = index.constant 17 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%short_table: buffer, %table: buffer, %short_output: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %thread = kernel.workitem.id<x> : index
  %start = index.cast %thread : index to i8
  %step = scalar.constant 1 : i8
  %raw = vector.iota %start step %step : vector<1xi8>
  %short_table_view = buffer.view %short_table[%base] : buffer -> view<4xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<16xi8>
  %short_output_view = buffer.view %short_output[%base] : buffer -> view<17xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<17xi8>
  %short_mask = vector.constant 3 : vector<1xi8>
  %mask = vector.constant 15 : vector<1xi8>
  %short_indices = vector.andi %raw, %short_mask : vector<1xi8>
  %indices = vector.andi %raw, %mask : vector<1xi8>
  %short_entries = vector.load %short_table_view[0] : view<4xi8> -> vector<4xi8>
  %entries = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %short_values = vector.table.lookup %short_entries[%short_indices] : vector<4xi8>, vector<1xi8> -> vector<1xi8>
  %values = vector.table.lookup %entries[%indices] : vector<16xi8>, vector<1xi8> -> vector<1xi8>
  %origin = scalar.constant 0 : i32
  %stride = scalar.constant 17 : i32
  %offsets = vector.iota %origin step %stride : vector<1xi32>
  vector.scatter %short_values, %short_output_view[%thread][%offsets] : vector<1xi8>, view<17xi8>, vector<1xi32>
  vector.scatter %values, %output_view[%thread][%offsets] : vector<1xi8>, view<17xi8>, vector<1xi32>
  kernel.return
}

check.scenario @computed_lookup_1_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %short_table = check.generate.iota offset(-127) step(64) : tensor<4xi8>
    %table = check.generate.iota offset(-127) step(16) : tensor<16xi8>
    %short_output = check.generate.fill value(91) : tensor<17xi8>
    %output = check.generate.fill value(91) : tensor<17xi8>
    check.compare<@lookup_computed_1, @repeat_two_tables>(%short_table, %table, %short_output, %output) : (tensor<4xi8>, tensor<16xi8>, tensor<17xi8>, tensor<17xi8>) -> () {
      check.expect.bitwise actual(%short_table) expected(%short_table) : tensor<4xi8>
      check.expect.bitwise actual(%table) expected(%table) : tensor<16xi8>
      check.expect.bitwise actual(%short_output) expected(%short_output) : tensor<17xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi8>
    }
  }
  check.return
}

