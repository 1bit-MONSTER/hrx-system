// The workload is dynamic; specialization cannot precompute these groups or
// byte counts. Both divide and scale operate beyond the low 32 bits.
func.def public @launch_arithmetic(%workload0: index, %tile0: index, %element_bytes: offset) -> (index, offset) {
  %workload, %tile = index.assume %workload0, %tile0 [range(%workload0, 0, 1099511627776), range(%tile0, 1, 65536)] : index, index
  %c1 = index.constant 1 : index
  %bias = index.sub %tile, %c1 : index
  %rounded = index.add %workload, %bias : index
  %groups = index.div %rounded, %tile : index
  %bytes = index.scale %workload, %element_bytes : index, offset -> offset
  func.return %groups, %bytes : index, offset
}

check.case @launch_large_workload {
  %workload = check.literal value(4294967297) : index
  %tile = check.literal value(256) : index
  %element_bytes = check.literal value(4) : offset
  %groups, %bytes = func.call @launch_arithmetic(%workload, %tile, %element_bytes) : (index, index, offset) -> (index, offset)
  %expected_groups = check.literal value(16777217) : index
  %expected_bytes = check.literal value(17179869188) : offset
  check.expect.equal actual(%groups) expected(%expected_groups) : index
  check.expect.equal actual(%bytes) expected(%expected_bytes) : offset
  check.return
}

check.case @launch_empty_workload {
  %workload = check.literal value(0) : index
  %tile = check.param.choice values([1, 32, 256]) : index
  %element_bytes = check.literal value(4) : offset
  %groups, %bytes = func.call @launch_arithmetic(%workload, %tile, %element_bytes) : (index, index, offset) -> (index, offset)
  %expected_bytes = check.literal value(0) : offset
  check.expect.equal actual(%groups) expected(%workload) : index
  check.expect.equal actual(%bytes) expected(%expected_bytes) : offset
  check.return
}

// The same raw narrow payload enters index as signed, offset as unsigned,
// and survives a low-bit round trip through the public argument/result ABI.
func.def public @address_casts(%flag: i1, %byte: i8, %word: i16) -> (index, offset, index, offset, index, offset, i8, i16) {
  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %byte_index = index.cast %byte : i8 to index
  %byte_offset = index.cast %byte : i8 to offset
  %word_index = index.cast %word : i16 to index
  %word_offset = index.cast %word : i16 to offset
  %byte_back = index.cast %byte_offset : offset to i8
  %word_back = index.cast %word_offset : offset to i16
  func.return %flag_index, %flag_offset, %byte_index, %byte_offset, %word_index, %word_offset, %byte_back, %word_back : index, offset, index, offset, index, offset, i8, i16
}

check.case @address_signedness {
  %flag = check.literal value(true) : i1
  %byte = check.literal value(-1) : i8
  %word = check.literal value(-1) : i16
  %flag_index, %flag_offset, %byte_index, %byte_offset, %word_index, %word_offset, %byte_back, %word_back = func.call @address_casts(%flag, %byte, %word) : (i1, i8, i16) -> (index, offset, index, offset, index, offset, i8, i16)
  %one_index = check.literal value(1) : index
  %one_offset = check.literal value(1) : offset
  %negative_index = check.literal value(-1) : index
  %max_byte = check.literal value(255) : offset
  %max_word = check.literal value(65535) : offset
  check.expect.equal actual(%flag_index) expected(%one_index) : index
  check.expect.equal actual(%flag_offset) expected(%one_offset) : offset
  check.expect.equal actual(%byte_index) expected(%negative_index) : index
  check.expect.equal actual(%byte_offset) expected(%max_byte) : offset
  check.expect.equal actual(%word_index) expected(%negative_index) : index
  check.expect.equal actual(%word_offset) expected(%max_word) : offset
  check.expect.equal actual(%byte_back) expected(%byte) : i8
  check.expect.equal actual(%word_back) expected(%word) : i16
  check.return
}

func.def public @index_loop(%limit0: index, %stride: offset) -> (offset) {
  %limit = index.assume %limit0 [range(%limit0, 0, 64)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial_bytes = index.constant 0 : offset
  %sum = scf.for %i = [%c0 to %limit step %c1](%total = %initial_bytes : offset) -> (offset) {
    %bytes = index.scale %i, %stride : index, offset -> offset
    %next = index.add %total, %bytes : offset
    scf.yield %next : offset
  }
  func.return %sum : offset
}

check.case @index_loop_case {
  %limit = check.literal value(5) : index
  %stride = check.literal value(8) : offset
  %sum = func.call @index_loop(%limit, %stride) : (index, offset) -> (offset)
  %expected = check.literal value(80) : offset
  check.expect.equal actual(%sum) expected(%expected) : offset
  check.return
}
