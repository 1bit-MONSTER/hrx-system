// The workload is dynamic; specialization cannot precompute these groups or
// byte counts. Both divide and scale operate beyond the low 32 bits.
func.def @launch_arithmetic(%workload0: index, %tile0: index, %element_bytes: offset) -> (index, offset) {
  %workload, %tile = index.assume %workload0, %tile0 [range(%workload0, 0, 1099511627776), range(%tile0, 1, 65536)] : index, index
  %c1 = index.constant 1 : index
  %bias = index.sub %tile, %c1 : index
  %rounded = index.add %workload, %bias : index
  %groups = index.div %rounded, %tile : index
  %bytes = index.scale %workload, %element_bytes : index, offset -> offset
  func.return %groups, %bytes : index, offset
}

// The same raw narrow payload enters index as signed, offset as unsigned,
// and survives a low-bit round trip through the public argument/result ABI.
func.def @address_casts(%flag: i1, %byte: i8, %word: i16) -> (index, offset, index, offset, index, offset, i8, i16) {
  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %byte_index = index.cast %byte : i8 to index
  %byte_offset = index.cast %byte : i8 to offset
  %word_index = index.cast %word : i16 to index
  %word_offset = index.cast %word : i16 to offset
  %byte_back = index.cast %byte_offset : offset to i8
  %word_back = index.cast %word_offset : offset to i16
  func.return %flag_index, %flag_offset, %byte_index, %byte_offset, %word_index, %word_offset, %byte_back, %word_back : index, offset, index, offset, index, offset, i8, i16
}

func.def @index_loop(%limit0: index, %stride: offset) -> (offset) {
  %limit = index.assume %limit0 [range(%limit0, 0, 64)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial_bytes = index.constant 0 : offset
  %sum = scf.for %i = [%c0 to %limit step %c1](%total = %initial_bytes : offset) -> (offset) {
    %bytes = index.scale %i, %stride : index, offset -> offset
    %next = index.add %total, %bytes : offset
    scf.yield %next : offset
  }
  func.return %sum : offset
}

func.def @launch_arithmetic_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %empty = index.cmp eq, %ordinal, %c0 : index
  %empty_workload = index.constant 0 : index
  %large = index.constant 4294967297 : index
  %workload = scf.select %empty, %empty_workload, %large : index
  %tile = index.constant 256 : index
  %element_bytes = index.constant 4 : offset
  %groups, %bytes = func.call @launch_arithmetic(%workload, %tile, %element_bytes) : (index, index, offset) -> (index, offset)
  %groups_value = index.cast %groups : index to i64
  %bytes_value = index.cast %bytes : offset to i64
  %values = vector.from_elements %groups_value, %bytes_value : vector<2xi64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi64>
  vector.store %values, %results[0] : vector<2xi64>, view<2xi64>
  func.return
}

func.def @address_cast_observations(%ordinal: index, %output: buffer) {
  %flag = scalar.constant true : i1
  %byte = scalar.constant -1 : i8
  %word = scalar.constant -1 : i16
  %flag_index, %flag_offset, %byte_index, %byte_offset, %word_index, %word_offset, %byte_back, %word_back = func.call @address_casts(%flag, %byte, %word) : (i1, i8, i16) -> (index, offset, index, offset, index, offset, i8, i16)
  %c1 = index.constant 1 : index
  %limit = index.add %ordinal, %c1 : index
  %stride = index.constant 8 : offset
  %sum = func.call @index_loop(%limit, %stride) : (index, offset) -> (offset)
  %flag_index_value = index.cast %flag_index : index to i64
  %flag_offset_value = index.cast %flag_offset : offset to i64
  %byte_index_value = index.cast %byte_index : index to i64
  %byte_offset_value = index.cast %byte_offset : offset to i64
  %word_index_value = index.cast %word_index : index to i64
  %word_offset_value = index.cast %word_offset : offset to i64
  %byte_back_value = scalar.extsi %byte_back : i8 to i64
  %word_back_value = scalar.extsi %word_back : i16 to i64
  %sum_value = index.cast %sum : offset to i64
  %values = vector.from_elements %flag_index_value, %flag_offset_value, %byte_index_value, %byte_offset_value, %word_index_value, %word_offset_value, %byte_back_value, %word_back_value, %sum_value : vector<9xi64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<9xi64>
  vector.store %values, %results[0] : vector<9xi64>, view<9xi64>
  func.return
}

check.scenario @launch_arithmetic_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0) : tensor<2xi64>
    check.compare<@launch_arithmetic_observations>(%trial, %output) : (index, tensor<2xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi64>
    }
  }
  check.return
}

check.scenario @address_cast_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0) : tensor<9xi64>
    check.compare<@address_cast_observations>(%trial, %output) : (index, tensor<9xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<9xi64>
    }
  }
  check.return
}
