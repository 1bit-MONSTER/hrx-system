// Casting out of the address domain keeps the low destination bits even when
// the source's high word is nonzero. The sign bit belongs to the i32 result.
kernel.def @truncate_wide_address() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: i64, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %lane_integer = index.cast %lane : index to i64
  %base = scalar.assume %input [range(%input, 0, 9223372036854775743)] : i64
  %varying = scalar.addi %base, %lane_integer : i64
  %address = index.cast %varying : i64 to offset
  %increment = index.constant 1 : offset
  %next = index.add %address, %increment : offset
  %word = index.cast %next : offset to i32
  %signed = scalar.extsi %word : i32 to i64
  %unsigned = scalar.extui %word : i32 to i64
  %signed_base = index.constant 0 : offset
  %unsigned_base = index.constant 512 : offset
  %signed_view = buffer.view %output[%signed_base] : buffer -> view<64xi64>
  %unsigned_view = buffer.view %output[%unsigned_base] : buffer -> view<64xi64>
  view.store %signed, %signed_view[%lane] : i64, view<64xi64>
  view.store %unsigned, %unsigned_view[%lane] : i64, view<64xi64>
  kernel.return
}

check.case public @truncate_wide_address_low {
  %input = check.literal value(4294967296) : i64
  %storage = check.generate.fill value(-123) : tensor<160xi64>
  %output = check.tensor.view %storage offset(128) : tensor<160xi64> -> tensor<128xi64>
  kernel.launch @truncate_wide_address(%input, %output) : (i64, tensor<128xi64>)
  %signed = check.tensor.view %output offset(0) : tensor<128xi64> -> tensor<64xi64>
  %unsigned = check.tensor.view %output offset(512) : tensor<128xi64> -> tensor<64xi64>
  %expected_signed = check.generate.iota offset(1) step(1) : tensor<64xi64>
  %expected_unsigned = check.generate.iota offset(1) step(1) : tensor<64xi64>
  check.expect.bitwise actual(%signed) expected(%expected_signed) : tensor<64xi64>
  check.expect.bitwise actual(%unsigned) expected(%expected_unsigned) : tensor<64xi64>
  %prefix = check.tensor.view %storage offset(0) : tensor<160xi64> -> tensor<16xi64>
  %suffix = check.tensor.view %storage offset(1152) : tensor<160xi64> -> tensor<16xi64>
  %guard = check.generate.fill value(-123) : tensor<16xi64>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<16xi64>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<16xi64>
  check.return
}

