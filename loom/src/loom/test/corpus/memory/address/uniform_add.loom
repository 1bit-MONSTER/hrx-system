  %actual_left = check.tensor.view %output offset(256) : tensor<256xi32> -> tensor<64xi32>
  %expected_left = check.generate.iota offset(2147483537) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_left) expected(%expected_left) : tensor<64xi32>
  %actual_constant_right = check.tensor.view %output offset(512) : tensor<256xi32> -> tensor<64xi32>
  %expected_constant_right = check.generate.iota offset(2147483564) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_constant_right) expected(%expected_constant_right) : tensor<64xi32>
  %actual_constant_left = check.tensor.view %output offset(768) : tensor<256xi32> -> tensor<64xi32>
  %expected_constant_left = check.generate.iota offset(2147483564) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_constant_left) expected(%expected_constant_left) : tensor<64xi32>
  %prefix = check.tensor.view %storage offset(0) : tensor<288xi32> -> tensor<16xi32>
  %suffix = check.tensor.view %storage offset(1088) : tensor<288xi32> -> tensor<16xi32>
  %guard = check.generate.fill value(-123) : tensor<16xi32>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<16xi32>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<16xi32>
