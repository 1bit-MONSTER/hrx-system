kernel.def @index_uniform_add() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%step: index, %input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<64xi32>
  %value = view.load %inputs[%lane] : view<64xi32> -> i32
  %position = index.cast %value : i32 to index
  %increment = index.constant 64 : index
  %sum_right = index.add %position, %step : index
  %word_right = index.cast %sum_right : index to i32
  %base_right = index.constant 0 : offset
  %outputs_right = buffer.view %output[%base_right] : buffer -> view<64xi32>
  view.store %word_right, %outputs_right[%lane] : i32, view<64xi32>
  %sum_left = index.add %step, %position : index
  %word_left = index.cast %sum_left : index to i32
  %base_left = index.constant 256 : offset
  %outputs_left = buffer.view %output[%base_left] : buffer -> view<64xi32>
  view.store %word_left, %outputs_left[%lane] : i32, view<64xi32>
  %sum_constant_right = index.add %position, %increment : index
  %word_constant_right = index.cast %sum_constant_right : index to i32
  %base_constant_right = index.constant 512 : offset
  %outputs_constant_right = buffer.view %output[%base_constant_right] : buffer -> view<64xi32>
  view.store %word_constant_right, %outputs_constant_right[%lane] : i32, view<64xi32>
  %sum_constant_left = index.add %increment, %position : index
  %word_constant_left = index.cast %sum_constant_left : index to i32
  %base_constant_left = index.constant 768 : offset
  %outputs_constant_left = buffer.view %output[%base_constant_left] : buffer -> view<64xi32>
  view.store %word_constant_left, %outputs_constant_left[%lane] : i32, view<64xi32>
  kernel.return
}

check.case public @index_add_negative_step {
  %step = check.literal value(-17) : index
  %input = check.generate.iota offset(100) step(1) : tensor<64xi32>
  %storage = check.generate.fill value(-123) : tensor<288xi32>
  %output = check.tensor.view %storage offset(64) : tensor<288xi32> -> tensor<256xi32>
  kernel.launch @index_uniform_add(%step, %input, %output) : (index, tensor<64xi32>, tensor<256xi32>)
  %actual_right = check.tensor.view %output offset(0) : tensor<256xi32> -> tensor<64xi32>
  %expected_right = check.generate.iota offset(83) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_right) expected(%expected_right) : tensor<64xi32>
  %actual_left = check.tensor.view %output offset(256) : tensor<256xi32> -> tensor<64xi32>
  %expected_left = check.generate.iota offset(83) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_left) expected(%expected_left) : tensor<64xi32>
  %actual_constant_right = check.tensor.view %output offset(512) : tensor<256xi32> -> tensor<64xi32>
  %expected_constant_right = check.generate.iota offset(164) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_constant_right) expected(%expected_constant_right) : tensor<64xi32>
  %actual_constant_left = check.tensor.view %output offset(768) : tensor<256xi32> -> tensor<64xi32>
  %expected_constant_left = check.generate.iota offset(164) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%actual_constant_left) expected(%expected_constant_left) : tensor<64xi32>
  %prefix = check.tensor.view %storage offset(0) : tensor<288xi32> -> tensor<16xi32>
  %suffix = check.tensor.view %storage offset(1088) : tensor<288xi32> -> tensor<16xi32>
  %guard = check.generate.fill value(-123) : tensor<16xi32>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<16xi32>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<16xi32>
  check.return
}

