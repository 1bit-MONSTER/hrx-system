// A flattened tile coordinate addresses the input while its remainder selects
// an integer channel weight. Only the full input address needs the row
// contribution.
func.def @tiled_channel_load(%input: buffer, %row: index, %lane: index) -> (i32) {
  %bounded_row = index.assume %row [range(%row, 0, 15)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 255)] : index
  %stride = index.constant 256 : index
  %linear = index.madd %bounded_row, %stride, %bounded_lane : index
  %channel = index.rem %linear, %stride : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<4096xi32>
  %value = view.load %data[%linear] : view<4096xi32> -> i32
  %weight = view.load %data[%channel] : view<4096xi32> -> i32
  %result = scalar.muli %value, %weight : i32
  func.return %result : i32
}

// The same address relation feeds scalar floating-point arithmetic without
// changing which coordinate carries the row contribution.
func.def @tiled_channel_load_f32(%input: buffer, %row: index, %lane: index) -> (f32) {
  %bounded_row = index.assume %row [range(%row, 0, 15)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 255)] : index
  %stride = index.constant 256 : index
  %linear = index.madd %bounded_row, %stride, %bounded_lane : index
  %channel = index.rem %linear, %stride : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<4096xf32>
  %value = view.load %data[%linear] : view<4096xf32> -> f32
  %weight = view.load %data[%channel] : view<4096xf32> -> f32
  %result = scalar.mulf %value, %weight : f32
  func.return %result : f32
}

func.def @tiled_channel_observations(%ordinal: index, %integer_input: buffer, %float_input: buffer, %integer_output: buffer, %float_output: buffer) {
  %c16 = index.constant 16 : index
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %row = index.rem %bounded_ordinal, %c16 : index
  %integer_result = func.call @tiled_channel_load(%integer_input, %row, %bounded_ordinal) : (buffer, index, index) -> (i32)
  %float_result = func.call @tiled_channel_load_f32(%float_input, %row, %bounded_ordinal) : (buffer, index, index) -> (f32)
  %origin = index.constant 0 : offset
  %integer_result_view = buffer.view %integer_output[%origin] : buffer -> view<1xi32>
  %float_result_view = buffer.view %float_output[%origin] : buffer -> view<1xf32>
  view.store %integer_result, %integer_result_view[0] : i32, view<1xi32>
  view.store %float_result, %float_result_view[0] : f32, view<1xf32>
  func.return
}

// Every lane and row participates. Finite, ordinary F32 values keep this a
// target-neutral address/arithmetic contract; representation edges stay Low.
check.scenario @tiled_channel_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %integer_storage = check.generate.iota offset(-2048) step(3) : tensor<4104xi32>
    %integer_input = check.tensor.view %integer_storage offset(16) : tensor<4104xi32> -> tensor<4096xi32>
    %integer_prefix = check.tensor.view %integer_storage offset(0) : tensor<4104xi32> -> tensor<4xi32>
    %integer_suffix = check.tensor.view %integer_storage offset(16400) : tensor<4104xi32> -> tensor<4xi32>
    %expected_integer_prefix = check.generate.iota offset(-2048) step(3) : tensor<4xi32>
    %expected_integer_suffix = check.generate.iota offset(10252) step(3) : tensor<4xi32>
    %float_storage = check.generate.iota offset(-8.0) step(0.00390625) : tensor<4104xf32>
    %float_input = check.tensor.view %float_storage offset(16) : tensor<4104xf32> -> tensor<4096xf32>
    %float_prefix = check.tensor.view %float_storage offset(0) : tensor<4104xf32> -> tensor<4xf32>
    %float_suffix = check.tensor.view %float_storage offset(16400) : tensor<4104xf32> -> tensor<4xf32>
    %expected_float_prefix = check.generate.iota offset(-8.0) step(0.00390625) : tensor<4xf32>
    %expected_float_suffix = check.generate.iota offset(8.015625) step(0.00390625) : tensor<4xf32>
    %integer_output = check.generate.fill value(-123) : tensor<1xi32>
    %float_output = check.generate.fill value(-123.5) : tensor<1xf32>
    check.compare<@tiled_channel_observations>(%trial, %integer_input, %float_input, %integer_output, %float_output) : (index, tensor<4096xi32>, tensor<4096xf32>, tensor<1xi32>, tensor<1xf32>) -> () {
      check.expect.bitwise actual(%integer_storage) expected(%integer_storage) : tensor<4104xi32>
      check.expect.bitwise actual(%float_storage) expected(%float_storage) : tensor<4104xf32>
      check.expect.bitwise actual(%integer_output) expected(%integer_output) : tensor<1xi32>
      check.expect.close actual(%float_output) expected(%float_output) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : tensor<1xf32>
      check.expect.bitwise actual(%integer_prefix) expected(%expected_integer_prefix) : tensor<4xi32>
      check.expect.bitwise actual(%integer_suffix) expected(%expected_integer_suffix) : tensor<4xi32>
      check.expect.bitwise actual(%float_prefix) expected(%expected_float_prefix) : tensor<4xf32>
      check.expect.bitwise actual(%float_suffix) expected(%expected_float_suffix) : tensor<4xf32>
    }
  }
  check.return
}
