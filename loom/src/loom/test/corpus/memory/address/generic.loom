// Uniform and lane-varying terms both contribute to the full flat pointer.
kernel.def @generic_atomic_indexed_i32() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer, %start: i32) {
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %origin = index.constant 65536 : offset
  %result_origin = index.constant 0 : offset
  %words = buffer.view %generic[%origin] : buffer -> view<66xi32>
  %results = buffer.view %output[%result_origin] : buffer -> view<128xi32>
  %uniform_input = index.cast %start : i32 to index
  %uniform = index.assume %uniform_input [range(%uniform_input, 0, 2)] : index
  %lane = kernel.workitem.id<x> : index
  %position = index.add %uniform, %lane : index
  %half = index.constant 64 : index
  %second = index.add %lane, %half : index
  %contribution = scalar.constant 3 : i32
  %increment = scalar.constant 5 : i32
  %expected = scalar.constant 18 : i32
  %replacement = scalar.constant 21 : i32
  view.atomic.reduce<addi> %contribution, %words[%position] {ordering = relaxed, scope = workgroup} : i32, view<66xi32>
  %old_add = view.atomic.rmw<addi> %increment, %words[%position] {ordering = relaxed, scope = workgroup} : i32, view<66xi32> -> i32
  %old_cas = view.atomic.cmpxchg %expected, %replacement, %words[%position] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : i32, view<66xi32> -> i32
  view.store %old_add, %results[%lane] : i32, view<128xi32>
  view.store %old_cas, %results[%second] : i32, view<128xi32>
  kernel.return
}

// A uniform dynamic term still reaches VADDR; flat packets have no SOFFSET.
kernel.def @generic_atomic_uniform_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer, %position: i32) {
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %origin = index.constant 16 : offset
  %result_origin = index.constant 0 : offset
  %words = buffer.view %generic[%origin] : buffer -> view<8xi64>
  %results = buffer.view %output[%result_origin] : buffer -> view<2xi64>
  %index_input = index.cast %position : i32 to index
  %index = index.assume %index_input [range(%index_input, 0, 7)] : index
  %increment = scalar.constant 4294967296 : i64
  %expected = scalar.constant 8589934602 : i64
  %replacement = scalar.constant 99 : i64
  view.atomic.reduce<addi> %increment, %words[%index] {ordering = relaxed, scope = device} : i64, view<8xi64>
  %old_add = view.atomic.rmw<addi> %increment, %words[%index] {ordering = relaxed, scope = device} : i64, view<8xi64> -> i64
  %old_cas = view.atomic.cmpxchg %expected, %replacement, %words[%index] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<8xi64> -> i64
  view.store %old_add, %results[0] : i64, view<2xi64>
  view.store %old_cas, %results[1] : i64, view<2xi64>
  kernel.return
}

// Generic pointers retain full-width dynamic addressing and byte origins.
kernel.def @generic_copy_i64() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source = buffer.assume.memory_space<generic> %input : buffer
  %target = buffer.assume.memory_space<generic> %output : buffer
  %source_origin = index.constant 16 : offset
  %target_origin = index.constant 8 : offset
  %source_view = buffer.view %source[%source_origin] : buffer -> view<64xi64>
  %target_view = buffer.view %target[%target_origin] : buffer -> view<64xi64>
  %lane = kernel.workitem.id<x> : index
  %value = view.load %source_view[%lane] : view<64xi64> -> i64
  view.store %value, %target_view[%lane] : i64, view<64xi64>
  kernel.return
}

kernel.def @generic_copy_vector() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source = buffer.assume.memory_space<generic> %input : buffer
  %target = buffer.assume.memory_space<generic> %output : buffer
  %origin = index.constant 0 : offset
  %source_view = buffer.view %source[%origin] : buffer -> view<4xi32>
  %target_view = buffer.view %target[%origin] : buffer -> view<4xi32>
  %value = vector.load %source_view[0] : view<4xi32> -> vector<4xi32>
  vector.store %value, %target_view[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// Offsets beyond the packet immediate are added to the full pointer.
kernel.def @generic_copy_half() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source = buffer.assume.memory_space<generic> %input : buffer
  %target = buffer.assume.memory_space<generic> %output : buffer
  %source_origin = index.constant 65536 : offset
  %target_origin = index.constant 0 : offset
  %source_view = buffer.view %source[%source_origin] : buffer -> view<1xf16>
  %target_view = buffer.view %target[%target_origin] : buffer -> view<1xf16>
  %value = view.load %source_view[0] : view<1xf16> -> f16
  view.store %value, %target_view[0] : f16, view<1xf16>
  kernel.return
}

// A freshly rounded half value can flow directly through generic memory.
kernel.def @generic_narrow_half_store() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %input: f32) {
  %target = buffer.assume.memory_space<generic> %output : buffer
  %origin = index.constant 0 : offset
  %target_view = buffer.view %target[%origin] : buffer -> view<1xf16>
  %half = scalar.fptrunc %input : f32 to f16
  view.store %half, %target_view[0] : f16, view<1xf16>
  kernel.return
}

check.case public @generic_memory_values {
  %input = check.generate.iota offset(4294967296) step(3) : tensor<66xi64>
  %output = check.generate.fill value(-1) : tensor<66xi64>
  kernel.launch @generic_copy_i64(%input, %output) : (tensor<66xi64>, tensor<66xi64>)
  %actual = check.tensor.view %output offset(8) : tensor<66xi64> -> tensor<64xi64>
  %expected = check.tensor.view %input offset(16) : tensor<66xi64> -> tensor<64xi64>
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<64xi64>
  %prefix = check.tensor.view %output offset(0) : tensor<66xi64> -> tensor<1xi64>
  %suffix = check.tensor.view %output offset(520) : tensor<66xi64> -> tensor<1xi64>
  %untouched = check.generate.fill value(-1) : tensor<1xi64>
  check.expect.bitwise actual(%prefix) expected(%untouched) : tensor<1xi64>
  check.expect.bitwise actual(%suffix) expected(%untouched) : tensor<1xi64>
  check.return
}

check.case public @generic_vector_values {
  %input = check.generate.iota offset(-19088743) step(123) : tensor<4xi32>
  %output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @generic_copy_vector(%input, %output) : (tensor<4xi32>, tensor<4xi32>)
  check.expect.bitwise actual(%output) expected(%input) : tensor<4xi32>
  check.return
}

check.case public @generic_half_values {
  %input = check.generate.fill value(-3.25) : tensor<32769xf16>
  %output = check.generate.fill value(0.0) : tensor<1xf16>
  kernel.launch @generic_copy_half(%input, %output) : (tensor<32769xf16>, tensor<1xf16>)
  %expected = check.generate.fill value(-3.25) : tensor<1xf16>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<1xf16>
  check.return
}

check.case public @generic_narrow_half_values {
  %input = check.literal value(-3.25) : f32
  %output = check.generate.fill value(0.0) : tensor<1xf16>
  kernel.launch @generic_narrow_half_store(%output, %input) : (tensor<1xf16>, f32)
  %expected = check.generate.fill value(-3.25) : tensor<1xf16>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<1xf16>
  check.return
}

// Two lanes in different waves hand off ordinary global and LDS payloads.
// The generic flag addresses a global allocation initialized by the caller.
// Acknowledged reuse orders LDS and global payloads without a rendezvous.
kernel.def @generic_workgroup_publication() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %generic_signal = buffer.assume.memory_space<generic> %signal : buffer
  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %flag = buffer.view %generic_signal[%origin] : buffer -> view<1xi64>
  %global = buffer.view %generic_payload[%origin] : buffer -> view<1xi32>
  %results = buffer.view %output[%origin] : buffer -> view<32xi32>
  %acknowledged = scalar.constant 0 : i64
  %published = scalar.constant 1 : i64
  %bias = scalar.constant 65536 : i32
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %reader_lane = index.constant 64 : index
  %lane = kernel.workitem.id<x> : index
  %writer = index.cmp eq, %lane, %begin : index
  %reader = index.cmp eq, %lane, %reader_lane : index
  scf.if %writer {
    scf.for %iteration = [%begin to %end step %step] {
      scf.while {
        %ack = view.atomic.load %flag[0] {ordering = acquire, scope = workgroup} : view<1xi64> -> i64
        %pending = scalar.cmpi ne, %ack, %acknowledged : i64
        scf.condition %pending : i1
      } do {
        scf.yield
      }
      %ordinal = index.cast %iteration : index to i32
      %value = scalar.addi %ordinal, %bias : i32
      view.store %value, %global[0] : i32, view<1xi32>
      view.store %value, %local[0] : i32, view<1xi32>
      view.atomic.store %published, %flag[0] {ordering = release, scope = workgroup} : i64, view<1xi64>
    }
  }
  scf.if %reader {
    scf.for %iteration = [%begin to %end step %step] {
      scf.while {
        %ready = view.atomic.load %flag[0] {ordering = acquire, scope = workgroup} : view<1xi64> -> i64
        %pending = scalar.cmpi ne, %ready, %published : i64
        scf.condition %pending : i1
      } do {
        scf.yield
      }
      %global_value = view.load %global[0] : view<1xi32> -> i32
      %local_value = view.load %local[0] : view<1xi32> -> i32
      %local_index = index.add %iteration, %end : index
      view.store %global_value, %results[%iteration] : i32, view<32xi32>
      view.store %local_value, %results[%local_index] : i32, view<32xi32>
      view.atomic.store %acknowledged, %flag[0] {ordering = release, scope = workgroup} : i64, view<1xi64>
    }
  }
  kernel.return
}

check.case public @generic_workgroup_publication_values {
  %signal = check.generate.fill value(0) : tensor<1xi64>
  %payload = check.generate.fill value(-1) : tensor<1xi32>
  %output = check.generate.fill value(-1) : tensor<32xi32>
  kernel.launch @generic_workgroup_publication(%signal, %payload, %output) : (tensor<1xi64>, tensor<1xi32>, tensor<32xi32>)
  %global_values = check.tensor.view %output offset(0) : tensor<32xi32> -> tensor<16xi32>
  %local_values = check.tensor.view %output offset(64) : tensor<32xi32> -> tensor<16xi32>
  %expected = check.generate.iota offset(65536) step(1) : tensor<16xi32>
  check.expect.bitwise actual(%global_values) expected(%expected) : tensor<16xi32>
  check.expect.bitwise actual(%local_values) expected(%expected) : tensor<16xi32>
  check.return
}

check.case public @generic_atomic_indexed_values {
  %storage = check.generate.fill value(10) : tensor<16450xi32>
  %output = check.generate.fill value(-1) : tensor<128xi32>
  %start = check.literal value(1) : i32
  kernel.launch @generic_atomic_indexed_i32(%storage, %output, %start) : (tensor<16450xi32>, tensor<128xi32>, i32)
  %add_values = check.tensor.view %output offset(0) : tensor<128xi32> -> tensor<64xi32>
  %cas_values = check.tensor.view %output offset(256) : tensor<128xi32> -> tensor<64xi32>
  %expected_add = check.generate.fill value(13) : tensor<64xi32>
  %expected_cas = check.generate.fill value(18) : tensor<64xi32>
  check.expect.bitwise actual(%add_values) expected(%expected_add) : tensor<64xi32>
  check.expect.bitwise actual(%cas_values) expected(%expected_cas) : tensor<64xi32>
  %updated = check.tensor.view %storage offset(65540) : tensor<16450xi32> -> tensor<64xi32>
  %expected_updated = check.generate.fill value(21) : tensor<64xi32>
  check.expect.bitwise actual(%updated) expected(%expected_updated) : tensor<64xi32>
  %prefix = check.tensor.view %storage offset(65536) : tensor<16450xi32> -> tensor<1xi32>
  %suffix = check.tensor.view %storage offset(65796) : tensor<16450xi32> -> tensor<1xi32>
  %untouched = check.generate.fill value(10) : tensor<1xi32>
  check.expect.bitwise actual(%prefix) expected(%untouched) : tensor<1xi32>
  check.expect.bitwise actual(%suffix) expected(%untouched) : tensor<1xi32>
  check.return
}

check.case public @generic_atomic_uniform_values {
  %storage = check.generate.fill value(10) : tensor<10xi64>
  %output = check.generate.fill value(-1) : tensor<2xi64>
  %position = check.literal value(3) : i32
  kernel.launch @generic_atomic_uniform_i64(%storage, %output, %position) : (tensor<10xi64>, tensor<2xi64>, i32)
  %add_value = check.tensor.view %output offset(0) : tensor<2xi64> -> tensor<1xi64>
  %cas_value = check.tensor.view %output offset(8) : tensor<2xi64> -> tensor<1xi64>
  %expected_add = check.generate.fill value(4294967306) : tensor<1xi64>
  %expected_cas = check.generate.fill value(8589934602) : tensor<1xi64>
  check.expect.bitwise actual(%add_value) expected(%expected_add) : tensor<1xi64>
  check.expect.bitwise actual(%cas_value) expected(%expected_cas) : tensor<1xi64>
  %updated = check.tensor.view %storage offset(40) : tensor<10xi64> -> tensor<1xi64>
  %expected_updated = check.generate.fill value(99) : tensor<1xi64>
  check.expect.bitwise actual(%updated) expected(%expected_updated) : tensor<1xi64>
  %prefix = check.tensor.view %storage offset(0) : tensor<10xi64> -> tensor<5xi64>
  %suffix = check.tensor.view %storage offset(48) : tensor<10xi64> -> tensor<4xi64>
  %untouched_prefix = check.generate.fill value(10) : tensor<5xi64>
  %untouched_suffix = check.generate.fill value(10) : tensor<4xi64>
  check.expect.bitwise actual(%prefix) expected(%untouched_prefix) : tensor<5xi64>
  check.expect.bitwise actual(%suffix) expected(%untouched_suffix) : tensor<4xi64>
  check.return
}
