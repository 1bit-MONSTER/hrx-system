check.case public @address_widening_maximum {
  %uniform_input = check.literal value(2147483647) : i32
  %input = check.generate.iota offset(2147483584) step(1) : tensor<64xi32>
  %storage = check.generate.fill value(-123) : tensor<288xi64>
