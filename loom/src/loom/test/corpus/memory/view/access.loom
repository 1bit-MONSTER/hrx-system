func.def @indexed_view_bytes(%base_value: i64, %row_value: i64, %column_value: i64, %pattern: i32) -> (i32, i32) {
  %length = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<private> align(8) %length : buffer
  %clear = scalar.constant 0 : i32
  buffer.fill %clear, %storage[%origin], %length : i32
  %base_input = scalar.assume %base_value [range(%base_value, 0, 13)] : i64
  %base = index.cast %base_input : i64 to offset
  %row_input = index.cast %row_value : i64 to index
  %column_input = index.cast %column_value : i64 to index
  %row = index.assume %row_input [range(%row_input, 0, 2)] : index
  %column = index.assume %column_input [range(%column_input, 0, 3)] : index
  %matrix = buffer.view %storage[%base] : buffer -> view<3x4xi32>
  view.store %pattern, %matrix[%row, %column] : i32, view<3x4xi32>
  %loaded = view.load %matrix[%row, %column] : view<3x4xi32> -> i32
  %element_bytes = index.constant 4 : index
  %linear = index.madd %row, %element_bytes, %column : index
  %bytes = index.mul %linear, %element_bytes : index
  %offset = index.cast %bytes : index to offset
  %address = index.add %base, %offset : offset
  %byte = buffer.load.i8.u %storage[%address]
  func.return %loaded, %byte : i32, i32
}

func.def @reverse_view_bytes(%index_value: i64, %pattern: i32) -> (i32, i32) {
  %length = index.constant 16 : offset
  %origin = index.constant 0 : offset
  %last_word = index.constant 12 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %clear = scalar.constant 0 : i32
  buffer.fill %clear, %storage[%origin], %length : i32
  %index_input = index.cast %index_value : i64 to index
  %index = index.assume %index_input [range(%index_input, 0, 3)] : index
  %element_bytes = index.constant 4 : index
  %bytes = index.mul %index, %element_bytes : index
  %offset = index.cast %bytes : index to offset
  %address = index.sub %last_word, %offset : offset
  %selected = buffer.view %storage[%address] : buffer -> view<1xi32>
  view.store %pattern, %selected[0] : i32, view<1xi32>
  %loaded = view.load %selected[0] : view<1xi32> -> i32
  %byte = buffer.load.i8.u %storage[%address]
  func.return %loaded, %byte : i32, i32
}

func.def @view_payloads(%input_i8: i8, %input_i16: i16, %input_i32: i32, %input_i64: i64, %input_f8E4M3: f8E4M3, %input_f8E5M2: f8E5M2, %input_f16: f16, %input_bf16: bf16, %input_f32: f32, %input_f64: f64) -> (i8, i16, i32, i64, f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %length = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<private> align(8) %length : buffer
  %view_i8 = buffer.view %storage[%origin] : buffer -> view<64xi8>
  view.store %input_i8, %view_i8[0] : i8, view<64xi8>
  %view_i16 = buffer.view %storage[%origin] : buffer -> view<32xi16>
  view.store %input_i16, %view_i16[1] : i16, view<32xi16>
  %view_i32 = buffer.view %storage[%origin] : buffer -> view<16xi32>
  view.store %input_i32, %view_i32[1] : i32, view<16xi32>
  %view_i64 = buffer.view %storage[%origin] : buffer -> view<8xi64>
  view.store %input_i64, %view_i64[1] : i64, view<8xi64>
  %view_f8E4M3 = buffer.view %storage[%origin] : buffer -> view<64xf8E4M3>
  view.store %input_f8E4M3, %view_f8E4M3[16] : f8E4M3, view<64xf8E4M3>
  %view_f8E5M2 = buffer.view %storage[%origin] : buffer -> view<64xf8E5M2>
  view.store %input_f8E5M2, %view_f8E5M2[17] : f8E5M2, view<64xf8E5M2>
  %view_f16 = buffer.view %storage[%origin] : buffer -> view<32xf16>
  view.store %input_f16, %view_f16[9] : f16, view<32xf16>
  %view_bf16 = buffer.view %storage[%origin] : buffer -> view<32xbf16>
  view.store %input_bf16, %view_bf16[10] : bf16, view<32xbf16>
  %view_f32 = buffer.view %storage[%origin] : buffer -> view<16xf32>
  view.store %input_f32, %view_f32[6] : f32, view<16xf32>
  %view_f64 = buffer.view %storage[%origin] : buffer -> view<8xf64>
  view.store %input_f64, %view_f64[4] : f64, view<8xf64>
  %loaded_i8 = view.load %view_i8[0] : view<64xi8> -> i8
  %loaded_i16 = view.load %view_i16[1] : view<32xi16> -> i16
  %loaded_i32 = view.load %view_i32[1] : view<16xi32> -> i32
  %loaded_i64 = view.load %view_i64[1] : view<8xi64> -> i64
  %loaded_f8E4M3 = view.load %view_f8E4M3[16] : view<64xf8E4M3> -> f8E4M3
  %loaded_f8E5M2 = view.load %view_f8E5M2[17] : view<64xf8E5M2> -> f8E5M2
  %loaded_f16 = view.load %view_f16[9] : view<32xf16> -> f16
  %loaded_bf16 = view.load %view_bf16[10] : view<32xbf16> -> bf16
  %loaded_f32 = view.load %view_f32[6] : view<16xf32> -> f32
  %loaded_f64 = view.load %view_f64[4] : view<8xf64> -> f64
  func.return %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64, %loaded_f8E4M3, %loaded_f8E5M2, %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64 : i8, i16, i32, i64, f8E4M3, f8E5M2, f16, bf16, f32, f64
}

func.def @view_tail_sum(%column_count: i64, %pattern: i32) -> (i32, i32) {
  %column_input = index.cast %column_count : i64 to index
  %columns = index.assume %column_input [range(%column_input, 1, 4)] : index
  %length = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %base = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %clear = scalar.constant 0 : i32
  buffer.fill %clear, %storage[%origin], %length : i32
  %matrix = buffer.view %storage[%base] : buffer -> view<2x[%columns]xi32>
  %tail = view.subview %matrix[1, 0] : view<2x[%columns]xi32> -> view<1x[%columns]xi32>
  %selected = view.refine %tail : view<1x[%columns]xi32> -> view<1x[%columns]xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %column = [%begin to %columns step %step] {
    %ordinal = index.cast %column : index to i32
    %value = scalar.addi %pattern, %ordinal : i32
    view.store %value, %selected[0, %column] : i32, view<1x[%columns]xi32>
  }
  %sum = scf.for %column = [%begin to %columns step %step](%partial = %clear : i32) -> (i32) {
    %value = view.load %matrix[1, %column] : view<2x[%columns]xi32> -> i32
    %next = scalar.addi %partial, %value : i32
    scf.yield %next : i32
  }
  %element_bytes = index.constant 4 : index
  %row_bytes = index.mul %columns, %element_bytes : index
  %row_offset = index.cast %row_bytes : index to offset
  %address = index.add %base, %row_offset : offset
  %byte = buffer.load.i8.u %storage[%address]
  func.return %sum, %byte : i32, i32
}

func.def inline @view_address_configuration(%config: i64) -> (i64, i64, i64, i64, i64) {
  %selector_mask = scalar.constant 3 : i64
  %base_selector = scalar.andi %config, %selector_mask : i64
  %base_shift = scalar.constant 2 : i64
  %base_scaled = scalar.shli %base_selector, %base_shift : i64
  %last_base_selector = scalar.cmpi eq, %base_selector, %selector_mask : i64
  %last_base = scalar.constant 13 : i64
  %base = scf.select %last_base_selector, %last_base, %base_scaled : i64
  %row_shifted = scalar.shrui %config, %base_shift : i64
  %row_selector = scalar.andi %row_shifted, %selector_mask : i64
  %row_limit = scalar.constant 2 : i64
  %row = scalar.minui %row_selector, %row_limit : i64
  %column_shift = scalar.constant 4 : i64
  %column_shifted = scalar.shrui %config, %column_shift : i64
  %column = scalar.andi %column_shifted, %selector_mask : i64
  %reverse_shift = scalar.constant 6 : i64
  %reverse_shifted = scalar.shrui %config, %reverse_shift : i64
  %reverse = scalar.andi %reverse_shifted, %selector_mask : i64
  %count_shift = scalar.constant 8 : i64
  %count_shifted = scalar.shrui %config, %count_shift : i64
  %count_base = scalar.andi %count_shifted, %selector_mask : i64
  %count_bias = scalar.constant 1 : i64
  %count = scalar.addi %count_base, %count_bias : i64
  func.return %base, %row, %column, %reverse, %count : i64, i64, i64, i64, i64
}

func.def @view_address_observations(%config: i64, %pattern_entropy: i64, %output: buffer) {
  %base, %row, %column, %reverse_index, %column_count = func.call @view_address_configuration(%config) : (i64) -> (i64, i64, i64, i64, i64)
  %pattern = scalar.trunci %pattern_entropy : i64 to i32
  %indexed_value, %indexed_byte = func.call @indexed_view_bytes(%base, %row, %column, %pattern) : (i64, i64, i64, i32) -> (i32, i32)
  %reverse_value, %reverse_byte = func.call @reverse_view_bytes(%reverse_index, %pattern) : (i64, i32) -> (i32, i32)
  %tail_sum, %tail_byte = func.call @view_tail_sum(%column_count, %pattern) : (i64, i32) -> (i32, i32)
  %values = vector.from_elements %indexed_value, %indexed_byte, %reverse_value, %reverse_byte, %tail_sum, %tail_byte : vector<6xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<6xi32>
  vector.store %values, %results[0] : vector<6xi32>, view<6xi32>
  func.return
}

func.def @view_payload_observations(%ordinal: index, %payload_entropy: i64, %output: buffer) {
  %ordinal_bits = index.cast %ordinal : index to i64
  %mixed_bits = scalar.xori %payload_entropy, %ordinal_bits : i64
  %input_i8 = scalar.trunci %ordinal_bits : i64 to i8
  %input_i16 = scalar.trunci %mixed_bits : i64 to i16
  %input_i32 = scalar.trunci %mixed_bits : i64 to i32
  %input_f8_bits = scalar.trunci %ordinal_bits : i64 to i8
  %input_f8E4M3 = scalar.bitcast %input_f8_bits : i8 to f8E4M3
  %input_f8E5M2 = scalar.bitcast %input_f8_bits : i8 to f8E5M2
  %input_f16_bits = scalar.trunci %mixed_bits : i64 to i16
  %input_f16 = scalar.bitcast %input_f16_bits : i16 to f16
  %input_bf16 = scalar.bitcast %input_f16_bits : i16 to bf16
  %input_f32_bits = scalar.trunci %mixed_bits : i64 to i32
  %input_f32 = scalar.bitcast %input_f32_bits : i32 to f32
  %input_f64 = scalar.bitcast %mixed_bits : i64 to f64
  %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64, %loaded_f8E4M3, %loaded_f8E5M2, %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64 = func.call @view_payloads(%input_i8, %input_i16, %input_i32, %payload_entropy, %input_f8E4M3, %input_f8E5M2, %input_f16, %input_bf16, %input_f32, %input_f64) : (i8, i16, i32, i64, f8E4M3, f8E5M2, f16, bf16, f32, f64) -> (i8, i16, i32, i64, f8E4M3, f8E5M2, f16, bf16, f32, f64)
  %bits_i8 = scalar.extui %loaded_i8 : i8 to i64
  %bits_i16 = scalar.extui %loaded_i16 : i16 to i64
  %bits_i32 = scalar.extui %loaded_i32 : i32 to i64
  %bits_f8E4M3_narrow = scalar.bitcast %loaded_f8E4M3 : f8E4M3 to i8
  %bits_f8E4M3 = scalar.extui %bits_f8E4M3_narrow : i8 to i64
  %bits_f8E5M2_narrow = scalar.bitcast %loaded_f8E5M2 : f8E5M2 to i8
  %bits_f8E5M2 = scalar.extui %bits_f8E5M2_narrow : i8 to i64
  %bits_f16_narrow = scalar.bitcast %loaded_f16 : f16 to i16
  %bits_f16 = scalar.extui %bits_f16_narrow : i16 to i64
  %bits_bf16_narrow = scalar.bitcast %loaded_bf16 : bf16 to i16
  %bits_bf16 = scalar.extui %bits_bf16_narrow : i16 to i64
  %bits_f32_narrow = scalar.bitcast %loaded_f32 : f32 to i32
  %bits_f32 = scalar.extui %bits_f32_narrow : i32 to i64
  %bits_f64 = scalar.bitcast %loaded_f64 : f64 to i64
  %values = vector.from_elements %bits_i8, %bits_i16, %bits_i32, %loaded_i64, %bits_f8E4M3, %bits_f8E5M2, %bits_f16, %bits_bf16, %bits_f32, %bits_f64 : vector<10xi64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<10xi64>
  vector.store %values, %results[0] : vector<10xi64>, view<10xi64>
  func.return
}

check.scenario @view_address_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %config_source = check.entropy.fork %entropy name("config") : check.entropy
    %pattern_source = check.entropy.fork %entropy name("pattern") : check.entropy
    %config = check.entropy.read %config_source[%trial] : check.entropy -> i64
    %pattern = check.entropy.read %pattern_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<6xi32>
    check.compare<@view_address_observations>(%config, %pattern, %output) : (i64, i64, tensor<6xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6xi32>
    }
  }
  check.return
}

check.scenario @view_payload_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %payload_source = check.entropy.fork %entropy name("payload") : check.entropy
    %payload = check.entropy.read %payload_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<10xi64>
    check.compare<@view_payload_observations>(%trial, %payload, %output) : (index, i64, tensor<10xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<10xi64>
    }
  }
  check.return
}
