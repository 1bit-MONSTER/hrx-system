// Positive vector-axis strides preserve raw payloads across every
// byte-addressable carrier family. The widest byte vector reaches the target
// packet-count boundary once; adjacent carrier types use smaller vectors.

kernel.def @strided_vector_bytes() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %e4m3_input_base = index.constant 64 : offset
  %e5m2_input_base = index.constant 69 : offset
  %i8_output_base = index.constant 1 : offset
  %e4m3_output_base = index.constant 65 : offset
  %e5m2_output_base = index.constant 70 : offset
  %e4m3_scratch_base = index.constant 192 : offset
  %e5m2_scratch_base = index.constant 208 : offset
  %scratch_bytes = index.constant 224 : offset
  %layout = encoding.layout.strided [1, 3] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer

  %i8_input = buffer.view %input[%base] : buffer -> view<64xi8>
  %e4m3_input = buffer.view %input[%e4m3_input_base] : buffer -> view<5xf8E4M3>
  %e5m2_input = buffer.view %input[%e5m2_input_base] : buffer -> view<5xf8E5M2>
  %i8_scratch = buffer.view %scratch[%base] : buffer -> view<1x64xi8, %layout>
  %e4m3_scratch = buffer.view %scratch[%e4m3_scratch_base] : buffer -> view<1x5xf8E4M3, %layout>
  %e5m2_scratch = buffer.view %scratch[%e5m2_scratch_base] : buffer -> view<1x5xf8E5M2, %layout>
  %i8_output = buffer.view %output[%i8_output_base] : buffer -> view<64xi8>
  %e4m3_output = buffer.view %output[%e4m3_output_base] : buffer -> view<5xf8E4M3>
  %e5m2_output = buffer.view %output[%e5m2_output_base] : buffer -> view<5xf8E5M2>

  %i8 = vector.load %i8_input[0] : view<64xi8> -> vector<64xi8>
  vector.store<volatile> %i8, %i8_scratch[0, 0] : vector<64xi8>, view<1x64xi8, %layout>
  %i8_staged = vector.load<volatile> %i8_scratch[0, 0] : view<1x64xi8, %layout> -> vector<64xi8>
  vector.store %i8_staged, %i8_output[0] : vector<64xi8>, view<64xi8>

  %e4m3 = vector.load %e4m3_input[0] : view<5xf8E4M3> -> vector<5xf8E4M3>
  vector.store<volatile> %e4m3, %e4m3_scratch[0, 0] : vector<5xf8E4M3>, view<1x5xf8E4M3, %layout>
  %e4m3_staged = vector.load<volatile> %e4m3_scratch[0, 0] : view<1x5xf8E4M3, %layout> -> vector<5xf8E4M3>
  vector.store %e4m3_staged, %e4m3_output[0] : vector<5xf8E4M3>, view<5xf8E4M3>

  %e5m2 = vector.load %e5m2_input[0] : view<5xf8E5M2> -> vector<5xf8E5M2>
  vector.store<volatile> %e5m2, %e5m2_scratch[0, 0] : vector<5xf8E5M2>, view<1x5xf8E5M2, %layout>
  %e5m2_staged = vector.load<volatile> %e5m2_scratch[0, 0] : view<1x5xf8E5M2, %layout> -> vector<5xf8E5M2>
  vector.store %e5m2_staged, %e5m2_output[0] : vector<5xf8E5M2>, view<5xf8E5M2>
  kernel.return
}

kernel.def @strided_vector_halfwords() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %f16_input_base = index.constant 20 : offset
  %bf16_input_base = index.constant 30 : offset
  %i16_output_base = index.constant 2 : offset
  %f16_output_base = index.constant 22 : offset
  %bf16_output_base = index.constant 32 : offset
  %f16_scratch_base = index.constant 64 : offset
  %bf16_scratch_base = index.constant 96 : offset
  %scratch_bytes = index.constant 128 : offset
  %layout = encoding.layout.strided [1, 3] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer

  %i16_input = buffer.view %input[%base] : buffer -> view<10xi16>
  %f16_input = buffer.view %input[%f16_input_base] : buffer -> view<5xf16>
  %bf16_input = buffer.view %input[%bf16_input_base] : buffer -> view<5xbf16>
  %i16_scratch = buffer.view %scratch[%base] : buffer -> view<1x10xi16, %layout>
  %f16_scratch = buffer.view %scratch[%f16_scratch_base] : buffer -> view<1x5xf16, %layout>
  %bf16_scratch = buffer.view %scratch[%bf16_scratch_base] : buffer -> view<1x5xbf16, %layout>
  %i16_output = buffer.view %output[%i16_output_base] : buffer -> view<10xi16>
  %f16_output = buffer.view %output[%f16_output_base] : buffer -> view<5xf16>
  %bf16_output = buffer.view %output[%bf16_output_base] : buffer -> view<5xbf16>

  %i16 = vector.load %i16_input[0] : view<10xi16> -> vector<10xi16>
  vector.store<volatile> %i16, %i16_scratch[0, 0] : vector<10xi16>, view<1x10xi16, %layout>
  %i16_staged = vector.load<volatile> %i16_scratch[0, 0] : view<1x10xi16, %layout> -> vector<10xi16>
  vector.store %i16_staged, %i16_output[0] : vector<10xi16>, view<10xi16>

  %f16 = vector.load %f16_input[0] : view<5xf16> -> vector<5xf16>
  vector.store<volatile> %f16, %f16_scratch[0, 0] : vector<5xf16>, view<1x5xf16, %layout>
  %f16_staged = vector.load<volatile> %f16_scratch[0, 0] : view<1x5xf16, %layout> -> vector<5xf16>
  vector.store %f16_staged, %f16_output[0] : vector<5xf16>, view<5xf16>

  %bf16 = vector.load %bf16_input[0] : view<5xbf16> -> vector<5xbf16>
  vector.store<volatile> %bf16, %bf16_scratch[0, 0] : vector<5xbf16>, view<1x5xbf16, %layout>
  %bf16_staged = vector.load<volatile> %bf16_scratch[0, 0] : view<1x5xbf16, %layout> -> vector<5xbf16>
  vector.store %bf16_staged, %bf16_output[0] : vector<5xbf16>, view<5xbf16>
  kernel.return
}

