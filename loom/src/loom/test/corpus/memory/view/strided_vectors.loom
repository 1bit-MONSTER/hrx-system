// Every AMDGPU address domain uses the same logical three-lane vector while
// retaining its distinct packet form. Constant memory is read-only.
kernel.def @strided_vector_address_spaces() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %descriptor_base = index.constant 24 : offset
  %constant_base = index.constant 48 : offset
  %scratch_bytes = index.constant 20 : offset
  %layout = encoding.layout.strided [1, 2] : encoding<layout>
  %global_input = buffer.assume.memory_space<global> %input : buffer
  %descriptor_input = buffer.assume.memory_space<descriptor> %input : buffer
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %generic_output = buffer.assume.memory_space<generic> %output : buffer
  %descriptor_output = buffer.assume.memory_space<descriptor> %output : buffer
  %global_output = buffer.assume.memory_space<global> %output : buffer
  %scratch = buffer.alloca<private> align(4) %scratch_bytes : buffer
  %input_view = buffer.view %global_input[%base] : buffer -> view<1x3xi32, %layout>
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1x3xi32, %layout>
  %output_view = buffer.view %generic_output[%base] : buffer -> view<1x3xi32, %layout>
  %descriptor_input_view = buffer.view %descriptor_input[%descriptor_base] : buffer -> view<1x3xi32, %layout>
  %descriptor_output_view = buffer.view %descriptor_output[%descriptor_base] : buffer -> view<1x3xi32, %layout>
  %constant_input_view = buffer.view %constant_input[%constant_base] : buffer -> view<1x3xi32, %layout>
  %global_output_view = buffer.view %global_output[%constant_base] : buffer -> view<1x3xi32, %layout>
  %value = vector.load<volatile> %input_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store<volatile> %value, %scratch_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  %staged = vector.load<volatile> %scratch_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store<volatile> %staged, %output_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  %descriptor_value = vector.load<volatile> %descriptor_input_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store<volatile> %descriptor_value, %descriptor_output_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  %constant_value = vector.load<volatile> %constant_input_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store<volatile> %constant_value, %global_output_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  kernel.return
}

func.def @copy_centered_span_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %input_length = buffer.length %input
  %output_length = buffer.length %output
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %bounded_output_length = index.assume %output_length [range(%output_length, 0, 9223372036854775807)] : offset
  %input_extent = index.cast %bounded_input_length : offset to index
  %output_extent = index.cast %bounded_output_length : offset to index
  %guard_span = index.sub %output_extent, %input_extent : index
  %guard_index = index.div %guard_span, %c2 : index
  %bounded_guard = index.assume %guard_index [range(%guard_index, 0, 9223372036854775807)] : index
  %guard = index.cast %bounded_guard : index to offset
  buffer.copy %input[%origin], %output[%guard], %input_length
  func.return
}

func.def @strided_vector_address_spaces_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %descriptor_base = index.constant 24 : offset
  %constant_base = index.constant 48 : offset
  %layout = encoding.layout.strided [1, 2] : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<1x3xi32, %layout>
  %output_view = buffer.view %output[%base] : buffer -> view<1x3xi32, %layout>
  %descriptor_input_view = buffer.view %input[%descriptor_base] : buffer -> view<1x3xi32, %layout>
  %descriptor_output_view = buffer.view %output[%descriptor_base] : buffer -> view<1x3xi32, %layout>
  %constant_input_view = buffer.view %input[%constant_base] : buffer -> view<1x3xi32, %layout>
  %constant_output_view = buffer.view %output[%constant_base] : buffer -> view<1x3xi32, %layout>
  %value = vector.load %input_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store %value, %output_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  %descriptor_value = vector.load %descriptor_input_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store %descriptor_value, %descriptor_output_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  %constant_value = vector.load %constant_input_view[0, 0] : view<1x3xi32, %layout> -> vector<3xi32>
  vector.store %constant_value, %constant_output_view[0, 0] : vector<3xi32>, view<1x3xi32, %layout>
  func.return
}

check.scenario @strided_vector_byte_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(3) : tensor<74xi8>
    %output = check.generate.fill value(91) : tensor<76xi8>
    check.compare<@strided_vector_bytes, @copy_centered_span_oracle>(%input, %output) : (tensor<74xi8>, tensor<76xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<74xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<76xi8>
    }
  }
  check.return
}

