check.scenario @strided_vector_address_space_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2147483648) step(268435455) : tensor<17xi32>
    %output = check.generate.fill value(1515870810) : tensor<17xi32>
    check.compare<@strided_vector_address_spaces, @strided_vector_address_spaces_oracle>(%input, %output) : (tensor<17xi32>, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<17xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
    }
  }
  check.return
}
