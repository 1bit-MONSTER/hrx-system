  vector.store<volatile> %i64, %i64_scratch[0, 0] : vector<3xi64>, view<1x3xi64, %layout>
  %i64_staged = vector.load<volatile> %i64_scratch[0, 0] : view<1x3xi64, %layout> -> vector<3xi64>
