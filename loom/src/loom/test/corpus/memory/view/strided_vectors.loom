  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(3000) : tensor<20xi16>
    %output = check.generate.fill value(23130) : tensor<22xi16>
    check.compare<@strided_vector_halfwords, @copy_centered_span_oracle>(%input, %output) : (tensor<20xi16>, tensor<22xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<20xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<22xi16>
