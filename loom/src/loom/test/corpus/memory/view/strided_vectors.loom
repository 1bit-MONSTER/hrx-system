kernel.def @strided_vector_doublewords() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %f64_input_base = index.constant 24 : offset
  %i64_output_base = index.constant 8 : offset
  %f64_output_base = index.constant 32 : offset
  %f64_scratch_base = index.constant 64 : offset
  %scratch_bytes = index.constant 128 : offset
