// The same allocation supplies every slot across loop entry, backedges, and
// live exit results. Each slot carries a distinct record number.

func.def @rotate_private_views_for_u1(%count_input: index, %seed: i32) -> (i32, i32, i32, i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %length = index.constant 16 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %unroll = index.constant 1 : index
  %last0, %last1, %last2, %last3 = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>) unroll(%unroll) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %current0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    scf.yield %current1, %current2, %current3, %refined : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  %value1 = view.load %last1[0] : view<1xi32> -> i32
  %value2 = view.load %last2[0] : view<1xi32> -> i32
  %value3 = view.load %last3[0] : view<1xi32> -> i32
  func.return %value0, %value1, %value2, %value3 : i32, i32, i32, i32
}

func.def @rotate_private_views_for_u2(%count_input: index, %seed: i32) -> (i32, i32, i32, i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %length = index.constant 16 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %unroll = index.constant 2 : index
  %last0, %last1, %last2, %last3 = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>) unroll(%unroll) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %current0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    scf.yield %current1, %current2, %current3, %refined : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  %value1 = view.load %last1[0] : view<1xi32> -> i32
  %value2 = view.load %last2[0] : view<1xi32> -> i32
  %value3 = view.load %last3[0] : view<1xi32> -> i32
  func.return %value0, %value1, %value2, %value3 : i32, i32, i32, i32
}

func.def @rotate_private_views_while(%count_input: index, %seed: i32) -> (i32, i32, i32, i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %length = index.constant 16 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %last0, %last1, %last2, %last3, %last_i = scf.while(%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>, %i = %begin : index) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>, index) {
    %more = index.cmp slt, %i, %count : index
    scf.condition %more, %current0, %current1, %current2, %current3, %i : i1, view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>, index
  } do(%active0: view<1xi32>, %active1: view<1xi32>, %active2: view<1xi32>, %active3: view<1xi32>, %record: index) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %active0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    %next = index.add %record, %step : index
    scf.yield %active1, %active2, %active3, %active0, %next : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>, index
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  %value1 = view.load %last1[0] : view<1xi32> -> i32
  %value2 = view.load %last2[0] : view<1xi32> -> i32
  %value3 = view.load %last3[0] : view<1xi32> -> i32
  func.return %value0, %value1, %value2, %value3 : i32, i32, i32, i32
}

func.def @rotation_observations(%ordinal: index, %seed_entropy: i64, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %count0 = index.constant 0 : index
  %count1 = index.constant 1 : index
  %count2 = index.constant 2 : index
  %count3 = index.constant 3 : index
  %count4 = index.constant 8 : index
  %count5 = index.constant 257 : index
  %selected0 = scf.select %is0, %count0, %count5 : index
  %selected1 = scf.select %is1, %count1, %selected0 : index
  %selected2 = scf.select %is2, %count2, %selected1 : index
  %selected3 = scf.select %is3, %count3, %selected2 : index
  %count = scf.select %is4, %count4, %selected3 : index
  %seed = scalar.trunci %seed_entropy : i64 to i32
  %u1_0, %u1_1, %u1_2, %u1_3 = func.call @rotate_private_views_for_u1(%count, %seed) : (index, i32) -> (i32, i32, i32, i32)
  %u2_0, %u2_1, %u2_2, %u2_3 = func.call @rotate_private_views_for_u2(%count, %seed) : (index, i32) -> (i32, i32, i32, i32)
  %while0, %while1, %while2, %while3 = func.call @rotate_private_views_while(%count, %seed) : (index, i32) -> (i32, i32, i32, i32)
  %values = vector.from_elements %u1_0, %u1_1, %u1_2, %u1_3, %u2_0, %u2_1, %u2_2, %u2_3, %while0, %while1, %while2, %while3 : vector<12xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<12xi32>
  vector.store %values, %results[0] : vector<12xi32>, view<12xi32>
  func.return
}

check.scenario @rotation_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %seed_source = check.entropy.fork %entropy name("seed") : check.entropy
    %seed = check.entropy.read %seed_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<12xi32>
    check.compare<@rotation_observations>(%trial, %seed, %output) : (index, i64, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}
