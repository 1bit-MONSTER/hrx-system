// Nested selections preserve dynamic projections and SSA dependencies after
// structured side effects. Distinct initialized elements make root/offset
// mixups visible.

func.def noinline @derived_selection(%first: buffer, %second: buffer, %third: buffer, %position_input: index, %select_first: i1, %select_pair: i1) -> (i32) {
  %position = index.assume %position_input [range(%position_input, -1, 2)] : index
  %base0 = index.constant 4 : offset
  %base1 = index.constant 8 : offset
  %base2 = index.constant 12 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %third_aligned = buffer.assume.alignment %third {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%base0] : buffer -> view<4xi32>
  %second_view = buffer.view %second_aligned[%base1] : buffer -> view<4xi32>
  %third_view = buffer.view %third_aligned[%base2] : buffer -> view<1xi32>
  %pair = scf.select %select_first, %first_view, %second_view : view<4xi32>
  %refined = view.refine %pair : view<4xi32> -> view<4xi32>
  %part = view.subview %refined[%position] : view<4xi32> -> view<1xi32>
  %selected = scf.select %select_pair, %part, %third_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// Nested selections compose with structured side effects and explicit CFG.
func.def noinline @selection_with_side_effects(%first: buffer, %second: buffer, %third: buffer, %select_first: i1, %select_pair: i1, %enter: i1, %side: i1, %initial: i32) -> (i32) {
  %base = index.constant 0 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %third_aligned = buffer.assume.alignment %third {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%base] : buffer -> view<1xi32>
  %third_view = buffer.view %third_aligned[%base] : buffer -> view<1xi32>
  cfg.cond_br %enter, ^producer, ^exit
^producer:
  view.store %initial, %third_view[0] : i32, view<1xi32>
  scf.if %side {
    view.store %initial, %first_view[0] : i32, view<1xi32>
  }
  %pair = scf.select %select_first, %first_view, %second_view : view<1xi32>
  cfg.br ^consumer
^consumer:
  %selected = scf.select %select_pair, %pair, %third_view : view<1xi32>
  %result = view.load %selected[0] : view<1xi32> -> i32
  func.return %result : i32
^exit:
  func.return %initial : i32
}

func.def @read_nested_selections(%position: index, %select_first: i1, %select_pair: i1, %enter: i1, %side: i1) -> (i32, i32) {
  %bytes = index.constant 32 : offset
  %base = index.constant 0 : offset
  %first = buffer.alloca<private> align(4) %bytes : buffer
  %second = buffer.alloca<private> align(4) %bytes : buffer
  %third = buffer.alloca<private> align(4) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<8xi32>
  %second_view = buffer.view %second[%base] : buffer -> view<8xi32>
  %third_view = buffer.view %third[%base] : buffer -> view<8xi32>
  %first_bias = scalar.constant 100 : i32
  %second_bias = scalar.constant 200 : i32
  %third_bias = scalar.constant 300 : i32
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %element = [%begin to %end step %step] {
    %number = index.cast %element : index to i32
    %first_value = scalar.addi %first_bias, %number : i32
    %second_value = scalar.addi %second_bias, %number : i32
    %third_value = scalar.addi %third_bias, %number : i32
    view.store %first_value, %first_view[%element] : i32, view<8xi32>
    view.store %second_value, %second_view[%element] : i32, view<8xi32>
    view.store %third_value, %third_view[%element] : i32, view<8xi32>
  }
  %derived = func.call @derived_selection(%first, %second, %third, %position, %select_first, %select_pair) : (buffer, buffer, buffer, index, i1, i1) -> (i32)
  %initial = scalar.constant 99 : i32
  %ordered = func.call @selection_with_side_effects(%first, %second, %third, %select_first, %select_pair, %enter, %side, %initial) : (buffer, buffer, buffer, i1, i1, i1, i1, i32) -> (i32)
  func.return %derived, %ordered : i32, i32
}

func.def @nested_selection_observations(%ordinal: index, %output: buffer) {
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %in_first_group = index.cmp ult, %ordinal, %c16 : index
  %in_second_group = index.cmp ult, %ordinal, %c32 : index
  %before_base = index.constant -1 : index
  %low = index.constant 1 : index
  %high = index.constant 2 : index
  %nonnegative = scf.select %in_second_group, %low, %high : index
  %position = scf.select %in_first_group, %before_base, %nonnegative : index
  %ordinal_value = index.cast %ordinal : index to i32
  %inactive = scalar.constant 0 : i32
  %first_mask = scalar.constant 1 : i32
  %pair_mask = scalar.constant 2 : i32
  %enter_mask = scalar.constant 4 : i32
  %side_mask = scalar.constant 8 : i32
  %first_bits = scalar.andi %ordinal_value, %first_mask : i32
  %pair_bits = scalar.andi %ordinal_value, %pair_mask : i32
  %enter_bits = scalar.andi %ordinal_value, %enter_mask : i32
  %side_bits = scalar.andi %ordinal_value, %side_mask : i32
  %select_first = scalar.cmpi ne, %first_bits, %inactive : i32
  %select_pair = scalar.cmpi ne, %pair_bits, %inactive : i32
  %enter = scalar.cmpi ne, %enter_bits, %inactive : i32
  %side = scalar.cmpi ne, %side_bits, %inactive : i32
  %derived, %ordered = func.call @read_nested_selections(%position, %select_first, %select_pair, %enter, %side) : (index, i1, i1, i1, i1) -> (i32, i32)
  %values = vector.from_elements %derived, %ordered : vector<2xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %values, %results[0] : vector<2xi32>, view<2xi32>
  func.return
}

check.scenario @nested_selection_values {
  check.trial[48](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0) : tensor<2xi32>
    check.compare<@nested_selection_observations>(%trial, %output) : (index, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}
