func.def noinline @read_view(%input: view<1xi32>) -> (i32) {
  %value = view.load %input[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def noinline @choose_view(%left: view<1xi32>, %right: view<1xi32>, %choose_right: i1) -> (view<1xi32>) {
  %selected = scf.select %choose_right, %right, %left : view<1xi32>
  func.return %selected : view<1xi32>
}

func.def noinline @choose_nested_view(%left: view<1xi32>, %middle: view<1xi32>, %right: view<1xi32>, %choose_middle: i1, %choose_right: i1) -> (view<1xi32>) {
  %left_or_middle = scf.select %choose_middle, %middle, %left : view<1xi32>
  %selected = scf.select %choose_right, %right, %left_or_middle : view<1xi32>
  func.return %selected : view<1xi32>
}

func.def @call_view_argument(%seed: i32) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %byte_length : buffer
  %view = buffer.view %storage[%byte_offset] : buffer -> view<1xi32>
  view.store %seed, %view[0] : i32, view<1xi32>
  %value = func.call @read_view(%view) : (view<1xi32>) -> (i32)
  func.return %value : i32
}

func.def @call_view_result(%left_value: i32, %right_value: i32, %choose_right: i1) -> (i32) {
  %byte_length = index.constant 8 : offset
  %left_offset = index.constant 0 : offset
  %right_offset = index.constant 4 : offset
  %left_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %right_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %left = buffer.view %left_storage[%left_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_storage[%right_offset] : buffer -> view<1xi32>
  view.store %left_value, %left[0] : i32, view<1xi32>
  view.store %right_value, %right[0] : i32, view<1xi32>
  %selected = func.call @choose_view(%left, %right, %choose_right) : (view<1xi32>, view<1xi32>, i1) -> (view<1xi32>)
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def @call_nested_view_result(%left_value: i32, %middle_value: i32, %right_value: i32, %choose_middle: i1, %choose_right: i1) -> (i32) {
  %byte_length = index.constant 12 : offset
  %left_offset = index.constant 0 : offset
  %middle_offset = index.constant 4 : offset
  %right_offset = index.constant 8 : offset
  %left_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %middle_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %right_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %left = buffer.view %left_storage[%left_offset] : buffer -> view<1xi32>
  %middle = buffer.view %middle_storage[%middle_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_storage[%right_offset] : buffer -> view<1xi32>
  view.store %left_value, %left[0] : i32, view<1xi32>
  view.store %middle_value, %middle[0] : i32, view<1xi32>
  view.store %right_value, %right[0] : i32, view<1xi32>
  %selected = func.call @choose_nested_view(%left, %middle, %right, %choose_middle, %choose_right) : (view<1xi32>, view<1xi32>, view<1xi32>, i1, i1) -> (view<1xi32>)
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def @carry_distinct_view(%count: index) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 0 : offset
  %first_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %second_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %first = buffer.view %first_storage[%byte_offset] : buffer -> view<1xi32>
  %second = buffer.view %second_storage[%byte_offset] : buffer -> view<1xi32>
  %first_value = scalar.constant 11 : i32
  %second_value = scalar.constant 29 : i32
  view.store %first_value, %first[0] : i32, view<1xi32>
  view.store %second_value, %second[0] : i32, view<1xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %last = scf.for %i = [%begin to %count step %step](%current = %first : view<1xi32>) -> (view<1xi32>) {
    scf.yield %second : view<1xi32>
  }
  %value = view.load %last[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def @rotate_distinct_views(%count: index) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 0 : offset
  %left_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %right_storage = buffer.alloca<private> align(4) %byte_length : buffer
  %left = buffer.view %left_storage[%byte_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_storage[%byte_offset] : buffer -> view<1xi32>
  %left_value = scalar.constant 11 : i32
  %right_value = scalar.constant 29 : i32
  view.store %left_value, %left[0] : i32, view<1xi32>
  view.store %right_value, %right[0] : i32, view<1xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %last_left, %last_right = scf.for %i = [%begin to %count step %step](%current_left = %left : view<1xi32>, %current_right = %right : view<1xi32>) -> (view<1xi32>, view<1xi32>) {
    scf.yield %current_right, %current_left : view<1xi32>, view<1xi32>
  }
  %final_left = view.load %last_left[0] : view<1xi32> -> i32
  %final_right = view.load %last_right[0] : view<1xi32> -> i32
  %scale = scalar.constant 100 : i32
  %scaled_left = scalar.muli %final_left, %scale : i32
  %result = scalar.addi %scaled_left, %final_right : i32
  func.return %result : i32
}

func.def @boundary_transport_observations(%ordinal: index, %left_entropy: i64, %middle_entropy: i64, %right_entropy: i64, %output: buffer) {
  %left = scalar.trunci %left_entropy : i64 to i32
  %middle = scalar.trunci %middle_entropy : i64 to i32
  %right = scalar.trunci %right_entropy : i64 to i32
  %ordinal_value = index.cast %ordinal : index to i32
  %inactive = scalar.constant 0 : i32
  %right_mask = scalar.constant 1 : i32
  %middle_mask = scalar.constant 2 : i32
  %right_bits = scalar.andi %ordinal_value, %right_mask : i32
  %middle_bits = scalar.andi %ordinal_value, %middle_mask : i32
  %choose_right = scalar.cmpi ne, %right_bits, %inactive : i32
  %choose_middle = scalar.cmpi ne, %middle_bits, %inactive : i32
  %argument = func.call @call_view_argument(%left) : (i32) -> (i32)
  %selected = func.call @call_view_result(%left, %right, %choose_right) : (i32, i32, i1) -> (i32)
  %nested = func.call @call_nested_view_result(%left, %middle, %right, %choose_middle, %choose_right) : (i32, i32, i32, i1, i1) -> (i32)
  %carry = func.call @carry_distinct_view(%ordinal) : (index) -> (i32)
  %rotation = func.call @rotate_distinct_views(%ordinal) : (index) -> (i32)
  %values = vector.from_elements %argument, %selected, %nested, %carry, %rotation : vector<5xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<5xi32>
  vector.store %values, %results[0] : vector<5xi32>, view<5xi32>
  func.return
}

check.scenario @boundary_transport_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %left_source = check.entropy.fork %entropy name("left") : check.entropy
    %middle_source = check.entropy.fork %entropy name("middle") : check.entropy
    %right_source = check.entropy.fork %entropy name("right") : check.entropy
    %left = check.entropy.read %left_source[%trial] : check.entropy -> i64
    %middle = check.entropy.read %middle_source[%trial] : check.entropy -> i64
    %right = check.entropy.read %right_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<5xi32>
    check.compare<@boundary_transport_observations>(%trial, %left, %middle, %right, %output) : (index, i64, i64, i64, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  check.return
}
