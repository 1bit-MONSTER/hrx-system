// A retained helper returns several projections of one selected coordinate.
func.def noinline @choose_crops(%left: view<8xi32>, %right: view<8xi32>, %choose_right: i1, %position: index) -> (view<1xi32>, view<1xi32>, view<1xi32>) where [range(%position, 0, 5)] {
  %selected = scf.select %choose_right, %right, %left : view<8xi32>
  %first = view.subview %selected[0] : view<8xi32> -> view<1xi32>
  %suffix = view.subview %selected[1] : view<8xi32> -> view<7xi32>
  %middle = view.subview %suffix[%position] : view<7xi32> -> view<1xi32>
  %last = view.subview %selected[6] : view<8xi32> -> view<1xi32>
  func.return %first, %middle, %last : view<1xi32>, view<1xi32>, view<1xi32>
}

func.def noinline @read_crop(%input: view<1xi32>) -> (i32) {
  %value = view.load %input[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def @call_selected_crops(%left_base_value: i64, %right_base_value: i64, %position_value: i64, %choice: i32) -> (i32, i32, i32, i32) {
  %false = scalar.constant 0 : i32
  %choose_right = scalar.cmpi ne, %choice, %false : i32
  %length = index.constant 64 : offset
  %c0 = index.constant 0 : offset
  %left_storage = buffer.alloca<private> align(4) %length : buffer
  %right_storage = buffer.alloca<private> align(4) %length : buffer
  %clear = scalar.constant 0 : i32
  buffer.fill %clear, %left_storage[%c0], %length : i32
  buffer.fill %clear, %right_storage[%c0], %length : i32
  %left_input = scalar.assume %left_base_value [range(%left_base_value, 0, 16)] : i64
  %right_input = scalar.assume %right_base_value [range(%right_base_value, 0, 12)] : i64
  %left_base = index.cast %left_input : i64 to offset
  %right_base = index.cast %right_input : i64 to offset
  %position_input = scalar.assume %position_value [range(%position_value, 0, 5)] : i64
  %position = index.cast %position_input : i64 to index
  %left = buffer.view %left_storage[%left_base] : buffer -> view<8xi32>
  %right = buffer.view %right_storage[%right_base] : buffer -> view<8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %left_seed = scalar.constant 100 : i32
  %right_seed = scalar.constant 200 : i32
  scf.for %i = [%begin to %end step %step] {
    %index = index.cast %i : index to i32
    %left_value = scalar.addi %left_seed, %index : i32
    %right_value = scalar.addi %right_seed, %index : i32
    view.store %left_value, %left[%i] : i32, view<8xi32>
    view.store %right_value, %right[%i] : i32, view<8xi32>
  }
  %first, %middle, %last = func.call @choose_crops(%left, %right, %choose_right, %position) : (view<8xi32>, view<8xi32>, i1, index) -> (view<1xi32>, view<1xi32>, view<1xi32>)
  %first_value = func.call @read_crop(%first) : (view<1xi32>) -> (i32)
  %middle_value = func.call @read_crop(%middle) : (view<1xi32>) -> (i32)
  %last_value = func.call @read_crop(%last) : (view<1xi32>) -> (i32)
  // Reversing the actuals keeps the second call's selected root independent.
  %other_first, %other_middle, %other_last = func.call @choose_crops(%right, %left, %choose_right, %position) : (view<8xi32>, view<8xi32>, i1, index) -> (view<1xi32>, view<1xi32>, view<1xi32>)
  %other_value = func.call @read_crop(%other_middle) : (view<1xi32>) -> (i32)
  func.return %first_value, %middle_value, %last_value, %other_value : i32, i32, i32, i32
}

// Independent arithmetic oracle for the initialized storage and crop positions.
func.def @expected_crops(%position: i64, %choice: i32) -> (i32, i32, i32, i32) {
  %c0 = scalar.constant 0 : i32
  %choose_right = scalar.cmpi ne, %choice, %c0 : i32
  %left = scalar.constant 100 : i32
  %right = scalar.constant 200 : i32
  %seed = scf.select %choose_right, %right, %left : i32
  %other_seed = scf.select %choose_right, %left, %right : i32
  %index = scalar.trunci %position : i64 to i32
  %c1 = scalar.constant 1 : i32
  %c6 = scalar.constant 6 : i32
  %displacement = scalar.addi %index, %c1 : i32
  %expected_middle = scalar.addi %seed, %displacement : i32
  %expected_last = scalar.addi %seed, %c6 : i32
  %expected_other = scalar.addi %other_seed, %displacement : i32
  func.return %seed, %expected_middle, %expected_last, %expected_other : i32, i32, i32, i32
}

func.def inline @selected_crop_configuration(%config: i64) -> (i64, i64, i64, i32) {
  %selector_mask = scalar.constant 3 : i64
  %left_selector = scalar.andi %config, %selector_mask : i64
  %left_shift = scalar.constant 2 : i64
  %left_scaled = scalar.shli %left_selector, %left_shift : i64
  %last_selector = scalar.cmpi eq, %left_selector, %selector_mask : i64
  %left_last = scalar.constant 16 : i64
  %left_base = scf.select %last_selector, %left_last, %left_scaled : i64
  %right_shifted = scalar.shrui %config, %left_shift : i64
  %bit_mask = scalar.constant 1 : i64
  %right_selector = scalar.andi %right_shifted, %bit_mask : i64
  %right_scale = scalar.constant 12 : i64
  %right_base = scalar.muli %right_selector, %right_scale : i64
  %position_shift = scalar.constant 3 : i64
  %position_shifted = scalar.shrui %config, %position_shift : i64
  %position_mask = scalar.constant 7 : i64
  %position_selector = scalar.andi %position_shifted, %position_mask : i64
  %position_limit = scalar.constant 5 : i64
  %position = scalar.minui %position_selector, %position_limit : i64
  %choice_shift = scalar.constant 6 : i64
  %choice_shifted = scalar.shrui %config, %choice_shift : i64
  %choice_bit = scalar.andi %choice_shifted, %bit_mask : i64
  %choice = scalar.trunci %choice_bit : i64 to i32
  func.return %left_base, %right_base, %position, %choice : i64, i64, i64, i32
}

func.def @selected_crop_observations(%config: i64, %output: buffer) {
  %left_base, %right_base, %position, %choice = func.call @selected_crop_configuration(%config) : (i64) -> (i64, i64, i64, i32)
  %first, %middle, %last, %other = func.call @call_selected_crops(%left_base, %right_base, %position, %choice) : (i64, i64, i64, i32) -> (i32, i32, i32, i32)
  %values = vector.from_elements %first, %middle, %last, %other : vector<4xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  vector.store %values, %results[0] : vector<4xi32>, view<4xi32>
  func.return
}

func.def @expected_crop_observations(%config: i64, %output: buffer) {
  %left_base, %right_base, %position, %choice = func.call @selected_crop_configuration(%config) : (i64) -> (i64, i64, i64, i32)
  %first, %middle, %last, %other = func.call @expected_crops(%position, %choice) : (i64, i32) -> (i32, i32, i32, i32)
  %values = vector.from_elements %first, %middle, %last, %other : vector<4xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  vector.store %values, %results[0] : vector<4xi32>, view<4xi32>
  func.return
}

check.scenario @selected_crop_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %config_source = check.entropy.fork %entropy name("config") : check.entropy
    %config = check.entropy.read %config_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@selected_crop_observations, @expected_crop_observations>(%config, %output) : (i64, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
