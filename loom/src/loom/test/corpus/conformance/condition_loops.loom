// Header state carries only the counter. Each condition evaluation computes a
// wider body/result tuple containing the counter and a payload. The body uses
// that payload and returns only the next counter to the header; the final false
// payload remains observable after the loop.
kernel.def @condition_counter_store() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %header_base = index.constant 16 : offset
  %exit_base = index.constant 36 : offset
  %bias = scalar.constant 17 : i32
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %body_view = buffer.view %aligned_output[%base] : buffer -> view<4xi32>
  %header_view = buffer.view %aligned_output[%header_base] : buffer -> view<5xi32>
  %exit_view = buffer.view %aligned_output[%exit_base] : buffer -> view<1xi32>
  %terminal, %terminal_payload = scf.while(%before = %begin : index) -> (index, i32) {
    %header_counter = index.cast %before : index to i32
    %header_value = scalar.addi %header_counter, %bias : i32
    view.store %header_value, %header_view[%before] : i32, view<5xi32>
    %more = index.cmp slt, %before, %end : index
    scf.condition %more, %before, %header_value : i1, index, i32
  } do(%position: index, %body_payload: i32) {
    view.store %body_payload, %body_view[%position] : i32, view<4xi32>
    %next = index.add %position, %step : index
    scf.yield %next : index
  }
  %terminal_counter = index.cast %terminal : index to i32
  %exit_value = scalar.addi %terminal_counter, %terminal_payload : i32
  view.store %exit_value, %exit_view[0] : i32, view<1xi32>
  kernel.return
}

check.case public @condition_counter_store_case {
  %actual = check.generate.fill value(-1) : tensor<10xi32>
  kernel.launch @condition_counter_store(%actual) : (tensor<10xi32>)
  %body = check.tensor.view %actual offset(0) : tensor<10xi32> -> tensor<4xi32>
  %headers = check.tensor.view %actual offset(16) : tensor<10xi32> -> tensor<5xi32>
  %expected_body = check.generate.iota offset(17) step(1) : tensor<4xi32>
  %expected_headers = check.generate.iota offset(17) step(1) : tensor<5xi32>
  check.expect.equal actual(%body) expected(%expected_body) : tensor<4xi32>
  check.expect.equal actual(%headers) expected(%expected_headers) : tensor<5xi32>
  %exit = check.tensor.view %actual offset(36) : tensor<10xi32> -> tensor<1xi32>
  %expected_exit = check.generate.fill value(25) : tensor<1xi32>
  check.expect.equal actual(%exit) expected(%expected_exit) : tensor<1xi32>
  check.return
}

// An empty body still executes its initial condition-region effects and
// publishes the initial counter as the loop result.
kernel.def @condition_counter_empty() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %begin = index.constant 4 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %header_base = index.constant 16 : offset
  %exit_base = index.constant 36 : offset
  %bias = scalar.constant 17 : i32
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %body_view = buffer.view %aligned_output[%base] : buffer -> view<4xi32>
  %header_view = buffer.view %aligned_output[%header_base] : buffer -> view<5xi32>
  %exit_view = buffer.view %aligned_output[%exit_base] : buffer -> view<1xi32>
  %terminal = scf.while(%before = %begin : index) -> (index) {
    %header_counter = index.cast %before : index to i32
    %header_value = scalar.addi %header_counter, %bias : i32
    view.store %header_value, %header_view[%before] : i32, view<5xi32>
    %more = index.cmp slt, %before, %end : index
    scf.condition %more, %before : i1, index
  } do(%position: index) {
    %body_value = index.cast %position : index to i32
    view.store %body_value, %body_view[%position] : i32, view<4xi32>
    %next = index.add %position, %step : index
    scf.yield %next : index
  }
  %exit_value = index.cast %terminal : index to i32
  view.store %exit_value, %exit_view[0] : i32, view<1xi32>
  kernel.return
}

check.case public @condition_counter_empty_case {
  %actual = check.generate.fill value(-1) : tensor<10xi32>
  kernel.launch @condition_counter_empty(%actual) : (tensor<10xi32>)
  %unchanged = check.tensor.view %actual offset(0) : tensor<10xi32> -> tensor<8xi32>
  %terminal = check.tensor.view %actual offset(32) : tensor<10xi32> -> tensor<1xi32>
  %expected_unchanged = check.generate.fill value(-1) : tensor<8xi32>
  %expected_terminal = check.generate.fill value(21) : tensor<1xi32>
  check.expect.equal actual(%unchanged) expected(%expected_unchanged) : tensor<8xi32>
  check.expect.equal actual(%terminal) expected(%expected_terminal) : tensor<1xi32>
  %exit = check.tensor.view %actual offset(36) : tensor<10xi32> -> tensor<1xi32>
  %expected_exit = check.generate.fill value(4) : tensor<1xi32>
  check.expect.equal actual(%exit) expected(%expected_exit) : tensor<1xi32>
  check.return
}

// The row and column loops prove a flattened footprint through a runtime
// conditional. The guard controls effects without changing the counter proof.
kernel.def @condition_counter_nested() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %enabled: i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rows = index.constant 3 : index
  %columns = index.constant 4 : index
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<12xi32>
  %row_end = scf.while(%row_before = %begin : index) -> (index) {
    %more_rows = index.cmp slt, %row_before, %rows : index
    scf.condition %more_rows, %row_before : i1, index
  } do(%row: index) {
    %row_base = index.mul %row, %columns : index
    %column_end = scf.while(%column_before = %begin : index) -> (index) {
      %more_columns = index.cmp ult, %column_before, %columns : index
      scf.condition %more_columns, %column_before : i1, index
    } do(%column: index) {
      scf.if %enabled {
        %position = index.add %row_base, %column : index
        %value = index.cast %position : index to i32
        view.store %value, %view[%position] : i32, view<12xi32>
      } else {
      }
      %next_column = index.add %column, %step : index
      scf.yield %next_column : index
    }
    %next_row = index.add %row, %step : index
    scf.yield %next_row : index
  }
  kernel.return
}

check.case public @condition_counter_nested_enabled {
  %actual = check.generate.fill value(-1) : tensor<12xi32>
  %enabled = check.literal value(true) : i1
  %expected = check.generate.iota offset(0) step(1) : tensor<12xi32>
  kernel.launch @condition_counter_nested(%actual, %enabled) : (tensor<12xi32>, i1)
  check.expect.equal actual(%actual) expected(%expected) : tensor<12xi32>
  check.return
}

check.case public @condition_counter_nested_disabled {
  %actual = check.generate.fill value(-1) : tensor<12xi32>
  %enabled = check.literal value(false) : i1
  %expected = check.generate.fill value(-1) : tensor<12xi32>
  kernel.launch @condition_counter_nested(%actual, %enabled) : (tensor<12xi32>, i1)
  check.expect.equal actual(%actual) expected(%expected) : tensor<12xi32>
  check.return
}

// Keep a native-width offset recurrence coherent across the condition and body
// CFG edges while the runtime iteration bound stays narrow.
kernel.def @condition_wide_recurrence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %initial: offset, %iteration_count_input: index) {
  %iteration_count = index.assume %iteration_count_input [range(%iteration_count_input, 0, 3)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %stride = index.constant 1 : offset
  %base = index.constant 0 : offset
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %result_view = buffer.view %aligned_output[%base] : buffer -> view<1xi64>
  %final_count, %final_value = scf.while(%before_count = %iteration_count : index, %before_value = %initial : offset) -> (index, offset) {
    %more = index.cmp sgt, %before_count, %c0 : index
    scf.condition %more, %before_count, %before_value : i1, index, offset
  } do(%count: index, %value: offset) {
    %next_count = index.sub %count, %c1 : index
    %next_value = index.sub %value, %stride : offset
    scf.yield %next_count, %next_value : index, offset
  }
  %wide_value = index.cast %final_value : offset to i64
  view.store %wide_value, %result_view[0] : i64, view<1xi64>
  kernel.return
}

check.case public @condition_wide_recurrence_case {
  %initial = check.literal value(103) : offset
  %iteration_count = check.literal value(3) : index
  %actual = check.generate.fill value(-1) : tensor<1xi64>
  %expected = check.generate.fill value(100) : tensor<1xi64>
  kernel.launch @condition_wide_recurrence(%actual, %initial, %iteration_count) : (tensor<1xi64>, offset, index)
  check.expect.equal actual(%actual) expected(%expected) : tensor<1xi64>
  check.return
}

// Crop a strided view in every condition evaluation, including the final
// false condition. Check body loads and the distinct final forwarded view.
kernel.def @condition_view() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %count: index) {
  %iterations = index.assume %count [range(%count, 0, 3)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %base = index.constant 4 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %initial_layout = encoding.layout.strided [8, 1] : encoding<layout>
  %initial_view = buffer.view %input_aligned[%base] : buffer -> view<[%initial_rows]x4xi32, %initial_layout>
  %destination = buffer.view %output_aligned[%base] : buffer -> view<2xi32>
  %c0_i32 = scalar.constant 0 : i32
  %remaining, %rows, %view, %sum = scf.while(%before_remaining = %iterations : index, %before_rows = %initial_rows : index, %before_view = %initial_view : view<[%before_rows]x4xi32, %initial_layout>, %before_sum = %c0_i32 : i32) -> (index, index, view<[%rows]x4xi32, %initial_layout>, i32) {
    %more = index.cmp sgt, %before_remaining, %c0 : index
    %forward_rows = index.sub %before_rows, %c1 : index
    %forward_view = view.subview %before_view[1, 0] : view<[%before_rows]x4xi32, %initial_layout> -> view<[%forward_rows]x4xi32, %initial_layout>
    scf.condition %more, %before_remaining, %forward_rows, %forward_view, %before_sum : i1, index, index, view<[%forward_rows]x4xi32, %initial_layout>, i32
  } do(%body_remaining: index, %body_rows: index, %body_view: view<[%body_rows]x4xi32, %initial_layout>, %total: i32) {
    %has_row = index.cmp sgt, %body_rows, %c0 : index
    %value = scf.if %has_row -> (i32) {
      %loaded = view.load %body_view[0, 1] : view<[%body_rows]x4xi32, %initial_layout> -> i32
      scf.yield %loaded : i32
    } else {
      scf.yield %c0_i32 : i32
    }
    %next_sum = scalar.addi %total, %value : i32
    %next_remaining = index.sub %body_remaining, %c1 : index
    scf.yield %next_remaining, %body_rows, %body_view, %next_sum : index, index, view<[%body_rows]x4xi32, %initial_layout>, i32
  }
  %has_final = index.cmp sgt, %rows, %c0 : index
  %final = scf.if %has_final -> (i32) {
    %loaded = view.load %view[0, 1] : view<[%rows]x4xi32, %initial_layout> -> i32
    scf.yield %loaded : i32
  } else {
    scf.yield %c0_i32 : i32
  }
  view.store %sum, %destination[0] : i32, view<2xi32>
  view.store %final, %destination[1] : i32, view<2xi32>
  kernel.return
}

check.case public @condition_view_0 {
  %count = check.literal value(0) : index
  %input = check.generate.iota offset(100) step(1) : tensor<68xi32>
  %input_expected = check.generate.iota offset(100) step(1) : tensor<68xi32>
  %output = check.generate.fill value(-99) : tensor<4xi32>
  kernel.launch @condition_view(%input, %output, %count) : (tensor<68xi32>, tensor<4xi32>, index)
  %sum = check.tensor.view %output offset(4) : tensor<4xi32> -> tensor<1xi32>
  %final = check.tensor.view %output offset(8) : tensor<4xi32> -> tensor<1xi32>
  %expected_sum = check.generate.fill value(0) : tensor<1xi32>
  %expected_final = check.generate.fill value(110) : tensor<1xi32>
  check.expect.bitwise actual(%sum) expected(%expected_sum) : tensor<1xi32>
  check.expect.bitwise actual(%final) expected(%expected_final) : tensor<1xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<1xi32>
  %suffix = check.tensor.view %output offset(12) : tensor<4xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(-99) : tensor<1xi32>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%input) expected(%input_expected) : tensor<68xi32>
  check.return
}

check.case public @condition_view_1 {
  %count = check.literal value(1) : index
  %input = check.generate.iota offset(100) step(1) : tensor<68xi32>
  %input_expected = check.generate.iota offset(100) step(1) : tensor<68xi32>
  %output = check.generate.fill value(-99) : tensor<4xi32>
