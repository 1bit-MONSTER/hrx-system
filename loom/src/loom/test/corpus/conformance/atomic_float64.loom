    check.compare<@atomic_f64_values, @atomic_f64_values_oracle>(%lhs, %rhs, %global, %generic, %output) : (i64, i64, tensor<12xi64>, tensor<12xi64>, tensor<51xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<51xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(9221120237041090851) : i64
    %rhs = check.literal value(9218868437227407241) : i64
    %global = check.generate.fill value(77) : tensor<12xi64>
    %generic = check.generate.fill value(77) : tensor<12xi64>
    %output = check.generate.fill value(-1) : tensor<51xi64>
    check.compare<@atomic_f64_values, @atomic_f64_values_oracle>(%lhs, %rhs, %global, %generic, %output) : (i64, i64, tensor<12xi64>, tensor<12xi64>, tensor<51xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<51xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(-4503599627367748) : i64
    %rhs = check.literal value(-2251799813684138) : i64
    %global = check.generate.fill value(77) : tensor<12xi64>
    %generic = check.generate.fill value(77) : tensor<12xi64>
    %output = check.generate.fill value(-1) : tensor<51xi64>
    check.compare<@atomic_f64_values, @atomic_f64_values_oracle>(%lhs, %rhs, %global, %generic, %output) : (i64, i64, tensor<12xi64>, tensor<12xi64>, tensor<51xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<51xi64>
    }
  }
  check.return
}

check.scenario @atomic_f64_random_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %lhs = check.entropy.read %entropy[0] : check.entropy -> i64
    %rhs = check.entropy.read %entropy[1] : check.entropy -> i64
