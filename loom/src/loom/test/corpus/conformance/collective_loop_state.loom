// The same uniform transport must preserve both halves of a wide recurrence.
kernel.def @collective_loop_wide_state() {
  %unit = index.constant 1 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %iterations_input: index) {
  %iterations = index.assume %iterations_input [range(%iterations_input, 0, 2)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %unit = index.constant 1 : index
  %initial = scalar.constant 4294967301 : i64
  %multiplier = scalar.constant 2 : i64
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %source, %destination = buffer.assume.noalias %input_aligned, %output_aligned : buffer, buffer
  %values = buffer.view %source[%base] : buffer -> view<128xi32>
  %results = buffer.view %destination[%base] : buffer -> view<128xi64>
  %value = view.load %values[%lane] : view<128xi32> -> i32
  %result = scf.for %iteration = [%c0 to %iterations step %unit](%sum = %initial : i64) -> (i64) {
    %reduced = kernel.workgroup.reduce<addi> %value : i32
    %wide = scalar.extui %reduced : i32 to i64
    %scaled = scalar.muli %sum, %multiplier : i64
    %next = scalar.addi %scaled, %wide : i64
    scf.yield %next : i64
  }
  view.store %result, %results[%lane] : i64, view<128xi64>
  kernel.return
}

check.case public @collective_loop_wide {
  %iterations = check.literal value(2) : index
  %input = check.generate.iota offset(1) step(1) : tensor<128xi32>
  %output = check.generate.fill value(-1) : tensor<128xi64>
  // 4*4294967301 + 3*sum(1..128).
  %expected = check.generate.fill value(17179893972) : tensor<128xi64>
  kernel.launch @collective_loop_wide_state(%input, %output, %iterations) : (tensor<128xi32>, tensor<128xi64>, index)
  check.expect.equal actual(%output) expected(%expected) : tensor<128xi64>
  check.return
}
