// Carry uniform and lane-dependent collective results through nested control.
// Every published state must retain its value across register banks. A row guard
// and nested repetition loop preserve participation; no inactive row is read.
// The guarded load and carried collective update stay in one source conditional;
// fixed outer bounds let the pipeline retain its producer and consumer parts.
// The subgroup reduction uses 16-lane clusters so its oracle is independent
// of the target subgroup width. The workgroup reduction communicates across waves.
template.decl @collective_rows(%input: buffer, %cluster_output: buffer, %group_output: buffer, %limit_input: index, %repeat_input: index, %end: index, %depth: index, %factor: index)

template.def<@collective_rows> @collective_rows_impl(%input: buffer, %cluster_output: buffer, %group_output: buffer, %limit_input: index, %repeat_input: index, %end: index, %depth: index, %factor: index) {
  %limit = index.assume %limit_input [range(%limit_input, 0, 16)] : index
  %repeat = index.assume %repeat_input [range(%repeat_input, 0, 2)] : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %unit = index.constant 1 : index
  %cluster_size = index.constant 16 : index
  %base = index.constant 0 : offset
  %initial = scalar.constant 37 : i32
  %multiplier = scalar.constant 2 : i32
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %cluster_aligned = buffer.assume.alignment %cluster_output {minimum_alignment = 4} : buffer
  %group_aligned = buffer.assume.alignment %group_output {minimum_alignment = 4} : buffer
  %source, %cluster_destination, %group_destination = buffer.assume.noalias %source_aligned, %cluster_aligned, %group_aligned : buffer, buffer, buffer
  %values = buffer.view %source[%base] : buffer -> view<16x128xi32>
  %cluster_results = buffer.view %cluster_destination[%base] : buffer -> view<8xi32>
  %group_results = buffer.view %group_destination[%base] : buffer -> view<8xi32>
  %cluster_result, %group_result = scf.for %row = [%c0 to %end step %unit](%cluster_sum = %initial : i32, %group_sum = %initial : i32) -> (i32, i32) pipeline(%depth) unroll(%factor) {
    %valid = index.cmp slt, %row, %limit : index
    %next_cluster, %next_group = scf.if %valid -> (i32, i32) {
      %value = view.load %values[%row, %lane] : view<16x128xi32> -> i32
      %repeated_cluster, %repeated_group = scf.for %iteration = [%c0 to %repeat step %unit](%cluster_partial = %cluster_sum : i32, %group_partial = %group_sum : i32) -> (i32, i32) {
        %cluster_reduced = kernel.subgroup.reduce<addi> %value {cluster_size = 16} : i32
        %group_reduced = kernel.workgroup.reduce<addi> %value : i32
        %cluster_scaled = scalar.muli %cluster_partial, %multiplier : i32
        %group_scaled = scalar.muli %group_partial, %multiplier : i32
        %cluster_added = scalar.addi %cluster_scaled, %cluster_reduced : i32
        %group_added = scalar.addi %group_scaled, %group_reduced : i32
        scf.yield %cluster_added, %group_added : i32, i32
      }
      scf.yield %repeated_cluster, %repeated_group : i32, i32
    } else {
      scf.yield %cluster_sum, %group_sum : i32, i32
    }
    scf.yield %next_cluster, %next_group : i32, i32
  }
  %cluster_lane = index.rem %lane, %cluster_size : index
  %leader = index.cmp eq, %cluster_lane, %c0 : index
  scf.if %leader {
    %cluster = index.div %lane, %cluster_size : index
    view.store %cluster_result, %cluster_results[%cluster] : i32, view<8xi32>
    view.store %group_result, %group_results[%cluster] : i32, view<8xi32>
  }
  template.return
}

kernel.def @collective_loop_state() {
  %unit = index.constant 1 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %cluster_output: buffer, %group_output: buffer, %limit_input: index, %repeat_input: index) {
  %end = index.constant 7 : index
  %depth = index.constant 1 : index
  %factor = index.constant 1 : index
  template.apply<@collective_rows>(%input, %cluster_output, %group_output, %limit_input, %repeat_input, %end, %depth, %factor) : (buffer, buffer, buffer, index, index, index, index, index)
  kernel.return
}

kernel.def @pipelined_collective_loop_state() {
  %unit = index.constant 1 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %cluster_output: buffer, %group_output: buffer, %limit_input: index, %repeat_input: index) {
  %end = index.constant 7 : index
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  template.apply<@collective_rows>(%input, %cluster_output, %group_output, %limit_input, %repeat_input, %end, %depth, %factor) : (buffer, buffer, buffer, index, index, index, index, index)
  kernel.return
}

kernel.def @short_collective_loop_state() {
  %unit = index.constant 1 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %cluster_output: buffer, %group_output: buffer, %limit_input: index, %repeat_input: index) {
  %end = index.constant 1 : index
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  template.apply<@collective_rows>(%input, %cluster_output, %group_output, %limit_input, %repeat_input, %end, %depth, %factor) : (buffer, buffer, buffer, index, index, index, index, index)
  kernel.return
}

kernel.def @empty_collective_loop_state() {
  %unit = index.constant 1 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %cluster_output: buffer, %group_output: buffer, %limit_input: index, %repeat_input: index) {
  %end = index.constant 0 : index
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  template.apply<@collective_rows>(%input, %cluster_output, %group_output, %limit_input, %repeat_input, %end, %depth, %factor) : (buffer, buffer, buffer, index, index, index, index, index)
  kernel.return
}

// Input(row,lane) = 128*row + lane + 1. The reduced values are
// 2048*row + 256*cluster + 136 and 16384*row + 8256 respectively.
// Expected outputs apply the ordered sum <- 2*sum + reduction from seed 37.
// Changing participation, recurrence order, or the input row changes the result.
check.case public @collective_loop_absent {
  %limit = check.literal value(0) : index
  %repeat = check.literal value(1) : index
  %input = check.generate.iota offset(1) step(1) : tensor<1x128xi32>
  %cluster_output = check.generate.fill value(-10000) : tensor<8xi32>
  %group_output = check.generate.fill value(-20000) : tensor<8xi32>
  %pipeline_cluster = check.generate.fill value(-30000) : tensor<8xi32>
  %pipeline_group = check.generate.fill value(-40000) : tensor<8xi32>
  %cluster_expected = check.generate.iota offset(37) step(0) : tensor<8xi32>
  %group_expected = check.generate.fill value(37) : tensor<8xi32>
  kernel.launch @collective_loop_state(%input, %cluster_output, %group_output, %limit, %repeat) : (tensor<1x128xi32>, tensor<8xi32>, tensor<8xi32>, index, index)
  kernel.launch @pipelined_collective_loop_state(%input, %pipeline_cluster, %pipeline_group, %limit, %repeat) : (tensor<1x128xi32>, tensor<8xi32>, tensor<8xi32>, index, index)
  check.expect.equal actual(%cluster_output) expected(%cluster_expected) : tensor<8xi32>
  check.expect.equal actual(%group_output) expected(%group_expected) : tensor<8xi32>
  check.expect.equal actual(%pipeline_cluster) expected(%cluster_expected) : tensor<8xi32>
  check.expect.equal actual(%pipeline_group) expected(%group_expected) : tensor<8xi32>
  kernel.launch @empty_collective_loop_state(%input, %pipeline_cluster, %pipeline_group, %limit, %repeat) : (tensor<1x128xi32>, tensor<8xi32>, tensor<8xi32>, index, index)
  check.expect.equal actual(%pipeline_cluster) expected(%cluster_expected) : tensor<8xi32>
  check.expect.equal actual(%pipeline_group) expected(%group_expected) : tensor<8xi32>
  check.return
}

check.case public @collective_loop_single {
  %limit = check.literal value(1) : index
  %repeat = check.literal value(1) : index
  %input = check.generate.iota offset(1) step(1) : tensor<1x128xi32>
  %cluster_output = check.generate.fill value(-10000) : tensor<8xi32>
  %group_output = check.generate.fill value(-20000) : tensor<8xi32>
  %pipeline_cluster = check.generate.fill value(-30000) : tensor<8xi32>
  %pipeline_group = check.generate.fill value(-40000) : tensor<8xi32>
  %cluster_expected = check.generate.iota offset(210) step(256) : tensor<8xi32>
  %group_expected = check.generate.fill value(8330) : tensor<8xi32>
  kernel.launch @collective_loop_state(%input, %cluster_output, %group_output, %limit, %repeat) : (tensor<1x128xi32>, tensor<8xi32>, tensor<8xi32>, index, index)
  kernel.launch @pipelined_collective_loop_state(%input, %pipeline_cluster, %pipeline_group, %limit, %repeat) : (tensor<1x128xi32>, tensor<8xi32>, tensor<8xi32>, index, index)
  check.expect.equal actual(%cluster_output) expected(%cluster_expected) : tensor<8xi32>
  check.expect.equal actual(%group_output) expected(%group_expected) : tensor<8xi32>
  check.expect.equal actual(%pipeline_cluster) expected(%cluster_expected) : tensor<8xi32>
  check.expect.equal actual(%pipeline_group) expected(%group_expected) : tensor<8xi32>
  kernel.launch @short_collective_loop_state(%input, %pipeline_cluster, %pipeline_group, %limit, %repeat) : (tensor<1x128xi32>, tensor<8xi32>, tensor<8xi32>, index, index)
  check.expect.equal actual(%pipeline_cluster) expected(%cluster_expected) : tensor<8xi32>
  check.expect.equal actual(%pipeline_group) expected(%group_expected) : tensor<8xi32>
  check.return
}

