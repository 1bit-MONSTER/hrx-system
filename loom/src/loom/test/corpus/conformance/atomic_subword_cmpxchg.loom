  %global_old = view.atomic.cmpxchg %expected, %next, %global_cells[%lane] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i16, view<195xi16> -> i16
  %generic_old = view.atomic.cmpxchg %initial, %replacement, %generic_cells[%lane] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : i16, view<195xi16> -> i16
  %generic_second = scf.if %even -> (i16) {
    %previous = view.atomic.cmpxchg %replacement, %next, %generic_cells[%lane] {failure_ordering = relaxed, scope = subgroup, success_ordering = relaxed} : i16, view<195xi16> -> i16
