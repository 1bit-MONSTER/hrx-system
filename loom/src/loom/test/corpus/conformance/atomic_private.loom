  %selected_e5 = check.tensor.view %output offset(1280) : tensor<6x256xi8> -> tensor<256xi8>
  %expected_selection_e5 = check.generate.fill value(60) : tensor<256xi8>
  check.expect.bitwise actual(%selected_e5) expected(%expected_selection_e5) : tensor<256xi8>
  check.return
}

// Narrow extrema preserve old NaN payloads and gradual underflow. Each
// minimum-subnormal input must survive a minimum with the immediate 1.0.
kernel.def @private_bf16_number() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 2 : offset
  %storage = buffer.alloca<private> align(2) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xbf16>
  %source = buffer.view %input[%origin] : buffer -> view<1xi16>
