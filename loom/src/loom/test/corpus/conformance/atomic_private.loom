// A minimum positive subnormal from memory doubles without flushing. Mixed
// private fields also check exact access widths and signed narrow wrapping.
kernel.def @private_carriers() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24 : offset
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %source = buffer.view %input[%origin] : buffer -> view<128xi64>
  %results = buffer.view %output[%origin] : buffer -> view<16x128xi64>
  %lane = kernel.workitem.id<x> : index
  %bits_i64 = view.load %source[%lane] : view<128xi64> -> i64
  %bits_i32 = scalar.trunci %bits_i64 : i64 to i32
  %bits_i16 = scalar.trunci %bits_i64 : i64 to i16
  %bits_i8 = scalar.trunci %bits_i64 : i64 to i8
  %offset_f16 = index.constant 0 : offset
  %cell_f16 = buffer.view %storage[%offset_f16] : buffer -> view<1xf16>
  %initial_f16 = scalar.bitcast %bits_i16 : i16 to f16
  view.atomic.store %initial_f16, %cell_f16[0] {ordering = release, scope = system} : f16, view<1xf16>
  %old_f16 = view.atomic.rmw<addf, noftz> %initial_f16, %cell_f16[0] {ordering = acq_rel, scope = system} : f16, view<1xf16> -> f16
  %final_f16 = view.atomic.load %cell_f16[0] {ordering = acquire, scope = system} : view<1xf16> -> f16
  %old_f16_bits = scalar.bitcast %old_f16 : f16 to i16
  %old_f16_wide = scalar.extui %old_f16_bits : i16 to i64
  view.store %old_f16_wide, %results[0, %lane] : i64, view<16x128xi64>
  %final_f16_bits = scalar.bitcast %final_f16 : f16 to i16
  %final_f16_wide = scalar.extui %final_f16_bits : i16 to i64
  view.store %final_f16_wide, %results[6, %lane] : i64, view<16x128xi64>
  %offset_bf16 = index.constant 2 : offset
  %cell_bf16 = buffer.view %storage[%offset_bf16] : buffer -> view<1xbf16>
  %initial_bf16 = scalar.bitcast %bits_i16 : i16 to bf16
  view.atomic.store %initial_bf16, %cell_bf16[0] {ordering = release, scope = system} : bf16, view<1xbf16>
  %old_bf16 = view.atomic.rmw<addf, noftz> %initial_bf16, %cell_bf16[0] {ordering = acq_rel, scope = system} : bf16, view<1xbf16> -> bf16
  %final_bf16 = view.atomic.load %cell_bf16[0] {ordering = acquire, scope = system} : view<1xbf16> -> bf16
  %old_bf16_bits = scalar.bitcast %old_bf16 : bf16 to i16
  %old_bf16_wide = scalar.extui %old_bf16_bits : i16 to i64
  view.store %old_bf16_wide, %results[1, %lane] : i64, view<16x128xi64>
  %final_bf16_bits = scalar.bitcast %final_bf16 : bf16 to i16
  %final_bf16_wide = scalar.extui %final_bf16_bits : i16 to i64
  view.store %final_bf16_wide, %results[7, %lane] : i64, view<16x128xi64>
  %offset_f32 = index.constant 4 : offset
  %cell_f32 = buffer.view %storage[%offset_f32] : buffer -> view<1xf32>
  %initial_f32 = scalar.bitcast %bits_i32 : i32 to f32
  view.atomic.store %initial_f32, %cell_f32[0] {ordering = release, scope = system} : f32, view<1xf32>
  %old_f32 = view.atomic.rmw<addf, noftz> %initial_f32, %cell_f32[0] {ordering = acq_rel, scope = system} : f32, view<1xf32> -> f32
  %final_f32 = view.atomic.load %cell_f32[0] {ordering = acquire, scope = system} : view<1xf32> -> f32
  %old_f32_bits = scalar.bitcast %old_f32 : f32 to i32
  %old_f32_wide = scalar.extui %old_f32_bits : i32 to i64
  view.store %old_f32_wide, %results[2, %lane] : i64, view<16x128xi64>
  %final_f32_bits = scalar.bitcast %final_f32 : f32 to i32
  %final_f32_wide = scalar.extui %final_f32_bits : i32 to i64
  view.store %final_f32_wide, %results[8, %lane] : i64, view<16x128xi64>
  %offset_f64 = index.constant 8 : offset
  %cell_f64 = buffer.view %storage[%offset_f64] : buffer -> view<1xf64>
  %initial_f64 = scalar.bitcast %bits_i64 : i64 to f64
  view.atomic.store %initial_f64, %cell_f64[0] {ordering = release, scope = system} : f64, view<1xf64>
  %old_f64 = view.atomic.rmw<addf, noftz> %initial_f64, %cell_f64[0] {ordering = acq_rel, scope = system} : f64, view<1xf64> -> f64
  %final_f64 = view.atomic.load %cell_f64[0] {ordering = acquire, scope = system} : view<1xf64> -> f64
  %old_f64_bits = scalar.bitcast %old_f64 : f64 to i64
  view.store %old_f64_bits, %results[3, %lane] : i64, view<16x128xi64>
  %final_f64_bits = scalar.bitcast %final_f64 : f64 to i64
  view.store %final_f64_bits, %results[9, %lane] : i64, view<16x128xi64>
  %offset_i8 = index.constant 16 : offset
  %cell_i8 = buffer.view %storage[%offset_i8] : buffer -> view<1xi8>
  %initial_i8 = scalar.constant 127 : i8
  %update_i8 = scalar.addi %bits_i8, %bits_i8 : i8
  view.atomic.store %initial_i8, %cell_i8[0] {ordering = release, scope = system} : i8, view<1xi8>
  %old_i8 = view.atomic.rmw<addi> %update_i8, %cell_i8[0] {ordering = acq_rel, scope = system} : i8, view<1xi8> -> i8
  %final_i8 = view.atomic.load %cell_i8[0] {ordering = acquire, scope = system} : view<1xi8> -> i8
  %old_i8_wide = scalar.extsi %old_i8 : i8 to i64
  view.store %old_i8_wide, %results[4, %lane] : i64, view<16x128xi64>
  %final_i8_wide = scalar.extsi %final_i8 : i8 to i64
  view.store %final_i8_wide, %results[10, %lane] : i64, view<16x128xi64>
  %offset_i16 = index.constant 18 : offset
  %cell_i16 = buffer.view %storage[%offset_i16] : buffer -> view<1xi16>
  %initial_i16 = scalar.constant 32767 : i16
  %update_i16 = scalar.addi %bits_i16, %bits_i16 : i16
  view.atomic.store %initial_i16, %cell_i16[0] {ordering = release, scope = system} : i16, view<1xi16>
  %old_i16 = view.atomic.rmw<addi> %update_i16, %cell_i16[0] {ordering = acq_rel, scope = system} : i16, view<1xi16> -> i16
  %final_i16 = view.atomic.load %cell_i16[0] {ordering = acquire, scope = system} : view<1xi16> -> i16
  %old_i16_wide = scalar.extsi %old_i16 : i16 to i64
  view.store %old_i16_wide, %results[5, %lane] : i64, view<16x128xi64>
  %final_i16_wide = scalar.extsi %final_i16 : i16 to i64
  view.store %final_i16_wide, %results[11, %lane] : i64, view<16x128xi64>
  %offset_f8e4m3 = index.constant 20 : offset
  %cell_f8e4m3 = buffer.view %storage[%offset_f8e4m3] : buffer -> view<1xf8E4M3>
  %initial_f8e4m3 = scalar.bitcast %bits_i8 : i8 to f8E4M3
  view.atomic.store %initial_f8e4m3, %cell_f8e4m3[0] {ordering = release, scope = system} : f8E4M3, view<1xf8E4M3>
  %old_f8e4m3 = view.atomic.rmw<addf, noftz> %initial_f8e4m3, %cell_f8e4m3[0] {ordering = acq_rel, scope = system} : f8E4M3, view<1xf8E4M3> -> f8E4M3
  %final_f8e4m3 = view.atomic.load %cell_f8e4m3[0] {ordering = acquire, scope = system} : view<1xf8E4M3> -> f8E4M3
  %old_f8e4m3_bits = scalar.bitcast %old_f8e4m3 : f8E4M3 to i8
  %old_f8e4m3_wide = scalar.extui %old_f8e4m3_bits : i8 to i64
  view.store %old_f8e4m3_wide, %results[12, %lane] : i64, view<16x128xi64>
  %final_f8e4m3_bits = scalar.bitcast %final_f8e4m3 : f8E4M3 to i8
  %final_f8e4m3_wide = scalar.extui %final_f8e4m3_bits : i8 to i64
  view.store %final_f8e4m3_wide, %results[13, %lane] : i64, view<16x128xi64>
  %offset_f8e5m2 = index.constant 21 : offset
  %cell_f8e5m2 = buffer.view %storage[%offset_f8e5m2] : buffer -> view<1xf8E5M2>
  %initial_f8e5m2 = scalar.bitcast %bits_i8 : i8 to f8E5M2
  view.atomic.store %initial_f8e5m2, %cell_f8e5m2[0] {ordering = release, scope = system} : f8E5M2, view<1xf8E5M2>
  %old_f8e5m2 = view.atomic.rmw<addf, noftz> %initial_f8e5m2, %cell_f8e5m2[0] {ordering = acq_rel, scope = system} : f8E5M2, view<1xf8E5M2> -> f8E5M2
  %final_f8e5m2 = view.atomic.load %cell_f8e5m2[0] {ordering = acquire, scope = system} : view<1xf8E5M2> -> f8E5M2
  %old_f8e5m2_bits = scalar.bitcast %old_f8e5m2 : f8E5M2 to i8
  %old_f8e5m2_wide = scalar.extui %old_f8e5m2_bits : i8 to i64
  view.store %old_f8e5m2_wide, %results[14, %lane] : i64, view<16x128xi64>
  %final_f8e5m2_bits = scalar.bitcast %final_f8e5m2 : f8E5M2 to i8
  %final_f8e5m2_wide = scalar.extui %final_f8e5m2_bits : i8 to i64
  view.store %final_f8e5m2_wide, %results[15, %lane] : i64, view<16x128xi64>
  kernel.return
}

check.case public @private_carrier_results {
  %input = check.generate.fill value(1) : tensor<128xi64>
  %output = check.generate.fill value(0) : tensor<16x128xi64>
  kernel.launch @private_carriers(%input, %output) : (tensor<128xi64>, tensor<16x128xi64>)
