  %expected_tickets = check.generate.iota offset(4294967330) step(-1) : tensor<68xi64>
  %expected_counter = check.generate.fill value(4294967262) : tensor<1xi64>
  %expected_bits = check.generate.fill value(562945658454050) : tensor<1xi64>
  %storage_guard = check.generate.fill value(4294967330) : tensor<1xi64>
  %output_guard = check.generate.fill value(-1) : tensor<1xi64>
  %global_tickets = check.tensor.view %global_output offset(8) : tensor<70xi64> -> tensor<68xi64>
  %generic_tickets = check.tensor.view %generic_output offset(8) : tensor<70xi64> -> tensor<68xi64>
  check.expect.bitwise actual(%global_tickets) expected(%expected_tickets) : tensor<68xi64>
  check.expect.bitwise actual(%generic_tickets) expected(%expected_tickets) : tensor<68xi64>
  %global_counter = check.tensor.view %global offset(8) : tensor<4xi64> -> tensor<1xi64>
  %generic_counter = check.tensor.view %generic offset(8) : tensor<4xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%global_counter) expected(%expected_counter) : tensor<1xi64>
  check.expect.bitwise actual(%generic_counter) expected(%expected_counter) : tensor<1xi64>
  %global_bits = check.tensor.view %global offset(16) : tensor<4xi64> -> tensor<1xi64>
  %generic_bits = check.tensor.view %generic offset(16) : tensor<4xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%global_bits) expected(%expected_bits) : tensor<1xi64>
  check.expect.bitwise actual(%generic_bits) expected(%expected_bits) : tensor<1xi64>
  %global_before = check.tensor.view %global offset(0) : tensor<4xi64> -> tensor<1xi64>
  %generic_before = check.tensor.view %generic offset(0) : tensor<4xi64> -> tensor<1xi64>
  %global_after = check.tensor.view %global offset(24) : tensor<4xi64> -> tensor<1xi64>
  %generic_after = check.tensor.view %generic offset(24) : tensor<4xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%global_before) expected(%storage_guard) : tensor<1xi64>
  check.expect.bitwise actual(%generic_before) expected(%storage_guard) : tensor<1xi64>
  check.expect.bitwise actual(%global_after) expected(%storage_guard) : tensor<1xi64>
  check.expect.bitwise actual(%generic_after) expected(%storage_guard) : tensor<1xi64>
  %global_output_before = check.tensor.view %global_output offset(0) : tensor<70xi64> -> tensor<1xi64>
  %generic_output_before = check.tensor.view %generic_output offset(0) : tensor<70xi64> -> tensor<1xi64>
  %global_output_after = check.tensor.view %global_output offset(552) : tensor<70xi64> -> tensor<1xi64>
  %generic_output_after = check.tensor.view %generic_output offset(552) : tensor<70xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%global_output_before) expected(%output_guard) : tensor<1xi64>
  check.expect.bitwise actual(%generic_output_before) expected(%output_guard) : tensor<1xi64>
  check.expect.bitwise actual(%global_output_after) expected(%output_guard) : tensor<1xi64>
  check.expect.bitwise actual(%generic_output_after) expected(%output_guard) : tensor<1xi64>
  check.return
}

// Sixty-five lanes span wave32 and wave64 boundaries. Each workgroup owns
// an independent counter; both cross a low-word borrow under contention.
kernel.def @contended_workgroup_atomic_i64() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %summary: buffer, %initial: i64) {
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : index
  %base = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %storage = buffer.alloca<workgroup> align(8) %bytes : buffer
  %cells = buffer.view %storage[%base] : buffer -> view<4xi64>
  %tickets = buffer.view %output[%base] : buffer -> view<2x65xi64>
  %summaries = buffer.view %summary[%base] : buffer -> view<2x4xi64>
  %leader = index.cmp eq, %lane, %origin : index
  %empty = scalar.constant 0 : i64
  scf.if %leader {
    view.store %initial, %cells[0] : i64, view<4xi64>
    view.store %initial, %cells[1] : i64, view<4xi64>
    view.store %empty, %cells[2] : i64, view<4xi64>
    view.store %initial, %cells[3] : i64, view<4xi64>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %active_count = index.constant 65 : index
  %active = index.cmp ult, %lane, %active_count : index
  scf.if %active {
    %lane_wide = index.cast %lane : index to i64
    %low_bits = scalar.constant 31 : i64
    %bit_index = scalar.andi %lane_wide, %low_bits : i64
    %high_word = scalar.constant 32 : i64
    %bit = scalar.addi %bit_index, %high_word : i64
    %increment = scalar.constant 1 : i64
    %contribution = scalar.shli %increment, %bit : i64
    view.atomic.reduce<ori> %contribution, %cells[2] {ordering = relaxed, scope = workgroup} : i64, view<4xi64>
    %old = view.atomic.rmw<subi> %increment, %cells[1] {ordering = relaxed, scope = workgroup} : i64, view<4xi64> -> i64
    %distance = scalar.subi %initial, %old : i64
    %bounded = scalar.assume %distance [range(%distance, 0, 64)] : i64
    %slot = index.cast %bounded : i64 to index
    view.store %old, %tickets[%group, %slot] : i64, view<2x65xi64>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %leader {
    %before = view.load %cells[0] : view<4xi64> -> i64
    %counter = view.load %cells[1] : view<4xi64> -> i64
    %bits = view.load %cells[2] : view<4xi64> -> i64
    %after = view.load %cells[3] : view<4xi64> -> i64
    view.store %before, %summaries[%group, 0] : i64, view<2x4xi64>
    view.store %counter, %summaries[%group, 1] : i64, view<2x4xi64>
    view.store %bits, %summaries[%group, 2] : i64, view<2x4xi64>
    view.store %after, %summaries[%group, 3] : i64, view<2x4xi64>
  }
  kernel.return
}

check.case public @contended_workgroup_atomic_i64_values {
  %initial = check.literal value(4294967330) : i64
  %output = check.generate.fill value(-1) : tensor<2x65xi64>
  %summary = check.generate.fill value(-1) : tensor<8xi64>
  kernel.launch @contended_workgroup_atomic_i64(%output, %summary, %initial) : (tensor<2x65xi64>, tensor<8xi64>, i64)
  %expected_tickets = check.generate.iota offset(4294967330) step(-1) period(65) : tensor<2x65xi64>
  check.expect.bitwise actual(%output) expected(%expected_tickets) : tensor<2x65xi64>
  %expected_counter = check.generate.fill value(4294967265) : tensor<1xi64>
  %expected_bits = check.generate.fill value(-4294967296) : tensor<1xi64>
  %expected_guard = check.generate.fill value(4294967330) : tensor<1xi64>
  %before_0 = check.tensor.view %summary offset(0) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%before_0) expected(%expected_guard) : tensor<1xi64>
  %counter_0 = check.tensor.view %summary offset(8) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%counter_0) expected(%expected_counter) : tensor<1xi64>
  %bits_0 = check.tensor.view %summary offset(16) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%bits_0) expected(%expected_bits) : tensor<1xi64>
  %after_0 = check.tensor.view %summary offset(24) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%after_0) expected(%expected_guard) : tensor<1xi64>
  %before_1 = check.tensor.view %summary offset(32) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%before_1) expected(%expected_guard) : tensor<1xi64>
  %counter_1 = check.tensor.view %summary offset(40) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%counter_1) expected(%expected_counter) : tensor<1xi64>
  %bits_1 = check.tensor.view %summary offset(48) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%bits_1) expected(%expected_bits) : tensor<1xi64>
  %after_1 = check.tensor.view %summary offset(56) : tensor<8xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%after_1) expected(%expected_guard) : tensor<1xi64>
  check.return
}
