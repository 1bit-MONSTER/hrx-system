// Every lane owns one adjacent cell; atomic and ordinary stores share physical
// dwords. Interior origins and guard cells expose widened or misplaced writes.
kernel.def @narrow_observations_i8() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %global_base = index.constant 1 : offset
  %generic_base = index.constant 131 : offset
  %bytes = index.constant 128 : offset
  %global = buffer.assume.memory_space<global> %storage : buffer
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %scratch = buffer.alloca<workgroup> align(1) %bytes : buffer
  %global_cells = buffer.view %global[%global_base] : buffer -> view<128xi8>
  %generic_cells = buffer.view %generic[%generic_base] : buffer -> view<128xi8>
  %local_cells = buffer.view %scratch[%origin] : buffer -> view<128xi8>
  %results = buffer.view %output[%origin] : buffer -> view<4x128xi8>
  %initial = scalar.constant 77 : i8
  %lane_i32 = index.cast %lane : index to i32
  %bias = scalar.constant -128 : i32
  %tag = scalar.addi %lane_i32, %bias : i32
  %replacement = scalar.trunci %tag : i32 to i8
  view.store %initial, %local_cells[%lane] : i8, view<128xi8>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %global_old = view.atomic.load %global_cells[%lane] {ordering = acquire, scope = device} : view<128xi8> -> i8
  %generic_old = view.atomic.load %generic_cells[%lane] {ordering = seq_cst, scope = system} : view<128xi8> -> i8
  %local_old = view.atomic.load %local_cells[%lane] {ordering = relaxed, scope = workgroup} : view<128xi8> -> i8
  view.store %global_old, %results[0, %lane] : i8, view<4x128xi8>
  view.store %generic_old, %results[1, %lane] : i8, view<4x128xi8>
  view.store %local_old, %results[2, %lane] : i8, view<4x128xi8>
  %parity_mask = scalar.constant 1 : i32
  %parity = scalar.andi %lane_i32, %parity_mask : i32
  %even = scalar.constant 0 : i32
  %atomic_lane = scalar.cmpi eq, %parity, %even : i32
  scf.if %atomic_lane {
    view.atomic.store %replacement, %global_cells[%lane] {ordering = release, scope = device} : i8, view<128xi8>
    view.atomic.store %replacement, %generic_cells[%lane] {ordering = seq_cst, scope = system} : i8, view<128xi8>
    view.atomic.store %replacement, %local_cells[%lane] {ordering = relaxed, scope = workgroup} : i8, view<128xi8>
  } else {
    view.store %replacement, %global_cells[%lane] : i8, view<128xi8>
    view.store %replacement, %generic_cells[%lane] : i8, view<128xi8>
    view.store %replacement, %local_cells[%lane] : i8, view<128xi8>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %local_final = view.atomic.load %local_cells[%lane] {ordering = acquire, scope = workgroup} : view<128xi8> -> i8
  view.store %local_final, %results[3, %lane] : i8, view<4x128xi8>
  kernel.return
}

check.case public @narrow_observation_values_i8 {
  %storage = check.generate.fill value(77) : tensor<260xi8>
  %output = check.generate.fill value(0) : tensor<4x128xi8>
  kernel.launch @narrow_observations_i8(%storage, %output) : (tensor<260xi8>, tensor<4x128xi8>)
  %global = check.tensor.view %storage offset(1) : tensor<260xi8> -> tensor<128xi8>
  %generic = check.tensor.view %storage offset(131) : tensor<260xi8> -> tensor<128xi8>
  %expected = check.generate.iota offset(-128) step(1) : tensor<128xi8>
  check.expect.bitwise actual(%global) expected(%expected) : tensor<128xi8>
  check.expect.bitwise actual(%generic) expected(%expected) : tensor<128xi8>
  %old = check.tensor.view %output offset(0) : tensor<4x128xi8> -> tensor<384xi8>
  %expected_old = check.generate.fill value(77) : tensor<384xi8>
  check.expect.bitwise actual(%old) expected(%expected_old) : tensor<384xi8>
  %local_final = check.tensor.view %output offset(384) : tensor<4x128xi8> -> tensor<128xi8>
  check.expect.bitwise actual(%local_final) expected(%expected) : tensor<128xi8>
  %expected_guard = check.generate.fill value(77) : tensor<1xi8>
  %guard_0 = check.tensor.view %storage offset(0) : tensor<260xi8> -> tensor<1xi8>
  check.expect.bitwise actual(%guard_0) expected(%expected_guard) : tensor<1xi8>
  %guard_129 = check.tensor.view %storage offset(129) : tensor<260xi8> -> tensor<1xi8>
  check.expect.bitwise actual(%guard_129) expected(%expected_guard) : tensor<1xi8>
  %guard_130 = check.tensor.view %storage offset(130) : tensor<260xi8> -> tensor<1xi8>
  check.expect.bitwise actual(%guard_130) expected(%expected_guard) : tensor<1xi8>
  %guard_259 = check.tensor.view %storage offset(259) : tensor<260xi8> -> tensor<1xi8>
  check.expect.bitwise actual(%guard_259) expected(%expected_guard) : tensor<1xi8>
  check.return
}

// Every lane owns one adjacent cell; atomic and ordinary stores share physical
// dwords. Interior origins and guard cells expose widened or misplaced writes.
kernel.def @narrow_observations_i16() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %global_base = index.constant 2 : offset
  %generic_base = index.constant 262 : offset
  %bytes = index.constant 256 : offset
  %global = buffer.assume.memory_space<global> %storage : buffer
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %scratch = buffer.alloca<workgroup> align(2) %bytes : buffer
  %global_cells = buffer.view %global[%global_base] : buffer -> view<128xi16>
  %generic_cells = buffer.view %generic[%generic_base] : buffer -> view<128xi16>
  %local_cells = buffer.view %scratch[%origin] : buffer -> view<128xi16>
  %results = buffer.view %output[%origin] : buffer -> view<4x128xi16>
  %initial = scalar.constant 77 : i16
  %lane_i32 = index.cast %lane : index to i32
  %bias = scalar.constant -32768 : i32
  %tag = scalar.addi %lane_i32, %bias : i32
  %replacement = scalar.trunci %tag : i32 to i16
  view.store %initial, %local_cells[%lane] : i16, view<128xi16>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %global_old = view.atomic.load %global_cells[%lane] {ordering = acquire, scope = device} : view<128xi16> -> i16
  %generic_old = view.atomic.load %generic_cells[%lane] {ordering = seq_cst, scope = system} : view<128xi16> -> i16
  %local_old = view.atomic.load %local_cells[%lane] {ordering = relaxed, scope = workgroup} : view<128xi16> -> i16
  view.store %global_old, %results[0, %lane] : i16, view<4x128xi16>
  view.store %generic_old, %results[1, %lane] : i16, view<4x128xi16>
  view.store %local_old, %results[2, %lane] : i16, view<4x128xi16>
  %parity_mask = scalar.constant 1 : i32
  %parity = scalar.andi %lane_i32, %parity_mask : i32
  %even = scalar.constant 0 : i32
  %atomic_lane = scalar.cmpi eq, %parity, %even : i32
  scf.if %atomic_lane {
    view.atomic.store %replacement, %global_cells[%lane] {ordering = release, scope = device} : i16, view<128xi16>
    view.atomic.store %replacement, %generic_cells[%lane] {ordering = seq_cst, scope = system} : i16, view<128xi16>
    view.atomic.store %replacement, %local_cells[%lane] {ordering = relaxed, scope = workgroup} : i16, view<128xi16>
  } else {
    view.store %replacement, %global_cells[%lane] : i16, view<128xi16>
    view.store %replacement, %generic_cells[%lane] : i16, view<128xi16>
    view.store %replacement, %local_cells[%lane] : i16, view<128xi16>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %local_final = view.atomic.load %local_cells[%lane] {ordering = acquire, scope = workgroup} : view<128xi16> -> i16
  view.store %local_final, %results[3, %lane] : i16, view<4x128xi16>
  kernel.return
}

check.case public @narrow_observation_values_i16 {
  %storage = check.generate.fill value(77) : tensor<260xi16>
  %output = check.generate.fill value(0) : tensor<4x128xi16>
  kernel.launch @narrow_observations_i16(%storage, %output) : (tensor<260xi16>, tensor<4x128xi16>)
  %global = check.tensor.view %storage offset(2) : tensor<260xi16> -> tensor<128xi16>
  %generic = check.tensor.view %storage offset(262) : tensor<260xi16> -> tensor<128xi16>
