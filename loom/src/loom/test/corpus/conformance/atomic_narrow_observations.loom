  %local_final = check.tensor.view %output offset(768) : tensor<4x128xi16> -> tensor<128xi16>
  check.expect.bitwise actual(%local_final) expected(%expected) : tensor<128xi16>
  %expected_guard = check.generate.fill value(77) : tensor<1xi16>
  %guard_0 = check.tensor.view %storage offset(0) : tensor<260xi16> -> tensor<1xi16>
  check.expect.bitwise actual(%guard_0) expected(%expected_guard) : tensor<1xi16>
  %guard_129 = check.tensor.view %storage offset(258) : tensor<260xi16> -> tensor<1xi16>
