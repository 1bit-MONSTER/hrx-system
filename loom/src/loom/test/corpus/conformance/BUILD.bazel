loom_test(
    name = "pipelined_guarded_recurrence_test",
    srcs = [
        "pipelined_guarded_recurrence.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/segmented_guarded_read_ahead.loom",
    ],
    compile_targets = [
        "//loom/target/amdgpu:gfx942",
        "//loom/target/amdgpu:gfx1151",
        "//loom/target/amdgpu:gfx1250",
        "//loom/target/spirv:vulkan1.3+bda",
    ],
    configs = {
        "benchmark.loop_count": "8",
        "test.factor": "1",
    },
    execution_profiles = GPU_HARDWARE_PROFILES + [AMDGPU_ACCESS_PROFILE],
    variants = {
        "depth_three": {"configs": {
            "benchmark.pipeline_depth": "3",
            "test.depth": "3",
        }},
        "serial": {"configs": {
            "benchmark.pipeline_depth": "1",
            "test.depth": "1",
        }},
        "unrolled": {"configs": {
            "benchmark.pipeline_depth": "4",
            "test.depth": "4",
            "test.factor": "2",
        }},
    },
)

