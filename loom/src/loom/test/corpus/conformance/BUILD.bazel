load("//loom/src/loom/tooling/target/wasm:execution_profiles.bzl", "WASM_HOSTED_PROFILE")
load("//loom/target:execution_profiles.bzl", "GPU_HARDWARE_PROFILES")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CONFIGURED_CASES = [
    "pipelined_guarded_recurrence.loom",
]

_SCENARIO_CASES = [
    "atomic_float64.loom",
    "half_float_extrema.loom",
    "numeric_vector_f32.loom",
    "packed_vector_select.loom",
    "predicate_logic.loom",
    "predicate_selection.loom",
    "predicate_truncation.loom",
    "scalar_integer_address.loom",
    "scalar_float_conversion.loom",
    "scalar_float64.loom",
    "subgroup_shuffle_participation.loom",
    "subgroup_transport.loom",
    "subgroup_transport_carrier.loom",
    "vector_integer_bitwise.loom",
]

_CASES = glob(
    ["*.loom"],
    exclude = _CONFIGURED_CASES + _SCENARIO_CASES,
)

exports_files(_CASES + _CONFIGURED_CASES + _SCENARIO_CASES)

