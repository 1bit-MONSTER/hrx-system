load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_module", "loom_test")
load("//loom/target:execution_profiles.bzl", "GPU_HARDWARE_PROFILES")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CONFIGURED_CASES = [
    "pipelined_guarded_recurrence.loom",
]

_SCENARIO_CASES = [
    "atomic_float64.loom",
    "half_float_extrema.loom",
    "scalar_float64.loom",
]

_CASES = glob(
    ["*.loom"],
    exclude = _CONFIGURED_CASES + _SCENARIO_CASES,
)

exports_files(_CASES + _CONFIGURED_CASES + _SCENARIO_CASES)

loom_test(
    name = "atomic_float64_test",
    srcs = ["atomic_float64.loom"],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/target/arch:vm"]),
)

