    check.compare<@workgroup_tree_three_waves, @workgroup_tree_float_sum_oracle>(%input, %output) : (tensor<96xf32>, tensor<1xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xf32>
    }
  }
  check.return
}

