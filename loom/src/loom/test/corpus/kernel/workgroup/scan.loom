// Serially evaluates the four workgroup scan direction/mode combinations.
// The element count follows the input buffer so one oracle serves every fixed
// target launch shape below.
func.def @workgroup_scan_i32_oracle(%input: buffer, %output: buffer) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %element_count = index.div %input_bytes, %element_bytes : index
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%base] : buffer -> view<[%element_count]xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<[%element_count]x4xi32>
  scf.for %lane = [%begin to %element_count step %step] {
    %next_lane = index.add %lane, %step : index
    %forward_inclusive = scf.for %position = [%begin to %next_lane step %step](%sum = %c0 : i32) -> (i32) {
      %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807), lt(%position, %element_count)] : index
      %value = view.load %input_view[%bounded_position] : view<[%element_count]xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    %forward_exclusive = scf.for %position = [%begin to %lane step %step](%sum = %c0 : i32) -> (i32) {
      %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807), lt(%position, %element_count)] : index
      %value = view.load %input_view[%bounded_position] : view<[%element_count]xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    %reverse_inclusive = scf.for %position = [%lane to %element_count step %step](%sum = %c0 : i32) -> (i32) {
      %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807), lt(%position, %element_count)] : index
      %value = view.load %input_view[%bounded_position] : view<[%element_count]xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    %reverse_exclusive = scf.for %position = [%next_lane to %element_count step %step](%sum = %c0 : i32) -> (i32) {
      %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807), lt(%position, %element_count)] : index
      %value = view.load %input_view[%bounded_position] : view<[%element_count]xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    view.store %forward_inclusive, %output_view[%lane, 0] : i32, view<[%element_count]x4xi32>
    view.store %forward_exclusive, %output_view[%lane, 1] : i32, view<[%element_count]x4xi32>
    view.store %reverse_inclusive, %output_view[%lane, 2] : i32, view<[%element_count]x4xi32>
    view.store %reverse_exclusive, %output_view[%lane, 3] : i32, view<[%element_count]x4xi32>
  }
  func.return
}

kernel.def @workgroup_scan_i32_16() {
  %unit = index.constant 1 : index
  %items = index.constant 16 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16x4xi32>
  %value = view.load %input_view[%lane] : view<16xi32> -> i32
  %forward_inclusive = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  %forward_exclusive = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  %reverse_inclusive = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i32
  %reverse_exclusive = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i32
  view.store %forward_inclusive, %output_view[%lane, 0] : i32, view<16x4xi32>
  view.store %forward_exclusive, %output_view[%lane, 1] : i32, view<16x4xi32>
  view.store %reverse_inclusive, %output_view[%lane, 2] : i32, view<16x4xi32>
  view.store %reverse_exclusive, %output_view[%lane, 3] : i32, view<16x4xi32>
  kernel.return
}

check.scenario @workgroup_scan_i32_16_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-8) step(3) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<16x4xi32>
    check.compare<@workgroup_scan_i32_16, @workgroup_scan_i32_oracle>(%input, %output) : (tensor<16xi32>, tensor<16x4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x4xi32>
    }
  }
  check.return
}

