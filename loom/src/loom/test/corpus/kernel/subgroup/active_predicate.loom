// Predicates computed before divergence retain bits for inactive lanes. Votes
// and ballots must intersect those predicates with the active set at the use.
kernel.def @subgroup_active_predicate() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %any_output: buffer, %all_output: buffer, %ballot_output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<64xi32>
  %any_view = buffer.view %any_output[%base] : buffer -> view<32xi32>
  %all_view = buffer.view %all_output[%base] : buffer -> view<32xi32>
  %ballot_view = buffer.view %ballot_output[%base] : buffer -> view<32xi32>
  %value = view.load %source[%lane] : view<64xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %odd = scalar.andi %value, %c1 : i32
  %inactive_predicate = scalar.cmpi ne, %odd, %c0 : i32
  %true_predicate = scalar.cmpi sge, %value, %c0 : i32
  %index_unit = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %parity = index.andi %lane, %index_unit : index
  %active = index.cmp eq, %parity, %c0_index : index
  scf.if %active {
    %pair_width = index.constant 2 : index
    %position = index.div %lane, %pair_width : index
    %any = kernel.subgroup.vote.any %inactive_predicate : i1
    %all = kernel.subgroup.vote.all %true_predicate : i1
    %inactive_ballot = kernel.subgroup.vote.ballot %inactive_predicate : i1 -> i64
    %active_ballot = kernel.subgroup.vote.ballot %true_predicate : i1 -> i64
    %active_mask = kernel.subgroup.active.mask : i64
    %c0_wide = scalar.constant 0 : i64
    %empty = scalar.cmpi eq, %inactive_ballot, %c0_wide : i64
    %complete = scalar.cmpi eq, %active_ballot, %active_mask : i64
    %ballots_match = scalar.andi %empty, %complete : i1
    %any_value = scalar.extui %any : i1 to i32
    %all_value = scalar.extui %all : i1 to i32
    %ballot_value = scalar.extui %ballots_match : i1 to i32
    view.store %any_value, %any_view[%position] : i32, view<32xi32>
    view.store %all_value, %all_view[%position] : i32, view<32xi32>
    view.store %ballot_value, %ballot_view[%position] : i32, view<32xi32>
  }
  kernel.return
}

check.case public @votes_ignore_inactive_lanes {
  %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
  %any = check.generate.fill value(99) : tensor<32xi32>
  %all = check.generate.fill value(99) : tensor<32xi32>
  %ballot = check.generate.fill value(99) : tensor<32xi32>
  kernel.launch @subgroup_active_predicate(%input, %any, %all, %ballot) : (tensor<64xi32>, tensor<32xi32>, tensor<32xi32>, tensor<32xi32>)
  %expected_false = check.generate.fill value(0) : tensor<32xi32>
  %expected_true = check.generate.fill value(1) : tensor<32xi32>
  check.expect.equal actual(%any) expected(%expected_false) : tensor<32xi32>
  check.expect.equal actual(%all) expected(%expected_true) : tensor<32xi32>
  check.expect.equal actual(%ballot) expected(%expected_true) : tensor<32xi32>
  check.return
}
