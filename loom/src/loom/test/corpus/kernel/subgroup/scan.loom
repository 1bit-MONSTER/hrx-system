// Compare each scan with a serial fold over the actual subgroup/lane metadata.
// Workitem coordinates index storage; they need not match subgroup lane order.
// The four folds cover both directions and inclusive/exclusive membership.
kernel.def @subgroup_scan_i32() {
  %unit = index.constant 1 : index
  %items = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup = kernel.subgroup.id : index
  %lane_i32 = index.cast %lane : index to i32
  %subgroup_i32 = index.cast %subgroup : index to i32
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %topology = buffer.view %scratch[%base] : buffer -> view<128x2xi32>
  view.store %lane_i32, %topology[%item, 0] : i32, view<128x2xi32>
  view.store %subgroup_i32, %topology[%item, 1] : i32, view<128x2xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %input_view = buffer.view %input[%base] : buffer -> view<128xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<128x4xi32>
  %value = view.load %input_view[%item] : view<128xi32> -> i32
  %forward_inclusive = kernel.subgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  %forward_exclusive = kernel.subgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  %reverse_inclusive = kernel.subgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i32
  %reverse_exclusive = kernel.subgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i32
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %sum_identity = scalar.constant 0 : i32
  %expected_forward_inclusive, %expected_forward_exclusive, %expected_reverse_inclusive, %expected_reverse_exclusive = scf.for %other = [%begin to %end step %step](%forward_inclusive_sum = %sum_identity : i32, %forward_exclusive_sum = %sum_identity : i32, %reverse_inclusive_sum = %sum_identity : i32, %reverse_exclusive_sum = %sum_identity : i32) -> (i32, i32, i32, i32) {
    %other_lane = view.load %topology[%other, 0] : view<128x2xi32> -> i32
    %other_subgroup = view.load %topology[%other, 1] : view<128x2xi32> -> i32
    %other_value = view.load %input_view[%other] : view<128xi32> -> i32
    %same_subgroup = scalar.cmpi eq, %subgroup_i32, %other_subgroup : i32
    %participating_value = scf.select %same_subgroup, %other_value, %sum_identity : i32
    %at_or_before = scalar.cmpi ule, %other_lane, %lane_i32 : i32
    %before = scalar.cmpi ult, %other_lane, %lane_i32 : i32
    %at_or_after = scalar.cmpi uge, %other_lane, %lane_i32 : i32
    %after = scalar.cmpi ugt, %other_lane, %lane_i32 : i32
    %forward_inclusive_value = scf.select %at_or_before, %participating_value, %sum_identity : i32
    %forward_exclusive_value = scf.select %before, %participating_value, %sum_identity : i32
    %reverse_inclusive_value = scf.select %at_or_after, %participating_value, %sum_identity : i32
    %reverse_exclusive_value = scf.select %after, %participating_value, %sum_identity : i32
    %next_forward_inclusive = scalar.addi %forward_inclusive_sum, %forward_inclusive_value : i32
    %next_forward_exclusive = scalar.addi %forward_exclusive_sum, %forward_exclusive_value : i32
    %next_reverse_inclusive = scalar.addi %reverse_inclusive_sum, %reverse_inclusive_value : i32
    %next_reverse_exclusive = scalar.addi %reverse_exclusive_sum, %reverse_exclusive_value : i32
    scf.yield %next_forward_inclusive, %next_forward_exclusive, %next_reverse_inclusive, %next_reverse_exclusive : i32, i32, i32, i32
  }
  %forward_inclusive_difference = scalar.xori %forward_inclusive, %expected_forward_inclusive : i32
  %forward_exclusive_difference = scalar.xori %forward_exclusive, %expected_forward_exclusive : i32
  %reverse_inclusive_difference = scalar.xori %reverse_inclusive, %expected_reverse_inclusive : i32
  %reverse_exclusive_difference = scalar.xori %reverse_exclusive, %expected_reverse_exclusive : i32
  view.store %forward_inclusive_difference, %output_view[%item, 0] : i32, view<128x4xi32>
  view.store %forward_exclusive_difference, %output_view[%item, 1] : i32, view<128x4xi32>
  view.store %reverse_inclusive_difference, %output_view[%item, 2] : i32, view<128x4xi32>
  view.store %reverse_exclusive_difference, %output_view[%item, 3] : i32, view<128x4xi32>
  kernel.return
}

func.def @subgroup_scan_i32_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %no_difference = vector.constant 0 : vector<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<128x4xi32>
  scf.for %item = [%begin to %end step %step] {
    vector.store %no_difference, %output_view[%item, 0] : vector<4xi32>, view<128x4xi32>
  }
  func.return
}

check.scenario @subgroup_scan_i32_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16 to 16) : tensor<128xi32>
    %output = check.generate.fill value(-559038737) : tensor<128x4xi32>
    check.compare<@subgroup_scan_i32, @subgroup_scan_i32_oracle>(%input, %output) : (tensor<128xi32>, tensor<128x4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<128x4xi32>
    }
  }
  check.return
}

// Compare bits except for NaN payloads, which extrema do not prescribe.
func.def device inline @scan_extrema_matches(%actual: vector<4xf32>, %expected: vector<4xf32>) -> (i32) {
  %actual_bits = vector.bitcast %actual : vector<4xf32> to vector<4xi32>
  %expected_bits = vector.bitcast %expected : vector<4xf32> to vector<4xi32>
  %magnitude_mask = vector.constant 2147483647 : vector<4xi32>
  %infinity_bits = vector.constant 2139095040 : vector<4xi32>
  %actual_magnitude = vector.andi %actual_bits, %magnitude_mask : vector<4xi32>
  %expected_magnitude = vector.andi %expected_bits, %magnitude_mask : vector<4xi32>
  %actual_nan = vector.cmpi sgt, %actual_magnitude, %infinity_bits : vector<4xi32> -> vector<4xi1>
  %expected_nan = vector.cmpi sgt, %expected_magnitude, %infinity_bits : vector<4xi32> -> vector<4xi1>
  %both_nan = vector.andi %actual_nan, %expected_nan : vector<4xi1>
  %same_bits = vector.cmpi eq, %actual_bits, %expected_bits : vector<4xi32> -> vector<4xi1>
  %matches = vector.ori %same_bits, %both_nan : vector<4xi1>
  %true = scalar.constant true : i1
  %all_match = vector.reduce<andi> %matches, %true : vector<4xi1>, i1
  %result = scalar.extui %all_match : i1 to i32
  func.return %result : i32
}

// Every active invocation reads the same runtime vector, so each nonempty
// prefix must reproduce it componentwise. Integer OR independently identifies
// empty prefixes without assuming subgroup size, dense packing, or lane zero.
// Odd workitems participate, leaving holes and a partial final subgroup.
kernel.def @subgroup_scan_float_extrema() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %unit = index.constant 1 : index
  %parity = index.andi %item, %unit : index
  %active = index.cmp eq, %parity, %unit : index
  %input_view = buffer.view %input[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<67x4xi32>
  %value = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  scf.if %active {
    %present = scalar.constant 1 : i32
    %absent = scalar.constant 0 : i32
    %prefix = kernel.subgroup.scan<ori> %present {direction = forward, mode = exclusive} : i32
    %has_prefix = scalar.cmpi ne, %prefix, %absent : i32
    %prefix_mask = vector.splat %has_prefix : vector<4xi1>
    %minimum_bound = vector.constant inf : vector<4xf32>
    %maximum_bound = vector.constant -inf : vector<4xf32>
    %expected_minimum = vector.select %prefix_mask, %value, %minimum_bound : vector<4xf32>
    %expected_maximum = vector.select %prefix_mask, %value, %maximum_bound : vector<4xf32>
    %exclusive_minimum = kernel.subgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : vector<4xf32>
    %exclusive_maximum = kernel.subgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : vector<4xf32>
    %inclusive_minimum = kernel.subgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : vector<4xf32>
    %inclusive_maximum = kernel.subgroup.scan<maxnumf> %value {direction = forward, mode = inclusive} : vector<4xf32>
    %exclusive_minimum_matches = func.call @scan_extrema_matches(%exclusive_minimum, %expected_minimum) : (vector<4xf32>, vector<4xf32>) -> (i32)
    %exclusive_maximum_matches = func.call @scan_extrema_matches(%exclusive_maximum, %expected_maximum) : (vector<4xf32>, vector<4xf32>) -> (i32)
    %inclusive_minimum_matches = func.call @scan_extrema_matches(%inclusive_minimum, %value) : (vector<4xf32>, vector<4xf32>) -> (i32)
    %inclusive_maximum_matches = func.call @scan_extrema_matches(%inclusive_maximum, %value) : (vector<4xf32>, vector<4xf32>) -> (i32)
    view.store %exclusive_minimum_matches, %output_view[%item, 0] : i32, view<67x4xi32>
    view.store %exclusive_maximum_matches, %output_view[%item, 1] : i32, view<67x4xi32>
    view.store %inclusive_minimum_matches, %output_view[%item, 2] : i32, view<67x4xi32>
    view.store %inclusive_maximum_matches, %output_view[%item, 3] : i32, view<67x4xi32>
  }
  kernel.return
}

func.def @subgroup_scan_extrema_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 1 : index
  %end = index.constant 67 : index
  %step = index.constant 2 : index
  %passed = vector.constant 1 : vector<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<67x4xi32>
  scf.for %item = [%begin to %end step %step] {
    vector.store %passed, %output_view[%item, 0] : vector<4xi32>, view<67x4xi32>
  }
  func.return
}

check.scenario @subgroup_scan_float_extrema_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2.0) step(1.0) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(inf) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-inf) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.4012984643248171e-45) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.return
}
