load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target:execution_profiles.bzl", "GPU_HARDWARE_VM_ORACLE_PROFILES")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_VM_ORACLE_PROFILE")
