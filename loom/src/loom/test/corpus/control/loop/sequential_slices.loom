  %actual = check.tensor.view %actual_storage offset(64) : tensor<672xi32> -> tensor<640xi32>
  kernel.launch @sequential_loop_slices(%counts, %actual, %length) : (tensor<64xi32>, tensor<640xi32>, i32)
  %expected_storage = check.generate.fill value(-123) : tensor<672xi32>
  %expected = check.tensor.view %expected_storage offset(64) : tensor<672xi32> -> tensor<640xi32>
  kernel.launch @sequential_loop_reference(%counts, %expected, %length) : (tensor<64xi32>, tensor<640xi32>, i32)
  check.expect.bitwise actual(%actual_storage) expected(%expected_storage) : tensor<672xi32>
