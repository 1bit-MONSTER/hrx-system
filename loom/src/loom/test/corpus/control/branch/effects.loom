// The positive count proves that the publishing lane also initializes.
kernel.def @conditional_publication() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %count: index) {
  %limit = index.assume %count [range(%count, 1, 64)] : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %values = buffer.view %output[%base] : buffer -> view<128xi32>
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    view.store %c1, %values[%c0] : i32, view<128xi32>
  }
  %active = index.cmp ult, %lane, %limit : index
  scf.if %active {
    %half = index.constant 64 : index
    %index = index.add %lane, %half : index
    view.store %c2, %values[%index] : i32, view<128xi32>
  }
  kernel.return
}

