  %inside = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<1xi32>
  %expected_inside = check.generate.iota offset(1) step(1) : tensor<1xi32>
  check.expect.bitwise actual(%inside) expected(%expected_inside) : tensor<1xi32>
  %first_inactive = check.tensor.view %storage offset(68) : tensor<224xi32> -> tensor<63xi32>
  %expected_first_inactive = check.generate.fill value(-99) : tensor<63xi32>
  check.expect.bitwise actual(%first_inactive) expected(%expected_first_inactive) : tensor<63xi32>
  %second = check.tensor.view %storage offset(320) : tensor<224xi32> -> tensor<1xi32>
  %expected_second = check.generate.iota offset(-3) step(-1) : tensor<1xi32>
  check.expect.bitwise actual(%second) expected(%expected_second) : tensor<1xi32>
  %second_inactive = check.tensor.view %storage offset(324) : tensor<224xi32> -> tensor<63xi32>
  %expected_second_inactive = check.generate.fill value(-99) : tensor<63xi32>
  check.expect.bitwise actual(%second_inactive) expected(%expected_second_inactive) : tensor<63xi32>
  %after = check.tensor.view %storage offset(576) : tensor<224xi32> -> tensor<64xi32>
