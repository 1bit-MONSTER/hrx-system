// The before region executes once even for an immediately false condition.
// It produces a wider body/result tuple than the count/value state returned on
// the backedge. Both condition-created values and the memory effect remain
// observable on exit.
func.def public @while_before_effects(%count: i32, %seed: i64) -> (i32, i64, i64, i32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %increment = scalar.constant 1 : i64
  %body_increment = scalar.constant 10 : i64
  %offset = index.constant 0 : offset
  %length = index.constant 1 : offset
  %visits = buffer.alloca<private> align(1) %length : buffer
  buffer.store.i8 %c0, %visits[%offset]
  %remaining, %value, %payload = scf.while(%before_count = %count : i32, %before_value = %seed : i64) -> (i32, i64, i64) {
    %previous_visits = buffer.load.i8.u %visits[%offset]
    %next_visits = scalar.addi %previous_visits, %c1 : i32
    buffer.store.i8 %next_visits, %visits[%offset]
    %forwarded = scalar.addi %before_value, %increment : i64
    %condition_payload = scalar.addi %forwarded, %increment : i64
    %condition = scalar.cmpi sgt, %before_count, %c0 : i32
    scf.condition %condition, %before_count, %forwarded, %condition_payload : i1, i32, i64, i64
  } do(%body_count: i32, %body_value: i64, %body_payload: i64) {
    %next_count = scalar.subi %body_count, %c1 : i32
    %next_value = scalar.addi %body_payload, %body_increment : i64
    scf.yield %next_count, %next_value : i32, i64
  }
  %visit_count = buffer.load.i8.u %visits[%offset]
  func.return %remaining, %value, %payload, %visit_count : i32, i64, i64, i32
}

check.case @while_before_effects_empty {
  %count = check.literal value(0) : i32
  %seed = check.literal value(4294967297) : i64
  %remaining, %value, %payload, %visits = func.call @while_before_effects(%count, %seed) : (i32, i64) -> (i32, i64, i64, i32)
  %expected_value = check.literal value(4294967298) : i64
  %expected_payload = check.literal value(4294967299) : i64
  %expected_visits = check.literal value(1) : i32
  check.expect.equal actual(%remaining) expected(%count) : i32
  check.expect.equal actual(%value) expected(%expected_value) : i64
  check.expect.equal actual(%payload) expected(%expected_payload) : i64
  check.expect.equal actual(%visits) expected(%expected_visits) : i32
  check.return
}

check.case @while_before_effects_repeated {
  %count = check.literal value(4) : i32
  %seed = check.literal value(4294967297) : i64
  %remaining, %value, %payload, %visits = func.call @while_before_effects(%count, %seed) : (i32, i64) -> (i32, i64, i64, i32)
  %c0 = check.literal value(0) : i32
  %expected_value = check.literal value(4294967346) : i64
  %expected_payload = check.literal value(4294967347) : i64
  %expected_visits = check.literal value(5) : i32
  check.expect.equal actual(%remaining) expected(%c0) : i32
  check.expect.equal actual(%value) expected(%expected_value) : i64
  check.expect.equal actual(%payload) expected(%expected_payload) : i64
  check.expect.equal actual(%visits) expected(%expected_visits) : i32
  check.return
}

// The inner bound depends on the outer induction variable. Diagonal and
// off-diagonal work meet at a value join before both loop-carried accumulators.
func.def public @triangular_sum(%extent: index) -> (i64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial = scalar.constant 0 : i64
  %result = scf.for %row = [%c0 to %extent step %c1](%outer_sum = %initial : i64) -> (i64) {
    %row_end = index.add %row, %c1 : index
    %row_value = index.cast %row_end : index to i64
    %row_sum = scf.for %column = [%c0 to %row_end step %c1](%inner_sum = %outer_sum : i64) -> (i64) {
      %diagonal = index.cmp eq, %row, %column : index
      %term = scf.if %diagonal -> (i64) {
        %square = scalar.muli %row_value, %row_value : i64
        scf.yield %square : i64
      } else {
        scf.yield %row_value : i64
      }
      %next = scalar.addi %inner_sum, %term : i64
      scf.yield %next : i64
    }
    scf.yield %row_sum : i64
  }
  func.return %result : i64
}

check.case @triangular_sum_empty {
  %extent = check.literal value(0) : index
  %result = func.call @triangular_sum(%extent) : (index) -> (i64)
  %expected = check.literal value(0) : i64
  check.expect.equal actual(%result) expected(%expected) : i64
  check.return
}

check.case @triangular_sum_single {
  %extent = check.literal value(1) : index
  %result = func.call @triangular_sum(%extent) : (index) -> (i64)
  %expected = check.literal value(1) : i64
  check.expect.equal actual(%result) expected(%expected) : i64
  check.return
}

check.case @triangular_sum_repeated {
  %extent = check.literal value(8) : index
  %result = func.call @triangular_sum(%extent) : (index) -> (i64)
  // Sum of k * (2k - 1), for k in [1, 8].
  %expected = check.literal value(372) : i64
  check.expect.equal actual(%result) expected(%expected) : i64
  check.return
}
