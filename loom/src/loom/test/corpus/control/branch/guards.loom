// Empty true arms preserve the guards around loads and nested loop effects.
func.def device inline @accumulate_nonnegative(%output: view<1xi32>, %value: i32) {
  %c0 = scalar.constant 0 : i32
  %skip = scalar.cmpi slt, %value, %c0 : i32
  scf.if %skip {
  } else {
    %previous = view.load %output[0] : view<1xi32> -> i32
    %next = scalar.addi %previous, %value : i32
    view.store %next, %output[0] : i32, view<1xi32>
  }
  func.return
}

kernel.def @conditional_guards() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %length: i32, %stop: i32, %iterations: index) {
  %c0 = scalar.constant 0 : i32
  %stopped = scalar.cmpi ne, %stop, %c0 : i32
  scf.if %stopped {
  } else {
    %lane = kernel.workitem.id<x> : index
    %lane_integer = index.cast %lane : index to i32
    %out_of_bounds = scalar.cmpi uge, %lane_integer, %length : i32
    scf.if %out_of_bounds {
    } else {
      %stride = index.constant 4 : offset
      %address = index.scale %lane, %stride : index, offset -> offset
      %input_view = buffer.view %input[%address] : buffer -> view<1xi32>
      %value = view.load %input_view[0] : view<1xi32> -> i32
      %output_view = buffer.view %output[%address] : buffer -> view<1xi32>
      %begin = index.constant 0 : index
      %step = index.constant 1 : index
      scf.for %iteration = [%begin to %iterations step %step] {
        func.call @accumulate_nonnegative(%output_view, %value) : (view<1xi32>, i32)
      }
    }
  }
  kernel.return
}

// A uniform stop suppresses loads even when length exceeds the input buffer.
check.case public @conditional_guards_stopped {
  %input = check.generate.iota offset(-18) step(1) : tensor<1xi32>
  %storage = check.generate.fill value(-123) : tensor<96xi32>
  %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
  %length = check.literal value(64) : i32
  %stop = check.literal value(1) : i32
  %iterations = check.literal value(3) : index
  kernel.launch @conditional_guards(%input, %output, %length, %stop, %iterations) : (tensor<1xi32>, tensor<64xi32>, i32, i32, index)
  %expected = check.generate.fill value(-123) : tensor<96xi32>
  check.expect.bitwise actual(%storage) expected(%expected) : tensor<96xi32>
  %original_input = check.generate.iota offset(-18) step(1) : tensor<1xi32>
  check.expect.bitwise actual(%input) expected(%original_input) : tensor<1xi32>
  check.return
}

// An empty active range performs no loads and leaves the output untouched.
check.case public @conditional_guards_empty {
  %input = check.generate.iota offset(-18) step(1) : tensor<1xi32>
  %storage = check.generate.fill value(-123) : tensor<96xi32>
  %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
  %length = check.literal value(0) : i32
  %stop = check.literal value(0) : i32
  %iterations = check.literal value(3) : index
  kernel.launch @conditional_guards(%input, %output, %length, %stop, %iterations) : (tensor<1xi32>, tensor<64xi32>, i32, i32, index)
  %expected = check.generate.fill value(-123) : tensor<96xi32>
  check.expect.bitwise actual(%storage) expected(%expected) : tensor<96xi32>
  %original_input = check.generate.iota offset(-18) step(1) : tensor<1xi32>
  check.expect.bitwise actual(%input) expected(%original_input) : tensor<1xi32>
  check.return
}

// Cross-wave tails and negative inputs leave their output unchanged. Active
// nonnegative inputs contribute three additions to the initial value of -123.
check.case public @conditional_guards_partial_wave {
  %input = check.generate.iota offset(-18) step(1) : tensor<37xi32>
  %storage = check.generate.fill value(-123) : tensor<96xi32>
  %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
  %length = check.literal value(37) : i32
  %stop = check.literal value(0) : i32
  %iterations = check.literal value(3) : index
  kernel.launch @conditional_guards(%input, %output, %length, %stop, %iterations) : (tensor<37xi32>, tensor<64xi32>, i32, i32, index)
  %prefix = check.tensor.view %storage offset(0) : tensor<96xi32> -> tensor<34xi32>
  %expected_prefix = check.generate.fill value(-123) : tensor<34xi32>
  check.expect.bitwise actual(%prefix) expected(%expected_prefix) : tensor<34xi32>
  %active = check.tensor.view %storage offset(136) : tensor<96xi32> -> tensor<19xi32>
  %expected_active = check.generate.iota offset(-123) step(3) : tensor<19xi32>
  check.expect.bitwise actual(%active) expected(%expected_active) : tensor<19xi32>
  %suffix = check.tensor.view %storage offset(212) : tensor<96xi32> -> tensor<43xi32>
  %expected_suffix = check.generate.fill value(-123) : tensor<43xi32>
  check.expect.bitwise actual(%suffix) expected(%expected_suffix) : tensor<43xi32>
  %original_input = check.generate.iota offset(-18) step(1) : tensor<37xi32>
  check.expect.bitwise actual(%input) expected(%original_input) : tensor<37xi32>
  check.return
}

// The reference is -123 plus three additions of each nonnegative input.
check.case public @conditional_guards_full_wave {
  %input = check.generate.iota offset(-18) step(1) : tensor<64xi32>
  %storage = check.generate.fill value(-123) : tensor<96xi32>
  %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
  %length = check.literal value(64) : i32
  %stop = check.literal value(0) : i32
  %iterations = check.literal value(3) : index
  kernel.launch @conditional_guards(%input, %output, %length, %stop, %iterations) : (tensor<64xi32>, tensor<64xi32>, i32, i32, index)
  %prefix = check.tensor.view %storage offset(0) : tensor<96xi32> -> tensor<34xi32>
  %expected_prefix = check.generate.fill value(-123) : tensor<34xi32>
  check.expect.bitwise actual(%prefix) expected(%expected_prefix) : tensor<34xi32>
  %active = check.tensor.view %storage offset(136) : tensor<96xi32> -> tensor<46xi32>
  %expected_active = check.generate.iota offset(-123) step(3) : tensor<46xi32>
  check.expect.bitwise actual(%active) expected(%expected_active) : tensor<46xi32>
  %suffix = check.tensor.view %storage offset(320) : tensor<96xi32> -> tensor<16xi32>
  %expected_suffix = check.generate.fill value(-123) : tensor<16xi32>
  check.expect.bitwise actual(%suffix) expected(%expected_suffix) : tensor<16xi32>
  %original_input = check.generate.iota offset(-18) step(1) : tensor<64xi32>
  check.expect.bitwise actual(%input) expected(%original_input) : tensor<64xi32>
  check.return
}
