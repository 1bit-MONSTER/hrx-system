// The two selected buffers are disjoint within each iteration, but exchange roles.
kernel.def @scheduled_unroll_swapping_roots() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_a: buffer, %input_b: buffer) {
  %a = buffer.assume.memory_space<global> %input_a : buffer
  %b = buffer.assume.memory_space<global> %input_b : buffer
  %base = index.constant 0 : offset
  %value0 = scalar.constant 1 : i32
  %value1 = scalar.constant 2 : i32
  %vec0 = vector.splat %value0 : vector<4xi32>
  %vec1 = vector.splat %value1 : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %i = [%start to %end step %step] unroll schedule(interleaved) {
    %first = index.cmp eq, %i, %start : index
    %left = scf.select %first, %a, %b : buffer
    %right = scf.select %first, %b, %a : buffer
    %left_unique, %right_unique = buffer.assume.noalias %left, %right : buffer, buffer
    %left_view = buffer.view %left_unique[%base] : buffer -> view<4xi32, %layout>
    %right_view = buffer.view %right_unique[%base] : buffer -> view<4xi32, %layout>
    vector.store %vec0, %left_view[0] : vector<4xi32>, view<4xi32, %layout>
    vector.store %vec1, %right_view[0] : vector<4xi32>, view<4xi32, %layout>
  }
  kernel.return
}

check.case public @scheduled_unroll_swapping_roots_result {
  %a = check.generate.fill value(0) : tensor<4xi32>
  %b = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @scheduled_unroll_swapping_roots(%a, %b) : (tensor<4xi32>, tensor<4xi32>)
  %expected_a = check.generate.fill value(2) : tensor<4xi32>
  %expected_b = check.generate.fill value(1) : tensor<4xi32>
  check.expect.bitwise actual(%a) expected(%expected_a) : tensor<4xi32>
  check.expect.bitwise actual(%b) expected(%expected_b) : tensor<4xi32>
  check.return
}

// A selected byte origin changes between iterations without exposing the IV in the access.
kernel.def @scheduled_unroll_selected_base() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %next_origin = index.constant 16 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %vec_one = vector.splat %first_value : vector<4xi32>
  %vec_two = vector.splat %second_value : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %i = [%start to %end step %step] unroll schedule(interleaved) {
    %first = index.cmp eq, %i, %start : index
    %base = scf.select %first, %origin, %next_origin : offset
    %view = buffer.view %output[%base] : buffer -> view<8xi32, %layout>
    vector.store %vec_one, %view[0] : vector<4xi32>, view<8xi32, %layout>
    vector.store %vec_two, %view[4] : vector<4xi32>, view<8xi32, %layout>
  }
  kernel.return
}

check.case public @scheduled_unroll_selected_base_result {
  %output = check.generate.fill value(0) : tensor<12xi32>
  kernel.launch @scheduled_unroll_selected_base(%output) : (tensor<12xi32>)
  %first = check.tensor.view %output offset(0) : tensor<12xi32> -> tensor<4xi32>
  %middle = check.tensor.view %output offset(16) : tensor<12xi32> -> tensor<4xi32>
  %last = check.tensor.view %output offset(32) : tensor<12xi32> -> tensor<4xi32>
  %ones = check.generate.fill value(1) : tensor<4xi32>
  %twos = check.generate.fill value(2) : tensor<4xi32>
  check.expect.bitwise actual(%first) expected(%ones) : tensor<4xi32>
  check.expect.bitwise actual(%middle) expected(%ones) : tensor<4xi32>
  check.expect.bitwise actual(%last) expected(%twos) : tensor<4xi32>
  check.return
}

// Loop-carried origins preserve the write order through the yielded dependency.
kernel.def @scheduled_unroll_carried_base() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %next_origin = index.constant 16 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %vec_one = vector.splat %first_value : vector<4xi32>
  %vec_two = vector.splat %second_value : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %final = scf.for %i = [%start to %end step %step](%base = %origin : offset) -> (offset) unroll schedule(interleaved) {
    %view = buffer.view %output[%base] : buffer -> view<8xi32, %layout>
    vector.store %vec_one, %view[0] : vector<4xi32>, view<8xi32, %layout>
    vector.store %vec_two, %view[4] : vector<4xi32>, view<8xi32, %layout>
    %next = index.sub %next_origin, %base : offset
    scf.yield %next : offset
  }
  kernel.return
}

check.case public @scheduled_unroll_carried_base_result {
  %output = check.generate.fill value(0) : tensor<12xi32>
  kernel.launch @scheduled_unroll_carried_base(%output) : (tensor<12xi32>)
  %first = check.tensor.view %output offset(0) : tensor<12xi32> -> tensor<4xi32>
  %middle = check.tensor.view %output offset(16) : tensor<12xi32> -> tensor<4xi32>
  %last = check.tensor.view %output offset(32) : tensor<12xi32> -> tensor<4xi32>
  %ones = check.generate.fill value(1) : tensor<4xi32>
  %twos = check.generate.fill value(2) : tensor<4xi32>
  check.expect.bitwise actual(%first) expected(%ones) : tensor<4xi32>
  check.expect.bitwise actual(%middle) expected(%ones) : tensor<4xi32>
  check.expect.bitwise actual(%last) expected(%twos) : tensor<4xi32>
  check.return
}

// Structured results have the same execution scope as scalar selects.
kernel.def @scheduled_unroll_nested_roots() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_a: buffer, %input_b: buffer) {
  %a = buffer.assume.memory_space<global> %input_a : buffer
  %b = buffer.assume.memory_space<global> %input_b : buffer
  %base = index.constant 0 : offset
  %value0 = scalar.constant 1 : i32
  %value1 = scalar.constant 2 : i32
  %vec0 = vector.splat %value0 : vector<4xi32>
  %vec1 = vector.splat %value1 : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %i = [%start to %end step %step] unroll schedule(interleaved) {
    %first = index.cmp eq, %i, %start : index
    %left = scf.if %first -> (buffer) {
      scf.yield %a : buffer
    } else {
      scf.yield %b : buffer
    }
    %right = scf.if %first -> (buffer) {
      scf.yield %b : buffer
    } else {
      scf.yield %a : buffer
    }
    %left_unique, %right_unique = buffer.assume.noalias %left, %right : buffer, buffer
    %left_view = buffer.view %left_unique[%base] : buffer -> view<4xi32, %layout>
    %right_view = buffer.view %right_unique[%base] : buffer -> view<4xi32, %layout>
    vector.store %vec0, %left_view[0] : vector<4xi32>, view<4xi32, %layout>
    vector.store %vec1, %right_view[0] : vector<4xi32>, view<4xi32, %layout>
  }
  kernel.return
}

check.case public @scheduled_unroll_nested_roots_result {
  %a = check.generate.fill value(0) : tensor<4xi32>
  %b = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @scheduled_unroll_nested_roots(%a, %b) : (tensor<4xi32>, tensor<4xi32>)
  %expected_a = check.generate.fill value(2) : tensor<4xi32>
  %expected_b = check.generate.fill value(1) : tensor<4xi32>
  check.expect.bitwise actual(%a) expected(%expected_a) : tensor<4xi32>
  check.expect.bitwise actual(%b) expected(%expected_b) : tensor<4xi32>
  check.return
}

// A structured byte-origin choice must not cancel across iterations.
kernel.def @scheduled_unroll_nested_base() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %next_origin = index.constant 16 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %vec_one = vector.splat %first_value : vector<4xi32>
  %vec_two = vector.splat %second_value : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %i = [%start to %end step %step] unroll schedule(interleaved) {
    %first = index.cmp eq, %i, %start : index
    %base = scf.if %first -> (offset) {
      scf.yield %origin : offset
    } else {
      scf.yield %next_origin : offset
    }
    %view = buffer.view %output[%base] : buffer -> view<8xi32, %layout>
    vector.store %vec_one, %view[0] : vector<4xi32>, view<8xi32, %layout>
    vector.store %vec_two, %view[4] : vector<4xi32>, view<8xi32, %layout>
  }
  kernel.return
}

check.case public @scheduled_unroll_nested_base_result {
  %output = check.generate.fill value(0) : tensor<12xi32>
  kernel.launch @scheduled_unroll_nested_base(%output) : (tensor<12xi32>)
  %first = check.tensor.view %output offset(0) : tensor<12xi32> -> tensor<4xi32>
  %middle = check.tensor.view %output offset(16) : tensor<12xi32> -> tensor<4xi32>
  %last = check.tensor.view %output offset(32) : tensor<12xi32> -> tensor<4xi32>
  %ones = check.generate.fill value(1) : tensor<4xi32>
  %twos = check.generate.fill value(2) : tensor<4xi32>
  check.expect.bitwise actual(%first) expected(%ones) : tensor<4xi32>
  check.expect.bitwise actual(%middle) expected(%ones) : tensor<4xi32>
  check.expect.bitwise actual(%last) expected(%twos) : tensor<4xi32>
  check.return
}

// An unchanged captured input can select the same byte origin in every iteration.
kernel.def @scheduled_unroll_readonly_choice() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input, %output : buffer, buffer
  %origin = index.constant 0 : offset
  %next_origin = index.constant 16 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %vec_one = vector.splat %first_value : vector<4xi32>
  %vec_two = vector.splat %second_value : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %input_view = buffer.view %input_unique[%origin] : buffer -> view<1xi32>
  scf.for %i = [%start to %end step %step] unroll schedule(interleaved) {
    %choice = view.load %input_view[0] : view<1xi32> -> i32
    %first = scalar.cmpi ne, %choice, %first_value : i32
    %base = scf.select %first, %origin, %next_origin : offset
    %view = buffer.view %output_unique[%base] : buffer -> view<8xi32, %layout>
    vector.store %vec_one, %view[0] : vector<4xi32>, view<8xi32, %layout>
    vector.store %vec_two, %view[4] : vector<4xi32>, view<8xi32, %layout>
  }
  kernel.return
}

check.case public @scheduled_unroll_readonly_choice_0 {
  %input = check.generate.fill value(0) : tensor<1xi32>
  %output = check.generate.fill value(0) : tensor<12xi32>
  kernel.launch @scheduled_unroll_readonly_choice(%input, %output) : (tensor<1xi32>, tensor<12xi32>)
  %actual0 = check.tensor.view %output offset(0) : tensor<12xi32> -> tensor<4xi32>
  %expected0 = check.generate.fill value(1) : tensor<4xi32>
  check.expect.bitwise actual(%actual0) expected(%expected0) : tensor<4xi32>
  %actual1 = check.tensor.view %output offset(16) : tensor<12xi32> -> tensor<4xi32>
  %expected1 = check.generate.fill value(2) : tensor<4xi32>
  check.expect.bitwise actual(%actual1) expected(%expected1) : tensor<4xi32>
  %actual2 = check.tensor.view %output offset(32) : tensor<12xi32> -> tensor<4xi32>
  %expected2 = check.generate.fill value(0) : tensor<4xi32>
  check.expect.bitwise actual(%actual2) expected(%expected2) : tensor<4xi32>
  check.return
}

check.case public @scheduled_unroll_readonly_choice_1 {
  %input = check.generate.fill value(1) : tensor<1xi32>
  %output = check.generate.fill value(0) : tensor<12xi32>
  kernel.launch @scheduled_unroll_readonly_choice(%input, %output) : (tensor<1xi32>, tensor<12xi32>)
  %actual0 = check.tensor.view %output offset(0) : tensor<12xi32> -> tensor<4xi32>
  %expected0 = check.generate.fill value(0) : tensor<4xi32>
  check.expect.bitwise actual(%actual0) expected(%expected0) : tensor<4xi32>
  %actual1 = check.tensor.view %output offset(16) : tensor<12xi32> -> tensor<4xi32>
  %expected1 = check.generate.fill value(1) : tensor<4xi32>
  check.expect.bitwise actual(%actual1) expected(%expected1) : tensor<4xi32>
  %actual2 = check.tensor.view %output offset(32) : tensor<12xi32> -> tensor<4xi32>
  %expected2 = check.generate.fill value(2) : tensor<4xi32>
  check.expect.bitwise actual(%actual2) expected(%expected2) : tensor<4xi32>
  check.return
}

// A read from written storage may select a different origin in the next iteration.
kernel.def @scheduled_unroll_mutable_choice() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %next_origin = index.constant 16 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %vec_one = vector.splat %first_value : vector<4xi32>
  %vec_two = vector.splat %second_value : vector<4xi32>
  %layout = encoding.layout.dense : encoding<layout>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %input_view = buffer.view %output[%origin] : buffer -> view<1xi32>
  scf.for %i = [%start to %end step %step] unroll schedule(interleaved) {
    %choice = view.load %input_view[0] : view<1xi32> -> i32
    %first = scalar.cmpi ne, %choice, %first_value : i32
    %base = scf.select %first, %origin, %next_origin : offset
    %view = buffer.view %output[%base] : buffer -> view<8xi32, %layout>
    vector.store %vec_one, %view[0] : vector<4xi32>, view<8xi32, %layout>
    vector.store %vec_two, %view[4] : vector<4xi32>, view<8xi32, %layout>
  }
  kernel.return
}

check.case public @scheduled_unroll_mutable_choice_0 {
  %output = check.generate.fill value(0) : tensor<12xi32>
  kernel.launch @scheduled_unroll_mutable_choice(%output) : (tensor<12xi32>)
  %actual0 = check.tensor.view %output offset(0) : tensor<12xi32> -> tensor<4xi32>
  %expected0 = check.generate.fill value(1) : tensor<4xi32>
  check.expect.bitwise actual(%actual0) expected(%expected0) : tensor<4xi32>
  %actual1 = check.tensor.view %output offset(16) : tensor<12xi32> -> tensor<4xi32>
  %expected1 = check.generate.fill value(1) : tensor<4xi32>
  check.expect.bitwise actual(%actual1) expected(%expected1) : tensor<4xi32>
  %actual2 = check.tensor.view %output offset(32) : tensor<12xi32> -> tensor<4xi32>
  %expected2 = check.generate.fill value(2) : tensor<4xi32>
  check.expect.bitwise actual(%actual2) expected(%expected2) : tensor<4xi32>
  check.return
}
