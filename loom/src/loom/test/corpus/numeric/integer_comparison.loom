  check.expect.equal actual(%ult) expected(%yes) : i1
  check.expect.equal actual(%ule) expected(%yes) : i1
  check.expect.equal actual(%ugt) expected(%no) : i1
  check.expect.equal actual(%uge) expected(%no) : i1
  check.return
}

check.case @compare_i32_descending {
  %a = check.param.choice values([2, 2147483647]) : i32
  %b = check.param.choice values([0, 1]) : i32
  %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge = func.call @compare_i32(%a, %b) : (i32, i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1)
