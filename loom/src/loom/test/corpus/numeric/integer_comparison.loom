// Every predicate is observable independently. Inputs distinguish equality,
// signed order, unsigned order, and high bits that cannot be truncated to i32.
func.def public @compare_i32(%a: i32, %b: i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %eq = scalar.cmpi eq, %a, %b : i32
  %ne = scalar.cmpi ne, %a, %b : i32
  %slt = scalar.cmpi slt, %a, %b : i32
  %sle = scalar.cmpi sle, %a, %b : i32
  %sgt = scalar.cmpi sgt, %a, %b : i32
  %sge = scalar.cmpi sge, %a, %b : i32
  %ult = scalar.cmpi ult, %a, %b : i32
  %ule = scalar.cmpi ule, %a, %b : i32
  %ugt = scalar.cmpi ugt, %a, %b : i32
  %uge = scalar.cmpi uge, %a, %b : i32
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

check.case @compare_i32_equal {
  %value = check.param.choice values([-2147483648, -1, 0, 1, 2147483647]) : i32
  %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge = func.call @compare_i32(%value, %value) : (i32, i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1)
  %yes = check.literal value(true) : i1
  %no = check.literal value(false) : i1
  check.expect.equal actual(%eq) expected(%yes) : i1
  check.expect.equal actual(%ne) expected(%no) : i1
  check.expect.equal actual(%slt) expected(%no) : i1
  check.expect.equal actual(%sle) expected(%yes) : i1
  check.expect.equal actual(%sgt) expected(%no) : i1
  check.expect.equal actual(%sge) expected(%yes) : i1
  check.expect.equal actual(%ult) expected(%no) : i1
  check.expect.equal actual(%ule) expected(%yes) : i1
  check.expect.equal actual(%ugt) expected(%no) : i1
  check.expect.equal actual(%uge) expected(%yes) : i1
  check.return
}

check.case @compare_i32_ascending {
  %a = check.param.choice values([0, 1]) : i32
  %b = check.param.choice values([2, 2147483647]) : i32
  %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge = func.call @compare_i32(%a, %b) : (i32, i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1)
  %yes = check.literal value(true) : i1
  %no = check.literal value(false) : i1
