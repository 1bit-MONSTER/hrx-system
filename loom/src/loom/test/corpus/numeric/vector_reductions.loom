func.def public @vector_integer_reductions(%a: i32, %b: i32, %c: i32, %d: i32, %initial: i32) -> (i32, i32, i32, i32, i32) {
  %values = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  %sum = vector.reduce<addi> %values, %initial : vector<4xi32>, i32
  %signed_min = vector.reduce<minsi> %values, %initial : vector<4xi32>, i32
  %signed_max = vector.reduce<maxsi> %values, %initial : vector<4xi32>, i32
  %unsigned_min = vector.reduce<minui> %values, %initial : vector<4xi32>, i32
  %unsigned_max = vector.reduce<maxui> %values, %initial : vector<4xi32>, i32
  func.return %sum, %signed_min, %signed_max, %unsigned_min, %unsigned_max : i32, i32, i32, i32, i32
}

check.case @vector_integer_reductions_case {
  %a = check.literal value(-2147483648) : i32
  %b = check.literal value(-1) : i32
  %c = check.literal value(0) : i32
  %d = check.literal value(7) : i32
  %initial = check.literal value(31) : i32
  %sum, %signed_min, %signed_max, %unsigned_min, %unsigned_max = func.call @vector_integer_reductions(%a, %b, %c, %d, %initial) : (i32, i32, i32, i32, i32) -> (i32, i32, i32, i32, i32)
  %expected_sum = check.literal value(-2147483611) : i32
  check.expect.equal actual(%sum) expected(%expected_sum) : i32
  check.expect.equal actual(%signed_min) expected(%a) : i32
  check.expect.equal actual(%signed_max) expected(%initial) : i32
  check.expect.equal actual(%unsigned_min) expected(%c) : i32
  check.expect.equal actual(%unsigned_max) expected(%b) : i32
  check.return
}

check.case @vector_integer_reductions_overflow_case {
  %maximum = check.literal value(2147483647) : i32
  %minimum = check.literal value(-2147483648) : i32
  %zero = check.literal value(0) : i32
  %initial = check.literal value(31) : i32
  %sum, %signed_min, %signed_max, %unsigned_min, %unsigned_max = func.call @vector_integer_reductions(%maximum, %maximum, %minimum, %zero, %initial) : (i32, i32, i32, i32, i32) -> (i32, i32, i32, i32, i32)
  %expected_sum = check.literal value(-2147483619) : i32
  check.expect.equal actual(%sum) expected(%expected_sum) : i32
  check.expect.equal actual(%signed_min) expected(%minimum) : i32
  check.expect.equal actual(%signed_max) expected(%maximum) : i32
  check.expect.equal actual(%unsigned_min) expected(%zero) : i32
  check.expect.equal actual(%unsigned_max) expected(%minimum) : i32
  check.return
}

func.def public @vector_bitwise_reductions(%a: i32, %b: i32, %c: i32, %initial: i32) -> (i32, i32, i32, i32) {
  %values = vector.from_elements %a, %b, %c : vector<3xi32>
  %product = vector.reduce<muli> %values, %initial : vector<3xi32>, i32
  %all_bits = vector.reduce<andi> %values, %initial : vector<3xi32>, i32
  %any_bits = vector.reduce<ori> %values, %initial : vector<3xi32>, i32
  %odd_bits = vector.reduce<xori> %values, %initial : vector<3xi32>, i32
  func.return %product, %all_bits, %any_bits, %odd_bits : i32, i32, i32, i32
}

check.case @vector_bitwise_reductions_case {
  %a = check.literal value(6) : i32
  %b = check.literal value(-3) : i32
  %c = check.literal value(5) : i32
  %initial = check.literal value(2) : i32
  %product, %all_bits, %any_bits, %odd_bits = func.call @vector_bitwise_reductions(%a, %b, %c, %initial) : (i32, i32, i32, i32) -> (i32, i32, i32, i32)
  %expected_product = check.literal value(-180) : i32
  %expected_all = check.literal value(0) : i32
  %expected_any = check.literal value(-1) : i32
  %expected_odd = check.literal value(-4) : i32
  check.expect.equal actual(%product) expected(%expected_product) : i32
  check.expect.equal actual(%all_bits) expected(%expected_all) : i32
  check.expect.equal actual(%any_bits) expected(%expected_any) : i32
  check.expect.equal actual(%odd_bits) expected(%expected_odd) : i32
  check.return
}

// An empty reduction returns the supplied accumulator, not a combining identity.
func.def public @vector_empty_reductions(%initial: i32) -> (i32, i32, i32, i32) {
  %empty = vector.splat %initial : vector<0xi32>
  %sum = vector.reduce<addi> %empty, %initial : vector<0xi32>, i32
  %product = vector.reduce<muli> %empty, %initial : vector<0xi32>, i32
  %minimum = vector.reduce<minsi> %empty, %initial : vector<0xi32>, i32
  %bits = vector.reduce<ori> %empty, %initial : vector<0xi32>, i32
  func.return %sum, %product, %minimum, %bits : i32, i32, i32, i32
}

check.case @vector_empty_reductions_case {
  %initial = check.literal value(-17) : i32
  %sum, %product, %minimum, %bits = func.call @vector_empty_reductions(%initial) : (i32) -> (i32, i32, i32, i32)
  check.expect.equal actual(%sum) expected(%initial) : i32
  check.expect.equal actual(%product) expected(%initial) : i32
  check.expect.equal actual(%minimum) expected(%initial) : i32
  check.expect.equal actual(%bits) expected(%initial) : i32
  check.return
}

// Distinct initial values expose accidental broadcast or repeated accumulation.
func.def public @vector_axis_reductions(%a: i32, %b: i32, %c: i32, %d: i32, %e: i32, %f: i32) -> (i32, i32, i32, i32, i32) {
  %matrix = vector.from_elements %a, %b, %c, %d, %e, %f : vector<2x3xi32>
  %transpose = vector.transpose<[1, 0]> %matrix : vector<2x3xi32> -> vector<3x2xi32>
  %c10 = scalar.constant 10 : i32
  %c100 = scalar.constant 100 : i32
  %c1000 = scalar.constant 1000 : i32
  %row_init = vector.from_elements %c10, %c100 : vector<2xi32>
  %column_init = vector.from_elements %c10, %c100, %c1000 : vector<3xi32>
  %rows = vector.reduce.axes<addi> %transpose, %row_init axes [0] : vector<3x2xi32>, vector<2xi32>
  %columns = vector.reduce.axes<addi> %transpose, %column_init axes [1] : vector<3x2xi32>, vector<3xi32>
  %r0 = vector.extract %rows[0] : vector<2xi32> -> i32
  %r1 = vector.extract %rows[1] : vector<2xi32> -> i32
  %c0 = vector.extract %columns[0] : vector<3xi32> -> i32
  %c1 = vector.extract %columns[1] : vector<3xi32> -> i32
  %c2 = vector.extract %columns[2] : vector<3xi32> -> i32
  func.return %r0, %r1, %c0, %c1, %c2 : i32, i32, i32, i32, i32
}

check.case @vector_axis_reductions_case {
  %a = check.literal value(-1) : i32
  %b = check.literal value(2) : i32
  %c = check.literal value(-3) : i32
  %d = check.literal value(4) : i32
  %e = check.literal value(-5) : i32
  %f = check.literal value(6) : i32
  %r0, %r1, %c0, %c1, %c2 = func.call @vector_axis_reductions(%a, %b, %c, %d, %e, %f) : (i32, i32, i32, i32, i32, i32) -> (i32, i32, i32, i32, i32)
  %e_r0 = check.literal value(8) : i32
  %e_r1 = check.literal value(105) : i32
  %e_c0 = check.literal value(13) : i32
  %e_c1 = check.literal value(97) : i32
  %e_c2 = check.literal value(1003) : i32
  check.expect.equal actual(%r0) expected(%e_r0) : i32
  check.expect.equal actual(%r1) expected(%e_r1) : i32
  check.expect.equal actual(%c0) expected(%e_c0) : i32
  check.expect.equal actual(%c1) expected(%e_c1) : i32
  check.expect.equal actual(%c2) expected(%e_c2) : i32
  check.return
}
