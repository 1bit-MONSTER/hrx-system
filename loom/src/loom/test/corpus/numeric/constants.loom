// Literal boundaries preserve declared types and exact bit patterns across
// the callable boundary.
func.def public @integer_constants_i64() -> (i64, i64, i64, i64, i64, i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  %negative = scalar.constant -1 : i64
  %signed_min = scalar.constant -32768 : i64
  %signed_max = scalar.constant 32767 : i64
  %below_signed = scalar.constant -32769 : i64
  %above_signed = scalar.constant 32768 : i64
  %unsigned_max = scalar.constant 4294967295 : i64
  %above_unsigned = scalar.constant 4294967296 : i64
  func.return %c0, %negative, %signed_min, %signed_max, %below_signed, %above_signed, %unsigned_max, %above_unsigned : i64, i64, i64, i64, i64, i64, i64, i64
}

check.case @integer_constants_i64_boundaries {
  %c0, %negative, %signed_min, %signed_max, %below_signed, %above_signed, %unsigned_max, %above_unsigned = func.call @integer_constants_i64() : () -> (i64, i64, i64, i64, i64, i64, i64, i64)
  %expected_zero = check.literal value(0) : i64
  %expected_negative = check.literal value(-1) : i64
  %expected_signed_min = check.literal value(-32768) : i64
  %expected_signed_max = check.literal value(32767) : i64
  %expected_below_signed = check.literal value(-32769) : i64
  %expected_above_signed = check.literal value(32768) : i64
  %expected_unsigned_max = check.literal value(4294967295) : i64
  %expected_above_unsigned = check.literal value(4294967296) : i64
  check.expect.equal actual(%c0) expected(%expected_zero) : i64
  check.expect.equal actual(%negative) expected(%expected_negative) : i64
  check.expect.equal actual(%signed_min) expected(%expected_signed_min) : i64
  check.expect.equal actual(%signed_max) expected(%expected_signed_max) : i64
  check.expect.equal actual(%below_signed) expected(%expected_below_signed) : i64
  check.expect.equal actual(%above_signed) expected(%expected_above_signed) : i64
  check.expect.equal actual(%unsigned_max) expected(%expected_unsigned_max) : i64
  check.expect.equal actual(%above_unsigned) expected(%expected_above_unsigned) : i64
  check.return
}

func.def public @integer_constants_i32() -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %c0 = scalar.constant 0 : i32
  %positive = scalar.constant 1 : i32
  %negative = scalar.constant -1 : i32
  %signed_min = scalar.constant -32768 : i32
  %signed_max = scalar.constant 32767 : i32
  %above_signed = scalar.constant 32768 : i32
  %below_signed = scalar.constant -32769 : i32
  %minimum = scalar.constant -2147483648 : i32
  func.return %c0, %positive, %negative, %signed_min, %signed_max, %above_signed, %below_signed, %minimum : i32, i32, i32, i32, i32, i32, i32, i32
}

check.case @integer_constants_i32_boundaries {
  %c0, %positive, %negative, %signed_min, %signed_max, %above_signed, %below_signed, %minimum = func.call @integer_constants_i32() : () -> (i32, i32, i32, i32, i32, i32, i32, i32)
  %expected_zero = check.literal value(0) : i32
  %expected_positive = check.literal value(1) : i32
  %expected_negative = check.literal value(-1) : i32
  %expected_signed_min = check.literal value(-32768) : i32
  %expected_signed_max = check.literal value(32767) : i32
  %expected_above_signed = check.literal value(32768) : i32
  %expected_below_signed = check.literal value(-32769) : i32
  %expected_minimum = check.literal value(-2147483648) : i32
  check.expect.equal actual(%c0) expected(%expected_zero) : i32
  check.expect.equal actual(%positive) expected(%expected_positive) : i32
  check.expect.equal actual(%negative) expected(%expected_negative) : i32
  check.expect.equal actual(%signed_min) expected(%expected_signed_min) : i32
  check.expect.equal actual(%signed_max) expected(%expected_signed_max) : i32
  check.expect.equal actual(%above_signed) expected(%expected_above_signed) : i32
  check.expect.equal actual(%below_signed) expected(%expected_below_signed) : i32
  check.expect.equal actual(%minimum) expected(%expected_minimum) : i32
  check.return
}

// Negating INT32_MIN during subtraction canonicalization must wrap at i32,
// not create an out-of-domain positive i32 literal from an i64 intermediate.
func.def public @subtract_i32_minimum(%value: i32) -> (i32) {
  %minimum = scalar.constant -2147483648 : i32
  %result = scalar.subi %value, %minimum : i32
  func.return %result : i32
}

check.case @subtract_i32_minimum_wraps {
  %zero = check.literal value(0) : i32
  %negative_one = check.literal value(-1) : i32
  %from_zero = func.call @subtract_i32_minimum(%zero) : (i32) -> (i32)
  %from_negative = func.call @subtract_i32_minimum(%negative_one) : (i32) -> (i32)
  %minimum = check.literal value(-2147483648) : i32
  %maximum = check.literal value(2147483647) : i32
  check.expect.equal actual(%from_zero) expected(%minimum) : i32
  check.expect.equal actual(%from_negative) expected(%maximum) : i32
  check.return
}

func.def public @integer_constants_narrow() -> (i1, i1, i8, i8, i16, i16) {
  %yes = scalar.constant true : i1
  %no = scalar.constant false : i1
  %byte_negative = scalar.constant -1 : i8
  %byte_positive = scalar.constant 127 : i8
  %word_negative = scalar.constant -32768 : i16
  %word_positive = scalar.constant 32767 : i16
  func.return %yes, %no, %byte_negative, %byte_positive, %word_negative, %word_positive : i1, i1, i8, i8, i16, i16
}

check.case @integer_constants_narrow_boundaries {
  %yes, %no, %byte_negative, %byte_positive, %word_negative, %word_positive = func.call @integer_constants_narrow() : () -> (i1, i1, i8, i8, i16, i16)
  %expected_yes = check.literal value(true) : i1
  %expected_no = check.literal value(false) : i1
  %expected_byte_negative = check.literal value(-1) : i8
  %expected_byte_positive = check.literal value(127) : i8
  %expected_word_negative = check.literal value(-32768) : i16
  %expected_word_positive = check.literal value(32767) : i16
  check.expect.equal actual(%yes) expected(%expected_yes) : i1
  check.expect.equal actual(%no) expected(%expected_no) : i1
  check.expect.equal actual(%byte_negative) expected(%expected_byte_negative) : i8
  check.expect.equal actual(%byte_positive) expected(%expected_byte_positive) : i8
  check.expect.equal actual(%word_negative) expected(%expected_word_negative) : i16
  check.expect.equal actual(%word_positive) expected(%expected_word_positive) : i16
  check.return
}

// Numeric zero comparisons would miss a changed sign bit or a flushed
// subnormal. The expected values are compared as complete float bit patterns.
func.def public @float_constant_patterns() -> (f32, f32, f32, f32, f64, f64, f64, f64) {
  %single_zero = scalar.constant 0.0 : f32
  %single_negative_zero = scalar.constant -0.0 : f32
  %single_tiny = scalar.constant 1.4012984643248171e-45 : f32
  %single_negative_tiny = scalar.constant -1.4012984643248171e-45 : f32
  %wide_zero = scalar.constant 0.0 : f64
  %wide_negative_zero = scalar.constant -0.0 : f64
  %wide_tiny = scalar.constant 4.9406564584124654e-324 : f64
  %wide_negative_tiny = scalar.constant -4.9406564584124654e-324 : f64
  func.return %single_zero, %single_negative_zero, %single_tiny, %single_negative_tiny, %wide_zero, %wide_negative_zero, %wide_tiny, %wide_negative_tiny : f32, f32, f32, f32, f64, f64, f64, f64
}

check.case @float_constant_patterns_preserve_all_bits {
  %single_zero, %single_negative_zero, %single_tiny, %single_negative_tiny, %wide_zero, %wide_negative_zero, %wide_tiny, %wide_negative_tiny = func.call @float_constant_patterns() : () -> (f32, f32, f32, f32, f64, f64, f64, f64)
  %expected_single_zero = check.literal value(0.0) : f32
  %expected_single_negative_zero = check.literal value(-0.0) : f32
  %expected_single_tiny = check.literal value(1.4012984643248171e-45) : f32
  %expected_single_negative_tiny = check.literal value(-1.4012984643248171e-45) : f32
  %expected_wide_zero = check.literal value(0.0) : f64
  %expected_wide_negative_zero = check.literal value(-0.0) : f64
  %expected_wide_tiny = check.literal value(4.9406564584124654e-324) : f64
  %expected_wide_negative_tiny = check.literal value(-4.9406564584124654e-324) : f64
  check.expect.bitwise actual(%single_zero) expected(%expected_single_zero) : f32
  check.expect.bitwise actual(%single_negative_zero) expected(%expected_single_negative_zero) : f32
  check.expect.bitwise actual(%single_tiny) expected(%expected_single_tiny) : f32
  check.expect.bitwise actual(%single_negative_tiny) expected(%expected_single_negative_tiny) : f32
  check.expect.bitwise actual(%wide_zero) expected(%expected_wide_zero) : f64
  check.expect.bitwise actual(%wide_negative_zero) expected(%expected_wide_negative_zero) : f64
  check.expect.bitwise actual(%wide_tiny) expected(%expected_wide_tiny) : f64
  check.expect.bitwise actual(%wide_negative_tiny) expected(%expected_wide_negative_tiny) : f64
  check.return
}
