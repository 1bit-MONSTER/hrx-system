func.def @f8E4M3_to_integer_1(%positive_input: buffer, %negative_input: buffer, %signed_output: buffer, %unsigned_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %positive = buffer.view %positive_input[%base] : buffer -> view<128xf8E4M3>
  %negative = buffer.view %negative_input[%base] : buffer -> view<128xf8E4M3>
  %signed = buffer.view %signed_output[%base] : buffer -> view<128xi32>
  %unsigned = buffer.view %unsigned_output[%base] : buffer -> view<128xi32>
  scf.for %i = [%begin to %end step %step] {
    %positive_value = view.load %positive[%i] : view<128xf8E4M3> -> f8E4M3
    %negative_value = view.load %negative[%i] : view<128xf8E4M3> -> f8E4M3
