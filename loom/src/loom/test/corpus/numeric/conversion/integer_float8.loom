// Integer inputs exercise FP8 rounding, finite saturation and IEEE overflow.
// Periodic byte inputs cover every finite FP8 payload for integer truncation;
// exceptional float-to-integer inputs remain outside the defined result domain.

func.def @i8_to_float_1(%input: buffer, %s_f8E5M2: buffer, %u_f8E5M2: buffer, %s_f8E4M3: buffer, %u_f8E4M3: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<256xi8>
  %s_f8E5M2_view = buffer.view %s_f8E5M2[%base] : buffer -> view<256xf8E5M2>
  %u_f8E5M2_view = buffer.view %u_f8E5M2[%base] : buffer -> view<256xf8E5M2>
  %s_f8E4M3_view = buffer.view %s_f8E4M3[%base] : buffer -> view<256xf8E4M3>
  %u_f8E4M3_view = buffer.view %u_f8E4M3[%base] : buffer -> view<256xf8E4M3>
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<256xi8> -> i8
    %s_f8E5M2_value = scalar.sitofp %value : i8 to f8E5M2
    view.store %s_f8E5M2_value, %s_f8E5M2_view[%i] : f8E5M2, view<256xf8E5M2>
    %u_f8E5M2_value = scalar.uitofp %value : i8 to f8E5M2
    view.store %u_f8E5M2_value, %u_f8E5M2_view[%i] : f8E5M2, view<256xf8E5M2>
    %s_f8E4M3_value = scalar.sitofp %value : i8 to f8E4M3
    view.store %s_f8E4M3_value, %s_f8E4M3_view[%i] : f8E4M3, view<256xf8E4M3>
    %u_f8E4M3_value = scalar.uitofp %value : i8 to f8E4M3
    view.store %u_f8E4M3_value, %u_f8E4M3_view[%i] : f8E4M3, view<256xf8E4M3>
  }
  func.return
}

