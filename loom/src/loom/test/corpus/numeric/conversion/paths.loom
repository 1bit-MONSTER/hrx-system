func.def public @float_conversion_paths(%e4: f8E4M3, %e5: f8E5M2, %half: f16, %brain: bf16) -> (f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64) {
  %r0 = scalar.extf %e4 : f8E4M3 to f16
  %r1 = scalar.extf %e5 : f8E5M2 to bf16
  %r2 = scalar.extf %half : f16 to f64
  %r3 = scalar.extf %brain : bf16 to f64
  %r4 = scalar.fptrunc %half : f16 to f8E4M3
  %r5 = scalar.fptrunc %brain : bf16 to f8E5M2
  %r6 = scalar.fptosi %e5 : f8E5M2 to i8
  %r7 = scalar.fptoui %half : f16 to i16
  %r8 = scalar.fptosi %brain : bf16 to i32
  %r9 = scalar.fptoui %e4 : f8E4M3 to i64
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9 : f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64
}

check.case @float_conversion_paths_case {
  %e4 = check.literal value(3.5) : f8E4M3
  %e5 = check.literal value(-2.5) : f8E5M2
  %half = check.literal value(7.75) : f16
  %brain = check.literal value(15.5) : bf16
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9 = func.call @float_conversion_paths(%e4, %e5, %half, %brain) : (f8E4M3, f8E5M2, f16, bf16) -> (f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64)
  %expected0 = check.literal value(3.5) : f16
  %expected1 = check.literal value(-2.5) : bf16
  %expected2 = check.literal value(7.75) : f64
  %expected3 = check.literal value(15.5) : f64
  %expected4 = check.literal value(8.0) : f8E4M3
  %expected5 = check.literal value(16.0) : f8E5M2
  %expected6 = check.literal value(-2) : i8
  %expected7 = check.literal value(7) : i16
  %expected8 = check.literal value(15) : i32
  %expected9 = check.literal value(3) : i64
  check.expect.equal actual(%r0) expected(%expected0) : f16
  check.expect.equal actual(%r1) expected(%expected1) : bf16
  check.expect.equal actual(%r2) expected(%expected2) : f64
  check.expect.equal actual(%r3) expected(%expected3) : f64
  check.expect.equal actual(%r4) expected(%expected4) : f8E4M3
  check.expect.equal actual(%r5) expected(%expected5) : f8E5M2
  check.expect.equal actual(%r6) expected(%expected6) : i8
  check.expect.equal actual(%r7) expected(%expected7) : i16
  check.expect.equal actual(%r8) expected(%expected8) : i32
  check.expect.equal actual(%r9) expected(%expected9) : i64
  check.return
}

func.def public @small_integer_float(%flag: i1, %byte: i8, %word: i16) -> (f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2) {
  %r0 = scalar.sitofp %flag : i1 to f8E4M3
  %r1 = scalar.uitofp %flag : i1 to f16
  %r2 = scalar.sitofp %byte : i8 to f32
  %r3 = scalar.uitofp %byte : i8 to f64
  %r4 = scalar.sitofp %word : i16 to bf16
  %r5 = scalar.uitofp %word : i16 to bf16
  %r6 = scalar.sitofp %byte : i8 to f8E5M2
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6 : f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2
}

check.case @small_integer_signedness {
  %flag = check.literal value(true) : i1
  %byte = check.literal value(-3) : i8
  %word = check.literal value(-1) : i16
  %r0, %r1, %r2, %r3, %r4, %r5, %r6 = func.call @small_integer_float(%flag, %byte, %word) : (i1, i8, i16) -> (f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2)
  %expected0 = check.literal value(-1.0) : f8E4M3
  %expected1 = check.literal value(1.0) : f16
  %expected2 = check.literal value(-3.0) : f32
  %expected3 = check.literal value(253.0) : f64
  %expected4 = check.literal value(-1.0) : bf16
  %expected5 = check.literal value(65536.0) : bf16
  %expected6 = check.literal value(-3.0) : f8E5M2
  check.expect.equal actual(%r0) expected(%expected0) : f8E4M3
  check.expect.equal actual(%r1) expected(%expected1) : f16
  check.expect.equal actual(%r2) expected(%expected2) : f32
  check.expect.equal actual(%r3) expected(%expected3) : f64
  check.expect.equal actual(%r4) expected(%expected4) : bf16
  check.expect.equal actual(%r5) expected(%expected5) : bf16
  check.expect.equal actual(%r6) expected(%expected6) : f8E5M2
  check.return
}

// Wide integers may be staged through f32 for these formats: every integer
// near a finite rounding boundary is exact in f32; larger values overflow.
func.def public @wide_integer_narrow_bits(%wide: i64) -> (i32, i32, i32, i32, i32, i32) {
  %half_signed = scalar.sitofp %wide : i64 to f16
  %e4_signed = scalar.sitofp %wide : i64 to f8E4M3
  %e5_signed = scalar.sitofp %wide : i64 to f8E5M2
  %half_unsigned = scalar.uitofp %wide : i64 to f16
  %e4_unsigned = scalar.uitofp %wide : i64 to f8E4M3
  %e5_unsigned = scalar.uitofp %wide : i64 to f8E5M2
  %bits0 = scalar.bitcast %half_signed : f16 to i16
  %bits1 = scalar.bitcast %e4_signed : f8E4M3 to i8
  %bits2 = scalar.bitcast %e5_signed : f8E5M2 to i8
  %bits3 = scalar.bitcast %half_unsigned : f16 to i16
  %bits4 = scalar.bitcast %e4_unsigned : f8E4M3 to i8
  %bits5 = scalar.bitcast %e5_unsigned : f8E5M2 to i8
  %r0 = scalar.extui %bits0 : i16 to i32
  %r1 = scalar.extui %bits1 : i8 to i32
  %r2 = scalar.extui %bits2 : i8 to i32
  %r3 = scalar.extui %bits3 : i16 to i32
  %r4 = scalar.extui %bits4 : i8 to i32
  %r5 = scalar.extui %bits5 : i8 to i32
  func.return %r0, %r1, %r2, %r3, %r4, %r5 : i32, i32, i32, i32, i32, i32
}

check.case @wide_integer_narrow_overflow {
  %wide = check.literal value(-1) : i64
  %r0, %r1, %r2, %r3, %r4, %r5 = func.call @wide_integer_narrow_bits(%wide) : (i64) -> (i32, i32, i32, i32, i32, i32)
  %negative_half = check.literal value(48128) : i32
  %negative_e4 = check.literal value(184) : i32
  %negative_e5 = check.literal value(188) : i32
  %infinite_half = check.literal value(31744) : i32
  %saturated_e4 = check.literal value(126) : i32
  %infinite_e5 = check.literal value(124) : i32
  check.expect.equal actual(%r0) expected(%negative_half) : i32
  check.expect.equal actual(%r1) expected(%negative_e4) : i32
  check.expect.equal actual(%r2) expected(%negative_e5) : i32
  check.expect.equal actual(%r3) expected(%infinite_half) : i32
  check.expect.equal actual(%r4) expected(%saturated_e4) : i32
  check.expect.equal actual(%r5) expected(%infinite_e5) : i32
  check.return
}

check.case @wide_integer_narrow_last_finite {
  %wide = check.literal value(65519) : i64
  %r0, %r1, %r2, %r3, %r4, %r5 = func.call @wide_integer_narrow_bits(%wide) : (i64) -> (i32, i32, i32, i32, i32, i32)
  %finite_half = check.literal value(31743) : i32
  %saturated_e4 = check.literal value(126) : i32
  %infinite_e5 = check.literal value(124) : i32
  check.expect.equal actual(%r0) expected(%finite_half) : i32
  check.expect.equal actual(%r1) expected(%saturated_e4) : i32
  check.expect.equal actual(%r2) expected(%infinite_e5) : i32
  check.expect.equal actual(%r3) expected(%finite_half) : i32
  check.expect.equal actual(%r4) expected(%saturated_e4) : i32
  check.expect.equal actual(%r5) expected(%infinite_e5) : i32
  check.return
}

check.case @wide_integer_narrow_above_finite_range {
  %wide = check.param.choice values([65520, 65521, 16777217, 9223372036854775807]) : i64
  %r0, %r1, %r2, %r3, %r4, %r5 = func.call @wide_integer_narrow_bits(%wide) : (i64) -> (i32, i32, i32, i32, i32, i32)
  %infinite_half = check.literal value(31744) : i32
  %saturated_e4 = check.literal value(126) : i32
  %infinite_e5 = check.literal value(124) : i32
  check.expect.equal actual(%r0) expected(%infinite_half) : i32
  check.expect.equal actual(%r1) expected(%saturated_e4) : i32
  check.expect.equal actual(%r2) expected(%infinite_e5) : i32
  check.expect.equal actual(%r3) expected(%infinite_half) : i32
  check.expect.equal actual(%r4) expected(%saturated_e4) : i32
  check.expect.equal actual(%r5) expected(%infinite_e5) : i32
  check.return
}
