// Runtime input buffers keep conversions out of constant folding. The
// reference evaluator rounds each original operation directly; native paths
// must agree bitwise, including every I8/I16 source pattern.

func.def @i8_to_float_1(%input: buffer, %s_f16: buffer, %u_f16: buffer, %s_bf16: buffer, %u_bf16: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<256xi8>
  %s_f16_view = buffer.view %s_f16[%base] : buffer -> view<256xf16>
  %u_f16_view = buffer.view %u_f16[%base] : buffer -> view<256xf16>
  %s_bf16_view = buffer.view %s_bf16[%base] : buffer -> view<256xbf16>
  %u_bf16_view = buffer.view %u_bf16[%base] : buffer -> view<256xbf16>
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<256xi8> -> i8
    %s_f16_value = scalar.sitofp %value : i8 to f16
    view.store %s_f16_value, %s_f16_view[%i] : f16, view<256xf16>
    %u_f16_value = scalar.uitofp %value : i8 to f16
    view.store %u_f16_value, %u_f16_view[%i] : f16, view<256xf16>
    %s_bf16_value = scalar.sitofp %value : i8 to bf16
    view.store %s_bf16_value, %s_bf16_view[%i] : bf16, view<256xbf16>
    %u_bf16_value = scalar.uitofp %value : i8 to bf16
    view.store %u_bf16_value, %u_bf16_view[%i] : bf16, view<256xbf16>
  }
  func.return
}

