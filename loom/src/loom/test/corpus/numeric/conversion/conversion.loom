func.def public @integer_widths(%boolean: i1, %word: i32, %wide: i64) -> (i32, i64, i64, i64, i1, i32) {
  %signed_boolean = scalar.extsi %boolean : i1 to i32
  %unsigned_boolean = scalar.extui %boolean : i1 to i64
  %signed_word = scalar.extsi %word : i32 to i64
  %unsigned_word = scalar.extui %word : i32 to i64
  %low_bit = scalar.trunci %wide : i64 to i1
  %low_word = scalar.trunci %wide : i64 to i32
  func.return %signed_boolean, %unsigned_boolean, %signed_word, %unsigned_word, %low_bit, %low_word : i32, i64, i64, i64, i1, i32
}

check.case @integer_sign_and_low_bits {
  %boolean = check.literal value(true) : i1
  %word = check.literal value(-1) : i32
  %wide = check.literal value(-4294967295) : i64
  %signed_boolean, %unsigned_boolean, %signed_word, %unsigned_word, %low_bit, %low_word = func.call @integer_widths(%boolean, %word, %wide) : (i1, i32, i64) -> (i32, i64, i64, i64, i1, i32)
  %one = check.literal value(1) : i32
  %wide_one = check.literal value(1) : i64
  %negative_one = check.literal value(-1) : i64
  %max_word = check.literal value(4294967295) : i64
  check.expect.equal actual(%signed_boolean) expected(%word) : i32
  check.expect.equal actual(%unsigned_boolean) expected(%wide_one) : i64
  check.expect.equal actual(%signed_word) expected(%negative_one) : i64
  check.expect.equal actual(%unsigned_word) expected(%max_word) : i64
  check.expect.equal actual(%low_bit) expected(%boolean) : i1
  check.expect.equal actual(%low_word) expected(%one) : i32
  check.return
}

// Neighboring f64 values at a binary32 midpoint must not be staged through f32.
func.def public @float_width_bits(%single_bits: i32, %double_bits: i64) -> (i64, i32) {
  %single = scalar.bitcast %single_bits : i32 to f32
  %double = scalar.bitcast %double_bits : i64 to f64
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  %wide_bits = scalar.bitcast %wide : f64 to i64
  %narrow_bits = scalar.bitcast %narrow : f32 to i32
  func.return %wide_bits, %narrow_bits : i64, i32
}

check.case @float_width_signed_zero {
  %single_bits = check.literal value(-2147483648) : i32
  %double_bits = check.literal value(-9223372036854775808) : i64
  %wide_bits, %narrow_bits = func.call @float_width_bits(%single_bits, %double_bits) : (i32, i64) -> (i64, i32)
  check.expect.equal actual(%wide_bits) expected(%double_bits) : i64
  check.expect.equal actual(%narrow_bits) expected(%single_bits) : i32
  check.return
}

check.case @float_width_nearest_even {
  %one_f32 = check.literal value(1065353216) : i32
  %one_f64 = check.literal value(4607182418800017408) : i64
  %midpoint = check.literal value(4607182419068452864) : i64
  %above_midpoint = check.literal value(4607182419068452865) : i64
  %next_f32 = check.literal value(1065353217) : i32
  %wide, %rounded = func.call @float_width_bits(%one_f32, %midpoint) : (i32, i64) -> (i64, i32)
  %wide_next, %rounded_next = func.call @float_width_bits(%one_f32, %above_midpoint) : (i32, i64) -> (i64, i32)
  check.expect.equal actual(%wide) expected(%one_f64) : i64
  check.expect.equal actual(%wide_next) expected(%one_f64) : i64
  check.expect.equal actual(%rounded) expected(%one_f32) : i32
  check.expect.equal actual(%rounded_next) expected(%next_f32) : i32
  check.return
}

func.def public @integer_to_float(%word: i32, %wide: i64) -> (f32, f64, f32, f64, f32, f64, f32, f64) {
  %signed_word_f32 = scalar.sitofp %word : i32 to f32
  %signed_word_f64 = scalar.sitofp %word : i32 to f64
  %unsigned_word_f32 = scalar.uitofp %word : i32 to f32
  %unsigned_word_f64 = scalar.uitofp %word : i32 to f64
  %signed_wide_f32 = scalar.sitofp %wide : i64 to f32
  %signed_wide_f64 = scalar.sitofp %wide : i64 to f64
  %unsigned_wide_f32 = scalar.uitofp %wide : i64 to f32
  %unsigned_wide_f64 = scalar.uitofp %wide : i64 to f64
  func.return %signed_word_f32, %signed_word_f64, %unsigned_word_f32, %unsigned_word_f64, %signed_wide_f32, %signed_wide_f64, %unsigned_wide_f32, %unsigned_wide_f64 : f32, f64, f32, f64, f32, f64, f32, f64
}

check.case @integer_to_float_signedness {
  %word = check.literal value(-1) : i32
  %wide = check.literal value(-1) : i64
  %signed_word_f32, %signed_word_f64, %unsigned_word_f32, %unsigned_word_f64, %signed_wide_f32, %signed_wide_f64, %unsigned_wide_f32, %unsigned_wide_f64 = func.call @integer_to_float(%word, %wide) : (i32, i64) -> (f32, f64, f32, f64, f32, f64, f32, f64)
  %negative_f32 = check.literal value(-1.0) : f32
  %negative_f64 = check.literal value(-1.0) : f64
  %max_word_f32 = check.literal value(4294967296.0) : f32
  %max_word_f64 = check.literal value(4294967295.0) : f64
  %max_wide_f32 = check.literal value(1.8446744073709552e+19) : f32
  %max_wide_f64 = check.literal value(1.8446744073709552e+19) : f64
  check.expect.equal actual(%signed_word_f32) expected(%negative_f32) : f32
  check.expect.equal actual(%signed_word_f64) expected(%negative_f64) : f64
  check.expect.equal actual(%unsigned_word_f32) expected(%max_word_f32) : f32
  check.expect.equal actual(%unsigned_word_f64) expected(%max_word_f64) : f64
  check.expect.equal actual(%signed_wide_f32) expected(%negative_f32) : f32
  check.expect.equal actual(%signed_wide_f64) expected(%negative_f64) : f64
  check.expect.equal actual(%unsigned_wide_f32) expected(%max_wide_f32) : f32
  check.expect.equal actual(%unsigned_wide_f64) expected(%max_wide_f64) : f64
  check.return
}

// Returns the exact conversion payloads so targets are compared independently
// of their floating-point ABI representation.
func.def @integer_to_float_observations(%word_bits: i64, %wide: i64) -> (i32, i64, i32, i64, i32, i64, i32, i64) {
  %word = scalar.trunci %word_bits : i64 to i32
  %signed_word_f32, %signed_word_f64, %unsigned_word_f32, %unsigned_word_f64, %signed_wide_f32, %signed_wide_f64, %unsigned_wide_f32, %unsigned_wide_f64 = func.call @integer_to_float(%word, %wide) : (i32, i64) -> (f32, f64, f32, f64, f32, f64, f32, f64)
  %signed_word_f32_bits = scalar.bitcast %signed_word_f32 : f32 to i32
  %signed_word_f64_bits = scalar.bitcast %signed_word_f64 : f64 to i64
  %unsigned_word_f32_bits = scalar.bitcast %unsigned_word_f32 : f32 to i32
  %unsigned_word_f64_bits = scalar.bitcast %unsigned_word_f64 : f64 to i64
  %signed_wide_f32_bits = scalar.bitcast %signed_wide_f32 : f32 to i32
  %signed_wide_f64_bits = scalar.bitcast %signed_wide_f64 : f64 to i64
  %unsigned_wide_f32_bits = scalar.bitcast %unsigned_wide_f32 : f32 to i32
  %unsigned_wide_f64_bits = scalar.bitcast %unsigned_wide_f64 : f64 to i64
  func.return %signed_word_f32_bits, %signed_word_f64_bits, %unsigned_word_f32_bits, %unsigned_word_f64_bits, %signed_wide_f32_bits, %signed_wide_f64_bits, %unsigned_wide_f32_bits, %unsigned_wide_f64_bits : i32, i64, i32, i64, i32, i64, i32, i64
}

// Selects signed, unsigned, and rounding boundaries without depending on the
// target's index width.
func.def @integer_to_float_boundary(%ordinal: index) -> (i32, i64, i32, i64, i32, i64, i32, i64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index

  %empty_value = scalar.constant 0 : i64
  %unit_value = scalar.constant 1 : i64
  %all_bits = scalar.constant -1 : i64
  %below_f32_exact_limit = scalar.constant 16777215 : i64
  %f32_exact_limit = scalar.constant 16777216 : i64
  %above_f32_exact_limit = scalar.constant 16777217 : i64
  %maximum_word = scalar.constant 2147483647 : i64
  %minimum_word = scalar.constant -2147483648 : i64
  %below_f64_exact_limit = scalar.constant 9007199254740991 : i64
  %f64_exact_limit = scalar.constant 9007199254740992 : i64
  %above_f64_exact_limit = scalar.constant 9007199254740993 : i64
  %maximum_wide = scalar.constant 9223372036854775807 : i64
  %minimum_wide = scalar.constant -9223372036854775808 : i64

  %word0 = scf.select %is0, %empty_value, %minimum_word : i64
  %word1 = scf.select %is1, %unit_value, %word0 : i64
  %word2 = scf.select %is2, %all_bits, %word1 : i64
  %word3 = scf.select %is3, %below_f32_exact_limit, %word2 : i64
  %word4 = scf.select %is4, %f32_exact_limit, %word3 : i64
  %word5 = scf.select %is5, %above_f32_exact_limit, %word4 : i64
  %word6 = scf.select %is6, %maximum_word, %word5 : i64
  %word7 = scf.select %is7, %minimum_word, %word6 : i64
  %word8 = scf.select %is8, %all_bits, %word7 : i64
  %word9 = scf.select %is9, %unit_value, %word8 : i64
  %wide0 = scf.select %is0, %empty_value, %minimum_wide : i64
  %wide1 = scf.select %is1, %unit_value, %wide0 : i64
  %wide2 = scf.select %is2, %all_bits, %wide1 : i64
  %wide3 = scf.select %is3, %below_f32_exact_limit, %wide2 : i64
  %wide4 = scf.select %is4, %f32_exact_limit, %wide3 : i64
  %wide5 = scf.select %is5, %above_f32_exact_limit, %wide4 : i64
  %wide6 = scf.select %is6, %below_f64_exact_limit, %wide5 : i64
  %wide7 = scf.select %is7, %f64_exact_limit, %wide6 : i64
  %wide8 = scf.select %is8, %above_f64_exact_limit, %wide7 : i64
  %wide = scf.select %is9, %maximum_wide, %wide8 : i64
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 = func.call @integer_to_float_observations(%word9, %wide) : (i64, i64) -> (i32, i64, i32, i64, i32, i64, i32, i64)
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 : i32, i64, i32, i64, i32, i64, i32, i64
}

check.scenario @integer_to_float_values {
  check.trial[11](%trial: index, %entropy: check.entropy) {
    check.compare<@integer_to_float_boundary>(%trial) : (index) -> [actual(%actual_signed_word_f32: i32, %actual_signed_word_f64: i64, %actual_unsigned_word_f32: i32, %actual_unsigned_word_f64: i64, %actual_signed_wide_f32: i32, %actual_signed_wide_f64: i64, %actual_unsigned_wide_f32: i32, %actual_unsigned_wide_f64: i64), expected(%expected_signed_word_f32: i32, %expected_signed_word_f64: i64, %expected_unsigned_word_f32: i32, %expected_unsigned_word_f64: i64, %expected_signed_wide_f32: i32, %expected_signed_wide_f64: i64, %expected_unsigned_wide_f32: i32, %expected_unsigned_wide_f64: i64)] {
      check.expect.equal actual(%actual_signed_word_f32) expected(%expected_signed_word_f32) : i32
      check.expect.equal actual(%actual_signed_word_f64) expected(%expected_signed_word_f64) : i64
      check.expect.equal actual(%actual_unsigned_word_f32) expected(%expected_unsigned_word_f32) : i32
      check.expect.equal actual(%actual_unsigned_word_f64) expected(%expected_unsigned_word_f64) : i64
      check.expect.equal actual(%actual_signed_wide_f32) expected(%expected_signed_wide_f32) : i32
      check.expect.equal actual(%actual_signed_wide_f64) expected(%expected_signed_wide_f64) : i64
      check.expect.equal actual(%actual_unsigned_wide_f32) expected(%expected_unsigned_wide_f32) : i32
      check.expect.equal actual(%actual_unsigned_wide_f64) expected(%expected_unsigned_wide_f64) : i64
    }
  }
  check.trial[1024](%trial: index, %entropy: check.entropy) {
    %word_entropy = check.entropy.fork %entropy name("word") : check.entropy
    %wide_entropy = check.entropy.fork %entropy name("wide") : check.entropy
    %word_bits = check.entropy.read %word_entropy[%trial] : check.entropy -> i64
    %wide = check.entropy.read %wide_entropy[%trial] : check.entropy -> i64
    check.compare<@integer_to_float_observations>(%word_bits, %wide) : (i64, i64) -> [actual(%actual_signed_word_f32: i32, %actual_signed_word_f64: i64, %actual_unsigned_word_f32: i32, %actual_unsigned_word_f64: i64, %actual_signed_wide_f32: i32, %actual_signed_wide_f64: i64, %actual_unsigned_wide_f32: i32, %actual_unsigned_wide_f64: i64), expected(%expected_signed_word_f32: i32, %expected_signed_word_f64: i64, %expected_unsigned_word_f32: i32, %expected_unsigned_word_f64: i64, %expected_signed_wide_f32: i32, %expected_signed_wide_f64: i64, %expected_unsigned_wide_f32: i32, %expected_unsigned_wide_f64: i64)] {
      check.expect.equal actual(%actual_signed_word_f32) expected(%expected_signed_word_f32) : i32
      check.expect.equal actual(%actual_signed_word_f64) expected(%expected_signed_word_f64) : i64
      check.expect.equal actual(%actual_unsigned_word_f32) expected(%expected_unsigned_word_f32) : i32
      check.expect.equal actual(%actual_unsigned_word_f64) expected(%expected_unsigned_word_f64) : i64
      check.expect.equal actual(%actual_signed_wide_f32) expected(%expected_signed_wide_f32) : i32
      check.expect.equal actual(%actual_signed_wide_f64) expected(%expected_signed_wide_f64) : i64
      check.expect.equal actual(%actual_unsigned_wide_f32) expected(%expected_unsigned_wide_f32) : i32
      check.expect.equal actual(%actual_unsigned_wide_f64) expected(%expected_unsigned_wide_f64) : i64
    }
  }
  check.return
}

func.def public @float_to_integer(%single: f32, %double: f64) -> (i32, i64, i32, i64) {
  %signed_word = scalar.fptosi %single : f32 to i32
  %signed_wide = scalar.fptosi %single : f32 to i64
  %unsigned_word = scalar.fptoui %double : f64 to i32
  %unsigned_wide = scalar.fptoui %double : f64 to i64
  func.return %signed_word, %signed_wide, %unsigned_word, %unsigned_wide : i32, i64, i32, i64
}

check.case @float_to_integer_truncates {
  %single = check.literal value(-7.75) : f32
  %double = check.literal value(4294967295.5) : f64
  %signed_word, %signed_wide, %unsigned_word, %unsigned_wide = func.call @float_to_integer(%single, %double) : (f32, f64) -> (i32, i64, i32, i64)
  %negative_word = check.literal value(-7) : i32
  %negative_wide = check.literal value(-7) : i64
  %max_word = check.literal value(-1) : i32
  %max_wide = check.literal value(4294967295) : i64
  check.expect.equal actual(%signed_word) expected(%negative_word) : i32
  check.expect.equal actual(%signed_wide) expected(%negative_wide) : i64
  check.expect.equal actual(%unsigned_word) expected(%max_word) : i32
  check.expect.equal actual(%unsigned_wide) expected(%max_wide) : i64
  check.return
}
