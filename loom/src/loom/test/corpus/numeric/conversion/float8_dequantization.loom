// Every byte encoding crosses scalar and packed conversion paths. Row scales
// are runtime data; the oracle uses scalar arithmetic and independent stores.
kernel.def @float8_dequantization() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %scales: buffer, %scalar_output: buffer, %vector_output: buffer, %bfloat_output: buffer, %decoded_output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %e4_source = buffer.view %input[%base] : buffer -> view<64x4xf8E4M3>
  %e5_source = buffer.view %input[%base] : buffer -> view<64x4xf8E5M2>
  %scale_source = buffer.view %scales[%base] : buffer -> view<64xf32>
  %scalar_result = buffer.view %scalar_output[%base] : buffer -> view<2x64x4xf32>
  %vector_result = buffer.view %vector_output[%base] : buffer -> view<2x64x4xf32>
  %bfloat_result = buffer.view %bfloat_output[%base] : buffer -> view<4x64x4xbf16>
  %decoded_result = buffer.view %decoded_output[%base] : buffer -> view<64x4x2xf32>
  %scale = view.load %scale_source[%lane] : view<64xf32> -> f32
  %scale_vector = vector.splat %scale : vector<4xf32>
  %e4 = vector.load %e4_source[%lane, 0] : view<64x4xf8E4M3> -> vector<4xf8E4M3>
  %e5 = vector.load %e5_source[%lane, 0] : view<64x4xf8E5M2> -> vector<4xf8E5M2>
  %e4_wide = vector.extf %e4 : vector<4xf8E4M3> to vector<4xf32>
  %e5_wide = vector.extf %e5 : vector<4xf8E5M2> to vector<4xf32>
  %e4_brain = vector.extf %e4 : vector<4xf8E4M3> to vector<4xbf16>
  %e5_brain = vector.extf %e5 : vector<4xf8E5M2> to vector<4xbf16>
  %e4_scaled = vector.mulf %e4_wide, %scale_vector : vector<4xf32>
  %e5_scaled = vector.mulf %e5_wide, %scale_vector : vector<4xf32>
  %e4_scaled_brain = vector.fptrunc %e4_scaled : vector<4xf32> to vector<4xbf16>
  %e5_scaled_brain = vector.fptrunc %e5_scaled : vector<4xf32> to vector<4xbf16>
  vector.store %e4_wide, %vector_result[0, %lane, 0] : vector<4xf32>, view<2x64x4xf32>
  vector.store %e5_wide, %vector_result[1, %lane, 0] : vector<4xf32>, view<2x64x4xf32>
  vector.store %e4_brain, %bfloat_result[0, %lane, 0] : vector<4xbf16>, view<4x64x4xbf16>
  vector.store %e5_brain, %bfloat_result[1, %lane, 0] : vector<4xbf16>, view<4x64x4xbf16>
  vector.store %e4_scaled_brain, %bfloat_result[2, %lane, 0] : vector<4xbf16>, view<4x64x4xbf16>
  vector.store %e5_scaled_brain, %bfloat_result[3, %lane, 0] : vector<4xbf16>, view<4x64x4xbf16>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %schema = encoding.define #encoding.f8e4m3<affine=scale_only, payload_elements=2, scale_format=f32, scale_group_elements=2, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %decode_scale = vector.splat %scale : vector<1xf32>
  scf.for %column = [%begin to %end step %step] {
    %e4_scalar = view.load %e4_source[%lane, %column] : view<64x4xf8E4M3> -> f8E4M3
    %e5_scalar = view.load %e5_source[%lane, %column] : view<64x4xf8E5M2> -> f8E5M2
    %e4_scalar_wide = scalar.extf %e4_scalar : f8E4M3 to f32
    %e5_scalar_wide = scalar.extf %e5_scalar : f8E5M2 to f32
    view.store %e4_scalar_wide, %scalar_result[0, %lane, %column] : f32, view<2x64x4xf32>
    view.store %e5_scalar_wide, %scalar_result[1, %lane, %column] : f32, view<2x64x4xf32>
    %payload = vector.splat %e4_scalar : vector<2xf8E4M3>
    %decoded = vector.decode %payload using %schema {scale = %decode_scale : vector<1xf32>} : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
    vector.store %decoded, %decoded_result[%lane, %column, 0] : vector<2xf32>, view<64x4x2xf32>
  }
  kernel.return
}

func.def @float8_dequantization_oracle(%input: buffer, %scales: buffer, %scalar_output: buffer, %vector_output: buffer, %bfloat_output: buffer, %decoded_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %rows = index.constant 64 : index
  %columns = index.constant 4 : index
  %step = index.constant 1 : index
  %e4_source = buffer.view %input[%base] : buffer -> view<64x4xf8E4M3>
  %e5_source = buffer.view %input[%base] : buffer -> view<64x4xf8E5M2>
  %bytes = buffer.view %input[%base] : buffer -> view<64x4xi8>
  %scale_source = buffer.view %scales[%base] : buffer -> view<64xf32>
  %scalar_result = buffer.view %scalar_output[%base] : buffer -> view<2x64x4xf32>
  %vector_result = buffer.view %vector_output[%base] : buffer -> view<2x64x4xf32>
  %bfloat_result = buffer.view %bfloat_output[%base] : buffer -> view<4x64x4xbf16>
  %decoded_result = buffer.view %decoded_output[%base] : buffer -> view<64x4x2xf32>
  %magnitude_mask = scalar.constant 127 : i32
  %sign_mask = scalar.constant 128 : i32
  %sign_shift = scalar.constant 24 : i32
  %special_exponent = scalar.constant 120 : i32
  %infinity_bits = scalar.constant 2139095040 : i32
  %nan_bits = scalar.constant 2143289344 : i32
  scf.for %row = [%begin to %rows step %step] {
    %scale = view.load %scale_source[%row] : view<64xf32> -> f32
    scf.for %column = [%begin to %columns step %step] {
      %e4 = view.load %e4_source[%row, %column] : view<64x4xf8E4M3> -> f8E4M3
      %e5 = view.load %e5_source[%row, %column] : view<64x4xf8E5M2> -> f8E5M2
      %e4_wide = scalar.extf %e4 : f8E4M3 to f32
      %e5_wide = scalar.extf %e5 : f8E5M2 to f32
      %e4_brain = scalar.fptrunc %e4_wide : f32 to bf16
      %e5_brain = scalar.fptrunc %e5_wide : f32 to bf16
      %e4_scaled = scalar.mulf %e4_wide, %scale : f32
      %e5_scaled = scalar.mulf %e5_wide, %scale : f32
      %e4_scaled_brain = scalar.fptrunc %e4_scaled : f32 to bf16
      %e5_scaled_brain = scalar.fptrunc %e5_scaled : f32 to bf16
      view.store %e4_wide, %scalar_result[0, %row, %column] : f32, view<2x64x4xf32>
      view.store %e5_wide, %scalar_result[1, %row, %column] : f32, view<2x64x4xf32>
      view.store %e4_wide, %vector_result[0, %row, %column] : f32, view<2x64x4xf32>
      view.store %e5_wide, %vector_result[1, %row, %column] : f32, view<2x64x4xf32>
      view.store %e4_brain, %bfloat_result[0, %row, %column] : bf16, view<4x64x4xbf16>
      view.store %e5_brain, %bfloat_result[1, %row, %column] : bf16, view<4x64x4xbf16>
      view.store %e4_scaled_brain, %bfloat_result[2, %row, %column] : bf16, view<4x64x4xbf16>
      view.store %e5_scaled_brain, %bfloat_result[3, %row, %column] : bf16, view<4x64x4xbf16>
      // IEEE E4M3 reserves the top exponent; scalar E4M3FN uses it for finite
      // values except the final NaN payload. Decode those IEEE cases explicitly.
      %byte = view.load %bytes[%row, %column] : view<64x4xi8> -> i8
      %bits = scalar.extui %byte : i8 to i32
      %magnitude = scalar.andi %bits, %magnitude_mask : i32
      %sign = scalar.andi %bits, %sign_mask : i32
      %sign_bits = scalar.shli %sign, %sign_shift : i32
      %is_special = scalar.cmpi uge, %magnitude, %special_exponent : i32
      %is_infinity = scalar.cmpi eq, %magnitude, %special_exponent : i32
      %special_bits = scf.select %is_infinity, %infinity_bits, %nan_bits : i32
      %signed_bits = scalar.ori %special_bits, %sign_bits : i32
      %special = scalar.bitcast %signed_bits : i32 to f32
      %decode_value = scf.select %is_special, %special, %e4_wide : f32
      %decoded = scalar.mulf %decode_value, %scale : f32
      view.store %decoded, %decoded_result[%row, %column, 0] : f32, view<64x4x2xf32>
      view.store %decoded, %decoded_result[%row, %column, 1] : f32, view<64x4x2xf32>
    }
  }
  func.return
}

check.scenario @float8_dequantization_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %scales = check.generate.random.uniform seed(%seed) range(-2.0 to 2.0) : tensor<64xf32>
    %scalar_storage = check.generate.fill value(-123.0) : tensor<520xf32>
    %vector_storage = check.generate.fill value(-123.0) : tensor<520xf32>
    %bfloat_storage = check.generate.fill value(-123.0) : tensor<1040xbf16>
    %decoded_storage = check.generate.fill value(-123.0) : tensor<520xf32>
    %scalar_output = check.tensor.view %scalar_storage offset(16) : tensor<520xf32> -> tensor<512xf32>
    %vector_output = check.tensor.view %vector_storage offset(16) : tensor<520xf32> -> tensor<512xf32>
    %bfloat_output = check.tensor.view %bfloat_storage offset(16) : tensor<1040xbf16> -> tensor<1024xbf16>
    %decoded_output = check.tensor.view %decoded_storage offset(16) : tensor<520xf32> -> tensor<512xf32>
    %e4_negative_zero = check.tensor.view %vector_output offset(0) : tensor<512xf32> -> tensor<1xf32>
    %e4_positive_zero = check.tensor.view %vector_output offset(512) : tensor<512xf32> -> tensor<1xf32>
    %e5_negative_zero = check.tensor.view %vector_output offset(1024) : tensor<512xf32> -> tensor<1xf32>
    %e5_positive_zero = check.tensor.view %vector_output offset(1536) : tensor<512xf32> -> tensor<1xf32>
    %scaled_zeros = check.tensor.view %decoded_output offset(0) : tensor<512xf32> -> tensor<2xf32>
    %e4_bfloat_zero = check.tensor.view %bfloat_output offset(0) : tensor<1024xbf16> -> tensor<1xbf16>
    %e5_bfloat_zero = check.tensor.view %bfloat_output offset(512) : tensor<1024xbf16> -> tensor<1xbf16>
    %e4_scaled_zero = check.tensor.view %bfloat_output offset(1024) : tensor<1024xbf16> -> tensor<1xbf16>
    %e5_scaled_zero = check.tensor.view %bfloat_output offset(1536) : tensor<1024xbf16> -> tensor<1xbf16>
    check.compare<@float8_dequantization, @float8_dequantization_oracle>(%input, %scales, %scalar_output, %vector_output, %bfloat_output, %decoded_output) : (tensor<256xi8>, tensor<64xf32>, tensor<512xf32>, tensor<512xf32>, tensor<1024xbf16>, tensor<512xf32>) -> () {
      check.expect.close actual(%scalar_storage) expected(%scalar_storage) atol(0.0) rtol(0.0) nan(same) : tensor<520xf32>
      check.expect.close actual(%vector_storage) expected(%vector_storage) atol(0.0) rtol(0.0) nan(same) : tensor<520xf32>
      check.expect.close actual(%bfloat_storage) expected(%bfloat_storage) atol(0.0) rtol(0.0) nan(same) : tensor<1040xbf16>
      check.expect.close actual(%decoded_storage) expected(%decoded_storage) atol(0.0) rtol(0.0) nan(same) : tensor<520xf32>
      check.expect.bitwise actual(%e4_negative_zero) expected(%e4_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e4_positive_zero) expected(%e4_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e5_negative_zero) expected(%e5_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e5_positive_zero) expected(%e5_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%scaled_zeros) expected(%scaled_zeros) : tensor<2xf32>
      check.expect.bitwise actual(%e4_bfloat_zero) expected(%e4_bfloat_zero) : tensor<1xbf16>
      check.expect.bitwise actual(%e5_bfloat_zero) expected(%e5_bfloat_zero) : tensor<1xbf16>
      check.expect.bitwise actual(%e4_scaled_zero) expected(%e4_scaled_zero) : tensor<1xbf16>
      check.expect.bitwise actual(%e5_scaled_zero) expected(%e5_scaled_zero) : tensor<1xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %scales = check.generate.iota offset(-2.0) step(1.0) period(5) : tensor<64xf32>
    %scalar_storage = check.generate.fill value(-123.0) : tensor<520xf32>
    %vector_storage = check.generate.fill value(-123.0) : tensor<520xf32>
    %bfloat_storage = check.generate.fill value(-123.0) : tensor<1040xbf16>
    %decoded_storage = check.generate.fill value(-123.0) : tensor<520xf32>
    %scalar_output = check.tensor.view %scalar_storage offset(16) : tensor<520xf32> -> tensor<512xf32>
    %vector_output = check.tensor.view %vector_storage offset(16) : tensor<520xf32> -> tensor<512xf32>
    %bfloat_output = check.tensor.view %bfloat_storage offset(16) : tensor<1040xbf16> -> tensor<1024xbf16>
    %decoded_output = check.tensor.view %decoded_storage offset(16) : tensor<520xf32> -> tensor<512xf32>
    check.compare<@float8_dequantization, @float8_dequantization_oracle>(%input, %scales, %scalar_output, %vector_output, %bfloat_output, %decoded_output) : (tensor<256xi8>, tensor<64xf32>, tensor<512xf32>, tensor<512xf32>, tensor<1024xbf16>, tensor<512xf32>) -> () {
      check.expect.close actual(%scalar_storage) expected(%scalar_storage) atol(0.0) rtol(0.0) nan(same) : tensor<520xf32>
      check.expect.close actual(%vector_storage) expected(%vector_storage) atol(0.0) rtol(0.0) nan(same) : tensor<520xf32>
      check.expect.close actual(%bfloat_storage) expected(%bfloat_storage) atol(0.0) rtol(0.0) nan(same) : tensor<1040xbf16>
      check.expect.close actual(%decoded_storage) expected(%decoded_storage) atol(0.0) rtol(0.0) nan(same) : tensor<520xf32>
    }
  }
  check.return
}

// Each scenario invocation decodes one runtime case. Directed scale words
// cover the E8M0 edges while deterministic entropy expands payload coverage.
// A single MXFP8 group covers the ordinary BF16 decode path.
func.def inline @e8m0_mxfp8_bf16_body(%input_buffer: buffer, %output_buffer: buffer) {
  %input, %output = buffer.assume.noalias %input_buffer, %output_buffer : buffer, buffer
  %base = index.constant 0 : offset
  %payload_offset = index.constant 4 : offset
  %origin = index.constant 0 : index
  %scale_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %payload_view = buffer.view %input[%payload_offset] : buffer -> view<8xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<8xbf16>
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=8, scale_format=e8m0, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %payload_bits = vector.load %payload_view[%origin] : view<8xi8> -> vector<8xi8>
  %payload = vector.bitcast %payload_bits : vector<8xi8> to vector<8xf8E4M3>
  %scale = vector.load %scale_view[%origin] : view<1xi32> -> vector<1xi32>
  %decoded = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xbf16>
  vector.store %decoded, %output_view[%origin] : vector<8xbf16>, view<8xbf16>
  func.return
}

kernel.def @e8m0_mxfp8_bf16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  func.call @e8m0_mxfp8_bf16_body(%input_buffer, %output_buffer) : (buffer, buffer)
  kernel.return
}

func.def @e8m0_mxfp8_bf16_oracle(%input_buffer: buffer, %output_buffer: buffer) {
  func.call @e8m0_mxfp8_bf16_body(%input_buffer, %output_buffer) : (buffer, buffer)
  func.return
}

check.scenario @e8m0_mxfp8_bf16_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(16843009) period(256) : tensor<3xi32>
    %expected_input = check.generate.iota offset(0) step(16843009) period(256) : tensor<3xi32>
    %output = check.generate.fill value(-123.0) : tensor<8xbf16>
    check.compare<@e8m0_mxfp8_bf16, @e8m0_mxfp8_bf16_oracle>(%input, %output) : (tensor<3xi32>, tensor<8xbf16>) -> () {
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<3xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xbf16>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("e8m0_mxfp8_bf16_input") : check.entropy
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<3xi32>
    %expected_input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<3xi32>
    %output = check.generate.fill value(-123.0) : tensor<8xbf16>
    check.compare<@e8m0_mxfp8_bf16, @e8m0_mxfp8_bf16_oracle>(%input, %output) : (tensor<3xi32>, tensor<8xbf16>) -> () {
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<3xi32>
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<8xbf16>
    }
  }
  check.return
}

// Four packed E8M0 groups cover minimum, identity, doubled, and NaN scales.
func.def inline @e8m0_mxfp8_grouped_body(%payload_buffer: buffer, %scale_buffer: buffer, %output_buffer: buffer) {
  %payload_input, %scale_input, %output = buffer.assume.noalias %payload_buffer, %scale_buffer, %output_buffer : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %bf16_output_offset = index.constant 128 : offset
  %f16_output_offset = index.constant 192 : offset
  %origin = index.constant 0 : index
  %payload_view = buffer.view %payload_input[%base] : buffer -> view<32xi8>
  %scale_view = buffer.view %scale_input[%base] : buffer -> view<1xi32>
  %f32_output_view = buffer.view %output[%base] : buffer -> view<32xf32>
  %bf16_output_view = buffer.view %output[%bf16_output_offset] : buffer -> view<32xbf16>
  %f16_output_view = buffer.view %output[%f16_output_offset] : buffer -> view<32xf16>
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=32, scale_format=e8m0, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %payload_bits = vector.load %payload_view[%origin] : view<32xi8> -> vector<32xi8>
  %payload = vector.bitcast %payload_bits : vector<32xi8> to vector<32xf8E4M3>
  %scale = vector.load %scale_view[%origin] : view<1xi32> -> vector<1xi32>
  %f32 = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<32xf8E4M3>, encoding<schema> -> vector<32xf32>
  %bf16 = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<32xf8E4M3>, encoding<schema> -> vector<32xbf16>
  %f16 = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<32xf8E4M3>, encoding<schema> -> vector<32xf16>
  vector.store %f32, %f32_output_view[%origin] : vector<32xf32>, view<32xf32>
  vector.store %bf16, %bf16_output_view[%origin] : vector<32xbf16>, view<32xbf16>
  vector.store %f16, %f16_output_view[%origin] : vector<32xf16>, view<32xf16>
  func.return
}

kernel.def @e8m0_mxfp8_grouped() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload_buffer: buffer, %scale_buffer: buffer, %output_buffer: buffer) {
  func.call @e8m0_mxfp8_grouped_body(%payload_buffer, %scale_buffer, %output_buffer) : (buffer, buffer, buffer)
  kernel.return
}

func.def @e8m0_mxfp8_grouped_oracle(%payload_buffer: buffer, %scale_buffer: buffer, %output_buffer: buffer) {
  func.call @e8m0_mxfp8_grouped_body(%payload_buffer, %scale_buffer, %output_buffer) : (buffer, buffer, buffer)
  func.return
}

check.scenario @e8m0_mxfp8_grouped_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %payload = check.generate.fill value(56) : tensor<32xi8>
    %expected_payload = check.generate.fill value(56) : tensor<32xi8>
    %scale = check.generate.fill value(-8356096) : tensor<1xi32>
    %expected_scale = check.generate.fill value(-8356096) : tensor<1xi32>
    %output = check.generate.fill value(-123) : tensor<256xi8>
    %f32_output = check.tensor.view %output offset(0) : tensor<256xi8> -> tensor<32xf32>
    %bf16_output = check.tensor.view %output offset(128) : tensor<256xi8> -> tensor<32xbf16>
    %f16_output = check.tensor.view %output offset(192) : tensor<256xi8> -> tensor<32xf16>
    %finite_f32 = check.tensor.view %f32_output offset(0) : tensor<32xf32> -> tensor<24xf32>
    %finite_bf16 = check.tensor.view %bf16_output offset(0) : tensor<32xbf16> -> tensor<24xbf16>
    %finite_f16 = check.tensor.view %f16_output offset(0) : tensor<32xf16> -> tensor<24xf16>
    check.compare<@e8m0_mxfp8_grouped, @e8m0_mxfp8_grouped_oracle>(%payload, %scale, %output) : (tensor<32xi8>, tensor<1xi32>, tensor<256xi8>) -> () {
      check.expect.bitwise actual(%payload) expected(%expected_payload) : tensor<32xi8>
      check.expect.bitwise actual(%scale) expected(%expected_scale) : tensor<1xi32>
      check.expect.close actual(%f32_output) expected(%f32_output) atol(0.0) rtol(0.0) nan(same) : tensor<32xf32>
      check.expect.close actual(%bf16_output) expected(%bf16_output) atol(0.0) rtol(0.0) nan(same) : tensor<32xbf16>
      check.expect.close actual(%f16_output) expected(%f16_output) atol(0.0) rtol(0.0) nan(same) : tensor<32xf16>
      check.expect.bitwise actual(%finite_f32) expected(%finite_f32) : tensor<24xf32>
      check.expect.bitwise actual(%finite_bf16) expected(%finite_bf16) : tensor<24xbf16>
      check.expect.bitwise actual(%finite_f16) expected(%finite_f16) : tensor<24xf16>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %payload_entropy = check.entropy.fork %entropy name("e8m0_mxfp8_grouped_payload") : check.entropy
    %scale_entropy = check.entropy.fork %entropy name("e8m0_mxfp8_grouped_scale") : check.entropy
    %payload_seed = check.entropy.read %payload_entropy[%trial] : check.entropy -> i64
    %scale_seed = check.entropy.read %scale_entropy[%trial] : check.entropy -> i64
    %payload = check.generate.random.uniform seed(%payload_seed) range(-128 to 127) : tensor<32xi8>
    %expected_payload = check.generate.random.uniform seed(%payload_seed) range(-128 to 127) : tensor<32xi8>
    %scale = check.generate.random.uniform seed(%scale_seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    %expected_scale = check.generate.random.uniform seed(%scale_seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    %output = check.generate.fill value(-123) : tensor<256xi8>
    %f32_output = check.tensor.view %output offset(0) : tensor<256xi8> -> tensor<32xf32>
    %bf16_output = check.tensor.view %output offset(128) : tensor<256xi8> -> tensor<32xbf16>
    %f16_output = check.tensor.view %output offset(192) : tensor<256xi8> -> tensor<32xf16>
    check.compare<@e8m0_mxfp8_grouped, @e8m0_mxfp8_grouped_oracle>(%payload, %scale, %output) : (tensor<32xi8>, tensor<1xi32>, tensor<256xi8>) -> () {
      check.expect.bitwise actual(%payload) expected(%expected_payload) : tensor<32xi8>
      check.expect.bitwise actual(%scale) expected(%expected_scale) : tensor<1xi32>
      check.expect.close actual(%f32_output) expected(%f32_output) atol(0.0) rtol(0.0) nan(same) : tensor<32xf32>
      check.expect.close actual(%bf16_output) expected(%bf16_output) atol(0.0) rtol(0.0) nan(same) : tensor<32xbf16>
      check.expect.close actual(%f16_output) expected(%f16_output) atol(0.0) rtol(0.0) nan(same) : tensor<32xf16>
    }
  }
  check.return
}

// Two ordinary MXFP8 groups distinguish adjacent packed scale bytes.
func.def inline @e8m0_mxfp8_wide_bf16_body(%input_buffer: buffer, %output_buffer: buffer) {
  %input, %output = buffer.assume.noalias %input_buffer, %output_buffer : buffer, buffer
  %base = index.constant 0 : offset
  %payload_offset = index.constant 4 : offset
  %origin = index.constant 0 : index
  %scale_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %payload_view = buffer.view %input[%payload_offset] : buffer -> view<64xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<64xbf16>
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=64, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %payload_bits = vector.load %payload_view[%origin] : view<64xi8> -> vector<64xi8>
  %payload = vector.bitcast %payload_bits : vector<64xi8> to vector<64xf8E4M3>
  %scale = vector.load %scale_view[%origin] : view<1xi32> -> vector<1xi32>
  %decoded = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<64xf8E4M3>, encoding<schema> -> vector<64xbf16>
  vector.store %decoded, %output_view[%origin] : vector<64xbf16>, view<64xbf16>
  func.return
}

kernel.def @e8m0_mxfp8_wide_bf16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  func.call @e8m0_mxfp8_wide_bf16_body(%input_buffer, %output_buffer) : (buffer, buffer)
  kernel.return
}

func.def @e8m0_mxfp8_wide_bf16_oracle(%input_buffer: buffer, %output_buffer: buffer) {
  func.call @e8m0_mxfp8_wide_bf16_body(%input_buffer, %output_buffer) : (buffer, buffer)
  func.return
}

