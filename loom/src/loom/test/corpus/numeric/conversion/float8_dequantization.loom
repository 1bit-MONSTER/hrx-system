    %input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<9xi32>
    %expected_input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<9xi32>
    %output = check.generate.fill value(-123.0) : tensor<64xbf16>
    check.compare<@e8m0_mxfp4_wide_bf16, @e8m0_mxfp4_wide_bf16_oracle>(%input, %output) : (tensor<9xi32>, tensor<64xbf16>) -> () {
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<9xi32>
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<64xbf16>
    }
  }
  check.return
}
