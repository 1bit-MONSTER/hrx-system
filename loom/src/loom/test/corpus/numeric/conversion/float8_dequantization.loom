// One packed MXFP4 group covers the native packet decode path.
kernel.def @e8m0_mxfp4_bf16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %input, %output = buffer.assume.noalias %input_buffer, %output_buffer : buffer, buffer
  %base = index.constant 0 : offset
  %payload_offset = index.constant 4 : offset
  %origin = index.constant 0 : index
  %scale_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %payload_view = buffer.view %input[%payload_offset] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<32xbf16>
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=32, payload_packing=little_endian_nibbles, payload_registers=4, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %payload_bits = vector.load %payload_view[%origin] : view<4xi32> -> vector<4xi32>
  %scale = vector.load %scale_view[%origin] : view<1xi32> -> vector<1xi32>
  %decoded = vector.decode %payload_bits using %schema {scale = %scale : vector<1xi32>} : vector<4xi32>, encoding<schema> -> vector<32xbf16>
  vector.store %decoded, %output_view[%origin] : vector<32xbf16>, view<32xbf16>
  kernel.return
}

// Two packed MXFP4 groups make adjacent scale-byte selection observable.
kernel.def @e8m0_mxfp4_wide_bf16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %input, %output = buffer.assume.noalias %input_buffer, %output_buffer : buffer, buffer
  %base = index.constant 0 : offset
  %payload_offset = index.constant 4 : offset
  %origin = index.constant 0 : index
  %scale_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %payload_view = buffer.view %input[%payload_offset] : buffer -> view<8xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<64xbf16>
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=64, payload_packing=little_endian_nibbles, payload_registers=8, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %payload_bits = vector.load %payload_view[%origin] : view<8xi32> -> vector<8xi32>
  %scale = vector.load %scale_view[%origin] : view<1xi32> -> vector<1xi32>
  %decoded = vector.decode %payload_bits using %schema {scale = %scale : vector<1xi32>} : vector<8xi32>, encoding<schema> -> vector<64xbf16>
  vector.store %decoded, %output_view[%origin] : vector<64xbf16>, view<64xbf16>
  kernel.return
}

// Decodes an E8M0 byte without using the encoded-vector path under test.
func.def inline @decode_e8m0_scale(%scale_byte: i32) -> (f32) {
  %c0 = scalar.constant 0 : i32
  %c23 = scalar.constant 23 : i32
  %c255 = scalar.constant 255 : i32
  %minimum_bits = scalar.constant 4194304 : i32
  %nan_bits = scalar.constant 2143289344 : i32
  %exponent_bits = scalar.shli %scale_byte, %c23 : i32
  %is_minimum = scalar.cmpi eq, %scale_byte, %c0 : i32
  %finite_bits = scf.select %is_minimum, %minimum_bits, %exponent_bits : i32
  %is_nan = scalar.cmpi eq, %scale_byte, %c255 : i32
  %bits = scf.select %is_nan, %nan_bits, %finite_bits : i32
  %scale = scalar.bitcast %bits : i32 to f32
  func.return %scale : f32
}

// Decodes a signed E2M1 nibble and rounds the scaled value to BF16.
func.def inline @decode_e8m0_scaled_e2m1(%nibble: i32, %scale: f32) -> (bf16) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c22 = scalar.constant 22 : i32
  %c23 = scalar.constant 23 : i32
  %c28 = scalar.constant 28 : i32
  %f32_exponent_bias = scalar.constant 126 : i32
  %half_bits = scalar.constant 1056964608 : i32
  %magnitude = scalar.andi %nibble, %c7 : i32
  %sign = scalar.andi %nibble, %c8 : i32
  %is_zero = scalar.cmpi eq, %magnitude, %c0 : i32
  %is_half = scalar.cmpi eq, %magnitude, %c1 : i32
  %magnitude_bits = scf.if %is_zero -> (i32) {
    scf.yield %c0 : i32
  } else {
    %nonzero_bits = scf.if %is_half -> (i32) {
      scf.yield %half_bits : i32
    } else {
      %exponent = scalar.shrui %magnitude, %c1 : i32
      %f32_exponent = scalar.addi %exponent, %f32_exponent_bias : i32
      %exponent_bits = scalar.shli %f32_exponent, %c23 : i32
      %mantissa = scalar.andi %magnitude, %c1 : i32
      %mantissa_bits = scalar.shli %mantissa, %c22 : i32
      %normal_bits = scalar.ori %exponent_bits, %mantissa_bits : i32
      scf.yield %normal_bits : i32
    }
    scf.yield %nonzero_bits : i32
  }
  %sign_bits = scalar.shli %sign, %c28 : i32
  %signed_bits = scalar.ori %magnitude_bits, %sign_bits : i32
  %unscaled = scalar.bitcast %signed_bits : i32 to f32
  %scaled = scalar.mulf %unscaled, %scale : f32
  %result = scalar.fptrunc %scaled : f32 to bf16
  func.return %result : bf16
}

func.def inline @decode_e8m0_mxfp4_bf16(%input_buffer: buffer, %output_buffer: buffer, %extent: index) {
  %base = index.constant 0 : offset
  %payload_offset = index.constant 4 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %scale_group_elements = index.constant 32 : index
  %payload_elements_per_word = index.constant 8 : index
  %scale_byte_bits = index.constant 8 : index
  %payload_element_bits = index.constant 4 : index
  %byte_mask = scalar.constant 255 : i32
  %nibble_mask = scalar.constant 15 : i32
  %scale_view = buffer.view %input_buffer[%base] : buffer -> view<1xi32>
  %payload_view = buffer.view %input_buffer[%payload_offset] : buffer -> view<8xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<64xbf16>
  %scale_word = view.load %scale_view[%origin] : view<1xi32> -> i32
  scf.for %position = [%origin to %extent step %step] {
    %scale_group = index.div %position, %scale_group_elements : index
    %scale_bit_position_index = index.mul %scale_group, %scale_byte_bits : index
    %scale_bit_position = index.cast %scale_bit_position_index : index to i32
    %shifted_scale = scalar.shrui %scale_word, %scale_bit_position : i32
    %scale_byte = scalar.andi %shifted_scale, %byte_mask : i32
    %scale = func.call @decode_e8m0_scale(%scale_byte) : (i32) -> (f32)
    %payload_word_position = index.div %position, %payload_elements_per_word : index
    %nibble_position = index.rem %position, %payload_elements_per_word : index
    %payload_bit_position_index = index.mul %nibble_position, %payload_element_bits : index
    %payload_bit_position = index.cast %payload_bit_position_index : index to i32
    %payload_word = view.load %payload_view[%payload_word_position] : view<8xi32> -> i32
    %shifted_payload = scalar.shrui %payload_word, %payload_bit_position : i32
    %nibble = scalar.andi %shifted_payload, %nibble_mask : i32
    %value = func.call @decode_e8m0_scaled_e2m1(%nibble, %scale) : (i32, f32) -> (bf16)
    view.store %value, %output_view[%position] : bf16, view<64xbf16>
  }
  func.return
}

func.def @e8m0_mxfp4_bf16_oracle(%input_buffer: buffer, %output_buffer: buffer) {
  %extent = index.constant 32 : index
  func.call @decode_e8m0_mxfp4_bf16(%input_buffer, %output_buffer, %extent) : (buffer, buffer, index)
  func.return
}

func.def @e8m0_mxfp4_wide_bf16_oracle(%input_buffer: buffer, %output_buffer: buffer) {
  %extent = index.constant 64 : index
  func.call @decode_e8m0_mxfp4_bf16(%input_buffer, %output_buffer, %extent) : (buffer, buffer, index)
  func.return
}

check.scenario @e8m0_mxfp4_bf16_subnormal_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    // The first word supplies the scale byte. Four following payload words
    // span all 16 E2M1 codes for every directed E8M0 boundary.
    %minimum_input = check.generate.iota offset(0) step(241389886) period(256) : tensor<9xi32>
    %expected_minimum_input = check.generate.iota offset(0) step(241389886) period(256) : tensor<9xi32>
    %minimum_output = check.generate.fill value(-123.0) : tensor<64xbf16>
    check.compare<@e8m0_mxfp4_bf16, @e8m0_mxfp4_bf16_oracle>(%minimum_input, %minimum_output) : (tensor<9xi32>, tensor<64xbf16>) -> () {
      check.expect.bitwise actual(%minimum_input) expected(%expected_minimum_input) : tensor<9xi32>
      check.expect.bitwise actual(%minimum_output) expected(%minimum_output) : tensor<64xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %next_input = check.generate.iota offset(1) step(241389886) period(256) : tensor<9xi32>
    %next_output = check.generate.fill value(-123.0) : tensor<64xbf16>
    check.compare<@e8m0_mxfp4_bf16, @e8m0_mxfp4_bf16_oracle>(%next_input, %next_output) : (tensor<9xi32>, tensor<64xbf16>) -> () {
      check.expect.bitwise actual(%next_output) expected(%next_output) : tensor<64xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %normal_low_input = check.generate.iota offset(2) step(241389886) period(256) : tensor<9xi32>
    %normal_low_output = check.generate.fill value(-123.0) : tensor<64xbf16>
    check.compare<@e8m0_mxfp4_bf16, @e8m0_mxfp4_bf16_oracle>(%normal_low_input, %normal_low_output) : (tensor<9xi32>, tensor<64xbf16>) -> () {
      check.expect.bitwise actual(%normal_low_output) expected(%normal_low_output) : tensor<64xbf16>
    }
  }
  check.return
}

