// Packed conversions exercise signedness, rounding ties and partial storage.
// Inputs cross a kernel boundary; exact expected values are independent of
// the compiler and guards detect stores beyond the converted vector.

kernel.def @sitofp_i8_bf16_4() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<4xi8>
  %target = buffer.view %output[%base] : buffer -> view<4xbf16>
  %value = vector.load %source[0] : view<4xi8> -> vector<4xi8>
  %converted = vector.sitofp %value : vector<4xi8> to vector<4xbf16>
  vector.store %converted, %target[0] : vector<4xbf16>, view<4xbf16>
  kernel.return
}

check.case public @sitofp_i8_bf16_4_values {
  %input = check.generate.iota offset(-128) step(85) : tensor<4xi8>
  %storage = check.generate.fill value(-7.0) : tensor<8xbf16>
  %output = check.tensor.view %storage offset(4) : tensor<8xbf16> -> tensor<4xbf16>
  kernel.launch @sitofp_i8_bf16_4(%input, %output) : (tensor<4xi8>, tensor<4xbf16>)
  %lane0 = check.tensor.view %output offset(0) : tensor<4xbf16> -> tensor<1xbf16>
  %expected0 = check.generate.fill value(-128.0) : tensor<1xbf16>
  check.expect.bitwise actual(%lane0) expected(%expected0) : tensor<1xbf16>
  %lane1 = check.tensor.view %output offset(2) : tensor<4xbf16> -> tensor<1xbf16>
  %expected1 = check.generate.fill value(-43.0) : tensor<1xbf16>
  check.expect.bitwise actual(%lane1) expected(%expected1) : tensor<1xbf16>
  %lane2 = check.tensor.view %output offset(4) : tensor<4xbf16> -> tensor<1xbf16>
  %expected2 = check.generate.fill value(42.0) : tensor<1xbf16>
  check.expect.bitwise actual(%lane2) expected(%expected2) : tensor<1xbf16>
  %lane3 = check.tensor.view %output offset(6) : tensor<4xbf16> -> tensor<1xbf16>
  %expected3 = check.generate.fill value(127.0) : tensor<1xbf16>
  check.expect.bitwise actual(%lane3) expected(%expected3) : tensor<1xbf16>
  %prefix = check.tensor.view %storage offset(0) : tensor<8xbf16> -> tensor<2xbf16>
  %suffix = check.tensor.view %storage offset(12) : tensor<8xbf16> -> tensor<2xbf16>
  %guard = check.generate.fill value(-7.0) : tensor<2xbf16>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<2xbf16>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<2xbf16>
  check.return
}

