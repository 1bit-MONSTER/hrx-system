// The integer-to-bfloat path has the same double-rounding hazard at large
// integer midpoints. Both signed and unsigned selectors preserve the low bit.
func.def public @integer_bf16_bits(%word: i32, %wide: i64) -> (i32, i32, i32, i32) {
  %signed_word = scalar.sitofp %word : i32 to bf16
  %unsigned_word = scalar.uitofp %word : i32 to bf16
  %signed_wide = scalar.sitofp %wide : i64 to bf16
  %unsigned_wide = scalar.uitofp %wide : i64 to bf16
  %raw0 = scalar.bitcast %signed_word : bf16 to i16
  %raw1 = scalar.bitcast %unsigned_word : bf16 to i16
  %raw2 = scalar.bitcast %signed_wide : bf16 to i16
  %raw3 = scalar.bitcast %unsigned_wide : bf16 to i16
  %result0 = scalar.extui %raw0 : i16 to i32
  %result1 = scalar.extui %raw1 : i16 to i32
  %result2 = scalar.extui %raw2 : i16 to i32
  %result3 = scalar.extui %raw3 : i16 to i32
  func.return %result0, %result1, %result2, %result3 : i32, i32, i32, i32
}

check.case @integer_bf16_above_midpoints {
  %word = check.literal value(1077936129) : i32
  %wide = check.literal value(1103806595073) : i64
  %signed_word, %unsigned_word, %signed_wide, %unsigned_wide = func.call @integer_bf16_bits(%word, %wide) : (i32, i64) -> (i32, i32, i32, i32)
  %expected_word = check.literal value(20097) : i32
  %expected_wide = check.literal value(21377) : i32
  check.expect.equal actual(%signed_word) expected(%expected_word) : i32
  check.expect.equal actual(%unsigned_word) expected(%expected_word) : i32
  check.expect.equal actual(%signed_wide) expected(%expected_wide) : i32
  check.expect.equal actual(%unsigned_wide) expected(%expected_wide) : i32
  check.return
}

func.def public @narrow_abi(%condition: i1, %a: f8E4M3, %b: f8E5M2, %c: f16, %d: bf16, %other_a: f8E4M3, %other_b: f8E5M2, %other_c: f16, %other_d: bf16) -> (f8E4M3, f8E5M2, f16, bf16, f32, f32, f32, f32) {
  %selected_a = scf.select %condition, %a, %other_a : f8E4M3
  %selected_b = scf.select %condition, %b, %other_b : f8E5M2
  %selected_c = scf.select %condition, %c, %other_c : f16
  %selected_d = scf.select %condition, %d, %other_d : bf16
  %wide_a = scalar.extf %selected_a : f8E4M3 to f32
  %wide_b = scalar.extf %selected_b : f8E5M2 to f32
  %wide_c = scalar.extf %selected_c : f16 to f32
  %wide_d = scalar.extf %selected_d : bf16 to f32
  func.return %selected_a, %selected_b, %selected_c, %selected_d, %wide_a, %wide_b, %wide_c, %wide_d : f8E4M3, f8E5M2, f16, bf16, f32, f32, f32, f32
}

check.case @narrow_abi_true {
  %condition = check.literal value(true) : i1
  %a = check.literal value(3.5) : f8E4M3
  %other_a = check.literal value(-2.5) : f8E4M3
  %b = check.literal value(3.5) : f8E5M2
  %other_b = check.literal value(-2.5) : f8E5M2
  %c = check.literal value(3.5) : f16
  %other_c = check.literal value(-2.5) : f16
  %d = check.literal value(3.5) : bf16
  %other_d = check.literal value(-2.5) : bf16
  %a_result, %b_result, %c_result, %d_result, %wide_a, %wide_b, %wide_c, %wide_d = func.call @narrow_abi(%condition, %a, %b, %c, %d, %other_a, %other_b, %other_c, %other_d) : (i1, f8E4M3, f8E5M2, f16, bf16, f8E4M3, f8E5M2, f16, bf16) -> (f8E4M3, f8E5M2, f16, bf16, f32, f32, f32, f32)
  check.expect.equal actual(%a_result) expected(%a) : f8E4M3
  check.expect.equal actual(%b_result) expected(%b) : f8E5M2
  check.expect.equal actual(%c_result) expected(%c) : f16
  check.expect.equal actual(%d_result) expected(%d) : bf16
  %expected = check.literal value(3.5) : f32
  check.expect.equal actual(%wide_a) expected(%expected) : f32
  check.expect.equal actual(%wide_b) expected(%expected) : f32
  check.expect.equal actual(%wide_c) expected(%expected) : f32
  check.expect.equal actual(%wide_d) expected(%expected) : f32
  check.return
}

check.case @narrow_abi_false {
  %condition = check.literal value(false) : i1
  %a = check.literal value(3.5) : f8E4M3
  %other_a = check.literal value(-2.5) : f8E4M3
  %b = check.literal value(3.5) : f8E5M2
  %other_b = check.literal value(-2.5) : f8E5M2
  %c = check.literal value(3.5) : f16
  %other_c = check.literal value(-2.5) : f16
  %d = check.literal value(3.5) : bf16
  %other_d = check.literal value(-2.5) : bf16
  %a_result, %b_result, %c_result, %d_result, %wide_a, %wide_b, %wide_c, %wide_d = func.call @narrow_abi(%condition, %a, %b, %c, %d, %other_a, %other_b, %other_c, %other_d) : (i1, f8E4M3, f8E5M2, f16, bf16, f8E4M3, f8E5M2, f16, bf16) -> (f8E4M3, f8E5M2, f16, bf16, f32, f32, f32, f32)
  check.expect.equal actual(%a_result) expected(%other_a) : f8E4M3
  check.expect.equal actual(%b_result) expected(%other_b) : f8E5M2
  check.expect.equal actual(%c_result) expected(%other_c) : f16
  check.expect.equal actual(%d_result) expected(%other_d) : bf16
  %expected = check.literal value(-2.5) : f32
  check.expect.equal actual(%wide_a) expected(%expected) : f32
  check.expect.equal actual(%wide_b) expected(%expected) : f32
  check.expect.equal actual(%wide_c) expected(%expected) : f32
  check.expect.equal actual(%wide_d) expected(%expected) : f32
  check.return
}

func.def public @narrow_constants() -> (i8, i16, f16, bf16) {
  %byte = scalar.constant -127 : i8
  %word = scalar.constant -32767 : i16
  %half = scalar.constant -1.5 : f16
  %brain = scalar.constant 1.25 : bf16
  func.return %byte, %word, %half, %brain : i8, i16, f16, bf16
}

check.case @narrow_constants_case {
  %byte, %word, %half, %brain = func.call @narrow_constants() : () -> (i8, i16, f16, bf16)
  %expected_byte = check.literal value(-127) : i8
  %expected_word = check.literal value(-32767) : i16
  %expected_half = check.literal value(-1.5) : f16
  %expected_brain = check.literal value(1.25) : bf16
  check.expect.equal actual(%byte) expected(%expected_byte) : i8
  check.expect.equal actual(%word) expected(%expected_word) : i16
  check.expect.equal actual(%half) expected(%expected_half) : f16
  check.expect.equal actual(%brain) expected(%expected_brain) : bf16
  check.return
}
