// Every narrow payload is supplied through memory after compilation. This
// keeps widening dynamic while exercising the exact F32 destination used by
// ordinary ML kernels.
func.def @widen_float8_to_f32(%byte_bits: buffer, %e4_output: buffer, %e5_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %byte_end = index.constant 256 : index
  %step = index.constant 1 : index
  %e4_input = buffer.view %byte_bits[%base] : buffer -> view<256xf8E4M3>
  %e5_input = buffer.view %byte_bits[%base] : buffer -> view<256xf8E5M2>
  %e4_results = buffer.view %e4_output[%base] : buffer -> view<256xf32>
  %e5_results = buffer.view %e5_output[%base] : buffer -> view<256xf32>
  scf.for %i = [%begin to %byte_end step %step] {
    %e4 = view.load %e4_input[%i] : view<256xf8E4M3> -> f8E4M3
    %e5 = view.load %e5_input[%i] : view<256xf8E5M2> -> f8E5M2
    %wide_e4 = scalar.extf %e4 : f8E4M3 to f32
    %wide_e5 = scalar.extf %e5 : f8E5M2 to f32
    view.store %wide_e4, %e4_results[%i] : f32, view<256xf32>
    view.store %wide_e5, %e5_results[%i] : f32, view<256xf32>
  }
  func.return
}

func.def @widen_bfloat_to_f32(%word_bits: buffer, %bf16_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %word_end = index.constant 65536 : index
  %step = index.constant 1 : index
  %bf16_input = buffer.view %word_bits[%base] : buffer -> view<65536xbf16>
  %bf16_results = buffer.view %bf16_output[%base] : buffer -> view<65536xf32>
  scf.for %i = [%begin to %word_end step %step] {
    %value = view.load %bf16_input[%i] : view<65536xbf16> -> bf16
    %wide = scalar.extf %value : bf16 to f32
    view.store %wide, %bf16_results[%i] : f32, view<65536xf32>
  }
  func.return
}

check.scenario @float8_to_f32_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %byte_bits = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %expected_byte_bits = check.generate.iota offset(-128) step(1) : tensor<256xi8>

    %e4_storage = check.generate.fill value(-123.5) : tensor<258xf32>
    %e5_storage = check.generate.fill value(-123.5) : tensor<258xf32>
    %e4_output = check.tensor.view %e4_storage offset(4) : tensor<258xf32> -> tensor<256xf32>
    %e5_output = check.tensor.view %e5_storage offset(4) : tensor<258xf32> -> tensor<256xf32>

    %e4_negative_zero = check.tensor.view %e4_output offset(0) : tensor<256xf32> -> tensor<1xf32>
    %e4_positive_zero = check.tensor.view %e4_output offset(512) : tensor<256xf32> -> tensor<1xf32>
    %e5_negative_zero = check.tensor.view %e5_output offset(0) : tensor<256xf32> -> tensor<1xf32>
    %e5_positive_zero = check.tensor.view %e5_output offset(512) : tensor<256xf32> -> tensor<1xf32>

    %guard = check.generate.fill value(-123.5) : tensor<1xf32>
    %e4_prefix = check.tensor.view %e4_storage offset(0) : tensor<258xf32> -> tensor<1xf32>
    %e4_suffix = check.tensor.view %e4_storage offset(1028) : tensor<258xf32> -> tensor<1xf32>
    %e5_prefix = check.tensor.view %e5_storage offset(0) : tensor<258xf32> -> tensor<1xf32>
    %e5_suffix = check.tensor.view %e5_storage offset(1028) : tensor<258xf32> -> tensor<1xf32>

    check.compare<@widen_float8_to_f32>(%byte_bits, %e4_output, %e5_output) : (tensor<256xi8>, tensor<256xf32>, tensor<256xf32>) -> () {
      check.expect.close actual(%e4_output) expected(%e4_output) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
      check.expect.close actual(%e5_output) expected(%e5_output) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
      check.expect.bitwise actual(%e4_negative_zero) expected(%e4_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e4_positive_zero) expected(%e4_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e5_negative_zero) expected(%e5_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e5_positive_zero) expected(%e5_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%byte_bits) expected(%expected_byte_bits) : tensor<256xi8>
      check.expect.bitwise actual(%e4_prefix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%e4_suffix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%e5_prefix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%e5_suffix) expected(%guard) : tensor<1xf32>
    }
  }
  check.return
}

check.scenario @bfloat_to_f32_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %word_bits = check.generate.iota offset(-32768) step(1) : tensor<65536xi16>
    %expected_word_bits = check.generate.iota offset(-32768) step(1) : tensor<65536xi16>
    %bf16_storage = check.generate.fill value(-123.5) : tensor<65538xf32>
    %bf16_output = check.tensor.view %bf16_storage offset(4) : tensor<65538xf32> -> tensor<65536xf32>
    %bf16_negative_zero = check.tensor.view %bf16_output offset(0) : tensor<65536xf32> -> tensor<1xf32>
    %bf16_positive_zero = check.tensor.view %bf16_output offset(131072) : tensor<65536xf32> -> tensor<1xf32>
    %guard = check.generate.fill value(-123.5) : tensor<1xf32>
    %bf16_prefix = check.tensor.view %bf16_storage offset(0) : tensor<65538xf32> -> tensor<1xf32>
    %bf16_suffix = check.tensor.view %bf16_storage offset(262148) : tensor<65538xf32> -> tensor<1xf32>
    check.compare<@widen_bfloat_to_f32>(%word_bits, %bf16_output) : (tensor<65536xi16>, tensor<65536xf32>) -> () {
      check.expect.close actual(%bf16_output) expected(%bf16_output) atol(0.0) rtol(0.0) nan(same) : tensor<65536xf32>
      check.expect.bitwise actual(%bf16_negative_zero) expected(%bf16_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%bf16_positive_zero) expected(%bf16_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%word_bits) expected(%expected_word_bits) : tensor<65536xi16>
      check.expect.bitwise actual(%bf16_prefix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%bf16_suffix) expected(%guard) : tensor<1xf32>
    }
  }
  check.return
}
