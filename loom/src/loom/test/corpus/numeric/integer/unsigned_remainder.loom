// Records constant unsigned remainders for a uniform value and a loaded value.
// The divisor set covers ordinary factors and the unsigned i32 boundaries whose
// lowering differs from signed arithmetic.
func.def inline @constant_unsigned_remainder_row(%value: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
  %c3 = scalar.constant 3 : i32
  %c5 = scalar.constant 5 : i32
  %c7 = scalar.constant 7 : i32
  %c9 = scalar.constant 9 : i32
  %c10 = scalar.constant 10 : i32
  %c20 = scalar.constant 20 : i32
  %high_power = scalar.constant -2147483648 : i32
  %high_bit = scalar.constant -2147483647 : i32
  %largest = scalar.constant -1 : i32
  %below_high_bit = scalar.constant 2147483647 : i32
  %results = buffer.view %output[%base] : buffer -> view<17x64xi32>

  %remainder_3 = scalar.remui %value, %c3 : i32
  %remainder_5 = scalar.remui %value, %c5 : i32
  %remainder_7 = scalar.remui %value, %c7 : i32
  %remainder_9 = scalar.remui %value, %c9 : i32
  %remainder_10 = scalar.remui %value, %c10 : i32
  %remainder_20 = scalar.remui %value, %c20 : i32
  %remainder_high_power = scalar.remui %value, %high_power : i32
  %remainder_high_bit = scalar.remui %value, %high_bit : i32
  %remainder_largest = scalar.remui %value, %largest : i32
  %remainder_below_high_bit = scalar.remui %value, %below_high_bit : i32
  view.store %remainder_3, %results[0, %column] : i32, view<17x64xi32>
  view.store %remainder_5, %results[1, %column] : i32, view<17x64xi32>
  view.store %remainder_7, %results[2, %column] : i32, view<17x64xi32>
  view.store %remainder_9, %results[3, %column] : i32, view<17x64xi32>
  view.store %remainder_10, %results[4, %column] : i32, view<17x64xi32>
  view.store %remainder_20, %results[5, %column] : i32, view<17x64xi32>
  view.store %remainder_high_power, %results[6, %column] : i32, view<17x64xi32>
  view.store %remainder_high_bit, %results[7, %column] : i32, view<17x64xi32>
  view.store %remainder_largest, %results[8, %column] : i32, view<17x64xi32>
  view.store %remainder_below_high_bit, %results[9, %column] : i32, view<17x64xi32>

  %value_bits = scalar.extui %value : i32 to i64
  %index_mask = scalar.constant 2147483647 : i64
  %nonnegative_bits = scalar.andi %value_bits, %index_mask : i64
  %position = index.cast %nonnegative_bits : i64 to index
  %index_3 = index.constant 3 : index
  %index_5 = index.constant 5 : index
  %index_7 = index.constant 7 : index
  %index_9 = index.constant 9 : index
  %index_20 = index.constant 20 : index
  %index_high_power = index.constant 2147483648 : index
  %index_largest = index.constant 4294967295 : index
  %index_remainder_3 = index.rem %position, %index_3 : index
  %index_remainder_5 = index.rem %position, %index_5 : index
  %index_remainder_7 = index.rem %position, %index_7 : index
  %index_remainder_9 = index.rem %position, %index_9 : index
  %index_remainder_20 = index.rem %position, %index_20 : index
  %index_remainder_high_power = index.rem %position, %index_high_power : index
  %index_remainder_largest = index.rem %position, %index_largest : index
  %word_remainder_3 = index.cast %index_remainder_3 : index to i32
  %word_remainder_5 = index.cast %index_remainder_5 : index to i32
  %word_remainder_7 = index.cast %index_remainder_7 : index to i32
  %word_remainder_9 = index.cast %index_remainder_9 : index to i32
  %word_remainder_20 = index.cast %index_remainder_20 : index to i32
  %word_remainder_high_power = index.cast %index_remainder_high_power : index to i32
  %word_remainder_largest = index.cast %index_remainder_largest : index to i32
  view.store %word_remainder_3, %results[10, %column] : i32, view<17x64xi32>
  view.store %word_remainder_5, %results[11, %column] : i32, view<17x64xi32>
  view.store %word_remainder_7, %results[12, %column] : i32, view<17x64xi32>
  view.store %word_remainder_9, %results[13, %column] : i32, view<17x64xi32>
  view.store %word_remainder_20, %results[14, %column] : i32, view<17x64xi32>
  view.store %word_remainder_high_power, %results[15, %column] : i32, view<17x64xi32>
  view.store %word_remainder_largest, %results[16, %column] : i32, view<17x64xi32>
  func.return
}

// A scalar loop gives every target the same loaded values without baking
// those values into the subject compilation request.
func.def @constant_unsigned_remainder_observations(%uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %values = buffer.view %input[%base] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<32xi32> -> i32
    %varying_column = index.add %lane, %end : index
    func.call @constant_unsigned_remainder_row(%uniform, %output, %lane) : (i32, buffer, index)
    func.call @constant_unsigned_remainder_row(%value, %output, %varying_column) : (i32, buffer, index)
  }
  func.return
}

check.scenario @constant_unsigned_remainder_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %uniform_entropy = check.entropy.fork %entropy name("uniform") : check.entropy
    %input_entropy = check.entropy.fork %entropy name("input") : check.entropy
    %uniform_bits = check.entropy.read %uniform_entropy[%trial] : check.entropy -> i64
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %unchanged_input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %storage = check.generate.fill value(-123) : tensor<1104xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<1104xi32> -> tensor<8xi32>
    %output = check.tensor.view %storage offset(32) : tensor<1104xi32> -> tensor<1088xi32>
    %suffix = check.tensor.view %storage offset(4384) : tensor<1104xi32> -> tensor<8xi32>
    %guard = check.generate.fill value(-123) : tensor<8xi32>
    check.compare<@constant_unsigned_remainder_observations>(%uniform_bits, %input, %output) : (i64, tensor<32xi32>, tensor<1088xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%unchanged_input) : tensor<32xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<1088xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<8xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<8xi32>
    }
  }
  check.return
}
