// Constant remainder preserves the complete unsigned i32 domain in both
// scalar registers and loaded per-lane values.
kernel.def @unsigned_constant_remainder() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%uniform: i32, %input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : offset
  %base = index.constant 64 : offset
  %inputs = buffer.view %input[%c0] : buffer -> view<32xi32>
  %outputs = buffer.view %output[%base] : buffer -> view<12x32xi32>
  %value = view.load %inputs[%lane] : view<32xi32> -> i32
  %divisor_0 = scalar.constant 3 : i32
  %remainder_0 = scalar.remui %value, %divisor_0 : i32
  view.store %remainder_0, %outputs[0, %lane] : i32, view<12x32xi32>
  %remainder_6 = scalar.remui %uniform, %divisor_0 : i32
  view.store %remainder_6, %outputs[6, %lane] : i32, view<12x32xi32>
  %divisor_1 = scalar.constant 7 : i32
  %remainder_1 = scalar.remui %value, %divisor_1 : i32
  view.store %remainder_1, %outputs[1, %lane] : i32, view<12x32xi32>
  %remainder_7 = scalar.remui %uniform, %divisor_1 : i32
  view.store %remainder_7, %outputs[7, %lane] : i32, view<12x32xi32>
  %divisor_2 = scalar.constant 10 : i32
  %remainder_2 = scalar.remui %value, %divisor_2 : i32
  view.store %remainder_2, %outputs[2, %lane] : i32, view<12x32xi32>
  %remainder_8 = scalar.remui %uniform, %divisor_2 : i32
  view.store %remainder_8, %outputs[8, %lane] : i32, view<12x32xi32>
  %divisor_3 = scalar.constant -2147483648 : i32
  %remainder_3 = scalar.remui %value, %divisor_3 : i32
  view.store %remainder_3, %outputs[3, %lane] : i32, view<12x32xi32>
  %remainder_9 = scalar.remui %uniform, %divisor_3 : i32
  view.store %remainder_9, %outputs[9, %lane] : i32, view<12x32xi32>
  %divisor_4 = scalar.constant -2147483647 : i32
  %remainder_4 = scalar.remui %value, %divisor_4 : i32
  view.store %remainder_4, %outputs[4, %lane] : i32, view<12x32xi32>
  %remainder_10 = scalar.remui %uniform, %divisor_4 : i32
  view.store %remainder_10, %outputs[10, %lane] : i32, view<12x32xi32>
  %divisor_5 = scalar.constant -1 : i32
  %remainder_5 = scalar.remui %value, %divisor_5 : i32
  view.store %remainder_5, %outputs[5, %lane] : i32, view<12x32xi32>
  %remainder_11 = scalar.remui %uniform, %divisor_5 : i32
  view.store %remainder_11, %outputs[11, %lane] : i32, view<12x32xi32>
  kernel.return
}

check.case public @unsigned_remainder_small {
  %uniform = check.literal value(-1) : i32
  %input = check.generate.iota offset(0) step(1) : tensor<32xi32>
  %output = check.generate.fill value(-7777) : tensor<416xi32>
  kernel.launch @unsigned_constant_remainder(%uniform, %input, %output) : (i32, tensor<32xi32>, tensor<416xi32>)
  %expected_0_prefix = check.generate.iota offset(0) step(1) : tensor<3xi32>
  %actual_0_prefix = check.tensor.view %output offset(64) : tensor<416xi32> -> tensor<3xi32>
  check.expect.equal actual(%actual_0_prefix) expected(%expected_0_prefix) : tensor<3xi32>
  %expected_0_tail = check.generate.iota offset(0) step(1) period(3) : tensor<29xi32>
  %actual_0_tail = check.tensor.view %output offset(76) : tensor<416xi32> -> tensor<29xi32>
  check.expect.equal actual(%actual_0_tail) expected(%expected_0_tail) : tensor<29xi32>
  %expected_0_uniform = check.generate.fill value(0) : tensor<32xi32>
  %actual_0_uniform = check.tensor.view %output offset(832) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_0_uniform) expected(%expected_0_uniform) : tensor<32xi32>
  %expected_1_prefix = check.generate.iota offset(0) step(1) : tensor<7xi32>
  %actual_1_prefix = check.tensor.view %output offset(192) : tensor<416xi32> -> tensor<7xi32>
  check.expect.equal actual(%actual_1_prefix) expected(%expected_1_prefix) : tensor<7xi32>
  %expected_1_tail = check.generate.iota offset(0) step(1) period(7) : tensor<25xi32>
  %actual_1_tail = check.tensor.view %output offset(220) : tensor<416xi32> -> tensor<25xi32>
  check.expect.equal actual(%actual_1_tail) expected(%expected_1_tail) : tensor<25xi32>
  %expected_1_uniform = check.generate.fill value(3) : tensor<32xi32>
  %actual_1_uniform = check.tensor.view %output offset(960) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_1_uniform) expected(%expected_1_uniform) : tensor<32xi32>
  %expected_2_prefix = check.generate.iota offset(0) step(1) : tensor<10xi32>
  %actual_2_prefix = check.tensor.view %output offset(320) : tensor<416xi32> -> tensor<10xi32>
  check.expect.equal actual(%actual_2_prefix) expected(%expected_2_prefix) : tensor<10xi32>
  %expected_2_tail = check.generate.iota offset(0) step(1) period(10) : tensor<22xi32>
  %actual_2_tail = check.tensor.view %output offset(360) : tensor<416xi32> -> tensor<22xi32>
  check.expect.equal actual(%actual_2_tail) expected(%expected_2_tail) : tensor<22xi32>
  %expected_2_uniform = check.generate.fill value(5) : tensor<32xi32>
  %actual_2_uniform = check.tensor.view %output offset(1088) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_2_uniform) expected(%expected_2_uniform) : tensor<32xi32>
  %expected_3_prefix = check.generate.iota offset(0) step(1) : tensor<32xi32>
  %actual_3_prefix = check.tensor.view %output offset(448) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_3_prefix) expected(%expected_3_prefix) : tensor<32xi32>
  %expected_3_uniform = check.generate.fill value(2147483647) : tensor<32xi32>
  %actual_3_uniform = check.tensor.view %output offset(1216) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_3_uniform) expected(%expected_3_uniform) : tensor<32xi32>
  %expected_4_prefix = check.generate.iota offset(0) step(1) : tensor<32xi32>
  %actual_4_prefix = check.tensor.view %output offset(576) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_4_prefix) expected(%expected_4_prefix) : tensor<32xi32>
  %expected_4_uniform = check.generate.fill value(2147483646) : tensor<32xi32>
  %actual_4_uniform = check.tensor.view %output offset(1344) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_4_uniform) expected(%expected_4_uniform) : tensor<32xi32>
  %expected_5_prefix = check.generate.iota offset(0) step(1) : tensor<32xi32>
  %actual_5_prefix = check.tensor.view %output offset(704) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_5_prefix) expected(%expected_5_prefix) : tensor<32xi32>
  %expected_5_uniform = check.generate.fill value(0) : tensor<32xi32>
  %actual_5_uniform = check.tensor.view %output offset(1472) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_5_uniform) expected(%expected_5_uniform) : tensor<32xi32>
  %input_expected = check.generate.iota offset(0) step(1) : tensor<32xi32>
  check.expect.equal actual(%input) expected(%input_expected) : tensor<32xi32>
  %guard = check.generate.fill value(-7777) : tensor<16xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<416xi32> -> tensor<16xi32>
  %suffix = check.tensor.view %output offset(1600) : tensor<416xi32> -> tensor<16xi32>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<16xi32>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<16xi32>
  check.return
}

check.case public @unsigned_remainder_maximum {
  %uniform = check.literal value(-2147483648) : i32
  %input = check.generate.iota offset(-32) step(1) : tensor<32xi32>
  %output = check.generate.fill value(-7777) : tensor<416xi32>
  kernel.launch @unsigned_constant_remainder(%uniform, %input, %output) : (i32, tensor<32xi32>, tensor<416xi32>)
  %expected_0_prefix = check.generate.iota offset(2) step(1) : tensor<1xi32>
  %actual_0_prefix = check.tensor.view %output offset(64) : tensor<416xi32> -> tensor<1xi32>
  check.expect.equal actual(%actual_0_prefix) expected(%expected_0_prefix) : tensor<1xi32>
  %expected_0_tail = check.generate.iota offset(0) step(1) period(3) : tensor<31xi32>
  %actual_0_tail = check.tensor.view %output offset(68) : tensor<416xi32> -> tensor<31xi32>
  check.expect.equal actual(%actual_0_tail) expected(%expected_0_tail) : tensor<31xi32>
  %expected_0_uniform = check.generate.fill value(2) : tensor<32xi32>
  %actual_0_uniform = check.tensor.view %output offset(832) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_0_uniform) expected(%expected_0_uniform) : tensor<32xi32>
  %expected_1_prefix = check.generate.iota offset(0) step(1) : tensor<7xi32>
  %actual_1_prefix = check.tensor.view %output offset(192) : tensor<416xi32> -> tensor<7xi32>
  check.expect.equal actual(%actual_1_prefix) expected(%expected_1_prefix) : tensor<7xi32>
  %expected_1_tail = check.generate.iota offset(0) step(1) period(7) : tensor<25xi32>
  %actual_1_tail = check.tensor.view %output offset(220) : tensor<416xi32> -> tensor<25xi32>
  check.expect.equal actual(%actual_1_tail) expected(%expected_1_tail) : tensor<25xi32>
  %expected_1_uniform = check.generate.fill value(2) : tensor<32xi32>
  %actual_1_uniform = check.tensor.view %output offset(960) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_1_uniform) expected(%expected_1_uniform) : tensor<32xi32>
  %expected_2_prefix = check.generate.iota offset(4) step(1) : tensor<6xi32>
  %actual_2_prefix = check.tensor.view %output offset(320) : tensor<416xi32> -> tensor<6xi32>
  check.expect.equal actual(%actual_2_prefix) expected(%expected_2_prefix) : tensor<6xi32>
  %expected_2_tail = check.generate.iota offset(0) step(1) period(10) : tensor<26xi32>
  %actual_2_tail = check.tensor.view %output offset(344) : tensor<416xi32> -> tensor<26xi32>
  check.expect.equal actual(%actual_2_tail) expected(%expected_2_tail) : tensor<26xi32>
  %expected_2_uniform = check.generate.fill value(8) : tensor<32xi32>
  %actual_2_uniform = check.tensor.view %output offset(1088) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_2_uniform) expected(%expected_2_uniform) : tensor<32xi32>
  %expected_3_prefix = check.generate.iota offset(2147483616) step(1) : tensor<32xi32>
  %actual_3_prefix = check.tensor.view %output offset(448) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_3_prefix) expected(%expected_3_prefix) : tensor<32xi32>
  %expected_3_uniform = check.generate.fill value(0) : tensor<32xi32>
  %actual_3_uniform = check.tensor.view %output offset(1216) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_3_uniform) expected(%expected_3_uniform) : tensor<32xi32>
  %expected_4_prefix = check.generate.iota offset(2147483615) step(1) : tensor<32xi32>
  %actual_4_prefix = check.tensor.view %output offset(576) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_4_prefix) expected(%expected_4_prefix) : tensor<32xi32>
  %expected_4_uniform = check.generate.fill value(-2147483648) : tensor<32xi32>
  %actual_4_uniform = check.tensor.view %output offset(1344) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_4_uniform) expected(%expected_4_uniform) : tensor<32xi32>
  %expected_5_prefix = check.generate.iota offset(-32) step(1) : tensor<31xi32>
  %actual_5_prefix = check.tensor.view %output offset(704) : tensor<416xi32> -> tensor<31xi32>
  check.expect.equal actual(%actual_5_prefix) expected(%expected_5_prefix) : tensor<31xi32>
  %expected_5_tail = check.generate.iota offset(0) step(1) period(4294967295) : tensor<1xi32>
  %actual_5_tail = check.tensor.view %output offset(828) : tensor<416xi32> -> tensor<1xi32>
  check.expect.equal actual(%actual_5_tail) expected(%expected_5_tail) : tensor<1xi32>
  %expected_5_uniform = check.generate.fill value(-2147483648) : tensor<32xi32>
  %actual_5_uniform = check.tensor.view %output offset(1472) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_5_uniform) expected(%expected_5_uniform) : tensor<32xi32>
  %input_expected = check.generate.iota offset(-32) step(1) : tensor<32xi32>
  check.expect.equal actual(%input) expected(%input_expected) : tensor<32xi32>
  %guard = check.generate.fill value(-7777) : tensor<16xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<416xi32> -> tensor<16xi32>
  %suffix = check.tensor.view %output offset(1600) : tensor<416xi32> -> tensor<16xi32>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<16xi32>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<16xi32>
  check.return
}

check.case public @unsigned_remainder_high_bit {
  %uniform = check.literal value(2147483647) : i32
  %input = check.generate.iota offset(-2147483648) step(1) : tensor<32xi32>
  %output = check.generate.fill value(-7777) : tensor<416xi32>
  kernel.launch @unsigned_constant_remainder(%uniform, %input, %output) : (i32, tensor<32xi32>, tensor<416xi32>)
  %expected_0_prefix = check.generate.iota offset(2) step(1) : tensor<1xi32>
  %actual_0_prefix = check.tensor.view %output offset(64) : tensor<416xi32> -> tensor<1xi32>
  check.expect.equal actual(%actual_0_prefix) expected(%expected_0_prefix) : tensor<1xi32>
  %expected_0_tail = check.generate.iota offset(0) step(1) period(3) : tensor<31xi32>
  %actual_0_tail = check.tensor.view %output offset(68) : tensor<416xi32> -> tensor<31xi32>
  check.expect.equal actual(%actual_0_tail) expected(%expected_0_tail) : tensor<31xi32>
  %expected_0_uniform = check.generate.fill value(1) : tensor<32xi32>
  %actual_0_uniform = check.tensor.view %output offset(832) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_0_uniform) expected(%expected_0_uniform) : tensor<32xi32>
  %expected_1_prefix = check.generate.iota offset(2) step(1) : tensor<5xi32>
  %actual_1_prefix = check.tensor.view %output offset(192) : tensor<416xi32> -> tensor<5xi32>
  check.expect.equal actual(%actual_1_prefix) expected(%expected_1_prefix) : tensor<5xi32>
  %expected_1_tail = check.generate.iota offset(0) step(1) period(7) : tensor<27xi32>
  %actual_1_tail = check.tensor.view %output offset(212) : tensor<416xi32> -> tensor<27xi32>
  check.expect.equal actual(%actual_1_tail) expected(%expected_1_tail) : tensor<27xi32>
  %expected_1_uniform = check.generate.fill value(1) : tensor<32xi32>
  %actual_1_uniform = check.tensor.view %output offset(960) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_1_uniform) expected(%expected_1_uniform) : tensor<32xi32>
  %expected_2_prefix = check.generate.iota offset(8) step(1) : tensor<2xi32>
  %actual_2_prefix = check.tensor.view %output offset(320) : tensor<416xi32> -> tensor<2xi32>
  check.expect.equal actual(%actual_2_prefix) expected(%expected_2_prefix) : tensor<2xi32>
  %expected_2_tail = check.generate.iota offset(0) step(1) period(10) : tensor<30xi32>
  %actual_2_tail = check.tensor.view %output offset(328) : tensor<416xi32> -> tensor<30xi32>
  check.expect.equal actual(%actual_2_tail) expected(%expected_2_tail) : tensor<30xi32>
  %expected_2_uniform = check.generate.fill value(7) : tensor<32xi32>
  %actual_2_uniform = check.tensor.view %output offset(1088) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_2_uniform) expected(%expected_2_uniform) : tensor<32xi32>
  %expected_3_prefix = check.generate.iota offset(0) step(1) : tensor<32xi32>
  %actual_3_prefix = check.tensor.view %output offset(448) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_3_prefix) expected(%expected_3_prefix) : tensor<32xi32>
  %expected_3_uniform = check.generate.fill value(2147483647) : tensor<32xi32>
  %actual_3_uniform = check.tensor.view %output offset(1216) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_3_uniform) expected(%expected_3_uniform) : tensor<32xi32>
  %expected_4_prefix = check.generate.iota offset(-2147483648) step(1) : tensor<1xi32>
  %actual_4_prefix = check.tensor.view %output offset(576) : tensor<416xi32> -> tensor<1xi32>
  check.expect.equal actual(%actual_4_prefix) expected(%expected_4_prefix) : tensor<1xi32>
  %expected_4_tail = check.generate.iota offset(0) step(1) period(2147483649) : tensor<31xi32>
  %actual_4_tail = check.tensor.view %output offset(580) : tensor<416xi32> -> tensor<31xi32>
  check.expect.equal actual(%actual_4_tail) expected(%expected_4_tail) : tensor<31xi32>
  %expected_4_uniform = check.generate.fill value(2147483647) : tensor<32xi32>
  %actual_4_uniform = check.tensor.view %output offset(1344) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_4_uniform) expected(%expected_4_uniform) : tensor<32xi32>
  %expected_5_prefix = check.generate.iota offset(-2147483648) step(1) : tensor<32xi32>
  %actual_5_prefix = check.tensor.view %output offset(704) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_5_prefix) expected(%expected_5_prefix) : tensor<32xi32>
  %expected_5_uniform = check.generate.fill value(2147483647) : tensor<32xi32>
  %actual_5_uniform = check.tensor.view %output offset(1472) : tensor<416xi32> -> tensor<32xi32>
  check.expect.equal actual(%actual_5_uniform) expected(%expected_5_uniform) : tensor<32xi32>
  %input_expected = check.generate.iota offset(-2147483648) step(1) : tensor<32xi32>
  check.expect.equal actual(%input) expected(%input_expected) : tensor<32xi32>
  %guard = check.generate.fill value(-7777) : tensor<16xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<416xi32> -> tensor<16xi32>
  %suffix = check.tensor.view %output offset(1600) : tensor<416xi32> -> tensor<16xi32>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<16xi32>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<16xi32>
  check.return
}
