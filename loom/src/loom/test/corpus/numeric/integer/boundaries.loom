// Unflagged integer arithmetic keeps low result bits on overflow. Shift
// counts stay in [0, width), where every target must agree on the result.
// The same contract applies while folding constants as during execution.
func.def public @folded_wrapping_i32(%salt: i32) -> (i32, i1) {
  %maximum = scalar.constant 2147483647 : i32
  %delta = scalar.constant 7 : i32
  %wrapped = scalar.addi %maximum, %delta : i32
  %result = scalar.addi %salt, %wrapped : i32
  %c0 = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %wrapped, %c0 : i32
  func.return %result, %negative : i32, i1
}

check.case @folded_wrapping_i32_signed_result {
  %salt = check.literal value(39) : i32
  %value, %negative = func.call @folded_wrapping_i32(%salt) : (i32) -> (i32, i1)
  %expected = check.literal value(-2147483603) : i32
  %yes = check.literal value(true) : i1
  check.expect.equal actual(%value) expected(%expected) : i32
  check.expect.equal actual(%negative) expected(%yes) : i1
  check.return
}

func.def public @wrapping_i32(%a: i32, %b: i32) -> (i32, i32, i32) {
  %sum = scalar.addi %a, %b : i32
  %difference = scalar.subi %a, %b : i32
  %product = scalar.muli %a, %b : i32
  func.return %sum, %difference, %product : i32, i32, i32
}

check.case @wrapping_i32_positive_overflow {
  %a = check.literal value(2147483647) : i32
  %b = check.literal value(1) : i32
  %sum, %difference, %product = func.call @wrapping_i32(%a, %b) : (i32, i32) -> (i32, i32, i32)
  %expected_sum = check.literal value(-2147483648) : i32
  %expected_difference = check.literal value(2147483646) : i32
  %expected_product = check.literal value(2147483647) : i32
  check.expect.equal actual(%sum) expected(%expected_sum) : i32
  check.expect.equal actual(%difference) expected(%expected_difference) : i32
  check.expect.equal actual(%product) expected(%expected_product) : i32
  check.return
}

check.case @wrapping_i32_negative_overflow {
  %a = check.literal value(-2147483648) : i32
  %b = check.literal value(-1) : i32
  %sum, %difference, %product = func.call @wrapping_i32(%a, %b) : (i32, i32) -> (i32, i32, i32)
  %expected_sum = check.literal value(2147483647) : i32
  %expected_difference = check.literal value(-2147483647) : i32
  %expected_product = check.literal value(-2147483648) : i32
  check.expect.equal actual(%sum) expected(%expected_sum) : i32
  check.expect.equal actual(%difference) expected(%expected_difference) : i32
  check.expect.equal actual(%product) expected(%expected_product) : i32
  check.return
}

check.case @wrapping_i32_product_overflow {
  %a = check.literal value(65536) : i32
  %b = check.literal value(65536) : i32
  %sum, %difference, %product = func.call @wrapping_i32(%a, %b) : (i32, i32) -> (i32, i32, i32)
  %expected_sum = check.literal value(131072) : i32
  %expected_difference = check.literal value(0) : i32
  %expected_product = check.literal value(0) : i32
  check.expect.equal actual(%sum) expected(%expected_sum) : i32
  check.expect.equal actual(%difference) expected(%expected_difference) : i32
  check.expect.equal actual(%product) expected(%expected_product) : i32
  check.return
}

func.def public @integer_multiply_add(%lhs: i32, %rhs: i32, %init: i32) -> (i32) {
  %result = scalar.fmai %lhs, %rhs, %init : i32
  func.return %result : i32
}

check.case @integer_multiply_add_wraps {
  %lhs = check.literal value(2147483647) : i32
  %rhs = check.literal value(2) : i32
  %init = check.literal value(3) : i32
  %result = func.call @integer_multiply_add(%lhs, %rhs, %init) : (i32, i32, i32) -> (i32)
  %expected = check.literal value(1) : i32
  check.expect.equal actual(%result) expected(%expected) : i32
  check.return
}

func.def public @shift_boundaries_i32(%value: i32, %count: i32) -> (i32, i32, i32, i32, i32) {
  %left = scalar.shli %value, %count : i32
  %arithmetic = scalar.shrsi %value, %count : i32
  %logical = scalar.shrui %value, %count : i32
  %rotate_left = scalar.rotli %value, %count : i32
  %rotate_right = scalar.rotri %value, %count : i32
  func.return %left, %arithmetic, %logical, %rotate_left, %rotate_right : i32, i32, i32, i32, i32
}

check.case @shift_boundaries_i32_zero {
  %value = check.param.choice values([-2147483648, -1, 0, 1, 2147483647]) : i32
  %count = check.literal value(0) : i32
  %left, %arithmetic, %logical, %rotate_left, %rotate_right = func.call @shift_boundaries_i32(%value, %count) : (i32, i32) -> (i32, i32, i32, i32, i32)
  check.expect.equal actual(%left) expected(%value) : i32
  check.expect.equal actual(%arithmetic) expected(%value) : i32
  check.expect.equal actual(%logical) expected(%value) : i32
  check.expect.equal actual(%rotate_left) expected(%value) : i32
  check.expect.equal actual(%rotate_right) expected(%value) : i32
  check.return
}

check.case @shift_boundaries_i32_last {
  %value = check.literal value(-2147483647) : i32
  %count = check.literal value(31) : i32
  %left, %arithmetic, %logical, %rotate_left, %rotate_right = func.call @shift_boundaries_i32(%value, %count) : (i32, i32) -> (i32, i32, i32, i32, i32)
  %expected_left = check.literal value(-2147483648) : i32
  check.expect.equal actual(%left) expected(%expected_left) : i32
  %expected_arithmetic = check.literal value(-1) : i32
  check.expect.equal actual(%arithmetic) expected(%expected_arithmetic) : i32
  %expected_logical = check.literal value(1) : i32
  check.expect.equal actual(%logical) expected(%expected_logical) : i32
  %expected_rotate_left = check.literal value(-1073741824) : i32
  check.expect.equal actual(%rotate_left) expected(%expected_rotate_left) : i32
  %expected_rotate_right = check.literal value(3) : i32
  check.expect.equal actual(%rotate_right) expected(%expected_rotate_right) : i32
  check.return
}

func.def public @wrapping_i64(%a: i64, %b: i64) -> (i64, i64, i64) {
  %sum = scalar.addi %a, %b : i64
  %difference = scalar.subi %a, %b : i64
  %product = scalar.muli %a, %b : i64
  func.return %sum, %difference, %product : i64, i64, i64
}

check.case @wrapping_i64_positive_overflow {
  %a = check.literal value(9223372036854775807) : i64
  %b = check.literal value(1) : i64
  %sum, %difference, %product = func.call @wrapping_i64(%a, %b) : (i64, i64) -> (i64, i64, i64)
  %expected_sum = check.literal value(-9223372036854775808) : i64
  %expected_difference = check.literal value(9223372036854775806) : i64
  %expected_product = check.literal value(9223372036854775807) : i64
  check.expect.equal actual(%sum) expected(%expected_sum) : i64
  check.expect.equal actual(%difference) expected(%expected_difference) : i64
  check.expect.equal actual(%product) expected(%expected_product) : i64
  check.return
}

check.case @wrapping_i64_negative_overflow {
  %a = check.literal value(-9223372036854775808) : i64
  %b = check.literal value(-1) : i64
  %sum, %difference, %product = func.call @wrapping_i64(%a, %b) : (i64, i64) -> (i64, i64, i64)
  %expected_sum = check.literal value(9223372036854775807) : i64
  %expected_difference = check.literal value(-9223372036854775807) : i64
  %expected_product = check.literal value(-9223372036854775808) : i64
  check.expect.equal actual(%sum) expected(%expected_sum) : i64
  check.expect.equal actual(%difference) expected(%expected_difference) : i64
  check.expect.equal actual(%product) expected(%expected_product) : i64
  check.return
}

check.case @wrapping_i64_product_overflow {
  %a = check.literal value(4294967296) : i64
  %b = check.literal value(4294967296) : i64
  %sum, %difference, %product = func.call @wrapping_i64(%a, %b) : (i64, i64) -> (i64, i64, i64)
  %expected_sum = check.literal value(8589934592) : i64
  %expected_difference = check.literal value(0) : i64
  %expected_product = check.literal value(0) : i64
  check.expect.equal actual(%sum) expected(%expected_sum) : i64
  check.expect.equal actual(%difference) expected(%expected_difference) : i64
  check.expect.equal actual(%product) expected(%expected_product) : i64
  check.return
}

func.def public @shift_boundaries_i64(%value: i64, %count: i64) -> (i64, i64, i64, i64, i64) {
  %left = scalar.shli %value, %count : i64
  %arithmetic = scalar.shrsi %value, %count : i64
  %logical = scalar.shrui %value, %count : i64
  %rotate_left = scalar.rotli %value, %count : i64
  %rotate_right = scalar.rotri %value, %count : i64
  func.return %left, %arithmetic, %logical, %rotate_left, %rotate_right : i64, i64, i64, i64, i64
}

check.case @shift_boundaries_i64_zero {
  %value = check.param.choice values([-9223372036854775808, -1, 0, 1, 9223372036854775807]) : i64
  %count = check.literal value(0) : i64
  %left, %arithmetic, %logical, %rotate_left, %rotate_right = func.call @shift_boundaries_i64(%value, %count) : (i64, i64) -> (i64, i64, i64, i64, i64)
  check.expect.equal actual(%left) expected(%value) : i64
  check.expect.equal actual(%arithmetic) expected(%value) : i64
  check.expect.equal actual(%logical) expected(%value) : i64
  check.expect.equal actual(%rotate_left) expected(%value) : i64
  check.expect.equal actual(%rotate_right) expected(%value) : i64
  check.return
}

check.case @shift_boundaries_i64_last {
  %value = check.literal value(-9223372036854775807) : i64
  %count = check.literal value(63) : i64
  %left, %arithmetic, %logical, %rotate_left, %rotate_right = func.call @shift_boundaries_i64(%value, %count) : (i64, i64) -> (i64, i64, i64, i64, i64)
  %expected_left = check.literal value(-9223372036854775808) : i64
  check.expect.equal actual(%left) expected(%expected_left) : i64
  %expected_arithmetic = check.literal value(-1) : i64
  check.expect.equal actual(%arithmetic) expected(%expected_arithmetic) : i64
  %expected_logical = check.literal value(1) : i64
  check.expect.equal actual(%logical) expected(%expected_logical) : i64
  %expected_rotate_left = check.literal value(-4611686018427387904) : i64
  check.expect.equal actual(%rotate_left) expected(%expected_rotate_left) : i64
  %expected_rotate_right = check.literal value(3) : i64
  check.expect.equal actual(%rotate_right) expected(%expected_rotate_right) : i64
  check.return
}
