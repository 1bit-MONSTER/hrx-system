}

func.def public @integer_unary_i32(%value: i32) -> (i32, i32, i32, i32, i32) {
  %negated = scalar.negi %value : i32
  %absolute = scalar.absi %value : i32
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  func.return %negated, %absolute, %leading, %trailing, %population : i32, i32, i32, i32, i32
}

check.scenario @integer_unary_i32_case {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %minimum = check.literal value(-2147483648) : i32
    check.compare<@integer_unary_i32>(%minimum) : (i32) -> [actual(%negated: i32, %absolute: i32, %leading: i32, %trailing: i32, %population: i32), expected(%oracle_negated: i32, %oracle_absolute: i32, %oracle_leading: i32, %oracle_trailing: i32, %oracle_population: i32)] {
      check.expect.equal actual(%negated) expected(%oracle_negated) : i32
      check.expect.equal actual(%absolute) expected(%oracle_absolute) : i32
      check.expect.equal actual(%leading) expected(%oracle_leading) : i32
      check.expect.equal actual(%trailing) expected(%oracle_trailing) : i32
      check.expect.equal actual(%population) expected(%oracle_population) : i32
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %zero = check.literal value(0) : i32
    check.compare<@integer_unary_i32>(%zero) : (i32) -> [actual(%negated: i32, %absolute: i32, %leading: i32, %trailing: i32, %population: i32), expected(%oracle_negated: i32, %oracle_absolute: i32, %oracle_leading: i32, %oracle_trailing: i32, %oracle_population: i32)] {
      check.expect.equal actual(%negated) expected(%oracle_negated) : i32
      check.expect.equal actual(%absolute) expected(%oracle_absolute) : i32
      check.expect.equal actual(%leading) expected(%oracle_leading) : i32
      check.expect.equal actual(%trailing) expected(%oracle_trailing) : i32
      check.expect.equal actual(%population) expected(%oracle_population) : i32
    }
  }
  check.return
}

