// The same cell bits have different signed and unsigned orderings. Dynamic
// arguments keep ordering and rotation in the compiled function, including
// values whose sign bit distinguishes a 32-bit cell from a complete 64-bit cell.
func.def public @order_and_rotate_i32(%value: i32, %lower: i32, %upper: i32, %shift: i32) -> (i32, i32, i32, i32, i32) {
  %signed_lower = scalar.maxsi %value, %lower : i32
  %signed_clamp = scalar.minsi %signed_lower, %upper : i32
  %unsigned_lower = scalar.maxui %value, %lower : i32
  %unsigned_clamp = scalar.minui %unsigned_lower, %upper : i32
  %left = scalar.rotli %value, %shift : i32
  %right = scalar.rotri %value, %shift : i32
  %logical = scalar.shrui %value, %shift : i32
  func.return %signed_clamp, %unsigned_clamp, %left, %right, %logical : i32, i32, i32, i32, i32
}

check.case @order_and_rotate_i32_case {
  %value = check.literal value(-2147483647) : i32
  %lower = check.literal value(1) : i32
  %upper = check.literal value(100) : i32
  %shift = check.literal value(1) : i32
  %signed, %unsigned, %left, %right, %logical = func.call @order_and_rotate_i32(%value, %lower, %upper, %shift) : (i32, i32, i32, i32) -> (i32, i32, i32, i32, i32)
  %expected_left = check.literal value(3) : i32
  %expected_right = check.literal value(-1073741824) : i32
  %expected_logical = check.literal value(1073741824) : i32
  check.expect.equal actual(%signed) expected(%lower) : i32
  check.expect.equal actual(%unsigned) expected(%upper) : i32
  check.expect.equal actual(%left) expected(%expected_left) : i32
  check.expect.equal actual(%right) expected(%expected_right) : i32
  check.expect.equal actual(%logical) expected(%expected_logical) : i32
  check.return
}

func.def public @order_and_rotate_i64(%value: i64, %lower: i64, %upper: i64, %shift: i64) -> (i64, i64, i64, i64, i64) {
  %signed_lower = scalar.maxsi %value, %lower : i64
  %signed_clamp = scalar.minsi %signed_lower, %upper : i64
  %unsigned_lower = scalar.maxui %value, %lower : i64
  %unsigned_clamp = scalar.minui %unsigned_lower, %upper : i64
  %left = scalar.rotli %value, %shift : i64
  %right = scalar.rotri %value, %shift : i64
  %logical = scalar.shrui %value, %shift : i64
  func.return %signed_clamp, %unsigned_clamp, %left, %right, %logical : i64, i64, i64, i64, i64
}

check.case @order_and_rotate_i64_case {
  %value = check.literal value(-9223372036854775807) : i64
  %lower = check.literal value(1) : i64
  %upper = check.literal value(100) : i64
  %shift = check.literal value(1) : i64
  %signed, %unsigned, %left, %right, %logical = func.call @order_and_rotate_i64(%value, %lower, %upper, %shift) : (i64, i64, i64, i64) -> (i64, i64, i64, i64, i64)
  %expected_left = check.literal value(3) : i64
  %expected_right = check.literal value(-4611686018427387904) : i64
  %expected_logical = check.literal value(4611686018427387904) : i64
  check.expect.equal actual(%signed) expected(%lower) : i64
  check.expect.equal actual(%unsigned) expected(%upper) : i64
  check.expect.equal actual(%left) expected(%expected_left) : i64
  check.expect.equal actual(%right) expected(%expected_right) : i64
  check.expect.equal actual(%logical) expected(%expected_logical) : i64
  check.return
}

func.def public @integer_unary_i32(%value: i32) -> (i32, i32, i32, i32, i32) {
  %negated = scalar.negi %value : i32
  %absolute = scalar.absi %value : i32
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  func.return %negated, %absolute, %leading, %trailing, %population : i32, i32, i32, i32, i32
}

check.case @integer_unary_i32_case {
  %minimum = check.literal value(-2147483648) : i32
  %zero = check.literal value(0) : i32
  %one = check.literal value(1) : i32
  %width = check.literal value(32) : i32
  %last_bit = check.literal value(31) : i32
  %negated, %absolute, %leading, %trailing, %population = func.call @integer_unary_i32(%minimum) : (i32) -> (i32, i32, i32, i32, i32)
  check.expect.equal actual(%negated) expected(%minimum) : i32
  check.expect.equal actual(%absolute) expected(%minimum) : i32
  check.expect.equal actual(%leading) expected(%zero) : i32
  check.expect.equal actual(%trailing) expected(%last_bit) : i32
  check.expect.equal actual(%population) expected(%one) : i32
  %negated_zero, %absolute_zero, %leading_zero, %trailing_zero, %population_zero = func.call @integer_unary_i32(%zero) : (i32) -> (i32, i32, i32, i32, i32)
  check.expect.equal actual(%negated_zero) expected(%zero) : i32
  check.expect.equal actual(%absolute_zero) expected(%zero) : i32
  check.expect.equal actual(%leading_zero) expected(%width) : i32
  check.expect.equal actual(%trailing_zero) expected(%width) : i32
  check.expect.equal actual(%population_zero) expected(%zero) : i32
  check.return
}

func.def public @integer_unary_i64(%value: i64) -> (i64, i64, i64, i64, i64) {
  %negated = scalar.negi %value : i64
  %absolute = scalar.absi %value : i64
  %leading = scalar.ctlzi %value : i64
  %trailing = scalar.cttzi %value : i64
  %population = scalar.ctpopi %value : i64
  func.return %negated, %absolute, %leading, %trailing, %population : i64, i64, i64, i64, i64
}

check.case @integer_unary_i64_case {
  %minimum = check.literal value(-9223372036854775808) : i64
  %zero = check.literal value(0) : i64
  %one = check.literal value(1) : i64
  %width = check.literal value(64) : i64
  %last_bit = check.literal value(63) : i64
  %negated, %absolute, %leading, %trailing, %population = func.call @integer_unary_i64(%minimum) : (i64) -> (i64, i64, i64, i64, i64)
  check.expect.equal actual(%negated) expected(%minimum) : i64
  check.expect.equal actual(%absolute) expected(%minimum) : i64
  check.expect.equal actual(%leading) expected(%zero) : i64
  check.expect.equal actual(%trailing) expected(%last_bit) : i64
  check.expect.equal actual(%population) expected(%one) : i64
  %negated_zero, %absolute_zero, %leading_zero, %trailing_zero, %population_zero = func.call @integer_unary_i64(%zero) : (i64) -> (i64, i64, i64, i64, i64)
  check.expect.equal actual(%negated_zero) expected(%zero) : i64
  check.expect.equal actual(%absolute_zero) expected(%zero) : i64
  check.expect.equal actual(%leading_zero) expected(%width) : i64
  check.expect.equal actual(%trailing_zero) expected(%width) : i64
  check.expect.equal actual(%population_zero) expected(%zero) : i64
  check.return
}
