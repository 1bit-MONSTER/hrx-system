  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %values = buffer.view %input[%base] : buffer -> view<32xi32>
  %c3 = scalar.constant 3 : i32
  %c5 = scalar.constant 5 : i32
  %c7 = scalar.constant 7 : i32
  %c9 = scalar.constant 9 : i32
  %c20 = scalar.constant 20 : i32
  %divisor_3 = scalar.addi %dynamic_zero, %c3 : i32
  %divisor_5 = scalar.addi %dynamic_zero, %c5 : i32
  %divisor_7 = scalar.addi %dynamic_zero, %c7 : i32
  %divisor_9 = scalar.addi %dynamic_zero, %c9 : i32
  %divisor_20 = scalar.addi %dynamic_zero, %c20 : i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<32xi32> -> i32
    %varying_column = index.add %lane, %end : index
    func.call @dynamic_index_division_rows(%uniform, %divisor_3, %divisor_5, %divisor_7, %divisor_9, %divisor_20, %output, %lane) : (i32, i32, i32, i32, i32, i32, buffer, index)
    func.call @dynamic_index_division_rows(%value, %divisor_3, %divisor_5, %divisor_7, %divisor_9, %divisor_20, %output, %varying_column) : (i32, i32, i32, i32, i32, i32, buffer, index)
  }
  func.return
}

func.def @constant_index_boundary_division(%dynamic_zero: index, %value: index, %output: buffer) {
  %base = index.constant 0 : offset
  %bounded = index.assume %value [range(%value, 0, 4294967295)] : index
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %high_power = index.constant 2147483648 : index
  %largest = index.constant 4294967295 : index
  %high_power_quotient = index.div %bounded, %high_power : index
  %high_power_remainder = index.rem %bounded, %high_power : index
  %largest_quotient = index.div %bounded, %largest : index
  %largest_remainder = index.rem %bounded, %largest : index
  %word_high_power_quotient = index.cast %high_power_quotient : index to i32
  %word_high_power_remainder = index.cast %high_power_remainder : index to i32
  %word_largest_quotient = index.cast %largest_quotient : index to i32
  %word_largest_remainder = index.cast %largest_remainder : index to i32
  view.store %word_high_power_quotient, %results[0] : i32, view<4xi32>
  view.store %word_high_power_remainder, %results[1] : i32, view<4xi32>
  view.store %word_largest_quotient, %results[2] : i32, view<4xi32>
  view.store %word_largest_remainder, %results[3] : i32, view<4xi32>
  func.return
}

func.def @dynamic_index_boundary_division(%dynamic_zero: index, %value: index, %output: buffer) {
  %base = index.constant 0 : offset
  %bounded = index.assume %value [range(%value, 0, 4294967295)] : index
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %high_power_constant = index.constant 2147483648 : index
  %largest_constant = index.constant 4294967295 : index
  %high_power = index.add %dynamic_zero, %high_power_constant : index
  %largest = index.add %dynamic_zero, %largest_constant : index
  %bounded_high_power = index.assume %high_power [range(%high_power, 1, 4294967295)] : index
  %bounded_largest = index.assume %largest [range(%largest, 1, 4294967295)] : index
  %high_power_quotient = index.div %bounded, %bounded_high_power : index
  %high_power_remainder = index.rem %bounded, %bounded_high_power : index
  %largest_quotient = index.div %bounded, %bounded_largest : index
  %largest_remainder = index.rem %bounded, %bounded_largest : index
  %word_high_power_quotient = index.cast %high_power_quotient : index to i32
  %word_high_power_remainder = index.cast %high_power_remainder : index to i32
  %word_largest_quotient = index.cast %largest_quotient : index to i32
  %word_largest_remainder = index.cast %largest_remainder : index to i32
  view.store %word_high_power_quotient, %results[0] : i32, view<4xi32>
  view.store %word_high_power_remainder, %results[1] : i32, view<4xi32>
  view.store %word_largest_quotient, %results[2] : i32, view<4xi32>
  view.store %word_largest_remainder, %results[3] : i32, view<4xi32>
  func.return
}

check.scenario @constant_scalar_quotient_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %zero = check.literal value(0) : i32
    %maximum = check.literal value(4294967295) : i64
    %input = check.generate.iota offset(0) step(1) : tensor<32xi32>
    %unchanged_input = check.generate.iota offset(0) step(1) : tensor<32xi32>
    %storage = check.generate.fill value(-123) : tensor<592xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<592xi32> -> tensor<8xi32>
    %output = check.tensor.view %storage offset(32) : tensor<592xi32> -> tensor<576xi32>
    %suffix = check.tensor.view %storage offset(2336) : tensor<592xi32> -> tensor<8xi32>
    %guard = check.generate.fill value(-123) : tensor<8xi32>
    check.compare<@constant_scalar_quotient_observations, @dynamic_scalar_quotient_observations>(%zero, %maximum, %input, %output) : (i32, i64, tensor<32xi32>, tensor<576xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%unchanged_input) : tensor<32xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<576xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<8xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<8xi32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %uniform_entropy = check.entropy.fork %entropy name("uniform") : check.entropy
    %input_entropy = check.entropy.fork %entropy name("input") : check.entropy
    %uniform_bits = check.entropy.read %uniform_entropy[%trial] : check.entropy -> i64
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %zero = check.literal value(0) : i32
    %input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %unchanged_input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %storage = check.generate.fill value(-123) : tensor<592xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<592xi32> -> tensor<8xi32>
    %output = check.tensor.view %storage offset(32) : tensor<592xi32> -> tensor<576xi32>
    %suffix = check.tensor.view %storage offset(2336) : tensor<592xi32> -> tensor<8xi32>
    %guard = check.generate.fill value(-123) : tensor<8xi32>
    check.compare<@constant_scalar_quotient_observations, @dynamic_scalar_quotient_observations>(%zero, %uniform_bits, %input, %output) : (i32, i64, tensor<32xi32>, tensor<576xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%unchanged_input) : tensor<32xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<576xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<8xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<8xi32>
    }
  }
  check.return
}

