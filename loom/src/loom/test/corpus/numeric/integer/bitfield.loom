func.def public @bitfield_full_width(%byte: i8, %word: i32, %wide: i64) -> (i8, i32, i64) {
  %byte_bits = scalar.bitfield.extracts %byte {offset = 0, width = 8} : i8 -> i8
  %word_bits = scalar.bitfield.extractu %word {offset = 0, width = 32} : i32 -> i32
  %wide_bits = scalar.bitfield.extracts %wide {offset = 0, width = 64} : i64 -> i64
  func.return %byte_bits, %word_bits, %wide_bits : i8, i32, i64
}

check.case @bitfield_full_width_case {
  %byte = check.param.choice values([-128, 0, 127]) : i8
  %word = check.param.choice values([-2147483648, -1, 2147483647]) : i32
  %wide = check.param.choice values([-9223372036854775808, 0, -1, 9223372036854775807]) : i64
  %byte_bits, %word_bits, %wide_bits = func.call @bitfield_full_width(%byte, %word, %wide) : (i8, i32, i64) -> (i8, i32, i64)
  check.expect.bitwise actual(%byte_bits) expected(%byte) : i8
  check.expect.bitwise actual(%word_bits) expected(%word) : i32
  check.expect.bitwise actual(%wide_bits) expected(%wide) : i64
  check.return
}

func.def public @bitfield_widen(%byte: i8, %half: i16) -> (i32, i64, i16, i64) {
  %low = scalar.bitfield.extractu %byte {offset = 0, width = 4} : i8 -> i32
  %high = scalar.bitfield.extracts %byte {offset = 4, width = 4} : i8 -> i64
  %middle = scalar.bitfield.extractu %half {offset = 3, width = 8} : i16 -> i16
  %top = scalar.bitfield.extracts %half {offset = 8, width = 8} : i16 -> i64
  func.return %low, %high, %middle, %top : i32, i64, i16, i64
}

check.case @bitfield_widen_case {
  %byte = check.literal value(-91) : i8
  %half = check.literal value(-14043) : i16
  %low, %high, %middle, %top = func.call @bitfield_widen(%byte, %half) : (i8, i16) -> (i32, i64, i16, i64)
  %expected_low = check.literal value(5) : i32
  %expected_high = check.literal value(-6) : i64
  %expected_middle = check.literal value(36) : i16
  %expected_top = check.literal value(-55) : i64
  check.expect.equal actual(%low) expected(%expected_low) : i32
  check.expect.equal actual(%high) expected(%expected_high) : i64
  check.expect.equal actual(%middle) expected(%expected_middle) : i16
  check.expect.equal actual(%top) expected(%expected_top) : i64
  check.return
}

func.def public @bitfield_narrow(%wide: i64) -> (i8, i16, i64, i64) {
  %byte = scalar.bitfield.extractu %wide {offset = 32, width = 8} : i64 -> i8
  %half = scalar.bitfield.extracts %wide {offset = 40, width = 12} : i64 -> i16
  %sign = scalar.bitfield.extracts %wide {offset = 63, width = 1} : i64 -> i64
  %low = scalar.bitfield.extractu %wide {offset = 0, width = 63} : i64 -> i64
  func.return %byte, %half, %sign, %low : i8, i16, i64, i64
}

check.case @bitfield_narrow_case {
  %wide = check.literal value(-8449633678174955912) : i64
  %byte, %half, %sign, %low = func.call @bitfield_narrow(%wide) : (i64) -> (i8, i16, i64, i64)
  %expected_byte = check.literal value(-16) : i8
  %expected_half = check.literal value(-802) : i16
  %expected_sign = check.literal value(-1) : i64
  %expected_low = check.literal value(773738358679819896) : i64
  check.expect.equal actual(%byte) expected(%expected_byte) : i8
  check.expect.equal actual(%half) expected(%expected_half) : i16
  check.expect.equal actual(%sign) expected(%expected_sign) : i64
  check.expect.equal actual(%low) expected(%expected_low) : i64
  check.return
}

check.case @bitfield_sign_only_case {
  %wide = check.literal value(-9223372036854775808) : i64
  %byte, %half, %sign, %low = func.call @bitfield_narrow(%wide) : (i64) -> (i8, i16, i64, i64)
  %expected_byte = check.literal value(0) : i8
  %expected_half = check.literal value(0) : i16
  %expected_sign = check.literal value(-1) : i64
  %expected_low = check.literal value(0) : i64
  check.expect.equal actual(%byte) expected(%expected_byte) : i8
  check.expect.equal actual(%half) expected(%expected_half) : i16
  check.expect.equal actual(%sign) expected(%expected_sign) : i64
  check.expect.equal actual(%low) expected(%expected_low) : i64
  check.return
}

func.def public @bitfield_predicate(%condition: i1, %word: i32) -> (i1, i32, i64, i1) {
  %identity = scalar.bitfield.extractu %condition {offset = 0, width = 1} : i1 -> i1
  %unsigned = scalar.bitfield.extractu %condition {offset = 0, width = 1} : i1 -> i32
  %signed = scalar.bitfield.extracts %condition {offset = 0, width = 1} : i1 -> i64
  %top = scalar.bitfield.extractu %word {offset = 31, width = 1} : i32 -> i1
  func.return %identity, %unsigned, %signed, %top : i1, i32, i64, i1
}

check.case @bitfield_predicate_set {
  %condition = check.literal value(true) : i1
  %word = check.param.choice values([-2147483648, -1]) : i32
  %identity, %unsigned, %signed, %top = func.call @bitfield_predicate(%condition, %word) : (i1, i32) -> (i1, i32, i64, i1)
  %expected_unsigned = check.literal value(1) : i32
  %expected_signed = check.literal value(-1) : i64
  check.expect.equal actual(%identity) expected(%condition) : i1
  check.expect.equal actual(%unsigned) expected(%expected_unsigned) : i32
  check.expect.equal actual(%signed) expected(%expected_signed) : i64
  check.expect.equal actual(%top) expected(%condition) : i1
  check.return
}

check.case @bitfield_predicate_clear {
  %condition = check.literal value(false) : i1
  %word = check.param.choice values([0, 2147483647]) : i32
  %identity, %unsigned, %signed, %top = func.call @bitfield_predicate(%condition, %word) : (i1, i32) -> (i1, i32, i64, i1)
  %expected_unsigned = check.literal value(0) : i32
  %expected_signed = check.literal value(0) : i64
  check.expect.equal actual(%identity) expected(%condition) : i1
  check.expect.equal actual(%unsigned) expected(%expected_unsigned) : i32
  check.expect.equal actual(%signed) expected(%expected_signed) : i64
  check.expect.equal actual(%top) expected(%condition) : i1
  check.return
}

// Two differently signed packed bytes exercise the scalar counterpart with
// different input/output element types and preserved offset/width attributes.
func.def public @bitfield_vector_lanes(%a: i8, %b: i8) -> (i32, i32, i32, i32) {
  %seed = vector.splat %a : vector<2xi8>
  %packed = vector.insert %b into %seed[1] : i8, vector<2xi8>
  %low = vector.bitfield.extractu %packed {offset = 0, width = 4} : vector<2xi8> -> vector<2xi32>
  %high = vector.bitfield.extracts %packed {offset = 4, width = 4} : vector<2xi8> -> vector<2xi32>
  %low_a = vector.extract %low[0] : vector<2xi32> -> i32
  %low_b = vector.extract %low[1] : vector<2xi32> -> i32
  %high_a = vector.extract %high[0] : vector<2xi32> -> i32
  %high_b = vector.extract %high[1] : vector<2xi32> -> i32
  func.return %low_a, %low_b, %high_a, %high_b : i32, i32, i32, i32
}

check.case @bitfield_vector_lanes_case {
  %a = check.literal value(-91) : i8
  %b = check.literal value(127) : i8
  %low_a, %low_b, %high_a, %high_b = func.call @bitfield_vector_lanes(%a, %b) : (i8, i8) -> (i32, i32, i32, i32)
  %expected_low_a = check.literal value(5) : i32
  %expected_low_b = check.literal value(15) : i32
  %expected_high_a = check.literal value(-6) : i32
  %expected_high_b = check.literal value(7) : i32
  check.expect.equal actual(%low_a) expected(%expected_low_a) : i32
  check.expect.equal actual(%low_b) expected(%expected_low_b) : i32
  check.expect.equal actual(%high_a) expected(%expected_high_a) : i32
  check.expect.equal actual(%high_b) expected(%expected_high_b) : i32
  check.return
}
