// Uniform subtraction retains scalar pairs, while loaded values exercise both
// mixed operand orders and varying subtraction. Results use modulo-2^64 integer
// arithmetic, including negation of the minimum signed value.
kernel.def @integer_wide_subtract() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%lhs: i64, %rhs: i64, %rounds: i32, %input: buffer, %other: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %output_base = index.constant 128 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 8} : buffer
  %aligned_other = buffer.assume.alignment %other {minimum_alignment = 8} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %inputs = buffer.view %aligned_input[%base] : buffer -> view<32xi64>
  %others = buffer.view %aligned_other[%base] : buffer -> view<32xi64>
  %outputs = buffer.view %aligned_output[%output_base] : buffer -> view<10x32xi64>
  %value = view.load %inputs[%lane] : view<32xi64> -> i64
  %other_value = view.load %others[%lane] : view<32xi64> -> i64
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  %difference = scalar.subi %lhs, %rhs : i64
  %negated = scalar.subi %c0, %lhs : i64
  %constant_right = scalar.subi %lhs, %wide : i64
  %constant_left = scalar.subi %wide, %lhs : i64
  %reverse = scalar.subi %rhs, %lhs : i64
  %chain = scalar.subi %difference, %reverse : i64
  %uniform_right = scalar.subi %value, %lhs : i64
  %uniform_left = scalar.subi %lhs, %value : i64
  %varying = scalar.subi %value, %other_value : i64
  %step = index.constant 1 : offset
  %end = index.cast %rounds : i32 to offset
  %repeated = scf.for %iteration = [%base to %end step %step](%previous = %lhs : i64) -> (i64) {
    %next = scalar.subi %previous, %rhs : i64
    scf.yield %next : i64
  }
  %equal = scalar.cmpi eq, %lhs, %rhs : i64
  %selected = scf.select %equal, %negated, %chain : i64
  view.store %difference, %outputs[0, %lane] : i64, view<10x32xi64>
  view.store %negated, %outputs[1, %lane] : i64, view<10x32xi64>
  view.store %constant_right, %outputs[2, %lane] : i64, view<10x32xi64>
  view.store %constant_left, %outputs[3, %lane] : i64, view<10x32xi64>
  view.store %chain, %outputs[4, %lane] : i64, view<10x32xi64>
  view.store %uniform_right, %outputs[5, %lane] : i64, view<10x32xi64>
  view.store %uniform_left, %outputs[6, %lane] : i64, view<10x32xi64>
  view.store %varying, %outputs[7, %lane] : i64, view<10x32xi64>
  view.store %repeated, %outputs[8, %lane] : i64, view<10x32xi64>
  view.store %selected, %outputs[9, %lane] : i64, view<10x32xi64>
  kernel.return
}

check.case public @wide_subtract_zero {
  %lhs = check.literal value(0) : i64
  %rhs = check.literal value(0) : i64
  %rounds = check.literal value(0) : i32
  %input = check.generate.iota offset(0) step(1) : tensor<32xi64>
  %other = check.generate.iota offset(0) step(2) : tensor<32xi64>
  %output = check.generate.fill value(-7777) : tensor<352xi64>
  kernel.launch @integer_wide_subtract(%lhs, %rhs, %rounds, %input, %other, %output) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>)
  %expected_0 = check.generate.fill value(0) : tensor<32xi64>
  %actual_0 = check.tensor.view %output offset(128) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_0) expected(%expected_0) : tensor<32xi64>
  %expected_1 = check.generate.fill value(0) : tensor<32xi64>
  %actual_1 = check.tensor.view %output offset(384) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_1) expected(%expected_1) : tensor<32xi64>
  %expected_2 = check.generate.fill value(-4294967297) : tensor<32xi64>
  %actual_2 = check.tensor.view %output offset(640) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_2) expected(%expected_2) : tensor<32xi64>
  %expected_3 = check.generate.fill value(4294967297) : tensor<32xi64>
  %actual_3 = check.tensor.view %output offset(896) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_3) expected(%expected_3) : tensor<32xi64>
  %expected_4 = check.generate.fill value(0) : tensor<32xi64>
  %actual_4 = check.tensor.view %output offset(1152) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_4) expected(%expected_4) : tensor<32xi64>
  %expected_5 = check.generate.iota offset(0) step(1) : tensor<32xi64>
  %actual_5 = check.tensor.view %output offset(1408) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_5) expected(%expected_5) : tensor<32xi64>
  %expected_6 = check.generate.iota offset(0) step(-1) : tensor<32xi64>
  %actual_6 = check.tensor.view %output offset(1664) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_6) expected(%expected_6) : tensor<32xi64>
  %expected_7 = check.generate.iota offset(0) step(-1) : tensor<32xi64>
  %actual_7 = check.tensor.view %output offset(1920) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_7) expected(%expected_7) : tensor<32xi64>
  %expected_8 = check.generate.fill value(0) : tensor<32xi64>
  %actual_8 = check.tensor.view %output offset(2176) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_8) expected(%expected_8) : tensor<32xi64>
  %expected_9 = check.generate.fill value(0) : tensor<32xi64>
  %actual_9 = check.tensor.view %output offset(2432) : tensor<352xi64> -> tensor<32xi64>
  check.expect.bitwise actual(%actual_9) expected(%expected_9) : tensor<32xi64>
  %expected_input = check.generate.iota offset(0) step(1) : tensor<32xi64>
  %expected_other = check.generate.iota offset(0) step(2) : tensor<32xi64>
  check.expect.bitwise actual(%input) expected(%expected_input) : tensor<32xi64>
  check.expect.bitwise actual(%other) expected(%expected_other) : tensor<32xi64>
  %prefix = check.tensor.view %output offset(0) : tensor<352xi64> -> tensor<16xi64>
  %suffix = check.tensor.view %output offset(2688) : tensor<352xi64> -> tensor<16xi64>
  %guard = check.generate.fill value(-7777) : tensor<16xi64>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<16xi64>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<16xi64>
  check.return
}

