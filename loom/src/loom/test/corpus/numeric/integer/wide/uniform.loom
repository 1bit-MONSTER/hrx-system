// Uniform operands stay in scalar register pairs. The checked values cross
// low-word carries, exercise high-word products, and retain signed bit patterns.
kernel.def @uniform_i64_arithmetic() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs: i64, %rhs: i64, %shift: i64, %sum_output: buffer, %product_output: buffer, %shifted_output: buffer) {
  %sum = scalar.addi %lhs, %rhs : i64
  %product = scalar.muli %lhs, %rhs : i64
  %shifted = scalar.shli %lhs, %shift : i64
  %base = index.constant 0 : offset
  %sum_storage = buffer.assume.alignment %sum_output {minimum_alignment = 8} : buffer
  %product_storage = buffer.assume.alignment %product_output {minimum_alignment = 8} : buffer
  %shifted_storage = buffer.assume.alignment %shifted_output {minimum_alignment = 8} : buffer
  %sum_view = buffer.view %sum_storage[%base] : buffer -> view<1xi64>
  %product_view = buffer.view %product_storage[%base] : buffer -> view<1xi64>
  %shifted_view = buffer.view %shifted_storage[%base] : buffer -> view<1xi64>
  view.store %sum, %sum_view[0] : i64, view<1xi64>
  view.store %product, %product_view[0] : i64, view<1xi64>
  view.store %shifted, %shifted_view[0] : i64, view<1xi64>
  kernel.return
}

check.case public @uniform_i64_arithmetic_0 {
  %lhs = check.literal value(0) : i64
  %rhs = check.literal value(0) : i64
  %shift = check.literal value(0) : i64
  %sum_output = check.generate.fill value(99) : tensor<1xi64>
  %product_output = check.generate.fill value(99) : tensor<1xi64>
  %shifted_output = check.generate.fill value(99) : tensor<1xi64>
  kernel.launch @uniform_i64_arithmetic(%lhs, %rhs, %shift, %sum_output, %product_output, %shifted_output) : (i64, i64, i64, tensor<1xi64>, tensor<1xi64>, tensor<1xi64>)
  %expected_sum = check.generate.fill value(0) : tensor<1xi64>
  check.expect.equal actual(%sum_output) expected(%expected_sum) : tensor<1xi64>
  %expected_product = check.generate.fill value(0) : tensor<1xi64>
  check.expect.equal actual(%product_output) expected(%expected_product) : tensor<1xi64>
  %expected_shifted = check.generate.fill value(0) : tensor<1xi64>
  check.expect.equal actual(%shifted_output) expected(%expected_shifted) : tensor<1xi64>
  check.return
}

