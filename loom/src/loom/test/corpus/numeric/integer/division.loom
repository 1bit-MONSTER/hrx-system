// Signed division rounds toward zero; unsigned division reads all cell bits.
func.def public @division_i32(%dividend: i32, %divisor: i32) -> (i32, i32, i32, i32) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i32
  %signed_remainder = scalar.remsi %dividend, %divisor : i32
  %unsigned_quotient = scalar.divui %dividend, %divisor : i32
  %unsigned_remainder = scalar.remui %dividend, %divisor : i32
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

check.case @division_i32_case {
  %dividend = check.literal value(-17) : i32
  %divisor = check.literal value(5) : i32
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i32(%dividend, %divisor) : (i32, i32) -> (i32, i32, i32, i32)
  %expected_signed_quotient = check.literal value(-3) : i32
  %expected_signed_remainder = check.literal value(-2) : i32
  %expected_unsigned_quotient = check.literal value(858993455) : i32
  %expected_unsigned_remainder = check.literal value(4) : i32
  check.expect.equal actual(%signed_quotient) expected(%expected_signed_quotient) : i32
  check.expect.equal actual(%signed_remainder) expected(%expected_signed_remainder) : i32
  check.expect.equal actual(%unsigned_quotient) expected(%expected_unsigned_quotient) : i32
  check.expect.equal actual(%unsigned_remainder) expected(%expected_unsigned_remainder) : i32
  check.return
}

// Unlike signed quotient, signed minimum remainder by -1 is exactly zero.
func.def public @minimum_remainder_i32(%dividend: i32, %divisor: i32) -> (i32) {
  %remainder = scalar.remsi %dividend, %divisor : i32
  func.return %remainder : i32
}

check.case @minimum_remainder_i32_case {
  %minimum = check.literal value(-2147483648) : i32
  %negative_one = check.literal value(-1) : i32
  %zero = check.literal value(0) : i32
  %remainder = func.call @minimum_remainder_i32(%minimum, %negative_one) : (i32, i32) -> (i32)
  check.expect.equal actual(%remainder) expected(%zero) : i32
  check.return
}

// Signed division rounds toward zero; unsigned division reads all cell bits.
func.def public @division_i64(%dividend: i64, %divisor: i64) -> (i64, i64, i64, i64) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i64
  %signed_remainder = scalar.remsi %dividend, %divisor : i64
  %unsigned_quotient = scalar.divui %dividend, %divisor : i64
  %unsigned_remainder = scalar.remui %dividend, %divisor : i64
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

check.case @division_i64_case {
  %dividend = check.literal value(-17) : i64
  %divisor = check.literal value(5) : i64
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i64(%dividend, %divisor) : (i64, i64) -> (i64, i64, i64, i64)
  %expected_signed_quotient = check.literal value(-3) : i64
  %expected_signed_remainder = check.literal value(-2) : i64
  %expected_unsigned_quotient = check.literal value(3689348814741910319) : i64
  %expected_unsigned_remainder = check.literal value(4) : i64
  check.expect.equal actual(%signed_quotient) expected(%expected_signed_quotient) : i64
  check.expect.equal actual(%signed_remainder) expected(%expected_signed_remainder) : i64
  check.expect.equal actual(%unsigned_quotient) expected(%expected_unsigned_quotient) : i64
  check.expect.equal actual(%unsigned_remainder) expected(%expected_unsigned_remainder) : i64
  check.return
}

// Unlike signed quotient, signed minimum remainder by -1 is exactly zero.
func.def public @minimum_remainder_i64(%dividend: i64, %divisor: i64) -> (i64) {
  %remainder = scalar.remsi %dividend, %divisor : i64
  func.return %remainder : i64
}

check.case @minimum_remainder_i64_case {
  %minimum = check.literal value(-9223372036854775808) : i64
  %negative_one = check.literal value(-1) : i64
  %zero = check.literal value(0) : i64
  %remainder = func.call @minimum_remainder_i64(%minimum, %negative_one) : (i64, i64) -> (i64)
  check.expect.equal actual(%remainder) expected(%zero) : i64
  check.return
}
