// Calls keep operands dynamic through source combination and execute the
// resulting extrema at signed/unsigned boundaries and inclusive ties.
func.def @extrema(%lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  %slt = scalar.cmpi slt, %lhs, %rhs : i64
  %sle = scalar.cmpi sle, %lhs, %rhs : i64
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i64
  %uge = scalar.cmpi uge, %lhs, %rhs : i64
  %smin = scf.select %slt, %lhs, %rhs : i64
  %smax = scf.select %sle, %rhs, %lhs : i64
  %umin = scf.select %ugt, %rhs, %lhs : i64
  %umax = scf.select %uge, %lhs, %rhs : i64
  func.return %smin, %smax, %umin, %umax : i64, i64, i64, i64
}

// Signed i1 orders true below false, although Boolean facts store true as 1.
// A constant false operand must not make signed minimum fold to false.
func.def @boolean_extrema(%value: i1) -> (i1, i1, i1, i1) {
  %false = scalar.constant false : i1
  %slt = scalar.cmpi slt, %value, %false : i1
  %sgt = scalar.cmpi sgt, %value, %false : i1
  %ult = scalar.cmpi ult, %value, %false : i1
  %ugt = scalar.cmpi ugt, %value, %false : i1
  %smin = scf.select %slt, %value, %false : i1
  %smax = scf.select %sgt, %value, %false : i1
  %umin = scf.select %ult, %value, %false : i1
  %umax = scf.select %ugt, %value, %false : i1
  func.return %smin, %smax, %umin, %umax : i1, i1, i1, i1
}

check.case @sign_boundary {
  %lhs = check.literal value(-9223372036854775808) : i64
  %rhs = check.literal value(9223372036854775807) : i64
  %smin, %smax, %umin, %umax = func.call @extrema(%lhs, %rhs) : (i64, i64) -> (i64, i64, i64, i64)
  check.expect.equal actual(%smin) expected(%lhs) : i64
  check.expect.equal actual(%smax) expected(%rhs) : i64
  check.expect.equal actual(%umin) expected(%rhs) : i64
  check.expect.equal actual(%umax) expected(%lhs) : i64
  check.return
}

check.case @zero_and_all_ones {
  %lhs = check.literal value(0) : i64
  %rhs = check.literal value(-1) : i64
  %smin, %smax, %umin, %umax = func.call @extrema(%lhs, %rhs) : (i64, i64) -> (i64, i64, i64, i64)
  check.expect.equal actual(%smin) expected(%rhs) : i64
  check.expect.equal actual(%smax) expected(%lhs) : i64
  check.expect.equal actual(%umin) expected(%lhs) : i64
  check.expect.equal actual(%umax) expected(%rhs) : i64
  check.return
}

check.case @equal_sign_bits {
  %lhs = check.literal value(-9223372036854775808) : i64
  %rhs = check.literal value(-9223372036854775808) : i64
  %smin, %smax, %umin, %umax = func.call @extrema(%lhs, %rhs) : (i64, i64) -> (i64, i64, i64, i64)
  check.expect.equal actual(%smin) expected(%lhs) : i64
  check.expect.equal actual(%smax) expected(%lhs) : i64
  check.expect.equal actual(%umin) expected(%lhs) : i64
  check.expect.equal actual(%umax) expected(%lhs) : i64
  check.return
}

check.case @signed_boolean_order {
  %true = check.literal value(true) : i1
  %false = check.literal value(false) : i1
  %smin, %smax, %umin, %umax = func.call @boolean_extrema(%true) : (i1) -> (i1, i1, i1, i1)
  check.expect.equal actual(%smin) expected(%true) : i1
  check.expect.equal actual(%smax) expected(%false) : i1
  check.expect.equal actual(%umin) expected(%false) : i1
  check.expect.equal actual(%umax) expected(%true) : i1
  %equal_smin, %equal_smax, %equal_umin, %equal_umax = func.call @boolean_extrema(%false) : (i1) -> (i1, i1, i1, i1)
  check.expect.equal actual(%equal_smin) expected(%false) : i1
  check.expect.equal actual(%equal_smax) expected(%false) : i1
  check.expect.equal actual(%equal_umin) expected(%false) : i1
  check.expect.equal actual(%equal_umax) expected(%false) : i1
  check.return
}
