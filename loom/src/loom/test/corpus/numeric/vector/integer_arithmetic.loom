// Boundary-sized execution witnesses for the two composed SIMD128 arithmetic
// mechanisms. Each vector crosses one packet boundary and ends in a maximal
// partial packet; a trailing storage lane guards the partial access while
// scalar loops provide independent semantic oracles.

func.def @vector_i8_arithmetic(%lhs_input: buffer, %rhs_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_input[%base] : buffer -> view<32xi8>
  %rhs_view = buffer.view %rhs_input[%base] : buffer -> view<32xi8>
  %results = buffer.view %output[%base] : buffer -> view<32xi8>
  %lhs = vector.load %lhs_view[0] : view<32xi8> -> vector<31xi8>
  %rhs = vector.load %rhs_view[0] : view<32xi8> -> vector<31xi8>
  %product = vector.muli %lhs, %rhs : vector<31xi8>
  vector.store %product, %results[0] : vector<31xi8>, view<32xi8>
  func.return
}

func.def @vector_i8_arithmetic_oracle(%lhs_input: buffer, %rhs_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 31 : index
  %step = index.constant 1 : index
  %lhs_view = buffer.view %lhs_input[%base] : buffer -> view<32xi8>
  %rhs_view = buffer.view %rhs_input[%base] : buffer -> view<32xi8>
  %results = buffer.view %output[%base] : buffer -> view<32xi8>
  scf.for %i = [%begin to %end step %step] {
    %lhs = view.load %lhs_view[%i] : view<32xi8> -> i8
    %rhs = view.load %rhs_view[%i] : view<32xi8> -> i8
    %product = scalar.muli %lhs, %rhs : i8
    view.store %product, %results[%i] : i8, view<32xi8>
  }
  func.return
}

check.scenario @vector_i8_arithmetic_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(-128) step(85) period(4) : tensor<32xi8>
    %rhs = check.generate.iota offset(127) step(-85) period(4) : tensor<32xi8>
    %output = check.generate.fill value(91) : tensor<32xi8>
    check.compare<@vector_i8_arithmetic, @vector_i8_arithmetic_oracle>(%lhs, %rhs, %output) : (tensor<32xi8>, tensor<32xi8>, tensor<32xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xi8>
    }
  }
  check.return
}

func.def @vector_i64_arithmetic(%lhs_input: buffer, %rhs_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_input[%base] : buffer -> view<3xi64>
  %rhs_view = buffer.view %rhs_input[%base] : buffer -> view<3xi64>
  %results = buffer.view %output[%base] : buffer -> view<4x3xi64>
  %lhs = vector.load %lhs_view[0] : view<3xi64> -> vector<3xi64>
  %rhs = vector.load %rhs_view[0] : view<3xi64> -> vector<3xi64>
  %min_signed = vector.minsi %lhs, %rhs : vector<3xi64>
  %max_signed = vector.maxsi %lhs, %rhs : vector<3xi64>
  %min_unsigned = vector.minui %lhs, %rhs : vector<3xi64>
  %max_unsigned = vector.maxui %lhs, %rhs : vector<3xi64>
  vector.store %min_signed, %results[0, 0] : vector<3xi64>, view<4x3xi64>
  vector.store %max_signed, %results[1, 0] : vector<3xi64>, view<4x3xi64>
  vector.store %min_unsigned, %results[2, 0] : vector<3xi64>, view<4x3xi64>
  vector.store %max_unsigned, %results[3, 0] : vector<3xi64>, view<4x3xi64>
  func.return
}

func.def @vector_i64_arithmetic_oracle(%lhs_input: buffer, %rhs_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %lhs_view = buffer.view %lhs_input[%base] : buffer -> view<3xi64>
  %rhs_view = buffer.view %rhs_input[%base] : buffer -> view<3xi64>
  %results = buffer.view %output[%base] : buffer -> view<4x3xi64>
  scf.for %i = [%begin to %end step %step] {
    %lhs = view.load %lhs_view[%i] : view<3xi64> -> i64
    %rhs = view.load %rhs_view[%i] : view<3xi64> -> i64
    %min_signed = scalar.minsi %lhs, %rhs : i64
    %max_signed = scalar.maxsi %lhs, %rhs : i64
    %min_unsigned = scalar.minui %lhs, %rhs : i64
    %max_unsigned = scalar.maxui %lhs, %rhs : i64
    view.store %min_signed, %results[0, %i] : i64, view<4x3xi64>
    view.store %max_signed, %results[1, %i] : i64, view<4x3xi64>
    view.store %min_unsigned, %results[2, %i] : i64, view<4x3xi64>
    view.store %max_unsigned, %results[3, %i] : i64, view<4x3xi64>
  }
  func.return
}

check.scenario @vector_i64_arithmetic_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(-9223372036854775808) step(9223372036854775807) period(3) : tensor<3xi64>
    %rhs = check.generate.iota offset(9223372036854775807) step(-9223372036854775807) period(3) : tensor<3xi64>
    %output = check.generate.fill value(-81985529216486896) : tensor<12xi64>
    check.compare<@vector_i64_arithmetic, @vector_i64_arithmetic_oracle>(%lhs, %rhs, %output) : (tensor<3xi64>, tensor<3xi64>, tensor<12xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi64>
    }
  }
  check.return
}
