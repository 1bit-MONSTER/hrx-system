// Scalar inputs keep the vector recipes dynamic; scalar outputs let every
// function executor check the same lane semantics without a vector host ABI.
func.def public @vector_fields(%a: i32, %b: i32, %c: i32, %d: i32) -> (i32, i32, i32, i32) {
  %values = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  %low = vector.bitfield.extractu %values {offset = 0, width = 4} : vector<4xi32> -> vector<4xi32>
  %high = vector.bitfield.extractu %values {offset = 4, width = 2} : vector<4xi32> -> vector<4xi32>
  %merged = vector.bitfield.insert %high into %low {offset = 4, width = 2} : vector<4xi32>, vector<4xi32>
  %bias = vector.constant 32 : vector<4xi32>
  %result = vector.subi %merged, %bias : vector<4xi32>
  %length = index.constant 16 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%origin] : buffer -> view<4xi32>
  vector.store %result, %view[0] : vector<4xi32>, view<4xi32>
  %r0 = view.load %view[0] : view<4xi32> -> i32
  %r1 = view.load %view[1] : view<4xi32> -> i32
  %r2 = view.load %view[2] : view<4xi32> -> i32
  %r3 = view.load %view[3] : view<4xi32> -> i32
  func.return %r0, %r1, %r2, %r3 : i32, i32, i32, i32
}

check.case @vector_fields_case {
  %a = check.literal value(-1) : i32
  %b = check.literal value(-2147483648) : i32
  %c = check.literal value(32) : i32
  %d = check.literal value(85) : i32
  %r0, %r1, %r2, %r3 = func.call @vector_fields(%a, %b, %c, %d) : (i32, i32, i32, i32) -> (i32, i32, i32, i32)
  %e0 = check.literal value(31) : i32
  %e1 = check.literal value(-32) : i32
  %e2 = check.literal value(0) : i32
  %e3 = check.literal value(-11) : i32
  check.expect.equal actual(%r0) expected(%e0) : i32
  check.expect.equal actual(%r1) expected(%e1) : i32
  check.expect.equal actual(%r2) expected(%e2) : i32
  check.expect.equal actual(%r3) expected(%e3) : i32
  check.return
}

func.def public @vector_full_width_insert(%field: i32, %base: i32) -> (i32) {
  %fields = vector.splat %field : vector<1xi32>
  %bases = vector.splat %base : vector<1xi32>
  %merged = vector.bitfield.insert %fields into %bases {offset = 0, width = 32} : vector<1xi32>, vector<1xi32>
  %result = vector.extract %merged[0] : vector<1xi32> -> i32
  func.return %result : i32
}

check.case @vector_full_width_insert_case {
  %field = check.param.choice values([-2147483648, -1, 0, 2147483647]) : i32
  %base = check.param.choice values([-1, 0, 73]) : i32
  %result = func.call @vector_full_width_insert(%field, %base) : (i32, i32) -> (i32)
  check.expect.bitwise actual(%result) expected(%field) : i32
  check.return
}

func.def public @vector_signed_fields(%input: i32) -> (i32, i32) {
  %values = vector.splat %input : vector<1xi32>
  %high = vector.bitfield.extracts %values {offset = 28, width = 4} : vector<1xi32> -> vector<1xi32>
  %middle = vector.bitfield.extracts %values {offset = 4, width = 4} : vector<1xi32> -> vector<1xi32>
  %r0 = vector.extract %high[0] : vector<1xi32> -> i32
  %r1 = vector.extract %middle[0] : vector<1xi32> -> i32
  func.return %r0, %r1 : i32, i32
}

check.case @vector_signed_fields_case {
  %input = check.literal value(-2147483488) : i32
  %high, %middle = func.call @vector_signed_fields(%input) : (i32) -> (i32, i32)
  %expected_high = check.literal value(-8) : i32
  %expected_middle = check.literal value(-6) : i32
  check.expect.equal actual(%high) expected(%expected_high) : i32
  check.expect.equal actual(%middle) expected(%expected_middle) : i32
  check.return
}
