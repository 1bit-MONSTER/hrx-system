// Every subject exercises the complete vector floating extrema family over
// four independent lanes. Inputs arrive as raw bits so signed zeros,
// subnormals, infinities, and NaNs survive the callable boundary. Finite trials
// compare exact output bits; special-value trials permit unspecified NaN
// payloads while requiring the same lanes to remain NaNs. Float8 results widen
// exactly to F32 because close expectations do not consume Float8 buffers.

func.def @vector_float_extrema_f8e4m3(%value_buffer: buffer, %lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %value_bits_view = buffer.view %value_buffer[%base] : buffer -> view<4xi8>
  %lhs_bits_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xi8>
  %rhs_bits_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xi8>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<28xf32>
  %value_bits = vector.load %value_bits_view[0] : view<4xi8> -> vector<4xi8>
  %lhs_bits = vector.load %lhs_bits_view[0] : view<4xi8> -> vector<4xi8>
  %rhs_bits = vector.load %rhs_bits_view[0] : view<4xi8> -> vector<4xi8>
  %value = vector.bitcast %value_bits : vector<4xi8> to vector<4xf8E4M3>
  %lhs = vector.bitcast %lhs_bits : vector<4xi8> to vector<4xf8E4M3>
  %rhs = vector.bitcast %rhs_bits : vector<4xi8> to vector<4xf8E4M3>
  %minimum = vector.minimumf %lhs, %rhs : vector<4xf8E4M3>
  %minimum_output = vector.extf %minimum : vector<4xf8E4M3> to vector<4xf32>
  vector.store %minimum_output, %output_view[0] : vector<4xf32>, view<28xf32>
  %maximum = vector.maximumf %lhs, %rhs : vector<4xf8E4M3>
  %maximum_output = vector.extf %maximum : vector<4xf8E4M3> to vector<4xf32>
  vector.store %maximum_output, %output_view[4] : vector<4xf32>, view<28xf32>
  %minnum = vector.minnumf %lhs, %rhs : vector<4xf8E4M3>
  %minnum_output = vector.extf %minnum : vector<4xf8E4M3> to vector<4xf32>
  vector.store %minnum_output, %output_view[8] : vector<4xf32>, view<28xf32>
  %maxnum = vector.maxnumf %lhs, %rhs : vector<4xf8E4M3>
  %maxnum_output = vector.extf %maxnum : vector<4xf8E4M3> to vector<4xf32>
  vector.store %maxnum_output, %output_view[12] : vector<4xf32>, view<28xf32>
  %ordered = vector.clampf<ordered> %value, %lhs, %rhs : vector<4xf8E4M3>
  %ordered_output = vector.extf %ordered : vector<4xf8E4M3> to vector<4xf32>
  vector.store %ordered_output, %output_view[16] : vector<4xf32>, view<28xf32>
  %number = vector.clampf<number> %value, %lhs, %rhs : vector<4xf8E4M3>
  %number_output = vector.extf %number : vector<4xf8E4M3> to vector<4xf32>
  vector.store %number_output, %output_view[20] : vector<4xf32>, view<28xf32>
  %ieee = vector.clampf<ieee> %value, %lhs, %rhs : vector<4xf8E4M3>
  %ieee_output = vector.extf %ieee : vector<4xf8E4M3> to vector<4xf32>
  vector.store %ieee_output, %output_view[24] : vector<4xf32>, view<28xf32>
  func.return
}

