check.scenario @vector_float_extrema_f8e4m3_values {
  // Opposing signed-zero operands exercise IEEE extrema ordering while the
  // alternating value tests ordered clamp's compare/select tie behavior.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(0) step(-128) period(2) : tensor<4xi8>
    %lhs = check.generate.iota offset(0) step(-128) period(2) : tensor<4xi8>
    %rhs = check.generate.fill value(-128) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%value, %lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xf32>
    }
  }
  // The representational special boundary covers maximum finite values,
  // infinities where present, signaling NaNs, and quiet NaNs.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(124) step(1) : tensor<4xi8>
    %lhs = check.generate.iota offset(124) step(1) : tensor<4xi8>
    %rhs = check.generate.iota offset(127) step(-1) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%value, %lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xf32>
    }
  }
  check.return
}

