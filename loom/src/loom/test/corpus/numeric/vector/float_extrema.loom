    check.compare<@vector_float_extrema_f32>(%value, %lhs, %rhs, %output) : (tensor<4xi32>, tensor<4xi32>, tensor<4xi32>, tensor<28xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xf32>
    }
  }
  check.return
}

check.scenario @vector_float_extrema_f64_values {
  // Opposing signed-zero operands exercise IEEE extrema ordering while the
  // alternating value tests ordered clamp's compare/select tie behavior.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(0) step(-9223372036854775808) period(2) : tensor<4xi64>
    %lhs = check.generate.iota offset(0) step(-9223372036854775808) period(2) : tensor<4xi64>
    %rhs = check.generate.fill value(-9223372036854775808) : tensor<4xi64>
    %output = check.generate.fill value(0.0) : tensor<28xf64>
    check.compare<@vector_float_extrema_f64>(%value, %lhs, %rhs, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<4xi64>, tensor<28xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xf64>
    }
  }
  // The representational special boundary covers maximum finite values,
  // infinities where present, signaling NaNs, and quiet NaNs.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(9218868437227405312) step(1) : tensor<4xi64>
    %lhs = check.generate.iota offset(9218868437227405311) step(1) : tensor<4xi64>
    %rhs = check.generate.iota offset(9221120237041090560) step(1) : tensor<4xi64>
    %output = check.generate.fill value(0.0) : tensor<28xf64>
    check.compare<@vector_float_extrema_f64>(%value, %lhs, %rhs, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<4xi64>, tensor<28xf64>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xf64>
    }
  }
  check.return
}
