// Constructed lanes remain dynamic across the compiled function boundary.
func.def public @lookup_lanes(%a: i32, %b: i32, %c: i32, %i: i32, %j: i32) -> (i32, i32, i32) {
  %table = vector.from_elements %a, %b, %c : vector<3xi32>
  %indices = vector.from_elements %i, %j, %i : vector<3xi32>
  %values = vector.table.lookup %table[%indices] : vector<3xi32>, vector<3xi32> -> vector<3xi32>
  %x = vector.extract %values[0] : vector<3xi32> -> i32
  %y = vector.extract %values[1] : vector<3xi32> -> i32
  %z = vector.extract %values[2] : vector<3xi32> -> i32
  func.return %x, %y, %z : i32, i32, i32
}

check.case @lookup_forward {
  %a = check.param.choice values([-2147483648, -1, 0, 2147483647]) : i32
  %b = check.literal value(73) : i32
  %c = check.literal value(-8) : i32
  %i = check.literal value(0) : i32
  %j = check.literal value(1) : i32
  %x, %y, %z = func.call @lookup_lanes(%a, %b, %c, %i, %j) : (i32, i32, i32, i32, i32) -> (i32, i32, i32)
  check.expect.equal actual(%x) expected(%a) : i32
  check.expect.equal actual(%y) expected(%b) : i32
  check.expect.equal actual(%z) expected(%a) : i32
  check.return
}

check.case @lookup_reverse {
  %a = check.literal value(73) : i32
  %b = check.literal value(-8) : i32
  %c = check.param.choice values([-2147483648, -1, 0, 2147483647]) : i32
  %i = check.literal value(2) : i32
  %j = check.literal value(0) : i32
  %x, %y, %z = func.call @lookup_lanes(%a, %b, %c, %i, %j) : (i32, i32, i32, i32, i32) -> (i32, i32, i32)
  check.expect.equal actual(%x) expected(%c) : i32
  check.expect.equal actual(%y) expected(%a) : i32
  check.expect.equal actual(%z) expected(%c) : i32
  check.return
}

// Both indices contribute to the row-major lane ordinal.
func.def public @extract_matrix(%a: i32, %b: i32, %c: i32, %d: i32, %row: index, %column: index) -> (i32) {
  %matrix = vector.from_elements %a, %b, %c, %d : vector<2x2xi32>
  %result = vector.extract %matrix[%row, %column] : vector<2x2xi32> -> i32
  func.return %result : i32
}

check.case @extract_each_matrix_coordinate {
  %a = check.param.choice values([-2147483648, -1, 0, 2147483647]) : i32
  %b = check.literal value(73) : i32
  %c = check.literal value(-8) : i32
  %d = check.literal value(19) : i32
  %zero = check.literal value(0) : index
  %one = check.literal value(1) : index
  %r00 = func.call @extract_matrix(%a, %b, %c, %d, %zero, %zero) : (i32, i32, i32, i32, index, index) -> (i32)
  %r01 = func.call @extract_matrix(%a, %b, %c, %d, %zero, %one) : (i32, i32, i32, i32, index, index) -> (i32)
  %r10 = func.call @extract_matrix(%a, %b, %c, %d, %one, %zero) : (i32, i32, i32, i32, index, index) -> (i32)
  %r11 = func.call @extract_matrix(%a, %b, %c, %d, %one, %one) : (i32, i32, i32, i32, index, index) -> (i32)
  check.expect.equal actual(%r00) expected(%a) : i32
  check.expect.equal actual(%r01) expected(%b) : i32
  check.expect.equal actual(%r10) expected(%c) : i32
  check.expect.equal actual(%r11) expected(%d) : i32
  check.return
}

// Selection preserves signed zero, subnormals and NaN payloads without doing
// floating-point arithmetic. Each lookup permutes all three lane positions.
func.def public @permute_float_bits(%a: i32, %b: i32, %c: i32, %first: i32, %second: i32, %third: i32) -> (i32, i32, i32) {
  %fa = scalar.bitcast %a : i32 to f32
  %fb = scalar.bitcast %b : i32 to f32
  %fc = scalar.bitcast %c : i32 to f32
  %table = vector.from_elements %fa, %fb, %fc : vector<3xf32>
  %indices = vector.from_elements %first, %second, %third : vector<3xi32>
  %values = vector.table.lookup %table[%indices] : vector<3xf32>, vector<3xi32> -> vector<3xf32>
  %x = vector.extract %values[0] : vector<3xf32> -> f32
  %y = vector.extract %values[1] : vector<3xf32> -> f32
  %z = vector.extract %values[2] : vector<3xf32> -> f32
  %xb = scalar.bitcast %x : f32 to i32
  %yb = scalar.bitcast %y : f32 to i32
  %zb = scalar.bitcast %z : f32 to i32
  func.return %xb, %yb, %zb : i32, i32, i32
}

check.case @permute_float_payloads {
  %a = check.param.choice values([0, -2147483648, 1, -2147483647, 2139095041, 2143289345, -4194303]) : i32
  %b = check.literal value(1065353216) : i32
  %c = check.literal value(-1073741824) : i32
  %first = check.literal value(2) : i32
  %second = check.literal value(0) : i32
  %third = check.literal value(1) : i32
  %x, %y, %z = func.call @permute_float_bits(%a, %b, %c, %first, %second, %third) : (i32, i32, i32, i32, i32, i32) -> (i32, i32, i32)
  check.expect.equal actual(%x) expected(%c) : i32
  check.expect.equal actual(%y) expected(%a) : i32
  check.expect.equal actual(%z) expected(%b) : i32
  check.return
}

func.def public @extract_singleton(%value: i64, %index: index) -> (i64) {
  %vector = vector.from_elements %value : vector<1xi64>
  %result = vector.extract %vector[%index] : vector<1xi64> -> i64
  func.return %result : i64
}

check.case @extract_singleton_bits {
  %value = check.param.choice values([-9223372036854775808, -1, 0, 9223372036854775807]) : i64
  %index = check.literal value(0) : index
  %result = func.call @extract_singleton(%value, %index) : (i64, index) -> (i64)
  check.expect.equal actual(%result) expected(%value) : i64
  check.return
}
