// The boundary widths exercise the two-word i8 active-lane predicate, a
// partial i32 tree, and multi-carrier i16 and i64 reductions. The i64 path
// additionally exercises packed lexicographic word pairs. Every input contains
// -1 and 0 while the authored initial value is 1, making signed maximum and
// unsigned ordering independently observable.

func.def @integer_extrema_reductions_i8x33(%storage_buffer: buffer) {
  %output_origin = index.constant 0 : offset
  %output_view = buffer.view %storage_buffer[%output_origin] : buffer -> view<4xi8>
  %negative = scalar.constant -1 : i8
  %c0 = scalar.constant 0 : i8
  %negative_values = vector.splat %negative : vector<33xi8>
  %input = vector.insert %c0 into %negative_values[0] : i8, vector<33xi8>
  %initial = scalar.constant 1 : i8
  %signed_minimum = vector.reduce<minsi> %input, %initial : vector<33xi8>, i8
  view.store %signed_minimum, %output_view[0] : i8, view<4xi8>
  %signed_maximum = vector.reduce<maxsi> %input, %initial : vector<33xi8>, i8
  view.store %signed_maximum, %output_view[1] : i8, view<4xi8>
  %unsigned_maximum = vector.reduce<maxui> %input, %initial : vector<33xi8>, i8
  view.store %unsigned_maximum, %output_view[2] : i8, view<4xi8>
  %unsigned_minimum = vector.reduce<minui> %input, %initial : vector<33xi8>, i8
  view.store %unsigned_minimum, %output_view[3] : i8, view<4xi8>
  func.return
}

func.def @integer_extrema_reductions_i16x33(%storage_buffer: buffer) {
  %output_origin = index.constant 0 : offset
  %output_view = buffer.view %storage_buffer[%output_origin] : buffer -> view<4xi16>
  %negative = scalar.constant -1 : i16
  %c0 = scalar.constant 0 : i16
  %negative_values = vector.splat %negative : vector<33xi16>
  %input = vector.insert %c0 into %negative_values[0] : i16, vector<33xi16>
  %initial = scalar.constant 1 : i16
  %signed_minimum = vector.reduce<minsi> %input, %initial : vector<33xi16>, i16
  view.store %signed_minimum, %output_view[0] : i16, view<4xi16>
  %signed_maximum = vector.reduce<maxsi> %input, %initial : vector<33xi16>, i16
  view.store %signed_maximum, %output_view[1] : i16, view<4xi16>
  %unsigned_maximum = vector.reduce<maxui> %input, %initial : vector<33xi16>, i16
  view.store %unsigned_maximum, %output_view[2] : i16, view<4xi16>
  %unsigned_minimum = vector.reduce<minui> %input, %initial : vector<33xi16>, i16
  view.store %unsigned_minimum, %output_view[3] : i16, view<4xi16>
  func.return
}

