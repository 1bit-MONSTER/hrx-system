// Narrow lanes widen with independent signed and unsigned interpretations.
// Minimum, maximum and zero-crossing inputs exercise both words of each i64
// result and neighboring packed lanes. Each vector result occupies 32 words.

kernel.def @vector_widen_i8() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %signed_base = index.constant 128 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi8>
  %unsigned_view = buffer.view %output[%base] : buffer -> view<16xi64>
  %signed_view = buffer.view %output[%signed_base] : buffer -> view<16xi64>
  %packed = vector.load %input_view[0] : view<16xi8> -> vector<16xi8>
  %unsigned = vector.extui %packed : vector<16xi8> to vector<16xi64>
  vector.store %unsigned, %unsigned_view[0] : vector<16xi64>, view<16xi64>
  %signed = vector.extsi %packed : vector<16xi8> to vector<16xi64>
  vector.store %signed, %signed_view[0] : vector<16xi64>, view<16xi64>
  kernel.return
}

check.case public @vector_i8_widen_minimum {
  %input = check.generate.iota offset(-128) step(1) : tensor<16xi8>
  %storage = check.generate.fill value(-123) : tensor<40xi64>
  %output = check.tensor.view %storage offset(32) : tensor<40xi64> -> tensor<32xi64>
  kernel.launch @vector_widen_i8(%input, %output) : (tensor<16xi8>, tensor<32xi64>)
  %unsigned_head = check.tensor.view %output offset(0) : tensor<32xi64> -> tensor<7xi64>
  %unsigned_tail = check.tensor.view %output offset(56) : tensor<32xi64> -> tensor<9xi64>
  %signed_head = check.tensor.view %output offset(128) : tensor<32xi64> -> tensor<7xi64>
  %signed_tail = check.tensor.view %output offset(184) : tensor<32xi64> -> tensor<9xi64>
  %expected_unsigned_head = check.generate.iota offset(128) step(1) : tensor<7xi64>
  %expected_unsigned_tail = check.generate.iota offset(135) step(1) : tensor<9xi64>
  %expected_signed_head = check.generate.iota offset(-128) step(1) : tensor<7xi64>
  %expected_signed_tail = check.generate.iota offset(-121) step(1) : tensor<9xi64>
  check.expect.bitwise actual(%unsigned_head) expected(%expected_unsigned_head) : tensor<7xi64>
  check.expect.bitwise actual(%unsigned_tail) expected(%expected_unsigned_tail) : tensor<9xi64>
  check.expect.bitwise actual(%signed_head) expected(%expected_signed_head) : tensor<7xi64>
  check.expect.bitwise actual(%signed_tail) expected(%expected_signed_tail) : tensor<9xi64>
  %prefix = check.tensor.view %storage offset(0) : tensor<40xi64> -> tensor<4xi64>
  %suffix = check.tensor.view %storage offset(288) : tensor<40xi64> -> tensor<4xi64>
  %guard = check.generate.fill value(-123) : tensor<4xi64>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi64>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi64>
  check.return
}

