  %unsigned_32 = scalar.extui %next : i8 to i16
  %signed_0 = scalar.extsi %value : i8 to i16
  %signed_32 = scalar.extsi %next : i8 to i16
  view.store %unsigned_0, %output_view[0] : i16, view<4xi16>
