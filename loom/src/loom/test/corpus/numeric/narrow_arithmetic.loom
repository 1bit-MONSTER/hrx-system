// The f64 path is an independent wider reference for binary narrow arithmetic.
// Products are exact in f64. Sums either fit exactly or discard bits too small
// to affect rounding to these source formats. All matrix inputs are finite.
func.def public @arithmetic_f16(%lhs_bits: i16, %rhs_bits: i16) -> (f16, f16, f16, f16) {
  %lhs = scalar.bitcast %lhs_bits : i16 to f16
  %rhs = scalar.bitcast %rhs_bits : i16 to f16
  %sum = scalar.addf %lhs, %rhs : f16
  %product = scalar.mulf %lhs, %rhs : f16
  %wide_lhs = scalar.extf %lhs : f16 to f64
  %wide_rhs = scalar.extf %rhs : f16 to f64
  %wide_sum = scalar.addf %wide_lhs, %wide_rhs : f64
  %wide_product = scalar.mulf %wide_lhs, %wide_rhs : f64
  %reference_sum = scalar.fptrunc %wide_sum : f64 to f16
  %reference_product = scalar.fptrunc %wide_product : f64 to f16
  func.return %sum, %product, %reference_sum, %reference_product : f16, f16, f16, f16
}

// Signed zeros, subnormal/normal boundaries, half-ULPs near one, and finite
// extrema exercise cancellation, ties, gradual underflow, and overflow.
check.case @arithmetic_f16_boundaries {
  %lhs = check.param.choice values([0, 1, 2, 1023, 1024, 1025, 4096, 14336, 15360, 15361, 16383, 16384, 16896, 31743, -32768, -32767, -31745, -31744, -17408, -17407, -1025]) : i16
  %rhs = check.param.choice values([0, 1, 2, 1023, 1024, 1025, 4096, 14336, 15360, 15361, 16383, 16384, 16896, 31743, -32768, -32767, -31745, -31744, -17408, -17407, -1025]) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_f16(%lhs, %rhs) : (i16, i16) -> (f16, f16, f16, f16)
  check.expect.bitwise actual(%sum) expected(%reference_sum) : f16
  check.expect.bitwise actual(%product) expected(%reference_product) : f16
  check.return
}

check.case @arithmetic_f16_infinities {
  %lhs = check.param.choice values([31744, -1024]) : i16
  %rhs = check.literal value(15360) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_f16(%lhs, %rhs) : (i16, i16) -> (f16, f16, f16, f16)
  check.expect.bitwise actual(%sum) expected(%reference_sum) : f16
  check.expect.bitwise actual(%product) expected(%reference_product) : f16
  check.return
}

// Arithmetic NaNs have no exact payload contract; both signs and signaling
// payloads must remain NaNs after extension, arithmetic, and narrowing.
check.case @arithmetic_f16_nans {
  %lhs = check.param.choice values([31745, 32256, -1023, -512]) : i16
  %rhs = check.literal value(15360) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_f16(%lhs, %rhs) : (i16, i16) -> (f16, f16, f16, f16)
  %expected = check.literal value(nan) : f16
  check.expect.close actual(%sum) expected(%expected) atol(0.0) rtol(0.0) nan(same) : f16
  check.expect.close actual(%product) expected(%expected) atol(0.0) rtol(0.0) nan(same) : f16
  check.return
}

check.case @arithmetic_f16_halfway {
  %lhs = check.literal value(15361) : i16
  %rhs = check.literal value(4096) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_f16(%lhs, %rhs) : (i16, i16) -> (f16, f16, f16, f16)
  %expected_sum = check.literal value(1.001953125) : f16
  check.expect.bitwise actual(%sum) expected(%expected_sum) : f16
  check.expect.bitwise actual(%reference_sum) expected(%expected_sum) : f16
  check.return
}

func.def public @arithmetic_bf16(%lhs_bits: i16, %rhs_bits: i16) -> (bf16, bf16, bf16, bf16) {
  %lhs = scalar.bitcast %lhs_bits : i16 to bf16
  %rhs = scalar.bitcast %rhs_bits : i16 to bf16
  %sum = scalar.addf %lhs, %rhs : bf16
  %product = scalar.mulf %lhs, %rhs : bf16
  %wide_lhs = scalar.extf %lhs : bf16 to f64
  %wide_rhs = scalar.extf %rhs : bf16 to f64
  %wide_sum = scalar.addf %wide_lhs, %wide_rhs : f64
  %wide_product = scalar.mulf %wide_lhs, %wide_rhs : f64
  %reference_sum = scalar.fptrunc %wide_sum : f64 to bf16
  %reference_product = scalar.fptrunc %wide_product : f64 to bf16
  func.return %sum, %product, %reference_sum, %reference_product : bf16, bf16, bf16, bf16
}

check.case @arithmetic_bf16_boundaries {
  %lhs = check.param.choice values([0, 1, 2, 127, 128, 129, 256, 15232, 16128, 16256, 16257, 16383, 16384, 16448, 32639, -32768, -32767, -32641, -32640, -16512, -16511, -129]) : i16
  %rhs = check.param.choice values([0, 1, 2, 127, 128, 129, 256, 15232, 16128, 16256, 16257, 16383, 16384, 16448, 32639, -32768, -32767, -32641, -32640, -16512, -16511, -129]) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_bf16(%lhs, %rhs) : (i16, i16) -> (bf16, bf16, bf16, bf16)
  check.expect.bitwise actual(%sum) expected(%reference_sum) : bf16
  check.expect.bitwise actual(%product) expected(%reference_product) : bf16
  check.return
}

check.case @arithmetic_bf16_infinities {
  %lhs = check.param.choice values([32640, -128]) : i16
  %rhs = check.literal value(16256) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_bf16(%lhs, %rhs) : (i16, i16) -> (bf16, bf16, bf16, bf16)
  check.expect.bitwise actual(%sum) expected(%reference_sum) : bf16
  check.expect.bitwise actual(%product) expected(%reference_product) : bf16
  check.return
}

check.case @arithmetic_bf16_nans {
  %lhs = check.param.choice values([32641, 32704, -127, -64]) : i16
  %rhs = check.literal value(16256) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_bf16(%lhs, %rhs) : (i16, i16) -> (bf16, bf16, bf16, bf16)
  %expected = check.literal value(nan) : bf16
  check.expect.close actual(%sum) expected(%expected) atol(0.0) rtol(0.0) nan(same) : bf16
  check.expect.close actual(%product) expected(%expected) atol(0.0) rtol(0.0) nan(same) : bf16
  check.return
}

check.case @arithmetic_bf16_halfway {
  %lhs = check.literal value(16257) : i16
  %rhs = check.literal value(15232) : i16
  %sum, %product, %reference_sum, %reference_product = func.call @arithmetic_bf16(%lhs, %rhs) : (i16, i16) -> (bf16, bf16, bf16, bf16)
  %expected_sum = check.literal value(1.015625) : bf16
  check.expect.bitwise actual(%sum) expected(%expected_sum) : bf16
  check.expect.bitwise actual(%reference_sum) expected(%expected_sum) : bf16
  check.return
}
