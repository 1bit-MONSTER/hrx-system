// A scalar condition chooses an entire vector, preserving every lane's bits.
// Scalar inputs/results isolate selection from aggregate callable lowering.
func.def public @whole_vector_select(%condition: i1, %a: i32, %b: i32) -> (i32, i32) {
  %af = scalar.bitcast %a : i32 to f32
  %bf = scalar.bitcast %b : i32 to f32
  %true_value = vector.from_elements %af, %bf, %bf, %af : vector<2x2xf32>
  %false_value = vector.from_elements %bf, %af, %af, %bf : vector<2x2xf32>
  %selected = scf.select %condition, %true_value, %false_value : vector<2x2xf32>
  %first = vector.extract %selected[0, 0] : vector<2x2xf32> -> f32
  %second = vector.extract %selected[1, 0] : vector<2x2xf32> -> f32
  %first_bits = scalar.bitcast %first : f32 to i32
  %second_bits = scalar.bitcast %second : f32 to i32
  func.return %first_bits, %second_bits : i32, i32
}

check.case @whole_vector_select_true {
  %condition = check.literal value(true) : i1
  %a = check.param.choice values([-2147483648, 2143289345, 1]) : i32
  %b = check.param.choice values([0, -4194303]) : i32
  %first, %second = func.call @whole_vector_select(%condition, %a, %b) : (i1, i32, i32) -> (i32, i32)
  check.expect.bitwise actual(%first) expected(%a) : i32
  check.expect.bitwise actual(%second) expected(%b) : i32
  check.return
}

check.case @whole_vector_select_false {
  %condition = check.literal value(false) : i1
  %a = check.param.choice values([-2147483648, 2143289345, 1]) : i32
  %b = check.param.choice values([0, -4194303]) : i32
  %first, %second = func.call @whole_vector_select(%condition, %a, %b) : (i1, i32, i32) -> (i32, i32)
  check.expect.bitwise actual(%first) expected(%b) : i32
  check.expect.bitwise actual(%second) expected(%a) : i32
  check.return
}

// Yield-only branches canonicalize into the same whole-value selection.
func.def public @whole_vector_if(%condition: i1, %a: i64, %b: i64) -> (i64, i64) {
  %true_value = vector.from_elements %a, %b : vector<2xi64>
  %false_value = vector.from_elements %b, %a : vector<2xi64>
  %selected = scf.if %condition -> (vector<2xi64>) {
    scf.yield %true_value : vector<2xi64>
  } else {
    scf.yield %false_value : vector<2xi64>
  }
  %first = vector.extract %selected[0] : vector<2xi64> -> i64
  %second = vector.extract %selected[1] : vector<2xi64> -> i64
  func.return %first, %second : i64, i64
}

check.case @whole_vector_if_true {
  %condition = check.literal value(true) : i1
  %a = check.param.choice values([-9223372036854775808, 4294967296]) : i64
  %b = check.param.choice values([-1, 0, 9223372036854775807]) : i64
  %first, %second = func.call @whole_vector_if(%condition, %a, %b) : (i1, i64, i64) -> (i64, i64)
  check.expect.equal actual(%first) expected(%a) : i64
  check.expect.equal actual(%second) expected(%b) : i64
  check.return
}

check.case @whole_vector_if_false {
  %condition = check.literal value(false) : i1
  %a = check.param.choice values([-9223372036854775808, 4294967296]) : i64
  %b = check.param.choice values([-1, 0, 9223372036854775807]) : i64
  %first, %second = func.call @whole_vector_if(%condition, %a, %b) : (i1, i64, i64) -> (i64, i64)
  check.expect.equal actual(%first) expected(%b) : i64
  check.expect.equal actual(%second) expected(%a) : i64
  check.return
}
