func.def @predicate_extension_narrow_observations(%trial: index, %byte_output: buffer, %half_output: buffer) {
  %c0 = scalar.constant 0 : i32
  %base = index.constant 0 : offset
  %byte_results = buffer.view %byte_output[%base] : buffer -> view<2xi8>
  %half_results = buffer.view %half_output[%base] : buffer -> view<2xi16>
  %value = index.cast %trial : index to i32
  %condition = scalar.cmpi ne, %value, %c0 : i32
  %signed8 = scalar.extsi %condition : i1 to i8
  %unsigned8 = scalar.extui %condition : i1 to i8
  %signed16 = scalar.extsi %condition : i1 to i16
  %unsigned16 = scalar.extui %condition : i1 to i16
  view.store %signed8, %byte_results[0] : i8, view<2xi8>
  view.store %unsigned8, %byte_results[1] : i8, view<2xi8>
  view.store %signed16, %half_results[0] : i16, view<2xi16>
  view.store %unsigned16, %half_results[1] : i16, view<2xi16>
  func.return
}

check.scenario @predicate_extension_narrow_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %byte_output = check.generate.fill value(0) : tensor<2xi8>
    %half_output = check.generate.fill value(0) : tensor<2xi16>
    check.compare<@predicate_extension_narrow_observations>(%trial, %byte_output, %half_output) : (index, tensor<2xi8>, tensor<2xi16>) -> () {
      check.expect.bitwise actual(%byte_output) expected(%byte_output) : tensor<2xi8>
      check.expect.bitwise actual(%half_output) expected(%half_output) : tensor<2xi16>
    }
  }
  check.return
}

func.def @predicate_extension_wide_observations(%trial: index, %word_output: buffer, %wide_output: buffer) {
  %c0 = scalar.constant 0 : i32
  %base = index.constant 0 : offset
  %word_results = buffer.view %word_output[%base] : buffer -> view<2xi32>
  %wide_results = buffer.view %wide_output[%base] : buffer -> view<2xi64>
  %value = index.cast %trial : index to i32
  %condition = scalar.cmpi ne, %value, %c0 : i32
  %signed32 = scalar.extsi %condition : i1 to i32
  %unsigned32 = scalar.extui %condition : i1 to i32
  %signed64 = scalar.extsi %condition : i1 to i64
  %unsigned64 = scalar.extui %condition : i1 to i64
  view.store %signed32, %word_results[0] : i32, view<2xi32>
  view.store %unsigned32, %word_results[1] : i32, view<2xi32>
  view.store %signed64, %wide_results[0] : i64, view<2xi64>
  view.store %unsigned64, %wide_results[1] : i64, view<2xi64>
  func.return
}

check.scenario @predicate_extension_wide_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %word_output = check.generate.fill value(0) : tensor<2xi32>
    %wide_output = check.generate.fill value(0) : tensor<2xi64>
    check.compare<@predicate_extension_wide_observations>(%trial, %word_output, %wide_output) : (index, tensor<2xi32>, tensor<2xi64>) -> () {
      check.expect.bitwise actual(%word_output) expected(%word_output) : tensor<2xi32>
      check.expect.bitwise actual(%wide_output) expected(%wide_output) : tensor<2xi64>
    }
  }
  check.return
}
