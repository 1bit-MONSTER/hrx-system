func.def @sum_capped_and_edges(%a: i32, %b: i32, %c: i32, %d: i32, %limit: i32) -> (i32, i32, i32) {
  %initial = vector.splat %a : vector<4xi32>
  %with_b = vector.insert %b into %initial[1] : i32, vector<4xi32>
  %with_c = vector.insert %c into %with_b[2] : i32, vector<4xi32>
  %input = vector.insert %d into %with_c[3] : i32, vector<4xi32>
  %initial_sum = scalar.constant 0 : i32
  %limits = vector.splat %limit : vector<4xi32>
  %below_limit = vector.cmpi slt, %input, %limits : vector<4xi32> -> vector<4xi1>
  %capped = vector.select %below_limit, %input, %limits : vector<4xi32>
  %sum = vector.reduce<addi> %capped, %initial_sum : vector<4xi32>, i32
  %first = vector.extract %below_limit[0] : vector<4xi1> -> i1
  %last = vector.extract %below_limit[3] : vector<4xi1> -> i1
  %first_integer = scalar.extui %first : i1 to i32
  %last_integer = scalar.extui %last : i1 to i32
  func.return %sum, %first_integer, %last_integer : i32, i32, i32
}

// Three value families place every predicate mask around limits -1, 0, and 1.
func.def @predicate_lane_observations(%ordinal: index, %output: buffer) {
  %c0_index = index.constant 0 : index
  %c2_index = index.constant 2 : index
  %c16_index = index.constant 16 : index
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 47)] : index
  %mask = index.rem %bounded_ordinal, %c16_index : index
  %family = index.div %bounded_ordinal, %c16_index : index
  %family0 = index.cmp eq, %family, %c0_index : index
  %family2 = index.cmp eq, %family, %c2_index : index

  %minimum = scalar.constant -2147483648 : i32
  %cneg1 = scalar.constant -1 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %maximum = scalar.constant 2147483647 : i32
  %limit_positive = scf.select %family2, %c1, %c0 : i32
  %limit = scf.select %family0, %cneg1, %limit_positive : i32
  %below_positive = scf.select %family2, %c0, %cneg1 : i32
  %below = scf.select %family0, %minimum, %below_positive : i32
  %above = scf.select %family0, %maximum, %limit_positive : i32

  %mask_word = index.cast %mask : index to i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %lane0_bit = scalar.andi %mask_word, %c1 : i32
  %lane1_shifted = scalar.shrui %mask_word, %c1 : i32
  %lane1_bit = scalar.andi %lane1_shifted, %c1 : i32
  %lane2_shifted = scalar.shrui %mask_word, %c2 : i32
  %lane2_bit = scalar.andi %lane2_shifted, %c1 : i32
  %lane3_shifted = scalar.shrui %mask_word, %c3 : i32
  %lane3_bit = scalar.andi %lane3_shifted, %c1 : i32
  %lane0_below = scalar.cmpi ne, %lane0_bit, %c0 : i32
  %lane1_below = scalar.cmpi ne, %lane1_bit, %c0 : i32
  %lane2_below = scalar.cmpi ne, %lane2_bit, %c0 : i32
  %lane3_below = scalar.cmpi ne, %lane3_bit, %c0 : i32
  %a = scf.select %lane0_below, %below, %above : i32
  %b = scf.select %lane1_below, %below, %above : i32
  %c = scf.select %lane2_below, %below, %above : i32
  %d = scf.select %lane3_below, %below, %above : i32
  %sum, %first, %last = func.call @sum_capped_and_edges(%a, %b, %c, %d, %limit) : (i32, i32, i32, i32, i32) -> (i32, i32, i32)

  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<3xi32>
  view.store %sum, %results[0] : i32, view<3xi32>
  view.store %first, %results[1] : i32, view<3xi32>
  view.store %last, %results[2] : i32, view<3xi32>
  func.return
}

check.scenario @predicate_lane_values {
  check.trial[48](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-123) : tensor<3xi32>
    check.compare<@predicate_lane_observations>(%trial, %output) : (index, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi32>
    }
  }
  check.return
}
