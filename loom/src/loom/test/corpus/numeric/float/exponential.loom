// Exercises approximate exponential operations across directed IEEE-754
// boundaries and deterministic full-width entropy. Exact power-of-two cases
// separately preserve normal, subnormal, overflow, and underflow result bits.

func.def @exponential_observations(%bits: i32, %output: buffer) {
  %input = scalar.bitcast %bits : i32 to f32
  %base_two = scalar.exp2f<afn> %input : f32
  %natural = scalar.expf<afn> %input : f32
  %results = vector.from_elements %base_two, %natural : vector<2xf32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xf32>
  vector.store %results, %result_view[0] : vector<2xf32>, view<2xf32>
  func.return
}

func.def @exponential_entropy_observations(%entropy_bits: i64, %output: buffer) {
  %bits = scalar.trunci %entropy_bits : i64 to i32
  func.call @exponential_observations(%bits, %output) : (i32, buffer)
  func.return
}

func.def @exponential_boundary_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index
  %is10 = index.cmp eq, %ordinal, %c10 : index
  %value0 = scalar.constant 1065353216 : i32
  %value1 = scalar.constant -1082130432 : i32
  %value2 = scalar.constant 0 : i32
  %value3 = scalar.constant -2147483648 : i32
  %value4 = scalar.constant -1028390912 : i32
  %value5 = scalar.constant -1090519040 : i32
  %value6 = scalar.constant 1117782016 : i32
  %value7 = scalar.constant 2139095040 : i32
  %value8 = scalar.constant -8388608 : i32
  %value9 = scalar.constant 2143289344 : i32
  %value10 = scalar.constant -4194304 : i32
  %value11 = scalar.constant 2139095041 : i32
  %bits0 = scf.select %is0, %value0, %value11 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %bits3 = scf.select %is3, %value3, %bits2 : i32
  %bits4 = scf.select %is4, %value4, %bits3 : i32
  %bits5 = scf.select %is5, %value5, %bits4 : i32
  %bits6 = scf.select %is6, %value6, %bits5 : i32
  %bits7 = scf.select %is7, %value7, %bits6 : i32
  %bits8 = scf.select %is8, %value8, %bits7 : i32
  %bits9 = scf.select %is9, %value9, %bits8 : i32
  %bits10 = scf.select %is10, %value10, %bits9 : i32
  func.call @exponential_observations(%bits10, %output) : (i32, buffer)
  func.return
}

func.def @power_of_two_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %value0 = scalar.constant -851 : i32
  %value1 = scalar.constant -2 : i32
  %value2 = scalar.constant -1 : i32
  %value3 = scalar.constant 0 : i32
  %value4 = scalar.constant 22 : i32
  %value5 = scalar.constant 23 : i32
  %value6 = scalar.constant 24 : i32
  %value7 = scalar.constant 277 : i32
  %value8 = scalar.constant 278 : i32
  %value9 = scalar.constant 1149 : i32
  %shift0 = scf.select %is0, %value0, %value9 : i32
  %shift1 = scf.select %is1, %value1, %shift0 : i32
  %shift2 = scf.select %is2, %value2, %shift1 : i32
  %shift3 = scf.select %is3, %value3, %shift2 : i32
  %shift4 = scf.select %is4, %value4, %shift3 : i32
  %shift5 = scf.select %is5, %value5, %shift4 : i32
  %shift6 = scf.select %is6, %value6, %shift5 : i32
  %shift7 = scf.select %is7, %value7, %shift6 : i32
  %shift8 = scf.select %is8, %value8, %shift7 : i32
  %minimum_exponent = scalar.constant -149 : i32
  %exponent = scalar.addi %minimum_exponent, %shift8 : i32
  %input = scalar.sitofp %exponent : i32 to f32
  %result = scalar.exp2f<afn> %input : f32
  %bits = scalar.bitcast %result : f32 to i32
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %bits, %result_view[0] : i32, view<1xi32>
  func.return
}

check.scenario @exponential_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@power_of_two_observations>(%trial, %output) : (index, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0.0) : tensor<2xf32>
    check.compare<@exponential_boundary_observations>(%trial, %output) : (index, tensor<2xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<2xf32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0.0) : tensor<2xf32>
    check.compare<@exponential_entropy_observations>(%bits, %output) : (i64, tensor<2xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<2xf32>
    }
  }
  check.return
}
