    %sign = check.generate.fill value(-9223372036854775808) : tensor<4xi64>
    %output = check.generate.fill value(-559038737) : tensor<15xi64>
    check.compare<@float64_sign_bits, @float64_sign_bits_oracle>(%input, %sign, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<15xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<15xi64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %sign_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<4xi64>
    %sign = check.generate.random.uniform seed(%sign_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<4xi64>
    %output = check.generate.fill value(-559038737) : tensor<15xi64>
    check.compare<@float64_sign_bits, @float64_sign_bits_oracle>(%input, %sign, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<15xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<15xi64>
    }
  }
  check.return
}
