    %atanhf_wide = func.call @inverse_bf16_vector_measure(%atanhf) : (vector<4xbf16>) -> (vector<4xf32>)
    vector.store %atanhf_wide, %results[2, %i] : vector<4xf32>, view<6x65536xf32>
