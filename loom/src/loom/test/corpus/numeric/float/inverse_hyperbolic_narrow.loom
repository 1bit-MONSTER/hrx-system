      check.expect.close actual(%output) expected(%output) atol(1.0) rtol(0.0) nan(same) : tensor<6x65536xf32>
    }
  }
  check.return
}

func.def @inverse_bf16_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<65536xbf16>
  %results = buffer.view %output[%origin] : buffer -> view<6x65536xf32>
