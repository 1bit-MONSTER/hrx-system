  %result = vector.select %finite, %ordinal, %wide : vector<4xf32>
  func.return %result : vector<4xf32>
}

func.def public @inverse_f8e4m3_observations(%packet_count: index, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<[%packet_count]x4xf8E4M3>
  %results = buffer.view %output[%origin] : buffer -> view<6x[%packet_count]x4xf32>
  %begin = index.constant 0 : index
  %packet_width = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %packet_count step %step] {
    %value = vector.load %source[%i, 0] : view<[%packet_count]x4xf8E4M3> -> vector<4xf8E4M3>
    %asinhf = vector.asinhf<afn> %value : vector<4xf8E4M3>
    %asinhf_wide = func.call @inverse_f8e4m3_vector_measure(%asinhf) : (vector<4xf8E4M3>) -> (vector<4xf32>)
    vector.store %asinhf_wide, %results[0, %i, 0] : vector<4xf32>, view<6x[%packet_count]x4xf32>
    %acoshf = vector.acoshf<afn> %value : vector<4xf8E4M3>
    %acoshf_wide = func.call @inverse_f8e4m3_vector_measure(%acoshf) : (vector<4xf8E4M3>) -> (vector<4xf32>)
    vector.store %acoshf_wide, %results[1, %i, 0] : vector<4xf32>, view<6x[%packet_count]x4xf32>
    %atanhf = vector.atanhf<afn> %value : vector<4xf8E4M3>
    %atanhf_wide = func.call @inverse_f8e4m3_vector_measure(%atanhf) : (vector<4xf8E4M3>) -> (vector<4xf32>)
    vector.store %atanhf_wide, %results[2, %i, 0] : vector<4xf32>, view<6x[%packet_count]x4xf32>
    scf.for %j = [%begin to %packet_width step %step] {
      %lane = view.load %source[%i, %j] : view<[%packet_count]x4xf8E4M3> -> f8E4M3
      %scalar_asinhf = scalar.asinhf<afn> %lane : f8E4M3
      %scalar_asinhf_wide = func.call @inverse_f8e4m3_scalar_measure(%scalar_asinhf) : (f8E4M3) -> (f32)
      view.store %scalar_asinhf_wide, %results[3, %i, %j] : f32, view<6x[%packet_count]x4xf32>
      %scalar_acoshf = scalar.acoshf<afn> %lane : f8E4M3
      %scalar_acoshf_wide = func.call @inverse_f8e4m3_scalar_measure(%scalar_acoshf) : (f8E4M3) -> (f32)
      view.store %scalar_acoshf_wide, %results[4, %i, %j] : f32, view<6x[%packet_count]x4xf32>
      %scalar_atanhf = scalar.atanhf<afn> %lane : f8E4M3
      %scalar_atanhf_wide = func.call @inverse_f8e4m3_scalar_measure(%scalar_atanhf) : (f8E4M3) -> (f32)
      view.store %scalar_atanhf_wide, %results[5, %i, %j] : f32, view<6x[%packet_count]x4xf32>
    }
  }
  func.return
}

func.def @inverse_f8e4m3_inputs(%input: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<16xi8>
  %positive_zero_input = scalar.constant 0 : i8
  %negative_zero_input = scalar.constant -128 : i8
  %min_subnormal = scalar.constant 1 : i8
  %max_subnormal = scalar.constant 7 : i8
  %min_normal = scalar.constant 8 : i8
  %before_half = scalar.constant 47 : i8
  %half = scalar.constant 48 : i8
  %after_half = scalar.constant 49 : i8
  %before_one = scalar.constant 55 : i8
  %positive_domain_endpoint = scalar.constant 56 : i8
  %after_one = scalar.constant 57 : i8
  %negative_domain_endpoint = scalar.constant -72 : i8
  %negative_after_one = scalar.constant -71 : i8
  %max_finite = scalar.constant 126 : i8
  %infinity_or_nan = scalar.constant 127 : i8
  %nan = scalar.constant -1 : i8
  %values = vector.from_elements %positive_zero_input, %negative_zero_input, %min_subnormal, %max_subnormal, %min_normal, %before_half, %half, %after_half, %before_one, %positive_domain_endpoint, %after_one, %negative_domain_endpoint, %negative_after_one, %max_finite, %infinity_or_nan, %nan : vector<16xi8>
  vector.store %values, %inputs[0] : vector<16xi8>, view<16xi8>
  func.return
}

check.scenario @inverse_f8e4m3_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %packet_count = check.literal value(4) : index
    %input = check.generate.fill value(0) : tensor<16xi8>
    check.generate<@inverse_f8e4m3_inputs>(%input) : (tensor<16xi8>) -> ()
    %output = check.generate.fill value(0.0) : tensor<6x16xf32>
    check.compare<@inverse_f8e4m3_observations>(%packet_count, %input, %output) : (index, tensor<16xi8>, tensor<6x16xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.0) rtol(0.0) nan(same) : tensor<6x16xf32>
    }
  }
  check.return
}

