  %infinity_or_nan = scalar.constant 32640 : i16
  %nan = scalar.constant 32704 : i16
  %values = vector.from_elements %positive_zero_input, %negative_zero_input, %min_subnormal, %max_subnormal, %min_normal, %before_half, %half, %after_half, %before_one, %positive_domain_endpoint, %after_one, %negative_domain_endpoint, %negative_after_one, %max_finite, %infinity_or_nan, %nan : vector<16xi16>
  vector.store %values, %inputs[0] : vector<16xi16>, view<16xi16>
  func.return
}

check.scenario @inverse_bf16_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %packet_count = check.literal value(4) : index
    %input = check.generate.fill value(0) : tensor<16xi16>
    check.generate<@inverse_bf16_inputs>(%input) : (tensor<16xi16>) -> ()
    %output = check.generate.fill value(0.0) : tensor<6x16xf32>
    check.compare<@inverse_bf16_observations>(%packet_count, %input, %output) : (index, tensor<16xi16>, tensor<6x16xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.0) rtol(0.0) nan(same) : tensor<6x16xf32>
    }
  }
  check.return
}
