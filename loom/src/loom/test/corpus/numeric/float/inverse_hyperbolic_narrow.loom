    scf.for %j = [%i to %limit step %lane_step] {
      %lane = view.load %source[%j] : view<65536xbf16> -> bf16
      %scalar_asinhf = scalar.asinhf<afn> %lane : bf16
      %scalar_asinhf_wide = func.call @inverse_bf16_scalar_measure(%scalar_asinhf) : (bf16) -> (f32)
      view.store %scalar_asinhf_wide, %results[3, %j] : f32, view<6x65536xf32>
