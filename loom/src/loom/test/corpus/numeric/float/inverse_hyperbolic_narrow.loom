      %scalar_atanhf = scalar.atanhf<afn> %lane : bf16
      %scalar_atanhf_wide = func.call @inverse_bf16_scalar_measure(%scalar_atanhf) : (bf16) -> (f32)
      view.store %scalar_atanhf_wide, %results[5, %j] : f32, view<6x65536xf32>
    }
  }
  func.return
}

check.scenario @inverse_bf16_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<65536xi16>
    %output = check.generate.fill value(0.0) : tensor<6x65536xf32>
