  %wide = scalar.extf %value : f16 to f32
  %finite = scalar.isfinitef %wide : f32
  %bits = scalar.bitcast %value : f16 to i16
  %unsigned = scalar.extui %bits : i16 to i32
  %ordinal = scalar.uitofp %unsigned : i32 to f32
