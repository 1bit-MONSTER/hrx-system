    %value = vector.load %source[%i] : view<65536xbf16> -> vector<4xbf16>
    %asinhf = vector.asinhf<afn> %value : vector<4xbf16>
    %asinhf_wide = func.call @inverse_bf16_vector_measure(%asinhf) : (vector<4xbf16>) -> (vector<4xf32>)
    vector.store %asinhf_wide, %results[0, %i] : vector<4xf32>, view<6x65536xf32>
