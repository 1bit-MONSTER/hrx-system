func.def @inverse_f16_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<65536xf16>
  %results = buffer.view %output[%origin] : buffer -> view<6x65536xf32>
  %begin = index.constant 0 : index
  %end = index.constant 65536 : index
  %step = index.constant 4 : index
  %lane_step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<65536xf16> -> vector<4xf16>
    %asinhf = vector.asinhf<afn> %value : vector<4xf16>
    %asinhf_wide = func.call @inverse_f16_vector_measure(%asinhf) : (vector<4xf16>) -> (vector<4xf32>)
    vector.store %asinhf_wide, %results[0, %i] : vector<4xf32>, view<6x65536xf32>
    %acoshf = vector.acoshf<afn> %value : vector<4xf16>
    %acoshf_wide = func.call @inverse_f16_vector_measure(%acoshf) : (vector<4xf16>) -> (vector<4xf32>)
    vector.store %acoshf_wide, %results[1, %i] : vector<4xf32>, view<6x65536xf32>
    %atanhf = vector.atanhf<afn> %value : vector<4xf16>
    %atanhf_wide = func.call @inverse_f16_vector_measure(%atanhf) : (vector<4xf16>) -> (vector<4xf32>)
    vector.store %atanhf_wide, %results[2, %i] : vector<4xf32>, view<6x65536xf32>
    %limit = index.add %i, %step : index
    scf.for %j = [%i to %limit step %lane_step] {
      %lane = view.load %source[%j] : view<65536xf16> -> f16
      %scalar_asinhf = scalar.asinhf<afn> %lane : f16
      %scalar_asinhf_wide = func.call @inverse_f16_scalar_measure(%scalar_asinhf) : (f16) -> (f32)
      view.store %scalar_asinhf_wide, %results[3, %j] : f32, view<6x65536xf32>
      %scalar_acoshf = scalar.acoshf<afn> %lane : f16
      %scalar_acoshf_wide = func.call @inverse_f16_scalar_measure(%scalar_acoshf) : (f16) -> (f32)
      view.store %scalar_acoshf_wide, %results[4, %j] : f32, view<6x65536xf32>
      %scalar_atanhf = scalar.atanhf<afn> %lane : f16
      %scalar_atanhf_wide = func.call @inverse_f16_scalar_measure(%scalar_atanhf) : (f16) -> (f32)
      view.store %scalar_atanhf_wide, %results[5, %j] : f32, view<6x65536xf32>
    }
  }
  func.return
}

check.scenario @inverse_f16_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<65536xi16>
    %output = check.generate.fill value(0.0) : tensor<6x65536xf32>
