func.def @rounding_f8e5m2_observations(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xf8E5M2>
  %results = buffer.view %output[%base] : buffer -> view<5x256xi32>
