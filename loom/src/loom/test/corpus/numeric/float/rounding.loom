func.def inline @rounding_f64_vector_bits(%value: vector<4xf64>) -> (vector<4xi64>) {
  %bits = vector.bitcast %value : vector<4xf64> to vector<4xi64>
  %is_nan = vector.isnanf %value : vector<4xf64> -> vector<4xi1>
  %nan_word = scalar.constant 9221120237041090560 : i64
  %nan_bits = vector.splat %nan_word : vector<4xi64>
  %observed = vector.select %is_nan, %nan_bits, %bits : vector<4xi64>
  func.return %observed : vector<4xi64>
}

