// Raw-bit parameters cover both sides of ties without source constant folding.
func.def public @round_away_f32(%bits: i32) -> (i32) {
  %value = scalar.bitcast %bits : i32 to f32
  %rounded = scalar.roundf %value : f32
  %result = scalar.bitcast %rounded : f32 to i32
  func.return %result : i32
}

check.case @round_away_f32_below_half {
  %bits = check.param.choice values([0, 1, 8388607, 1056964607]) : i32
  %actual = func.call @round_away_f32(%bits) : (i32) -> (i32)
  %expected = check.literal value(0) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @round_away_f32_negative_below_half {
  %bits = check.param.choice values([-2147483648, -2147483647, -2139095041, -1090519041]) : i32
  %actual = func.call @round_away_f32(%bits) : (i32) -> (i32)
  %expected = check.literal value(-2147483648) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @round_away_f32_to_one {
  %bits = check.param.choice values([1056964608, 1056964609, 1065353216, 1069547519]) : i32
  %actual = func.call @round_away_f32(%bits) : (i32) -> (i32)
  %expected = check.literal value(1065353216) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @round_away_f32_negative_to_one {
  %bits = check.param.choice values([-1090519040, -1090519039, -1082130432, -1077936129]) : i32
  %actual = func.call @round_away_f32(%bits) : (i32) -> (i32)
  %expected = check.literal value(-1082130432) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @round_away_f32_to_two {
  %bits = check.param.choice values([1069547520, 1069547521, 1073741824, 1075838975]) : i32
  %actual = func.call @round_away_f32(%bits) : (i32) -> (i32)
  %expected = check.literal value(1073741824) : i32
