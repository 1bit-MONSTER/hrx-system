    vector.store %round_bits, %results[3, %i] : vector<4xi32>, view<5x64xi32>
    %trunc = vector.truncf %value : vector<4xf32>
    %trunc_bits = func.call @rounding_f32_vector_bits(%trunc) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<5x64xi32>
