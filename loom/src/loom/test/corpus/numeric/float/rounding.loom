    %wide_round = vector.extf %round : vector<4xf8E4M3> to vector<4xf32>
    %wide_trunc = vector.extf %trunc : vector<4xf8E4M3> to vector<4xf32>
    %ceil_bits = func.call @rounding_f32_vector_bits(%wide_ceil) : (vector<4xf32>) -> (vector<4xi32>)
    %floor_bits = func.call @rounding_f32_vector_bits(%wide_floor) : (vector<4xf32>) -> (vector<4xi32>)
    %roundeven_bits = func.call @rounding_f32_vector_bits(%wide_roundeven) : (vector<4xf32>) -> (vector<4xi32>)
    %round_bits = func.call @rounding_f32_vector_bits(%wide_round) : (vector<4xf32>) -> (vector<4xi32>)
    %trunc_bits = func.call @rounding_f32_vector_bits(%wide_trunc) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %ceil_bits, %results[0, %i] : vector<4xi32>, view<5x256xi32>
    vector.store %floor_bits, %results[1, %i] : vector<4xi32>, view<5x256xi32>
    vector.store %roundeven_bits, %results[2, %i] : vector<4xi32>, view<5x256xi32>
    vector.store %round_bits, %results[3, %i] : vector<4xi32>, view<5x256xi32>
    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<5x256xi32>
  }
  func.return
}

