// Results cross the ordinary function boundary as raw bits so signed zeros
// and NaNs cannot be hidden by a numeric comparison.
func.def public @rounding_f32(%bits: i32) -> (i32, i32, i32, i32) {
  %value = scalar.bitcast %bits : i32 to f32
  %ceil = scalar.ceilf %value : f32
  %ceil_bits = scalar.bitcast %ceil : f32 to i32
  %floor = scalar.floorf %value : f32
  %floor_bits = scalar.bitcast %floor : f32 to i32
  %roundeven = scalar.roundevenf %value : f32
  %roundeven_bits = scalar.bitcast %roundeven : f32 to i32
  %trunc = scalar.truncf %value : f32
  %trunc_bits = scalar.bitcast %trunc : f32 to i32
  func.return %ceil_bits, %floor_bits, %roundeven_bits, %trunc_bits : i32, i32, i32, i32
}

check.case @rounding_f32_half {
  %input = check.literal value(1069547520) : i32
  %ceil, %floor, %roundeven, %trunc = func.call @rounding_f32(%input) : (i32) -> (i32, i32, i32, i32)
  %expected0 = check.literal value(1073741824) : i32
  %expected1 = check.literal value(1065353216) : i32
  check.expect.equal actual(%ceil) expected(%expected0) : i32
  check.expect.equal actual(%floor) expected(%expected1) : i32
  check.expect.equal actual(%roundeven) expected(%expected0) : i32
  check.expect.equal actual(%trunc) expected(%expected1) : i32
  check.return
}

check.case @rounding_f32_negative_half {
  %input = check.literal value(-1090519040) : i32
  %ceil, %floor, %roundeven, %trunc = func.call @rounding_f32(%input) : (i32) -> (i32, i32, i32, i32)
  %expected0 = check.literal value(-2147483648) : i32
  %expected1 = check.literal value(-1082130432) : i32
  check.expect.equal actual(%ceil) expected(%expected0) : i32
  check.expect.equal actual(%floor) expected(%expected1) : i32
  check.expect.equal actual(%roundeven) expected(%expected0) : i32
  check.expect.equal actual(%trunc) expected(%expected0) : i32
  check.return
}

