    %wide_floor = vector.extf %floor : vector<4xf8E5M2> to vector<4xf32>
    %wide_roundeven = vector.extf %roundeven : vector<4xf8E5M2> to vector<4xf32>
    %wide_round = vector.extf %round : vector<4xf8E5M2> to vector<4xf32>
