// Every narrow input widens exactly to F32. Its integral rounded value is
// also exactly representable in the original format, so rounding before or
// after this widening must agree without a second rounding step.
func.def @rounding_f16_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<65536xf16>
  %results = buffer.view %output[%base] : buffer -> view<5x65536xi32>
  %begin = index.constant 0 : index
  %end = index.constant 65536 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<65536xf16> -> f16
    %wide = scalar.extf %value : f16 to f32
    %bits = scalar.bitcast %wide : f32 to i32
    %ceil, %floor, %roundeven, %round, %trunc = func.call @rounding_f32_observations(%bits) : (i32) -> (i32, i32, i32, i32, i32)
    view.store %ceil, %results[0, %i] : i32, view<5x65536xi32>
    view.store %floor, %results[1, %i] : i32, view<5x65536xi32>
    view.store %roundeven, %results[2, %i] : i32, view<5x65536xi32>
    view.store %round, %results[3, %i] : i32, view<5x65536xi32>
    view.store %trunc, %results[4, %i] : i32, view<5x65536xi32>
  }
  func.return
}

