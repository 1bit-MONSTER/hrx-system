  %expected = check.literal value(-1069547520) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

// Integral values at the precision limit, infinities, and quiet NaN are preserved.
check.case @round_away_f32_identity {
  %bits = check.param.choice values([0, -2147483648, 1258291198, 1258291200, 1258291201, -889192447, 2139095039, -8388609, 2139095040, -8388608, 2143289344]) : i32
  %actual = func.call @round_away_f32(%bits) : (i32) -> (i32)
  check.expect.equal actual(%actual) expected(%bits) : i32
  check.return
}

