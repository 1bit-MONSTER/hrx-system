// Exercises exact rounding payloads across directed IEEE-754 boundaries and
// deterministic full-width entropy. NaN results retain their classification
// while allowing target-selected sign and payload bits.

func.def inline @rounding_f32_result_bits(%value: f32) -> (i32) {
  %bits = scalar.bitcast %value : f32 to i32
  %is_nan = scalar.isnanf %value : f32
  %nan_bits = scalar.constant 2143289344 : i32
  %observed = scf.select %is_nan, %nan_bits, %bits : i32
  func.return %observed : i32
}

func.def inline @rounding_f32_vector_bits(%value: vector<4xf32>) -> (vector<4xi32>) {
  %bits = vector.bitcast %value : vector<4xf32> to vector<4xi32>
  %is_nan = vector.isnanf %value : vector<4xf32> -> vector<4xi1>
  %nan_word = scalar.constant 2143289344 : i32
  %nan_bits = vector.splat %nan_word : vector<4xi32>
  %observed = vector.select %is_nan, %nan_bits, %bits : vector<4xi32>
  func.return %observed : vector<4xi32>
}

func.def @rounding_f32_observations(%bits: i32) -> (i32, i32, i32, i32, i32) {
  %value = scalar.bitcast %bits : i32 to f32
  %ceil = scalar.ceilf %value : f32
  %ceil_bits = func.call @rounding_f32_result_bits(%ceil) : (f32) -> (i32)
  %floor = scalar.floorf %value : f32
  %floor_bits = func.call @rounding_f32_result_bits(%floor) : (f32) -> (i32)
  %roundeven = scalar.roundevenf %value : f32
  %roundeven_bits = func.call @rounding_f32_result_bits(%roundeven) : (f32) -> (i32)
  %round = scalar.roundf %value : f32
  %round_bits = func.call @rounding_f32_result_bits(%round) : (f32) -> (i32)
  %trunc = scalar.truncf %value : f32
  %trunc_bits = func.call @rounding_f32_result_bits(%trunc) : (f32) -> (i32)
  func.return %ceil_bits, %floor_bits, %roundeven_bits, %round_bits, %trunc_bits : i32, i32, i32, i32, i32
}

func.def @rounding_f32_entropy_observations(%entropy_bits: i64) -> (i32, i32, i32, i32, i32) {
  %bits = scalar.trunci %entropy_bits : i64 to i32
  %ceil, %floor, %roundeven, %round, %trunc = func.call @rounding_f32_observations(%bits) : (i32) -> (i32, i32, i32, i32, i32)
  func.return %ceil, %floor, %roundeven, %round, %trunc : i32, i32, i32, i32, i32
}

func.def @rounding_f32_boundary_observations(%ordinal: index) -> (i32, i32, i32, i32, i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %c11 = index.constant 11 : index
  %c12 = index.constant 12 : index
  %c13 = index.constant 13 : index
  %c14 = index.constant 14 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index
  %is10 = index.cmp eq, %ordinal, %c10 : index
  %is11 = index.cmp eq, %ordinal, %c11 : index
  %is12 = index.cmp eq, %ordinal, %c12 : index
  %is13 = index.cmp eq, %ordinal, %c13 : index
  %is14 = index.cmp eq, %ordinal, %c14 : index
  %is15 = index.cmp eq, %ordinal, %c15 : index
  %is16 = index.cmp eq, %ordinal, %c16 : index
  %value0 = scalar.constant 0 : i32
  %value1 = scalar.constant -2147483648 : i32
  %value2 = scalar.constant 1 : i32
  %value3 = scalar.constant -2147483647 : i32
  %value4 = scalar.constant 1056964607 : i32
  %value5 = scalar.constant 1056964608 : i32
  %value6 = scalar.constant -1090519040 : i32
  %value7 = scalar.constant 1069547520 : i32
  %value8 = scalar.constant -1077936128 : i32
  %value9 = scalar.constant 1075838976 : i32
  %value10 = scalar.constant -1071644672 : i32
  %value11 = scalar.constant 1258291200 : i32
  %value12 = scalar.constant 1258291201 : i32
  %value13 = scalar.constant 2139095039 : i32
  %value14 = scalar.constant 2139095040 : i32
  %value15 = scalar.constant -8388608 : i32
  %value16 = scalar.constant 2143289344 : i32
  %value17 = scalar.constant 2139169605 : i32
  %bits0 = scf.select %is0, %value0, %value17 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %bits3 = scf.select %is3, %value3, %bits2 : i32
  %bits4 = scf.select %is4, %value4, %bits3 : i32
  %bits5 = scf.select %is5, %value5, %bits4 : i32
  %bits6 = scf.select %is6, %value6, %bits5 : i32
  %bits7 = scf.select %is7, %value7, %bits6 : i32
  %bits8 = scf.select %is8, %value8, %bits7 : i32
  %bits9 = scf.select %is9, %value9, %bits8 : i32
  %bits10 = scf.select %is10, %value10, %bits9 : i32
  %bits11 = scf.select %is11, %value11, %bits10 : i32
  %bits12 = scf.select %is12, %value12, %bits11 : i32
  %bits13 = scf.select %is13, %value13, %bits12 : i32
  %bits14 = scf.select %is14, %value14, %bits13 : i32
  %bits15 = scf.select %is15, %value15, %bits14 : i32
  %bits16 = scf.select %is16, %value16, %bits15 : i32
  %ceil, %floor, %roundeven, %round, %trunc = func.call @rounding_f32_observations(%bits16) : (i32) -> (i32, i32, i32, i32, i32)
  func.return %ceil, %floor, %roundeven, %round, %trunc : i32, i32, i32, i32, i32
}

check.scenario @rounding_f32_values {
  check.trial[18](%trial: index, %entropy: check.entropy) {
    check.compare<@rounding_f32_boundary_observations>(%trial) : (index) -> [actual(%actual_ceil: i32, %actual_floor: i32, %actual_roundeven: i32, %actual_round: i32, %actual_trunc: i32), expected(%expected_ceil: i32, %expected_floor: i32, %expected_roundeven: i32, %expected_round: i32, %expected_trunc: i32)] {
      check.expect.bitwise actual(%actual_ceil) expected(%expected_ceil) : i32
      check.expect.bitwise actual(%actual_floor) expected(%expected_floor) : i32
      check.expect.bitwise actual(%actual_roundeven) expected(%expected_roundeven) : i32
      check.expect.bitwise actual(%actual_round) expected(%expected_round) : i32
      check.expect.bitwise actual(%actual_trunc) expected(%expected_trunc) : i32
    }
  }
  check.trial[1024](%trial: index, %entropy: check.entropy) {
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    check.compare<@rounding_f32_entropy_observations>(%bits) : (i64) -> [actual(%actual_ceil: i32, %actual_floor: i32, %actual_roundeven: i32, %actual_round: i32, %actual_trunc: i32), expected(%expected_ceil: i32, %expected_floor: i32, %expected_roundeven: i32, %expected_round: i32, %expected_trunc: i32)] {
      check.expect.bitwise actual(%actual_ceil) expected(%expected_ceil) : i32
      check.expect.bitwise actual(%actual_floor) expected(%expected_floor) : i32
      check.expect.bitwise actual(%actual_roundeven) expected(%expected_roundeven) : i32
      check.expect.bitwise actual(%actual_round) expected(%expected_round) : i32
      check.expect.bitwise actual(%actual_trunc) expected(%expected_trunc) : i32
    }
  }
  check.return
}

