// Exhaustive narrow encodings travel through runtime buffers, not constants.
// Widening rounded outputs is exact and reuses the F32 observation boundary:
// finite values and zero signs compare bitwise, while NaNs retain their class.
func.def @rounding_f16_observations(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<65536xf16>
  %results = buffer.view %output[%base] : buffer -> view<5x65536xi32>
  %begin = index.constant 0 : index
  %end = index.constant 65536 : index
  %step = index.constant 4 : index
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<65536xf16> -> vector<4xf16>
    %ceil = vector.ceilf %value : vector<4xf16>
    %floor = vector.floorf %value : vector<4xf16>
    %roundeven = vector.roundevenf %value : vector<4xf16>
    %round = vector.roundf %value : vector<4xf16>
    %trunc = vector.truncf %value : vector<4xf16>
    %wide_ceil = vector.extf %ceil : vector<4xf16> to vector<4xf32>
    %wide_floor = vector.extf %floor : vector<4xf16> to vector<4xf32>
    %wide_roundeven = vector.extf %roundeven : vector<4xf16> to vector<4xf32>
    %wide_round = vector.extf %round : vector<4xf16> to vector<4xf32>
    %wide_trunc = vector.extf %trunc : vector<4xf16> to vector<4xf32>
    %ceil_bits = func.call @rounding_f32_vector_bits(%wide_ceil) : (vector<4xf32>) -> (vector<4xi32>)
    %floor_bits = func.call @rounding_f32_vector_bits(%wide_floor) : (vector<4xf32>) -> (vector<4xi32>)
    %roundeven_bits = func.call @rounding_f32_vector_bits(%wide_roundeven) : (vector<4xf32>) -> (vector<4xi32>)
    %round_bits = func.call @rounding_f32_vector_bits(%wide_round) : (vector<4xf32>) -> (vector<4xi32>)
    %trunc_bits = func.call @rounding_f32_vector_bits(%wide_trunc) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %ceil_bits, %results[0, %i] : vector<4xi32>, view<5x65536xi32>
    vector.store %floor_bits, %results[1, %i] : vector<4xi32>, view<5x65536xi32>
    vector.store %roundeven_bits, %results[2, %i] : vector<4xi32>, view<5x65536xi32>
    vector.store %round_bits, %results[3, %i] : vector<4xi32>, view<5x65536xi32>
    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<5x65536xi32>
  }
  func.return
}

check.scenario @rounding_f16_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<65536xi16>
    %output = check.generate.fill value(-1) : tensor<5x65536xi32>
    check.compare<@rounding_f16_observations, @rounding_f16_oracle>(%input, %output) : (tensor<65536xi16>, tensor<5x65536xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5x65536xi32>
    }
  }
  check.return
}

