// Inverse hyperbolic source semantics across scalar and vector lanes. Runtime
// inputs preserve subnormal, threshold, domain, and finite-overflow boundaries.

func.def @inverse_f32_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<64xf32>
  %results = buffer.view %output[%origin] : buffer -> view<6x64xf32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 4 : index
  %lane_step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<64xf32> -> vector<4xf32>
    %asinhf = vector.asinhf<afn> %value : vector<4xf32>
    vector.store %asinhf, %results[0, %i] : vector<4xf32>, view<6x64xf32>
    %acoshf = vector.acoshf<afn> %value : vector<4xf32>
    vector.store %acoshf, %results[1, %i] : vector<4xf32>, view<6x64xf32>
    %atanhf = vector.atanhf<afn> %value : vector<4xf32>
    vector.store %atanhf, %results[2, %i] : vector<4xf32>, view<6x64xf32>
    %limit = index.add %i, %step : index
    scf.for %j = [%i to %limit step %lane_step] {
      %lane = view.load %source[%j] : view<64xf32> -> f32
      %scalar_asinhf = scalar.asinhf<afn> %lane : f32
      view.store %scalar_asinhf, %results[3, %j] : f32, view<6x64xf32>
      %scalar_acoshf = scalar.acoshf<afn> %lane : f32
      view.store %scalar_acoshf, %results[4, %j] : f32, view<6x64xf32>
      %scalar_atanhf = scalar.atanhf<afn> %lane : f32
      view.store %scalar_atanhf, %results[5, %j] : f32, view<6x64xf32>
    }
  }
  func.return
}

// Signed zeros, subnormal limits, maximum finite values, infinities, NaNs,
// neighbors of the polynomial and logarithm thresholds, and interior values.
// Expected boundaries below are independently rounded from double libm.
// Entropy trials separately compare native targets with the VM implementation.
check.scenario @inverse_f32_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<64xi32>
    %output = check.generate.fill value(0.0) : tensor<6x64xf32>
    %expected0 = check.generate.fill value(0) : tensor<64xi32>
    %expected1 = check.generate.fill value(nan) : tensor<64xf32>
    %expected2 = check.generate.fill value(0) : tensor<64xi32>
    %actual0 = check.tensor.view %output offset(0) : tensor<6x64xf32> -> tensor<64xi32>
    %actual1 = check.tensor.view %output offset(256) : tensor<6x64xf32> -> tensor<64xf32>
    %actual2 = check.tensor.view %output offset(512) : tensor<6x64xf32> -> tensor<64xi32>
    %actual3 = check.tensor.view %output offset(768) : tensor<6x64xf32> -> tensor<64xi32>
    %actual4 = check.tensor.view %output offset(1024) : tensor<6x64xf32> -> tensor<64xf32>
    %actual5 = check.tensor.view %output offset(1280) : tensor<6x64xf32> -> tensor<64xi32>
    check.compare<@inverse_f32_observations>(%input, %output) : (tensor<64xi32>, tensor<6x64xf32>) -> () {
      check.expect.bitwise actual(%actual0) expected(%expected0) : tensor<64xi32>
      check.expect.close actual(%actual1) expected(%expected1) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.bitwise actual(%actual2) expected(%expected2) : tensor<64xi32>
      check.expect.bitwise actual(%actual3) expected(%expected0) : tensor<64xi32>
      check.expect.close actual(%actual4) expected(%expected1) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.bitwise actual(%actual5) expected(%expected2) : tensor<64xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-2147483648) : tensor<64xi32>
