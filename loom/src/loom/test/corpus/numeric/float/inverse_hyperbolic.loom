// Directed IEEE-754, domain, and range-transition witnesses. Each input occurs
// once per scalar/vector implementation, with different values in adjacent lanes.
// Expected values are independently rounded from double-precision libm.

func.def @inverse_f32_inputs(%input: buffer, %expected: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<32xi32>
  %expectations = buffer.view %expected[%origin] : buffer -> view<3x32xf32>
  %positive_zero_input = scalar.constant 0 : i32
  %positive_zero_result = scalar.constant 0.0 : f32
  %nan = scalar.constant nan : f32
  %negative_zero_input = scalar.constant -2147483648 : i32
  %negative_zero_result = scalar.constant -0.0 : f32
  %bits_min_subnormal = scalar.constant 1 : i32
  %asinh_min_subnormal = scalar.constant 1.4012984643248171e-45 : f32
  %bits_next_subnormal = scalar.constant 2 : i32
  %asinh_next_subnormal = scalar.constant 2.8025969286496341e-45 : f32
  %bits_max_subnormal = scalar.constant 8388607 : i32
  %asinh_max_subnormal = scalar.constant 1.1754942106924411e-38 : f32
  %bits_min_normal = scalar.constant 8388608 : i32
  %asinh_min_normal = scalar.constant 1.1754943508222875e-38 : f32
  %bits_next_normal = scalar.constant 8388609 : i32
  %asinh_next_normal = scalar.constant 1.1754944909521339e-38 : f32
  %bits_max_finite = scalar.constant 2139095039 : i32
  %asinh_max_finite = scalar.constant 89.415985107421875 : f32
  %bits_infinity = scalar.constant 2139095040 : i32
  %infinity = scalar.constant inf : f32
  %bits_negative_infinity = scalar.constant -8388608 : i32
  %negative_infinity = scalar.constant -inf : f32
  %bits_quiet_nan = scalar.constant 2143289344 : i32
  %bits_signaling_nan = scalar.constant 2139095041 : i32
  %bits_before_half = scalar.constant 1056964607 : i32
  %asinh_before_half = scalar.constant 0.48121181130409241 : f32
  %atanh_before_half = scalar.constant 0.54930609464645386 : f32
  %bits_half = scalar.constant 1056964608 : i32
  %atanh_half = scalar.constant 0.54930615425109863 : f32
  %bits_after_half = scalar.constant 1056964609 : i32
  %asinh_after_half = scalar.constant 0.48121187090873718 : f32
  %atanh_after_half = scalar.constant 0.54930621385574341 : f32
  %bits_negative_half = scalar.constant -1090519040 : i32
  %asinh_negative_half = scalar.constant -0.48121181130409241 : f32
  %atanh_negative_half = scalar.constant -0.54930615425109863 : f32
  %bits_before_one = scalar.constant 1065353215 : i32
  %asinh_before_one = scalar.constant 0.88137352466583252 : f32
  %atanh_before_one = scalar.constant 8.6643400192260742 : f32
  %positive_domain_endpoint = scalar.constant 1065353216 : i32
  %asinh_one = scalar.constant 0.88137358427047729 : f32
  %bits_after_one = scalar.constant 1065353217 : i32
  %asinh_after_one = scalar.constant 0.88137364387512207 : f32
  %acosh_after_one = scalar.constant 0.00048828125 : f32
  %bits_negative_before_one = scalar.constant -1082130433 : i32
  %asinh_negative_before_one = scalar.constant -0.88137352466583252 : f32
  %atanh_negative_before_one = scalar.constant -8.6643400192260742 : f32
  %negative_domain_endpoint = scalar.constant -1082130432 : i32
  %asinh_negative_one = scalar.constant -0.88137358427047729 : f32
  %bits_negative_after_one = scalar.constant -1082130431 : i32
  %asinh_negative_after_one = scalar.constant -0.88137364387512207 : f32
  %bits_before_three_halves = scalar.constant 1069547519 : i32
  %asinh_before_three_halves = scalar.constant 1.19476318359375 : f32
  %acosh_before_three_halves = scalar.constant 0.96242356300354004 : f32
  %bits_three_halves = scalar.constant 1069547520 : i32
  %acosh_three_halves = scalar.constant 0.96242362260818481 : f32
  %bits_after_three_halves = scalar.constant 1069547521 : i32
  %asinh_after_three_halves = scalar.constant 1.1947633028030396 : f32
  %acosh_after_three_halves = scalar.constant 0.96242374181747437 : f32
  %bits_before_large = scalar.constant 1166016511 : i32
  %asinh_before_large = scalar.constant 9.0109128952026367 : f32
  %bits_large = scalar.constant 1166016512 : i32
  %bits_after_large = scalar.constant 1166016513 : i32
  %asinh_after_large = scalar.constant 9.0109138488769531 : f32
  %bits_eighth = scalar.constant 1040187392 : i32
  %asinh_eighth = scalar.constant 0.12467674911022186 : f32
  %atanh_eighth = scalar.constant 0.12565721571445465 : f32
  %bits_three_quarters = scalar.constant 1061158912 : i32
  %asinh_three_quarters = scalar.constant 0.69314718246459961 : f32
  %atanh_three_quarters = scalar.constant 0.97295504808425903 : f32
  %outer_range_input = scalar.constant 1073741824 : i32
  %asinh_two = scalar.constant 1.4436354637145996 : f32
  %acosh_two = scalar.constant 1.316957950592041 : f32
  %negative_outer_range_input = scalar.constant -1073741824 : i32
  %asinh_negative_two = scalar.constant -1.4436354637145996 : f32
  %input_values = vector.from_elements %positive_zero_input, %negative_zero_input, %bits_min_subnormal, %bits_next_subnormal, %bits_max_subnormal, %bits_min_normal, %bits_next_normal, %bits_max_finite, %bits_infinity, %bits_negative_infinity, %bits_quiet_nan, %bits_signaling_nan, %bits_before_half, %bits_half, %bits_after_half, %bits_negative_half, %bits_before_one, %positive_domain_endpoint, %bits_after_one, %bits_negative_before_one, %negative_domain_endpoint, %bits_negative_after_one, %bits_before_three_halves, %bits_three_halves, %bits_after_three_halves, %bits_before_large, %bits_large, %bits_after_large, %bits_eighth, %bits_three_quarters, %outer_range_input, %negative_outer_range_input : vector<32xi32>
  vector.store %input_values, %inputs[0] : vector<32xi32>, view<32xi32>
  %asinh_values = vector.from_elements %positive_zero_result, %negative_zero_result, %asinh_min_subnormal, %asinh_next_subnormal, %asinh_max_subnormal, %asinh_min_normal, %asinh_next_normal, %asinh_max_finite, %infinity, %negative_infinity, %nan, %nan, %asinh_before_half, %asinh_before_half, %asinh_after_half, %asinh_negative_half, %asinh_before_one, %asinh_one, %asinh_after_one, %asinh_negative_before_one, %asinh_negative_one, %asinh_negative_after_one, %asinh_before_three_halves, %asinh_before_three_halves, %asinh_after_three_halves, %asinh_before_large, %asinh_before_large, %asinh_after_large, %asinh_eighth, %asinh_three_quarters, %asinh_two, %asinh_negative_two : vector<32xf32>
  vector.store %asinh_values, %expectations[0, 0] : vector<32xf32>, view<3x32xf32>
  %acosh_values = vector.from_elements %nan, %nan, %nan, %nan, %nan, %nan, %nan, %asinh_max_finite, %infinity, %nan, %nan, %nan, %nan, %nan, %nan, %nan, %nan, %positive_zero_result, %acosh_after_one, %nan, %nan, %nan, %acosh_before_three_halves, %acosh_three_halves, %acosh_after_three_halves, %asinh_before_large, %asinh_before_large, %asinh_after_large, %nan, %nan, %acosh_two, %nan : vector<32xf32>
  vector.store %acosh_values, %expectations[1, 0] : vector<32xf32>, view<3x32xf32>
  %atanh_values = vector.from_elements %positive_zero_result, %negative_zero_result, %asinh_min_subnormal, %asinh_next_subnormal, %asinh_max_subnormal, %asinh_min_normal, %asinh_next_normal, %nan, %nan, %nan, %nan, %nan, %atanh_before_half, %atanh_half, %atanh_after_half, %atanh_negative_half, %atanh_before_one, %infinity, %nan, %atanh_negative_before_one, %negative_infinity, %nan, %nan, %nan, %nan, %nan, %nan, %nan, %atanh_eighth, %atanh_three_quarters, %nan, %nan : vector<32xf32>
  vector.store %atanh_values, %expectations[2, 0] : vector<32xf32>, view<3x32xf32>
  func.return
}

func.def @inverse_f32_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<32xf32>
  %results = buffer.view %output[%origin] : buffer -> view<6x32xf32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 4 : index
  %lane_step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<32xf32> -> vector<4xf32>
    %asinhf = vector.asinhf<afn> %value : vector<4xf32>
    vector.store %asinhf, %results[0, %i] : vector<4xf32>, view<6x32xf32>
    %acoshf = vector.acoshf<afn> %value : vector<4xf32>
    vector.store %acoshf, %results[1, %i] : vector<4xf32>, view<6x32xf32>
    %atanhf = vector.atanhf<afn> %value : vector<4xf32>
    vector.store %atanhf, %results[2, %i] : vector<4xf32>, view<6x32xf32>
    %limit = index.add %i, %step : index
    scf.for %j = [%i to %limit step %lane_step] {
      %lane = view.load %source[%j] : view<32xf32> -> f32
      %scalar_asinhf = scalar.asinhf<afn> %lane : f32
      view.store %scalar_asinhf, %results[3, %j] : f32, view<6x32xf32>
      %scalar_acoshf = scalar.acoshf<afn> %lane : f32
      view.store %scalar_acoshf, %results[4, %j] : f32, view<6x32xf32>
      %scalar_atanhf = scalar.atanhf<afn> %lane : f32
      view.store %scalar_atanhf, %results[5, %j] : f32, view<6x32xf32>
    }
  }
  func.return
}

check.scenario @inverse_f32_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<32xi32>
    %expected = check.generate.fill value(0.0) : tensor<3x32xf32>
    %output = check.generate.fill value(0.0) : tensor<6x32xf32>
    check.generate<@inverse_f32_inputs>(%input, %expected) : (tensor<32xi32>, tensor<3x32xf32>) -> ()
    %vector_results = check.tensor.view %output offset(0) : tensor<6x32xf32> -> tensor<3x32xf32>
    %scalar_results = check.tensor.view %output offset(384) : tensor<6x32xf32> -> tensor<3x32xf32>
    // Relative error does not distinguish +0 and -0. Check those lanes as bits.
    %positive_zero = check.tensor.view %input offset(0) : tensor<32xi32> -> tensor<1xi32>
    %vector_acosh_one = check.tensor.view %output offset(196) : tensor<6x32xf32> -> tensor<1xi32>
    %scalar_acosh_one = check.tensor.view %output offset(580) : tensor<6x32xf32> -> tensor<1xi32>
    %zero_bits = check.tensor.view %input offset(0) : tensor<32xi32> -> tensor<2xi32>
    %vector_asinh_zeros = check.tensor.view %output offset(0) : tensor<6x32xf32> -> tensor<2xi32>
    %vector_atanh_zeros = check.tensor.view %output offset(256) : tensor<6x32xf32> -> tensor<2xi32>
    %scalar_asinh_zeros = check.tensor.view %output offset(384) : tensor<6x32xf32> -> tensor<2xi32>
    %scalar_atanh_zeros = check.tensor.view %output offset(640) : tensor<6x32xf32> -> tensor<2xi32>
    check.compare<@inverse_f32_observations>(%input, %output) : (tensor<32xi32>, tensor<6x32xf32>) -> () {
      check.expect.close actual(%vector_results) expected(%expected) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<3x32xf32>
      check.expect.close actual(%scalar_results) expected(%expected) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<3x32xf32>
      check.expect.bitwise actual(%vector_acosh_one) expected(%positive_zero) : tensor<1xi32>
      check.expect.bitwise actual(%scalar_acosh_one) expected(%positive_zero) : tensor<1xi32>
      check.expect.bitwise actual(%vector_asinh_zeros) expected(%zero_bits) : tensor<2xi32>
      check.expect.bitwise actual(%vector_atanh_zeros) expected(%zero_bits) : tensor<2xi32>
      check.expect.bitwise actual(%scalar_asinh_zeros) expected(%zero_bits) : tensor<2xi32>
      check.expect.bitwise actual(%scalar_atanh_zeros) expected(%zero_bits) : tensor<2xi32>
    }
  }
  check.return
}

// Cross-target consistency smoke; the directed scenario owns accuracy.
check.scenario @inverse_f32_entropy {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %output = check.generate.fill value(0.0) : tensor<6x32xf32>
    check.compare<@inverse_f32_observations>(%input, %output) : (tensor<32xi32>, tensor<6x32xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<6x32xf32>
    }
  }
  check.return
}
