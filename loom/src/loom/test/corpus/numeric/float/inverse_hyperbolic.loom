      check.expect.close actual(%actual0) expected(%expected0) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.close actual(%actual1) expected(%expected1) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.close actual(%actual2) expected(%expected2) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.close actual(%actual3) expected(%expected0) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.close actual(%actual4) expected(%expected1) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
      check.expect.close actual(%actual5) expected(%expected2) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<64xf32>
    }
  }
  check.return
}

check.scenario @inverse_f32_entropy {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<64xi32>
    %output = check.generate.fill value(0.0) : tensor<6x64xf32>
    check.compare<@inverse_f32_observations>(%input, %output) : (tensor<64xi32>, tensor<6x64xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(9.9999999999999995e-07) nan(same) : tensor<6x64xf32>
    }
  }
  check.return
}
