// Float selection is a bit-preserving move, including signed zero and NaN
// payloads. Mixing scalar widths also exercises the result move sequence.
func.def public @select_bits(%condition: i1, %a32: i32, %b32: i32, %a64: i64, %b64: i64) -> (i64, i32, i64, i32) {
  %af32 = scalar.bitcast %a32 : i32 to f32
  %bf32 = scalar.bitcast %b32 : i32 to f32
  %af64 = scalar.bitcast %a64 : i64 to f64
  %bf64 = scalar.bitcast %b64 : i64 to f64
  %i32 = scf.select %condition, %a32, %b32 : i32
  %i64 = scf.select %condition, %a64, %b64 : i64
  %f32 = scf.select %condition, %af32, %bf32 : f32
  %f64 = scf.select %condition, %af64, %bf64 : f64
  %f32_bits = scalar.bitcast %f32 : f32 to i32
  %f64_bits = scalar.bitcast %f64 : f64 to i64
  func.return %i64, %f32_bits, %f64_bits, %i32 : i64, i32, i64, i32
}

check.case @select_true_bits {
  %condition = check.literal value(true) : i1
  %a32 = check.param.choice values([0, -2147483648, 2143289345]) : i32
  %a64 = check.param.choice values([0, -9223372036854775808, 9221120237041090561]) : i64
  %b32 = check.literal value(1065353216) : i32
  %b64 = check.literal value(4607182418800017408) : i64
  %i64, %f32_bits, %f64_bits, %i32 = func.call @select_bits(%condition, %a32, %b32, %a64, %b64) : (i1, i32, i32, i64, i64) -> (i64, i32, i64, i32)
  check.expect.equal actual(%i64) expected(%a64) : i64
  check.expect.equal actual(%f32_bits) expected(%a32) : i32
  check.expect.equal actual(%f64_bits) expected(%a64) : i64
  check.expect.equal actual(%i32) expected(%a32) : i32
  check.return
}

check.case @select_false_bits {
  %condition = check.literal value(false) : i1
  %a32 = check.literal value(1065353216) : i32
  %a64 = check.literal value(4607182418800017408) : i64
  %b32 = check.param.choice values([0, -2147483648, 2143289345]) : i32
  %b64 = check.param.choice values([0, -9223372036854775808, 9221120237041090561]) : i64
  %i64, %f32_bits, %f64_bits, %i32 = func.call @select_bits(%condition, %a32, %b32, %a64, %b64) : (i1, i32, i32, i64, i64) -> (i64, i32, i64, i32)
  check.expect.equal actual(%i64) expected(%b64) : i64
  check.expect.equal actual(%f32_bits) expected(%b32) : i32
  check.expect.equal actual(%f64_bits) expected(%b64) : i64
  check.expect.equal actual(%i32) expected(%b32) : i32
  check.return
}
