// FMA must keep the product bits lost by separate selected-width rounding.
func.def public @fused_rounding_f64(%a: f64, %b: f64, %c: f64) -> (f64, f64) {
  %product = scalar.mulf %a, %b : f64
  %separate = scalar.addf %product, %c : f64
  %fused = scalar.fmaf %a, %b, %c : f64
  func.return %separate, %fused : f64, f64
}

check.case @fused_rounding_f64_case {
  %a = check.literal value(1.0000000000000002) : f64
  %b = check.literal value(0.99999999999999978) : f64
  %c = check.literal value(-1.0) : f64
  %separate, %fused = func.call @fused_rounding_f64(%a, %b, %c) : (f64, f64, f64) -> (f64, f64)
  %zero = check.literal value(0.0) : f64
  %expected_fused = check.literal value(-4.9303806576313238e-32) : f64
  check.expect.equal actual(%separate) expected(%zero) : f64
  check.expect.equal actual(%fused) expected(%expected_fused) : f64
  check.return
}

func.def public @clamp_nan_f64(%bits: i64, %lower: f64, %upper: f64) -> (i64, f64, i1) {
  %value = scalar.bitcast %bits : i64 to f64
  %ordered = scalar.clampf<ordered> %value, %lower, %upper : f64
  %number = scalar.clampf<number> %value, %lower, %upper : f64
  %ieee = scalar.clampf<ieee> %value, %lower, %upper : f64
  %ordered_bits = scalar.bitcast %ordered : f64 to i64
  %ieee_nan = scalar.isnanf %ieee : f64
  func.return %ordered_bits, %number, %ieee_nan : i64, f64, i1
