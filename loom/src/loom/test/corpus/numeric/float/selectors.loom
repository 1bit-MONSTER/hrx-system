// Raw payload arguments exercise signed zeros and NaNs without host floating
// literal conversion, and the results check the source-level NaN policies.
func.def public @float_boundaries_f32(%a_bits: i32, %b_bits: i32) -> (i32, i32, i32, i32, i1, i1, i1, i1, i1, i1, i1) {
  %a = scalar.bitcast %a_bits : i32 to f32
  %b = scalar.bitcast %b_bits : i32 to f32
  %minimum = scalar.minimumf %a, %b : f32
  %maximum = scalar.maximumf %a, %b : f32
  %minnum = scalar.minnumf %a, %b : f32
  %maxnum = scalar.maxnumf %a, %b : f32
  %minimum_bits = scalar.bitcast %minimum : f32 to i32
  %maximum_bits = scalar.bitcast %maximum : f32 to i32
  %minnum_bits = scalar.bitcast %minnum : f32 to i32
  %maxnum_bits = scalar.bitcast %maxnum : f32 to i32
  %ordered_equal = scalar.cmpf oeq, %a, %b : f32
  %unordered = scalar.cmpf uno, %a, %b : f32
  %isnan = scalar.isnanf %a : f32
  %isinf = scalar.isinff %a : f32
  %isfinite = scalar.isfinitef %a : f32
  %minimum_nan = scalar.isnanf %minimum : f32
  %maximum_nan = scalar.isnanf %maximum : f32
  func.return %minimum_bits, %maximum_bits, %minnum_bits, %maxnum_bits, %ordered_equal, %unordered, %isnan, %isinf, %isfinite, %minimum_nan, %maximum_nan : i32, i32, i32, i32, i1, i1, i1, i1, i1, i1, i1
}

check.case @float_boundaries_f32_zeros {
  %a = check.literal value(0) : i32
  %b = check.literal value(-2147483648) : i32
  %minimum, %maximum, %minnum, %maxnum, %ordered_equal, %unordered, %isnan, %isinf, %isfinite, %minimum_nan, %maximum_nan = func.call @float_boundaries_f32(%a, %b) : (i32, i32) -> (i32, i32, i32, i32, i1, i1, i1, i1, i1, i1, i1)
  %expected_minimum = check.literal value(-2147483648) : i32
  check.expect.equal actual(%minimum) expected(%expected_minimum) : i32
  %expected_maximum = check.literal value(0) : i32
  check.expect.equal actual(%maximum) expected(%expected_maximum) : i32
  %expected_minnum = check.literal value(-2147483648) : i32
  check.expect.equal actual(%minnum) expected(%expected_minnum) : i32
  %expected_maxnum = check.literal value(0) : i32
  check.expect.equal actual(%maxnum) expected(%expected_maxnum) : i32
  %expected_ordered_equal = check.literal value(true) : i1
  check.expect.equal actual(%ordered_equal) expected(%expected_ordered_equal) : i1
  %expected_unordered = check.literal value(false) : i1
  check.expect.equal actual(%unordered) expected(%expected_unordered) : i1
  %expected_isnan = check.literal value(false) : i1
  check.expect.equal actual(%isnan) expected(%expected_isnan) : i1
  %expected_isinf = check.literal value(false) : i1
  check.expect.equal actual(%isinf) expected(%expected_isinf) : i1
  %expected_isfinite = check.literal value(true) : i1
  check.expect.equal actual(%isfinite) expected(%expected_isfinite) : i1
  check.expect.equal actual(%minimum_nan) expected(%expected_isnan) : i1
  check.expect.equal actual(%maximum_nan) expected(%expected_isnan) : i1
  check.return
}

check.case @float_boundaries_f32_nan {
  %a = check.literal value(2143289344) : i32
  %b = check.literal value(1065353216) : i32
  %minimum, %maximum, %minnum, %maxnum, %ordered_equal, %unordered, %isnan, %isinf, %isfinite, %minimum_nan, %maximum_nan = func.call @float_boundaries_f32(%a, %b) : (i32, i32) -> (i32, i32, i32, i32, i1, i1, i1, i1, i1, i1, i1)
  %expected_minnum = check.literal value(1065353216) : i32
  check.expect.equal actual(%minnum) expected(%expected_minnum) : i32
  %expected_maxnum = check.literal value(1065353216) : i32
  check.expect.equal actual(%maxnum) expected(%expected_maxnum) : i32
  %expected_ordered_equal = check.literal value(false) : i1
  check.expect.equal actual(%ordered_equal) expected(%expected_ordered_equal) : i1
  %expected_unordered = check.literal value(true) : i1
  check.expect.equal actual(%unordered) expected(%expected_unordered) : i1
  %expected_isnan = check.literal value(true) : i1
  check.expect.equal actual(%isnan) expected(%expected_isnan) : i1
  %expected_isinf = check.literal value(false) : i1
  check.expect.equal actual(%isinf) expected(%expected_isinf) : i1
  %expected_isfinite = check.literal value(false) : i1
  check.expect.equal actual(%isfinite) expected(%expected_isfinite) : i1
  check.expect.equal actual(%minimum_nan) expected(%expected_isnan) : i1
  check.expect.equal actual(%maximum_nan) expected(%expected_isnan) : i1
  check.return
}

// FMA must keep the product bits lost by separate selected-width rounding.
func.def public @fused_rounding_f32(%a: f32, %b: f32, %c: f32) -> (f32, f32) {
  %product = scalar.mulf %a, %b : f32
  %separate = scalar.addf %product, %c : f32
  %fused = scalar.fmaf %a, %b, %c : f32
  func.return %separate, %fused : f32, f32
}

check.case @fused_rounding_f32_case {
  %a = check.literal value(1.0000001192092896) : f32
  %b = check.literal value(0.99999988079071045) : f32
  %c = check.literal value(-1.0) : f32
  %separate, %fused = func.call @fused_rounding_f32(%a, %b, %c) : (f32, f32, f32) -> (f32, f32)
  %zero = check.literal value(0.0) : f32
  %expected_fused = check.literal value(-1.4210854715202004e-14) : f32
  check.expect.equal actual(%separate) expected(%zero) : f32
  check.expect.equal actual(%fused) expected(%expected_fused) : f32
  check.return
}

func.def public @clamp_nan_f32(%bits: i32, %lower: f32, %upper: f32) -> (i32, f32, i1) {
  %value = scalar.bitcast %bits : i32 to f32
  %ordered = scalar.clampf<ordered> %value, %lower, %upper : f32
  %number = scalar.clampf<number> %value, %lower, %upper : f32
  %ieee = scalar.clampf<ieee> %value, %lower, %upper : f32
  %ordered_bits = scalar.bitcast %ordered : f32 to i32
  %ieee_nan = scalar.isnanf %ieee : f32
  func.return %ordered_bits, %number, %ieee_nan : i32, f32, i1
}

check.case @clamp_nan_f32_case {
  %bits = check.literal value(-4194304) : i32
  %lower = check.literal value(1.0) : f32
  %upper = check.literal value(2.0) : f32
  %ordered_bits, %number, %ieee_nan = func.call @clamp_nan_f32(%bits, %lower, %upper) : (i32, f32, f32) -> (i32, f32, i1)
  %yes = check.literal value(true) : i1
  check.expect.equal actual(%ordered_bits) expected(%bits) : i32
  check.expect.equal actual(%number) expected(%lower) : f32
  check.expect.equal actual(%ieee_nan) expected(%yes) : i1
  check.return
}

// Raw payload arguments exercise signed zeros and NaNs without host floating
// literal conversion, and the results check the source-level NaN policies.
func.def public @float_boundaries_f64(%a_bits: i64, %b_bits: i64) -> (i64, i64, i64, i64, i1, i1, i1, i1, i1, i1, i1) {
  %a = scalar.bitcast %a_bits : i64 to f64
  %b = scalar.bitcast %b_bits : i64 to f64
  %minimum = scalar.minimumf %a, %b : f64
  %maximum = scalar.maximumf %a, %b : f64
  %minnum = scalar.minnumf %a, %b : f64
  %maxnum = scalar.maxnumf %a, %b : f64
  %minimum_bits = scalar.bitcast %minimum : f64 to i64
  %maximum_bits = scalar.bitcast %maximum : f64 to i64
  %minnum_bits = scalar.bitcast %minnum : f64 to i64
  %maxnum_bits = scalar.bitcast %maxnum : f64 to i64
  %ordered_equal = scalar.cmpf oeq, %a, %b : f64
  %unordered = scalar.cmpf uno, %a, %b : f64
  %isnan = scalar.isnanf %a : f64
  %isinf = scalar.isinff %a : f64
  %isfinite = scalar.isfinitef %a : f64
  %minimum_nan = scalar.isnanf %minimum : f64
  %maximum_nan = scalar.isnanf %maximum : f64
  func.return %minimum_bits, %maximum_bits, %minnum_bits, %maxnum_bits, %ordered_equal, %unordered, %isnan, %isinf, %isfinite, %minimum_nan, %maximum_nan : i64, i64, i64, i64, i1, i1, i1, i1, i1, i1, i1
}

check.case @float_boundaries_f64_zeros {
  %a = check.literal value(0) : i64
  %b = check.literal value(-9223372036854775808) : i64
  %minimum, %maximum, %minnum, %maxnum, %ordered_equal, %unordered, %isnan, %isinf, %isfinite, %minimum_nan, %maximum_nan = func.call @float_boundaries_f64(%a, %b) : (i64, i64) -> (i64, i64, i64, i64, i1, i1, i1, i1, i1, i1, i1)
  %expected_minimum = check.literal value(-9223372036854775808) : i64
