// Exercises extrema, predicates, fused arithmetic, clamp policies, and sign
// classification together. NaN results without a payload contract are
// canonicalized before comparison; operations with payload-preserving
// semantics retain their raw bits.

func.def inline @selector_f32_result_bits(%value: f32) -> (i32) {
  %bits = scalar.bitcast %value : f32 to i32
  %is_nan = scalar.isnanf %value : f32
  %nan_bits = scalar.constant 2143289344 : i32
  %observed = scf.select %is_nan, %nan_bits, %bits : i32
  func.return %observed : i32
}

func.def @selector_f32_observations(%a_entropy: i64, %b_entropy: i64, %c_entropy: i64, %output: buffer) {
  %a_bits = scalar.trunci %a_entropy : i64 to i32
  %b_bits = scalar.trunci %b_entropy : i64 to i32
  %c_bits = scalar.trunci %c_entropy : i64 to i32
  %a = scalar.bitcast %a_bits : i32 to f32
  %b = scalar.bitcast %b_bits : i32 to f32
  %c = scalar.bitcast %c_bits : i32 to f32

  %minimum = scalar.minimumf %a, %b : f32
  %maximum = scalar.maximumf %a, %b : f32
  %minnum = scalar.minnumf %a, %b : f32
  %maxnum = scalar.maxnumf %a, %b : f32
  %minimum_bits = func.call @selector_f32_result_bits(%minimum) : (f32) -> (i32)
  %maximum_bits = func.call @selector_f32_result_bits(%maximum) : (f32) -> (i32)
  %minnum_bits = func.call @selector_f32_result_bits(%minnum) : (f32) -> (i32)
  %maxnum_bits = func.call @selector_f32_result_bits(%maxnum) : (f32) -> (i32)

  %ordered_equal = scalar.cmpf oeq, %a, %b : f32
  %unordered = scalar.cmpf uno, %a, %b : f32
  %is_nan = scalar.isnanf %a : f32
  %is_infinite = scalar.isinff %a : f32
  %is_finite = scalar.isfinitef %a : f32
  %minimum_nan = scalar.isnanf %minimum : f32
  %maximum_nan = scalar.isnanf %maximum : f32
  %ordered_equal_bits = scalar.extui %ordered_equal : i1 to i32
  %unordered_bits = scalar.extui %unordered : i1 to i32
  %is_nan_bits = scalar.extui %is_nan : i1 to i32
  %is_infinite_bits = scalar.extui %is_infinite : i1 to i32
  %is_finite_bits = scalar.extui %is_finite : i1 to i32
  %minimum_nan_bits = scalar.extui %minimum_nan : i1 to i32
  %maximum_nan_bits = scalar.extui %maximum_nan : i1 to i32

  %product = scalar.mulf %a, %b : f32
  %separate = scalar.addf %product, %c : f32
  %fused = scalar.fmaf %a, %b, %c : f32
  %separate_bits = func.call @selector_f32_result_bits(%separate) : (f32) -> (i32)
  %fused_bits = func.call @selector_f32_result_bits(%fused) : (f32) -> (i32)

  %lower = scalar.constant 1.0 : f32
  %upper = scalar.constant 2.0 : f32
  %ordered = scalar.clampf<ordered> %a, %lower, %upper : f32
  %number = scalar.clampf<number> %a, %lower, %upper : f32
  %ieee = scalar.clampf<ieee> %a, %lower, %upper : f32
  %ordered_bits = scalar.bitcast %ordered : f32 to i32
  %number_bits = func.call @selector_f32_result_bits(%number) : (f32) -> (i32)
  %ieee_nan = scalar.isnanf %ieee : f32
  %ieee_nan_bits = scalar.extui %ieee_nan : i1 to i32

  %sign = scalar.signf %a : f32
  %sign_bits = scalar.bitcast %sign : f32 to i32

  %results = vector.from_elements %minimum_bits, %maximum_bits, %minnum_bits, %maxnum_bits, %ordered_equal_bits, %unordered_bits, %is_nan_bits, %is_infinite_bits, %is_finite_bits, %minimum_nan_bits, %maximum_nan_bits, %separate_bits, %fused_bits, %ordered_bits, %number_bits, %ieee_nan_bits, %sign_bits : vector<17xi32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<17xi32>
  vector.store %results, %result_view[0] : vector<17xi32>, view<17xi32>
  func.return
}

func.def inline @selector_f64_result_bits(%value: f64) -> (i64) {
  %bits = scalar.bitcast %value : f64 to i64
  %is_nan = scalar.isnanf %value : f64
  %nan_bits = scalar.constant 9221120237041090560 : i64
  %observed = scf.select %is_nan, %nan_bits, %bits : i64
  func.return %observed : i64
}

func.def @selector_f64_observations(%a_bits: i64, %b_bits: i64, %c_bits: i64, %output: buffer) {
  %a = scalar.bitcast %a_bits : i64 to f64
  %b = scalar.bitcast %b_bits : i64 to f64
  %c = scalar.bitcast %c_bits : i64 to f64

  %minimum = scalar.minimumf %a, %b : f64
  %maximum = scalar.maximumf %a, %b : f64
  %minnum = scalar.minnumf %a, %b : f64
  %maxnum = scalar.maxnumf %a, %b : f64
  %minimum_bits = func.call @selector_f64_result_bits(%minimum) : (f64) -> (i64)
  %maximum_bits = func.call @selector_f64_result_bits(%maximum) : (f64) -> (i64)
  %minnum_bits = func.call @selector_f64_result_bits(%minnum) : (f64) -> (i64)
  %maxnum_bits = func.call @selector_f64_result_bits(%maxnum) : (f64) -> (i64)

  %ordered_equal = scalar.cmpf oeq, %a, %b : f64
  %unordered = scalar.cmpf uno, %a, %b : f64
  %is_nan = scalar.isnanf %a : f64
  %is_infinite = scalar.isinff %a : f64
  %is_finite = scalar.isfinitef %a : f64
  %minimum_nan = scalar.isnanf %minimum : f64
  %maximum_nan = scalar.isnanf %maximum : f64
  %ordered_equal_bits = scalar.extui %ordered_equal : i1 to i64
  %unordered_bits = scalar.extui %unordered : i1 to i64
  %is_nan_bits = scalar.extui %is_nan : i1 to i64
  %is_infinite_bits = scalar.extui %is_infinite : i1 to i64
  %is_finite_bits = scalar.extui %is_finite : i1 to i64
  %minimum_nan_bits = scalar.extui %minimum_nan : i1 to i64
  %maximum_nan_bits = scalar.extui %maximum_nan : i1 to i64

  %product = scalar.mulf %a, %b : f64
  %separate = scalar.addf %product, %c : f64
  %fused = scalar.fmaf %a, %b, %c : f64
  %separate_bits = func.call @selector_f64_result_bits(%separate) : (f64) -> (i64)
  %fused_bits = func.call @selector_f64_result_bits(%fused) : (f64) -> (i64)

  %lower = scalar.constant 1.0 : f64
  %upper = scalar.constant 2.0 : f64
  %ordered = scalar.clampf<ordered> %a, %lower, %upper : f64
  %number = scalar.clampf<number> %a, %lower, %upper : f64
  %ieee = scalar.clampf<ieee> %a, %lower, %upper : f64
  %ordered_bits = scalar.bitcast %ordered : f64 to i64
  %number_bits = func.call @selector_f64_result_bits(%number) : (f64) -> (i64)
  %ieee_nan = scalar.isnanf %ieee : f64
  %ieee_nan_bits = scalar.extui %ieee_nan : i1 to i64

  %sign = scalar.signf %a : f64
  %sign_bits = scalar.bitcast %sign : f64 to i64

  %results = vector.from_elements %minimum_bits, %maximum_bits, %minnum_bits, %maxnum_bits, %ordered_equal_bits, %unordered_bits, %is_nan_bits, %is_infinite_bits, %is_finite_bits, %minimum_nan_bits, %maximum_nan_bits, %separate_bits, %fused_bits, %ordered_bits, %number_bits, %ieee_nan_bits, %sign_bits : vector<17xi64>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<17xi64>
  vector.store %results, %result_view[0] : vector<17xi64>, view<17xi64>
  func.return
}

check.scenario @selector_f32_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %a = check.literal value(0) : i64
    %b = check.literal value(-2147483648) : i64
    %c = check.literal value(-1082130432) : i64
    %output = check.generate.fill value(-1) : tensor<17xi32>
    check.compare<@selector_f32_observations>(%a, %b, %c, %output) : (i64, i64, i64, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %a = check.literal value(-4194304) : i64
    %b = check.literal value(1065353216) : i64
    %c = check.literal value(-1082130432) : i64
    %output = check.generate.fill value(-1) : tensor<17xi32>
    check.compare<@selector_f32_observations>(%a, %b, %c, %output) : (i64, i64, i64, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %a = check.literal value(1065353217) : i64
    %b = check.literal value(1065353214) : i64
    %c = check.literal value(-1082130432) : i64
    %output = check.generate.fill value(-1) : tensor<17xi32>
    check.compare<@selector_f32_observations>(%a, %b, %c, %output) : (i64, i64, i64, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %a_source = check.entropy.fork %entropy name("a") : check.entropy
    %b_source = check.entropy.fork %entropy name("b") : check.entropy
    %c_source = check.entropy.fork %entropy name("c") : check.entropy
    %a = check.entropy.read %a_source[%trial] : check.entropy -> i64
    %b = check.entropy.read %b_source[%trial] : check.entropy -> i64
    %c = check.entropy.read %c_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(-1) : tensor<17xi32>
    check.compare<@selector_f32_observations>(%a, %b, %c, %output) : (i64, i64, i64, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
    }
  }
  check.return
}

