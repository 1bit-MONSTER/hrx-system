check.case @clamp_nan_f64_case {
  %bits = check.literal value(-2251799813685248) : i64
  %lower = check.literal value(1.0) : f64
  %upper = check.literal value(2.0) : f64
  %ordered_bits, %number, %ieee_nan = func.call @clamp_nan_f64(%bits, %lower, %upper) : (i64, f64, f64) -> (i64, f64, i1)
