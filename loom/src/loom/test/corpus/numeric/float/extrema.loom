// Raw operands preserve signed zeros, subnormals and signaling NaNs. Arithmetic
// NaN payloads are unspecified, so normalize only NaN results for comparison.
kernel.def @float_extrema_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs_bits: i32, %rhs_bits: i32, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %output : buffer
  %view = buffer.view %global[%base] : buffer -> view<4xi32>
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %nan_bits = scalar.constant 2143289344 : i32
  %minimumf = scalar.minimumf %lhs, %rhs : f32
  %minimumf_bits = scalar.bitcast %minimumf : f32 to i32
  %minimumf_nan = scalar.cmpf uno, %minimumf, %minimumf : f32
  %minimumf_observed = scf.select %minimumf_nan, %nan_bits, %minimumf_bits : i32
  view.store %minimumf_observed, %view[0] : i32, view<4xi32>
  %maximumf = scalar.maximumf %lhs, %rhs : f32
  %maximumf_bits = scalar.bitcast %maximumf : f32 to i32
  %maximumf_nan = scalar.cmpf uno, %maximumf, %maximumf : f32
  %maximumf_observed = scf.select %maximumf_nan, %nan_bits, %maximumf_bits : i32
  view.store %maximumf_observed, %view[1] : i32, view<4xi32>
  %minnumf = scalar.minnumf %lhs, %rhs : f32
  %minnumf_bits = scalar.bitcast %minnumf : f32 to i32
  %minnumf_nan = scalar.cmpf uno, %minnumf, %minnumf : f32
  %minnumf_observed = scf.select %minnumf_nan, %nan_bits, %minnumf_bits : i32
  view.store %minnumf_observed, %view[2] : i32, view<4xi32>
  %maxnumf = scalar.maxnumf %lhs, %rhs : f32
  %maxnumf_bits = scalar.bitcast %maxnumf : f32 to i32
  %maxnumf_nan = scalar.cmpf uno, %maxnumf, %maxnumf : f32
  %maxnumf_observed = scf.select %maxnumf_nan, %nan_bits, %maxnumf_bits : i32
  view.store %maxnumf_observed, %view[3] : i32, view<4xi32>
  kernel.return
}

check.case public @float_extrema_finite {
  %lhs = check.literal value(-1082130432) : i32
  %rhs = check.literal value(1073741824) : i32
  %output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @float_extrema_f32(%lhs, %rhs, %output) : (i32, i32, tensor<4xi32>)
  %actual_0 = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<1xi32>
  %expected_0 = check.generate.fill value(-1082130432) : tensor<1xi32>
  check.expect.bitwise actual(%actual_0) expected(%expected_0) : tensor<1xi32>
  %actual_1 = check.tensor.view %output offset(4) : tensor<4xi32> -> tensor<1xi32>
  %expected_1 = check.generate.fill value(1073741824) : tensor<1xi32>
  check.expect.bitwise actual(%actual_1) expected(%expected_1) : tensor<1xi32>
  %actual_2 = check.tensor.view %output offset(8) : tensor<4xi32> -> tensor<1xi32>
  %expected_2 = check.generate.fill value(-1082130432) : tensor<1xi32>
  check.expect.bitwise actual(%actual_2) expected(%expected_2) : tensor<1xi32>
  %actual_3 = check.tensor.view %output offset(12) : tensor<4xi32> -> tensor<1xi32>
  %expected_3 = check.generate.fill value(1073741824) : tensor<1xi32>
  check.expect.bitwise actual(%actual_3) expected(%expected_3) : tensor<1xi32>
  check.return
}

