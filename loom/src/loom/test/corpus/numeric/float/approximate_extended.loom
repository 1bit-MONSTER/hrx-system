// Representative normal inputs exercise approximate scalar and vector
// transcendental instructions without imposing target-specific behavior for
// subnormals. Number extrema use NaN operands to observe finite-value selection.
kernel.def @approximate_extended_math_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %global[%base] : buffer -> view<18xf32>

  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %c2 = scalar.constant 2.0 : f32
  %cn3 = scalar.constant -3.0 : f32
  %ln_two = scalar.constant 0.69314718055994529 : f32
  %e = scalar.constant 2.7182818284590451 : f32
  %nan_bits = scalar.constant 2143289344 : i32
  %nan = scalar.bitcast %nan_bits : i32 to f32

  %scalar_exp = scalar.expf<afn> %ln_two : f32
  %scalar_log = scalar.logf<afn> %e : f32
  %scalar_exp2 = scalar.exp2f<afn> %c1 : f32
  %scalar_log2 = scalar.log2f<afn> %c2 : f32
  view.store %scalar_exp, %results[0] : f32, view<18xf32>
  view.store %scalar_log, %results[1] : f32, view<18xf32>
  view.store %scalar_exp2, %results[2] : f32, view<18xf32>
  view.store %scalar_log2, %results[3] : f32, view<18xf32>

  %exp_inputs = vector.from_elements %c0, %ln_two : vector<2xf32>
  %log_inputs = vector.from_elements %c1, %e : vector<2xf32>
  %base_two_inputs = vector.from_elements %c0, %c1 : vector<2xf32>
  %log_two_inputs = vector.from_elements %c1, %c2 : vector<2xf32>
  %vector_exp = vector.expf<afn> %exp_inputs : vector<2xf32>
  %vector_log = vector.logf<afn> %log_inputs : vector<2xf32>
  %vector_exp2 = vector.exp2f<afn> %base_two_inputs : vector<2xf32>
  %vector_log2 = vector.log2f<afn> %log_two_inputs : vector<2xf32>
  vector.store %vector_exp, %results[4] : vector<2xf32>, view<18xf32>
  vector.store %vector_log, %results[6] : vector<2xf32>, view<18xf32>
  vector.store %vector_exp2, %results[8] : vector<2xf32>, view<18xf32>
  vector.store %vector_log2, %results[10] : vector<2xf32>, view<18xf32>

  %extrema_lhs = vector.from_elements %nan, %c2 : vector<2xf32>
  %extrema_rhs = vector.from_elements %c1, %cn3 : vector<2xf32>
  %vector_min = vector.minnumf<nsz> %extrema_lhs, %extrema_rhs : vector<2xf32>
  %vector_max = vector.maxnumf<nsz> %extrema_lhs, %extrema_rhs : vector<2xf32>
  vector.store %vector_min, %results[12] : vector<2xf32>, view<18xf32>
  vector.store %vector_max, %results[14] : vector<2xf32>, view<18xf32>

  %scalar_min = scalar.minnumf<nsz> %nan, %c1 : f32
  %scalar_max = scalar.maxnumf<nsz> %nan, %c1 : f32
  view.store %scalar_min, %results[16] : f32, view<18xf32>
  view.store %scalar_max, %results[17] : f32, view<18xf32>
  kernel.return
}

check.case public @approximate_extended_math_f32_case {
  %output = check.generate.fill value(-1000.0) : tensor<18xf32>
  kernel.launch @approximate_extended_math_f32(%output) : (tensor<18xf32>)

  %scalar_exp = check.tensor.view %output offset(0) : tensor<18xf32> -> tensor<1xf32>
  %expected_two = check.generate.fill value(2.0) : tensor<1xf32>
  check.expect.close actual(%scalar_exp) expected(%expected_two) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<1xf32>
  %scalar_log = check.tensor.view %output offset(4) : tensor<18xf32> -> tensor<1xf32>
  %expected_one = check.generate.fill value(1.0) : tensor<1xf32>
  check.expect.close actual(%scalar_log) expected(%expected_one) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<1xf32>
  %scalar_exp2 = check.tensor.view %output offset(8) : tensor<18xf32> -> tensor<1xf32>
  check.expect.close actual(%scalar_exp2) expected(%expected_two) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<1xf32>
  %scalar_log2 = check.tensor.view %output offset(12) : tensor<18xf32> -> tensor<1xf32>
  check.expect.close actual(%scalar_log2) expected(%expected_one) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<1xf32>

  %vector_exp = check.tensor.view %output offset(16) : tensor<18xf32> -> tensor<2xf32>
  %expected_one_two = check.generate.iota offset(1.0) step(1.0) : tensor<2xf32>
  check.expect.close actual(%vector_exp) expected(%expected_one_two) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<2xf32>
  %vector_log = check.tensor.view %output offset(24) : tensor<18xf32> -> tensor<2xf32>
  %expected_zero_one = check.generate.iota offset(0.0) step(1.0) : tensor<2xf32>
  check.expect.close actual(%vector_log) expected(%expected_zero_one) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<2xf32>
  %vector_exp2 = check.tensor.view %output offset(32) : tensor<18xf32> -> tensor<2xf32>
  check.expect.close actual(%vector_exp2) expected(%expected_one_two) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<2xf32>
  %vector_log2 = check.tensor.view %output offset(40) : tensor<18xf32> -> tensor<2xf32>
  check.expect.close actual(%vector_log2) expected(%expected_zero_one) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<2xf32>

  %vector_min = check.tensor.view %output offset(48) : tensor<18xf32> -> tensor<2xf32>
  %expected_min = check.generate.iota offset(1.0) step(-4.0) : tensor<2xf32>
  check.expect.close actual(%vector_min) expected(%expected_min) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  %vector_max = check.tensor.view %output offset(56) : tensor<18xf32> -> tensor<2xf32>
  check.expect.close actual(%vector_max) expected(%expected_one_two) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  %scalar_extrema = check.tensor.view %output offset(64) : tensor<18xf32> -> tensor<2xf32>
  %expected_ones = check.generate.fill value(1.0) : tensor<2xf32>
  check.expect.close actual(%scalar_extrema) expected(%expected_ones) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  check.return
}
