// Mixed floating and predicate results preserve their logical types and source
// order across the function boundary.
func.def public @logical_constants() -> (f32, f64, i1, i1) {
  %narrow = scalar.constant 1.25 : f32
  %wide = scalar.constant 4294967297.5 : f64
  %yes = scalar.constant true : i1
  %no = scalar.constant false : i1
  func.return %narrow, %wide, %yes, %no : f32, f64, i1, i1
}

check.case @logical_constants_case {
  %narrow, %wide, %yes, %no = func.call @logical_constants() : () -> (f32, f64, i1, i1)
  %expected_narrow = check.literal value(1.25) : f32
  %expected_wide = check.literal value(4294967297.5) : f64
  %expected_yes = check.literal value(true) : i1
  %expected_no = check.literal value(false) : i1
  check.expect.equal actual(%narrow) expected(%expected_narrow) : f32
  check.expect.equal actual(%wide) expected(%expected_wide) : f64
  check.expect.equal actual(%yes) expected(%expected_yes) : i1
  check.expect.equal actual(%no) expected(%expected_no) : i1
  check.return
}

func.def public @float_arithmetic_f32(%a: f32, %b: f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
  %sum = scalar.addf %a, %b : f32
  %difference = scalar.subf %a, %b : f32
  %product = scalar.mulf %a, %b : f32
  %quotient = scalar.divf %a, %b : f32
  %remainder = scalar.remf %a, %b : f32
  %signed = scalar.copysignf %a, %b : f32
  %negated = scalar.negf %a : f32
  %absolute = scalar.absf %a : f32
  func.return %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute : f32, f32, f32, f32, f32, f32, f32, f32
}

check.case @float_arithmetic_f32_case {
  %a = check.literal value(9.0) : f32
  %b = check.literal value(-2.0) : f32
  %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute = func.call @float_arithmetic_f32(%a, %b) : (f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32)
  %expected_sum = check.literal value(7.0) : f32
  check.expect.equal actual(%sum) expected(%expected_sum) : f32
  %expected_difference = check.literal value(11.0) : f32
  check.expect.equal actual(%difference) expected(%expected_difference) : f32
  %expected_product = check.literal value(-18.0) : f32
  check.expect.equal actual(%product) expected(%expected_product) : f32
  %expected_quotient = check.literal value(-4.5) : f32
  check.expect.equal actual(%quotient) expected(%expected_quotient) : f32
  %expected_remainder = check.literal value(1.0) : f32
  check.expect.equal actual(%remainder) expected(%expected_remainder) : f32
  %expected_signed = check.literal value(-9.0) : f32
  check.expect.equal actual(%signed) expected(%expected_signed) : f32
  %expected_negated = check.literal value(-9.0) : f32
  check.expect.equal actual(%negated) expected(%expected_negated) : f32
  %expected_absolute = check.literal value(9.0) : f32
  check.expect.equal actual(%absolute) expected(%expected_absolute) : f32
  check.return
}

func.def public @float_arithmetic_f64(%a: f64, %b: f64) -> (f64, f64, f64, f64, f64, f64, f64, f64) {
  %sum = scalar.addf %a, %b : f64
  %difference = scalar.subf %a, %b : f64
  %product = scalar.mulf %a, %b : f64
  %quotient = scalar.divf %a, %b : f64
  %remainder = scalar.remf %a, %b : f64
  %signed = scalar.copysignf %a, %b : f64
  %negated = scalar.negf %a : f64
  %absolute = scalar.absf %a : f64
  func.return %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute : f64, f64, f64, f64, f64, f64, f64, f64
}

check.case @float_arithmetic_f64_case {
  %a = check.literal value(4294967297.0) : f64
  %b = check.literal value(-2.0) : f64
  %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute = func.call @float_arithmetic_f64(%a, %b) : (f64, f64) -> (f64, f64, f64, f64, f64, f64, f64, f64)
  %expected_sum = check.literal value(4294967295.0) : f64
  check.expect.equal actual(%sum) expected(%expected_sum) : f64
  %expected_difference = check.literal value(4294967299.0) : f64
  check.expect.equal actual(%difference) expected(%expected_difference) : f64
  %expected_product = check.literal value(-8589934594.0) : f64
  check.expect.equal actual(%product) expected(%expected_product) : f64
  %expected_quotient = check.literal value(-2147483648.5) : f64
  check.expect.equal actual(%quotient) expected(%expected_quotient) : f64
  %expected_remainder = check.literal value(1.0) : f64
  check.expect.equal actual(%remainder) expected(%expected_remainder) : f64
  %expected_signed = check.literal value(-4294967297.0) : f64
  check.expect.equal actual(%signed) expected(%expected_signed) : f64
  %expected_negated = check.literal value(-4294967297.0) : f64
  check.expect.equal actual(%negated) expected(%expected_negated) : f64
  %expected_absolute = check.literal value(4294967297.0) : f64
  check.expect.equal actual(%absolute) expected(%expected_absolute) : f64
  check.return
}
