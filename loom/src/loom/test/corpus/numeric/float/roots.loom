// Exercises scalar and vector square roots across directed IEEE-754 boundaries
// and deterministic full-width entropy. Exact cases separately preserve signed
// zero and infinity result bits.

func.def @root_observations(%first_bits: i32, %second_bits: i32, %output: buffer) {
  %first = scalar.bitcast %first_bits : i32 to f32
  %second = scalar.bitcast %second_bits : i32 to f32
  %scalar_root = scalar.sqrtf %first : f32
  %scalar_inverse = scalar.rsqrtf %first : f32
  %values = vector.from_elements %first, %second : vector<2xf32>
  %roots = vector.sqrtf %values : vector<2xf32>
  %root0 = vector.extract %roots[0] : vector<2xf32> -> f32
  %root1 = vector.extract %roots[1] : vector<2xf32> -> f32
  %inverses = vector.rsqrtf %values : vector<2xf32>
  %inverse0 = vector.extract %inverses[0] : vector<2xf32> -> f32
  %inverse1 = vector.extract %inverses[1] : vector<2xf32> -> f32
  %results = vector.from_elements %scalar_root, %scalar_inverse, %root0, %root1, %inverse0, %inverse1 : vector<6xf32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<6xf32>
  vector.store %results, %result_view[0] : vector<6xf32>, view<6xf32>
  func.return
}

func.def @root_entropy_observations(%first_entropy: i64, %second_entropy: i64, %output: buffer) {
  %first_bits = scalar.trunci %first_entropy : i64 to i32
  %second_bits = scalar.trunci %second_entropy : i64 to i32
  func.call @root_observations(%first_bits, %second_bits, %output) : (i32, i32, buffer)
  func.return
}

func.def @root_boundary_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %c11 = index.constant 11 : index
  %c12 = index.constant 12 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index
  %is10 = index.cmp eq, %ordinal, %c10 : index
  %is11 = index.cmp eq, %ordinal, %c11 : index
  %is12 = index.cmp eq, %ordinal, %c12 : index
  %value0 = scalar.constant 1 : i32
  %value1 = scalar.constant 2 : i32
  %value2 = scalar.constant 8388607 : i32
  %value3 = scalar.constant 8388608 : i32
  %value4 = scalar.constant 8388609 : i32
  %value5 = scalar.constant 1073741824 : i32
  %value6 = scalar.constant 1091567616 : i32
  %value7 = scalar.constant 2139095039 : i32
  %value8 = scalar.constant -2147483647 : i32
  %value9 = scalar.constant -1082130432 : i32
  %value10 = scalar.constant 2143289344 : i32
  %value11 = scalar.constant -4194304 : i32
  %value12 = scalar.constant 2139095041 : i32
  %value13 = scalar.constant -8388607 : i32
  %bits0 = scf.select %is0, %value0, %value13 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %bits3 = scf.select %is3, %value3, %bits2 : i32
  %bits4 = scf.select %is4, %value4, %bits3 : i32
  %bits5 = scf.select %is5, %value5, %bits4 : i32
  %bits6 = scf.select %is6, %value6, %bits5 : i32
  %bits7 = scf.select %is7, %value7, %bits6 : i32
  %bits8 = scf.select %is8, %value8, %bits7 : i32
  %bits9 = scf.select %is9, %value9, %bits8 : i32
  %bits10 = scf.select %is10, %value10, %bits9 : i32
  %bits11 = scf.select %is11, %value11, %bits10 : i32
  %bits12 = scf.select %is12, %value12, %bits11 : i32
  %second_bits = scalar.constant 1082130432 : i32
  func.call @root_observations(%bits12, %second_bits, %output) : (i32, i32, buffer)
  func.return
}

func.def @root_exact_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %value0 = scalar.constant 0 : i32
  %value1 = scalar.constant -2147483648 : i32
  %value2 = scalar.constant 2139095040 : i32
  %bits0 = scf.select %is0, %value0, %value2 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %input = scalar.bitcast %bits1 : i32 to f32
  %root = scalar.sqrtf %input : f32
  %inverse = scalar.rsqrtf %input : f32
  %root_bits = scalar.bitcast %root : f32 to i32
  %inverse_bits = scalar.bitcast %inverse : f32 to i32
  %results = vector.from_elements %root_bits, %inverse_bits : vector<2xi32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %results, %result_view[0] : vector<2xi32>, view<2xi32>
  func.return
}

check.scenario @root_values {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@root_exact_observations>(%trial, %output) : (index, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[14](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0.0) : tensor<6xf32>
    check.compare<@root_boundary_observations>(%trial, %output) : (index, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6xf32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %first_source = check.entropy.fork %entropy name("first") : check.entropy
    %second_source = check.entropy.fork %entropy name("second") : check.entropy
    %first_bits = check.entropy.read %first_source[%trial] : check.entropy -> i64
    %second_bits = check.entropy.read %second_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0.0) : tensor<6xf32>
    check.compare<@root_entropy_observations>(%first_bits, %second_bits, %output) : (i64, i64, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6xf32>
    }
  }
  check.return
}
