func.def public @compare_f64(%a_bits: i64, %b_bits: i64) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %a = scalar.bitcast %a_bits : i64 to f64
  %b = scalar.bitcast %b_bits : i64 to f64
  %oeq = scalar.cmpf oeq, %a, %b : f64
  %ogt = scalar.cmpf ogt, %a, %b : f64
  %oge = scalar.cmpf oge, %a, %b : f64
  %olt = scalar.cmpf olt, %a, %b : f64
  %ole = scalar.cmpf ole, %a, %b : f64
  %one = scalar.cmpf one, %a, %b : f64
  %ord = scalar.cmpf ord, %a, %b : f64
  %ueq = scalar.cmpf ueq, %a, %b : f64
  %ugt = scalar.cmpf ugt, %a, %b : f64
  %uge = scalar.cmpf uge, %a, %b : f64
  %ult = scalar.cmpf ult, %a, %b : f64
  %ule = scalar.cmpf ule, %a, %b : f64
  %une = scalar.cmpf une, %a, %b : f64
  %uno = scalar.cmpf uno, %a, %b : f64
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

