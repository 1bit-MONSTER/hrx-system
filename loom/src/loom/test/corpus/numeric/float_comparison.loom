// Bit-pattern arguments preserve NaN payloads, signs, and subnormals at the
// invocation boundary. The checks assert IEEE predicates, not NaN propagation.
func.def public @compare_f32(%a_bits: i32, %b_bits: i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %a = scalar.bitcast %a_bits : i32 to f32
  %b = scalar.bitcast %b_bits : i32 to f32
  %oeq = scalar.cmpf oeq, %a, %b : f32
  %ogt = scalar.cmpf ogt, %a, %b : f32
  %oge = scalar.cmpf oge, %a, %b : f32
  %olt = scalar.cmpf olt, %a, %b : f32
  %ole = scalar.cmpf ole, %a, %b : f32
  %one = scalar.cmpf one, %a, %b : f32
  %ord = scalar.cmpf ord, %a, %b : f32
  %ueq = scalar.cmpf ueq, %a, %b : f32
  %ugt = scalar.cmpf ugt, %a, %b : f32
  %uge = scalar.cmpf uge, %a, %b : f32
  %ult = scalar.cmpf ult, %a, %b : f32
  %ule = scalar.cmpf ule, %a, %b : f32
  %une = scalar.cmpf une, %a, %b : f32
  %uno = scalar.cmpf uno, %a, %b : f32
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

check.case @compare_f32_equal {
  // -inf, -1, -min_subnormal, -0, +0, +min_subnormal, +1, +inf.
  %value = check.param.choice values([-8388608, -1082130432, -2147483647, -2147483648, 0, 1, 1065353216, 2139095040]) : i32
  %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno = func.call @compare_f32(%value, %value) : (i32, i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1)
  %yes = check.literal value(true) : i1
  %no = check.literal value(false) : i1
  check.expect.equal actual(%oeq) expected(%yes) : i1
  check.expect.equal actual(%ogt) expected(%no) : i1
  check.expect.equal actual(%oge) expected(%yes) : i1
  check.expect.equal actual(%olt) expected(%no) : i1
  check.expect.equal actual(%ole) expected(%yes) : i1
  check.expect.equal actual(%one) expected(%no) : i1
  check.expect.equal actual(%ord) expected(%yes) : i1
  check.expect.equal actual(%ueq) expected(%yes) : i1
  check.expect.equal actual(%ugt) expected(%no) : i1
  check.expect.equal actual(%uge) expected(%yes) : i1
  check.expect.equal actual(%ult) expected(%no) : i1
  check.expect.equal actual(%ule) expected(%yes) : i1
  check.expect.equal actual(%une) expected(%no) : i1
  check.expect.equal actual(%uno) expected(%no) : i1
  check.return
}

