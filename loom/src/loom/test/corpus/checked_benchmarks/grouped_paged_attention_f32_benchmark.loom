kernel.decl @grouped_paged_attention_independent(%workload_pair_count: index) launch(%launch_pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

kernel.decl @grouped_paged_attention_shared_serial(%workload_pair_count: index) launch(%launch_pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

kernel.decl @grouped_paged_attention_shared(%workload_pair_count: index) launch(%launch_pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

// One dispatch per timing case, with the same 64 MiB K/V pool and page-table
// allocation for every policy. Zero queries give max=0 and denominator=length;
// channel-periodic values give an exact normalized output for any page order.
// The checks above separately distinguish queries, pages, masks and recurrence.
check.case public @grouped_paged_attention_independent_n128 {
  %pairs = check.param.choice values([1, 128, 1024]) name("pairs") : index
  %seed = check.literal value(7451) : i64
  %lengths = check.generate.fill value(128) : tensor<[%pairs]x2xi32>
  %query = check.generate.fill value(0.0) : tensor<[%pairs]x2x128xf32>
  %pages = check.generate.random.uniform seed(%seed) range(0 to 4095) : tensor<[%pairs]x64xi32>
  %keys = check.generate.iota offset(-0.5) step(0.00390625) period(257) : tensor<65536x128xf32>
  %values = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<65536x128xf32>
  %state = check.generate.fill value(-10000.0) : tensor<[%pairs]x2x2xf32>
  %output = check.generate.fill value(-20000.0) : tensor<[%pairs]x2x128xf32>
  %expected_state = check.generate.iota offset(0.0) step(128.0) period(2) : tensor<[%pairs]x2x2xf32>
  %expected_output = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<[%pairs]x2x128xf32>
  kernel.launch @grouped_paged_attention_independent[%pairs](%pairs, %lengths, %query, %pages, %keys, %values, %state, %output) : [index](index, tensor<[%pairs]x2xi32>, tensor<[%pairs]x2x128xf32>, tensor<[%pairs]x64xi32>, tensor<65536x128xf32>, tensor<65536x128xf32>, tensor<[%pairs]x2x2xf32>, tensor<[%pairs]x2x128xf32>)
  check.expect.close actual(%state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%pairs]x2x2xf32>
  check.expect.close actual(%output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%pairs]x2x128xf32>
  check.return
}

