// Ordered f32 accumulation of [2^24, 1, -(2^24-2)] returns 2: adding 1 to
// 2^24 rounds back to 2^24. Reversing the order returns 3. This distinguishes
// recurrence order from the exactly representable sums in the route controls.
check.case public @moe_routed_combine_loop_rounding_order {
  %count = check.literal value(3) : index
  %ids = check.generate.fill value(0) : tensor<32xi32>
  %weights = check.generate.iota offset(16777216.0) step(-16777215.0) period(3) : tensor<32xf32>
  %payloads = check.generate.fill value(1.0) : tensor<4x4xf32>
  %actual = check.generate.fill value(-1000.0) : tensor<4xf32>
  %expected = check.generate.fill value(2.0) : tensor<4xf32>
  kernel.launch @moe_routed_combine_loop_f32(%count, %ids, %weights, %payloads, %actual) : (index, tensor<32xi32>, tensor<32xf32>, tensor<4x4xf32>, tensor<4xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.benchmark<@moe_routed_combine_loop_n32> @moe_routed_combine_loop
