kernel.decl @cooperative_paged_attention_serial(%workload_instance_count: index) launch(%launch_instance_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

kernel.decl @cooperative_paged_attention_pipelined(%workload_instance_count: index) launch(%launch_instance_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

// One kernel per timing case. Zero queries make every score zero and denominator
// equal to the sequence length. Values repeat by channel, giving an exact output
// independent of the sampled page order while retaining the full cache footprint.
// The varied and analytic cases above separately verify physical row identity.
check.case public @cooperative_paged_attention_serial_n128 {
  %instances = check.param.choice values([1, 16, 256]) name("instances") : index
  %seed = check.literal value(7401) : i64
  %lengths = check.generate.fill value(128) : tensor<[%instances]xi32>
  %query = check.generate.fill value(0.0) : tensor<[%instances]x128xf32>
  %pages = check.generate.random.uniform seed(%seed) range(0 to 255) : tensor<[%instances]x64xi32>
  %keys = check.generate.iota offset(-0.5) step(0.00390625) period(257) : tensor<4096x128xf32>
  %values = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<4096x128xf32>
  %state = check.generate.fill value(-10000.0) : tensor<[%instances]x2xf32>
  %output = check.generate.fill value(-20000.0) : tensor<[%instances]x128xf32>
  %expected_state = check.generate.iota offset(0.0) step(128.0) period(2) : tensor<[%instances]x2xf32>
  %expected_output = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<[%instances]x128xf32>
  kernel.launch @cooperative_paged_attention_serial[%instances](%instances, %lengths, %query, %pages, %keys, %values, %state, %output) : [index](index, tensor<[%instances]xi32>, tensor<[%instances]x128xf32>, tensor<[%instances]x64xi32>, tensor<4096x128xf32>, tensor<4096x128xf32>, tensor<[%instances]x2xf32>, tensor<[%instances]x128xf32>)
  check.expect.close actual(%state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x128xf32>
  check.return
}

check.benchmark<@cooperative_paged_attention_serial_n128> @cooperative_paged_attention_serial_n128_i1 {instances = 1}

check.benchmark<@cooperative_paged_attention_serial_n128> @cooperative_paged_attention_serial_n128_i16 {instances = 16}

check.benchmark<@cooperative_paged_attention_serial_n128> @cooperative_paged_attention_serial_n128_i256 {instances = 256}

