  %expected_output = check.generate.iota offset(126.84375) step(0.03125) : tensor<1x128xf32>
  kernel.launch @cooperative_paged_attention_serial[%instances](%instances, %lengths, %query, %pages, %keys, %values, %serial_state, %serial_output) : [index](index, tensor<1xi32>, tensor<1x128xf32>, tensor<1x64xi32>, tensor<48x128xf32>, tensor<48x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
  kernel.launch @cooperative_paged_attention_pipelined[%instances](%instances, %lengths, %query, %pages, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, tensor<1xi32>, tensor<1x128xf32>, tensor<1x64xi32>, tensor<48x128xf32>, tensor<48x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
