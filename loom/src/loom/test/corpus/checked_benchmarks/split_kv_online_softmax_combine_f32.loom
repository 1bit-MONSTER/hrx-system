// Builds the non-affine indirection arrays for the padded semantic case.
// Fixture setup stays outside all timed cases.
kernel.def @split_kv_stage2_initialize_metadata() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%query_offsets: buffer, %kv_offsets: buffer, %split_offsets: buffer, %valid_split_count: buffer) {
  %base = index.constant 0 : offset
  %query_offset_view = buffer.view %query_offsets[%base] : buffer -> view<4xi32>
  %kv_offset_view = buffer.view %kv_offsets[%base] : buffer -> view<4xi32>
  %split_offset_view = buffer.view %split_offsets[%base] : buffer -> view<4xi32>
  %valid_split_view = buffer.view %valid_split_count[%base] : buffer -> view<3xi32>
  %c0 = scalar.constant 0 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c8 = scalar.constant 8 : i32
  %c11 = scalar.constant 11 : i32
  %c64 = scalar.constant 64 : i32
  %c80 = scalar.constant 80 : i32
  %c144 = scalar.constant 144 : i32
  view.store %c0, %query_offset_view[0] : i32, view<4xi32>
  view.store %c2, %query_offset_view[1] : i32, view<4xi32>
  view.store %c3, %query_offset_view[2] : i32, view<4xi32>
  view.store %c5, %query_offset_view[3] : i32, view<4xi32>
  view.store %c0, %kv_offset_view[0] : i32, view<4xi32>
  view.store %c64, %kv_offset_view[1] : i32, view<4xi32>
  view.store %c80, %kv_offset_view[2] : i32, view<4xi32>
  view.store %c144, %kv_offset_view[3] : i32, view<4xi32>
  view.store %c0, %split_offset_view[0] : i32, view<4xi32>
  view.store %c4, %split_offset_view[1] : i32, view<4xi32>
  view.store %c8, %split_offset_view[2] : i32, view<4xi32>
  view.store %c11, %split_offset_view[3] : i32, view<4xi32>
  view.store %c2, %valid_split_view[0] : i32, view<3xi32>
  view.store %c3, %valid_split_view[1] : i32, view<3xi32>
  view.store %c4, %valid_split_view[2] : i32, view<3xi32>
  kernel.return
}

// Writes only active logical payloads through flat physical addresses. The
// reduction consumes the same storage through runtime strided views, keeping
// fixture construction independent of the address-layout implementation.
kernel.def @split_kv_stage2_initialize_padded_payload() {
  %queries = index.constant 5 : index
  %heads = index.constant 2 : index
  %splits = index.constant 4 : index
  %unit = index.constant 1 : index
  %workgroup_width = index.constant 256 : index
  kernel.launch.config workgroups(%queries, %heads, %splits) workgroup_size(%workgroup_width, %unit, %unit) : index
} launch(%partial_output: buffer, %partial_lse: buffer) {
  %query = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %split = kernel.workgroup.id<z> : index
  %local_id = kernel.workitem.id<x> : index
  %channel0 = index.assume %local_id [range(%local_id, 0, 255)] : index
  %channel_offset = index.constant 256 : index
  %channel1 = index.add %channel0, %channel_offset : index
  %value_width = index.constant 512 : index
  %query_split = index.constant 2 : index
  %third_query = index.constant 3 : index
  %first_sequence = index.cmp ult, %query, %query_split : index
  %second_sequence = index.cmp ult, %query, %third_query : index
  %valid_splits = scf.if %first_sequence -> (index) {
    scf.yield %query_split : index
  } else {
    %remaining = scf.if %second_sequence -> (index) {
      %single = index.constant 1 : index
      scf.yield %single : index
    } else {
      scf.yield %third_query : index
    }
    scf.yield %remaining : index
  }
  %active = index.cmp ult, %split, %valid_splits : index
  scf.if %active {
    %base = index.constant 0 : offset
    %partial_output_view = buffer.view %partial_output[%base] : buffer -> view<75776xf32>
    %partial_lse_view = buffer.view %partial_lse[%base] : buffer -> view<148xf32>
    %batch_stride = index.constant 31 : index
    %split_stride = index.constant 7 : index
    %head_stride = index.constant 2 : index
    %query_offset = index.mul %query, %batch_stride : index
    %split_offset = index.mul %split, %split_stride : index
    %head_offset = index.mul %head, %head_stride : index
    %query_split_offset = index.add %query_offset, %split_offset : index
    %lse_offset = index.add %query_split_offset, %head_offset : index
    %value_base = index.mul %lse_offset, %value_width : index
    %physical0 = index.add %value_base, %channel0 : index
    %physical1 = index.add %value_base, %channel1 : index
    %logical_row = index.madd %query, %query_split, %head : index
    %logical_base = index.mul %logical_row, %value_width : index
    %logical0 = index.add %logical_base, %channel0 : index
    %logical1 = index.add %logical_base, %channel1 : index
    %period = index.constant 127 : index
    %periodic0 = index.rem %logical0, %period : index
    %periodic1 = index.rem %logical1, %period : index
    %periodic0_i32 = index.cast %periodic0 : index to i32
    %periodic1_i32 = index.cast %periodic1 : index to i32
    %value0 = scalar.sitofp %periodic0_i32 : i32 to f32
    %value1 = scalar.sitofp %periodic1_i32 : i32 to f32
    view.store %value0, %partial_output_view[%physical0] : f32, view<75776xf32>
    view.store %value1, %partial_output_view[%physical1] : f32, view<75776xf32>
    %leader_index = index.constant 0 : index
    %leader = index.cmp eq, %channel0, %leader_index : index
    scf.if %leader {
      %split_i32 = index.cast %split : index to i32
      %score = scalar.sitofp %split_i32 : i32 to f32
      view.store %score, %partial_lse_view[%lse_offset] : f32, view<148xf32>
    }
  }
  kernel.return
}

// Builds three partials with scores [0, 1, 0] and payloads [2, 4, 6]. Their
// weighted average is exactly four for any finite value of exp(-1), while the
// rising and falling score sequence requires both old-state rescaling paths.
kernel.def @split_kv_stage2_initialize_rescaling_payload() {
  %split_count = index.constant 3 : index
  %unit = index.constant 1 : index
  %workgroup_width = index.constant 256 : index
  kernel.launch.config workgroups(%split_count, %unit, %unit) workgroup_size(%workgroup_width, %unit, %unit) : index
} launch(%partial_output: buffer, %partial_lse: buffer) {
  %split_id = kernel.workgroup.id<x> : index
  %split = index.assume %split_id [range(%split_id, 0, 2)] : index
  %local_id = kernel.workitem.id<x> : index
  %channel0 = index.assume %local_id [range(%local_id, 0, 255)] : index
  %channel_offset = index.constant 256 : index
  %channel1 = index.add %channel0, %channel_offset : index
  %value_width = index.constant 512 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %split_ordinal = index.add %split, %c1 : index
  %payload_index = index.mul %split_ordinal, %c2 : index
  %payload_i32 = index.cast %payload_index : index to i32
  %payload = scalar.sitofp %payload_i32 : i32 to f32
  %base = index.constant 0 : offset
  %partial_output_view = buffer.view %partial_output[%base] : buffer -> view<1536xf32>
  %partial_lse_view = buffer.view %partial_lse[%base] : buffer -> view<3xf32>
  %split_base = index.mul %split, %value_width : index
  %physical0 = index.add %split_base, %channel0 : index
  %physical1 = index.add %split_base, %channel1 : index
  view.store %payload, %partial_output_view[%physical0] : f32, view<1536xf32>
  view.store %payload, %partial_output_view[%physical1] : f32, view<1536xf32>
  %leader_index = index.constant 0 : index
  %leader = index.cmp eq, %channel0, %leader_index : index
  scf.if %leader {
    %zero_score = scalar.constant 0.0 : f32
    %one_score = scalar.constant 1.0 : f32
    %middle = index.cmp eq, %split, %c1 : index
    %score = scf.if %middle -> (f32) {
      scf.yield %one_score : f32
    } else {
      scf.yield %zero_score : f32
    }
    view.store %score, %partial_lse_view[%split] : f32, view<3xf32>
  }
  kernel.return
}

// Ragged query ranges are 2/1/2. Sequence zero is limited by the explicit
// valid count, sequence one by KV length, and sequence two by split indptr.
// Every inactive payload and physical padding slot remains NaN.
check.case public @split_kv_stage2_padded_ragged {
  %sequences = check.literal value(3) : index
  %heads = check.literal value(2) : index
  %queries = check.literal value(5) : index
  %splits = check.literal value(4) : index
  %partial_batch_stride = check.literal value(31) : index
  %partial_head_stride = check.literal value(2) : index
  %partial_split_stride = check.literal value(7) : index
  %output_batch_stride = check.literal value(1048) : index
  %output_head_stride = check.literal value(520) : index
  %partial_output = check.generate.fill value(nan) : tensor<75776xf32>
  %partial_lse = check.generate.fill value(nan) : tensor<148xf32>
  %query_offsets = check.generate.fill value(-1) : tensor<4xi32>
  %kv_offsets = check.generate.fill value(-1) : tensor<4xi32>
  %split_offsets = check.generate.fill value(-1) : tensor<4xi32>
  %valid_split_count = check.generate.fill value(-1) : tensor<3xi32>
  kernel.launch @split_kv_stage2_initialize_metadata(%query_offsets, %kv_offsets, %split_offsets, %valid_split_count) : (tensor<4xi32>, tensor<4xi32>, tensor<4xi32>, tensor<3xi32>)
  kernel.launch @split_kv_stage2_initialize_padded_payload(%partial_output, %partial_lse) : (tensor<75776xf32>, tensor<148xf32>)
  %serial_output = check.generate.fill value(nan) : tensor<5224xbf16>
  %pipelined_output = check.generate.fill value(nan) : tensor<5224xbf16>
  kernel.launch @split_kv_stage2_serial_mgc16[%sequences, %heads](%sequences, %heads, %queries, %splits, %partial_output, %partial_lse, %serial_output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride) : [index, index](index, index, index, index, tensor<75776xf32>, tensor<148xf32>, tensor<5224xbf16>, tensor<4xi32>, tensor<4xi32>, tensor<4xi32>, tensor<3xi32>, index, index, index, index, index)
  kernel.launch @split_kv_stage2_pipelined_mgc16[%sequences, %heads](%sequences, %heads, %queries, %splits, %partial_output, %partial_lse, %pipelined_output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride) : [index, index](index, index, index, index, tensor<75776xf32>, tensor<148xf32>, tensor<5224xbf16>, tensor<4xi32>, tensor<4xi32>, tensor<4xi32>, tensor<3xi32>, index, index, index, index, index)
  check.expect.bitwise actual(%pipelined_output) expected(%serial_output) : tensor<5224xbf16>
  %expected = check.generate.iota offset(0.0) step(1.0) period(127) : tensor<5x2x512xbf16>
  %actual_q0h0 = check.tensor.view %pipelined_output offset(0) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q0h1 = check.tensor.view %pipelined_output offset(1040) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q1h0 = check.tensor.view %pipelined_output offset(2096) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q1h1 = check.tensor.view %pipelined_output offset(3136) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q2h0 = check.tensor.view %pipelined_output offset(4192) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q2h1 = check.tensor.view %pipelined_output offset(5232) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q3h0 = check.tensor.view %pipelined_output offset(6288) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q3h1 = check.tensor.view %pipelined_output offset(7328) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q4h0 = check.tensor.view %pipelined_output offset(8384) : tensor<5224xbf16> -> tensor<512xbf16>
  %actual_q4h1 = check.tensor.view %pipelined_output offset(9424) : tensor<5224xbf16> -> tensor<512xbf16>
  %expected_q0h0 = check.tensor.view %expected offset(0) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q0h1 = check.tensor.view %expected offset(1024) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q1h0 = check.tensor.view %expected offset(2048) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q1h1 = check.tensor.view %expected offset(3072) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q2h0 = check.tensor.view %expected offset(4096) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q2h1 = check.tensor.view %expected offset(5120) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q3h0 = check.tensor.view %expected offset(6144) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q3h1 = check.tensor.view %expected offset(7168) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q4h0 = check.tensor.view %expected offset(8192) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  %expected_q4h1 = check.tensor.view %expected offset(9216) : tensor<5x2x512xbf16> -> tensor<512xbf16>
  check.expect.bitwise actual(%actual_q0h0) expected(%expected_q0h0) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q0h1) expected(%expected_q0h1) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q1h0) expected(%expected_q1h0) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q1h1) expected(%expected_q1h1) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q2h0) expected(%expected_q2h0) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q2h1) expected(%expected_q2h1) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q3h0) expected(%expected_q3h0) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q3h1) expected(%expected_q3h1) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q4h0) expected(%expected_q4h0) : tensor<512xbf16>
  check.expect.bitwise actual(%actual_q4h1) expected(%expected_q4h1) : tensor<512xbf16>
  check.return
}

// Symmetric payloads around the highest-scored split have an exact analytic
// result while still exercising rescaling of both old and incoming state.
check.case public @split_kv_stage2_rescaling {
  %sequences = check.literal value(1) : index
  %heads = check.literal value(1) : index
  %queries = check.literal value(1) : index
  %splits = check.literal value(3) : index
  %partial_batch_stride = check.literal value(3) : index
  %partial_head_stride = check.literal value(1) : index
  %partial_split_stride = check.literal value(1) : index
  %output_batch_stride = check.literal value(512) : index
  %output_head_stride = check.literal value(512) : index
  %partial_output = check.generate.fill value(nan) : tensor<1x3x1x512xf32>
  %partial_lse = check.generate.fill value(nan) : tensor<1x3x1xf32>
  kernel.launch @split_kv_stage2_initialize_rescaling_payload(%partial_output, %partial_lse) : (tensor<1x3x1x512xf32>, tensor<1x3x1xf32>)
  %query_offsets = check.generate.iota offset(0) step(1) : tensor<2xi32>
  %kv_offsets = check.generate.iota offset(0) step(48) : tensor<2xi32>
  %split_offsets = check.generate.iota offset(0) step(3) : tensor<2xi32>
  %valid_split_count = check.generate.fill value(3) : tensor<1xi32>
  %serial_output = check.generate.fill value(nan) : tensor<1x1x512xbf16>
  %pipelined_output = check.generate.fill value(nan) : tensor<1x1x512xbf16>
  kernel.launch @split_kv_stage2_serial_mgc16[%sequences, %heads](%sequences, %heads, %queries, %splits, %partial_output, %partial_lse, %serial_output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride) : [index, index](index, index, index, index, tensor<1x3x1x512xf32>, tensor<1x3x1xf32>, tensor<1x1x512xbf16>, tensor<2xi32>, tensor<2xi32>, tensor<2xi32>, tensor<1xi32>, index, index, index, index, index)
  kernel.launch @split_kv_stage2_pipelined_mgc16[%sequences, %heads](%sequences, %heads, %queries, %splits, %partial_output, %partial_lse, %pipelined_output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride) : [index, index](index, index, index, index, tensor<1x3x1x512xf32>, tensor<1x3x1xf32>, tensor<1x1x512xbf16>, tensor<2xi32>, tensor<2xi32>, tensor<2xi32>, tensor<1xi32>, index, index, index, index, index)
  check.expect.bitwise actual(%pipelined_output) expected(%serial_output) : tensor<1x1x512xbf16>
  %expected = check.generate.fill value(4.0) : tensor<1x1x512xbf16>
  check.expect.equal actual(%pipelined_output) expected(%expected) : tensor<1x1x512xbf16>
  check.return
}

// A single split still follows the f32 recurrence and converts its normalized
// result to bf16. AITER's separate alias fast path has a bf16 partial buffer
// contract and does not belong in this f32 reducer.
check.case public @split_kv_stage2_single_split {
  %sequences = check.literal value(2) : index
  %heads = check.literal value(2) : index
  %queries = check.literal value(2) : index
  %splits = check.literal value(1) : index
  %partial_batch_stride = check.literal value(2) : index
  %partial_head_stride = check.literal value(1) : index
  %partial_split_stride = check.literal value(2) : index
  %output_batch_stride = check.literal value(1024) : index
  %output_head_stride = check.literal value(512) : index
  %partial_output = check.generate.iota offset(0.0) step(1.0) period(257) : tensor<2x1x2x512xf32>
  %partial_lse = check.generate.fill value(3.0) : tensor<2x1x2xf32>
  %query_offsets = check.generate.iota offset(0) step(1) : tensor<3xi32>
  %kv_offsets = check.generate.iota offset(0) step(16) : tensor<3xi32>
  %split_offsets = check.generate.iota offset(0) step(1) : tensor<3xi32>
  %valid_split_count = check.generate.fill value(1) : tensor<2xi32>
  %serial_output = check.generate.fill value(nan) : tensor<2x2x512xbf16>
  %pipelined_output = check.generate.fill value(nan) : tensor<2x2x512xbf16>
  %expected = check.generate.iota offset(0.0) step(1.0) period(257) : tensor<2x2x512xbf16>
  kernel.launch @split_kv_stage2_serial_mgc16[%sequences, %heads](%sequences, %heads, %queries, %splits, %partial_output, %partial_lse, %serial_output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride) : [index, index](index, index, index, index, tensor<2x1x2x512xf32>, tensor<2x1x2xf32>, tensor<2x2x512xbf16>, tensor<3xi32>, tensor<3xi32>, tensor<3xi32>, tensor<2xi32>, index, index, index, index, index)
  kernel.launch @split_kv_stage2_pipelined_mgc16[%sequences, %heads](%sequences, %heads, %queries, %splits, %partial_output, %partial_lse, %pipelined_output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride) : [index, index](index, index, index, index, tensor<2x1x2x512xf32>, tensor<2x1x2xf32>, tensor<2x2x512xbf16>, tensor<3xi32>, tensor<3xi32>, tensor<3xi32>, tensor<2xi32>, index, index, index, index, index)
  check.expect.bitwise actual(%pipelined_output) expected(%serial_output) : tensor<2x2x512xbf16>
  check.expect.bitwise actual(%pipelined_output) expected(%expected) : tensor<2x2x512xbf16>
  check.return
}
