// Production-shaped split-KV attention reduction.
//
// Each workgroup owns one sequence and head. Query, KV, and split indirection
// describe ragged batches; each query combines normalized f32 partial output
// [query, split, head, 512] with its f32 log-sum-exp and writes bf16 output
// [query, head, 512]. Runtime element strides match the AITER stage-two ABI.
// The split recurrence is explicit so callers can select serial or controlled
// pipelined schedules without changing the kernel boundary.
template.decl @split_kv_stage2(%sequence_count: index, %head_count: index, %total_query_count: index, %maximum_split_count: index, %split_granularity: index, %partial_output: buffer, %partial_lse: buffer, %output: buffer, %query_offsets: buffer, %kv_offsets: buffer, %split_offsets: buffer, %valid_split_count: buffer, %partial_batch_stride: index, %partial_head_stride: index, %partial_split_stride: index, %output_batch_stride: index, %output_head_stride: index, %depth: index, %factor: index)

template.def<@split_kv_stage2> @split_kv_stage2_impl(%sequence_count: index, %head_count: index, %total_query_count: index, %maximum_split_count: index, %split_granularity: index, %partial_output: buffer, %partial_lse: buffer, %output: buffer, %query_offsets: buffer, %kv_offsets: buffer, %split_offsets: buffer, %valid_split_count: buffer, %partial_batch_stride: index, %partial_head_stride: index, %partial_split_stride: index, %output_batch_stride: index, %output_head_stride: index, %depth: index, %factor: index) {
  %sequence_id = kernel.workgroup.id<x> : index
  %head_id = kernel.workgroup.id<y> : index
  %sequence, %sequences = index.assume %sequence_id, %sequence_count [range(%sequence_count, 1, 4096), lt(%sequence_id, %sequence_count)] : index, index
  %head, %heads = index.assume %head_id, %head_count [range(%head_count, 1, 256), lt(%head_id, %head_count)] : index, index
  %queries = index.assume %total_query_count [range(%total_query_count, 1, 32768)] : index
  %splits = index.assume %maximum_split_count [range(%maximum_split_count, 1, 32)] : index
  %split_width = index.assume %split_granularity [range(%split_granularity, 1, 4096)] : index
  %partial_batch, %partial_head, %partial_split = index.assume %partial_batch_stride, %partial_head_stride, %partial_split_stride [range(%partial_batch_stride, 1, 1048576), range(%partial_head_stride, 1, 1048576), range(%partial_split_stride, 1, 1048576)] : index, index, index
  %output_batch, %output_head = index.assume %output_batch_stride, %output_head_stride [range(%output_batch_stride, 1, 1048576), range(%output_head_stride, 1, 1048576)] : index, index
  %c1 = index.constant 1 : index
  %metadata_count = index.add %sequences, %c1 : index
  %next_sequence = index.add %sequence, %c1 : index
  %workitem = kernel.workitem.id<x> : index
  %workgroup_width = index.constant 64 : index
  %value_width = index.constant 512 : index
  %fragment_width = index.constant 4 : index
  %fragment_span = index.mul %workgroup_width, %fragment_width : index
  %channel0_unbounded = index.mul %workitem, %fragment_width : index
  %channel0 = index.assume %channel0_unbounded [range(%channel0_unbounded, 0, 252)] : index
  %channel1_unbounded = index.add %channel0, %fragment_span : index
  %channel1 = index.assume %channel1_unbounded [range(%channel1_unbounded, 256, 508)] : index
  %begin = index.constant 0 : index
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0.0 : f32
  %negative_infinity_bits = scalar.constant -8388608 : i32
  %negative_infinity = scalar.bitcast %negative_infinity_bits : i32 to f32
  %zero_vector = vector.splat %c0 : vector<4xf32>

  %partial_output_aligned = buffer.assume.alignment %partial_output {minimum_alignment = 4} : buffer
  %partial_lse_aligned = buffer.assume.alignment %partial_lse {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 2} : buffer
  %query_offsets_aligned = buffer.assume.alignment %query_offsets {minimum_alignment = 4} : buffer
  %kv_offsets_aligned = buffer.assume.alignment %kv_offsets {minimum_alignment = 4} : buffer
  %split_offsets_aligned = buffer.assume.alignment %split_offsets {minimum_alignment = 4} : buffer
  %valid_split_count_aligned = buffer.assume.alignment %valid_split_count {minimum_alignment = 4} : buffer
  %partial_output_storage, %partial_lse_storage, %output_storage, %query_offset_storage, %kv_offset_storage, %split_offset_storage, %valid_split_storage = buffer.assume.noalias %partial_output_aligned, %partial_lse_aligned, %output_aligned, %query_offsets_aligned, %kv_offsets_aligned, %split_offsets_aligned, %valid_split_count_aligned : buffer, buffer, buffer, buffer, buffer, buffer, buffer

  %partial_batch_value_stride = index.mul %partial_batch, %value_width : index
  %partial_head_value_stride = index.mul %partial_head, %value_width : index
  %partial_split_value_stride = index.mul %partial_split, %value_width : index
  %partial_output_layout = encoding.layout.strided [%partial_batch_value_stride, %partial_split_value_stride, %partial_head_value_stride, 1] : encoding<layout>
  %partial_lse_layout = encoding.layout.strided [%partial_batch, %partial_split, %partial_head] : encoding<layout>
  %output_layout = encoding.layout.strided [%output_batch, %output_head, 1] : encoding<layout>
  %partial_output_view = buffer.view %partial_output_storage[%base] : buffer -> view<[%queries]x[%splits]x[%heads]x512xf32, %partial_output_layout>
  %partial_lse_view = buffer.view %partial_lse_storage[%base] : buffer -> view<[%queries]x[%splits]x[%heads]xf32, %partial_lse_layout>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<[%queries]x[%heads]x512xbf16, %output_layout>
  %query_offset_view = buffer.view %query_offset_storage[%base] : buffer -> view<[%metadata_count]xi32>
  %kv_offset_view = buffer.view %kv_offset_storage[%base] : buffer -> view<[%metadata_count]xi32>
  %split_offset_view = buffer.view %split_offset_storage[%base] : buffer -> view<[%metadata_count]xi32>
  %valid_split_view = buffer.view %valid_split_storage[%base] : buffer -> view<[%sequences]xi32>

  %query_begin_i32 = view.load %query_offset_view[%sequence] : view<[%metadata_count]xi32> -> i32
  %query_end_i32 = view.load %query_offset_view[%next_sequence] : view<[%metadata_count]xi32> -> i32
  %query_begin0 = index.cast %query_begin_i32 : i32 to index
  %query_end0 = index.cast %query_end_i32 : i32 to index
  %query_begin, %query_end = index.assume %query_begin0, %query_end0 [range(%query_begin0, 0, 32768), range(%query_end0, 0, 32768), le(%query_begin0, %query_end0), le(%query_end0, %queries)] : index, index

  %kv_begin_i32 = view.load %kv_offset_view[%sequence] : view<[%metadata_count]xi32> -> i32
  %kv_end_i32 = view.load %kv_offset_view[%next_sequence] : view<[%metadata_count]xi32> -> i32
  %kv_begin0 = index.cast %kv_begin_i32 : i32 to index
  %kv_end0 = index.cast %kv_end_i32 : i32 to index
  %kv_begin, %kv_end = index.assume %kv_begin0, %kv_end0 [range(%kv_begin0, 0, 2147483647), range(%kv_end0, 0, 2147483647), le(%kv_begin0, %kv_end0)] : index, index
  %kv_length = index.sub %kv_end, %kv_begin : index
  %split_rounding = index.sub %split_width, %c1 : index
  %rounded_kv_length = index.add %kv_length, %split_rounding : index
  %kv_split_capacity = index.div %rounded_kv_length, %split_width : index

  %split_begin_i32 = view.load %split_offset_view[%sequence] : view<[%metadata_count]xi32> -> i32
  %split_end_i32 = view.load %split_offset_view[%next_sequence] : view<[%metadata_count]xi32> -> i32
  %split_begin0 = index.cast %split_begin_i32 : i32 to index
  %split_end0 = index.cast %split_end_i32 : i32 to index
  %split_begin, %split_end = index.assume %split_begin0, %split_end0 [range(%split_begin0, 0, 2147483647), range(%split_end0, 0, 2147483647), le(%split_begin0, %split_end0)] : index, index
  %split_capacity0 = index.sub %split_end, %split_begin : index
  %split_capacity = index.assume %split_capacity0 [range(%split_capacity0, 0, 32), le(%split_capacity0, %splits)] : index

  %valid_split_count_i32 = view.load %valid_split_view[%sequence] : view<[%sequences]xi32> -> i32
  %valid_split_count0 = index.cast %valid_split_count_i32 : i32 to index
  %valid_split_limit = index.assume %valid_split_count0 [range(%valid_split_count0, 0, 32)] : index
  %metadata_capacity = index.min %split_capacity, %kv_split_capacity : index
  %valid_splits0 = index.min %metadata_capacity, %valid_split_limit : index
  %valid_splits = index.assume %valid_splits0 [range(%valid_splits0, 0, 32), le(%valid_splits0, %splits)] : index

  scf.for %query = [%query_begin to %query_end step %c1] {
    %bounded_query = index.assume %query [lt(%query, %queries)] : index
    %maximum, %denominator, %numerator0, %numerator1 = scf.for %split = [%begin to %valid_splits step %c1](%carried_maximum = %negative_infinity : f32, %carried_denominator = %c0 : f32, %carried_numerator0 = %zero_vector : vector<4xf32>, %carried_numerator1 = %zero_vector : vector<4xf32>) -> (f32, f32, vector<4xf32>, vector<4xf32>) pipeline(%depth) unroll(%factor) {
      %bounded_split = index.assume %split [lt(%split, %splits)] : index
      %partial_maximum = view.load %partial_lse_view[%bounded_query, %bounded_split, %head] : view<[%queries]x[%splits]x[%heads]xf32, %partial_lse_layout> -> f32
      %partial_numerator0 = vector.load %partial_output_view[%bounded_query, %bounded_split, %head, %channel0] : view<[%queries]x[%splits]x[%heads]x512xf32, %partial_output_layout> -> vector<4xf32>
      %partial_numerator1 = vector.load %partial_output_view[%bounded_query, %bounded_split, %head, %channel1] : view<[%queries]x[%splits]x[%heads]x512xf32, %partial_output_layout> -> vector<4xf32>
      %updated_maximum = scalar.maxnumf<nsz> %carried_maximum, %partial_maximum : f32
      %old_delta = scalar.subf %carried_maximum, %updated_maximum : f32
      %partial_delta = scalar.subf %partial_maximum, %updated_maximum : f32
      %old_scale = scalar.expf<afn> %old_delta : f32
      %partial_scale = scalar.expf<afn> %partial_delta : f32
      %rescaled_denominator = scalar.mulf<contract> %carried_denominator, %old_scale : f32
      %updated_denominator = scalar.addf<contract> %rescaled_denominator, %partial_scale : f32
      %old_scale_vector = vector.splat %old_scale : vector<4xf32>
      %partial_scale_vector = vector.splat %partial_scale : vector<4xf32>
      %rescaled_numerator0 = vector.mulf<contract> %carried_numerator0, %old_scale_vector : vector<4xf32>
      %weighted_partial0 = vector.mulf<contract> %partial_numerator0, %partial_scale_vector : vector<4xf32>
      %updated_numerator0 = vector.addf<contract> %rescaled_numerator0, %weighted_partial0 : vector<4xf32>
      %rescaled_numerator1 = vector.mulf<contract> %carried_numerator1, %old_scale_vector : vector<4xf32>
      %weighted_partial1 = vector.mulf<contract> %partial_numerator1, %partial_scale_vector : vector<4xf32>
      %updated_numerator1 = vector.addf<contract> %rescaled_numerator1, %weighted_partial1 : vector<4xf32>
      scf.yield %updated_maximum, %updated_denominator, %updated_numerator0, %updated_numerator1 : f32, f32, vector<4xf32>, vector<4xf32>
    }
    %denominators = vector.splat %denominator : vector<4xf32>
    %normalized0 = vector.divf %numerator0, %denominators : vector<4xf32>
    %normalized1 = vector.divf %numerator1, %denominators : vector<4xf32>
    %rounded0 = vector.fptrunc %normalized0 : vector<4xf32> to vector<4xbf16>
    %rounded1 = vector.fptrunc %normalized1 : vector<4xf32> to vector<4xbf16>
    vector.store %rounded0, %output_view[%bounded_query, %head, %channel0] : vector<4xbf16>, view<[%queries]x[%heads]x512xbf16, %output_layout>
    vector.store %rounded1, %output_view[%bounded_query, %head, %channel1] : vector<4xbf16>, view<[%queries]x[%heads]x512xbf16, %output_layout>
  }
  template.return
}

kernel.def @split_kv_stage2_serial_mgc16(%sequence_count: index, %head_count: index) {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%sequence_count, %head_count, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%sequence_count: index, %head_count: index, %total_query_count: index, %maximum_split_count: index, %partial_output: buffer, %partial_lse: buffer, %output: buffer, %query_offsets: buffer, %kv_offsets: buffer, %split_offsets: buffer, %valid_split_count: buffer, %partial_batch_stride: index, %partial_head_stride: index, %partial_split_stride: index, %output_batch_stride: index, %output_head_stride: index) {
  %split_granularity = index.constant 16 : index
  %depth = index.constant 1 : index
  %factor = index.constant 1 : index
  template.apply<@split_kv_stage2>(%sequence_count, %head_count, %total_query_count, %maximum_split_count, %split_granularity, %partial_output, %partial_lse, %output, %query_offsets, %kv_offsets, %split_offsets, %valid_split_count, %partial_batch_stride, %partial_head_stride, %partial_split_stride, %output_batch_stride, %output_head_stride, %depth, %factor) : (index, index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index, index, index, index, index, index)
  kernel.return
}

