kernel.decl @routed_row_combine_serial(%workload_token_count: index) launch(%route_count: index, %launch_token_count: index, %route_ids: buffer, %route_weights: buffer, %row_buffer: buffer, %combined_rows: buffer)

kernel.decl @routed_row_combine_pipelined(%workload_token_count: index) launch(%route_count: index, %launch_token_count: index, %route_ids: buffer, %route_weights: buffer, %row_buffer: buffer, %combined_rows: buffer)

// Analytic timing inputs span the row pool: row IDs descend through 4095..0,
// weights alternate -1,+1, and payload(row,channel)=row+channel/1024-0.5.
// Every consecutive route pair contributes exactly -1, giving -4 for eight
// routes and -16 for 32. Each row below times exactly one kernel launch.
check.case public @routed_row_combine_serial_n8 {
  %count = check.literal value(8) : index
  %tokens = check.param.choice values([1, 16, 256]) name("tokens") : index
  %ids = check.generate.iota offset(4095) step(-1) period(4096) : tensor<[%tokens]x32xi32>
  %weights = check.generate.iota offset(-1.0) step(2.0) period(2) : tensor<[%tokens]x32xf32>
  %rows = check.generate.iota offset(-0.5) step(0.0009765625) : tensor<4096x1024xf32>
  %actual = check.generate.fill value(-10000.0) : tensor<[%tokens]x1024xf32>
  %expected = check.generate.fill value(-4.0) : tensor<[%tokens]x1024xf32>
  kernel.launch @routed_row_combine_serial[%tokens](%count, %tokens, %ids, %weights, %rows, %actual) : [index](index, index, tensor<[%tokens]x32xi32>, tensor<[%tokens]x32xf32>, tensor<4096x1024xf32>, tensor<[%tokens]x1024xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%tokens]x1024xf32>
  check.return
}

check.benchmark<@routed_row_combine_serial_n8> @routed_row_combine_serial_n8_t1 {tokens = 1}

check.benchmark<@routed_row_combine_serial_n8> @routed_row_combine_serial_n8_t16 {tokens = 16}

check.benchmark<@routed_row_combine_serial_n8> @routed_row_combine_serial_n8_t256 {tokens = 256}

