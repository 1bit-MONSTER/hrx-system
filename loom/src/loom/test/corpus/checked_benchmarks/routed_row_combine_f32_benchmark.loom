  %actual = check.generate.fill value(-10000.0) : tensor<[%tokens]x1024xf32>
  %expected = check.generate.fill value(-4.0) : tensor<[%tokens]x1024xf32>
  kernel.launch @routed_row_combine_pipelined[%tokens](%count, %tokens, %ids, %weights, %rows, %actual) : [index](index, index, tensor<[%tokens]x32xi32>, tensor<[%tokens]x32xf32>, tensor<4096x1024xf32>, tensor<[%tokens]x1024xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%tokens]x1024xf32>
  check.return
}

