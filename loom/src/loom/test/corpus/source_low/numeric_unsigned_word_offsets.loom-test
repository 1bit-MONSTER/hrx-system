// A word-sized record ordinal must be unsigned before forming a wide address.
func.def @unsigned_record_address(%base: i64, %record: i32, %record_bytes: i64) -> (i64) {
  %ordinal = scalar.extui %record : i32 to i64
  %displacement = scalar.muli %ordinal, %record_bytes : i64
  %address = scalar.addi %base, %displacement : i64
  func.return %address : i64
}

// ====

// Wrapping the ordinal discards every upper bit of the incoming wide counter.
func.def @wrapped_record_address(%base: i64, %counter: i64, %record_bytes: i64) -> (i64) {
  %record = scalar.trunci %counter : i64 to i32
  %ordinal = scalar.extui %record : i32 to i64
  %displacement = scalar.muli %ordinal, %record_bytes : i64
  %address = scalar.addi %base, %displacement : i64
  func.return %address : i64
}
