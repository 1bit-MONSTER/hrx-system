// An odd step alternates banks, including a nonzero entry phase. Every lane's
// complete packet fits inside a bank; the loop also carries an authored value.
kernel.def @alternating_banks() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %banks = buffer.view %scratch[%base] : buffer -> view<2x32x4xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x4xi32>
  %begin = index.constant 1 : index
  %end = index.constant 10 : index
  %step = index.constant 3 : index
  %bank_count = index.constant 2 : index
  %initial = vector.constant 7 : vector<4xi32>
  %final = scf.for %iteration = [%begin to %end step %step](%carried = %initial : vector<4xi32>) -> (vector<4xi32>) {
    %bank = index.rem %iteration, %bank_count : index
    vector.store<volatile> %carried, %banks[%bank, %lane, 0] : vector<4xi32>, view<2x32x4xi32>
    %loaded = vector.load<volatile> %banks[%bank, %lane, 0] : view<2x32x4xi32> -> vector<4xi32>
    scf.yield %loaded : vector<4xi32>
  }
  vector.store %final, %result[%lane, 0] : vector<4xi32>, view<32x4xi32>
  kernel.return
}

// ====

// The logical banks overlap physically. Addition remains necessary when a
// lane's packet can set the purported bank bit independently of the phase.
kernel.def @overlapping_bank_footprints() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 768 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %stride = index.constant 64 : index
  %layout = encoding.layout.strided [%stride, 4, 1] : encoding<layout>
  %banks = buffer.view %scratch[%base] : buffer -> view<2x32x4xi32, %layout>
  %result = buffer.view %output[%base] : buffer -> view<32x4xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %bank_count = index.constant 2 : index
  %initial = vector.constant 7 : vector<4xi32>
  %final = scf.for %iteration = [%begin to %end step %step](%carried = %initial : vector<4xi32>) -> (vector<4xi32>) {
    %bank = index.rem %iteration, %bank_count : index
    vector.store<volatile> %carried, %banks[%bank, %lane, 0] : vector<4xi32>, view<2x32x4xi32, %layout>
    %loaded = vector.load<volatile> %banks[%bank, %lane, 0] : view<2x32x4xi32, %layout> -> vector<4xi32>
    scf.yield %loaded : vector<4xi32>
  }
  vector.store %final, %result[%lane, 0] : vector<4xi32>, view<32x4xi32>
  kernel.return
}

// ====

// A single access per root cannot amortize a shifted descriptor, even when
// the loop has a clamped uniform term and a large static row bias.
kernel.def @sparse_buffer_origins() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%left: buffer, %right: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %left_view = buffer.view %left[%base] : buffer -> view<1024x16xi32>
  %right_view = buffer.view %right[%base] : buffer -> view<1024x16xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  %distance = index.constant 128 : index
  %row = index.add %lane, %distance : index
  scf.for %iteration = [%begin to %end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %first = vector.load %left_view[%lane, %column] : view<1024x16xi32> -> vector<4xi32>
    %second = vector.load %right_view[%row, %column] : view<1024x16xi32> -> vector<4xi32>
    vector.store %first, %result[%lane, 0] : vector<4xi32>, view<32x8xi32>
    vector.store %second, %result[%lane, 4] : vector<4xi32>, view<32x8xi32>
  }
  kernel.return
}

// ====

// Repeated row biases on two roots pay for one shifted descriptor per root.
// Interleaved roots share the clamped loop term without merging their costs;
// row biases remain scalar/immediate offsets.
kernel.def @reused_buffer_origins() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%left: buffer, %right: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %left_view = buffer.view %left[%base] : buffer -> view<1024x16xi32>
  %right_view = buffer.view %right[%base] : buffer -> view<1024x16xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  %distance_one = index.constant 128 : index
  %distance_two = index.constant 256 : index
  %distance_three = index.constant 384 : index
  %row_one = index.add %lane, %distance_one : index
  %row_two = index.add %lane, %distance_two : index
  %row_three = index.add %lane, %distance_three : index
  scf.for %iteration = [%begin to %end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %left_zero = vector.load %left_view[%lane, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_zero = vector.load %right_view[%lane, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_one = vector.load %left_view[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_one = vector.load %right_view[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_two = vector.load %left_view[%row_two, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_two = vector.load %right_view[%row_two, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_three = vector.load %left_view[%row_three, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_three = vector.load %right_view[%row_three, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_pair = vector.addi %left_zero, %left_one : vector<4xi32>
    %left_triple = vector.addi %left_pair, %left_two : vector<4xi32>
    %left_sum = vector.addi %left_triple, %left_three : vector<4xi32>
    %right_pair = vector.addi %right_zero, %right_one : vector<4xi32>
    %right_triple = vector.addi %right_pair, %right_two : vector<4xi32>
    %right_sum = vector.addi %right_triple, %right_three : vector<4xi32>
    vector.store %left_sum, %result[%lane, 0] : vector<4xi32>, view<32x8xi32>
    vector.store %right_sum, %result[%lane, 4] : vector<4xi32>, view<32x8xi32>
  }
  kernel.return
}

// ====

// Duplicate volatile reads share one address calculation, not four savings.
// The second loop has distinct biases but too few trips to pay for setup.
kernel.def @unamortized_buffer_origins() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1024x16xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x8xi32>
  %begin = index.constant 0 : index
  %long_end = index.constant 32 : index
  %short_end = index.constant 4 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  %distance_one = index.constant 128 : index
  %distance_two = index.constant 256 : index
  %distance_three = index.constant 384 : index
  %row_one = index.add %lane, %distance_one : index
  %row_two = index.add %lane, %distance_two : index
  %row_three = index.add %lane, %distance_three : index
  scf.for %iteration = [%begin to %long_end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %duplicate_first = vector.load<volatile> %source[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %duplicate_second = vector.load<volatile> %source[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %duplicate_third = vector.load<volatile> %source[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %duplicate_fourth = vector.load<volatile> %source[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %pair = vector.addi %duplicate_first, %duplicate_second : vector<4xi32>
    %triple = vector.addi %pair, %duplicate_third : vector<4xi32>
    %sum = vector.addi %triple, %duplicate_fourth : vector<4xi32>
    vector.store %sum, %result[%lane, 0] : vector<4xi32>, view<32x8xi32>
  }
  scf.for %iteration = [%begin to %short_end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %short_first = vector.load %source[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %short_second = vector.load %source[%row_two, %column] : view<1024x16xi32> -> vector<4xi32>
    %short_third = vector.load %source[%row_three, %column] : view<1024x16xi32> -> vector<4xi32>
    %pair = vector.addi %short_first, %short_second : vector<4xi32>
    %sum = vector.addi %pair, %short_third : vector<4xi32>
    vector.store %sum, %result[%lane, 4] : vector<4xi32>, view<32x8xi32>
  }
  kernel.return
}

// ====

// A bounded access view is not a substitute for retained ABI resource bounds.
// Another live dynamic view prevents a static extent on the imported resource.
kernel.def @unbounded_resource_origin() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%input: buffer, %output: buffer, %row_count: index) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %rows = index.assume %row_count [range(%row_count, 1, 1024)] : index
  %dynamic_view = buffer.view %input[%base] : buffer -> view<[%rows]x16xi32>
  %source = buffer.view %input[%base] : buffer -> view<1024x16xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x8xi32>
  %side_read = vector.load<volatile> %dynamic_view[0, 0] : view<[%rows]x16xi32> -> vector<4xi32>
  vector.store %side_read, %result[%lane, 4] : vector<4xi32>, view<32x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  %distance_one = index.constant 128 : index
  %distance_two = index.constant 256 : index
  %distance_three = index.constant 384 : index
  %row_one = index.add %lane, %distance_one : index
  %row_two = index.add %lane, %distance_two : index
  %row_three = index.add %lane, %distance_three : index
  scf.for %iteration = [%begin to %end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %biased_first = vector.load %source[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %biased_second = vector.load %source[%row_two, %column] : view<1024x16xi32> -> vector<4xi32>
    %biased_third = vector.load %source[%row_three, %column] : view<1024x16xi32> -> vector<4xi32>
    %pair = vector.addi %biased_first, %biased_second : vector<4xi32>
    %sum = vector.addi %pair, %biased_third : vector<4xi32>
    vector.store %sum, %result[%lane, 0] : vector<4xi32>, view<32x8xi32>
  }
  kernel.return
}

// ====

// A lane-divergent enclosing region retains direct address lowering. Its
// restored-EXEC merge keeps the authored argument and edge identity contract.
kernel.def @masked_loop_banks() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %banks = buffer.view %scratch[%base] : buffer -> view<2x32x4xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x4xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %bank_count = index.constant 2 : index
  %half = index.constant 16 : index
  %selected = index.cmp ult, %lane, %half : index
  %initial = vector.constant 7 : vector<4xi32>
  %final = scf.if %selected -> (vector<4xi32>) {
    %loop_result = scf.for %iteration = [%begin to %end step %step](%carried = %initial : vector<4xi32>) -> (vector<4xi32>) {
      %bank = index.rem %iteration, %bank_count : index
      vector.store<volatile> %carried, %banks[%bank, %lane, 0] : vector<4xi32>, view<2x32x4xi32>
      %loaded = vector.load<volatile> %banks[%bank, %lane, 0] : view<2x32x4xi32> -> vector<4xi32>
      scf.yield %loaded : vector<4xi32>
    }
    scf.yield %loop_result : vector<4xi32>
  } else {
    scf.yield %initial : vector<4xi32>
  }
  vector.store %final, %result[%lane, 0] : vector<4xi32>, view<32x4xi32>
  kernel.return
}
