func.def @bf16_extrema(%lhs: bf16, %rhs: bf16) -> (bf16, bf16, bf16, bf16) {
  %minimum = scalar.minimumf %lhs, %rhs : bf16
  %maximum = scalar.maximumf %lhs, %rhs : bf16
  %minnum = scalar.minnumf %lhs, %rhs : bf16
  %maxnum = scalar.maxnumf<nnan|nsz> %lhs, %rhs : bf16
  func.return %minimum, %maximum, %minnum, %maxnum : bf16, bf16, bf16, bf16
}

// ====

func.def @bf16_vector_extrema(%lhs: vector<2xbf16>, %rhs: vector<2xbf16>) -> (vector<2xbf16>, vector<2xbf16>) {
  %minimum = vector.minnumf %lhs, %rhs : vector<2xbf16>
  %maximum = vector.maxnumf<nnan|nsz> %lhs, %rhs : vector<2xbf16>
  func.return %minimum, %maximum : vector<2xbf16>, vector<2xbf16>
}

