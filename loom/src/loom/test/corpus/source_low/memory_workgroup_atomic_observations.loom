// Mixed integer and floating observations preserve bits and neighboring cells.
kernel.def @lds_observations_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i32, %replacement: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %whole = buffer.view %scratch[%origin] : buffer -> view<4xi32>
  %integers = view.subview %whole[1] : view<4xi32> -> view<2xi32>
  %float_whole = buffer.view %scratch[%origin] : buffer -> view<4xf32>
  %floats = view.subview %float_whole[1] : view<4xf32> -> view<2xf32>
  %results = buffer.view %output[%origin] : buffer -> view<5xi32>
  %float_replacement = scalar.bitcast %replacement : i32 to f32
  view.store %initial, %whole[0] : i32, view<4xi32>
  view.store %initial, %whole[3] : i32, view<4xi32>
  view.atomic.store %initial, %integers[0] {ordering = relaxed, scope = workgroup} : i32, view<2xi32>
  %unused = view.atomic.load %integers[0] {ordering = relaxed, scope = workgroup} : view<2xi32> -> i32
  %relaxed = view.atomic.load %floats[0] {ordering = relaxed, scope = workgroup} : view<2xf32> -> f32
  view.atomic.store %float_replacement, %floats[1] {ordering = release, scope = workgroup} : f32, view<2xf32>
  %acquired = view.atomic.load %integers[1] {ordering = acquire, scope = workgroup} : view<2xi32> -> i32
  view.atomic.store %initial, %integers[0] {ordering = seq_cst, scope = workgroup} : i32, view<2xi32>
  %sequential = view.atomic.load %floats[0] {ordering = seq_cst, scope = workgroup} : view<2xf32> -> f32
  %relaxed_bits = scalar.bitcast %relaxed : f32 to i32
  %sequential_bits = scalar.bitcast %sequential : f32 to i32
  %before = view.load %whole[0] : view<4xi32> -> i32
  %after = view.load %whole[3] : view<4xi32> -> i32
  view.store %relaxed_bits, %results[0] : i32, view<5xi32>
  view.store %acquired, %results[1] : i32, view<5xi32>
  view.store %sequential_bits, %results[2] : i32, view<5xi32>
  view.store %before, %results[3] : i32, view<5xi32>
  view.store %after, %results[4] : i32, view<5xi32>
  kernel.return
}

// ====
// Mixed integer and floating observations preserve bits and neighboring cells.
kernel.def @lds_observations_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i64, %replacement: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %whole = buffer.view %scratch[%origin] : buffer -> view<4xi64>
  %integers = view.subview %whole[1] : view<4xi64> -> view<2xi64>
  %float_whole = buffer.view %scratch[%origin] : buffer -> view<4xf64>
  %floats = view.subview %float_whole[1] : view<4xf64> -> view<2xf64>
  %results = buffer.view %output[%origin] : buffer -> view<5xi64>
  %float_replacement = scalar.bitcast %replacement : i64 to f64
  view.store %initial, %whole[0] : i64, view<4xi64>
  view.store %initial, %whole[3] : i64, view<4xi64>
  view.atomic.store %initial, %integers[0] {ordering = relaxed, scope = workgroup} : i64, view<2xi64>
  %unused = view.atomic.load %integers[0] {ordering = relaxed, scope = workgroup} : view<2xi64> -> i64
  %relaxed = view.atomic.load %floats[0] {ordering = relaxed, scope = workgroup} : view<2xf64> -> f64
  view.atomic.store %float_replacement, %floats[1] {ordering = release, scope = workgroup} : f64, view<2xf64>
  %acquired = view.atomic.load %integers[1] {ordering = acquire, scope = workgroup} : view<2xi64> -> i64
  view.atomic.store %initial, %integers[0] {ordering = seq_cst, scope = workgroup} : i64, view<2xi64>
  %sequential = view.atomic.load %floats[0] {ordering = seq_cst, scope = workgroup} : view<2xf64> -> f64
  %relaxed_bits = scalar.bitcast %relaxed : f64 to i64
  %sequential_bits = scalar.bitcast %sequential : f64 to i64
  %before = view.load %whole[0] : view<4xi64> -> i64
  %after = view.load %whole[3] : view<4xi64> -> i64
  view.store %relaxed_bits, %results[0] : i64, view<5xi64>
  view.store %acquired, %results[1] : i64, view<5xi64>
  view.store %sequential_bits, %results[2] : i64, view<5xi64>
  view.store %before, %results[3] : i64, view<5xi64>
  view.store %after, %results[4] : i64, view<5xi64>
  kernel.return
}

// ====
// Coherent payload reads can replace invalidation, but not LDS completion.
kernel.def @lds_acquire_coherent_payload() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1024xi32>
  %results = buffer.view %output[%origin] : buffer -> view<1xi32>
  %observed = view.atomic.load %flag[0] {ordering = acquire, scope = workgroup} : view<1xi32> -> i32
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %results[0] : i32, view<1xi32>
  kernel.return
}
