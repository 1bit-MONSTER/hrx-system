func.def @choose_buffer_reference(%condition: i1, %first: buffer, %second: buffer) -> (buffer) {
  %selected = scf.select %condition, %first, %second : buffer
  func.return %selected : buffer
}

// Different lanes select different allocations and different interior origins.
// Observations through both original references expose lost aliasing writes.
kernel.def @selected_buffer_aliases() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%first: buffer, %second: buffer, %before: buffer, %first_after: buffer, %second_after: buffer) {
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %parity = index.andi %lane, %c1 : index
  %choose_first = index.cmp eq, %parity, %c0 : index
  %selected = func.call @choose_buffer_reference(%choose_first, %first, %second) : (i1, buffer, buffer) -> (buffer)
  %first_origin = index.constant 64 : offset
  %second_origin = index.constant 128 : offset
  %origin = scf.select %choose_first, %first_origin, %second_origin : offset
  %selected_view = buffer.view %selected[%origin] : buffer -> view<64xi32>
  %first_view = buffer.view %first[%first_origin] : buffer -> view<64xi32>
  %second_view = buffer.view %second[%second_origin] : buffer -> view<64xi32>
  %base = index.constant 0 : offset
  %before_view = buffer.view %before[%base] : buffer -> view<64xi32>
  %first_after_view = buffer.view %first_after[%base] : buffer -> view<64xi32>
  %second_after_view = buffer.view %second_after[%base] : buffer -> view<64xi32>
  %previous = view.load %selected_view[%lane] : view<64xi32> -> i32
  %increment = scalar.constant 1 : i32
  %replacement = scalar.addi %previous, %increment : i32
  view.store %replacement, %selected_view[%lane] : i32, view<64xi32>
  %first_observed = view.load %first_view[%lane] : view<64xi32> -> i32
  %second_observed = view.load %second_view[%lane] : view<64xi32> -> i32
  // Removing the lane's iota contribution leaves the selected origin visible.
  %lane_value = index.cast %lane : index to i32
  %previous_origin = scalar.subi %previous, %lane_value : i32
  %first_observed_origin = scalar.subi %first_observed, %lane_value : i32
  %second_observed_origin = scalar.subi %second_observed, %lane_value : i32
  view.store %previous_origin, %before_view[%lane] : i32, view<64xi32>
  view.store %first_observed_origin, %first_after_view[%lane] : i32, view<64xi32>
  view.store %second_observed_origin, %second_after_view[%lane] : i32, view<64xi32>
  kernel.return
}

check.case public @selected_buffer_aliases_case {
  %first = check.generate.iota offset(0) step(1) : tensor<128xi32>
  %second = check.generate.iota offset(1024) step(1) : tensor<128xi32>
  %before = check.generate.fill value(-1) : tensor<64xi32>
  %first_after = check.generate.fill value(-1) : tensor<64xi32>
  %second_after = check.generate.fill value(-1) : tensor<64xi32>
  %expected_before = check.generate.iota offset(16) step(1040) period(2) : tensor<64xi32>
  %expected_first = check.generate.iota offset(17) step(-1) period(2) : tensor<64xi32>
  %expected_second = check.generate.iota offset(1056) step(1) period(2) : tensor<64xi32>
  kernel.launch @selected_buffer_aliases(%first, %second, %before, %first_after, %second_after) : (tensor<128xi32>, tensor<128xi32>, tensor<64xi32>, tensor<64xi32>, tensor<64xi32>)
  check.expect.equal actual(%before) expected(%expected_before) : tensor<64xi32>
  check.expect.equal actual(%first_after) expected(%expected_first) : tensor<64xi32>
  check.expect.equal actual(%second_after) expected(%expected_second) : tensor<64xi32>
  check.return
}

// The loop trip count varies by lane, including zero. Each backedge rotates
// complete coordinates while inactive lanes retain their exit references.
kernel.def @rotating_buffer_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%first: buffer, %second: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %mask = index.constant 7 : index
  %count = index.andi %lane, %mask : index
  %first_origin = index.constant 64 : offset
  %second_origin = index.constant 128 : offset
  %selected, %origin, %unused_buffer, %unused_origin = scf.for %iteration = [%c0 to %count step %c1](%current = %first : buffer, %current_origin = %first_origin : offset, %other = %second : buffer, %other_origin = %second_origin : offset) -> (buffer, offset, buffer, offset) {
    scf.yield %other, %other_origin, %current, %current_origin : buffer, offset, buffer, offset
  }
  %selected_view = buffer.view %selected[%origin] : buffer -> view<64xi32>
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  %value = view.load %selected_view[%lane] : view<64xi32> -> i32
  %lane_value = index.cast %lane : index to i32
  %observed_origin = scalar.subi %value, %lane_value : i32
  view.store %observed_origin, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

check.case public @rotating_buffer_coordinates_case {
  %first = check.generate.iota offset(0) step(1) : tensor<128xi32>
  %second = check.generate.iota offset(1024) step(1) : tensor<128xi32>
  %output = check.generate.fill value(-1) : tensor<64xi32>
  %expected = check.generate.iota offset(16) step(1040) period(2) : tensor<64xi32>
  kernel.launch @rotating_buffer_coordinates(%first, %second, %output) : (tensor<128xi32>, tensor<128xi32>, tensor<64xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<64xi32>
  check.return
}

// A large common origin exercises address arithmetic on the selected base.
kernel.def @selected_buffer_static_origin() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%first: buffer, %second: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %parity = index.andi %lane, %c1 : index
  %choose_first = index.cmp eq, %parity, %c0 : index
  %selected = scf.select %choose_first, %first, %second : buffer
  %origin = index.constant 16384 : offset
  %selected_view = buffer.view %selected[%origin] : buffer -> view<64xi32>
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  %value = view.load %selected_view[%lane] : view<64xi32> -> i32
  %lane_value = index.cast %lane : index to i32
  %observed_origin = scalar.subi %value, %lane_value : i32
  view.store %observed_origin, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

check.case public @selected_buffer_static_origin_case {
  %first = check.generate.iota offset(0) step(1) : tensor<4160xi32>
  %second = check.generate.iota offset(1024) step(1) : tensor<4160xi32>
  %output = check.generate.fill value(-1) : tensor<64xi32>
  %expected = check.generate.iota offset(4096) step(1024) period(2) : tensor<64xi32>
  kernel.launch @selected_buffer_static_origin(%first, %second, %output) : (tensor<4160xi32>, tensor<4160xi32>, tensor<64xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<64xi32>
  check.return
}
