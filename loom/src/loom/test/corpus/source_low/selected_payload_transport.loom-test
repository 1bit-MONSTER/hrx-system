// ====

func.def public @independent_assumption_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload, %bounded = scalar.assume %scalar, %selected [range(%selected, 0, 42)] : i32, i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ====

func.def public @selected_assumption_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload, %bounded = scalar.assume %scalar, %selected [range(%selected, 0, 42)] : i32, i32
  cfg.br ^forward(%bounded: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ====

func.def public @independent_transformed_assumption_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload, %bounded = scalar.assume %scalar, %selected [range(%selected, 0, 42)] : i32, i32
  %increment = scalar.constant 3 : i32
  %transformed = scalar.addi %payload, %increment : i32
  cfg.br ^forward(%transformed: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ====

func.def public @selected_transformed_assumption_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload, %bounded = scalar.assume %scalar, %selected [range(%selected, 0, 42)] : i32, i32
  %increment = scalar.constant 3 : i32
  %transformed = scalar.addi %bounded, %increment : i32
  cfg.br ^forward(%transformed: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ====

func.def public @independent_predicate_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload = scalar.assume %scalar [lt(%scalar, %selected)] : i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}
