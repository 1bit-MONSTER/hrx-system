func.def public @selected_truncated(%input: vector<4xi32>, %left: i64, %right: i64) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ====

func.def public @selected_coordinate(%input: vector<4xi32>, %left: i32, %right: i32) -> (index) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload = index.cast %selected : i32 to index
  cfg.br ^forward(%payload: index)
^forward(%carried: index):
  func.return %carried : index
}

