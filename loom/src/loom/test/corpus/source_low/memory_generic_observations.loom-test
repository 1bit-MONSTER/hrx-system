}

// ====

// Sparse scalar payload reads carry acquisition on their flat packets.
kernel.def @generic_coherent_system() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %generic_signal = buffer.assume.memory_space<generic> %signal : buffer
  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic_signal[%origin] : buffer -> view<1xf32>
  %data = buffer.view %generic_payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = system} : view<1xf32> -> f32
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
  kernel.return
}

// ====

// Sequential observations order both sides of the load and preserve wide bits.
kernel.def @generic_sequential_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %output: buffer, %value: i64) {
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic[%origin] : buffer -> view<1xi64>
  %result = buffer.view %output[%origin] : buffer -> view<1xi64>
  view.atomic.store %value, %word[0] {ordering = seq_cst, scope = system} : i64, view<1xi64>
  %observed = view.atomic.load %word[0] {ordering = seq_cst, scope = system} : view<1xi64> -> i64
  view.store %observed, %result[0] : i64, view<1xi64>
  kernel.return
}

// ====

// Fences pair with relaxed flat flags and retain coherent generic payloads.
kernel.def @generic_fence_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %generic_signal = buffer.assume.memory_space<generic> %signal : buffer
  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic_signal[%origin] : buffer -> view<1xi32>
  %data = buffer.view %generic_payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %marker = scalar.constant 7 : i32
  view.store %marker, %data[0] : i32, view<1024xi32>
  buffer.fence scope(workgroup) ordering(release)
  view.atomic.store %marker, %word[0] {ordering = relaxed, scope = workgroup} : i32, view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  buffer.fence scope(workgroup) ordering(acquire)
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
  kernel.return
}
