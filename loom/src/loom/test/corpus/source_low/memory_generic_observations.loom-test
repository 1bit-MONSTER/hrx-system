  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic_signal[%origin] : buffer -> view<1xi64>
  %data = buffer.view %generic_payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = device} : view<1xi64> -> i64
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
