// Repeated and unused observations remain distinct memory packets.
kernel.def @generic_relaxed_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %generic = buffer.assume.memory_space<generic> %input : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic[%origin] : buffer -> view<1xi32>
  %result = buffer.view %output[%origin] : buffer -> view<2xi32>
  %first = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  %second = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  %unused = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  view.store %first, %result[0] : i32, view<2xi32>
  view.store %second, %result[1] : i32, view<2xi32>
  kernel.return
}

// ====

// A flat publication releases prior global and LDS payloads.
kernel.def @generic_release_f64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %value: f64) {
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xf64>
  %word = buffer.view %generic[%origin] : buffer -> view<1xf64>
  %data = buffer.view %payload[%origin] : buffer -> view<1xf64>
  view.store %value, %data[0] : f64, view<1xf64>
  view.store %value, %local[0] : f64, view<1xf64>
  view.atomic.store %value, %word[0] {ordering = release, scope = workgroup} : f64, view<1xf64>
  kernel.return
}

// ====

// An unused acquire completes both possible domains before independent reads.
// A wide mutable payload requires eager cache acquisition.
kernel.def @generic_acquire_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %generic_signal = buffer.assume.memory_space<generic> %signal : buffer
  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xi64>
  %word = buffer.view %generic_signal[%origin] : buffer -> view<1xi64>
  %data = buffer.view %generic_payload[%origin] : buffer -> view<1xi64>
  %result = buffer.view %output[%origin] : buffer -> view<2xi64>
  %marker = scalar.constant 4294967299 : i64
  view.store %marker, %local[0] : i64, view<1xi64>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xi64> -> i64
  %value = view.load %data[0] : view<1xi64> -> i64
  %local_value = view.load %local[0] : view<1xi64> -> i64
  view.store %value, %result[0] : i64, view<2xi64>
  view.store %local_value, %result[1] : i64, view<2xi64>
  kernel.return
}

// ====

// Sparse scalar payload reads carry acquisition on their flat packets.
kernel.def @generic_coherent_workgroup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %generic_signal = buffer.assume.memory_space<generic> %signal : buffer
  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic_signal[%origin] : buffer -> view<1xi32>
  %data = buffer.view %generic_payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xi32> -> i32
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
  kernel.return
}

