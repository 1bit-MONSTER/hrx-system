// Advisory CU cache hints cannot narrow the authored atomic coherence scope.
kernel.def @half_vector_four() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: vector<4xf16>) {
  %first = index.constant 0 : index
  %unit = index.constant 1 : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xf16>
  %offsets = vector.iota %first step %unit : vector<4xindex>
  vector.atomic.reduce<addf> %value, %scratch_view[0][%offsets] {cache_scope = cu, cache_temporal = non_temporal, ordering = relaxed, scope = workgroup} : vector<4xf16>, view<32xf16>, vector<4xindex>
  kernel.return
}

// ====

kernel.def @half_vector_strided() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: vector<2xf16>) {
  %first = index.constant 0 : index
  %stride = index.constant 2 : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xf16>
  %offsets = vector.iota %first step %stride : vector<2xindex>
  vector.atomic.reduce<addf> %value, %scratch_view[0][%offsets] {cache_scope = cu, cache_temporal = non_temporal, ordering = relaxed, scope = workgroup} : vector<2xf16>, view<32xf16>, vector<2xindex>
  kernel.return
}

