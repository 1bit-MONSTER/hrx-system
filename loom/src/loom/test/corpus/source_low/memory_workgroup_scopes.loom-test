// Flat CAS acquisition completes both address domains, including on failure.
kernel.def @generic_workgroup_cmpxchg_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
