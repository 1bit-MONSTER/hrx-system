  %data = buffer.view %payload[%base] : buffer -> view<1xi64>
  %result = buffer.view %output[%base] : buffer -> view<1xi64>
  %expected = scalar.constant 7 : i32
  %replacement = scalar.constant 9 : i32
  %observed = view.atomic.cmpxchg %expected, %replacement, %word[0] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %acquired = view.load %data[0] : view<1xi64> -> i64
  view.store %acquired, %result[0] : i64, view<1xi64>
  kernel.return
}

// ====

// No-return acquisition completes the store counter before a payload load.
kernel.def @workgroup_acquire_reduce_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %word = buffer.view %signal[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi64>
  %result = buffer.view %output[%origin] : buffer -> view<1xi64>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %word[0] {ordering = acquire, scope = workgroup} : i32, view<1xi32>
  %value = view.load %data[0] : view<1xi64> -> i64
  view.store %value, %result[0] : i64, view<1xi64>
  kernel.return
}
