func.def @f8e4m3_scalar_arithmetic(%lhs: f8E4M3, %rhs: f8E4M3) -> (f8E4M3, f8E4M3, f8E4M3, f8E4M3) {
  %sum = scalar.addf %lhs, %rhs : f8E4M3
  %difference = scalar.subf %lhs, %rhs : f8E4M3
  %product = scalar.mulf %lhs, %rhs : f8E4M3
  %finite = scalar.addf<nnan|ninf> %lhs, %rhs : f8E4M3
  func.return %sum, %difference, %product, %finite : f8E4M3, f8E4M3, f8E4M3, f8E4M3
}

