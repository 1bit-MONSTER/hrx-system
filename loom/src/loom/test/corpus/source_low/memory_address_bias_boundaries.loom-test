// The positive base makes every neighboring byte address nonnegative. Negative
// origin suffixes remain in SSA under the shared source-memory plan contract.
func.def @exchange_offset_bias_boundaries(%buffer: buffer, %byte_offset: offset, %replacement: i8) -> (i8, i8, i8, i8) {
  %base = index.assume %byte_offset [range(%byte_offset, 256, 4096)] : offset
  %negative_boundary_prefix = index.constant 128 : offset
  %negative_outside_prefix = index.constant 129 : offset
  %positive_boundary_prefix = index.constant 127 : offset
  %positive_outside_prefix = index.constant 128 : offset
  %before_boundary = index.sub %base, %negative_boundary_prefix : offset
  %before_outside = index.sub %base, %negative_outside_prefix : offset
  %after_boundary = index.add %base, %positive_boundary_prefix : offset
  %after_outside = index.add %base, %positive_outside_prefix : offset
  %before_boundary_view = buffer.view %buffer[%before_boundary] : buffer -> view<1xi8>
  %before_outside_view = buffer.view %buffer[%before_outside] : buffer -> view<1xi8>
  %after_boundary_view = buffer.view %buffer[%after_boundary] : buffer -> view<1xi8>
  %after_outside_view = buffer.view %buffer[%after_outside] : buffer -> view<1xi8>
  %previous_before_boundary = view.load %before_boundary_view[0] : view<1xi8> -> i8
  %previous_before_outside = view.load %before_outside_view[0] : view<1xi8> -> i8
  %previous_after_boundary = view.load %after_boundary_view[0] : view<1xi8> -> i8
  %previous_after_outside = view.load %after_outside_view[0] : view<1xi8> -> i8
  view.store %replacement, %before_boundary_view[0] : i8, view<1xi8>
  view.store %replacement, %before_outside_view[0] : i8, view<1xi8>
  view.store %replacement, %after_boundary_view[0] : i8, view<1xi8>
  view.store %replacement, %after_outside_view[0] : i8, view<1xi8>
  func.return %previous_before_boundary, %previous_before_outside, %previous_after_boundary, %previous_after_outside : i8, i8, i8, i8
}


// ====

// A signed source coordinate becomes two legal neighboring byte positions.
func.def @exchange_signed_index_bias_boundaries(%buffer: buffer, %coordinate: index, %replacement: i8) -> (i8, i8) {
  %signed_coordinate = index.assume %coordinate [range(%coordinate, -127, 127)] : index
  %boundary_bias = index.constant 127 : index
  %outside_bias = index.constant 128 : index
  %boundary_position = index.add %signed_coordinate, %boundary_bias : index
  %outside_position = index.add %signed_coordinate, %outside_bias : index
  %origin = index.constant 0 : offset
  %view = buffer.view %buffer[%origin] : buffer -> view<256xi8>
  %previous_boundary = view.load %view[%boundary_position] : view<256xi8> -> i8
  %previous_outside = view.load %view[%outside_position] : view<256xi8> -> i8
  view.store %replacement, %view[%boundary_position] : i8, view<256xi8>
  view.store %replacement, %view[%outside_position] : i8, view<256xi8>
  func.return %previous_boundary, %previous_outside : i8, i8
}
