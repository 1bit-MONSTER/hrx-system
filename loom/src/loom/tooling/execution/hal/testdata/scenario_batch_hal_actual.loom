func.def @scenario_alias_update(%first: buffer, %second: buffer, %delta: index) {
  %origin = index.constant 0 : offset
  %delta_i32 = index.cast %delta : index to i32
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%origin] : buffer -> view<4xi32>
  %second_view = buffer.view %second_aligned[%origin] : buffer -> view<4xi32>
  %value = view.load %second_view[0] : view<4xi32> -> i32
  %updated = scalar.addi %value, %delta_i32 : i32
  view.store %updated, %first_view[1] : i32, view<4xi32>
  %aliased = view.load %second_view[0] : view<4xi32> -> i32
  view.store %aliased, %second_view[1] : i32, view<4xi32>
  func.return
}

kernel.def @scenario_alias_update_kernel() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%first: buffer, %second: buffer, %delta: index) {
  func.call @scenario_alias_update(%first, %second, %delta) : (buffer, buffer, index)
  kernel.return
}

check.scenario public @scenario_batch_hal_actual {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(11) : tensor<8xi32>
    %first = check.tensor.view %storage offset(4) : tensor<8xi32> -> tensor<4xi32>
    %second = check.tensor.view %storage offset(8) : tensor<8xi32> -> tensor<4xi32>
    check.invoke<@scenario_alias_update_kernel>(%first, %second, %trial) : (tensor<4xi32>, tensor<4xi32>, index) -> ()
  }
  check.return
}
