load("//loom/build_tools/bazel:build_defs.bzl", "iree_select", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(["testdata/duplicate_symbols.loom-test"])

loom_cc_library(
    name = "input",
    srcs = ["input.c"],
    hdrs = ["input.h"],
    deps = [
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/error:source",
        "//loom/src/loom/format:low_repr",
        "//loom/src/loom/format/bytecode:reader",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/tooling/io:source_path",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:path",
    ],
)

loom_cc_library(
    name = "configured",
    srcs = ["configured.c"],
    hdrs = ["configured.h"],
    copts = iree_select({
        "//loom/config/import:cxx": ["-DLOOM_CONFIG_INPUT_HAVE_CXX=1"],
        "//conditions:default": [],
    }),
    deps = [":input"] + iree_select({
        "//loom/config/import:cxx": ["//loom/src/loom/import/cxx/tooling:input"],
        "//conditions:default": [],
    }),
)

loom_cc_library(
    name = "flags",
    srcs = ["flags.c"],
    hdrs = ["flags.h"],
    deps = [
        ":input",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

loom_cc_test(
    name = "input_test",
    srcs = ["input_test.cc"],
    deps = [
        ":input",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
