{
  "version": 1,
  "cases": [
    {
      "name": "unknown feature",
      "steps": [
        {
          "name": "fixture",
          "write": {
            "path": "{tmp}/fixture.loom-test",
            "text": "// RUN: emit spirv-dis input=source-low target=spirv:vulkan1.3+bda+hal features=MISSING\n// REQUIRES: spirv-dis\n\nfunc.def @entry() {\n  func.return\n}\n"
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "loom-check",
            "args": [
              "{tmp}/fixture.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "unknown or duplicate SPIR-V feature 'MISSING'"
            ]
          },
          "env": {
            "LOOM_SPIRV_DIS": "{tool:spirv-dis}"
          }
        }
      ]
    },
    {
      "name": "duplicate feature",
      "steps": [
