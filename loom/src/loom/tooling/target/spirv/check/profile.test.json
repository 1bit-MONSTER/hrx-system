    {
      "name": "profile refinement contradiction",
      "steps": [
        {
          "name": "fixture",
          "write": {
            "path": "{tmp}/fixture.loom-test",
            "text": "// RUN: emit spirv-dis input=source-low target=spirv:vulkan1.3+bda+hal features=-PHYSICAL_STORAGE_BUFFER\n// REQUIRES: spirv-dis\n\nfunc.def @entry() {\n  func.return\n}\n"
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "loom-check",
            "args": [
              "{tmp}/fixture.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "SPIR-V feature 'spirv.physical_storage_buffer' has contradictory facts",
              "'spirv:vulkan1.3+bda+hal' says true",
              "'spirv-dis features option' says false"
            ]
          },
          "env": {
            "LOOM_SPIRV_DIS": "{tool:spirv-dis}"
          }
        }
      ]
