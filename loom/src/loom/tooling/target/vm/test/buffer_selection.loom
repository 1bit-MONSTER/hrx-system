// The selected reference crosses a real call boundary together with its origin.
func.def noinline @choose_coordinate(%first: buffer, %second: buffer, %choose_first: i1) -> (buffer, offset) {
  %first_origin = index.constant 3 : offset
  %second_origin = index.constant 11 : offset
  %selected = scf.select %choose_first, %first, %second : buffer
  %origin = scf.select %choose_first, %first_origin, %second_origin : offset
  func.return %selected, %origin : buffer, offset
}

// Both original references stay live across selection, call return, and loop
// swaps. Reads through them observe exactly the selected write. Unequal origins
// and opposite-location canaries detect a reference paired with the wrong origin.
func.def @exchange_coordinate(%choose_first: i1, %count_input: i32, %replacement: i32) -> (i32, i32, i32, i32, i32) {
  %base = index.constant 0 : offset
  %length = index.constant 16 : offset
  %first_origin = index.constant 3 : offset
  %second_origin = index.constant 11 : offset
  %first = buffer.alloca<private> align(8) %length : buffer
  %second = buffer.alloca<private> align(8) %length : buffer
  %first_canary = scalar.constant 85 : i8
  %second_canary = scalar.constant -86 : i8
  buffer.fill %first_canary, %first[%base], %length : i8
  buffer.fill %second_canary, %second[%base], %length : i8
  %first_value = scalar.constant 17 : i32
  %second_value = scalar.constant 29 : i32
  buffer.store.i8 %first_value, %first[%first_origin]
  buffer.store.i8 %second_value, %second[%second_origin]
  %selected, %selected_origin = func.call @choose_coordinate(%first, %second, %choose_first) : (buffer, buffer, i1) -> (buffer, offset)
  %other = scf.select %choose_first, %second, %first : buffer
  %other_origin = scf.select %choose_first, %second_origin, %first_origin : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.cast %count_input : i32 to index
  %rotated, %rotated_origin, %unused_buffer, %unused_origin = scf.for %iteration = [%begin to %count step %step](%current = %selected : buffer, %current_origin = %selected_origin : offset, %next = %other : buffer, %next_origin = %other_origin : offset) -> (buffer, offset, buffer, offset) {
    scf.yield %next, %next_origin, %current, %current_origin : buffer, offset, buffer, offset
  }
  %before = buffer.load.i8.u %rotated[%rotated_origin]
  buffer.store.i8 %replacement, %rotated[%rotated_origin]
  %first_after = buffer.load.i8.u %first[%first_origin]
  %second_after = buffer.load.i8.u %second[%second_origin]
  %first_guard = buffer.load.i8.u %first[%second_origin]
  %second_guard = buffer.load.i8.u %second[%first_origin]
  func.return %before, %first_after, %second_after, %first_guard, %second_guard : i32, i32, i32, i32, i32
}

check.case @first_after_even_swaps {
  %choose_first = check.literal value(true) : i1
  %count = check.param.choice values([0, 2, 16, 256]) : i32
  %replacement = check.param.choice values([0, 127, 255]) : i32
  %before, %first_after, %second_after, %first_guard, %second_guard = func.call @exchange_coordinate(%choose_first, %count, %replacement) : (i1, i32, i32) -> (i32, i32, i32, i32, i32)
  %first_value = check.literal value(17) : i32
  %second_value = check.literal value(29) : i32
  %first_canary = check.literal value(85) : i32
  %second_canary = check.literal value(170) : i32
  check.expect.equal actual(%before) expected(%first_value) : i32
  check.expect.equal actual(%first_after) expected(%replacement) : i32
  check.expect.equal actual(%second_after) expected(%second_value) : i32
  check.expect.equal actual(%first_guard) expected(%first_canary) : i32
  check.expect.equal actual(%second_guard) expected(%second_canary) : i32
  check.return
}

check.case @second_after_even_swaps {
  %choose_first = check.literal value(false) : i1
  %count = check.param.choice values([0, 2, 16, 256]) : i32
  %replacement = check.param.choice values([0, 127, 255]) : i32
  %before, %first_after, %second_after, %first_guard, %second_guard = func.call @exchange_coordinate(%choose_first, %count, %replacement) : (i1, i32, i32) -> (i32, i32, i32, i32, i32)
  %first_value = check.literal value(17) : i32
  %second_value = check.literal value(29) : i32
  %first_canary = check.literal value(85) : i32
  %second_canary = check.literal value(170) : i32
  check.expect.equal actual(%before) expected(%second_value) : i32
  check.expect.equal actual(%first_after) expected(%first_value) : i32
  check.expect.equal actual(%second_after) expected(%replacement) : i32
  check.expect.equal actual(%first_guard) expected(%first_canary) : i32
  check.expect.equal actual(%second_guard) expected(%second_canary) : i32
  check.return
}

check.case @second_after_odd_swaps {
  %choose_first = check.literal value(true) : i1
  %count = check.param.choice values([1, 3, 17, 257]) : i32
  %replacement = check.param.choice values([0, 127, 255]) : i32
  %before, %first_after, %second_after, %first_guard, %second_guard = func.call @exchange_coordinate(%choose_first, %count, %replacement) : (i1, i32, i32) -> (i32, i32, i32, i32, i32)
  %first_value = check.literal value(17) : i32
  %second_value = check.literal value(29) : i32
  %first_canary = check.literal value(85) : i32
  %second_canary = check.literal value(170) : i32
  check.expect.equal actual(%before) expected(%second_value) : i32
  check.expect.equal actual(%first_after) expected(%first_value) : i32
  check.expect.equal actual(%second_after) expected(%replacement) : i32
  check.expect.equal actual(%first_guard) expected(%first_canary) : i32
  check.expect.equal actual(%second_guard) expected(%second_canary) : i32
  check.return
}

check.case @first_after_odd_swaps {
  %choose_first = check.literal value(false) : i1
  %count = check.param.choice values([1, 3, 17, 257]) : i32
  %replacement = check.param.choice values([0, 127, 255]) : i32
  %before, %first_after, %second_after, %first_guard, %second_guard = func.call @exchange_coordinate(%choose_first, %count, %replacement) : (i1, i32, i32) -> (i32, i32, i32, i32, i32)
  %first_value = check.literal value(17) : i32
  %second_value = check.literal value(29) : i32
  %first_canary = check.literal value(85) : i32
  %second_canary = check.literal value(170) : i32
  check.expect.equal actual(%before) expected(%first_value) : i32
  check.expect.equal actual(%first_after) expected(%replacement) : i32
  check.expect.equal actual(%second_after) expected(%second_value) : i32
  check.expect.equal actual(%first_guard) expected(%first_canary) : i32
  check.expect.equal actual(%second_guard) expected(%second_canary) : i32
  check.return
}
