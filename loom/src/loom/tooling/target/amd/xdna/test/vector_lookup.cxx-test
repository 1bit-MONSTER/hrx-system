// INPUT: cxx root=lookup I=../../../../../import/cxx/test
// RUN: emit source-low @lookup target=amd.xdna.aie2p:core output=low

#include "vector_lookup.cxx"

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @lookup(%table: reg<aie2p.vec256 x2>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %52 = vextract.8.imm %indices, 0
  %53 = extend.u8 %52
  %54 = vextract.8.imm %indices, 1
  %55 = extend.u8 %54
  %56 = vextract.8.imm %indices, 2
  %57 = extend.u8 %56
  %58 = vextract.8.imm %indices, 3
  %59 = extend.u8 %58
  %60 = vextract.8.reg %table, %53
  %61 = vextract.8.reg %table, %55
  %62 = vextract.8.reg %table, %57
  %63 = vextract.8.reg %table, %59
  %64 = vbcst.8 %60
  %65 = mov.short 1
  %66 = copy %65 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %67 = vinsert.8.reg %64, %66, %61
  %68 = mov.short 2
  %69 = copy %68 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %70 = vinsert.8.reg %67, %69, %62
  %71 = mov.short 3
  %72 = copy %71 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %73 = vinsert.8.reg %70, %72, %63
  return %73
}
