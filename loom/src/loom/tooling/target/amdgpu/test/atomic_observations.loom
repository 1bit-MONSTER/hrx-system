kernel.decl @atomic_observation_bits() launch(%storage: buffer, %output: buffer, %value: i64)

// The two patterns carry distinct low and high words. Both loaded and stored
// representations must survive without widening into neighboring guards.
check.case public @atomic_observation_wide_bits {
  %storage = check.generate.fill value(9221120238168475493) : tensor<10xi64>
  %output = check.generate.fill value(37) : tensor<10xi64>
  %value = check.literal value(-4294967297) : i64
  kernel.launch @atomic_observation_bits(%storage, %output, %value) : (tensor<10xi64>, tensor<10xi64>, i64)
  %observed = check.tensor.view %output offset(16) : tensor<10xi64> -> tensor<6xi64>
  %stored = check.tensor.view %storage offset(16) : tensor<10xi64> -> tensor<6xi64>
  %expected_observed = check.generate.fill value(9221120238168475493) : tensor<6xi64>
  %expected_stored = check.generate.fill value(-4294967297) : tensor<6xi64>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<6xi64>
  check.expect.bitwise actual(%stored) expected(%expected_stored) : tensor<6xi64>
  %storage_guard = check.generate.fill value(9221120238168475493) : tensor<2xi64>
  %output_guard = check.generate.fill value(37) : tensor<2xi64>
  %storage_before = check.tensor.view %storage offset(0) : tensor<10xi64> -> tensor<2xi64>
  %storage_after = check.tensor.view %storage offset(64) : tensor<10xi64> -> tensor<2xi64>
  %output_before = check.tensor.view %output offset(0) : tensor<10xi64> -> tensor<2xi64>
  %output_after = check.tensor.view %output offset(64) : tensor<10xi64> -> tensor<2xi64>
  check.expect.bitwise actual(%storage_before) expected(%storage_guard) : tensor<2xi64>
  check.expect.bitwise actual(%storage_after) expected(%storage_guard) : tensor<2xi64>
  check.expect.bitwise actual(%output_before) expected(%output_guard) : tensor<2xi64>
  check.expect.bitwise actual(%output_after) expected(%output_guard) : tensor<2xi64>
  check.return
}

check.case public @atomic_observation_high_bit {
  %storage = check.generate.fill value(-9223372036854775808) : tensor<10xi64>
  %output = check.generate.fill value(37) : tensor<10xi64>
  %value = check.literal value(0) : i64
  kernel.launch @atomic_observation_bits(%storage, %output, %value) : (tensor<10xi64>, tensor<10xi64>, i64)
  %observed = check.tensor.view %output offset(16) : tensor<10xi64> -> tensor<6xi64>
  %stored = check.tensor.view %storage offset(16) : tensor<10xi64> -> tensor<6xi64>
  %expected_observed = check.generate.fill value(-9223372036854775808) : tensor<6xi64>
  %expected_stored = check.generate.fill value(0) : tensor<6xi64>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<6xi64>
  check.expect.bitwise actual(%stored) expected(%expected_stored) : tensor<6xi64>
  check.return
}

kernel.decl @atomic_float_observation_bits() launch(%storage: buffer, %output: buffer, %value: i64)

// The observed and published patterns carry distinct NaN payloads when read
// as f64. Equality is checked on their integer bits, never as floating values.
check.case public @atomic_float_observation_nan_bits {
  %storage = check.generate.fill value(9221120238168475493) : tensor<10xi64>
  %output = check.generate.fill value(37) : tensor<12xi64>
  %value = check.literal value(-4294967297) : i64
  kernel.launch @atomic_float_observation_bits(%storage, %output, %value) : (tensor<10xi64>, tensor<12xi64>, i64)
  %observed = check.tensor.view %output offset(16) : tensor<12xi64> -> tensor<7xi64>
  %stored = check.tensor.view %storage offset(16) : tensor<10xi64> -> tensor<6xi64>
  %expected_observed = check.generate.fill value(9221120238168475493) : tensor<7xi64>
  %expected_stored = check.generate.fill value(-4294967297) : tensor<6xi64>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<7xi64>
  check.expect.bitwise actual(%stored) expected(%expected_stored) : tensor<6xi64>
  %storage_guard = check.generate.fill value(9221120238168475493) : tensor<2xi64>
  %output_before_guard = check.generate.fill value(37) : tensor<2xi64>
  %output_after_guard = check.generate.fill value(37) : tensor<3xi64>
  %storage_before = check.tensor.view %storage offset(0) : tensor<10xi64> -> tensor<2xi64>
  %storage_after = check.tensor.view %storage offset(64) : tensor<10xi64> -> tensor<2xi64>
  %output_before = check.tensor.view %output offset(0) : tensor<12xi64> -> tensor<2xi64>
  %output_after = check.tensor.view %output offset(72) : tensor<12xi64> -> tensor<3xi64>
  check.expect.bitwise actual(%storage_before) expected(%storage_guard) : tensor<2xi64>
  check.expect.bitwise actual(%storage_after) expected(%storage_guard) : tensor<2xi64>
  check.expect.bitwise actual(%output_before) expected(%output_before_guard) : tensor<2xi64>
  check.expect.bitwise actual(%output_after) expected(%output_after_guard) : tensor<3xi64>
  check.return
}

check.case public @atomic_float_observation_signed_zero {
  %storage = check.generate.fill value(-9223372036854775808) : tensor<10xi64>
  %output = check.generate.fill value(37) : tensor<12xi64>
  %value = check.literal value(0) : i64
  kernel.launch @atomic_float_observation_bits(%storage, %output, %value) : (tensor<10xi64>, tensor<12xi64>, i64)
  %observed = check.tensor.view %output offset(16) : tensor<12xi64> -> tensor<7xi64>
  %stored = check.tensor.view %storage offset(16) : tensor<10xi64> -> tensor<6xi64>
  %expected_observed = check.generate.fill value(-9223372036854775808) : tensor<7xi64>
  %expected_stored = check.generate.fill value(0) : tensor<6xi64>
  check.expect.bitwise actual(%observed) expected(%expected_observed) : tensor<7xi64>
  check.expect.bitwise actual(%stored) expected(%expected_stored) : tensor<6xi64>
  check.return
}

kernel.decl @float64_memory_copy() launch(%input: buffer, %output: buffer)

check.case public @float64_memory_payloads {
  %input = check.generate.iota offset(9221120237041090560) step(65537) : tensor<18xi64>
  %output = check.generate.fill value(37) : tensor<18xi64>
  kernel.launch @float64_memory_copy(%input, %output) : (tensor<18xi64>, tensor<18xi64>)
  %expected = check.tensor.view %input offset(8) : tensor<18xi64> -> tensor<16xi64>
  %actual = check.tensor.view %output offset(8) : tensor<18xi64> -> tensor<16xi64>
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<16xi64>
  %guard = check.generate.fill value(37) : tensor<1xi64>
  %before = check.tensor.view %output offset(0) : tensor<18xi64> -> tensor<1xi64>
  %after = check.tensor.view %output offset(136) : tensor<18xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%before) expected(%guard) : tensor<1xi64>
  check.expect.bitwise actual(%after) expected(%guard) : tensor<1xi64>
  check.return
}
