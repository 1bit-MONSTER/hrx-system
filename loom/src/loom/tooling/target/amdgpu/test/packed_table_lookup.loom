// Runtime table entries and packed codes exercise all sixteen selector values.
kernel.def @lookup_packed_nibbles() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base_offset = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %code_count = index.constant 4 : index
  %position = index.mul %lane, %code_count : index
  %input_view = buffer.view %input[%base_offset] : buffer -> view<128xi8>
  %table_view = buffer.view %table[%base_offset] : buffer -> view<16xi8>
  %output_view = buffer.view %output[%base_offset] : buffer -> view<128xi8>
  %packed = vector.load %input_view[%position] : view<128xi8> -> vector<2xi8>
  %codes = vector.bitunpacku<4> %packed : vector<2xi8> -> vector<4xi8>
  %values = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %decoded = vector.table.lookup %values[%codes] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  vector.store %decoded, %output_view[%position] : vector<4xi8>, view<128xi8>
  kernel.return
}

check.case public @packed_table_lookup {
  // Each packed result mixes all four table quarters. Rotating those quarters
  // exercises every table entry in every output-byte position. Within each
  // rotation, adding 0x1111 walks the four entries without nibble carries.
  %input0 = check.generate.iota offset(51264) step(4369) period(4) : tensor<32xi32>
  %input1 = check.generate.iota offset(3204) step(4369) period(4) : tensor<32xi32>
  %input2 = check.generate.iota offset(16584) step(4369) period(4) : tensor<32xi32>
  %input3 = check.generate.iota offset(33804) step(4369) period(4) : tensor<32xi32>
  %table = check.generate.iota offset(-127) step(16) : tensor<16xi8>
  %storage = check.generate.fill value(91) : tensor<520xi8>
  %output0 = check.tensor.view %storage offset(4) : tensor<520xi8> -> tensor<32xi32>
  %output1 = check.tensor.view %storage offset(132) : tensor<520xi8> -> tensor<32xi32>
  %output2 = check.tensor.view %storage offset(260) : tensor<520xi8> -> tensor<32xi32>
  %output3 = check.tensor.view %storage offset(388) : tensor<520xi8> -> tensor<32xi32>
  kernel.launch @lookup_packed_nibbles(%input0, %table, %output0) : (tensor<32xi32>, tensor<16xi8>, tensor<32xi32>)
  kernel.launch @lookup_packed_nibbles(%input1, %table, %output1) : (tensor<32xi32>, tensor<16xi8>, tensor<32xi32>)
  kernel.launch @lookup_packed_nibbles(%input2, %table, %output2) : (tensor<32xi32>, tensor<16xi8>, tensor<32xi32>)
  kernel.launch @lookup_packed_nibbles(%input3, %table, %output3) : (tensor<32xi32>, tensor<16xi8>, tensor<32xi32>)
  // Expected words contain table[code] bytes in source order. A step of
  // 0x10101010 advances every byte independently within its quarter.
  %expected0 = check.generate.iota offset(1090634113) step(269488144) period(4) : tensor<32xi32>
  %expected1 = check.generate.iota offset(-2126446143) step(269488144) period(4) : tensor<32xi32>
  %expected2 = check.generate.iota offset(-1048493823) step(269488144) period(4) : tensor<32xi32>
  %expected3 = check.generate.iota offset(29458753) step(269488144) period(4) : tensor<32xi32>
  check.expect.bitwise actual(%output0) expected(%expected0) : tensor<32xi32>
  check.expect.bitwise actual(%output1) expected(%expected1) : tensor<32xi32>
  check.expect.bitwise actual(%output2) expected(%expected2) : tensor<32xi32>
  check.expect.bitwise actual(%output3) expected(%expected3) : tensor<32xi32>
  %prefix = check.tensor.view %storage offset(0) : tensor<520xi8> -> tensor<4xi8>
  %suffix = check.tensor.view %storage offset(516) : tensor<520xi8> -> tensor<4xi8>
  %guard = check.generate.fill value(91) : tensor<4xi8>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi8>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi8>
  check.return
}
