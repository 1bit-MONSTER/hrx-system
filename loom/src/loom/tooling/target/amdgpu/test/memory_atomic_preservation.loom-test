// CAS packing borrows constants that remain observable after consumption.
kernel.def @preserve_expected() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%destination: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %failed = scalar.constant 0 : i32
  %expected = scalar.constant 5 : i32
  %replacement = scalar.constant 11 : i32
  %cell = buffer.view %destination[%base] : buffer -> view<1xi32>
  %old = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = relaxed, scope = device, success_ordering = acquire} : i32, view<1xi32> -> i32
  %observed = scalar.constant 7 : i32
  %equal = scalar.cmpi eq, %old, %observed : i32
  %passed = scalar.constant 512 : i32
  %result = scf.select %equal, %passed, %failed : i32
  view.atomic.reduce<addi> %expected, %cell[0] {ordering = release, scope = device} : i32, view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %result, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ====

kernel.def @preserve_replacement() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%destination: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %failed = scalar.constant 0 : i32
  %expected = scalar.constant 5 : i32
  %replacement = scalar.constant 11 : i32
  %cell = buffer.view %destination[%base] : buffer -> view<1xi32>
  %old = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = relaxed, scope = device, success_ordering = acquire} : i32, view<1xi32> -> i32
  %observed = scalar.constant 7 : i32
  %equal = scalar.cmpi eq, %old, %observed : i32
  %passed = scalar.constant 512 : i32
  %result = scf.select %equal, %passed, %failed : i32
  view.atomic.reduce<addi> %replacement, %cell[0] {ordering = release, scope = device} : i32, view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %result, %output_view[0] : i32, view<1xi32>
  kernel.return
}
