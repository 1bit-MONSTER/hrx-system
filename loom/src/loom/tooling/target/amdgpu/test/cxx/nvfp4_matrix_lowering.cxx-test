  %367 = v_lshlrev_b32_src0_inline %366, 2
  %368 = v_lshrrev_b32_src0_inline %lane, 4
  %369 = v_lshl_add_u32_shift_imm %368, %367, 8
  %370 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %369, %370, %output_view
  %371 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %369, %371, %output_view {offset = 64}
  %372 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %369, %372, %output_view {offset = 128}
  %373 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %369, %373, %output_view {offset = 192}
  return
}
