  %373 = v_lshlrev_b32_src0_inline %372, 2
  %374 = v_lshrrev_b32_src0_inline %lane, 4
  %375 = v_lshl_add_u32_shift_imm %374, %373, 8
  %376 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %375, %376, %output_view
  %377 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %375, %377, %output_view {offset = 64}
  %378 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %375, %378, %output_view {offset = 128}
  %379 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %375, %379, %output_view {offset = 192}
  return
}
