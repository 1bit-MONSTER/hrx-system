amdgpu.target<gfx11-generic> @wave32 {subgroup_size = 32}

amdgpu.target<gfx11-generic> @wave64 {subgroup_size = 64}

func.decl @cooperative_subgroup(%payload: buffer, %payload_origin: offset, %publication: buffer, %publication_origin: offset, %expected_width: i32) -> (i32)

func.decl @narrow_subgroup() -> (i32)

kernel.def target(@wave32) @cooperate_wave32() {
  %unit = index.constant 1 : index
  %count = index.constant 96 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%count, %unit, %unit) : index
} launch(%payload: buffer, %publication: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %aligned = buffer.assume.alignment %publication {minimum_alignment = 4} : buffer
  %width = scalar.constant 32 : i32
  %failures = func.call @cooperative_subgroup(%payload, %origin, %aligned, %origin, %width) : (buffer, offset, buffer, offset, i32) -> (i32)
  %narrow_failures = func.call @narrow_subgroup() : () -> (i32)
  %combined = scalar.ori %failures, %narrow_failures : i32
  %item = kernel.workitem.id<x> : index
  %guard_bytes = index.constant 4 : offset
  %results = buffer.view %output[%guard_bytes] : buffer -> view<96xi32>
  view.store %combined, %results[%item] : i32, view<96xi32>
  kernel.return
}

kernel.def target(@wave64) @cooperate_wave64() {
  %unit = index.constant 1 : index
  %count = index.constant 96 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%count, %unit, %unit) : index
} launch(%payload: buffer, %publication: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %aligned = buffer.assume.alignment %publication {minimum_alignment = 4} : buffer
  %width = scalar.constant 64 : i32
  %failures = func.call @cooperative_subgroup(%payload, %origin, %aligned, %origin, %width) : (buffer, offset, buffer, offset, i32) -> (i32)
  %item = kernel.workitem.id<x> : index
  %guard_bytes = index.constant 4 : offset
  %results = buffer.view %output[%guard_bytes] : buffer -> view<96xi32>
  view.store %failures, %results[%item] : i32, view<96xi32>
  kernel.return
}

check.case @cooperative_wave32 {
  // Ordered global observations require the RDNA 3.5 system-scope provider.
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.rdna3_5.core"}
  %payload = check.generate.iota offset(19) step(13) : tensor<96xi32>
  %publication = check.generate.fill value(1) : tensor<96xi32>
  %output = check.generate.fill value(37) : tensor<98xi32>
  kernel.launch @cooperate_wave32(%payload, %publication, %output) : (tensor<96xi32>, tensor<96xi32>, tensor<98xi32>)
  %before = check.tensor.view %output offset(0) : tensor<98xi32> -> tensor<1xi32>
  %values = check.tensor.view %output offset(4) : tensor<98xi32> -> tensor<96xi32>
  %after = check.tensor.view %output offset(388) : tensor<98xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi32>
  %success = check.generate.fill value(0) : tensor<96xi32>
  check.expect.bitwise actual(%values) expected(%success) : tensor<96xi32>
  check.expect.bitwise actual(%before) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%after) expected(%guard) : tensor<1xi32>
  check.return
}

check.case @cooperative_wave64_tail {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.rdna3_5.core"}
  %payload = check.generate.iota offset(19) step(13) : tensor<96xi32>
  %publication = check.generate.fill value(1) : tensor<96xi32>
  %output = check.generate.fill value(37) : tensor<98xi32>
  kernel.launch @cooperate_wave64(%payload, %publication, %output) : (tensor<96xi32>, tensor<96xi32>, tensor<98xi32>)
  %before = check.tensor.view %output offset(0) : tensor<98xi32> -> tensor<1xi32>
  %values = check.tensor.view %output offset(4) : tensor<98xi32> -> tensor<96xi32>
  %after = check.tensor.view %output offset(388) : tensor<98xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi32>
  %success = check.generate.fill value(0) : tensor<96xi32>
  check.expect.bitwise actual(%values) expected(%success) : tensor<96xi32>
  check.expect.bitwise actual(%before) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%after) expected(%guard) : tensor<1xi32>
  check.return
}
