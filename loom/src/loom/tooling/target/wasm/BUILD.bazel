load(
    "//build_tools/wasm:build_defs.bzl",
    "iree_wasm_cc_library",
)
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_WASM_CHECK_VISIBILITY = ["//loom/src/loom/tools/loom-check:__pkg__"]

iree_wasm_cc_library(
    name = "host_js",
    srcs = ["host.mjs"],
    module = "loom_wasm_host",
)

loom_cc_library(
    name = "host",
    srcs = ["host.c"],
    hdrs = ["host.h"],
    deps = [
        ":host_js",
        "//loom/src/loom/target/emit/wasm:program",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "prepare",
    srcs = ["prepare.c"],
    hdrs = ["prepare.h"],
    deps = [
        "//loom/src/loom/codegen/low:allocation",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:function_model",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/wasm/descriptors",
        "//loom/src/loom/target/emit/wasm:module_binary",
        "//loom/src/loom/target/emit/wasm:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "artifact_emitter",
    srcs = ["artifact_emitter.c"],
    hdrs = ["artifact_emitter.h"],
    visibility = ["//loom/src/loom/tooling/compile:__pkg__"],
    deps = [
        ":prepare",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/wasm/ops",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "loom_check",
    srcs = ["check/loom_check.c"],
    hdrs = ["check/loom_check.h"],
    deps = [
        ":prepare",
        "//loom/src/loom/target/tool:wasm",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "check_provider",
    srcs = ["check/provider.c"],
    hdrs = ["check/provider.h"],
    visibility = _WASM_CHECK_VISIBILITY,
    deps = [
        ":loom_check",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)
