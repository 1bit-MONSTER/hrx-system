load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_WASM_CHECK_VISIBILITY = ["//loom/src/loom/tools/loom-check:__pkg__"]

loom_cc_library(
    name = "prepare",
    srcs = ["prepare.c"],
    hdrs = ["prepare.h"],
    deps = [
        "//loom/src/loom/codegen/low:allocation",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:function_model",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/wasm/descriptors",
        "//loom/src/loom/target/emit/wasm:module_binary",
        "//loom/src/loom/target/emit/wasm:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

iree_c_embed_data(
    name = "evaluator_script",
    srcs = ["evaluator.mjs"],
    c_file_output = "evaluator_script.c",
    h_file_output = "evaluator_script.h",
    identifier = "loom_wasm_evaluator_script",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:wasm_artifacts",
    ]),
)

loom_cc_library(
    name = "evaluator",
    srcs = ["evaluator.c"],
    hdrs = ["evaluator.h"],
    deps = [
        ":evaluator_script",
        ":prepare",
        "//loom/src/loom/target/tool:process",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "testbench",
    srcs = ["testbench.c"],
    hdrs = ["testbench.h"],
    visibility = ["//loom/src/loom/tools/iree-test-loom:__pkg__"],
    deps = [
        ":evaluator",
        ":prepare",
        "//loom/src/loom/error:source",
        "//loom/src/loom/link:linker",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/wasm:provider",
        "//loom/src/loom/tooling/compile:pipeline",
        "//loom/src/loom/tooling/compile:preparation",
        "//loom/src/loom/tooling/compile:request",
        "//loom/src/loom/tooling/config",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "artifact_emitter",
    srcs = ["artifact_emitter.c"],
    hdrs = ["artifact_emitter.h"],
    visibility = ["//loom/src/loom/tooling/compile:__pkg__"],
    deps = [
        ":prepare",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/wasm/ops",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "loom_check",
    srcs = ["check/loom_check.c"],
    hdrs = ["check/loom_check.h"],
    deps = [
        ":prepare",
        "//loom/src/loom/target/tool:wasm",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "check_provider",
    srcs = ["check/provider.c"],
    hdrs = ["check/provider.h"],
    visibility = _WASM_CHECK_VISIBILITY,
    deps = [
        ":loom_check",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)
