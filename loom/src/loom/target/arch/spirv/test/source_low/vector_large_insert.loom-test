// RUN: pass target-legalize{mode=eager},canonicalize,dce

spirv.target<vulkan1_3> @target

func.def target(@target) @insert_tail(%input: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi32>
  %destination = buffer.view %output[%base] : buffer -> view<5xi32>
  %values = vector.load %source[0] : view<5xi32> -> vector<5xi32>
  %result = vector.insert %value into %values[4] : i32, vector<5xi32>
  vector.store %result, %destination[0] : vector<5xi32>, view<5xi32>
  func.return
}

// ----
spirv.target<vulkan1_3> @target

func.def target(@target) @insert_tail(%input: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi32>
  %destination = buffer.view %output[%base] : buffer -> view<5xi32>
  %12 = view.load %source[0] : view<5xi32> -> i32
  %13 = view.load %source[1] : view<5xi32> -> i32
  %14 = view.load %source[2] : view<5xi32> -> i32
  %15 = view.load %source[3] : view<5xi32> -> i32
  %41 = vector.splat %12 : vector<4xi32>
  %36 = vector.insert %13 into %41[1] : i32, vector<4xi32>
  %40 = vector.splat %12 : vector<1xi32>
  %32 = vector.insert %14 into %36[2] : i32, vector<4xi32>
  %28 = vector.insert %15 into %32[3] : i32, vector<4xi32>
  %39 = vector.insert %value into %40[0] : i32, vector<1xi32>
  %result = vector.concat<0> %28, %39 : vector<4xi32>, vector<1xi32> -> vector<5xi32>
  vector.store %result, %destination[0] : vector<5xi32>, view<5xi32>
  func.return
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @insert_dynamic(%input: buffer, %output: buffer, %value: i64, %position: index) where [range(%position, 0, 4)] {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi64>
  %destination = buffer.view %output[%base] : buffer -> view<5xi64>
  %values = vector.load %source[0] : view<5xi64> -> vector<5xi64>
  %result = vector.insert %value into %values[%position] : i64, vector<5xi64>
  vector.store %result, %destination[0] : vector<5xi64>, view<5xi64>
  func.return
}

// ----
spirv.target<vulkan1_3> @target

func.def target(@target) @insert_dynamic(%input: buffer, %output: buffer, %value: i64, %position: index) where [range(%position, 0, 4)] {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi64>
  %destination = buffer.view %output[%base] : buffer -> view<5xi64>
  %26 = view.load %source[0] : view<5xi64> -> i64
  %27 = view.load %source[1] : view<5xi64> -> i64
  %28 = view.load %source[2] : view<5xi64> -> i64
  %29 = view.load %source[3] : view<5xi64> -> i64
  %30 = view.load %source[4] : view<5xi64> -> i64
  %58 = vector.splat %26 : vector<4xi64>
  %50 = vector.insert %27 into %58[1] : i64, vector<4xi64>
  %57 = vector.splat %26 : vector<1xi64>
  %46 = vector.insert %28 into %50[2] : i64, vector<4xi64>
  %42 = vector.insert %29 into %46[3] : i64, vector<4xi64>
  %39 = vector.insert %30 into %57[0] : i64, vector<1xi64>
  %9 = index.constant 0 : index
  %10 = index.constant 4 : index
  %11 = index.cmp ult, %position, %10 : index
  %14 = index.cmp uge, %position, %10 : index
  %17 = scf.select %11, %position, %9 : index
  %18 = vector.insert %value into %42[%17] : i64, vector<4xi64>
  %19 = scf.select %11, %18, %42 : vector<4xi64>
  %56 = vector.insert %value into %57[0] : i64, vector<1xi64>
  %24 = scf.select %14, %56, %39 : vector<1xi64>
  %result = vector.concat<0> %19, %24 : vector<4xi64>, vector<1xi64> -> vector<5xi64>
  vector.store %result, %destination[0] : vector<5xi64>, view<5xi64>
  func.return
}

// ====
// RUN: pass target-legalize{mode=final},canonicalize,dce

spirv.target<vulkan1_3> @target

func.def target(@target) @insert_rank_two(%input: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<2x2xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2x2xi32>
  %values = vector.load %source[0, 0] : view<2x2xi32> -> vector<2x2xi32>
  %result = vector.insert %value into %values[1, 1] : i32, vector<2x2xi32>
  vector.store %result, %destination[0, 0] : vector<2x2xi32>, view<2x2xi32>
  func.return
}

// ----
spirv.target<vulkan1_3> @target

func.def target(@target) @insert_rank_two(%input: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<2x2xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2x2xi32>
  %11 = view.load %source[0, 0] : view<2x2xi32> -> i32
  %12 = view.load %source[0, 1] : view<2x2xi32> -> i32
  %13 = view.load %source[1, 0] : view<2x2xi32> -> i32
  view.store %11, %destination[0, 0] : i32, view<2x2xi32>
  view.store %12, %destination[0, 1] : i32, view<2x2xi32>
  view.store %13, %destination[1, 0] : i32, view<2x2xi32>
  view.store %value, %destination[1, 1] : i32, view<2x2xi32>
  func.return
}
