// TEMPLATE: loom/src/loom/test/corpus/source_low/predicate_extension.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @predicate_extension_i8(%condition: i1) -> (i8, i8) {
  %signed = scalar.extsi %condition : i1 to i8
  %unsigned = scalar.extui %condition : i1 to i8
  func.return %signed, %unsigned : i8, i8
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @predicate_extension_i8(%condition: reg<spirv.id : i1>) -> (reg<spirv.id : i8>, reg<spirv.id : i8>) asm {
  %14 = OpConstant.i8 -1
  %15 = OpConstant.i8 0
  %signed = OpSelect.i8 %condition, %14, %15
  %17 = OpConstant.i8 1
  %unsigned = OpSelect.i8 %condition, %17, %15
  return %signed, %unsigned
}

// ====

