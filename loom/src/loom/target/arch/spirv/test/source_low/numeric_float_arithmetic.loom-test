// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_arithmetic.loom-test
// TEMPLATE-EXCLUDE: @float_arithmetic_f32 Requires scalar copysignf, negf and absf contracts.
// TEMPLATE-EXCLUDE: @float_arithmetic_f64 Requires scalar copysignf, negf and absf contracts.
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @float_arithmetic_f16(%a: f16, %b: f16) -> (f16, f16) {
  %sum = scalar.addf %a, %b : f16
  %product = scalar.mulf %a, %b : f16
  func.return %sum, %product : f16, f16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @float_arithmetic_f16(%a: reg<spirv.id : f16>, %b: reg<spirv.id : f16>) -> (reg<spirv.id : f16>, reg<spirv.id : f16>) asm {
  %sum = OpFAdd.f16 %a, %b
  %product = OpFMul.f16 %a, %b
  return %sum, %product
}

// ====

func.def @float_arithmetic_bf16(%a: bf16, %b: bf16) -> (bf16, bf16) {
  %sum = scalar.addf %a, %b : bf16
  %product = scalar.mulf %a, %b : bf16
  func.return %sum, %product : bf16, bf16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @float_arithmetic_bf16(%a: reg<spirv.id : bf16>, %b: reg<spirv.id : bf16>) -> (reg<spirv.id : bf16>, reg<spirv.id : bf16>) asm {
  %18 = OpFConvert.bf16.f32 %a
  %19 = OpFConvert.bf16.f32 %b
  %20 = OpFAdd.f32 %18, %19
  %21 = OpConstant.i32 16
  %22 = OpConstant.i32 1
  %23 = OpConstant.i32 32767
  %24 = OpConstant.i32 2147483647
  %25 = OpConstant.i32 2139095040
  %26 = OpConstant.i32 64
  %27 = OpBitcast.f32.i32 %20 : reg<spirv.id>
  %28 = OpShiftRightLogical %27, %21 : reg<spirv.id>
  %29 = OpBitwiseAnd %28, %22 : reg<spirv.id>
  %30 = OpIAdd %29, %23 : reg<spirv.id>
  %31 = OpIAdd %27, %30 : reg<spirv.id>
  %32 = OpShiftRightLogical %31, %21 : reg<spirv.id>
  %33 = OpBitwiseAnd %27, %24 : reg<spirv.id>
  %34 = OpSGreaterThan %33, %25 : reg<spirv.id>
  %35 = OpBitwiseOr %28, %26 : reg<spirv.id>
  %36 = OpSelect %34, %35, %32 : reg<spirv.id>
  %37 = OpSConvert.i32.i16 %36 : reg<spirv.id>
  %sum = OpBitcast.i16.bf16 %37
  %39 = OpFMul.f32 %18, %19
  %46 = OpBitcast.f32.i32 %39 : reg<spirv.id>
  %47 = OpShiftRightLogical %46, %21 : reg<spirv.id>
  %48 = OpBitwiseAnd %47, %22 : reg<spirv.id>
  %49 = OpIAdd %48, %23 : reg<spirv.id>
  %50 = OpIAdd %46, %49 : reg<spirv.id>
  %51 = OpShiftRightLogical %50, %21 : reg<spirv.id>
  %52 = OpBitwiseAnd %46, %24 : reg<spirv.id>
  %53 = OpSGreaterThan %52, %25 : reg<spirv.id>
  %54 = OpBitwiseOr %47, %26 : reg<spirv.id>
  %55 = OpSelect %53, %54, %51 : reg<spirv.id>
  %56 = OpSConvert.i32.i16 %55 : reg<spirv.id>
  %product = OpBitcast.i16.bf16 %56
  return %sum, %product
}
