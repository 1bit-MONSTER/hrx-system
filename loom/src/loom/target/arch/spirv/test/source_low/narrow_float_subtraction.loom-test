// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @subtract_f16_1(%lhs: f16, %rhs: f16) -> (f16) {
  %difference = scalar.subf %lhs, %rhs : f16
  func.return %difference : f16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @subtract_f16_1(%lhs: reg<spirv.id : f16>, %rhs: reg<spirv.id : f16>) -> (reg<spirv.id : f16>) asm {
  %difference = OpFSub.f16 %lhs, %rhs
  return %difference
}

