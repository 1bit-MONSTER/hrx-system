  %199 = OpLoad.storage_buffer.i32 %198
  %200 = OpConstant.offset64 52
  %201 = OpIAdd.offset64 %source_offset, %200
  %202 = OpPtrAccessChain.storage_buffer.i32.byte_offset %source, %201
