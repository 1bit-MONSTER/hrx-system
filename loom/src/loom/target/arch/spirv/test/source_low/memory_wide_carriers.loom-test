// ====

func.def @copy_wide_origin_scalar(%input: buffer, %output: buffer, %byte_offset_input: i64) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %byte_offset = scalar.assume %byte_offset_input [range(%byte_offset_input, 0, 4096), multiple_of(%byte_offset_input, 64)] : i64
  %prefix = scalar.constant 64 : i64
  %source_origin = scalar.addi %byte_offset, %prefix : i64
  %source_offset = index.cast %source_origin : i64 to offset
  %destination_offset = index.cast %byte_offset : i64 to offset
  %source_view = buffer.view %source[%source_offset] : buffer -> view<1xi32>
  %destination_view = buffer.view %destination[%destination_offset] : buffer -> view<1xi32>
  %value = view.load %source_view[0] : view<1xi32> -> i32
  view.store %value, %destination_view[0] : i32, view<1xi32>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @copy_wide_origin_scalar(%source: reg<spirv.ptr.storage_buffer>, %destination: reg<spirv.ptr.storage_buffer>, %byte_offset: reg<spirv.id : i64>) asm {
  %prefix = OpConstant.i64 64
  %source_origin = OpIAdd.i64 %byte_offset, %prefix
  %source_offset = OpBitcast.i64.offset64 %source_origin
  %destination_offset = OpBitcast.i64.offset64 %byte_offset
  %20 = OpPtrAccessChain.storage_buffer.i32.byte_offset %source, %source_offset
  %value = OpLoad.storage_buffer.i32 %20
  %22 = OpPtrAccessChain.storage_buffer.i32.byte_offset %destination, %destination_offset
  OpStore.storage_buffer.i32 %22, %value
  return
}

// ====

func.def @exchange_wide_origin(%buffer: buffer, %base_input: i64, %position_input: index, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %wide_base = scalar.assume %base_input [range(%base_input, 0, 128), multiple_of(%base_input, 8)] : i64
  %base = index.cast %wide_base : i64 to offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @exchange_wide_origin(%aligned_buffer: reg<spirv.ptr.storage_buffer>, %wide_base: reg<spirv.id : i64>, %position: reg<spirv.id : index>, %value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %base = OpBitcast.i64.offset64 %wide_base
  %19 = OpSConvert.i32.offset64 %position
  %20 = OpConstant.offset64 4
  %21 = OpIMul.offset64 %19, %20
  %22 = OpIAdd.offset64 %base, %21
  %23 = OpConstant.offset64 16
  %24 = OpIAdd.offset64 %22, %23
  %25 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned_buffer, %24
  %previous = OpLoad.storage_buffer.i32 %25
  OpStore.storage_buffer.i32 %25, %value
  return %previous
}

// ====

func.def @exchange_signed_coordinate(%buffer: buffer, %base_input: offset, %position_input: i32, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 64, 128), multiple_of(%base_input, 8)] : offset
  %signed_position = scalar.assume %position_input [range(%position_input, -8, -1)] : i32
  %coordinate = index.cast %signed_position : i32 to index
  %bias = index.constant 8 : index
  %position = index.add %coordinate, %bias : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @exchange_signed_coordinate(%aligned_buffer: reg<spirv.ptr.storage_buffer>, %base: reg<spirv.offset64>, %signed_position: reg<spirv.id : i32>, %value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %20 = OpSConvert.i32.offset64 %signed_position
  %21 = OpConstant.offset64 4
  %22 = OpIMul.offset64 %20, %21
  %23 = OpIAdd.offset64 %base, %22
  %24 = OpConstant.offset64 48
  %25 = OpIAdd.offset64 %23, %24
  %26 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned_buffer, %25
  %previous = OpLoad.storage_buffer.i32 %26
  OpStore.storage_buffer.i32 %26, %value
  return %previous
}
