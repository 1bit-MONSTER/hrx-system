// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @binary64_to_binary32(%input: f64) -> (f32) {
  %result = scalar.fptrunc %input : f64 to f32
  func.return %result : f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @binary64_to_binary32(%input: reg<spirv.id : f64>) -> (reg<spirv.id : f32>) asm {
  %result = OpFConvert.f64.f32 %input
  return %result
}

