func.def @fptosi_f8E4M3_i16_1(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xf8E4M3>
  %target = buffer.view %output[%base] : buffer -> view<1xi16>
  %value = view.load %source[0] : view<1xf8E4M3> -> f8E4M3
  %converted = scalar.fptosi %value : f8E4M3 to i16
  view.store %converted, %target[0] : i16, view<1xi16>
  func.return
}

