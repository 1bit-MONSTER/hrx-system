  %number = OpSelect.v2f32 %395, %upper, %396
  %398 = OpSelect.v2f32 %364, %366, %387
  %399 = OpBitcast.v2f32.v2i32 %398
  %400 = OpBitwiseOr.v2i32 %399, %368
