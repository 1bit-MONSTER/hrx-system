  %maximum_lane = OpCompositeExtract.v2f32.f32 %maximum, 1
  %minnum_lane = OpCompositeExtract.v2f32.f32 %363, 0
  %maxnum_lane = OpCompositeExtract.v2f32.f32 %377, 1
