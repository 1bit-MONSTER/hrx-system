// RUN: with-checks emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
CHECK: %7 = OpConstant.offset64 0
CHECK: %8 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %7
CHECK: %first = OpLoad.storage_buffer.i32<volatile> %8
CHECK: %10 = OpConstant.offset64 4
CHECK: %11 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %10
CHECK: %second = OpLoad.storage_buffer.i32<volatile> %11
CHECK: return
CHECK-NOT: * = OpLoad.storage_buffer.i32 *

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

// ----
CHECK: %77 = OpConstant.offset64 0
CHECK: %78 = OpPtrAccessChain.storage_buffer.i32.byte_offset %source_aligned, %77
CHECK: %79 = OpLoad.storage_buffer.i32<volatile> %78
CHECK: %122 = OpConstant.offset64 60
CHECK: %123 = OpPtrAccessChain.storage_buffer.i32.byte_offset %source_aligned, %122
CHECK: %124 = OpLoad.storage_buffer.i32<volatile> %123
CHECK: %127 = OpLoad.storage_buffer.i32<volatile> %78
CHECK: %172 = OpLoad.storage_buffer.i32<volatile> %123
CHECK: %174 = OpPtrAccessChain.storage_buffer.i32.byte_offset %destination_aligned, %77
CHECK: OpStore.storage_buffer.i32<volatile> %174, %79
CHECK: %204 = OpPtrAccessChain.storage_buffer.i32.byte_offset %destination_aligned, %122
CHECK: OpStore.storage_buffer.i32<volatile> %204, %124
CHECK: %205 = OpConstant.offset64 64
CHECK: %206 = OpPtrAccessChain.storage_buffer.i32.byte_offset %destination_aligned, %205
CHECK: OpStore.storage_buffer.i32<volatile> %206, %127
CHECK: %235 = OpConstant.offset64 124
CHECK: %236 = OpPtrAccessChain.storage_buffer.i32.byte_offset %destination_aligned, %235
CHECK: OpStore.storage_buffer.i32<volatile> %236, %172
CHECK-NOT: * = OpLoad.storage_buffer.i32 *
CHECK-NOT: OpStore.storage_buffer.i32 *

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
CHECK: %9 = OpConstant.offset64 0
CHECK: %10 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %9
CHECK: %first = OpLoad.storage_buffer.i8<volatile> %10
CHECK: %second = OpLoad.storage_buffer.i8<volatile> %10
CHECK: %16 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %9
CHECK: OpStore.storage_buffer.i8<volatile> %16, %first
CHECK: %17 = OpConstant.offset64 1
CHECK: %18 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %17
CHECK: OpStore.storage_buffer.i8<volatile> %18, %second
CHECK-NOT: * = OpLoad.storage_buffer.i8 *
CHECK-NOT: OpStore.storage_buffer.i8 *

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), multiple_of(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
CHECK: %13 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %base
CHECK: %first = OpLoad.storage_buffer.i32<volatile> %13
CHECK: %15 = OpConstant.offset64 4
CHECK: %16 = OpIAdd.offset64 %base, %15
CHECK: %17 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %16
CHECK: %second = OpLoad.storage_buffer.i32<volatile> %17
CHECK: return %first, %second
CHECK-NOT: * = OpLoad.storage_buffer.i32 *

// ====
// RUN: emit source-low target=spirv:vulkan1.3+bda output=low

// All volatile reads are captured before the overlapping writes. Native
// arithmetic consumes the assembled snapshot once, and the final scalar
// stores extract that result without rebuilding its producer per lane.
func.def @volatile_overlapping_vector_rounding(%storage: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %storage {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<4xf32>
  %value = vector.load<volatile> %view[0] : view<4xf32> -> vector<3xf32>
  %rounded = vector.roundevenf<nnan|ninf|nsz> %value : vector<3xf32>
  vector.store<volatile> %rounded, %view[1] : vector<3xf32>, view<4xf32>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @volatile_overlapping_vector_rounding(%aligned: reg<spirv.ptr.storage_buffer>) asm {
  %14 = OpConstant.offset64 0
  %15 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %14
  %16 = OpLoad.storage_buffer.f32<volatile> %15
  %17 = OpConstant.offset64 4
  %18 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %17
  %19 = OpLoad.storage_buffer.f32<volatile> %18
  %20 = OpConstant.offset64 8
  %21 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %20
  %22 = OpLoad.storage_buffer.f32<volatile> %21
  %value = OpCompositeConstruct.v3f32 %16, %19, %22
  %rounded = OpExtInst.GLSL.std.450.RoundEven.v3f32 %value
  %25 = OpCompositeExtract.v3f32.f32 %rounded, 0
  %26 = OpCompositeExtract.v3f32.f32 %rounded, 1
  %27 = OpCompositeExtract.v3f32.f32 %rounded, 2
  OpStore.storage_buffer.f32<volatile> %18, %25
  OpStore.storage_buffer.f32<volatile> %21, %26
  %32 = OpConstant.offset64 12
  %33 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %32
  OpStore.storage_buffer.f32<volatile> %33, %27
  return
}
