// RUN: with-checks emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

// Packed byte accesses retain their byte alignment when split into words.
kernel.def @byte_origin() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %start = index.constant 1 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%start] : buffer -> view<32xi8>
  %value = vector.load %source_view[0] : view<32xi8> -> vector<32xi8>
  %destination_view = buffer.view %destination[%c0] : buffer -> view<32xi8>
  vector.store %value, %destination_view[0] : vector<32xi8>, view<32xi8>
  kernel.return
}

// ----
CHECK: %78 = OpConstant.offset64 1
CHECK: %79 = OpPtrAccessChain.storage_buffer.i8.byte_offset %source, %78
CHECK: %80 = OpLoad.storage_buffer.i8 %79
CHECK: %171 = OpConstant.offset64 32
CHECK: %172 = OpPtrAccessChain.storage_buffer.i8.byte_offset %source, %171
CHECK: %173 = OpLoad.storage_buffer.i8 %172
CHECK: %174 = OpConstant.offset64 0
CHECK: %175 = OpPtrAccessChain.storage_buffer.i8.byte_offset %destination, %174
CHECK: OpStore.storage_buffer.i8 %175, %80
CHECK: %168 = OpConstant.offset64 31
CHECK: %237 = OpPtrAccessChain.storage_buffer.i8.byte_offset %destination, %168
CHECK: OpStore.storage_buffer.i8 %237, %173

// ====

// A halfword origin preserves two-byte alignment within a wider payload.
kernel.def @halfword_origin() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %start = index.constant 2 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%start] : buffer -> view<16xi16>
  %value = vector.load %source_view[0] : view<16xi16> -> vector<16xi16>
  %destination_view = buffer.view %destination[%c0] : buffer -> view<16xi16>
  vector.store %value, %destination_view[0] : vector<16xi16>, view<16xi16>
  kernel.return
}

// ----
CHECK: %46 = OpConstant.offset64 2
CHECK: %47 = OpPtrAccessChain.storage_buffer.i16.byte_offset %source, %46
CHECK: %48 = OpLoad.storage_buffer.i16 %47
CHECK: %91 = OpConstant.offset64 32
CHECK: %92 = OpPtrAccessChain.storage_buffer.i16.byte_offset %source, %91
CHECK: %93 = OpLoad.storage_buffer.i16 %92
CHECK: %94 = OpConstant.offset64 0
CHECK: %95 = OpPtrAccessChain.storage_buffer.i16.byte_offset %destination, %94
CHECK: OpStore.storage_buffer.i16 %95, %48
CHECK: %88 = OpConstant.offset64 30
CHECK: %125 = OpPtrAccessChain.storage_buffer.i16.byte_offset %destination, %88
CHECK: OpStore.storage_buffer.i16 %125, %93

// ====

// A word origin retains four-byte alignment within a wider payload.
kernel.def @word_origin() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %start = index.constant 4 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%start] : buffer -> view<32xi8>
  %value = vector.load %source_view[0] : view<32xi8> -> vector<32xi8>
  %destination_view = buffer.view %destination[%c0] : buffer -> view<32xi8>
  vector.store %value, %destination_view[0] : vector<32xi8>, view<32xi8>
  kernel.return
}

// ----
CHECK: %78 = OpConstant.offset64 4
CHECK: %79 = OpPtrAccessChain.storage_buffer.i8.byte_offset %source, %78
CHECK: %80 = OpLoad.storage_buffer.i8 %79
CHECK: %171 = OpConstant.offset64 35
CHECK: %172 = OpPtrAccessChain.storage_buffer.i8.byte_offset %source, %171
CHECK: %173 = OpLoad.storage_buffer.i8 %172
CHECK: %174 = OpConstant.offset64 0
CHECK: %175 = OpPtrAccessChain.storage_buffer.i8.byte_offset %destination, %174
CHECK: OpStore.storage_buffer.i8 %175, %80
CHECK: %159 = OpConstant.offset64 31
CHECK: %237 = OpPtrAccessChain.storage_buffer.i8.byte_offset %destination, %159
CHECK: OpStore.storage_buffer.i8 %237, %173
