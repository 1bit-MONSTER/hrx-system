// A halfword origin preserves two-byte alignment within a wider payload.
kernel.def @halfword_origin() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %start = index.constant 2 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%start] : buffer -> view<16xi16>
  %value = vector.load %source_view[0] : view<16xi16> -> vector<16xi16>
  %destination_view = buffer.view %destination[%c0] : buffer -> view<16xi16>
  vector.store %value, %destination_view[0] : vector<16xi16>, view<16xi16>
  kernel.return
}

