  %190 = OpShiftLeftLogical %189, %141
  %191 = OpConstant.i32 21
  %192 = OpShiftLeftLogical %187, %191
  %193 = OpBitwiseOr %183, %190
  %194 = OpBitwiseOr %193, %192
  %195 = OpBitwiseAnd %187, %148
