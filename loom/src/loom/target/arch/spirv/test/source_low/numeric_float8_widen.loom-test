// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float8_widen.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @float8_to_half(%e4m3: f8E4M3, %e5m2: f8E5M2) -> (f16, f16) {
  %half_e4m3 = scalar.extf %e4m3 : f8E4M3 to f16
  %half_e5m2 = scalar.extf %e5m2 : f8E5M2 to f16
  func.return %half_e4m3, %half_e5m2 : f16, f16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @float8_to_half(%e4m3: reg<spirv.id : i8>, %e5m2: reg<spirv.id : i8>) -> (reg<spirv.id : f16>, reg<spirv.id : f16>) asm {
