  // ERROR@+1: LOWERING/036 {op_name="scalar.logf", phase_name="legalize-math", policy_name="spirv-math", math_op="logf", lane_domain="scalar", element_type="f64", constraint_key="math.transcendental.f32"}
  %result = scalar.logf<afn> %input : f64
