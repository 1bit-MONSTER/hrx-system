spirv.target<vulkan1_3> @target

func.def target(@target) @exact_exp(%input: f32) -> (f32) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.expf", phase_name="legalize-math", policy_name="spirv-math", math_op="expf", lane_domain="scalar", element_type="f32", constraint_key="math.transcendental.afn"}
  %result = scalar.expf %input : f32
  func.return %result : f32
}

