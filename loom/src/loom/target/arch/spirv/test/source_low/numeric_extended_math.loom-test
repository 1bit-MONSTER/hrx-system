spirv.target<vulkan1_3> @target

func.def target(@target) @exact_minnum(%lhs: f32, %rhs: f32) -> (f32) {
  // ERROR@+1: TARGET/003 {op_name="scalar.minnumf", subject_role="flags", subject_name="fastmath", constraint_key="has_all.nsz"}
  %result = scalar.minnumf %lhs, %rhs : f32
