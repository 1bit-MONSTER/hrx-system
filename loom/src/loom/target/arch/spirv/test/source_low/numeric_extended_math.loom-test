spirv.target<vulkan1_3> @target

func.def target(@target) @exact_vector_log2(%input: f32) -> (f32) {
  %values = vector.splat %input : vector<4xf32>
  // ERROR@+1: LOWERING/036 {op_name="vector.log2f", phase_name="legalize-math", policy_name="spirv-math", math_op="log2f", lane_domain="vector", element_type="f32", constraint_key="math.transcendental.afn"}
  %logs = vector.log2f %values : vector<4xf32>
  %result = vector.extract %logs[0] : vector<4xf32> -> f32
  func.return %result : f32
}

