  %198 = OpShiftRightLogical %197, %160
  %199 = OpBitwiseAnd %193, %148
  %200 = OpConstant.i32 112
  %201 = OpIAdd %198, %200
  %202 = OpShiftLeftLogical %201, %153
  %203 = OpConstant.i32 21
  %204 = OpShiftLeftLogical %199, %203
  %205 = OpBitwiseOr %195, %202
  %206 = OpBitwiseOr %205, %204
  %207 = OpBitwiseAnd %199, %160
  %208 = OpINotEqual %207, %159
  %209 = OpSelect %208, %163, %159
  %210 = OpConstant.i32 111
  %211 = OpIAdd %209, %210
  %212 = OpShiftLeftLogical %211, %153
  %213 = OpISub %153, %209
  %214 = OpShiftLeftLogical %199, %213
  %215 = OpBitwiseAnd %214, %174
  %216 = OpBitwiseOr %195, %212
