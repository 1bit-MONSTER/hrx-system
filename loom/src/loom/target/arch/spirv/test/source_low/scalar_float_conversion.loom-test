// TEMPLATE: loom/src/loom/test/corpus/source_low/scalar_float_conversion.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @convert_scalar_f64(%single: f32, %double: f64) -> (f64, f32) {
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  func.return %wide, %narrow : f64, f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @convert_scalar_f64(%single: reg<spirv.id : f32>, %double: reg<spirv.id : f64>) -> (reg<spirv.id : f64>, reg<spirv.id : f32>) asm {
  %wide = OpFConvert.f32.f64 %single
  %narrow = OpFConvert.f64.f32 %double
  return %wide, %narrow
}

// ====

kernel.def @floating_arguments() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%single: f32, %double: f64, %output: buffer) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<3xf32>
  %single_double = scalar.fptrunc %double : f64 to f32
  %wide = scalar.extf %single : f32 to f64
  %roundtrip = scalar.fptrunc %wide : f64 to f32
  view.store %single, %output_view[0] : f32, view<3xf32>
  view.store %single_double, %output_view[1] : f32, view<3xf32>
  view.store %roundtrip, %output_view[2] : f32, view<3xf32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @floating_arguments(%single: reg<spirv.id : f32>, %double: reg<spirv.id : f64>) asm {
  %output = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %single_double = OpFConvert.f64.f32 %double
  %13 = OpConstant.offset64 0
  %14 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output, %13
  OpStore.storage_buffer.f32 %14, %single
  %15 = OpConstant.offset64 4
  %16 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output, %15
  OpStore.storage_buffer.f32 %16, %single_double
  %17 = OpConstant.offset64 8
  %18 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output, %17
  OpStore.storage_buffer.f32 %18, %single
  return
}

// ====

func.def @widen_narrow_to_f64(%e4: f8E4M3, %e5: f8E5M2, %half: f16, %brain: bf16) -> (f64, f64, f64, f64) {
  %double_e4 = scalar.extf %e4 : f8E4M3 to f64
  %double_e5 = scalar.extf %e5 : f8E5M2 to f64
  %double_half = scalar.extf %half : f16 to f64
  %double_brain = scalar.extf %brain : bf16 to f64
  func.return %double_e4, %double_e5, %double_half, %double_brain : f64, f64, f64, f64
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @widen_narrow_to_f64(%e4: reg<spirv.id : i8>, %e5: reg<spirv.id : i8>, %half: reg<spirv.id : f16>, %brain: reg<spirv.id : bf16>) -> (reg<spirv.id : f64>, reg<spirv.id : f64>, reg<spirv.id : f64>, reg<spirv.id : f64>) asm {
