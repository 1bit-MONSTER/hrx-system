// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @convert_scalar_f64(%single: f32, %double: f64) -> (f64, f32, f16) {
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  %half = scalar.fptrunc %double : f64 to f16
  func.return %wide, %narrow, %half : f64, f32, f16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @convert_scalar_f64(%single: reg<spirv.id : f32>, %double: reg<spirv.id : f64>) -> (reg<spirv.id : f64>, reg<spirv.id : f32>, reg<spirv.id : f16>) asm {
  %wide = OpFConvert.f32.f64 %single
  %14 = OpBitcast.f64.i64 %double : reg<spirv.id>
