  %167 = OpINotEqual %166, %159
  %168 = OpSelect %167, %160, %164
  %169 = OpConstant.i32 118
  %170 = OpIAdd %168, %169
  %171 = OpShiftLeftLogical %170, %153
  %172 = OpISub %153, %168
  %173 = OpShiftLeftLogical %151, %172
  %174 = OpConstant.i32 8388607
  %175 = OpBitwiseAnd %173, %174
  %176 = OpBitwiseOr %145, %171
  %177 = OpBitwiseOr %176, %175
  %178 = OpIEqual %151, %159
  %179 = OpSelect %178, %145, %177
  %180 = OpIEqual %149, %159
  %181 = OpSelect %180, %179, %158
  %182 = OpConstant.i32 15
  %183 = OpIEqual %149, %182
  %184 = OpConstant.i32 2143289344
  %185 = OpIEqual %151, %150
  %186 = OpConstantFalse.bool
  %187 = OpSelect.bool %183, %185, %186
  %188 = OpSelect %187, %184, %181
  %189 = OpBitcast.i32.f32 %188
  %double_e4 = OpFConvert.f32.f64 %189
  %191 = OpBitcast.i8.u8 %e5
  %192 = OpUConvert.u8.u32 %191
