// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

// This profile lacks the optional controls required by native IEEE widening.
// Numerical coverage belongs to the exhaustive executable conversion corpus.
func.def @widen_half(%value: f16) -> (f32) {
  %result = scalar.extf %value : f16 to f32
  func.return %result : f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @widen_half(%value: reg<spirv.id : f16>) -> (reg<spirv.id : f32>) asm {
  %5 = OpCompositeConstruct.v2f16 %value, %value : reg<spirv.id>
  %6 = OpBitcast.v2f16.i32 %5 : reg<spirv.id>
  %7 = OpConstant.i32 32767 : reg<spirv.id>
  %8 = OpBitwiseAnd %6, %7 : reg<spirv.id>
  %9 = OpConstant.i32 32768 : reg<spirv.id>
  %10 = OpBitwiseAnd %6, %9 : reg<spirv.id>
  %11 = OpConstant.i32 16 : reg<spirv.id>
  %12 = OpShiftLeftLogical %10, %11 : reg<spirv.id>
  %13 = OpConstant.i32 1024 : reg<spirv.id>
  %14 = OpSLessThan %8, %13 : reg<spirv.id>
  %15 = OpConstant.i32 31744 : reg<spirv.id>
  %16 = OpSGreaterThanEqual %8, %15 : reg<spirv.id>
  %17 = OpConstant.i32 0 : reg<spirv.id>
  %18 = OpIEqual %8, %17 : reg<spirv.id>
  %19 = OpConstant.i32 1879048192 : reg<spirv.id>
  %20 = OpConstant.i32 939524096 : reg<spirv.id>
  %21 = OpSelect %16, %19, %20 : reg<spirv.id>
  %22 = OpConstant.i32 13 : reg<spirv.id>
  %23 = OpShiftLeftLogical %8, %22 : reg<spirv.id>
  %24 = OpIAdd %23, %21 : reg<spirv.id>
  %25 = OpConvertSToF.i32.f32 %8 : reg<spirv.id>
  %26 = OpBitcast.f32.i32 %25 : reg<spirv.id>
  %27 = OpConstant.i32 -201326592 : reg<spirv.id>
  %28 = OpIAdd %26, %27 : reg<spirv.id>
  %29 = OpSelect %14, %28, %24 : reg<spirv.id>
  %30 = OpSelect %18, %17, %29 : reg<spirv.id>
  %31 = OpBitwiseOr %30, %12 : reg<spirv.id>
  %result = OpBitcast.i32.f32 %31
  return %result
}

// ====

// Arithmetic retains its native vector shape and packs Float64 through I32.
func.def @widen_pair(%first: f32, %second: f32) -> (f64) {
  %input = vector.from_elements %first, %second : vector<2xf32>
  %wide = vector.extf %input : vector<2xf32> to vector<2xf64>
  %result = vector.extract %wide[1] : vector<2xf64> -> f64
  func.return %result : f64
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @widen_pair(%first: reg<spirv.id : f32>, %second: reg<spirv.id : f32>) -> (reg<spirv.id : f64>) asm {
  %input = OpCompositeConstruct.v2f32 %first, %second
  %10 = OpBitcast.v2f32.v2i32 %input : reg<spirv.id>
  %11 = OpConstant.i32 2147483647 : reg<spirv.id>
  %12 = OpCompositeConstruct.v2i32 %11, %11 : reg<spirv.id>
  %13 = OpBitwiseAnd.v2i32 %10, %12 : reg<spirv.id>
  %14 = OpConstant.i32 -2147483648 : reg<spirv.id>
  %15 = OpCompositeConstruct.v2i32 %14, %14 : reg<spirv.id>
  %16 = OpBitwiseAnd.v2i32 %10, %15 : reg<spirv.id>
  %17 = OpConstant.i32 8388608 : reg<spirv.id>
  %18 = OpCompositeConstruct.v2i32 %17, %17 : reg<spirv.id>
  %19 = OpSLessThan.v2i32 %13, %18 : reg<spirv.id>
  %20 = OpConstant.i32 2139095040 : reg<spirv.id>
  %21 = OpCompositeConstruct.v2i32 %20, %20 : reg<spirv.id>
  %22 = OpSGreaterThanEqual.v2i32 %13, %21 : reg<spirv.id>
  %23 = OpConstant.i32 0 : reg<spirv.id>
  %24 = OpCompositeConstruct.v2i32 %23, %23 : reg<spirv.id>
  %25 = OpIEqual.v2i32 %13, %24 : reg<spirv.id>
  %26 = OpConstant.i32 1879048192 : reg<spirv.id>
  %27 = OpCompositeConstruct.v2i32 %26, %26 : reg<spirv.id>
  %28 = OpConstant.i32 939524096 : reg<spirv.id>
  %29 = OpCompositeConstruct.v2i32 %28, %28 : reg<spirv.id>
  %30 = OpSelect.v2i32 %22, %27, %29 : reg<spirv.id>
  %31 = OpConstant.i32 3 : reg<spirv.id>
  %32 = OpCompositeConstruct.v2i32 %31, %31 : reg<spirv.id>
  %33 = OpShiftRightLogical.v2i32 %13, %32 : reg<spirv.id>
  %34 = OpIAdd.v2i32 %33, %30 : reg<spirv.id>
  %35 = OpConvertSToF.v2i32.v2f32 %13 : reg<spirv.id>
  %36 = OpBitcast.v2f32.v2i32 %35 : reg<spirv.id>
  %37 = OpShiftRightLogical.v2i32 %36, %32 : reg<spirv.id>
  %38 = OpConstant.i32 783286272 : reg<spirv.id>
  %39 = OpCompositeConstruct.v2i32 %38, %38 : reg<spirv.id>
  %40 = OpIAdd.v2i32 %37, %39 : reg<spirv.id>
  %41 = OpSelect.v2i32 %19, %40, %34 : reg<spirv.id>
  %42 = OpSelect.v2i32 %25, %24, %41 : reg<spirv.id>
  %43 = OpBitwiseOr.v2i32 %42, %16 : reg<spirv.id>
  %44 = OpSelect.v2i32 %19, %36, %13 : reg<spirv.id>
  %45 = OpConstant.i32 29 : reg<spirv.id>
  %46 = OpCompositeConstruct.v2i32 %45, %45 : reg<spirv.id>
  %47 = OpShiftLeftLogical.v2i32 %44, %46 : reg<spirv.id>
  %48 = OpCompositeExtract.v2i32.i32 %47, 0 : reg<spirv.id>
  %49 = OpCompositeExtract.v2i32.i32 %43, 0 : reg<spirv.id>
  %50 = OpCompositeConstruct.v2i32 %48, %49 : reg<spirv.id>
  %51 = OpBitcast.v2i32.f64 %50 : reg<spirv.id>
  %52 = OpCompositeExtract.v2i32.i32 %47, 1 : reg<spirv.id>
  %53 = OpCompositeExtract.v2i32.i32 %43, 1 : reg<spirv.id>
  %54 = OpCompositeConstruct.v2i32 %52, %53 : reg<spirv.id>
  %55 = OpBitcast.v2i32.f64 %54 : reg<spirv.id>
  %wide = OpCompositeConstruct.v2f64 %51, %55
  %result = OpCompositeExtract.v2f64.f64 %wide, 1
  return %result
}
