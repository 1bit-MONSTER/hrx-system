  %93 = OpSelect %91, %92, %88
  %94 = OpConstant.i32 4
  %95 = OpBitwiseAnd %80, %94
  %96 = OpINotEqual %95, %88
  %97 = OpSelect %96, %89, %93
  %98 = OpConstant.i32 118
  %99 = OpIAdd %97, %98
  %100 = OpShiftLeftLogical %99, %82
  %101 = OpISub %82, %97
  %102 = OpShiftLeftLogical %80, %101
  %103 = OpConstant.i32 8388607
  %104 = OpBitwiseAnd %102, %103
  %105 = OpBitwiseOr %74, %100
  %106 = OpBitwiseOr %105, %104
  %107 = OpIEqual %80, %88
  %108 = OpSelect %107, %74, %106
  %109 = OpIEqual %78, %88
  %110 = OpSelect %109, %108, %87
  %111 = OpConstant.i32 15
  %112 = OpIEqual %78, %111
  %113 = OpConstant.i32 2143289344
  %114 = OpIEqual %80, %79
  %115 = OpConstantFalse.bool
  %116 = OpSelect.bool %112, %114, %115
  %117 = OpSelect %116, %113, %110
  %118 = OpBitcast.i32.f32 %117
  %double = OpFConvert.f32.f64 %118
  return %double
}
