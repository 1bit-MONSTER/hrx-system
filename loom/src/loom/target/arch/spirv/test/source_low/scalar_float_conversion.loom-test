  %67 = OpBitwiseOr.i64 %18, %66 : reg<spirv.id>
  %68 = OpBitcast.i64.v2f32 %67 : reg<spirv.id>
  %narrow = OpCompositeExtract.v2f32.f32 %68, 0
  %73 = OpConstant.i64 48 : reg<spirv.id>
  %74 = OpShiftRightLogical.i64 %16, %73 : reg<spirv.id>
  %83 = OpConstant.i64 1008 : reg<spirv.id>
  %84 = OpSGreaterThan.i64 %26, %83 : reg<spirv.id>
  %85 = OpSelect.i64 %84, %83, %26 : reg<spirv.id>
