  %29 = OpSelect.i64 %28, %27, %26 : reg<spirv.id>
  %30 = OpConstant.i64 926 : reg<spirv.id>
  %31 = OpISub.i64 %30, %29 : reg<spirv.id>
  %32 = OpConstant.i64 63 : reg<spirv.id>
  %33 = OpSGreaterThan.i64 %31, %32 : reg<spirv.id>
  %34 = OpSelect.i64 %33, %32, %31 : reg<spirv.id>
  %35 = OpShiftRightLogical.i64 %24, %34 : reg<spirv.id>
  %36 = OpConstant.i64 1 : reg<spirv.id>
  %37 = OpISub.i64 %34, %36 : reg<spirv.id>
  %38 = OpShiftLeftLogical.i64 %36, %37 : reg<spirv.id>
  %39 = OpISub.i64 %38, %36 : reg<spirv.id>
  %40 = OpBitwiseAnd.i64 %35, %36 : reg<spirv.id>
  %41 = OpIAdd.i64 %24, %39 : reg<spirv.id>
  %42 = OpIAdd.i64 %41, %40 : reg<spirv.id>
  %43 = OpShiftRightLogical.i64 %42, %34 : reg<spirv.id>
