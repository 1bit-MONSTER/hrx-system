  %50 = OpIAdd.i64 %49, %47 : reg<spirv.id>
  %51 = OpShiftRightLogical.i64 %50, %44 : reg<spirv.id>
  %52 = OpConstant.i64 4039728865751334912 : reg<spirv.id>
  %53 = OpSLessThan.i64 %20, %52 : reg<spirv.id>
  %54 = OpSelect.i64 %53, %43, %51 : reg<spirv.id>
  %55 = OpConstant.i64 2139095040 : reg<spirv.id>
  %56 = OpSGreaterThanEqual.i64 %54, %55 : reg<spirv.id>
  %57 = OpSelect.i64 %56, %55, %54 : reg<spirv.id>
  %60 = OpShiftRightLogical.i64 %22, %44 : reg<spirv.id>
  %61 = OpBitwiseOr.i64 %55, %60 : reg<spirv.id>
