// ====

func.def @widen_float8_chain(%input: f8E4M3) -> (f64) {
  %single = scalar.extf %input : f8E4M3 to f32
  %double = scalar.extf %single : f32 to f64
  func.return %double : f64
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @widen_float8_chain(%input: reg<spirv.id : i8>) -> (reg<spirv.id : f64>) asm {
  %68 = OpBitcast.i8.u8 %input
  %69 = OpUConvert.u8.u32 %68
  %70 = OpBitcast.u32.i32 %69
  %71 = OpConstant.i32 128
  %72 = OpBitwiseAnd %70, %71
