  %98 = OpIAdd.i64 %97, %96 : reg<spirv.id>
  %99 = OpShiftRightLogical.i64 %98, %90 : reg<spirv.id>
  %100 = OpConstant.i64 42 : reg<spirv.id>
  %101 = OpShiftRightLogical.i64 %20, %100 : reg<spirv.id>
  %103 = OpBitwiseAnd.i64 %101, %36 : reg<spirv.id>
  %104 = OpConstant.i64 -4539626225366204417 : reg<spirv.id>
  %105 = OpIAdd.i64 %20, %104 : reg<spirv.id>
  %106 = OpIAdd.i64 %105, %103 : reg<spirv.id>
  %107 = OpShiftRightLogical.i64 %106, %100 : reg<spirv.id>
  %108 = OpConstant.i64 4544132024016830464 : reg<spirv.id>
  %109 = OpSLessThan.i64 %20, %108 : reg<spirv.id>
  %110 = OpSelect.i64 %109, %99, %107 : reg<spirv.id>
  %111 = OpConstant.i64 31744 : reg<spirv.id>
