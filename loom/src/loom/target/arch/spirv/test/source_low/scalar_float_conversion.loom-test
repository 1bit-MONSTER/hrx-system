  %85 = OpShiftLeftLogical %80, %84
  %86 = OpBitwiseOr %74, %83
  %87 = OpBitwiseOr %86, %85
  %88 = OpConstant.i32 0
  %89 = OpConstant.i32 2
  %90 = OpBitwiseAnd %80, %89
  %91 = OpINotEqual %90, %88
