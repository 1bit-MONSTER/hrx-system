  %24 = OpConstant.i32 8388607 : reg<spirv.id>
  %25 = OpBitwiseAnd %23, %24 : reg<spirv.id>
  %26 = OpConstant.i32 8388608 : reg<spirv.id>
  %27 = OpBitwiseOr %25, %26 : reg<spirv.id>
  %28 = OpConstant.i32 23 : reg<spirv.id>
  %29 = OpShiftRightLogical %23, %28 : reg<spirv.id>
