  %37 = OpConstant.i32 2139095040 : reg<spirv.id>
  %38 = OpSGreaterThan %36, %37 : reg<spirv.id>
  %39 = OpConstant.i32 64 : reg<spirv.id>
  %40 = OpBitwiseOr %28, %39 : reg<spirv.id>
  %narrow = OpSelect %38, %40, %34
  %bits = OpSConvert.i32.i16 %narrow
  return %bits
}

