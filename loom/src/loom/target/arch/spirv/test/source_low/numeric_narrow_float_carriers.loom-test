// ====

// Extended scalar types without SPV_KHR_bfloat16.
spirv.target<vulkan1_3> @target {contract_feature_bits = 33278}

func.def target(@target) @narrow_bfloat_bits_to_float8_carriers(%input: i16) -> (i8, i8) {
  %bfloat = scalar.bitcast %input : i16 to bf16
  %e4m3 = scalar.fptrunc %bfloat : bf16 to f8E4M3
  %e5m2 = scalar.fptrunc %bfloat : bf16 to f8E5M2
  %e4m3_bits = scalar.bitcast %e4m3 : f8E4M3 to i8
  %e5m2_bits = scalar.bitcast %e5m2 : f8E5M2 to i8
  func.return %e4m3_bits, %e5m2_bits : i8, i8
}

