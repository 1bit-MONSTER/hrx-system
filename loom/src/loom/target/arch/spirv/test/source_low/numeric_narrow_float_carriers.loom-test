// RUN: emit source-low output=low control-flow=structured-low

// Extended scalar types without SPV_KHR_bfloat16.
spirv.target<vulkan1_3> @target {contract_feature_bits = 33278}

func.def target(@target) @narrow_bfloat_carrier(%input: f32) -> (i16) {
  %narrow = scalar.fptrunc %input : f32 to bf16
  %bits = scalar.bitcast %narrow : bf16 to i16
  func.return %bits : i16
}

func.def target(@target) @narrow_f8e4m3_carrier(%input: f32) -> (i8) {
  %narrow = scalar.fptrunc %input : f32 to f8E4M3
  %bits = scalar.bitcast %narrow : f8E4M3 to i8
  func.return %bits : i8
}

func.def target(@target) @narrow_f8e5m2_carrier(%input: f32) -> (i8) {
  %narrow = scalar.fptrunc %input : f32 to f8E5M2
  %bits = scalar.bitcast %narrow : f8E5M2 to i8
  func.return %bits : i8
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @narrow_bfloat_carrier(%input: reg<spirv.id : f32>) -> (reg<spirv.id : i16>) asm {
  %14 = OpConstant.i32 16
  %15 = OpConstant.i32 1
  %16 = OpConstant.i32 32767
  %17 = OpConstant.i32 2147483647
  %18 = OpConstant.i32 2139095040
  %19 = OpConstant.i32 64
  %20 = OpBitcast.f32.i32 %input : reg<spirv.id>
  %21 = OpShiftRightLogical %20, %14 : reg<spirv.id>
  %22 = OpBitwiseAnd %21, %15 : reg<spirv.id>
  %23 = OpIAdd %22, %16 : reg<spirv.id>
  %24 = OpIAdd %20, %23 : reg<spirv.id>
  %25 = OpShiftRightLogical %24, %14 : reg<spirv.id>
  %26 = OpBitwiseAnd %20, %17 : reg<spirv.id>
  %27 = OpSGreaterThan %26, %18 : reg<spirv.id>
  %28 = OpBitwiseOr %21, %19 : reg<spirv.id>
  %narrow = OpSelect %27, %28, %25
  %bits = OpSConvert.i32.i16 %narrow
  return %bits
}

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @narrow_f8e4m3_carrier(%input: reg<spirv.id : f32>) -> (reg<spirv.id : i8>) asm {
  %33 = OpBitcast.f32.i32 %input : reg<spirv.id>
  %34 = OpConstant.i32 -2147483648 : reg<spirv.id>
  %35 = OpBitwiseAnd %33, %34 : reg<spirv.id>
  %36 = OpConstant.i32 24 : reg<spirv.id>
  %37 = OpShiftRightLogical %35, %36 : reg<spirv.id>
  %38 = OpConstant.i32 2147483647 : reg<spirv.id>
  %39 = OpBitwiseAnd %33, %38 : reg<spirv.id>
  %40 = OpConstant.f32 1182793728 : reg<spirv.id>
  %41 = OpBitcast.i32.f32 %39 : reg<spirv.id>
  %42 = OpFAdd.f32 %41, %40 : reg<spirv.id>
  %43 = OpBitcast.f32.i32 %42 : reg<spirv.id>
  %44 = OpConstant.i32 1182793728 : reg<spirv.id>
  %45 = OpISub %43, %44 : reg<spirv.id>
  %46 = OpConstant.i32 20 : reg<spirv.id>
  %47 = OpShiftRightLogical %39, %46 : reg<spirv.id>
  %48 = OpConstant.i32 1 : reg<spirv.id>
  %49 = OpBitwiseAnd %47, %48 : reg<spirv.id>
  %50 = OpConstant.i32 -1006108673 : reg<spirv.id>
  %51 = OpIAdd %39, %50 : reg<spirv.id>
  %52 = OpIAdd %51, %49 : reg<spirv.id>
  %53 = OpShiftRightLogical %52, %46 : reg<spirv.id>
  %54 = OpConstant.i32 1015021568 : reg<spirv.id>
  %55 = OpSLessThan %39, %54 : reg<spirv.id>
  %56 = OpSelect %55, %45, %53 : reg<spirv.id>
  %58 = OpConstant.i32 127 : reg<spirv.id>
  %59 = OpConstant.i32 126 : reg<spirv.id>
  %60 = OpSGreaterThanEqual %56, %58 : reg<spirv.id>
  %61 = OpSelect %60, %59, %56 : reg<spirv.id>
  %63 = OpConstant.i32 2139095040 : reg<spirv.id>
  %64 = OpSGreaterThan %39, %63 : reg<spirv.id>
  %65 = OpSelect %64, %58, %61 : reg<spirv.id>
  %66 = OpBitwiseOr %37, %65 : reg<spirv.id>
  %bits = OpSConvert.i32.i8 %66
  return %bits
}

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @narrow_f8e5m2_carrier(%input: reg<spirv.id : f32>) -> (reg<spirv.id : i8>) asm {
  %70 = OpBitcast.f32.i32 %input : reg<spirv.id>
  %71 = OpConstant.i32 -2147483648 : reg<spirv.id>
  %72 = OpBitwiseAnd %70, %71 : reg<spirv.id>
  %73 = OpConstant.i32 24 : reg<spirv.id>
  %74 = OpShiftRightLogical %72, %73 : reg<spirv.id>
  %75 = OpConstant.i32 2147483647 : reg<spirv.id>
  %76 = OpBitwiseAnd %70, %75 : reg<spirv.id>
  %77 = OpConstant.f32 1124073472 : reg<spirv.id>
  %78 = OpBitcast.i32.f32 %76 : reg<spirv.id>
  %79 = OpFAdd.f32 %78, %77 : reg<spirv.id>
  %80 = OpBitcast.f32.i32 %79 : reg<spirv.id>
  %81 = OpConstant.i32 1124073472 : reg<spirv.id>
  %82 = OpISub %80, %81 : reg<spirv.id>
  %83 = OpConstant.i32 21 : reg<spirv.id>
  %84 = OpShiftRightLogical %76, %83 : reg<spirv.id>
  %85 = OpConstant.i32 1 : reg<spirv.id>
