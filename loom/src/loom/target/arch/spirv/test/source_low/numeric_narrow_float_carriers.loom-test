  %14 = OpConstant.i32 16 : reg<spirv.id>
  %15 = OpShiftLeftLogical %bfloat, %14 : reg<spirv.id>
  %16 = OpBitcast.i32.f32 %15 : reg<spirv.id>
  %17 = OpBitcast.f32.i32 %16 : reg<spirv.id>
