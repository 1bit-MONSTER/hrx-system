// RUN: emit source-low output=low control-flow=structured-low

// Extended scalar types without SPV_KHR_bfloat16.
spirv.target<vulkan1_3> @target {contract_feature_bits = 33278}

func.def target(@target) @narrow_bfloat_carrier(%input: f32) -> (i16) {
  %narrow = scalar.fptrunc %input : f32 to bf16
  %bits = scalar.bitcast %narrow : bf16 to i16
  func.return %bits : i16
}

func.def target(@target) @narrow_f8e4m3_carrier(%input: f32) -> (i8) {
  %narrow = scalar.fptrunc %input : f32 to f8E4M3
  %bits = scalar.bitcast %narrow : f8E4M3 to i8
  func.return %bits : i8
}

func.def target(@target) @narrow_f8e5m2_carrier(%input: f32) -> (i8) {
  %narrow = scalar.fptrunc %input : f32 to f8E5M2
  %bits = scalar.bitcast %narrow : f8E5M2 to i8
  func.return %bits : i8
}

func.def target(@target) @narrow_binary64_bfloat_carrier(%input: f64) -> (i16) {
  %narrow = scalar.fptrunc %input : f64 to bf16
  %bits = scalar.bitcast %narrow : bf16 to i16
  func.return %bits : i16
}

func.def target(@target) @narrow_bfloat_f8e4m3_carrier(%input: bf16) -> (i8) {
  %narrow = scalar.fptrunc %input : bf16 to f8E4M3
  %bits = scalar.bitcast %narrow : f8E4M3 to i8
  func.return %bits : i8
}

func.def target(@target) @narrow_bfloat_f8e5m2_carrier(%input: bf16) -> (i8) {
  %narrow = scalar.fptrunc %input : bf16 to f8E5M2
  %bits = scalar.bitcast %narrow : f8E5M2 to i8
  func.return %bits : i8
}

