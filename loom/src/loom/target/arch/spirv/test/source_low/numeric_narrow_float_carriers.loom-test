  %87 = OpConstant.i32 -938475521 : reg<spirv.id>
  %88 = OpIAdd %76, %87 : reg<spirv.id>
  %89 = OpIAdd %88, %86 : reg<spirv.id>
  %90 = OpShiftRightLogical %89, %83 : reg<spirv.id>
  %91 = OpConstant.i32 947912704 : reg<spirv.id>
  %92 = OpSLessThan %76, %91 : reg<spirv.id>
  %93 = OpSelect %92, %82, %90 : reg<spirv.id>
  %94 = OpConstant.i32 124 : reg<spirv.id>
  %95 = OpSGreaterThanEqual %93, %94 : reg<spirv.id>
  %96 = OpSelect %95, %94, %93 : reg<spirv.id>
  %97 = OpConstant.i32 127 : reg<spirv.id>
  %98 = OpConstant.i32 2139095040 : reg<spirv.id>
  %99 = OpSGreaterThan %76, %98 : reg<spirv.id>
  %100 = OpSelect %99, %97, %96 : reg<spirv.id>
  %101 = OpBitwiseOr %74, %100 : reg<spirv.id>
