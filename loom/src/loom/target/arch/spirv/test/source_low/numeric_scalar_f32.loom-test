// RUN: emit source-low target=spirv:vulkan1.3+bda output=low control-flow=structured-low

// XFAIL: SPIR-V fused multiply-add lowering is unsupported
func.def @scalar_f32_arith(%lhs: f32, %rhs: f32, %bias: f32) -> (f32) {
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %sum, %bias : f32
  %product = scalar.mulf %difference, %rhs : f32
  %result = scalar.fmaf %product, %rhs, %bias : f32
  func.return %result : f32
}

// ====

func.def @scalar_f32_sign_bits(%input: f32, %sign: f32) -> (f32, f32, f32) {
  %negated = scalar.negf %input : f32
  %absolute = scalar.absf %input : f32
  %copied = scalar.copysignf %input, %sign : f32
  func.return %negated, %absolute, %copied : f32, f32, f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_f32_sign_bits(%input: reg<spirv.id : f32>, %sign: reg<spirv.id : f32>) -> (reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>) asm {
  %29 = OpBitcast.f32.i32 %input
  %30 = OpConstant.i32 -2147483648
  %31 = OpBitwiseXor %29, %30
  %negated = OpBitcast.i32.f32 %31
  %33 = OpConstant.i32 2147483647
  %34 = OpBitwiseAnd %29, %33
  %absolute = OpBitcast.i32.f32 %34
  %36 = OpBitcast.f32.i32 %sign
  %37 = OpBitwiseAnd %36, %30
  %38 = OpBitwiseOr %34, %37
  %copied = OpBitcast.i32.f32 %38
  return %negated, %absolute, %copied
}

// ====

// XFAIL: SPIR-V shader-entry vector arguments and results are unsupported
func.def @vector_f32_sign_bits(%input: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %negated = vector.negf %input : vector<4xf32>
  %absolute = vector.absf %input : vector<4xf32>
  func.return %negated, %absolute : vector<4xf32>, vector<4xf32>
}
