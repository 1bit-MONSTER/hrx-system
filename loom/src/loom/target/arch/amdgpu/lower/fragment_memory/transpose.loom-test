low.kernel.def target<amdgpu.rdna4.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @row_major_rhs_transpose_load() asm {
  %40 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %43 = v_and_b32_src0_inline %40, 7
  %44 = v_lshlrev_b32_src0_inline %43, 5
  %45 = v_lshrrev_b32_src0_inline %40, 3
  %46 = v_and_b32_src0_inline %45, 1
  %47 = v_lshl_add_u32_shift_imm %46, %44, 4
  %48 = v_lshrrev_b32_src0_inline %40, 4
  %49 = v_and_b32_src0_inline %48, 1
  %50 = v_lshl_add_u32_shift_imm %49, %47, 8
  %fragment = global_load_tr_b128_saddr %50, %input_view
  %52 = v_mov_b32 0
  global_store_b128_saddr %52, %fragment, %output_view
  return
}

