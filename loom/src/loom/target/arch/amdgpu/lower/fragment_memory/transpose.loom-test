} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %k = index.constant 16 : index
  %n = index.constant 16 : index
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xf8E5M2>
  %output_view = buffer.view %output[%base] : buffer -> view<8xf8E5M2>
  %fragment = vector.fragment.load<rhs> %input_view[0, 0] shape [%k, %n] : view<16x16xf8E5M2> -> vector<8xf8E5M2>
  vector.store %fragment, %output_view[0] : vector<8xf8E5M2>, view<8xf8E5M2>
  kernel.return
}

