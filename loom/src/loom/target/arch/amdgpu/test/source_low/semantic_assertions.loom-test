// TEMPLATE: loom/src/loom/test/corpus/source_low/semantic_assertions.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx11-generic output=low

kernel.def @semantic_value_assertion() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: i32) {
  %checked = sanitizer.assert.value %value [ne(%value, 0)] : i32
  kernel.return
}

// ----
CHECK: low.kernel.def * @semantic_value_assertion*
CHECK: * = s_cmp_lg_i32*
CHECK: low.cond_br *
CHECK-NOT: *sanitizer.assert*
CHECK-NOT: *kernel.assert*

// ====

kernel.def @semantic_operation_assertion() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%denominator: i32) {
  sanitizer.assert.op %denominator [ne(%denominator, 0)] : i32
  kernel.return
}

// ----
CHECK: low.kernel.def * @semantic_operation_assertion*
CHECK: * = s_cmp_lg_i32*
CHECK: low.cond_br *
CHECK-NOT: *sanitizer.assert*
CHECK-NOT: *kernel.assert*

// ====

kernel.def @semantic_layout_assertion() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%extent: index, %view: view<[%extent]xi32>) {
  %checked = sanitizer.assert.layout %view : view<[%extent]xi32> -> view<4xi32>
  kernel.return
}

// ----
CHECK: low.kernel.def * @semantic_layout_assertion*
CHECK: * = s_cmp_lg_u64*
CHECK: low.cond_br *
CHECK-NOT: *sanitizer.assert*
CHECK-NOT: *kernel.assert*
