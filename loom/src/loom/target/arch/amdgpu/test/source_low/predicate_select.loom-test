// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @predicate_select_single(%mask: vector<1xi1>, %true_value: vector<1xi1>, %false_value: vector<1xi1>) -> (vector<1xi1>) {
  %selected = vector.select %mask, %true_value, %false_value : vector<1xi1>
  func.return %selected : vector<1xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_select_single(%mask: reg<amdgpu.sgpr x2>, %true_value: reg<amdgpu.sgpr x2>, %false_value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %9 = s_and_b64 %mask, %true_value
  %10 = s_mov_b64_exec_read
  %11 = s_xor_b64 %mask, %10
  %12 = s_and_b64 %11, %false_value
  %selected = s_or_b64 %9, %12
  return %selected
}

