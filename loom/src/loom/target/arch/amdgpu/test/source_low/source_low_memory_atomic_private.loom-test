// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_private.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @private_counter(%initial: i64, %increment: i64, %expected: i64) -> (i64, i64, i64) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old = view.atomic.rmw<addi> %increment, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %compared = view.atomic.cmpxchg %expected, %increment, %cell[0] {failure_ordering = acquire, scope = system, success_ordering = seq_cst} : i64, view<1xi64> -> i64
  %final = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  func.return %old, %compared, %final : i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @private_counter(%initial: reg<amdgpu.sgpr x2>, %increment: reg<amdgpu.sgpr x2>, %expected: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %25 = slice %initial[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = slice %initial[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = slice %increment[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = slice %increment[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29, %30 = s_add_co_u32 %25, %27
  %31, %32 = s_addc_u32 %26, %28, %30
  %33 = concat(%29, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %34 = s_cmp_eq_u64 %33, %expected
  %37 = s_cselect_b32 %27, %29, %34
  %40 = s_cselect_b32 %28, %31, %34
  %41 = concat(%37, %40) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %initial, %33, %41
}

// ====

func.def @private_float(%initial: f64, %increment: f64) -> (f64, f64) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xf64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : f64, view<1xf64>
  %old = view.atomic.rmw<addf, noftz> %increment, %cell[0] {ordering = acq_rel, scope = system} : f64, view<1xf64> -> f64
  %final = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xf64> -> f64
  func.return %old, %final : f64, f64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @private_float(%initial: reg<amdgpu.vgpr x2>, %increment: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %17 = v_add_f64 %initial, %increment
  return %initial, %17
}

// ====

func.def @private_half_vector(%initial: vector<2xf16>, %increment: vector<2xf16>, %mask: vector<2xi1>) -> (vector<2xf16>, vector<2xf16>, vector<2xf16>) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %cells = buffer.view %storage[%origin] : buffer -> view<2xf16>
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %offsets = vector.iota %first step %step : vector<2xindex>
  vector.store %initial, %cells[0] : vector<2xf16>, view<2xf16>
  %old = vector.atomic.rmw<addf, noftz> %increment, %cells[0][%offsets] {ordering = acq_rel, scope = system} : vector<2xf16>, view<2xf16>, vector<2xindex>
  %masked = vector.atomic.rmw.mask<addf, noftz> %increment, %cells[0][%offsets], %mask, %initial {ordering = relaxed, scope = thread} : vector<2xf16>, view<2xf16>, vector<2xindex>, vector<2xi1>, vector<2xf16>
  %final = vector.load %cells[0] : view<2xf16> -> vector<2xf16>
  func.return %old, %masked, %final : vector<2xf16>, vector<2xf16>, vector<2xf16>
}

