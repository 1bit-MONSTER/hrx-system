low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_signed_remainder(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %37 = v_mov_b32 1717986919
  %38 = v_mul_hi_i32 %value, %37
  %39 = v_ashrrev_i32_src0_inline %38, 1
  %40 = v_lshrrev_b32_src0_inline %39, 31
  %quotient_positive_five = v_add_u32 %39, %40
  %42 = v_mov_b32 2147483649
  %43 = v_mul_hi_i32 %value, %42
  %44 = v_add_u32 %43, %value
  %45 = v_lshrrev_b32_src0_inline %44, 31
  %46 = v_add_u32 %44, %45
  %47 = v_mov_b32 2
  %48 = v_mul_lo_u32 %46, %47
  %remainder_positive_two = v_sub_u32 %value, %48
  %50 = v_mov_b32 1431655766
  %51 = v_mul_hi_i32 %value, %50
  %52 = v_lshrrev_b32_src0_inline %51, 31
  %53 = v_add_u32 %51, %52
  %54 = v_mov_b32 3
  %55 = v_mul_lo_u32 %53, %54
  %remainder_positive_three = v_sub_u32 %value, %55
  %60 = v_ashrrev_i32_src0_inline %44, 1
  %61 = v_lshrrev_b32_src0_inline %60, 31
  %62 = v_add_u32 %60, %61
  %63 = v_mov_b32 4
  %64 = v_mul_lo_u32 %62, %63
  %remainder_positive_four = v_sub_u32 %value, %64
  %71 = v_mov_b32 5
  %72 = v_mul_lo_u32 %quotient_positive_five, %71
  %remainder_positive_five = v_sub_u32 %value, %72
  %74 = v_mov_b32 2147483647
  %75 = v_mul_hi_i32 %value, %74
  %76 = v_sub_u32 %75, %value
  %77 = v_lshrrev_b32_src0_inline %76, 31
  %78 = v_add_u32 %76, %77
  %79 = v_mov_b32 4294967294
  %80 = v_mul_lo_u32 %78, %79
  %remainder_negative_two = v_sub_u32 %value, %80
  %82 = v_mov_b32 1431655765
  %83 = v_mul_hi_i32 %value, %82
  %84 = v_sub_u32 %83, %value
  %85 = v_ashrrev_i32_src0_inline %84, 1
  %86 = v_lshrrev_b32_src0_inline %85, 31
  %87 = v_add_u32 %85, %86
  %88 = v_mov_b32 4294967293
  %89 = v_mul_lo_u32 %87, %88
  %remainder_negative_three = v_sub_u32 %value, %89
  return %quotient_positive_five, %remainder_positive_two, %remainder_positive_three, %remainder_positive_four, %remainder_positive_five, %remainder_negative_two, %remainder_negative_three
}

// ====

amdgpu.target<gfx11-generic> @target

// Narrow signed operations widen through the shared i32 legalization before
// selecting the same reciprocal machinery.
func.def target(@target) @narrow_signed_division(%byte: i8, %halfword: i16) -> (i8, i8, i16, i16) {
  %byte_divisor = scalar.constant -3 : i8
  %halfword_divisor = scalar.constant 5 : i16
  %byte_quotient = scalar.divsi %byte, %byte_divisor : i8
  %byte_remainder = scalar.remsi %byte, %byte_divisor : i8
  %halfword_quotient = scalar.divsi %halfword, %halfword_divisor : i16
  %halfword_remainder = scalar.remsi %halfword, %halfword_divisor : i16
  func.return %byte_quotient, %byte_remainder, %halfword_quotient, %halfword_remainder : i8, i8, i16, i16
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_signed_division(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %38 = v_bfe_i32_offset_width_inline %byte {offset = 0, width = 8}
  %40 = v_mov_b32 1431655765
  %41 = v_mul_hi_i32 %38, %40
  %42 = v_sub_nc_u32 %41, %38
  %43 = v_ashrrev_i32_src0_inline %42, 1
  %44 = v_lshrrev_b32_src0_inline %43, 31
  %byte_quotient = v_add_u32 %43, %44
  %52 = v_mov_b32 4294967293
  %53 = v_mul_lo_u32 %byte_quotient, %52
  %byte_remainder = v_sub_nc_u32 %38, %53
  %55 = v_bfe_i32_offset_width_inline %halfword {offset = 0, width = 16}
  %57 = v_mov_b32 1717986919
  %58 = v_mul_hi_i32 %55, %57
  %59 = v_ashrrev_i32_src0_inline %58, 1
  %60 = v_lshrrev_b32_src0_inline %59, 31
  %halfword_quotient = v_add_u32 %59, %60
  %67 = v_mov_b32 5
  %68 = v_mul_lo_u32 %halfword_quotient, %67
  %halfword_remainder = v_sub_nc_u32 %55, %68
  return %byte_quotient, %byte_remainder, %halfword_quotient, %halfword_remainder
}
