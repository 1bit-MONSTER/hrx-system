// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

// The bias load intentionally stays outside the lane0 branch. Cross-wave
// workgroup reduction narrows EXEC internally, and later all-lane memory
// operations must not reuse VGPR materializations produced under that narrowed
// participant set.
kernel.def target(@target) @workgroup_reduce_then_all_lane_bias_load() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %bias: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %second_output = index.constant 1 : index
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %input_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input_global, %bias_global, %output_global : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<128xf32>
  %bias_view = buffer.view %bias_noalias[%base] : buffer -> view<1xbf16>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<2xf32>
  %value = view.load %input_view[%tid] : view<128xf32> -> f32
  %sum0 = kernel.workgroup.reduce<addf> %value : f32
  %sum1 = kernel.workgroup.reduce<addf> %value : f32
  %bias_bf16 = view.load %bias_view[%leader_index] : view<1xbf16> -> bf16
  %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
  %result0 = scalar.addf<reassoc|nnan|ninf|nsz> %sum0, %bias_f32 : f32
  %result1 = scalar.addf<reassoc|nnan|ninf|nsz> %sum1, %bias_f32 : f32
  %is_lane0 = index.cmp eq, %tid, %leader_index : index
  scf.if %is_lane0 {
    view.store %result0, %output_view[%leader_index] : f32, view<2xf32>
    view.store %result1, %output_view[%second_output] : f32, view<2xf32>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(128, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_then_all_lane_bias_load() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %bias_view = resource<hal_binding> {extent = 2, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 8, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %30 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_dword_saddr %30, %input_view
  %32 = v_and_b32_src0_inline %tid, 63
  %33 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %34 = storage_address %33 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %35 = v_xor_b32_src0_inline %32, 32
  %36 = v_lshlrev_b32_src0_inline %35, 2
  %37 = ds_bpermute_b32 %36, %value
  %38 = v_add_f32 %value, %37
  %39 = v_xor_b32_src0_inline %32, 16
  %40 = v_lshlrev_b32_src0_inline %39, 2
  %41 = ds_bpermute_b32 %40, %38
  %42 = v_add_f32 %38, %41
  %43 = v_xor_b32_src0_inline %32, 8
  %44 = v_lshlrev_b32_src0_inline %43, 2
  %45 = ds_bpermute_b32 %44, %42
  %46 = v_add_f32 %42, %45
  %47 = v_xor_b32_src0_inline %32, 4
  %48 = v_lshlrev_b32_src0_inline %47, 2
  %49 = ds_bpermute_b32 %48, %46
  %50 = v_add_f32 %46, %49
  %51 = v_xor_b32_src0_inline %32, 2
  %52 = v_lshlrev_b32_src0_inline %51, 2
  %53 = ds_bpermute_b32 %52, %50
  %54 = v_add_f32 %50, %53
  %55 = v_xor_b32_src0_inline %32, 1
  %56 = v_lshlrev_b32_src0_inline %55, 2
  %57 = ds_bpermute_b32 %56, %54
  %58 = v_add_f32 %54, %57
  %59 = v_lshrrev_b32_src0_inline %tid, 6
  %60 = v_lshlrev_b32_src0_inline %59, 2
  %61 = v_mov_b32 1
  %62 = v_cmp_lt_u32 %32, %61
  %63, %64 = s_and_saveexec_b64 %62
  %65 = v_add_u32 %34, %60
  ds_write_b32 %65, %58
  s_mov_b64_exec %63
  s_barrier
  %66 = v_mov_b32 2
  %67 = v_cmp_lt_u32 %32, %66
  %68, %69 = s_and_saveexec_b64 %67
  %70 = v_lshlrev_b32_src0_inline %32, 2
  %71 = v_add_u32 %34, %70
  %72 = ds_read_b32 %71
  %73 = v_add_f32_dpp %72, %72 {dpp_ctrl = 177}
  s_mov_b64_exec %68
  %74 = v_mov_b32 0
  %sum0 = ds_bpermute_b32 %74, %73
  %76 = v_and_b32_src0_inline %tid, 63
  %77 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %78 = storage_address %77 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %79 = v_xor_b32_src0_inline %76, 32
  %80 = v_lshlrev_b32_src0_inline %79, 2
  %81 = ds_bpermute_b32 %80, %value
  %82 = v_add_f32 %value, %81
  %83 = v_xor_b32_src0_inline %76, 16
  %84 = v_lshlrev_b32_src0_inline %83, 2
  %85 = ds_bpermute_b32 %84, %82
  %86 = v_add_f32 %82, %85
  %87 = v_xor_b32_src0_inline %76, 8
  %88 = v_lshlrev_b32_src0_inline %87, 2
  %89 = ds_bpermute_b32 %88, %86
  %90 = v_add_f32 %86, %89
  %91 = v_xor_b32_src0_inline %76, 4
  %92 = v_lshlrev_b32_src0_inline %91, 2
  %93 = ds_bpermute_b32 %92, %90
  %94 = v_add_f32 %90, %93
  %95 = v_xor_b32_src0_inline %76, 2
  %96 = v_lshlrev_b32_src0_inline %95, 2
  %97 = ds_bpermute_b32 %96, %94
  %98 = v_add_f32 %94, %97
  %99 = v_xor_b32_src0_inline %76, 1
  %100 = v_lshlrev_b32_src0_inline %99, 2
  %101 = ds_bpermute_b32 %100, %98
  %102 = v_add_f32 %98, %101
  %103 = v_lshrrev_b32_src0_inline %tid, 6
  %104 = v_lshlrev_b32_src0_inline %103, 2
  %105 = v_mov_b32 1
  %106 = v_cmp_lt_u32 %76, %105
  %107, %108 = s_and_saveexec_b64 %106
  %109 = v_add_u32 %78, %104
  ds_write_b32 %109, %102
  s_mov_b64_exec %107
  s_barrier
  %110 = v_mov_b32 2
  %111 = v_cmp_lt_u32 %76, %110
  %112, %113 = s_and_saveexec_b64 %111
  %114 = v_lshlrev_b32_src0_inline %76, 2
  %115 = v_add_u32 %78, %114
  %116 = ds_read_b32 %115
  %117 = v_add_f32_dpp %116, %116 {dpp_ctrl = 177}
  s_mov_b64_exec %112
  %118 = v_mov_b32 0
  %sum1 = ds_bpermute_b32 %118, %117
  %120 = v_mov_b32 0
  %bias_bf16 = global_load_d16_b16_saddr %120, %bias_view
  %bias_f32 = v_lshlrev_b32_src0_16_low16 %bias_bf16
  %result0 = v_add_f32 %sum0, %bias_f32
  %result1 = v_add_f32 %sum1, %bias_f32
  %is_lane0 = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  %126, %127 = s_and_saveexec_b64 %is_lane0
  low.cond_br %127, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %128 = v_mov_b32 0
  global_store_dword_saddr %128, %result0, %output_view
  global_store_dword_saddr %128, %result1, %output_view {offset = 4}
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %126
  return
}

// ====

amdgpu.target<gfx942> @target

kernel.def target(@target) @subgroup_shuffle_xor_f32_pair_cdna3() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %offset = scalar.constant 1 : i32
  %width = scalar.constant 2 : i32
  %shuffle, %valid = kernel.subgroup.shuffle<xor> %value, %offset, %width : f32, i32, i32
  view.store %shuffle, %output_view[%tid] : f32, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_shuffle_xor_f32_pair_cdna3() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_dword_saddr %16, %input_view
  %shuffle = v_mov_b32_dpp %value {dpp_ctrl = 177}
  %19 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_dword_saddr %19, %shuffle, %output_view
  return
}

