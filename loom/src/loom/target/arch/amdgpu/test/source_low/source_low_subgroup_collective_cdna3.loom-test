low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_reduce_addf_f32_cluster8_cdna3() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_dword_saddr %13, %input_view
  %15 = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %16 = v_add_f32_dpp %15, %15 {dpp_ctrl = 78}
  %sum = v_add_f32_dpp %16, %16 {dpp_ctrl = 321}
  %18 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_dword_saddr %18, %sum, %output_view
  return
}

