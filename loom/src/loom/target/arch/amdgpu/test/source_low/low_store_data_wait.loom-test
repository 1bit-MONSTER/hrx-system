// ----
.Lbb1:
  s_nop 0
  v_mov_b32 v0, 42
  v_mov_b32 v1, v0
  v_mov_b32 v2, v0
  v_mov_b32 v3, v0
  global_store_dwordx4 v8, v[0:3], s[0:1] offset:0
  s_cbranch_scc1 .Lbb1
.Lbb2:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

