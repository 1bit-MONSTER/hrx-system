// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @bitpack_width_rejected(%codes: vector<2xi32>) -> (vector<4xi8>) {
  // ERROR@+1: TARGET/003 {subject_role="field-width", subject_name="i32", constraint_key="amdgpu.packed_integer.width_i32"}
  %packed = vector.bitpack<16> %codes : vector<2xi32> -> vector<4xi8>
  func.return %packed : vector<4xi8>
}

