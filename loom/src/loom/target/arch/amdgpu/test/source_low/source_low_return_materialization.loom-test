// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Return representation depends on all paths, regardless of block layout.
func.def @return_loaded_or_argument(%input: buffer, %load: i1, %fallback: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
^argument:
  func.return %fallback : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_loaded_or_argument(%load: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = s_mov_b32 0
  %12 = s_cmp_lg_i32 %load, %11
  low.cond_br %12, ^loaded, ^argument : reg<amdgpu.scc>
^loaded:
  %13 = v_mov_b32 0
  %value = global_load_b32_saddr %13, %view
  return %value
^argument:
  %15 = v_mov_b32_copy %fallback
  return %15
}

// ====

func.def @return_argument_or_loaded(%input: buffer, %load: i1, %fallback: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^argument:
  func.return %fallback : i32
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_argument_or_loaded(%load: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = s_mov_b32 0
  %12 = s_cmp_lg_i32 %load, %11
  low.cond_br %12, ^loaded, ^argument : reg<amdgpu.scc>
^argument:
  %13 = v_mov_b32_copy %fallback
  return %13
^loaded:
  %14 = v_mov_b32 0
  %value = global_load_b32_saddr %14, %view
  return %value
}

// ====

func.def @return_wide_loaded_or_argument(%input: buffer, %load: i1, %fallback: i64) -> (i64) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi64>
  cfg.cond_br %load, ^loaded, ^argument
^loaded:
  %value = view.load %view[0] : view<1xi64> -> i64
  func.return %value : i64
^argument:
  func.return %fallback : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_wide_loaded_or_argument(%load: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = s_mov_b32 0
  %12 = s_cmp_lg_i32 %load, %11
  low.cond_br %12, ^loaded, ^argument : reg<amdgpu.scc>
^loaded:
  %13 = v_mov_b32 0
  %value = global_load_b64_saddr %13, %view
  return %value
^argument:
  %15 = slice %fallback[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %17 = slice %fallback[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = concat(%16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %19
}

// ====

// Each result position has its own carrier, including unchanged uniform data.
func.def @return_mixed_values(%input: buffer, %load: i1, %integer: i32, %real: f32, %tag: i32) -> (i32, f32, i32) {
  %origin = index.constant 0 : offset
  %integers = buffer.view %input[%origin] : buffer -> view<2xi32>
  %reals = buffer.view %input[%origin] : buffer -> view<2xf32>
  cfg.cond_br %load, ^loaded, ^argument
^argument:
  func.return %integer, %real, %tag : i32, f32, i32
^loaded:
  %loaded_integer = view.load %integers[0] : view<2xi32> -> i32
  %loaded_real = view.load %reals[1] : view<2xf32> -> f32
  func.return %loaded_integer, %loaded_real, %tag : i32, f32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_mixed_values(%load: reg<amdgpu.sgpr>, %integer: reg<amdgpu.sgpr>, %real: reg<amdgpu.vgpr>, %tag: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %reals = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = s_mov_b32 0
  %22 = s_cmp_lg_i32 %load, %21
  low.cond_br %22, ^loaded, ^argument : reg<amdgpu.scc>
^argument:
  %23 = v_mov_b32_copy %integer
  return %23, %real, %tag
^loaded:
  %24 = v_mov_b32 0
  %loaded_integer = global_load_b32_saddr %24, %reals
  %loaded_real = global_load_b32_saddr %24, %reals {offset = 4}
  return %loaded_integer, %loaded_real, %tag
}

// ====

// Width and register-bank joins are independent: the loaded offset may need
// vector storage even though its range is narrower than the fallback address.
func.def @return_offset(%input: buffer, %load: i1, %fallback: offset) -> (offset) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^argument:
  func.return %fallback : offset
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  %byte_offset = index.cast %value : i32 to offset
  func.return %byte_offset : offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_offset(%load: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_mov_b32 0
  %13 = s_cmp_lg_i32 %load, %12
  low.cond_br %13, ^loaded, ^argument : reg<amdgpu.scc>
^argument:
  %14 = slice %fallback[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %14
  %16 = slice %fallback[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = v_mov_b32_copy %16
  %18 = concat(%15, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %18
^loaded:
  %19 = v_mov_b32 0
  %byte_offset = global_load_b32_saddr %19, %view
  %22 = concat(%byte_offset, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %22
}

// ====

func.def @return_predicate(%input: buffer, %load: i1, %fallback: i1) -> (i1) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^argument:
  func.return %fallback : i1
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %positive = scalar.cmpi slt, %threshold, %value : i32
  func.return %positive : i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_predicate(%load: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = s_mov_b32 0
  %15 = s_cmp_lg_i32 %load, %14
  low.cond_br %15, ^loaded, ^argument : reg<amdgpu.scc>
^argument:
  %16 = s_cmp_lg_i32_src1_inline %fallback {rhs = 0}
  %17 = s_mov_b64_exec_read
  %18 = slice %17[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %17[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = s_cselect_b32 %18, %14, %16
  %22 = s_cselect_b32 %19, %14, %16
  %23 = concat(%21, %22) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %23
^loaded:
  %24 = v_mov_b32 0
  %value = global_load_b32_saddr %24, %view
  %positive = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  return %positive
}

// ====

func.def @return_selected_buffer(%input: buffer, %fallback: buffer, %select: i1) -> (buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %select, ^selected, ^argument
^argument:
  func.return %fallback : buffer
^selected:
  %value = view.load %view[0] : view<1xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %positive = scalar.cmpi slt, %threshold, %value : i32
  %selected = scf.select %positive, %input, %fallback : buffer
  func.return %selected : buffer
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_selected_buffer(%select: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %fallback = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = s_mov_b32 0
  %16 = s_cmp_lg_i32 %select, %15
  low.cond_br %16, ^selected, ^argument : reg<amdgpu.scc>
^argument:
  %17 = slice %fallback[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = slice %fallback[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %19
  %21 = concat(%18, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %21
^selected:
  %22 = v_mov_b32 0
  %value = global_load_b32_saddr %22, %view
  %positive = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %25 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = slice %fallback[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %29 = v_cndmask_b32 %28, %26, %positive
  %30 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = v_mov_b32_copy %30
  %32 = slice %fallback[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = v_mov_b32_copy %32
  %34 = v_cndmask_b32 %33, %31, %positive
  %selected = concat(%29, %34) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}

// ====

// Semantic refinement keeps the consumed physical carrier until the callable
// boundary selects a proven-narrow result.
func.def @return_refined_ordinals(%coordinate0: index, %byte_offset0: offset) -> (index, offset) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 1024), range(%byte_offset0, 0, 4096)] : index, offset
  func.return %coordinate, %byte_offset : index, offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_refined_ordinals(%coordinate: reg<amdgpu.sgpr>, %byte_offset: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %10 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  return %coordinate, %10
}

// ====

// Multiple exits join callable result carriers without rewriting producer
// bindings. The refined alias remains wide internally and is narrowed on its
// return path; the constant already matches the result carrier.
func.def @return_refined_or_constant(%byte_offset0: offset, %use_refined: i1) -> (offset) {
  %byte_offset = index.assume %byte_offset0 [range(%byte_offset0, 0, 4096)] : offset
  cfg.cond_br %use_refined, ^refined, ^constant
^refined:
  func.return %byte_offset : offset
^constant:
  %constant = index.constant 7 : offset
  func.return %constant : offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @return_refined_or_constant(%byte_offset: reg<amdgpu.sgpr x2>, %use_refined: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %8 = s_mov_b32 0
  %9 = s_cmp_lg_i32 %use_refined, %8
  low.cond_br %9, ^refined, ^constant : reg<amdgpu.scc>
^refined:
  %10 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  return %10
^constant:
  %constant = s_mov_b32 7
  return %constant
}

// ====

// A non-returning body still has its declared callable result signature.
func.def @never_returns() -> (i32) {
  cfg.br ^loop
^loop:
  cfg.br ^loop
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @never_returns() -> (reg<amdgpu.sgpr>) asm {
  low.br ^loop
^loop:
  low.br ^loop
}
