CHECK: ds_add_u64 *
CHECK: * = ds_add_rtn_u64 *
CHECK: ds_sub_u64 *
CHECK: * = ds_sub_rtn_u64 *
CHECK: ds_min_i64 *
CHECK: * = ds_min_rtn_i64 *
CHECK: ds_max_i64 *
CHECK: * = ds_max_rtn_i64 *
CHECK: ds_min_u64 *
CHECK: * = ds_min_rtn_u64 *
CHECK: ds_max_u64 *
CHECK: * = ds_max_rtn_u64 *
CHECK: ds_and_b64 *
CHECK: * = ds_and_rtn_b64 *
CHECK: ds_or_b64 *
CHECK: * = ds_or_rtn_b64 *
CHECK: ds_xor_b64 *
CHECK: * = ds_xor_rtn_b64 *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
