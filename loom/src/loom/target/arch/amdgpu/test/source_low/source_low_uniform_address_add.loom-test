// RUN: pass source-to-low,low-select-operand-forms,low-cse,low-dce

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_lhs(%values: vector<2xi32>, %step: index) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi32> -> i32
  %position = index.cast %value : i32 to index
  %next = index.add %step, %position : index
  %result = index.cast %next : index to i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_lhs(%values: reg<amdgpu.vgpr x2>, %step: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %position = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_add_u32 %step, %position
  return %result
}

