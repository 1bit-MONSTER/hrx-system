// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @bounded_offset_lhs(%values: vector<2xi64>, %wide_step: offset) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %position = scalar.assume %value [range(%value, 0, 4294967168)] : i64
  %bounded_position = index.cast %position : i64 to offset
  %step = index.assume %wide_step [range(%wide_step, 0, 127)] : offset
  %next = index.add %step, %bounded_position : offset
  %bounded = index.assume %next [range(%next, 0, 4294967295)] : offset
  %result = index.cast %bounded : offset to i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @bounded_offset_lhs(%values: reg<amdgpu.vgpr x4>, %step: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %position = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %bounded_position = slice %position[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = slice %step[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %result = v_add_u32 %15, %bounded_position
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @bounded_offset_rhs(%values: vector<2xi64>, %wide_step: offset) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %position = scalar.assume %value [range(%value, 0, 4294967168)] : i64
  %bounded_position = index.cast %position : i64 to offset
  %step = index.assume %wide_step [range(%wide_step, 0, 127)] : offset
  %next = index.add %bounded_position, %step : offset
  %bounded = index.assume %next [range(%next, 0, 4294967295)] : offset
  %result = index.cast %bounded : offset to i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @bounded_offset_rhs(%values: reg<amdgpu.vgpr x4>, %step: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %position = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %bounded_position = slice %position[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = slice %step[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %result = v_add_u32 %15, %bounded_position
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_result(%position: index, %step: index) -> (index) {
  %result = index.add %position, %step : index
  func.return %result : index
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_result(%position: reg<amdgpu.sgpr>, %step: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %result = s_add_u32 %position, %step
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @varying_operands(%values: vector<2xi32>) -> (i32) {
  %lhs = vector.extract %values[0] : vector<2xi32> -> i32
  %rhs = vector.extract %values[1] : vector<2xi32> -> i32
  %position = index.cast %lhs : i32 to index
  %step = index.cast %rhs : i32 to index
  %next = index.add %position, %step : index
  %result = index.cast %next : index to i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @varying_operands(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %position = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %step = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_add_u32 %position, %step
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @ordered_subtraction(%values: vector<2xi32>, %step: index) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi32> -> i32
  %position = index.cast %value : i32 to index
  %next = index.sub %position, %step : index
  %result = index.cast %next : index to i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @ordered_subtraction(%values: reg<amdgpu.vgpr x2>, %step: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %position = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = v_mov_b32_copy %step
  %result = v_sub_nc_u32 %position, %11
  return %result
}
