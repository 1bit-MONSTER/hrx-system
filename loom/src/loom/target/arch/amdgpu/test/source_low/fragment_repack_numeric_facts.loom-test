// ====

amdgpu.target<gfx1100> @target

kernel.def target(@target) @rdna_wave32_not_nan() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%value: f32, %output: buffer) {
  %extent = index.constant 16 : index
  %not_nan = scalar.assume %value [not_nan(%value)] : f32
  %converted = vector.splat %not_nan : vector<8xf32>
  %result = vector.fragment<result> %converted shape [%extent, %extent] : vector<8xf32>
  %lhs = vector.fragment.repack<lhs> %result shape [%extent, %extent] : vector<8xf32> -> vector<16xbf16>
  %base = index.constant 0 : offset
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %output_view = buffer.view %output_global[%base] : buffer -> view<16x16xbf16>
  vector.fragment.store<lhs> %lhs, %output_view[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

