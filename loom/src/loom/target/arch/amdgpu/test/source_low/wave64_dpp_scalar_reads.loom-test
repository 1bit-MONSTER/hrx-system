// Uniform DPP data is read in both wave64 passes, unlike the carry predicate.
// RUN: emit amdgpu-assembly @dpp_uniform_data_gfx1151 strategy=source

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @dpp_uniform_data_gfx1151(%uniform: reg<amdgpu.sgpr>, %varying: reg<amdgpu.vgpr>, %carry_in: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %result, %carry = v_add_co_ci_u32_dpp16_sgpr %varying, %uniform, %carry_in {dpp_ctrl = 27}
  return %result, %carry
}

// ----
  v_add_co_ci_u32_e64_dpp v0, s[2:3], v0, s0, s[2:3], quad_perm:[3,2,1,0], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @dpp_uniform_compare_gfx1170 strategy=source

amdgpu.target<gfx1170> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna4m.core>(@target) @dpp_uniform_compare_gfx1170(%uniform: reg<amdgpu.sgpr>, %varying: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %mask = v_cmp_ne_i32_dpp16_sgpr %varying, %uniform {dpp_ctrl = 27}
  return %mask
}

// ----
  v_cmp_ne_i32_e64_dpp s[2:3], v0, s0, quad_perm:[3,2,1,0], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_endpgm
