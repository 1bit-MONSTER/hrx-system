// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_workgroup_atomic_observations.loom
// RUN: emit source-low target=amdgpu:gfx1200 output=low

// Mixed integer and floating observations preserve bits and neighboring cells.
kernel.def @lds_observations_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i32, %replacement: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %whole = buffer.view %scratch[%origin] : buffer -> view<4xi32>
  %integers = view.subview %whole[1] : view<4xi32> -> view<2xi32>
  %float_whole = buffer.view %scratch[%origin] : buffer -> view<4xf32>
  %floats = view.subview %float_whole[1] : view<4xf32> -> view<2xf32>
  %results = buffer.view %output[%origin] : buffer -> view<5xi32>
  %float_replacement = scalar.bitcast %replacement : i32 to f32
  view.store %initial, %whole[0] : i32, view<4xi32>
  view.store %initial, %whole[3] : i32, view<4xi32>
  view.atomic.store %initial, %integers[0] {ordering = relaxed, scope = workgroup} : i32, view<2xi32>
  %unused = view.atomic.load %integers[0] {ordering = relaxed, scope = workgroup} : view<2xi32> -> i32
  %relaxed = view.atomic.load %floats[0] {ordering = relaxed, scope = workgroup} : view<2xf32> -> f32
  view.atomic.store %float_replacement, %floats[1] {ordering = release, scope = workgroup} : f32, view<2xf32>
  %acquired = view.atomic.load %integers[1] {ordering = acquire, scope = workgroup} : view<2xi32> -> i32
  view.atomic.store %initial, %integers[0] {ordering = seq_cst, scope = workgroup} : i32, view<2xi32>
  %sequential = view.atomic.load %floats[0] {ordering = seq_cst, scope = workgroup} : view<2xf32> -> f32
  %relaxed_bits = scalar.bitcast %relaxed : f32 to i32
  %sequential_bits = scalar.bitcast %sequential : f32 to i32
  %before = view.load %whole[0] : view<4xi32> -> i32
  %after = view.load %whole[3] : view<4xi32> -> i32
  view.store %relaxed_bits, %results[0] : i32, view<5xi32>
  view.store %acquired, %results[1] : i32, view<5xi32>
  view.store %sequential_bits, %results[2] : i32, view<5xi32>
  view.store %before, %results[3] : i32, view<5xi32>
  view.store %after, %results[4] : i32, view<5xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "initial", arg1 = "replacement"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_observations_i32(%initial: reg<amdgpu.sgpr>, %float_replacement: reg<amdgpu.sgpr>) asm {
  %results = resource<hal_binding> {extent = 20, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = storage {byte_alignment = 4, byte_length = 16} : low.storage<workgroup>
  %26 = v_mov_b32_copy %initial
  %27 = v_mov_b32 0
  ds_write_b32 %27, %26
  ds_write_b32 %27, %26 {offset = 12}
  ds_write_b32<volatile> %27, %26 {offset = 4}
  %unused = ds_read_b32<volatile> %27 {offset = 4}
  %relaxed_bits = ds_read_b32<volatile> %27 {offset = 4}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %36 = v_mov_b32_copy %float_replacement
  ds_write_b32<volatile> %27, %36 {offset = 8}
  %acquired = ds_read_b32<volatile> %27 {offset = 8}
  s_wait_dscnt {dscnt = 0}
  global_inv {scope = 1}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  ds_write_b32<volatile> %27, %26 {offset = 4}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %sequential_bits = ds_read_b32<volatile> %27 {offset = 4}
  s_wait_dscnt {dscnt = 0}
  global_inv {scope = 1}
  %before = ds_read_b32 %27
  %after = ds_read_b32 %27 {offset = 12}
  global_store_b32_saddr %27, %relaxed_bits, %results
  global_store_b32_saddr %27, %acquired, %results {offset = 4}
  global_store_b32_saddr %27, %sequential_bits, %results {offset = 8}
  global_store_b32_saddr %27, %before, %results {offset = 12}
  global_store_b32_saddr %27, %after, %results {offset = 16}
  return
}

