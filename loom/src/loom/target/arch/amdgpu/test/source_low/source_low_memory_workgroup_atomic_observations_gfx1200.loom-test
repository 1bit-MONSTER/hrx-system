// Mixed integer and floating observations preserve bits and neighboring cells.
kernel.def @lds_observations_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial: i64, %replacement: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %whole = buffer.view %scratch[%origin] : buffer -> view<4xi64>
  %integers = view.subview %whole[1] : view<4xi64> -> view<2xi64>
  %float_whole = buffer.view %scratch[%origin] : buffer -> view<4xf64>
  %floats = view.subview %float_whole[1] : view<4xf64> -> view<2xf64>
  %results = buffer.view %output[%origin] : buffer -> view<5xi64>
  %float_replacement = scalar.bitcast %replacement : i64 to f64
  view.store %initial, %whole[0] : i64, view<4xi64>
  view.store %initial, %whole[3] : i64, view<4xi64>
  view.atomic.store %initial, %integers[0] {ordering = relaxed, scope = workgroup} : i64, view<2xi64>
  %unused = view.atomic.load %integers[0] {ordering = relaxed, scope = workgroup} : view<2xi64> -> i64
  %relaxed = view.atomic.load %floats[0] {ordering = relaxed, scope = workgroup} : view<2xf64> -> f64
  view.atomic.store %float_replacement, %floats[1] {ordering = release, scope = workgroup} : f64, view<2xf64>
  %acquired = view.atomic.load %integers[1] {ordering = acquire, scope = workgroup} : view<2xi64> -> i64
  view.atomic.store %initial, %integers[0] {ordering = seq_cst, scope = workgroup} : i64, view<2xi64>
  %sequential = view.atomic.load %floats[0] {ordering = seq_cst, scope = workgroup} : view<2xf64> -> f64
  %relaxed_bits = scalar.bitcast %relaxed : f64 to i64
  %sequential_bits = scalar.bitcast %sequential : f64 to i64
  %before = view.load %whole[0] : view<4xi64> -> i64
  %after = view.load %whole[3] : view<4xi64> -> i64
  view.store %relaxed_bits, %results[0] : i64, view<5xi64>
  view.store %acquired, %results[1] : i64, view<5xi64>
  view.store %sequential_bits, %results[2] : i64, view<5xi64>
  view.store %before, %results[3] : i64, view<5xi64>
  view.store %after, %results[4] : i64, view<5xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "initial", arg1 = "replacement"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_observations_i64(%initial: reg<amdgpu.sgpr x2>, %float_replacement: reg<amdgpu.sgpr x2>) asm {
  %results = resource<hal_binding> {extent = 40, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = storage {byte_alignment = 8, byte_length = 32} : low.storage<workgroup>
  %26 = slice %initial[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %28 = slice %initial[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = v_mov_b32_copy %28
  %30 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31 = v_mov_b32 0
  ds_write_b64 %31, %30
  %36 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  ds_write_b64 %31, %36 {offset = 24}
  %42 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  ds_write_b64<volatile> %31, %42 {offset = 8}
  %unused = ds_read_b64<volatile> %31 {offset = 8}
  %relaxed_bits = ds_read_b64<volatile> %31 {offset = 8}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %48 = slice %float_replacement[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %49 = v_mov_b32_copy %48
  %50 = slice %float_replacement[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = v_mov_b32_copy %50
  %52 = concat(%49, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  ds_write_b64<volatile> %31, %52 {offset = 16}
  %acquired = ds_read_b64<volatile> %31 {offset = 16}
  s_wait_dscnt {dscnt = 0}
  global_inv {scope = 1}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %60 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  ds_write_b64<volatile> %31, %60 {offset = 8}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %sequential_bits = ds_read_b64<volatile> %31 {offset = 8}
  s_wait_dscnt {dscnt = 0}
  global_inv {scope = 1}
  %before = ds_read_b64 %31
  %after = ds_read_b64 %31 {offset = 24}
  global_store_b64_saddr %31, %relaxed_bits, %results
  global_store_b64_saddr %31, %acquired, %results {offset = 8}
  global_store_b64_saddr %31, %sequential_bits, %results {offset = 16}
  global_store_b64_saddr %31, %before, %results {offset = 24}
  global_store_b64_saddr %31, %after, %results {offset = 32}
  return
}

// ====

// Coherent payload reads can replace invalidation, but not LDS completion.
kernel.def @lds_acquire_coherent_payload() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1024xi32>
  %results = buffer.view %output[%origin] : buffer -> view<1xi32>
  %observed = view.atomic.load %flag[0] {ordering = acquire, scope = workgroup} : view<1xi32> -> i32
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %results[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_acquire_coherent_payload() asm {
  %data = resource<hal_binding> {extent = 4096, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %15 = v_mov_b32 0
  %observed = ds_read_b32<volatile> %15
  s_wait_dscnt {dscnt = 0}
  %value = global_load_b32_saddr %15, %data {scope = 1}
  global_store_b32_saddr %15, %value, %results
  return
}
