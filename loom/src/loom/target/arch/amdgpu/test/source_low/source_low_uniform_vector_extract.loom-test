// RUN: emit source-low @uniform_packed_extract_banks target=amdgpu:gfx11-generic output=low

kernel.def @uniform_packed_extract_banks() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_i16: buffer, %input_f16: buffer, %input_bf16: buffer, %output_i16: buffer, %output_f16: buffer, %output_bf16: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %aligned_i16 = buffer.assume.alignment %input_i16 {minimum_alignment = 16} : buffer
  %aligned_f16 = buffer.assume.alignment %input_f16 {minimum_alignment = 16} : buffer
  %aligned_bf16 = buffer.assume.alignment %input_bf16 {minimum_alignment = 16} : buffer
  %source_i16, %source_f16, %source_bf16, %destination_i16, %destination_f16, %destination_bf16 = buffer.assume.noalias %aligned_i16, %aligned_f16, %aligned_bf16, %output_i16, %output_f16, %output_bf16 : buffer, buffer, buffer, buffer, buffer, buffer
  %input_i16_view = buffer.view %source_i16[%base] : buffer -> view<256x4xi16>
  %input_f16_view = buffer.view %source_f16[%base] : buffer -> view<256x2xf16>
  %input_bf16_view = buffer.view %source_bf16[%base] : buffer -> view<256x2xbf16>
  %output_i16_view = buffer.view %destination_i16[%base] : buffer -> view<256x4xi16>
  %output_f16_view = buffer.view %destination_f16[%base] : buffer -> view<256x2xf16>
  %output_bf16_view = buffer.view %destination_bf16[%base] : buffer -> view<256x2xbf16>
  scf.for %packet = [%begin to %end step %step] {
    %i16_values = vector.load %input_i16_view[%packet, 0] : view<256x4xi16> -> vector<4xi16>
    %f16_values = vector.load %input_f16_view[%packet, 0] : view<256x2xf16> -> vector<2xf16>
    %bf16_values = vector.load %input_bf16_view[%packet, 0] : view<256x2xbf16> -> vector<2xbf16>
    %i16_result = vector.shuffle<[0, 2, 1, 3]> %i16_values : vector<4xi16>
    %f16_result = vector.shuffle<[1, 0]> %f16_values : vector<2xf16>
    %bf16_result = vector.shuffle<[1, 0]> %bf16_values : vector<2xbf16>
    vector.store %i16_result, %output_i16_view[%packet, 0] : vector<4xi16>, view<256x4xi16>
    vector.store %f16_result, %output_f16_view[%packet, 0] : vector<2xf16>, view<256x2xf16>
    vector.store %bf16_result, %output_bf16_view[%packet, 0] : vector<2xbf16>, view<256x2xbf16>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 6, resource_count = 6, resource_offsets = [0, 8, 16, 24, 32, 40], resource_parameter_indices = [0, 1, 2, 3, 4, 5], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_packed_extract_banks() asm {
  %input_i16_view = resource<hal_binding> {extent = 2048, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %input_f16_view = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %input_bf16_view = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_i16_view = resource<hal_binding> {extent = 2048, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_f16_view = resource<hal_binding> {extent = 1024, index = 4, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_bf16_view = resource<hal_binding> {extent = 1024, index = 5, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %end = s_mov_b32 256
  %step = s_mov_b32 1
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>)
^_bb1(%packet: reg<amdgpu.sgpr>):
  %91 = s_cmp_lt_i32 %packet, %end
  low.cond_br %91, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %92 = s_lshl_b32_rhs_inline %packet, 3
  %i16_values = s_load_dwordx2 %input_i16_view, %92
  %94 = s_lshl_b32_rhs_inline %packet, 2
  %f16_values = s_load_dword %input_f16_view, %94
  %96 = s_lshl_b32_rhs_inline %packet, 2
  %bf16_values = s_load_dword %input_bf16_view, %96
  %98 = slice %i16_values[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %99 = v_bfe_i32_offset_width_inline %98 {offset = 0, width = 16}
  %100 = slice %i16_values[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %101 = v_bfe_i32_offset_width_inline %100 {offset = 0, width = 16}
  %103 = v_mov_b32_copy %98
  %104 = v_ashrrev_i32_src0_inline %103, 16
  %106 = v_mov_b32_copy %100
  %107 = v_ashrrev_i32_src0_inline %106, 16
  %108 = v_and_b32_lit %99, 65535
  %109 = v_and_b32_lit %101, 65535
  %110 = v_lshlrev_b32_src0_inline %109, 16
  %111 = v_or_b32 %108, %110
  %112 = v_and_b32_lit %104, 65535
  %113 = v_and_b32_lit %107, 65535
  %114 = v_lshlrev_b32_src0_inline %113, 16
  %115 = v_or_b32 %112, %114
  %i16_result = concat(%111, %115) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %117 = s_lshr_b32_rhs_inline %f16_values, 16
  %118 = v_mov_b32_copy %117
  %119 = v_and_b32_lit %118, 65535
  %120 = v_mov_b32_copy %f16_values
  %121 = v_and_b32_lit %120, 65535
  %122 = v_lshlrev_b32_src0_inline %121, 16
  %f16_result = v_or_b32 %119, %122
  %124 = v_mov_b32_copy %bf16_values
  %125 = v_lshrrev_b32_src0_inline %124, 16
  %127 = v_and_b32_lit %125, 65535
  %128 = v_and_b32_lit %124, 65535
  %129 = v_lshlrev_b32_src0_inline %128, 16
  %bf16_result = v_or_b32 %127, %129
  %131 = v_mov_b32 0
  %132 = s_lshl_b32_rhs_inline %packet, 3
  %133 = slice %output_i16_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %134 = slice %output_i16_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %136, %137 = s_add_co_u32 %133, %132
  %138, %139 = s_addc_u32 %134, %begin, %137
  %140 = concat(%136, %138) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b64_saddr %131, %i16_result, %140
  %142 = s_lshl_b32_rhs_inline %packet, 2
  %143 = slice %output_f16_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %144 = slice %output_f16_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %146, %147 = s_add_co_u32 %143, %142
  %148, %149 = s_addc_u32 %144, %begin, %147
  %150 = concat(%146, %148) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %131, %f16_result, %150
  %152 = s_lshl_b32_rhs_inline %packet, 2
  %153 = slice %output_bf16_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %154 = slice %output_bf16_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %156, %157 = s_add_co_u32 %153, %152
  %158, %159 = s_addc_u32 %154, %begin, %157
  %160 = concat(%156, %158) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %131, %bf16_result, %160
  %161 = s_add_u32 %packet, %step
  low.br ^_bb1(%161: reg<amdgpu.sgpr>)
^_bb3:
  return
}
