  flat_atomic_add_f64 %61, %value {scope = 3}
  s_wait_dscnt {dscnt = 0}
  global_wb {scope = 2}
  s_wait_storecnt {storecnt = 0}
  %minnum = global_atomic_min_num_f64_rtn_saddr %54, %value, %global_view {offset = 8, scope = 2}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 2}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_loadcnt {loadcnt = 0}
