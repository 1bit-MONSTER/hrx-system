  %59 = v_mov_b32_copy %57
  %60 = v_mov_b32_copy %58
  %61 = concat(%59, %60) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  s_wait_dscnt {dscnt = 0}
