// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_integer_widening.loom
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @widen_signed_word(%value: i32) -> (i64) {
  %result = scalar.extsi %value : i32 to i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @widen_signed_word(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %5 = s_ashr_i32_rhs_inline %value, 31
  %result = concat(%value, %5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

// ====

func.def @widen_unsigned_word(%value: i32) -> (i64) {
  %result = scalar.extui %value : i32 to i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @widen_unsigned_word(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %5 = s_mov_b32 0
  %result = concat(%value, %5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

// ====

func.def @add_signed_word(%base: i64, %delta: i32) -> (i64) {
  %wide_delta = scalar.extsi %delta : i32 to i64
  %result = scalar.addi %base, %wide_delta : i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @add_signed_word(%base: reg<amdgpu.sgpr x2>, %delta: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %8 = s_ashr_i32_rhs_inline %delta, 31
  %10 = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14, %15 = s_add_co_u32 %10, %delta
  %16, %17 = s_addc_u32 %11, %8, %15
  %result = concat(%14, %16) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

// ====

func.def @assemble_wide_word(%low: i32, %high: i32) -> (i64) {
  %low_word = scalar.extui %low : i32 to i64
  %high_word = scalar.extui %high : i32 to i64
  %word_bits = scalar.constant 32 : i64
  %high_half = scalar.shli %high_word, %word_bits : i64
  %result = scalar.ori %low_word, %high_half : i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @assemble_wide_word(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %11 = s_mov_b32 0
  %low_word = concat(%low, %11) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %high_word = concat(%high, %11) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %15 = s_mov_b32 32
  %high_half = s_lshl_b64 %high_word, %15
  %result = s_or_b64 %low_word, %high_half
  return %result
}

// ====

func.def @exchange_signed_position(%buffer: buffer, %position: i32, %replacement: i32) -> (i32) {
  %bounded_position = scalar.assume %position [range(%position, -4, 4)] : i32
  %wide_position = scalar.extsi %bounded_position : i32 to i64
  %element_bytes = scalar.constant 4 : i64
  %displacement = scalar.muli %wide_position, %element_bytes : i64
  %center = scalar.constant 16 : i64
  %wide_origin = scalar.addi %center, %displacement : i64
  %origin = index.cast %wide_origin : i64 to offset
  %view = buffer.view %buffer[%origin] : buffer -> view<1xi32>
  %previous = view.load %view[0] : view<1xi32> -> i32
  view.store %replacement, %view[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @exchange_signed_position(%bounded_position: reg<amdgpu.sgpr>, %replacement: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %40 = v_mov_b32 0
  %41 = s_ashr_i32_rhs_inline %bounded_position, 31
  %42 = concat(%bounded_position, %41) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %43 = s_mov_b32 2
  %44 = s_lshl_b64 %42, %43
  %45 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = slice %44[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48 = slice %44[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %49, %50 = s_add_co_u32 %45, %47
  %51, %52 = s_addc_u32 %46, %48, %50
  %53 = concat(%49, %51) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %previous = global_load_b32_saddr %40, %53 {offset = 16}
  %55 = v_mov_b32_copy %replacement
  %57 = s_ashr_i32_rhs_inline %bounded_position, 31
  %58 = concat(%bounded_position, %57) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %60 = s_lshl_b64 %58, %43
  %63 = slice %60[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64 = slice %60[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %65, %66 = s_add_co_u32 %45, %63
  %67, %68 = s_addc_u32 %46, %64, %66
  %69 = concat(%65, %67) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %40, %55, %69 {offset = 16}
  return %previous
}
