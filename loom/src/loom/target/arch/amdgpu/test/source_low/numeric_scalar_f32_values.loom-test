// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_f32_values.loom
// RUN: emit source-low target=amdgpu:gfx1100 output=none

func.def @scalar_f32_arithmetic(%lhs: f32, %rhs: f32) -> (f32, f32, f32, f32) {
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %lhs, %rhs : f32
  %product = scalar.mulf %lhs, %rhs : f32
  %quotient = scalar.divf %lhs, %rhs : f32
  func.return %sum, %difference, %product, %quotient : f32, f32, f32, f32
}

// ====

func.def @scalar_f32_signs(%magnitude: f32, %sign: f32) -> (f32, f32, f32) {
  %absolute = scalar.absf %magnitude : f32
  %negated = scalar.negf %magnitude : f32
  %copied = scalar.copysignf %magnitude, %sign : f32
  func.return %absolute, %negated, %copied : f32, f32, f32
}

// ====

func.def @scalar_f32_extrema(%lhs: f32, %rhs: f32) -> (f32, f32) {
  %minimum = scalar.minimumf %lhs, %rhs : f32
  %maximum = scalar.maximumf %lhs, %rhs : f32
  func.return %minimum, %maximum : f32, f32
}

// ====

func.def @scalar_f32_rounding(%input: f32) -> (f32, f32, f32, f32) {
  %ceil = scalar.ceilf %input : f32
  %floor = scalar.floorf %input : f32
  %roundeven = scalar.roundevenf %input : f32
  %trunc = scalar.truncf %input : f32
  func.return %ceil, %floor, %roundeven, %trunc : f32, f32, f32, f32
}

// ====

func.def @scalar_f32_sqrt(%input: f32) -> (f32) {
  %result = scalar.sqrtf %input : f32
  func.return %result : f32
}

// ====

func.def @scalar_f32_comparisons(%lhs: f32, %rhs: f32) -> (i1, i1, i1, i1, i1, i1) {
  %equal = scalar.cmpf oeq, %lhs, %rhs : f32
  %greater = scalar.cmpf ogt, %lhs, %rhs : f32
  %greater_equal = scalar.cmpf oge, %lhs, %rhs : f32
  %less = scalar.cmpf olt, %lhs, %rhs : f32
  %less_equal = scalar.cmpf ole, %lhs, %rhs : f32
  %not_equal_or_unordered = scalar.cmpf une, %lhs, %rhs : f32
  func.return %equal, %greater, %greater_equal, %less, %less_equal, %not_equal_or_unordered : i1, i1, i1, i1, i1, i1
}

// ====

// The nnan contract makes the ordered and unordered spellings equivalent.
func.def @scalar_f32_comparisons_no_nan(%lhs: f32, %rhs: f32) -> (i1, i1, i1, i1, i1, i1) {
  %not_equal = scalar.cmpf<nnan> one, %lhs, %rhs : f32
  %equal = scalar.cmpf<nnan> ueq, %lhs, %rhs : f32
  %greater = scalar.cmpf<nnan> ugt, %lhs, %rhs : f32
  %greater_equal = scalar.cmpf<nnan> uge, %lhs, %rhs : f32
  %less = scalar.cmpf<nnan> ult, %lhs, %rhs : f32
  %less_equal = scalar.cmpf<nnan> ule, %lhs, %rhs : f32
  func.return %not_equal, %equal, %greater, %greater_equal, %less, %less_equal : i1, i1, i1, i1, i1, i1
}
