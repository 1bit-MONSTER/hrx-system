  %228 = s_lshl_b32_rhs_inline %227, 1
  %229 = v_mov_b32_copy %223
  %count_x = concat(%229, %202) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
