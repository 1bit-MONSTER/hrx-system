// RUN: emit source-low target=amdgpu:gfx1250 output=low

// Dynamic dispatch fields are loaded in their native widths even when a
// connected control-flow component requires a wider published carrier.
kernel.def @wide_cluster_queries(%groups_x: index, %groups_y: index, %groups_z: index) {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  %cluster_width = index.constant 2 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %groups_z) workgroup_size(%threads, %unit, %unit) cluster_size(%cluster_width, %cluster_width, %cluster_width) : index
} launch(%output: buffer) {
  %group_x = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %group_z = kernel.workgroup.id<z> : index
  %lane = kernel.workitem.id<x> : index
  %c0_index = index.constant 0 : index
  %first_x = index.cmp eq, %group_x, %c0_index : index
  %first_y = index.cmp eq, %group_y, %c0_index : index
  %first_z = index.cmp eq, %group_z, %c0_index : index
  %first_lane = index.cmp eq, %lane, %c0_index : index
  %first_xy = scalar.andi %first_x, %first_y : i1
  %first_xyz = scalar.andi %first_xy, %first_z : i1
  %leader = scalar.andi %first_xyz, %first_lane : i1
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %iterations = scalar.constant 2 : i32
  %count_x = kernel.workgroup.count<x> : index
  %count_y = kernel.workgroup.count<y> : index
  %count_z = kernel.workgroup.count<z> : index
  %cluster_x = kernel.cluster.id<x> : index
  %cluster_y = kernel.cluster.id<y> : index
  %cluster_z = kernel.cluster.id<z> : index
  %local_x = kernel.cluster.workgroup.id<x> : index
  %local_y = kernel.cluster.workgroup.id<y> : index
  %local_z = kernel.cluster.workgroup.id<z> : index
  %local_flat = kernel.cluster.workgroup.flat_id : index
  %size = kernel.cluster.size<x> : index
  %clusters_x = kernel.cluster.count<x> : index
  %clusters_y = kernel.cluster.count<y> : index
  %clusters_z = kernel.cluster.count<z> : index
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<3x14xi64>
  cfg.cond_br %leader, ^enter, ^exit
^enter:
  %wide_count_x = index.constant 4294967303 : index
  %wide_count_y = index.constant 4294967304 : index
  %wide_count_z = index.constant 4294967305 : index
  %wide_cluster_x = index.constant 4294967306 : index
  %wide_cluster_y = index.constant 4294967307 : index
  %wide_cluster_z = index.constant 4294967308 : index
  %wide_local_x = index.constant 4294967309 : index
  %wide_local_y = index.constant 4294967310 : index
  %wide_local_z = index.constant 4294967311 : index
  %wide_local_flat = index.constant 4294967312 : index
  %wide_size = index.constant 4294967313 : index
  %wide_clusters_x = index.constant 4294967314 : index
  %wide_clusters_y = index.constant 4294967315 : index
  %wide_clusters_z = index.constant 4294967316 : index
  cfg.br ^loop(%iterations: i32, %count_x: index, %count_y: index, %count_z: index, %cluster_x: index, %cluster_y: index, %cluster_z: index, %local_x: index, %local_y: index, %local_z: index, %local_flat: index, %size: index, %clusters_x: index, %clusters_y: index, %clusters_z: index)
^loop(%remaining: i32, %value_count_x: index, %value_count_y: index, %value_count_z: index, %value_cluster_x: index, %value_cluster_y: index, %value_cluster_z: index, %value_local_x: index, %value_local_y: index, %value_local_z: index, %value_local_flat: index, %value_size: index, %value_clusters_x: index, %value_clusters_y: index, %value_clusters_z: index):
  %slot_value = index.cast %remaining : i32 to index
  %slot = index.assume %slot_value [range(%slot_value, 0, 2)] : index
  %bits_count_x = index.cast %value_count_x : index to i64
  view.store %bits_count_x, %view[%slot, 0] : i64, view<3x14xi64>
  %bits_count_y = index.cast %value_count_y : index to i64
  view.store %bits_count_y, %view[%slot, 1] : i64, view<3x14xi64>
  %bits_count_z = index.cast %value_count_z : index to i64
  view.store %bits_count_z, %view[%slot, 2] : i64, view<3x14xi64>
  %bits_cluster_x = index.cast %value_cluster_x : index to i64
  view.store %bits_cluster_x, %view[%slot, 3] : i64, view<3x14xi64>
  %bits_cluster_y = index.cast %value_cluster_y : index to i64
  view.store %bits_cluster_y, %view[%slot, 4] : i64, view<3x14xi64>
  %bits_cluster_z = index.cast %value_cluster_z : index to i64
  view.store %bits_cluster_z, %view[%slot, 5] : i64, view<3x14xi64>
  %bits_local_x = index.cast %value_local_x : index to i64
  view.store %bits_local_x, %view[%slot, 6] : i64, view<3x14xi64>
  %bits_local_y = index.cast %value_local_y : index to i64
  view.store %bits_local_y, %view[%slot, 7] : i64, view<3x14xi64>
  %bits_local_z = index.cast %value_local_z : index to i64
  view.store %bits_local_z, %view[%slot, 8] : i64, view<3x14xi64>
  %bits_local_flat = index.cast %value_local_flat : index to i64
  view.store %bits_local_flat, %view[%slot, 9] : i64, view<3x14xi64>
  %bits_size = index.cast %value_size : index to i64
  view.store %bits_size, %view[%slot, 10] : i64, view<3x14xi64>
  %bits_clusters_x = index.cast %value_clusters_x : index to i64
  view.store %bits_clusters_x, %view[%slot, 11] : i64, view<3x14xi64>
  %bits_clusters_y = index.cast %value_clusters_y : index to i64
  view.store %bits_clusters_y, %view[%slot, 12] : i64, view<3x14xi64>
  %bits_clusters_z = index.cast %value_clusters_z : index to i64
  view.store %bits_clusters_z, %view[%slot, 13] : i64, view<3x14xi64>
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = scalar.subi %remaining, %c1 : i32
  cfg.br ^loop(%next: i32, %wide_count_x: index, %wide_count_y: index, %wide_count_z: index, %wide_cluster_x: index, %wide_cluster_y: index, %wide_cluster_z: index, %wide_local_x: index, %wide_local_y: index, %wide_local_z: index, %wide_local_flat: index, %wide_size: index, %wide_clusters_x: index, %wide_clusters_y: index, %wide_clusters_z: index)
^exit:
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.gfx125x.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) cluster_size(2, 2, 2) @wide_cluster_queries() asm {
