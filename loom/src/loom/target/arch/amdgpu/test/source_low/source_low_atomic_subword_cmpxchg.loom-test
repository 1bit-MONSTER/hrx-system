func.def @subword_global_i8(%input: buffer, %expected: i8, %replacement: i8) -> (i8) {
  %memory = buffer.assume.memory_space<global> %input : buffer
  %origin = index.constant 3 : offset
  %cell = buffer.view %memory[%origin] : buffer -> view<1xi8>
  %old = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i8, view<1xi8> -> i8
  func.return %old : i8
}

