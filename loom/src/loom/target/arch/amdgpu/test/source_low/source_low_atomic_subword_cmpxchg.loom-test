// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_subword_cmpxchg.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

func.def @subword_i8(%expected: i8, %replacement: i8) -> (i8) {
  %origin = index.constant 1 : offset
  %bytes = index.constant 3 : offset
  %storage = buffer.alloca<workgroup> align(1) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi8>
  %old = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : i8, view<1xi8> -> i8
  func.return %old : i8
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: * = ds_cmpst_rtn_b32 *
CHECK: * = v_cndmask_b32 *
CHECK: * = v_cmp_ne_i32 *
CHECK: * = v_cmp_eq_i32 *
CHECK: *low.cond_br *
CHECK: * = v_lshrrev_b32 *

// ====

