// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// A wide uniform numerator can produce independently narrow and wide index
// results without changing the retained two-word source carrier.
func.def target(@target) @uniform_wide_index_division(%input: index) -> (index, index) where [range(%input, 4294967296, 1099511627775)] {
  %value = index.assume %input [range(%input, 4294967296, 1099511627775)] : index
  %quotient_divisor = index.constant 256 : index
  %remainder_divisor = index.constant 4294967297 : index
  %quotient = index.div %value, %quotient_divisor : index
  %remainder = index.rem %value, %remainder_divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_wide_index_division(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) where [range(%value, 4294967296, 1099511627775)] asm {
  %11 = s_mov_b32 8
  %12 = s_lshr_b64 %value, %11
  %quotient = slice %12[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = s_mov_b32 4294967041
  %15 = s_mov_b32 255
  %17 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = s_mov_b32 0
  %22 = s_mul_hi_u32 %17, %14
  %23 = s_mul_i32 %19, %14
  %24 = s_mul_hi_u32 %19, %14
  %31, %32 = s_add_co_u32 %23, %22
  %33, %34 = s_addc_u32 %24, %21, %32
  %38 = s_mul_i32 %17, %15
  %39 = s_mul_hi_u32 %17, %15
  %46, %47 = s_add_co_u32 %38, %31
  %48, %49 = s_addc_u32 %39, %21, %47
  %53 = s_mul_i32 %19, %15
  %54 = s_mul_hi_u32 %19, %15
  %61, %62 = s_add_co_u32 %53, %33
  %63, %64 = s_addc_u32 %54, %21, %62
  %71, %72 = s_add_co_u32 %61, %48
  %73, %74 = s_addc_u32 %63, %21, %72
  %75 = concat(%71, %73) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %77 = s_lshr_b64 %75, %11
  %78 = slice %77[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %79 = s_mov_b32 1
  %84 = s_mul_i32 %78, %79
  %85 = s_mul_hi_u32 %78, %79
  %87 = s_add_u32 %85, %84
  %93, %94 = s_sub_co_u32 %17, %84
  %95, %96 = s_subb_u32 %19, %87, %94
  %remainder = concat(%93, %95) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %quotient, %remainder
}

// ====

amdgpu.target<gfx942> @target

// Varying index division uses the same retained word-arithmetic recipe while
// publishing the fact-selected width of each result.
func.def target(@target) @varying_wide_index_division(%inputs: vector<2xi64>) -> (index, index) {
  %input = vector.extract %inputs[0] : vector<2xi64> -> i64
  %bounded = scalar.assume %input [range(%input, 4294967296, 1099511627775)] : i64
  %value = index.cast %bounded : i64 to index
  %quotient_divisor = index.constant 3 : index
  %remainder_divisor = index.constant 7 : index
  %quotient = index.div %value, %quotient_divisor : index
  %remainder = index.rem %value, %remainder_divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_wide_index_division(%inputs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>) asm {
  %14 = v_mov_b32 1431655766
  %15 = v_mov_b32 1431655765
  %160 = slice %inputs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %159 = slice %inputs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_mov_b32 0
  %22 = v_mul_hi_u32 %160, %14
  %23 = v_mul_lo_u32 %159, %14
  %24 = v_mul_hi_u32 %159, %14
  %31, %32 = v_add_co_u32 %23, %22
  %33, %34 = v_addc_co_u32 %24, %21, %32
  %38 = v_mul_lo_u32 %160, %15
  %39 = v_mul_hi_u32 %160, %15
  %46, %47 = v_add_co_u32 %38, %31
  %48, %49 = v_addc_co_u32 %39, %21, %47
  %53 = v_mul_lo_u32 %159, %15
  %54 = v_mul_hi_u32 %159, %15
  %61, %62 = v_add_co_u32 %53, %33
  %63, %64 = v_addc_co_u32 %54, %21, %62
  %71, %72 = v_add_co_u32 %61, %48
  %73, %74 = v_addc_co_u32 %63, %21, %72
  %quotient = concat(%71, %73) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %76 = v_mov_b32 2454267027
  %77 = v_mov_b32 613566756
  %84 = v_mul_hi_u32 %160, %76
  %85 = v_mul_lo_u32 %159, %76
  %86 = v_mul_hi_u32 %159, %76
  %93, %94 = v_add_co_u32 %85, %84
  %95, %96 = v_addc_co_u32 %86, %21, %94
  %100 = v_mul_lo_u32 %160, %77
  %101 = v_mul_hi_u32 %160, %77
  %108, %109 = v_add_co_u32 %100, %93
  %110, %111 = v_addc_co_u32 %101, %21, %109
  %115 = v_mul_lo_u32 %159, %77
  %123, %124 = v_add_co_u32 %115, %95
  %133, %134 = v_add_co_u32 %123, %110
  %138 = v_mov_b32 7
  %141 = v_mul_lo_u32 %133, %138
  %150, %151 = v_sub_co_u32 %160, %141
  return %quotient, %150
}
