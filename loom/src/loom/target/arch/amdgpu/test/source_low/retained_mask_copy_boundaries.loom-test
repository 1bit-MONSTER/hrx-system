// Copy identity proofs stop at pre-read copies and replacing scalar reads.
// RUN: emit amdgpu-assembly @before_read strategy=source fixed=%current:physical_register:0:2 fixed=%next:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @before_read(%value: reg<amdgpu.vgpr>, %current: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.br ^exit(%swapped: reg<amdgpu.sgpr x2>)
^exit(%next: reg<amdgpu.sgpr x2>):
  return %next
}

// ----
  s_mov_b32 s2, s0
  s_mov_b32 s3, s1
  s_mov_b32 s1, s2
  s_mov_b32 s0, s3
  v_cndmask_b32 v0, 0, v0, s[2:3]
.Lbb1:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @loop_before_read strategy=source fixed=%seed:physical_register:0:2 fixed=%current:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @loop_before_read(%value: reg<amdgpu.vgpr>, %seed: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%seed: reg<amdgpu.sgpr x2>)
^loop(%current: reg<amdgpu.sgpr x2>):
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.br ^loop(%swapped: reg<amdgpu.sgpr x2>)
}

// ----
.Lbb1:
  s_mov_b32 s3, s0
  s_mov_b32 s2, s1
  v_cndmask_b32 v1, 0, v0, s[0:1]
  s_mov_b32 s0, s2
  s_waitcnt_depctr 0xff9e
  s_mov_b32 s1, s3
  s_waitcnt_depctr 0xff9e
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @loop_identity strategy=source fixed=%seed:physical_register:0:2 fixed=%current:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @loop_identity(%value: reg<amdgpu.vgpr>, %seed: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%seed: reg<amdgpu.sgpr x2>)
^loop(%current: reg<amdgpu.sgpr x2>):
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %same = concat(%first, %second) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.br ^loop(%same: reg<amdgpu.sgpr x2>)
}

// ----
.Lbb1:
  v_cndmask_b32 v1, 0, v0, s[0:1]
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @identity strategy=source fixed=%current:physical_register:0:2 fixed=%next:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @identity(%value: reg<amdgpu.vgpr>, %current: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %same = concat(%first, %second) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.br ^exit(%same: reg<amdgpu.sgpr x2>)
^exit(%next: reg<amdgpu.sgpr x2>):
  return %next
}

// ----
  s_mov_b32 s2, s0
  s_mov_b32 s3, s1
  s_mov_b32 s0, s2
  s_mov_b32 s1, s3
  v_cndmask_b32 v0, 0, v0, s[2:3]
.Lbb1:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @after_reset strategy=source fixed=%current:physical_register:0:2 fixed=%next:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @after_reset(%value: reg<amdgpu.vgpr>, %current: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %first
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^exit(%swapped: reg<amdgpu.sgpr x2>)
^exit(%next: reg<amdgpu.sgpr x2>):
  return %next
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_mov_b32 s3, s0
  v_mov_b32_copy v0, s3
  s_mov_b32 s2, s1
  s_mov_b32 s0, s2
  s_mov_b32 s1, s3
.Lbb1:
  s_endpgm
