// RUN: emit amdgpu-assembly @partial_lds_concat strategy=source fixed=%address:physical_register:0:1 fixed=%ready:physical_register:12:4 fixed=%first:physical_register:4:4 fixed=%joined:physical_register:4:8 fixed=%later:physical_register:16:4

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @partial_lds_concat(%address: reg<amdgpu.vgpr>, %ready: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x4>) asm {
  %first = ds_read_b128 %address
  %joined = concat(%first, %ready) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %later = ds_read_b128 %address {offset = 1024}
  return %joined, %later
}

// ----
  ds_read_b128 v[4:7], v0 offset:0
  v_mov_b32 v8, v12
  v_mov_b32 v9, v13
  v_mov_b32 v10, v14
  v_mov_b32 v11, v15
  ds_read_b128 v[16:19], v0 offset:1024
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Cross-class structural moves retain independent source and destination
// register banks through wait-state planning. A high VGPR destination must not
// be interpreted as an SGPR index merely because the source is scalar.
// RUN: emit amdgpu-assembly @sgpr_to_high_vgpr_copy strategy=source fixed=%source:physical_register:2:1 fixed=%result:physical_register:96:1

amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @sgpr_to_high_vgpr_copy(%source: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = copy %source : reg<amdgpu.sgpr> -> reg<amdgpu.vgpr>
  return %result
}

// ----
  v_mov_b32 v96, s2
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @sgpr_to_high_vgpr_copy strategy=source fixed=%source:physical_register:2:1 fixed=%result:physical_register:200:1

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @sgpr_to_high_vgpr_copy(%source: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = copy %source : reg<amdgpu.sgpr> -> reg<amdgpu.vgpr>
  return %result
}

// ----
  v_mov_b32 v200, s2
  s_endpgm

// ====

// Materialized inner aggregates consume the first two loads before later
// loads can reuse their physical registers.
// RUN: emit amdgpu-assembly @nested_lds_copied strategy=source

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @nested_lds_copied(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x16>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 1024}
  %prefix = concat(%first, %second) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %third = ds_read_b128 %address {offset = 2048}
  %fourth = ds_read_b128 %address {offset = 3072}
  %suffix = concat(%third, %fourth) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %joined = concat(%prefix, %suffix) : (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) -> reg<amdgpu.vgpr x16>
  return %joined
}

// ----
  ds_read_b128 v[4:7], v0 offset:0
  ds_read_b128 v[8:11], v0 offset:1024
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_mov_b32 v16, v4
  v_mov_b32 v17, v5
  v_mov_b32 v18, v6
  v_mov_b32 v19, v7
  v_mov_b32 v20, v8
  v_mov_b32 v21, v9
  v_mov_b32 v22, v10
  v_mov_b32 v23, v11
  ds_read_b128 v[8:11], v0 offset:2048
  ds_read_b128 v[12:15], v0 offset:3072
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_mov_b32 v24, v8
  v_mov_b32 v25, v9
  v_mov_b32 v26, v10
  v_mov_b32 v27, v11
  v_mov_b32 v28, v12
  v_mov_b32 v29, v13
  v_mov_b32 v30, v14
  v_mov_b32 v31, v15
  s_endpgm

// ====

// Exact nested forwarding keeps the first aggregate's pending loads in their
// final storage without an early completion wait.
// RUN: emit amdgpu-assembly @nested_lds_alias strategy=source fixed=%first:physical_register:16:4 fixed=%second:physical_register:20:4

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @nested_lds_alias(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x16>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 1024}
  %prefix = concat(%first, %second) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %third = ds_read_b128 %address {offset = 2048}
  %fourth = ds_read_b128 %address {offset = 3072}
  %suffix = concat(%third, %fourth) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %joined = concat(%prefix, %suffix) : (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) -> reg<amdgpu.vgpr x16>
  return %joined
}

// ----
  ds_read_b128 v[16:19], v0 offset:0
  ds_read_b128 v[20:23], v0 offset:1024
  ds_read_b128 v[8:11], v0 offset:2048
  ds_read_b128 v[12:15], v0 offset:3072
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_mov_b32 v24, v8
  v_mov_b32 v25, v9
  v_mov_b32 v26, v10
  v_mov_b32 v27, v11
  v_mov_b32 v28, v12
  v_mov_b32 v29, v13
  v_mov_b32 v30, v14
  v_mov_b32 v31, v15
  s_endpgm

// ====

// A flat aggregate provides the direct-forwarding baseline.
// RUN: emit amdgpu-assembly @flat_lds_alias strategy=source

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @flat_lds_alias(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x16>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 1024}
  %third = ds_read_b128 %address {offset = 2048}
  %fourth = ds_read_b128 %address {offset = 3072}
  %joined = concat(%first, %second, %third, %fourth) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x16>
  return %joined
}

// ----
  ds_read_b128 v[16:19], v0 offset:0
  ds_read_b128 v[20:23], v0 offset:1024
  ds_read_b128 v[24:27], v0 offset:2048
  ds_read_b128 v[28:31], v0 offset:3072
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Slicing and reassembling every unit in original order preserves the pending
// load's exact storage identity.
// RUN: emit amdgpu-assembly @reconstructed_lds_alias strategy=source fixed=%address:physical_register:0:1 fixed=%first:physical_register:16:4 fixed=%joined:physical_register:16:4 fixed=%later:physical_register:8:4

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @reconstructed_lds_alias(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %first = ds_read_b128 %address
  %lower = slice %first[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %upper = slice %first[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %joined = concat(%lower, %upper) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %later = ds_read_b128 %address {offset = 1024}
  return %joined, %later
}

// ----
  ds_read_b128 v[16:19], v0 offset:0
  ds_read_b128 v[8:11], v0 offset:1024
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Repeating one half does not cover the leased storage exactly and requires a
// completion wait before materializing the duplicate.
// RUN: emit amdgpu-assembly @repeated_lds_half strategy=source fixed=%address:physical_register:0:1 fixed=%first:physical_register:16:4 fixed=%joined:physical_register:16:4 fixed=%later:physical_register:8:4

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @repeated_lds_half(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %first = ds_read_b128 %address
  %lower = slice %first[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %joined = concat(%lower, %lower) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %later = ds_read_b128 %address {offset = 1024}
  return %joined, %later
}

// ----
  ds_read_b128 v[16:19], v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_mov_b32 v18, v16
  v_mov_b32 v19, v17
  ds_read_b128 v[8:11], v0 offset:1024
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Reordering halves requires capture and move sequencing after the original
// load completes.
// RUN: emit amdgpu-assembly @swapped_lds_halves strategy=source fixed=%address:physical_register:0:1 fixed=%first:physical_register:16:4 fixed=%joined:physical_register:16:4 fixed=%later:physical_register:8:4

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @swapped_lds_halves(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %first = ds_read_b128 %address
  %lower = slice %first[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %upper = slice %first[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %joined = concat(%upper, %lower) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %later = ds_read_b128 %address {offset = 1024}
  return %joined, %later
}

// ----
  ds_read_b128 v[16:19], v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_mov_b32 v14, v18
  v_mov_b32 v15, v19
  s_delay_alu instid0(VALU_DEP_1)
  v_mov_b32 v18, v16
  v_mov_b32 v19, v17
  v_mov_b32 v16, v14
  v_mov_b32 v17, v15
  ds_read_b128 v[8:11], v0 offset:1024
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

