amdgpu.target<gfx11-generic> @target

func.def target(@target) @distinct_snapshot_consumers(%source: buffer, %destination: buffer, %original: buffer, %duplicate: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<64xi32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<64xi32>
  %original_view = buffer.view %original[%base] : buffer -> view<64xi32>
  %duplicate_view = buffer.view %duplicate[%base] : buffer -> view<64xi32>
  %12 = vector.load %source_view[0] : view<64xi32> -> vector<4xi32>
  %13 = vector.load %source_view[4] : view<64xi32> -> vector<4xi32>
  %14 = vector.load %source_view[8] : view<64xi32> -> vector<4xi32>
  %15 = vector.load %source_view[12] : view<64xi32> -> vector<4xi32>
  %16 = vector.load %source_view[16] : view<64xi32> -> vector<4xi32>
  %17 = vector.load %source_view[20] : view<64xi32> -> vector<4xi32>
  %18 = vector.load %source_view[24] : view<64xi32> -> vector<4xi32>
  %19 = vector.load %source_view[28] : view<64xi32> -> vector<4xi32>
  %20 = vector.load %source_view[32] : view<64xi32> -> vector<4xi32>
  %21 = vector.load %source_view[36] : view<64xi32> -> vector<4xi32>
  %22 = vector.load %source_view[40] : view<64xi32> -> vector<4xi32>
  %23 = vector.load %source_view[44] : view<64xi32> -> vector<4xi32>
  %24 = vector.load %source_view[48] : view<64xi32> -> vector<4xi32>
  %25 = vector.load %source_view[52] : view<64xi32> -> vector<4xi32>
  %26 = vector.load %source_view[56] : view<64xi32> -> vector<4xi32>
  %27 = vector.load %source_view[60] : view<64xi32> -> vector<4xi32>
  %29 = index.constant 256 : offset
  %30 = buffer.alloca<private> align(16) %29 : buffer
  %31 = index.constant 0 : offset
  %32 = buffer.view %30[%31] : buffer -> view<64xi32>
  vector.store %12, %32[0] : vector<4xi32>, view<64xi32>
  vector.store %13, %32[4] : vector<4xi32>, view<64xi32>
  vector.store %14, %32[8] : vector<4xi32>, view<64xi32>
  vector.store %15, %32[12] : vector<4xi32>, view<64xi32>
  vector.store %16, %32[16] : vector<4xi32>, view<64xi32>
  vector.store %17, %32[20] : vector<4xi32>, view<64xi32>
  vector.store %18, %32[24] : vector<4xi32>, view<64xi32>
  vector.store %19, %32[28] : vector<4xi32>, view<64xi32>
  vector.store %20, %32[32] : vector<4xi32>, view<64xi32>
  vector.store %21, %32[36] : vector<4xi32>, view<64xi32>
  vector.store %22, %32[40] : vector<4xi32>, view<64xi32>
  vector.store %23, %32[44] : vector<4xi32>, view<64xi32>
  vector.store %24, %32[48] : vector<4xi32>, view<64xi32>
  vector.store %25, %32[52] : vector<4xi32>, view<64xi32>
  vector.store %26, %32[56] : vector<4xi32>, view<64xi32>
  vector.store %27, %32[60] : vector<4xi32>, view<64xi32>
  %47 = index.constant 0 : index
  %48 = index.constant 64 : index
  %49 = index.constant 4 : index
  scf.for %50 = [%47 to %48 step %49] {
    %51 = vector.load %32[%50] : view<64xi32> -> vector<4xi32>
    %52 = vector.addi %51, %51 : vector<4xi32>
    %53 = vector.load %32[%50] : view<64xi32> -> vector<4xi32>
    %54 = vector.addi %52, %53 : vector<4xi32>
    vector.store %54, %destination_view[%50] : vector<4xi32>, view<64xi32>
  }
  %42 = index.constant 0 : index
  %43 = index.constant 64 : index
  %44 = index.constant 4 : index
  scf.for %45 = [%42 to %43 step %44] {
    %46 = vector.load %32[%45] : view<64xi32> -> vector<4xi32>
    vector.store %46, %original_view[%45] : vector<4xi32>, view<64xi32>
  }
  %37 = index.constant 0 : index
  %38 = index.constant 64 : index
  %39 = index.constant 4 : index
  scf.for %40 = [%37 to %38 step %39] {
    %41 = vector.load %32[%40] : view<64xi32> -> vector<4xi32>
    vector.store %41, %duplicate_view[%40] : vector<4xi32>, view<64xi32>
  }
  func.return
}
