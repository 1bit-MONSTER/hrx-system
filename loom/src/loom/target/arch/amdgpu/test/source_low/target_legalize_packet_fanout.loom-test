// RUN: pass target-legalize{mode=final,policy=require-native}

// Four operand uses belong to three distinct consumers. With sixteen packets,
// their shared snapshot stays exactly within the 64-operation staging budget.
amdgpu.target<gfx11-generic> @target

func.def target(@target) @duplicate_snapshot_operands(%source: buffer, %destination: buffer, %original: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<64xi32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<64xi32>
  %original_view = buffer.view %original[%base] : buffer -> view<64xi32>
  %snapshot = vector.load %source_view[0] : view<64xi32> -> vector<64xi32>
  %doubled = vector.addi %snapshot, %snapshot : vector<64xi32>
  %tripled = vector.addi %doubled, %snapshot : vector<64xi32>
  vector.store %tripled, %destination_view[0] : vector<64xi32>, view<64xi32>
  vector.store %snapshot, %original_view[0] : vector<64xi32>, view<64xi32>
  func.return
}

