// The mask is dead in SSA before the backedge, but its physical read survives
// to the scalar write at the start of the next iteration.
// RUN: emit low-allocation-json @backedge_retains_mask fixed=%mask:physical_register:0:2 fixed=%lower:physical_register:4:1 fixed=%upper:physical_register:5:1 fixed=%step:physical_register:6:1

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @backedge_retains_mask(%lower: reg<amdgpu.sgpr>, %upper: reg<amdgpu.sgpr>, %step: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  low.scf.for signed [%lower to %upper step %step] do(%iteration: reg<amdgpu.sgpr>) {
    %scratch = s_mov_b32 1
    %mask = v_cmp_eq_i32 %value, %value
    %selected = v_cndmask_b32 %value, %value, %mask
  }
  return
}

