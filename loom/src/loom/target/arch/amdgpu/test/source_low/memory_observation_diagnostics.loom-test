// RUN: emit source-low target=amdgpu:gfx1151 output=none

// Splitting an unaligned observation into byte loads cannot preserve atomicity.
kernel.def @unaligned_observation() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %base = index.constant 1 : offset
  %word = buffer.view %aligned[%base] : buffer -> view<1xi32, align(1)>
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  %value = view.atomic.load %word[0] {ordering = relaxed, scope = device} : view<1xi32, align(1)> -> i32
  kernel.return
}

// ====

// Four-byte alignment does not establish a single-copy 64-bit observation.
kernel.def @under_aligned_wide_observation() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 8} : buffer
  %base = index.constant 4 : offset
  %word = buffer.view %aligned[%base] : buffer -> view<1xi64, align(4)>
  %value = scalar.constant 4294967297 : i64
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  %observed = view.atomic.load %word[0] {ordering = relaxed, scope = device} : view<1xi64, align(4)> -> i64
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  view.atomic.store %value, %word[0] {ordering = relaxed, scope = system} : i64, view<1xi64, align(4)>
  kernel.return
}

// ====

// LDS width and alignment are atomicity requirements, not scalarization hints.
kernel.def @lds_observation_alignment() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: i64) {
  %base = index.constant 4 : offset
  %bytes = index.constant 16 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %word = buffer.view %scratch[%base] : buffer -> view<1xi64, align(4)>
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  %observed = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi64, align(4)> -> i64
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  view.atomic.store %value, %word[0] {ordering = relaxed, scope = workgroup} : i64, view<1xi64, align(4)>
  kernel.return
}

// ====

// Generic storage has the same indivisible width and alignment requirements.
kernel.def @generic_observation_alignment() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %value: i64) {
  %generic = buffer.assume.memory_space<generic> %input : buffer
  %aligned = buffer.assume.alignment %generic {minimum_alignment = 8} : buffer
  %origin = index.constant 4 : offset
  %word = buffer.view %aligned[%origin] : buffer -> view<1xi64, align(4)>
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  %observed = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xi64, align(4)> -> i64
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.alignment"}
  view.atomic.store %value, %word[0] {ordering = release, scope = system} : i64, view<1xi64, align(4)>
  kernel.return
}
