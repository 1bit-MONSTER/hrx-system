// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_float64_arithmetic.loom-test
// RUN: emit source-low target=amdgpu:gfx1200 output=low

// Native candidates must preserve f64 numerical and backing-memory semantics.
// Source spaces and scopes select the corresponding native or bitwise CAS path.
func.def @atomic_f64_realizations(%global_storage: buffer, %generic_storage: buffer, %value: f64) -> (f64, f64, f64, f64) {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %global_view = buffer.view %global[%base] : buffer -> view<3xf64>
  %generic_view = buffer.view %generic[%base] : buffer -> view<2xf64>
  %workgroup_view = buffer.view %scratch[%base] : buffer -> view<1xf64>
  view.store %value, %workgroup_view[0] : f64, view<1xf64>
  %add = view.atomic.rmw<addf, noftz> %value, %global_view[0] {ordering = relaxed, scope = device} : f64, view<3xf64> -> f64
  view.atomic.reduce<addf, noftz> %value, %generic_view[0] {ordering = release, scope = system} : f64, view<2xf64>
  %minnum = view.atomic.rmw<minnumf> %value, %global_view[1] {ordering = acq_rel, scope = device} : f64, view<3xf64> -> f64
  view.atomic.reduce<maxnumf> %value, %workgroup_view[0] {ordering = release, scope = workgroup} : f64, view<1xf64>
  %workgroup_add = view.atomic.rmw<addf, noftz> %value, %workgroup_view[0] {ordering = seq_cst, scope = system} : f64, view<1xf64> -> f64
  %minimum = view.atomic.rmw<minimumf> %value, %generic_view[1] {ordering = acquire, scope = device} : f64, view<2xf64> -> f64
  view.atomic.reduce<maximumf> %value, %global_view[2] {ordering = relaxed, scope = device} : f64, view<3xf64>
  func.return %add, %minnum, %workgroup_add, %minimum : f64, f64, f64, f64
}

