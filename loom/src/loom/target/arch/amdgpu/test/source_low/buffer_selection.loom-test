// TEMPLATE: loom/src/loom/test/corpus/source_low/buffer_selection.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A selected reference retains the ordinary buffer result ABI.
func.def @choose_buffer(%first: buffer, %second: buffer, %choose_first: i1) -> (buffer) {
  %selected = scf.select %choose_first, %first, %second : buffer
  func.return %selected : buffer
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @choose_buffer(%choose_first: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %first = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = s_cmp_lg_i32_src1_inline %choose_first {rhs = 0}
  %10 = slice %first[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %second[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = s_cselect_b32 %10, %11, %9
  %13 = slice %first[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %second[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = s_cselect_b32 %13, %14, %9
  %selected = concat(%12, %15) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %selected
}

// ====

// A selected reference remains a buffer for both reads and writes.
func.def @exchange_selected_byte(%first: buffer, %second: buffer, %choose_first: i1, %position_input: offset, %replacement: i32) -> (i32) {
  %position = index.assume %position_input [range(%position_input, 0, 1024)] : offset
  %selected = scf.select %choose_first, %first, %second : buffer
  %previous = buffer.load.i8.u %selected[%position]
  buffer.store.i8 %replacement, %selected[%position]
  func.return %previous : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @exchange_selected_byte(%choose_first: reg<amdgpu.sgpr>, %position: reg<amdgpu.sgpr x2>, %replacement: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = s_cmp_lg_i32_src1_inline %choose_first {rhs = 0}
  %16 = slice %first[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %second[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_cselect_b32 %16, %17, %15
  %19 = slice %first[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %second[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = s_cselect_b32 %19, %20, %15
  %23 = v_mov_b32 0
  %24 = slice %position[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = s_mov_b32 0
  %28, %29 = s_add_co_u32 %18, %24
  %30, %31 = s_addc_u32 %21, %27, %29
  %32 = concat(%28, %30) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %previous = global_load_u8_saddr %23, %32
  %34 = v_mov_b32_copy %replacement
  %40, %41 = s_add_co_u32 %18, %24
  %42, %43 = s_addc_u32 %21, %27, %41
  %44 = concat(%40, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b8_saddr %23, %34, %44
  return %previous
}

// ====

// Canonicalization may select the components independently, but both selections
// retain the same condition and therefore the same complete coordinate.
func.def @selected_buffer_coordinate(%first: buffer, %second: buffer, %first_origin_input: offset, %second_origin_input: offset, %choose_first: i1) -> (i32) {
  %first_origin = index.assume %first_origin_input [range(%first_origin_input, 0, 1024)] : offset
  %second_origin = index.assume %second_origin_input [range(%second_origin_input, 0, 1024)] : offset
  %selected, %origin = scf.if %choose_first -> (buffer, offset) {
    scf.yield %first, %first_origin : buffer, offset
  } else {
    scf.yield %second, %second_origin : buffer, offset
  }
  %value = buffer.load.i8.u %selected[%origin]
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @selected_buffer_coordinate(%first_origin: reg<amdgpu.sgpr x2>, %second_origin: reg<amdgpu.sgpr x2>, %choose_first: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = s_cmp_lg_i32_src1_inline %choose_first {rhs = 0}
  %20 = slice %first[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = slice %second[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = s_cselect_b32 %20, %21, %19
  %23 = slice %first[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %second[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_cselect_b32 %23, %24, %19
  %27 = s_cmp_lg_i32_src1_inline %choose_first {rhs = 0}
  %28 = slice %first_origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %second_origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %origin = s_cselect_b32 %28, %29, %27
  %31 = v_mov_b32 0
  %34 = s_mov_b32 0
  %35, %36 = s_add_co_u32 %22, %origin
  %37, %38 = s_addc_u32 %25, %34, %36
  %39 = concat(%35, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_u8_saddr %31, %39
  return %value
}

// ====

// Rotating a reference and its origin carries both values over the same edge.
func.def @rotate_buffer_coordinates(%first: buffer, %second: buffer, %first_origin_input: offset, %second_origin_input: offset, %count: index) -> (i32) {
  %first_origin = index.assume %first_origin_input [range(%first_origin_input, 0, 1024)] : offset
  %second_origin = index.assume %second_origin_input [range(%second_origin_input, 0, 1024)] : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %selected, %origin, %unused_buffer, %unused_origin = scf.for %i = [%begin to %count step %step](%current = %first : buffer, %current_origin = %first_origin : offset, %other = %second : buffer, %other_origin = %second_origin : offset) -> (buffer, offset, buffer, offset) {
    scf.yield %other, %other_origin, %current, %current_origin : buffer, offset, buffer, offset
  }
  %value = buffer.load.i8.u %selected[%origin]
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @rotate_buffer_coordinates(%first_origin: reg<amdgpu.sgpr x2>, %second_origin: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %45 = slice %first_origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = slice %second_origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %first: reg<amdgpu.sgpr x2>, %45: reg<amdgpu.sgpr>, %second: reg<amdgpu.sgpr x2>, %46: reg<amdgpu.sgpr>)
^_bb1(%i: reg<amdgpu.sgpr>, %current: reg<amdgpu.sgpr x2>, %current_origin: reg<amdgpu.sgpr>, %other: reg<amdgpu.sgpr x2>, %other_origin: reg<amdgpu.sgpr>):
  %47 = s_cmp_lt_i32 %i, %count
  low.cond_br %47, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %48 = s_add_u32 %i, %step
  low.br ^_bb1(%48: reg<amdgpu.sgpr>, %other: reg<amdgpu.sgpr x2>, %other_origin: reg<amdgpu.sgpr>, %current: reg<amdgpu.sgpr x2>, %current_origin: reg<amdgpu.sgpr>)
^_bb3:
  %49 = v_mov_b32 0
  %50 = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %53, %54 = s_add_co_u32 %50, %current_origin
  %55, %56 = s_addc_u32 %51, %begin, %54
  %57 = concat(%53, %55) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_u8_saddr %49, %57
  return %value
}
