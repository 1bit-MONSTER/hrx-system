// ====

// The low sum is dead, but its unsigned carry contributes to the returned word.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @high_word_only(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %step = s_mov_b32 3
  %zero = s_mov_b32 0
  %sum_low, %carry = s_add_co_u32 %low, %step
  %sum_high, %carry_out = s_addc_u32 %high, %zero, %carry
  return %sum_high
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @high_word_only(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %sum_low, %carry = s_add_co_u32_rhs_inline %low, 3
  %sum_high, %carry_out = s_addc_u32_rhs_inline %high, %carry, 0
  return %sum_high
}

// ====

// Both the carry chain and ordinary arithmetic disappear when their values die.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dead_carry_chain(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %low, %carry = s_add_co_u32 %lhs, %rhs
  %high, %carry_out = s_addc_u32 %lhs, %rhs, %carry
  %ordinary = s_add_u32 %lhs, %rhs
  return %lhs
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dead_carry_chain(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  return %lhs
}

// ====

// Both source positions admit inline constants through 64. A larger operand
// remains in a register, and every high-word addition retains its carry edge.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @carry_constant_bounds(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %inline_limit = s_mov_b32 64
  %outside_inline = s_mov_b32 65
  %sum_low, %carry = s_add_co_u32 %low, %high
  %rhs_zero, %carry_rhs_zero = s_addc_u32 %high, %zero, %carry
  %lhs_zero, %carry_lhs_zero = s_addc_u32 %zero, %rhs_zero, %carry_rhs_zero
  %rhs_limit, %carry_rhs_limit = s_addc_u32 %lhs_zero, %inline_limit, %carry_lhs_zero
  %lhs_limit, %carry_lhs_limit = s_addc_u32 %inline_limit, %rhs_limit, %carry_rhs_limit
  %large, %carry_large = s_addc_u32 %lhs_limit, %outside_inline, %carry_lhs_limit
  return %large
}

// ----
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @carry_constant_bounds(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %outside_inline = s_mov_b32 65
  %sum_low, %carry = s_add_co_u32 %low, %high
  %rhs_zero, %carry_rhs_zero = s_addc_u32_rhs_inline %high, %carry, 0
  %lhs_zero, %carry_lhs_zero = s_addc_u32_lhs_inline %rhs_zero, %carry_rhs_zero, 0
  %rhs_limit, %carry_rhs_limit = s_addc_u32_rhs_inline %lhs_zero, %carry_lhs_zero, 64
  %lhs_limit, %carry_lhs_limit = s_addc_u32_lhs_inline %rhs_limit, %carry_rhs_limit, 64
  %large, %carry_large = s_addc_u32 %lhs_limit, %outside_inline, %carry_lhs_limit
  return %large
}
