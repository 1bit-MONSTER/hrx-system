// ====

func.def @nibble_lookup_to_float_8(%table: vector<16xi8>, %packed: vector<4xi8>) -> (vector<8xf32>) {
  %indices = vector.bitunpacku<4> %packed : vector<4xi8> -> vector<8xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<8xi8> -> vector<8xi8>
  %converted = vector.sitofp %values : vector<8xi8> to vector<8xf32>
  func.return %converted : vector<8xf32>
}

// ----
CHECK: *v_perm_b32*
CHECK: *v_cvt_f32_i32*
CHECK-NOT: *v_cmp_*
CHECK-NOT: *v_cndmask*

// ====

func.def @nibble_lookup_to_float_16(%table: vector<16xi8>, %packed: vector<8xi8>) -> (vector<16xf32>) {
  %indices = vector.bitunpacku<4> %packed : vector<8xi8> -> vector<16xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<16xi8> -> vector<16xi8>
  %converted = vector.sitofp %values : vector<16xi8> to vector<16xf32>
  func.return %converted : vector<16xf32>
}

// ----
CHECK: *v_perm_b32*
CHECK: *v_cvt_f32_i32*
CHECK-NOT: *v_cmp_*
CHECK-NOT: *v_cndmask*
