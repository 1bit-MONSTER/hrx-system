// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_half_extrema.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @half_extrema(%lhs: f16, %rhs: f16) -> (f16, f16, f16, f16) {
  %minimum = scalar.minimumf %lhs, %rhs : f16
  %maximum = scalar.maximumf %lhs, %rhs : f16
  %minnum = scalar.minnumf %lhs, %rhs : f16
  %maxnum = scalar.maxnumf %lhs, %rhs : f16
  func.return %minimum, %maximum, %minnum, %maxnum : f16, f16, f16, f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @half_extrema(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %24 = v_max_f16 %lhs, %lhs
  %25 = v_max_f16 %rhs, %rhs
  %26 = v_min_f16 %24, %25
  %27 = v_cmp_u_f16 %lhs, %rhs
  %28 = v_mov_b32 32767
  %29 = v_bfe_u32_offset_0_width_16_low16 %26
  %minimum = v_cndmask_b32 %29, %28, %27
  %33 = v_max_f16 %24, %25
  %34 = v_bfe_u32_offset_0_width_16_low16 %33
  %maximum = v_cndmask_b32 %34, %28, %27
  return %minimum, %maximum, %29, %34
}

// ====

func.def @half_extrema_uniform(%lhs_bits: i32, %rhs_bits: i32) -> (f16, f16) {
  %lhs_half = scalar.trunci %lhs_bits : i32 to i16
  %rhs_half = scalar.trunci %rhs_bits : i32 to i16
  %lhs = scalar.bitcast %lhs_half : i16 to f16
  %rhs = scalar.bitcast %rhs_half : i16 to f16
  %minimum = scalar.minnumf %lhs, %rhs : f16
  %maximum = scalar.maxnumf %lhs, %rhs : f16
  func.return %minimum, %maximum : f16, f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @half_extrema_uniform(%lhs_bits: reg<amdgpu.sgpr>, %rhs_bits: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %lhs = v_mov_b32_copy %lhs_bits
  %rhs = v_mov_b32_copy %rhs_bits
  %16 = v_max_f16 %lhs, %lhs
  %17 = v_max_f16 %rhs, %rhs
  %minimum = v_min_f16 %16, %17
  %maximum = v_max_f16 %16, %17
  %22 = v_bfe_u32_offset_0_width_16_low16 %minimum
  %23 = v_bfe_u32_offset_0_width_16_low16 %maximum
  return %22, %23
}

// ====

func.def @half_extrema_bounds(%value: f16) -> (f16, f16) {
  %bound = scalar.constant 1.0 : f16
  %minimum = scalar.minnumf %value, %bound : f16
  %maximum = scalar.maxnumf<nnan> %value, %bound : f16
  func.return %minimum, %maximum : f16, f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @half_extrema_bounds(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %bound = v_mov_b32 15360
  %10 = v_max_f16 %value, %value
  %11 = v_max_f16 %bound, %bound
  %minimum = v_min_f16 %10, %11
  %maximum = v_max_f16 %value, %bound
  %14 = v_bfe_u32_offset_0_width_16_low16 %minimum
  %15 = v_bfe_u32_offset_0_width_16_low16 %maximum
  return %14, %15
}

// ====

func.def @packed_half_extrema(%value: vector<4xf16>, %lower: vector<4xf16>, %upper: vector<4xf16>) -> (vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>) {
  %minnum = vector.minnumf %value, %lower : vector<4xf16>
  %maxnum = vector.maxnumf %value, %lower : vector<4xf16>
  %minimum = vector.minimumf %value, %lower : vector<4xf16>
  %maximum = vector.maximumf %value, %lower : vector<4xf16>
  %clamped = vector.clampf<number> %value, %lower, %upper : vector<4xf16>
  %finite = vector.clampf<number, nnan> %value, %lower, %upper : vector<4xf16>
  func.return %minnum, %maxnum, %minimum, %maximum, %clamped, %finite : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
}

