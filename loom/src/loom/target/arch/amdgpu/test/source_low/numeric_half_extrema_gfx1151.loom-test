  %164 = v_or_b32 %161, %163
  %165 = v_and_b32_lit %150, 65535
  %166 = v_and_b32_lit %160, 65535
  %167 = v_lshlrev_b32_src0_inline %166, 16
  %168 = v_or_b32 %165, %167
  %minimum = concat(%164, %168) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %172 = v_max_f16 %126, %127
