  %213 = slice %upper[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %215 = v_pk_max_f16 %213, %213
  %216 = slice %upper[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
