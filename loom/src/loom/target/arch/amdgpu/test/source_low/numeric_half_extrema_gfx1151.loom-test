  %148 = v_cmp_u_f16 %85, %92
  %149 = v_bfe_u32_offset_0_width_16_low16 %147
  %150 = v_cndmask_b32 %149, %130, %148
  %152 = v_lshrrev_b32_src0_inline %85, 16
  %154 = v_lshrrev_b32_src0_inline %92, 16
  %155 = v_max_f16 %152, %152
