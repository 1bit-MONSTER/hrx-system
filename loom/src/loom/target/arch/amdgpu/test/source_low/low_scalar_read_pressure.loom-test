// Both scalar inputs remain live when the carry result is written. Their
// transient pressure makes the independent storage operation preferable.
// RUN: with-checks emit low-schedule-json @two_uniform_late_reads strategy=resource-stall diagnostics=candidates amdgpu.sgpr=4

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @two_uniform_late_reads(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %result, %carry = v_add_co_u32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %scratch = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  return %result, %carry
}

// ----
CHECK: *"scheduled_node_indices":[1,0,2],*
CHECK: *"rejected_node":0,*"rejected_pressure_cliff_penalty":2,"rejected_pressure_cliff_source":"amdgpu.sgpr","rejected_pressure_cliff_units":4,*

// ====

// A dying slice keeps one unit of its early-read owner live through the write.
// RUN: with-checks emit low-schedule-json @late_slice_of_carry strategy=resource-stall diagnostics=candidates amdgpu.sgpr=3

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @late_slice_of_carry(%carry_in: reg<amdgpu.sgpr x2>, %varying: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  // REMARK@+1: BACKEND/015
  %uniform = slice %carry_in[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  // REMARK@+1: BACKEND/015
  %result, %carry = v_add_co_ci_u32 %uniform, %varying, %carry_in
  %scratch = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  return %result, %carry
}

// ----
CHECK: *"scheduled_node_indices":[0,1,2,3],*
CHECK: *"chosen_node":1,*"chosen_pressure_cliff_penalty":2,"chosen_pressure_cliff_source":"amdgpu.sgpr","chosen_pressure_cliff_units":3,*

// ====

// Repeated late operands consume one storage lifetime, not two.
// RUN: with-checks emit low-schedule-json @repeated_late_read strategy=resource-stall diagnostics=candidates amdgpu.sgpr=3

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @repeated_late_read(%uniform: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %result, %carry = v_add_co_u32 %uniform, %uniform
  // REMARK@+1: BACKEND/015
  %scratch = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  return %result, %carry
}

// ----
CHECK: *"scheduled_node_indices":[1,0,2],*
CHECK: *"rejected_node":0,*"rejected_pressure_cliff_penalty":3,"rejected_pressure_cliff_source":"amdgpu.sgpr","rejected_pressure_cliff_units":3,*
