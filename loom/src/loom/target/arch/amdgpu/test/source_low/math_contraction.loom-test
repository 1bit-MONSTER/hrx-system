// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @scalar_contract(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %product, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_contract(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_fma_f32 %a, %b, %c
  return %result
}

// ====

func.def @scalar_swapped(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %c, %product : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_swapped(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_fma_f32 %a, %b, %c
  return %result
}

// ====

func.def @scalar_nonadjacent(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %addend = scalar.mulf %c, %c : f32
  %result = scalar.addf<contract> %product, %addend : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_nonadjacent(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %addend = v_mul_f32 %c, %c
  %result = v_fma_f32 %a, %b, %addend
  return %result
}

// ====

func.def @scalar_multiuse(%a: f32, %b: f32, %c: f32) -> (f32, f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %product, %c : f32
  func.return %product, %result : f32, f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_multiuse(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %product = v_mul_f32 %a, %b
  %result = v_add_f32 %product, %c
  return %product, %result
}

// ====

func.def @scalar_one_flag(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf %product, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_one_flag(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %product = v_mul_f32 %a, %b
  %result = v_add_f32 %product, %c
  return %result
}

// ====

func.def @scalar_explicit(%a: f32, %b: f32, %c: f32) -> (f32) {
  %result = scalar.fmaf %a, %b, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_explicit(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_fma_f32 %a, %b, %c
  return %result
}

// ====

func.def @vector4_contract(%a: vector<4xf32>, %b: vector<4xf32>, %c: vector<4xf32>) -> (vector<4xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<4xf32>
  %result = vector.addf<contract> %product, %c : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @vector4_contract(%a: reg<amdgpu.vgpr x4>, %b: reg<amdgpu.vgpr x4>, %c: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %11 = slice %a[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = slice %b[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %13 = slice %c[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = v_fma_f32 %11, %12, %13
  %15 = slice %a[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = slice %b[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %c[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_fma_f32 %15, %16, %17
  %19 = slice %a[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = slice %b[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = slice %c[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = v_fma_f32 %19, %20, %21
  %23 = slice %a[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %24 = slice %b[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = slice %c[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %26 = v_fma_f32 %23, %24, %25
  %result = concat(%14, %18, %22, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

func.def @vector4_reduce(%a: vector<4xf32>, %b: vector<4xf32>, %c: f32) -> (f32) {
  %product = vector.mulf<contract> %a, %b : vector<4xf32>
  %result = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product, %c : vector<4xf32>, f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @vector4_reduce(%a: reg<amdgpu.vgpr x4>, %b: reg<amdgpu.vgpr x4>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %11 = slice %a[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = slice %b[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %13 = v_fma_f32 %11, %12, %c
  %14 = slice %a[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = slice %b[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_fmac_f32 %13, %14, %15
  %17 = slice %a[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = slice %b[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = v_fmac_f32 %16, %17, %18
  %20 = slice %a[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = slice %b[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %result = v_fmac_f32 %19, %20, %21
  return %result
}

// ====

func.def @vector16_contract(%a: vector<16xf32>, %b: vector<16xf32>, %c: vector<16xf32>) -> (vector<16xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<16xf32>
  %result = vector.addf<contract> %product, %c : vector<16xf32>
  func.return %result : vector<16xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @vector16_contract(%a: reg<amdgpu.vgpr x16>, %b: reg<amdgpu.vgpr x16>, %c: reg<amdgpu.vgpr x16>) -> (reg<amdgpu.vgpr x16>) asm {
  %11 = slice %a[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %12 = slice %b[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %13 = slice %c[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %14 = v_fma_f32 %11, %12, %13
  %15 = slice %a[1] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %16 = slice %b[1] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %17 = slice %c[1] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %18 = v_fma_f32 %15, %16, %17
  %19 = slice %a[2] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %20 = slice %b[2] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %21 = slice %c[2] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %22 = v_fma_f32 %19, %20, %21
  %23 = slice %a[3] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %24 = slice %b[3] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %25 = slice %c[3] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %26 = v_fma_f32 %23, %24, %25
  %27 = slice %a[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %28 = slice %b[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %29 = slice %c[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %30 = v_fma_f32 %27, %28, %29
  %31 = slice %a[5] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %32 = slice %b[5] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %33 = slice %c[5] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %34 = v_fma_f32 %31, %32, %33
  %35 = slice %a[6] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %36 = slice %b[6] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %37 = slice %c[6] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %38 = v_fma_f32 %35, %36, %37
  %39 = slice %a[7] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %40 = slice %b[7] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %41 = slice %c[7] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %42 = v_fma_f32 %39, %40, %41
  %43 = slice %a[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %44 = slice %b[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %45 = slice %c[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %46 = v_fma_f32 %43, %44, %45
  %47 = slice %a[9] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %48 = slice %b[9] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %49 = slice %c[9] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %50 = v_fma_f32 %47, %48, %49
  %51 = slice %a[10] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %52 = slice %b[10] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %53 = slice %c[10] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %54 = v_fma_f32 %51, %52, %53
  %55 = slice %a[11] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %56 = slice %b[11] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %57 = slice %c[11] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %58 = v_fma_f32 %55, %56, %57
  %59 = slice %a[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %60 = slice %b[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %61 = slice %c[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %62 = v_fma_f32 %59, %60, %61
  %63 = slice %a[13] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %64 = slice %b[13] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %65 = slice %c[13] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %66 = v_fma_f32 %63, %64, %65
  %67 = slice %a[14] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %68 = slice %b[14] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %69 = slice %c[14] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %70 = v_fma_f32 %67, %68, %69
  %71 = slice %a[15] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %72 = slice %b[15] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %73 = slice %c[15] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %74 = v_fma_f32 %71, %72, %73
  %result = concat(%14, %18, %22, %26, %30, %34, %38, %42, %46, %50, %54, %58, %62, %66, %70, %74) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x16>
