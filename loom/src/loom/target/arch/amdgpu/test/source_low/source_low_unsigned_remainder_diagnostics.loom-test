// RUN: emit source-low output=none

amdgpu.target<gfx11-generic> @target

func.def target(@target) @zero_divisor(%value: i32) -> (i32) {
  %c0 = scalar.constant 0 : i32
  // ERROR@+1: TARGET/003 {op_name="scalar.remui"}
  %result = scalar.remui %value, %c0 : i32
  func.return %result : i32
}

