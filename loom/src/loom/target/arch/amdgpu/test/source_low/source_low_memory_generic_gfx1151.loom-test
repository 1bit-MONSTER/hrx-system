// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_generic.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Generic pointers retain full-width dynamic addressing and byte origins.
kernel.def @generic_copy_i64() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source = buffer.assume.memory_space<generic> %input : buffer
  %target = buffer.assume.memory_space<generic> %output : buffer
  %source_origin = index.constant 16 : offset
  %target_origin = index.constant 8 : offset
  %source_view = buffer.view %source[%source_origin] : buffer -> view<64xi64>
  %target_view = buffer.view %target[%target_origin] : buffer -> view<64xi64>
  %lane = kernel.workitem.id<x> : index
  %value = view.load %source_view[%lane] : view<64xi64> -> i64
  view.store %value, %target_view[%lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @generic_copy_i64() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source_view = resource<hal_binding> {extent = 528, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_view = resource<hal_binding> {extent = 520, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = v_lshlrev_b32_src0_inline %lane, 3
  %16 = v_lshrrev_b32_src0_inline %lane, 29
  %17 = slice %source_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %source_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19, %20 = v_add_co_u32 %17, %15
  %21 = v_mov_b32_copy %18
  %22, %23 = v_add_co_ci_u32 %21, %16, %20
  %24 = concat(%19, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = flat_load_dwordx2 %24 {offset = 16}
  %28 = slice %target_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %target_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30, %31 = v_add_co_u32 %28, %15
  %32 = v_mov_b32_copy %29
  %33, %34 = v_add_co_ci_u32 %32, %16, %31
  %35 = concat(%30, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_b64 %35, %value {offset = 8}
  return
}

// ====

kernel.def @generic_copy_vector() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source = buffer.assume.memory_space<generic> %input : buffer
  %target = buffer.assume.memory_space<generic> %output : buffer
  %origin = index.constant 0 : offset
  %source_view = buffer.view %source[%origin] : buffer -> view<4xi32>
  %target_view = buffer.view %target[%origin] : buffer -> view<4xi32>
  %value = vector.load %source_view[0] : view<4xi32> -> vector<4xi32>
  vector.store %value, %target_view[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @generic_copy_vector() asm {
  %source_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = slice %source_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = slice %source_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = v_mov_b32_copy %11
  %14 = v_mov_b32_copy %12
  %15 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = flat_load_dwordx4 %15
  %17 = slice %target_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %target_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %17
  %20 = v_mov_b32_copy %18
  %21 = concat(%19, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_b128 %21, %value
  return
}

// ====

// Offsets beyond the packet immediate are added to the full pointer.
kernel.def @generic_copy_half() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source = buffer.assume.memory_space<generic> %input : buffer
  %target = buffer.assume.memory_space<generic> %output : buffer
  %source_origin = index.constant 65536 : offset
  %target_origin = index.constant 0 : offset
  %source_view = buffer.view %source[%source_origin] : buffer -> view<1xf16>
  %target_view = buffer.view %target[%target_origin] : buffer -> view<1xf16>
  %value = view.load %source_view[0] : view<1xf16> -> f16
  view.store %value, %target_view[0] : f16, view<1xf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @generic_copy_half() asm {
  %source_view = resource<hal_binding> {extent = 65538, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_view = resource<hal_binding> {extent = 2, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_mov_b32 65536
  %13 = s_mov_b32 0
  %15 = slice %source_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %source_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19, %20 = s_add_co_u32 %15, %12
  %21, %22 = s_addc_u32 %16, %13, %20
  %26 = v_mov_b32_copy %19
  %27 = v_mov_b32_copy %21
  %28 = concat(%26, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = flat_load_u16 %28
  %30 = slice %target_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = slice %target_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %30
  %33 = v_mov_b32_copy %31
  %34 = concat(%32, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_b16 %34, %value
  return
}
