  %wide_lane = concat(%317, %276) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^loop(%iterations: reg<amdgpu.sgpr>, %local_x: reg<amdgpu.vgpr x2>, %local_y: reg<amdgpu.vgpr x2>, %local_z: reg<amdgpu.vgpr x2>, %189: reg<amdgpu.sgpr>, %193: reg<amdgpu.sgpr>, %190: reg<amdgpu.sgpr>, %191: reg<amdgpu.sgpr>, %213: reg<amdgpu.sgpr>, %iterations: reg<amdgpu.sgpr>, %global_x: reg<amdgpu.vgpr x2>, %global_y: reg<amdgpu.vgpr x2>, %global_z: reg<amdgpu.vgpr x2>, %239: reg<amdgpu.sgpr>, %242: reg<amdgpu.sgpr>, %255: reg<amdgpu.sgpr>, %256: reg<amdgpu.sgpr>, %lane: reg<amdgpu.vgpr x2>)
^loop(%slot: reg<amdgpu.sgpr>, %bits_local_x: reg<amdgpu.vgpr x2>, %bits_local_y: reg<amdgpu.vgpr x2>, %bits_local_z: reg<amdgpu.vgpr x2>, %382: reg<amdgpu.sgpr>, %383: reg<amdgpu.sgpr>, %384: reg<amdgpu.sgpr>, %386: reg<amdgpu.sgpr>, %388: reg<amdgpu.sgpr>, %390: reg<amdgpu.sgpr>, %bits_global_x: reg<amdgpu.vgpr x2>, %bits_global_y: reg<amdgpu.vgpr x2>, %bits_global_z: reg<amdgpu.vgpr x2>, %392: reg<amdgpu.sgpr>, %394: reg<amdgpu.sgpr>, %396: reg<amdgpu.sgpr>, %397: reg<amdgpu.sgpr>, %bits_lane: reg<amdgpu.vgpr x2>):
