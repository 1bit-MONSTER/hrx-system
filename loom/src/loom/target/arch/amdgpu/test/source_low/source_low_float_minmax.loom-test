low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @scalar_f32_minmax_semantics(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %minnum = v_min_num_f32 %lhs, %rhs
  %maxnum = v_max_num_f32 %lhs, %rhs
  %minimum = v_minimum_f32 %lhs, %rhs
  %maximum = v_maximum_f32 %lhs, %rhs
  return %minnum, %maxnum, %minimum, %maximum
}

