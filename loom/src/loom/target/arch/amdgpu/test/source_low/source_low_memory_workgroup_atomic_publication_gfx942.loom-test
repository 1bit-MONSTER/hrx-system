low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_publish_seq_cst_cmpxchg(%value: reg<amdgpu.sgpr x2>) asm {
  %data = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = storage {byte_alignment = 8, byte_length = 8} : low.storage<workgroup>
  %flag = storage_address %17 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %19 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %19
  %21 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = v_mov_b32_copy %21
  %23 = concat(%20, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %24 = v_mov_b32 0
  global_store_dwordx2_saddr %24, %23, %data
  s_waitcnt {lgkmcnt = 0}
  %30 = concat(%24, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %35 = concat(%20, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old = ds_cmpst_rtn_b64 %flag, %30, %35
  s_waitcnt {lgkmcnt = 0}
  %observed = global_load_dwordx2_saddr %24, %data
  %39 = slice %old[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %40 = slice %old[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %41 = slice %observed[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %42 = slice %observed[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %43, %44 = v_add_co_u32 %39, %41
  %45, %46 = v_addc_co_u32 %40, %42, %44
  %sum = concat(%43, %45) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %24, %sum, %output
  return
}
