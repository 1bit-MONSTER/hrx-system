// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_workgroup_atomic_publication.loom-test
// RUN: emit source-low target=amdgpu:gfx942 output=low

// An LDS publication orders ordinary global payloads across memory paths.
kernel.def @lds_publish_release_reduce() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %value: i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi32>
  view.store %value, %data[0] : i32, view<1xi32>
  view.atomic.reduce<addi> %value, %flag[0] {ordering = release, scope = workgroup} : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_publish_release_reduce(%value: reg<amdgpu.sgpr>) asm {
  %data = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %10 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %flag = storage_address %10 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %12 = v_mov_b32_copy %value
  %13 = v_mov_b32 0
  global_store_dword_saddr %13, %12, %data
  s_waitcnt {lgkmcnt = 0}
  ds_add_u32 %flag, %12
  return
}

// ====

kernel.def @lds_publish_acquire_rmw() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %result: buffer, %value: i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %output = buffer.view %result[%origin] : buffer -> view<1xi32>
  %old = view.atomic.rmw<xchgi> %value, %flag[0] {ordering = acquire, scope = workgroup} : i32, view<1xi32> -> i32
  %observed = view.load %data[0] : view<1xi32> -> i32
  %sum = scalar.addi %old, %observed : i32
  view.store %sum, %output[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_publish_acquire_rmw(%value: reg<amdgpu.sgpr>) asm {
  %data = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %flag = storage_address %16 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %18 = v_mov_b32_copy %value
  %old = ds_wrxchg_rtn_b32 %flag, %18
  s_waitcnt {lgkmcnt = 0}
  %20 = v_mov_b32 0
  %observed = global_load_dword_saddr %20, %data
  %sum = v_add_u32 %old, %observed
  global_store_dword_saddr %20, %sum, %output
  return
}

// ====

kernel.def @lds_publish_seq_cst_cmpxchg() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %result: buffer, %value: i64) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi64>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi64>
  %output = buffer.view %result[%origin] : buffer -> view<1xi64>
  view.store %value, %data[0] : i64, view<1xi64>
  %expected = scalar.constant 0 : i64
  %old = view.atomic.cmpxchg %expected, %value, %flag[0] {failure_ordering = acquire, scope = workgroup, success_ordering = seq_cst} : i64, view<1xi64> -> i64
  %observed = view.load %data[0] : view<1xi64> -> i64
  %sum = scalar.addi %old, %observed : i64
  view.store %sum, %output[0] : i64, view<1xi64>
  kernel.return
}

