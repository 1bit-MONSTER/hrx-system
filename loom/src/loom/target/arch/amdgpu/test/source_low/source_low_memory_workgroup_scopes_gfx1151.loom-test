// Unused acquisition still completes before coherent payload reads.
kernel.def @unused_workgroup_acquire() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %word = buffer.view %signal[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xi32> -> i32
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
  kernel.return
}

