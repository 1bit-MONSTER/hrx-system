// The acquired word and following payload use independent memory roots.
kernel.def @consume_workgroup_load_f64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %signal: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %result_offset = index.constant 8 : offset
  %data = buffer.view %payload[%base] : buffer -> view<1xf64>
  %word = buffer.view %signal[%base] : buffer -> view<1xf64>
  %result = buffer.view %output[%base] : buffer -> view<1xf64>
  %observed_result = buffer.view %output[%result_offset] : buffer -> view<1xf64>
  %observed = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xf64> -> f64
  %value = view.load %data[0] : view<1xf64> -> f64
  view.store %value, %result[0] : f64, view<1xf64>
  view.store %observed, %observed_result[0] : f64, view<1xf64>
  kernel.return
}

