  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %word = buffer.view %generic[%base] : buffer -> view<1xi32>
  %data = buffer.view %payload[%base] : buffer -> view<1xi64>
  %result = buffer.view %output[%base] : buffer -> view<1xi64>
  %expected = scalar.constant 7 : i32
  %replacement = scalar.constant 9 : i32
  %observed = view.atomic.cmpxchg %expected, %replacement, %word[0] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %acquired = view.load %data[0] : view<1xi64> -> i64
  view.store %acquired, %result[0] : i64, view<1xi64>
  kernel.return
}

