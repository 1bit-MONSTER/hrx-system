  %data = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %word = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %17 = v_mov_b32_copy %value
  %18 = v_mov_b32 0
  global_store_b32_saddr %18, %17, %data
  %19 = v_mov_b32 7
  ds_write_b32 %18, %19
  s_waitcnt {vmcnt = 0, lgkmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
