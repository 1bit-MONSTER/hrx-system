// Publication releases preceding accesses through both global and local roots.
kernel.def @publish_workgroup_store_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %signal: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %local_bytes = index.constant 4 : offset
  %local_storage = buffer.alloca<workgroup> align(4) %local_bytes : buffer
  %local = buffer.view %local_storage[%base] : buffer -> view<1xi32>
  %data = buffer.view %payload[%base] : buffer -> view<1xi32>
  %word = buffer.view %signal[%base] : buffer -> view<1xi32>
  %marker = scalar.constant 7 : i32
  view.store %value, %data[0] : i32, view<1xi32>
  view.store %marker, %local[0] : i32, view<1xi32>
  view.atomic.store %value, %word[0] {ordering = release, scope = workgroup} : i32, view<1xi32>
  kernel.return
}

