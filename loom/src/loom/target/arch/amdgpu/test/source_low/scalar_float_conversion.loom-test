// TEMPLATE: loom/src/loom/test/corpus/source_low/scalar_float_conversion.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @convert_scalar_f64(%single: f32, %double: f64) -> (f64, f32) {
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  func.return %wide, %narrow : f64, f32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @convert_scalar_f64(%single: reg<amdgpu.vgpr>, %double: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>) asm {
  %wide = v_cvt_f64_f32 %single
  %narrow = v_cvt_f32_f64 %double
  return %wide, %narrow
}

// ====

kernel.def @floating_arguments() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%single: f32, %double: f64, %output: buffer) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<3xf32>
  %single_double = scalar.fptrunc %double : f64 to f32
  %wide = scalar.extf %single : f32 to f64
  %roundtrip = scalar.fptrunc %wide : f64 to f32
  view.store %single, %output_view[0] : f32, view<3xf32>
  view.store %single_double, %output_view[1] : f32, view<3xf32>
  view.store %roundtrip, %output_view[2] : f32, view<3xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 3, direct_arg_count = 2, direct_arg_names = {arg0 = "single", arg1 = "double"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 8], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @floating_arguments(%single: reg<amdgpu.sgpr>, %double: reg<amdgpu.sgpr x2>) asm {
  %output_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %single_double = v_cvt_f32_f64 %double
  %13 = v_mov_b32_copy %single
  %14 = v_mov_b32 0
  global_store_b32_saddr %14, %13, %output_view
  global_store_b32_saddr %14, %single_double, %output_view {offset = 4}
  global_store_b32_saddr %14, %13, %output_view {offset = 8}
  return
}

