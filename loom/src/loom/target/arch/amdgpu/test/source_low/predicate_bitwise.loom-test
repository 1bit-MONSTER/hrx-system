// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @predicate_bitwise_single(%lhs: vector<1xi1>, %rhs: vector<1xi1>) -> (vector<1xi1>, vector<1xi1>, vector<1xi1>) {
  %and_result = vector.andi %lhs, %rhs : vector<1xi1>
  %or_result = vector.ori %lhs, %rhs : vector<1xi1>
  %xor_result = vector.xori %lhs, %rhs : vector<1xi1>
  func.return %and_result, %or_result, %xor_result : vector<1xi1>, vector<1xi1>, vector<1xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_bitwise_single(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %and_result = s_and_b64 %lhs, %rhs
  %or_result = s_or_b64 %lhs, %rhs
  %xor_result = s_xor_b64 %lhs, %rhs
  return %and_result, %or_result, %xor_result
}

// ====

func.def @predicate_bitwise_four(%lhs: vector<4xi1>, %rhs: vector<4xi1>) -> (vector<4xi1>, vector<4xi1>, vector<4xi1>) {
  %and_result = vector.andi %lhs, %rhs : vector<4xi1>
  %or_result = vector.ori %lhs, %rhs : vector<4xi1>
  %xor_result = vector.xori %lhs, %rhs : vector<4xi1>
  func.return %and_result, %or_result, %xor_result : vector<4xi1>, vector<4xi1>, vector<4xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_bitwise_four(%lhs: reg<amdgpu.sgpr x8>, %rhs: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x8>, reg<amdgpu.sgpr x8>, reg<amdgpu.sgpr x8>) asm {
  %13 = slice %lhs[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %14 = slice %rhs[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %15 = s_and_b64 %13, %14
  %16 = slice %lhs[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %17 = slice %rhs[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %18 = s_and_b64 %16, %17
  %19 = slice %lhs[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %20 = slice %rhs[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %21 = s_and_b64 %19, %20
  %22 = slice %lhs[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %23 = slice %rhs[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %24 = s_and_b64 %22, %23
  %and_result = concat(%15, %18, %21, %24) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  %28 = s_or_b64 %13, %14
  %31 = s_or_b64 %16, %17
  %34 = s_or_b64 %19, %20
  %37 = s_or_b64 %22, %23
  %or_result = concat(%28, %31, %34, %37) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  %41 = s_xor_b64 %13, %14
  %44 = s_xor_b64 %16, %17
  %47 = s_xor_b64 %19, %20
  %50 = s_xor_b64 %22, %23
  %xor_result = concat(%41, %44, %47, %50) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  return %and_result, %or_result, %xor_result
}
