// ====

amdgpu.target<gfx942> @target

func.def target(@target) @authored_general_multiply_add(%lanes: vector<2xi32>, %factor: i32, %start: i32) -> (i32) {
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %result = scalar.fmai %lane, %factor, %start : i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @authored_general_multiply_add(%lanes: reg<amdgpu.vgpr x2>, %factor: reg<amdgpu.sgpr>, %start: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %lane = slice %lanes[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = v_mov_b32_copy %factor
  %14 = v_mul_lo_u32 %lane, %13
  %15 = v_mov_b32_copy %start
  %result = v_add_u32 %15, %14
  return %result
}
