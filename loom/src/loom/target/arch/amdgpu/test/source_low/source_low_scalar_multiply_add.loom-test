// RUN: with-checks pass target-legalize{mode=final},dce,canonicalize,source-to-low,low-select-operand-forms,low-cse,low-dce

amdgpu.target<gfx942> @target

func.def target(@target) @u24_inline_scale(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %lane = scalar.assume %lane_input [range(%lane_input, 0, 255)] : i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %lane, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_mad_u32_u24_src1_inline %lane, %start, 20
CHECK-NOT: *v_mov_b32_copy %start*
CHECK-NOT: *v_mul_lo_u32*
CHECK-NOT: *v_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @u24_inline_scale_all_vgpr(%lanes: vector<2xi32>) -> (i32) {
  %value_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %value = scalar.assume %value_input [range(%value_input, 0, 255)] : i32
  %addend = vector.extract %lanes[1] : vector<2xi32> -> i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %value, %scale : i32
  %result = scalar.addi %product, %addend : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_mad_u32_u24_src1_inline %value, %addend, 20
CHECK-NOT: *v_mov_b32_copy*
CHECK-NOT: *v_mul_lo_u32*
CHECK-NOT: *v_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @commuted_inline_scale_with_uniform_value(%value: i32, %lanes: vector<2xi32>) -> (i32) {
  %bounded = scalar.assume %value [range(%value, 0, 255)] : i32
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %scale, %bounded : i32
  %result = scalar.addi %product, %lane : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_mad_u32_u24_src0_inline %bounded, %lane, 20
CHECK-NOT: *v_mov_b32_copy %bounded*
CHECK-NOT: *v_mul_lo_u32*
CHECK-NOT: *v_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @uniform_u24_multiply_add(%value: i32, %start: i32) -> (i32) {
  %bounded = scalar.assume %value [range(%value, 0, 255)] : i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %bounded, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: %product = s_mulk_i32 %bounded, 20
CHECK: %result = s_add_u32 *, %start
CHECK-NOT: *v_mad_u32_u24*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @commuted_u24_inline_scale(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %lane = scalar.assume %lane_input [range(%lane_input, 0, 255)] : i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %scale, %lane : i32
  %result = scalar.addi %start, %product : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_mad_u32_u24_src0_inline %lane, %start, 20
CHECK-NOT: *v_mov_b32_copy %start*
CHECK-NOT: *v_mul_lo_u32*
CHECK-NOT: *v_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @power_of_two_scale(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %scale = scalar.constant 16 : i32
  %product = scalar.muli %lane, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_lshl_add_u32_shift_imm %lane, %start, 4
CHECK-NOT: *v_lshlrev_b32*
CHECK-NOT: *v_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @unit_scale_canonicalizes(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %scale = scalar.constant 1 : i32
  %product = scalar.muli %lane, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_add_u32 %lane, *
CHECK-NOT: *v_lshl_add_u32*
CHECK-NOT: *v_mad_u32_u24*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @power_of_two_scale_with_uniform_value(%value: i32, %lanes: vector<2xi32>) -> (i32) {
  %bounded = scalar.assume %value [range(%value, 0, 255)] : i32
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %scale = scalar.constant 16 : i32
  %product = scalar.muli %scale, %bounded : i32
  %result = scalar.addi %product, %lane : i32
  func.return %result : i32
}

// ----
CHECK: %result = v_lshl_add_u32_shift_imm %bounded, %lane, 4
CHECK-NOT: *v_mov_b32_copy %bounded*
CHECK-NOT: *v_lshlrev_b32*
CHECK-NOT: *v_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @non_inline_u24_scale(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %lane = scalar.assume %lane_input [range(%lane_input, 0, 255)] : i32
  %scale = scalar.constant 80 : i32
  %product = scalar.muli %lane, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: * = v_mul_lo_u32 %lane, *
CHECK: %result = v_add_u32 *, *
CHECK-NOT: *v_mad_u32_u24*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @general_multiply_add(%lanes: vector<2xi32>, %factor: i32, %start: i32) -> (i32) {
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %product = scalar.muli %lane, %factor : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: * = v_mul_lo_u32 %lane, *
CHECK: %result = v_add_u32 *, *
CHECK-NOT: *v_mad_u32_u24*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @flagged_multiply(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %lane = scalar.assume %lane_input [range(%lane_input, 0, 255)] : i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli<nuw> %lane, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: *v_mul_lo_u32*
CHECK: %result = v_add_u32 *, *
CHECK-NOT: *v_mad_u32_u24*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @flagged_add(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %lane = scalar.assume %lane_input [range(%lane_input, 0, 255)] : i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %lane, %scale : i32
  %result = scalar.addi<nsw> %product, %start : i32
  func.return %result : i32
}

// ----
CHECK: *v_mul_lo_u32*
CHECK: %result = v_add_u32 *, *
CHECK-NOT: *v_mad_u32_u24*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @authored_general_multiply_add(%lanes: vector<2xi32>, %factor: i32, %start: i32) -> (i32) {
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %result = scalar.fmai %lane, %factor, %start : i32
  func.return %result : i32
}

// ----
CHECK: * = v_mul_lo_u32 %lane, *
CHECK: %result = v_add_u32 *, *
CHECK-NOT: *v_mad_u32_u24*
