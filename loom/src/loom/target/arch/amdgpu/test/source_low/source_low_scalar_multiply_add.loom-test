amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @u24_inline_scale_all_vgpr(%lanes: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %value = slice %lanes[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %addend = slice %lanes[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_mad_u32_u24_src1_inline %value, %addend, 20
  return %result
}

