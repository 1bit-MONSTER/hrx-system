// RUN: pass target-legalize{mode=final},dce,canonicalize,source-to-low,low-select-operand-forms,low-cse,low-dce

amdgpu.target<gfx942> @target

func.def target(@target) @u24_inline_scale(%lanes: vector<2xi32>, %start: i32) -> (i32) {
  %lane_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %lane = scalar.assume %lane_input [range(%lane_input, 0, 255)] : i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %lane, %scale : i32
  %result = scalar.addi %product, %start : i32
  func.return %result : i32
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @u24_inline_scale(%lanes: reg<amdgpu.vgpr x2>, %start: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %lane = slice %lanes[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_mad_u32_u24_src1_inline %lane, %start, 20
  return %result
}

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @u24_inline_scale_all_vgpr(%lanes: vector<2xi32>) -> (i32) {
  %value_input = vector.extract %lanes[0] : vector<2xi32> -> i32
  %value = scalar.assume %value_input [range(%value_input, 0, 255)] : i32
  %addend = vector.extract %lanes[1] : vector<2xi32> -> i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %value, %scale : i32
  %result = scalar.addi %product, %addend : i32
  func.return %result : i32
}

