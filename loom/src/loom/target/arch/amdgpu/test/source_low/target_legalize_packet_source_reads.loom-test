amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @preserve_volatile_reduction() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %destination: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<36xf32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<1xf32>
  %observed = vector.load<volatile> %source_view[0] : view<36xf32> -> vector<36xf32>
  %initial = scalar.constant 0.0 : f32
  %sum = vector.reduce<addf> %observed, %initial : vector<36xf32>, f32
  view.store %sum, %destination_view[0] : f32, view<1xf32>
  kernel.return
}

