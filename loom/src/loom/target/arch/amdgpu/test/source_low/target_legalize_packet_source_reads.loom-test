amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @preserve_outer_read() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %destination: buffer, %count: index, %replacement: f32) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<36xf32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<36xf32>
  %old = vector.load %source_view[0] : view<36xf32> -> vector<36xf32>
  %lower = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %iteration = [%lower to %count step %step] {
    view.store %replacement, %source_view[0] : f32, view<36xf32>
    vector.store %old, %destination_view[0] : vector<36xf32>, view<36xf32>
  }
  kernel.return
}

