amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @preserve_unpacketized_source_type() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %destination: buffer, %replacement: f16) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<36xf16>
  %destination_view = buffer.view %destination[%base] : buffer -> view<36xf32>
  %old = vector.load %source_view[0] : view<36xf16> -> vector<36xf16>
  %extended = vector.extf %old : vector<36xf16> to vector<36xf32>
  view.store %replacement, %source_view[0] : f16, view<36xf16>
  vector.store %extended, %destination_view[0] : vector<36xf32>, view<36xf32>
  kernel.return
}

