amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @preserve_volatile_reduction() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %destination: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<36xf32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<1xf32>
  %9 = vector.load<volatile> %source_view[0] : view<36xf32> -> vector<4xf32>
  %10 = vector.load<volatile> %source_view[4] : view<36xf32> -> vector<4xf32>
  %11 = vector.load<volatile> %source_view[8] : view<36xf32> -> vector<4xf32>
  %12 = vector.load<volatile> %source_view[12] : view<36xf32> -> vector<4xf32>
  %13 = vector.load<volatile> %source_view[16] : view<36xf32> -> vector<4xf32>
  %14 = vector.load<volatile> %source_view[20] : view<36xf32> -> vector<4xf32>
  %15 = vector.load<volatile> %source_view[24] : view<36xf32> -> vector<4xf32>
  %16 = vector.load<volatile> %source_view[28] : view<36xf32> -> vector<4xf32>
  %17 = vector.load<volatile> %source_view[32] : view<36xf32> -> vector<4xf32>
  %initial = scalar.constant 0.0 : f32
  %19 = vector.reduce<addf> %9, %initial : vector<4xf32>, f32
  %20 = vector.reduce<addf> %10, %19 : vector<4xf32>, f32
  %21 = vector.reduce<addf> %11, %20 : vector<4xf32>, f32
  %22 = vector.reduce<addf> %12, %21 : vector<4xf32>, f32
  %23 = vector.reduce<addf> %13, %22 : vector<4xf32>, f32
  %24 = vector.reduce<addf> %14, %23 : vector<4xf32>, f32
  %25 = vector.reduce<addf> %15, %24 : vector<4xf32>, f32
  %26 = vector.reduce<addf> %16, %25 : vector<4xf32>, f32
  %sum = vector.reduce<addf> %17, %26 : vector<4xf32>, f32
  view.store %sum, %destination_view[0] : f32, view<1xf32>
