// RUN: pass target-legalize{mode=final,policy=require-native}

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @preserve_overwritten_read() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %destination0: buffer, %destination1: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<36xf32>
  %destination0_view = buffer.view %destination0[%base] : buffer -> view<36xf32>
  %destination1_view = buffer.view %destination1[%base] : buffer -> view<36xf32>
  %old = vector.load %source_view[0] : view<36xf32> -> vector<36xf32>
  %replacement_scalar = scalar.constant 2.0 : f32
  %replacement = vector.splat %replacement_scalar : vector<36xf32>
  vector.store %replacement, %source_view[0] : vector<36xf32>, view<36xf32>
  vector.store %old, %destination0_view[0] : vector<36xf32>, view<36xf32>
  vector.store %old, %destination1_view[0] : vector<36xf32>, view<36xf32>
  kernel.return
}

