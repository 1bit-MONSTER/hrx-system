amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @preserve_overwritten_read() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %destination0: buffer, %destination1: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<36xf32>
  %destination0_view = buffer.view %destination0[%base] : buffer -> view<36xf32>
  %destination1_view = buffer.view %destination1[%base] : buffer -> view<36xf32>
  %11 = vector.load %source_view[0] : view<36xf32> -> vector<4xf32>
  %12 = vector.load %source_view[4] : view<36xf32> -> vector<4xf32>
  %13 = vector.load %source_view[8] : view<36xf32> -> vector<4xf32>
  %14 = vector.load %source_view[12] : view<36xf32> -> vector<4xf32>
  %15 = vector.load %source_view[16] : view<36xf32> -> vector<4xf32>
  %16 = vector.load %source_view[20] : view<36xf32> -> vector<4xf32>
  %17 = vector.load %source_view[24] : view<36xf32> -> vector<4xf32>
  %18 = vector.load %source_view[28] : view<36xf32> -> vector<4xf32>
  %19 = vector.load %source_view[32] : view<36xf32> -> vector<4xf32>
  %replacement_scalar = scalar.constant 2.0 : f32
  %21 = index.constant 0 : index
  %22 = index.constant 36 : index
  %23 = index.constant 4 : index
  scf.for %24 = [%21 to %22 step %23] {
    %25 = vector.splat %replacement_scalar : vector<4xf32>
    vector.store %25, %source_view[%24] : vector<4xf32>, view<36xf32>
  }
  vector.store %11, %destination0_view[0] : vector<4xf32>, view<36xf32>
  vector.store %12, %destination0_view[4] : vector<4xf32>, view<36xf32>
  vector.store %13, %destination0_view[8] : vector<4xf32>, view<36xf32>
  vector.store %14, %destination0_view[12] : vector<4xf32>, view<36xf32>
  vector.store %15, %destination0_view[16] : vector<4xf32>, view<36xf32>
  vector.store %16, %destination0_view[20] : vector<4xf32>, view<36xf32>
  vector.store %17, %destination0_view[24] : vector<4xf32>, view<36xf32>
  vector.store %18, %destination0_view[28] : vector<4xf32>, view<36xf32>
  vector.store %19, %destination0_view[32] : vector<4xf32>, view<36xf32>
  vector.store %11, %destination1_view[0] : vector<4xf32>, view<36xf32>
  vector.store %12, %destination1_view[4] : vector<4xf32>, view<36xf32>
  vector.store %13, %destination1_view[8] : vector<4xf32>, view<36xf32>
  vector.store %14, %destination1_view[12] : vector<4xf32>, view<36xf32>
  vector.store %15, %destination1_view[16] : vector<4xf32>, view<36xf32>
  vector.store %16, %destination1_view[20] : vector<4xf32>, view<36xf32>
  vector.store %17, %destination1_view[24] : vector<4xf32>, view<36xf32>
  vector.store %18, %destination1_view[28] : vector<4xf32>, view<36xf32>
  vector.store %19, %destination1_view[32] : vector<4xf32>, view<36xf32>
  kernel.return
}

