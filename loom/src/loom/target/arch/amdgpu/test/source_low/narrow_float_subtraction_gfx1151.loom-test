func.def @subtract_f16_1(%lhs: f16, %rhs: f16) -> (f16) {
  %difference = scalar.subf %lhs, %rhs : f16
  func.return %difference : f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @subtract_f16_1(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %difference = v_sub_f16 %lhs, %rhs
  %8 = v_bfe_u32_offset_0_width_16_low16 %difference
  return %8
}

