0xDD090000
0x04000200
0xDF090000
0x05000200
0xBF810000

// ====
// RUN: emit amdgpu-native-words @flat_cmpxchg waits=none strategy=source fixed=%address:physical_register:0:2 fixed=%pair:physical_register:4:4 fixed=%device:physical_register:8:2 fixed=%system:physical_register:10:2

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @flat_cmpxchg(%address: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.vgpr x4>) asm {
  %device = flat_atomic_cmpswap_x2_rtn %address, %pair : reg<amdgpu.vgpr x2>
  %system = flat_atomic_cmpswap_x2_rtn %address, %pair {sc1 = 1} : reg<amdgpu.vgpr x2>
  return
}

