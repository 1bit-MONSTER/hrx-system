// SC1 selects system coherence independently of SC0 return control. These
// words match LLVM MC on gfx942 and gfx950, including device-scope defaults.
// RUN: emit amdgpu-native-words @global_reduce waits=none strategy=source fixed=%offset:physical_register:0:1 fixed=%value:physical_register:1:1 fixed=%address:physical_register:0:2

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @global_reduce(%offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %address: reg<amdgpu.sgpr x2>) asm {
  global_atomic_add_saddr %offset, %value, %address
  global_atomic_add_saddr %offset, %value, %address {sc1 = 1}
  return
}

// ----
0xDD088000
0x00000100
0xDF088000
0x00000100
0xBF810000

// ====
// RUN: emit amdgpu-native-words @global_rmw waits=none strategy=source fixed=%offset:physical_register:0:1 fixed=%value:physical_register:2:2 fixed=%address:physical_register:0:2 fixed=%device:physical_register:4:2 fixed=%system:physical_register:6:2

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @global_rmw(%offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %address: reg<amdgpu.sgpr x2>) asm {
  %device = global_atomic_add_x2_rtn_saddr %offset, %value, %address : reg<amdgpu.vgpr x2>
  %system = global_atomic_add_x2_rtn_saddr %offset, %value, %address {sc1 = 1} : reg<amdgpu.vgpr x2>
  return
}

// ----
0xDD898000
0x04000200
0xDF898000
0x06000200
0xBF810000

// ====
// RUN: emit amdgpu-native-words @flat_rmw waits=none strategy=source fixed=%address:physical_register:0:2 fixed=%value:physical_register:2:1 fixed=%device:physical_register:4:1 fixed=%system:physical_register:5:1

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @flat_rmw(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) asm {
  %device = flat_atomic_add_rtn %address, %value : reg<amdgpu.vgpr>
  %system = flat_atomic_add_rtn %address, %value {sc1 = 1} : reg<amdgpu.vgpr>
  return
}

