// RUN: emit amdgpu-assembly @reuse strategy=source fixed=%mask:physical_register:0:2 fixed=%replacement:physical_register:0:2 fixed=%source:physical_register:4:2

// Scalar overwrite drains only scalar destinations before address arithmetic.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// Wave32 does not have the mask reuse hazard.
amdgpu.target<gfx1151> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// An ordinary scalar VALU source does not establish a lane-mask read.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %word = slice %mask[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %selected = v_mov_b32_copy %word
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_mov_b32_copy v0, s0
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// VALU overwrite uses va_sdst instead of a full ALU drain.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %replacement = v_cmp_eq_i32 %value, %value
  %again = v_cndmask_b32_src0_inline %selected, %replacement {false_value = 0}
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, s[0:1]
  v_cmp_eq_i32 s[0:1], v0, v0
  s_waitcnt_depctr 0xf19f
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_cndmask_b32 v0, 0, v1, s[0:1]
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_endpgm

// ====
// A fallthrough block retains the predecessor mask read.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^consume
^consume:
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
.Lbb1:
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// The join precedes its mask-reading predecessor in layout order.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) asm {
  low.cond_br %condition, ^read_mask, ^skip : reg<amdgpu.scc>
^skip:
  low.br ^join
^join:
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
^read_mask:
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^join
}

// ----
  s_cbranch_scc1 .Lbb3
.Lbb1:
.Lbb2:
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm
.Lbb3:
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_branch .Lbb2

// ====
// RUN: emit amdgpu-assembly @reuse strategy=source fixed=%replacement:physical_register:0:2 fixed=%source:physical_register:4:2

// A loop header sees a mask read arriving from its backedge.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^header
^header:
  %replacement = s_or_b64 %source, %source
  low.br ^body
^body:
  %chosen = v_cndmask_b32_src0_inline %value, %replacement {false_value = 0}
  low.br ^header
}

// ----
.Lbb1:
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
.Lbb2:
  v_cndmask_b32 v1, 0, v0, s[0:1]
  s_branch .Lbb1

// ====
// Carry inputs are lane masks, including when the result has another mask.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %sum, %carry = v_add_co_ci_u32 %value, %value, %mask
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_add_co_ci_u32 v0, s[0:1], v0, v0, s[0:1]
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// Borrow inputs share the mask hazard contract.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %difference, %borrow = v_sub_co_ci_u32 %value, %value, %mask
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_sub_co_ci_u32 v0, s[0:1], v0, v0, s[0:1]
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// A resolved copy waits after each overwritten mask DWORD.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %replacement = copy %source : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_mov_b32 s0, s4
  s_waitcnt_depctr 0xff9e
  s_mov_b32 s1, s5
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// An edge copy waits inside the predecessor before the branch.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^consume(%source: reg<amdgpu.sgpr x2>)
^consume(%replacement: reg<amdgpu.sgpr x2>):
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_mov_b32 s0, s4
  s_waitcnt_depctr 0xff9e
  s_mov_b32 s1, s5
  s_waitcnt_depctr 0xff9e
.Lbb1:
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @rotate strategy=source fixed=%seed:physical_register:0:2 fixed=%current:physical_register:0:2

// The backedge rotates mask DWORDs through allocator-generated copies.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @rotate(%value: reg<amdgpu.vgpr>, %seed: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%seed: reg<amdgpu.sgpr x2>)
^loop(%current: reg<amdgpu.sgpr x2>):
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^loop(%swapped: reg<amdgpu.sgpr x2>)
}

// ----
.Lbb1:
  v_cndmask_b32 v1, 0, v0, s[0:1]
  s_mov_b32 s3, s0
  s_mov_b32 s2, s1
  s_mov_b32 s0, s2
  s_waitcnt_depctr 0xff9e
  s_mov_b32 s1, s3
  s_waitcnt_depctr 0xff9e
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @reuse strategy=source

// VALU VCC overwrites select their own dependency field.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %replacement = v_cmp_eq_i32_src0_inline_vcc %value {lhs = 0}
  %again = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, vcc
  v_cmp_eq_i32 vcc, 0, v0
  s_waitcnt_depctr 0xff9d
  s_delay_alu instid0(VALU_DEP_2)
  v_cndmask_b32 v0, 0, v1, vcc
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @reuse strategy=source

// SALU VCC overwrites select their own dependency field.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %replacement = s_mov_b32_vcc_imm 1
  %again = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, vcc
  s_mov_b32 vcc_lo, 1
  s_waitcnt_depctr 0xff9e
  s_delay_alu instid0(VALU_DEP_1)
  v_cndmask_b32 v0, 0, v0, vcc
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @swap strategy=source fixed=%lhs:physical_register:1:1 fixed=%rhs:physical_register:0:1 fixed=%returned:physical_register:0:2

// A reversed pair requires a resolved parallel-copy cycle on its return edge.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @swap(%value: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %mask = concat(%rhs, %lhs) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %pair = concat(%lhs, %rhs) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^exit(%pair: reg<amdgpu.sgpr x2>)
^exit(%returned: reg<amdgpu.sgpr x2>):
  return %returned
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_mov_b32 s2, s0
  s_mov_b32 s0, s1
  s_waitcnt_depctr 0xff9e
  s_mov_b32 s1, s2
  s_waitcnt_depctr 0xff9e
.Lbb1:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @partial_vcc strategy=source

// Writing vcc_lo leaves the prior high-half mask read relevant to a later
// full-mask overwrite even without an intervening predicate use.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @partial_vcc(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %partial = s_mov_b32_vcc_imm 1
  %replacement = v_cmp_eq_i32_src0_inline_vcc %value {lhs = 0}
  %again = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, vcc
  s_mov_b32 vcc_lo, 1
  s_waitcnt_depctr 0xff9e
  v_cmp_eq_i32 vcc, 0, v0
  s_waitcnt_depctr 0xff9d
  s_delay_alu instid0(VALU_DEP_2)
  v_cndmask_b32 v0, 0, v1, vcc
  s_endpgm
