amdgpu.target<gfx11-generic> @target

func.def target(@target) @narrow_comparison(%input: i32, %other: i32) -> (i32) {
  %small = scalar.trunci %input : i32 to i16
  %wide = scalar.extsi %small : i16 to i32
  %condition = scalar.cmpi slt, %wide, %other : i32
  %result = scf.select %condition, %wide, %other : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_comparison(%input: reg<amdgpu.sgpr>, %other: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %small = v_mov_b32_copy %input
  %wide = v_bfe_i32_offset_width_inline %small {offset = 0, width = 16}
  %13 = v_mov_b32_copy %other
  %result = v_min_i32 %wide, %13
  return %result
}

