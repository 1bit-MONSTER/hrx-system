amdgpu.target<gfx11-generic> @target

func.def target(@target) @bitcast_f16_select_signed(%lhs: f16, %rhs: f16, %condition: i1) -> (i32) {
  %lhs_bits = scalar.bitcast %lhs : f16 to i16
  %rhs_bits = scalar.bitcast %rhs : f16 to i16
  %selected = scf.select %condition, %lhs_bits, %rhs_bits : i16
  %result = scalar.extsi %selected : i16 to i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @bitcast_f16_select_signed(%lhs_bits: reg<amdgpu.vgpr>, %rhs_bits: reg<amdgpu.vgpr>, %condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %selected = v_cndmask_b32 %rhs_bits, %lhs_bits, %condition
  %result = v_bfe_i32_offset_width_inline %selected {offset = 0, width = 16}
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @bitcast_f16_select_constant_unsigned(%input: f16, %condition: i1) -> (i32, f32) {
  %bits = scalar.bitcast %input : f16 to i16
  %fallback = scalar.constant -1 : i16
  %selected = scf.select %condition, %bits, %fallback : i16
  %integer = scalar.extui %selected : i16 to i32
  %floating = scalar.uitofp %selected : i16 to f32
  func.return %integer, %floating : i32, f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @bitcast_f16_select_constant_unsigned(%bits: reg<amdgpu.vgpr>, %condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fallback = v_mov_b32 4294967295
  %selected = v_cndmask_b32 %fallback, %bits, %condition
  %integer = v_and_b32_lit %selected, 65535
  %floating = v_cvt_f32_u32 %integer
  return %integer, %floating
}

