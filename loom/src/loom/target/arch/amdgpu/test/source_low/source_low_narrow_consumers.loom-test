  %small = v_mov_b32_copy %input
  %9 = v_and_b32_lit %small, 255
  %10 = v_mov_b32 0
  %12 = s_mov_b32 1
  %13 = s_mov_b32 0
  %16 = v_mov_b32_copy %12
  %18 = v_mov_b32_copy %13
  %24, %25 = v_add_co_u32 %9, %16
  %26, %27 = v_add_co_ci_u32 %10, %18, %25
  %result = concat(%24, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

