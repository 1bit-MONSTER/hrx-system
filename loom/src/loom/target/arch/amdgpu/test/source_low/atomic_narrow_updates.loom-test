// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_narrow_updates.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

func.def @narrow_i8(%input: buffer, %update: i8) -> (i8) {
  %origin = index.constant 1 : offset
  %bytes = index.constant 3 : offset
  %storage = buffer.alloca<workgroup> align(1) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi8>
  %old = view.atomic.rmw<subi> %update, %cell[0] {ordering = acq_rel, scope = system} : i8, view<1xi8> -> i8
  func.return %old : i8
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: * = ds_cmpst_rtn_b32 *
CHECK: * = v_cndmask_b32 *
CHECK: *low.cond_br *
CHECK: * = v_cmp_ne_i32 *

// ====

func.def @narrow_i16(%input: buffer, %update: i16) -> (i16) {
  %origin = index.constant 2 : offset
  %storage = buffer.assume.memory_space<global> %input : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi16>
  %old = view.atomic.rmw<minui> %update, %cell[0] {ordering = acq_rel, scope = device} : i16, view<1xi16> -> i16
  func.return %old : i16
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: * = flat_atomic_cmpswap_b32_rtn *
CHECK: * = v_cndmask_b32 *
CHECK: *low.cond_br *
CHECK: * = v_cmp_ne_i32 *

// ====

func.def @narrow_f16(%input: buffer, %update: f16) -> (f16) {
  %origin = index.constant 2 : offset
  %storage = buffer.assume.memory_space<generic> %input : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xf16>
  %old = view.atomic.rmw<addf, noftz> %update, %cell[0] {ordering = acq_rel, scope = system} : f16, view<1xf16> -> f16
  func.return %old : f16
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: * = flat_atomic_cmpswap_b32_rtn *
CHECK: * = v_cndmask_b32 *
CHECK: *low.cond_br *
CHECK: * = v_cmp_ne_i32 *

