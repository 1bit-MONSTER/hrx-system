  %storage = buffer.assume.memory_space<global> %input : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xbf16>
  %old = view.atomic.rmw<xchgf> %update, %cell[0] {ordering = acq_rel, scope = subgroup} : bf16, view<1xbf16> -> bf16
