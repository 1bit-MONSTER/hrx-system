  %value = global_load_b32_saddr %13, %source
  %15 = v_and_b32_src0_inline %item, 31
  %16 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %17 = storage_address %16 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %18 = v_mov_b32 32
  %19 = v_cmp_ge_u32 %item, %18
  %21 = v_mov_b32 1
  %22 = v_cndmask_b32 %18, %21, %19
  %24 = v_add_u32 %15, %21
  %25 = v_cmp_lt_u32 %24, %22
  %26 = v_lshlrev_b32_src0_inline %24, 2
  %27 = v_mov_b32 2
  %28 = v_add_u32 %15, %27
  %29 = v_cmp_lt_u32 %28, %22
  %30 = v_lshlrev_b32_src0_inline %28, 2
  %31 = v_mov_b32 4
  %32 = v_add_u32 %15, %31
  %33 = v_cmp_lt_u32 %32, %22
  %34 = v_lshlrev_b32_src0_inline %32, 2
  %35 = v_mov_b32 8
  %36 = v_add_u32 %15, %35
  %37 = v_cmp_lt_u32 %36, %22
  %38 = v_lshlrev_b32_src0_inline %36, 2
  %39 = v_mov_b32 16
  %40 = v_add_u32 %15, %39
  %41 = v_cmp_lt_u32 %40, %22
  %42 = v_lshlrev_b32_src0_inline %40, 2
  %43 = ds_bpermute_b32 %26, %value
  %44 = v_min_f32 %value, %43
  %45 = v_cndmask_b32 %value, %44, %25
  %46 = ds_bpermute_b32 %30, %45
  %47 = v_min_f32 %45, %46
  %48 = v_cndmask_b32 %45, %47, %29
  %49 = ds_bpermute_b32 %34, %48
  %50 = v_min_f32 %48, %49
  %51 = v_cndmask_b32 %48, %50, %33
  %52 = ds_bpermute_b32 %38, %51
  %53 = v_min_f32 %51, %52
  %54 = v_cndmask_b32 %51, %53, %37
  %55 = ds_bpermute_b32 %42, %54
  %56 = v_min_f32 %54, %55
  %57 = v_cndmask_b32 %54, %56, %41
  %58 = ds_bpermute_b32 %26, %57
  %59 = v_mov_b32 2139095040
  %60 = v_cndmask_b32 %59, %58, %25
  %61 = v_lshrrev_b32_src0_inline %item, 5
  %62 = v_lshlrev_b32_src0_inline %61, 2
  %63 = v_mov_b32 1
  %64 = v_cmp_lt_u32 %15, %63
  %65, %66 = s_and_saveexec_b64 %64
  %67 = v_add_u32 %17, %62
  ds_write_b32 %67, %57
  s_mov_b64_exec %65
  s_barrier
  %68 = v_mov_b32 0
  %69 = v_add_u32 %17, %68
  %70 = v_add_u32_src0_inline %69, 4
  %71 = ds_read_b32 %70
  %72 = v_mov_b32 32
  %73 = v_cmp_lt_u32 %item, %72
  %74 = v_min_f32 %60, %71
  %75 = v_cndmask_b32 %71, %74, %25
  %prefix = v_cndmask_b32 %60, %75, %73
  %77 = v_lshlrev_b32_src0_inline %item, 2
  global_store_b32_saddr %77, %prefix, %destination
