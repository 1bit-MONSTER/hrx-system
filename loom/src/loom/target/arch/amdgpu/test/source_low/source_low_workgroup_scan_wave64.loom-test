low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(33, 1, 1) workgroup_count(1, 1, 1) @workgroup_scan_reverse_partial_minimum() asm {
  %item = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 132, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 132, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
