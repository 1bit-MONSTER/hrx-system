// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_offset_narrowing.loom-test
// RUN: emit source-low target=amdgpu:gfx1100 output=low

func.def @native_origin(%origin: offset, %position: i32) -> (offset) {
  %position_wide = scalar.extsi %position : i32 to i64
  %element_bytes = scalar.constant 4 : i64
  %displacement = scalar.muli %position_wide, %element_bytes : i64
  %origin_wide = index.cast %origin : offset to i64
  %sum = scalar.addi %origin_wide, %displacement : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result : offset
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @native_origin(%origin_wide: reg<amdgpu.sgpr x2>, %position: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %15 = s_ashr_i32_rhs_inline %position, 31
  %position_wide = concat(%position, %15) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %17 = s_mov_b32 2
  %displacement = s_lshl_b64 %position_wide, %17
  %22 = slice %origin_wide[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %displacement[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26, %27 = s_add_co_u32 %22, %24
  return %26
}

// ====

func.def @unsigned_half_origin(%input: i32) -> (offset, i64) {
  %word = scalar.assume %input [range(%input, 0, 2147483647)] : i32
  %extended = scalar.extui %word : i32 to i64
  %bias = scalar.constant 2147483648 : i64
  %sum = scalar.addi %extended, %bias : i64
  %result = index.cast %sum : i64 to offset
  %roundtrip = index.cast %result : offset to i64
  func.return %result, %roundtrip : offset, i64
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @unsigned_half_origin(%word: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) asm {
  %14 = s_mov_b32 2147483648
  %21, %22 = s_add_co_u32 %word, %14
  %27 = s_mov_b32 0
  %roundtrip = concat(%21, %27) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %21, %roundtrip
}

// ====

func.def @observed_origin(%input: i32, %origin: i64) -> (offset, i64) {
  %extended = scalar.extui %input : i32 to i64
  %sum = scalar.addi %origin, %extended : i64
  %bounded = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result = index.cast %bounded : i64 to offset
  func.return %result, %sum : offset, i64
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @observed_origin(%input: reg<amdgpu.sgpr>, %origin: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) asm {
  %12 = s_mov_b32 0
  %14 = slice %origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %origin[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18, %19 = s_add_co_u32 %14, %input
  %20, %21 = s_addc_u32 %15, %12, %19
  %bounded = concat(%18, %20) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %18, %bounded
}
