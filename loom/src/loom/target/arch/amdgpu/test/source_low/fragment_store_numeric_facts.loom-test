amdgpu.target<gfx1100> @target {subgroup_size = 32}

kernel.def target(@target) @rdna_non_nan() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%value: f32, %output: buffer) {
  %extent = index.constant 16 : index
  %non_nan = scalar.assume %value [not_nan(%value)] : f32
  %payload = vector.splat %non_nan : vector<8xf32>
  %fragment = vector.fragment<result> %payload shape [%extent, %extent] : vector<8xf32>
  %base = index.constant 0 : offset
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %output_view = buffer.view %output_global[%base] : buffer -> view<16x16xbf16>
  vector.fragment.store<result> %fragment, %output_view[0, 0] shape [%extent, %extent] : vector<8xf32>, view<16x16xbf16>
  kernel.return
}

