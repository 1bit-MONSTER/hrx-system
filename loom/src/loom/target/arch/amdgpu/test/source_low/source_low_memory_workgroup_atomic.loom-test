  %old_release = view.atomic.rmw<addi> %increment, %scratch_view[%tid] {ordering = release, scope = workgroup} : i32, view<64xi32> -> i32
  %old_acq_rel = view.atomic.rmw<addi> %increment, %scratch_view[%tid] {ordering = acq_rel, scope = workgroup} : i32, view<64xi32> -> i32
  %old_seq_cst = view.atomic.rmw<addi> %increment, %scratch_view[%tid] {ordering = seq_cst, scope = workgroup} : i32, view<64xi32> -> i32
