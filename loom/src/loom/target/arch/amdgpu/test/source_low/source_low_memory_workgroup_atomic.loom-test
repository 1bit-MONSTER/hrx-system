kernel.def @lds_atomic_bitwise_i32() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %tid = kernel.workitem.id<x> : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<64xi32>
  %mask = scalar.constant 255 : i32
  view.atomic.reduce<andi> %mask, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  view.atomic.reduce<ori> %mask, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  view.atomic.reduce<xori> %mask, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  %old_and = view.atomic.rmw<andi> %mask, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32> -> i32
  %old_or = view.atomic.rmw<ori> %mask, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32> -> i32
  %old_xor = view.atomic.rmw<xori> %mask, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32> -> i32
  kernel.return
}

