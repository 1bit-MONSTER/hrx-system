func.def @exchange_nonnegative_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %bounded_position = index.assume %position [range(%position, 0, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %bounded_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @exchange_nonnegative_word(%bounded_position: reg<amdgpu.sgpr>, %replacement: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 36, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_mov_b32 0
  %15 = s_lshl_b32_rhs_inline %bounded_position, 2
  %16 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_mov_b32 0
  %19, %20 = s_add_co_u32 %16, %15
  %21, %22 = s_addc_u32 %17, %18, %20
  %23 = concat(%19, %21) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %previous = global_load_b32_saddr %14, %23 {offset = 16}
  %25 = v_mov_b32_copy %replacement
  %27 = s_lshl_b32_rhs_inline %bounded_position, 2
  %31, %32 = s_add_co_u32 %16, %27
  %33, %34 = s_addc_u32 %17, %18, %32
  %35 = concat(%31, %33) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %14, %25, %35 {offset = 16}
  return %previous
}

