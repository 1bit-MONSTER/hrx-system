// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_biased_offsets.loom
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @exchange_biased_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %signed_position = index.assume %position [range(%position, -4, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @exchange_biased_word(%signed_position: reg<amdgpu.sgpr>, %replacement: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 36, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_mov_b32 0
  %15 = s_ashr_i32_rhs_inline %signed_position, 31
  %16 = concat(%signed_position, %15) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %17 = s_mov_b32 2
  %18 = s_lshl_b64 %16, %17
  %19 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = slice %18[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = slice %18[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23, %24 = s_add_co_u32 %19, %21
  %25, %26 = s_addc_u32 %20, %22, %24
  %27 = concat(%23, %25) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %previous = global_load_b32_saddr %14, %27 {offset = 16}
  %29 = v_mov_b32_copy %replacement
  %31 = s_ashr_i32_rhs_inline %signed_position, 31
  %32 = concat(%signed_position, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %34 = s_lshl_b64 %32, %17
  %37 = slice %34[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %34[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39, %40 = s_add_co_u32 %19, %37
  %41, %42 = s_addc_u32 %20, %38, %40
  %43 = concat(%39, %41) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %14, %29, %43 {offset = 16}
  return %previous
}

