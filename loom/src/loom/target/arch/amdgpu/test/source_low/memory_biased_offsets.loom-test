  %32 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35, %36 = s_add_co_u32 %31, %26
  %37, %38 = s_addc_u32 %32, %28, %36
  %39 = concat(%35, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %previous = global_load_b32_saddr %14, %39 {offset = 4095}
  %41 = v_mov_b32_copy %replacement
  %43 = s_ashr_i32_rhs_inline %signed_position, 31
  %44 = concat(%signed_position, %43) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %46 = s_lshl_b64 %44, %17
  %50 = slice %46[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
