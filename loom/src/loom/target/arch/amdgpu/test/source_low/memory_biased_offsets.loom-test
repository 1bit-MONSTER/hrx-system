func.def @copy_biased_vector(%source: buffer, %destination: buffer, %position: index) {
  %signed_position = index.assume %position [range(%position, -4, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<12xi32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<12xi32>
  %values = vector.load %source_view[%element] : view<12xi32> -> vector<4xi32>
  vector.store %values, %destination_view[%element] : vector<4xi32>, view<12xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @copy_biased_vector(%signed_position: reg<amdgpu.sgpr>) asm {
  %source_view = resource<hal_binding> {extent = 48, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination_view = resource<hal_binding> {extent = 48, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %14 = s_ashr_i32_rhs_inline %signed_position, 31
  %15 = concat(%signed_position, %14) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 2
  %17 = s_lshl_b64 %15, %16
  %18 = slice %source_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %source_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %17[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = slice %17[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22, %23 = s_add_co_u32 %18, %20
  %24, %25 = s_addc_u32 %19, %21, %23
  %26 = concat(%22, %24) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %values = global_load_b128_saddr %13, %26 {offset = 16}
  %29 = s_ashr_i32_rhs_inline %signed_position, 31
  %30 = concat(%signed_position, %29) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %32 = s_lshl_b64 %30, %16
  %33 = slice %destination_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %destination_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %32[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = slice %32[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37, %38 = s_add_co_u32 %33, %35
  %39, %40 = s_addc_u32 %34, %36, %38
  %41 = concat(%37, %39) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %13, %values, %41 {offset = 16}
  return
}

