  %63, %64 = s_add_co_u32 %31, %54
  %65, %66 = s_addc_u32 %32, %56, %64
  %67 = concat(%63, %65) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
