// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_half_extrema.loom-test
// RUN: emit source-low target=amdgpu:gfx1170 output=low

func.def @half_extrema(%lhs: f16, %rhs: f16) -> (f16, f16, f16, f16) {
  %minimum = scalar.minimumf %lhs, %rhs : f16
  %maximum = scalar.maximumf %lhs, %rhs : f16
  %minnum = scalar.minnumf %lhs, %rhs : f16
  %maxnum = scalar.maxnumf %lhs, %rhs : f16
  func.return %minimum, %maximum, %minnum, %maxnum : f16, f16, f16, f16
}

// ----
low.func.def target<amdgpu.rdna4m.core> abi(hal_kernel) @half_extrema(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %minimum = v_minimum_f16 %lhs, %rhs
  %maximum = v_maximum_f16 %lhs, %rhs
  %minnum = v_min_num_f16 %lhs, %rhs
  %maxnum = v_max_num_f16 %lhs, %rhs
  %20 = v_bfe_u32_offset_0_width_16_low16 %minimum
  %21 = v_bfe_u32_offset_0_width_16_low16 %maximum
  %22 = v_bfe_u32_offset_0_width_16_low16 %minnum
  %23 = v_bfe_u32_offset_0_width_16_low16 %maxnum
  return %20, %21, %22, %23
}

// ====

func.def @half_extrema_uniform(%lhs_bits: i32, %rhs_bits: i32) -> (f16, f16) {
  %lhs_half = scalar.trunci %lhs_bits : i32 to i16
  %rhs_half = scalar.trunci %rhs_bits : i32 to i16
  %lhs = scalar.bitcast %lhs_half : i16 to f16
  %rhs = scalar.bitcast %rhs_half : i16 to f16
  %minimum = scalar.minnumf %lhs, %rhs : f16
  %maximum = scalar.maxnumf %lhs, %rhs : f16
  func.return %minimum, %maximum : f16, f16
}

// ----
low.func.def target<amdgpu.rdna4m.core> abi(hal_kernel) @half_extrema_uniform(%lhs_bits: reg<amdgpu.sgpr>, %rhs_bits: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %lhs = v_mov_b32_copy %lhs_bits
  %rhs = v_mov_b32_copy %rhs_bits
  %minimum = v_min_num_f16 %lhs, %rhs
  %maximum = v_max_num_f16 %lhs, %rhs
  %18 = v_bfe_u32_offset_0_width_16_low16 %minimum
  %19 = v_bfe_u32_offset_0_width_16_low16 %maximum
  return %18, %19
}

// ====

func.def @half_extrema_bounds(%value: f16) -> (f16, f16) {
  %bound = scalar.constant 1.0 : f16
  %minimum = scalar.minnumf %value, %bound : f16
  %maximum = scalar.maxnumf<nnan> %value, %bound : f16
  func.return %minimum, %maximum : f16, f16
}

// ----
low.func.def target<amdgpu.rdna4m.core> abi(hal_kernel) @half_extrema_bounds(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %bound = v_mov_b32 15360
  %minimum = v_min_num_f16 %value, %bound
  %maximum = v_max_num_f16 %value, %bound
  %12 = v_bfe_u32_offset_0_width_16_low16 %minimum
  %13 = v_bfe_u32_offset_0_width_16_low16 %maximum
  return %12, %13
}

// ====

func.def @packed_half_extrema(%value: vector<4xf16>, %lower: vector<4xf16>, %upper: vector<4xf16>) -> (vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>) {
  %minnum = vector.minnumf %value, %lower : vector<4xf16>
  %maxnum = vector.maxnumf %value, %lower : vector<4xf16>
  %minimum = vector.minimumf %value, %lower : vector<4xf16>
  %maximum = vector.maximumf %value, %lower : vector<4xf16>
  %clamped = vector.clampf<number> %value, %lower, %upper : vector<4xf16>
  %finite = vector.clampf<number, nnan> %value, %lower, %upper : vector<4xf16>
  func.return %minnum, %maxnum, %minimum, %maximum, %clamped, %finite : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
}

// ----
low.func.def target<amdgpu.rdna4m.core> abi(hal_kernel) @packed_half_extrema(%value: reg<amdgpu.vgpr x2>, %lower: reg<amdgpu.vgpr x2>, %upper: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %24 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25 = slice %lower[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %26 = v_pk_min_num_f16 %24, %25
  %27 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = slice %lower[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %29 = v_pk_min_num_f16 %27, %28
  %minnum = concat(%26, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %33 = v_pk_max_num_f16 %24, %25
  %36 = v_pk_max_num_f16 %27, %28
  %maxnum = concat(%33, %36) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %40 = v_pk_minimum_f16 %24, %25
  %43 = v_pk_minimum_f16 %27, %28
  %minimum = concat(%40, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %47 = v_pk_maximum_f16 %24, %25
  %50 = v_pk_maximum_f16 %27, %28
  %maximum = concat(%47, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %60 = slice %upper[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %61 = v_pk_min_num_f16 %33, %60
  %63 = slice %upper[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %64 = v_pk_min_num_f16 %36, %63
  %clamped = concat(%61, %64) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %finite = concat(%61, %64) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %minnum, %maxnum, %minimum, %maximum, %clamped, %finite
}
