// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @scalar_ctlzi_i32_sgpr(%input: i32) -> (i32) {
  %result = scalar.ctlzi %input : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_ctlzi_i32_sgpr(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %5 = s_clz_i32_u32 %input
  %6 = s_mov_b32 32
  %result = s_min_u32 %5, %6
  return %result
}

