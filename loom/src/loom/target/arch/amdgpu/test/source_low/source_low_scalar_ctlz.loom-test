// ====

amdgpu.target<gfx942> @target

func.def target(@target) @scalar_ctlzi_i32_cdna3(%uniform: i32, %inputs: vector<2xi32>) -> (i32, i32) {
  %varying = vector.extract %inputs[0] : vector<2xi32> -> i32
  %uniform_result = scalar.ctlzi %uniform : i32
  %varying_result = scalar.ctlzi %varying : i32
  func.return %uniform_result, %varying_result : i32, i32
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @scalar_ctlzi_i32_cdna3(%uniform: reg<amdgpu.sgpr>, %inputs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %varying = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %12 = s_flbit_i32_b32 %uniform
  %13 = s_mov_b32 32
  %uniform_result = s_min_u32 %12, %13
  %15 = v_ffbh_u32 %varying
  %16 = v_mov_b32 32
  %varying_result = v_min_u32 %15, %16
  return %uniform_result, %varying_result
}
