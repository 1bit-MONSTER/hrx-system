  %20 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %20, %input_view
  %22 = v_lshlrev_b32_src0_inline %lane, 2
  %result = ds_bpermute_b32 %22, %value
  %24 = v_lshlrev_b32_src0_inline %tid, 2
