low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_shuffle_dynamic_up_i32() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c3 = s_mov_b32 3
  %biased_lane = v_add_u32 %c3, %lane
  %26 = s_mov_b32 15
  %source_lane_i32 = v_and_b32 %26, %biased_lane
  %28 = v_lshlrev_b32_src0_inline %lane, 2
  %value = global_load_b32_saddr %28, %input_view
  %30 = v_sub_nc_u32 %lane, %source_lane_i32
  %31 = v_and_b32_src0_inline %lane, 15
  %32 = v_cmp_ge_u32 %31, %source_lane_i32
  %33 = s_mov_b64_exec_read
  %34 = slice %33[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = v_mov_b32_copy %34
  %36 = slice %33[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37 = v_mov_b32_copy %36
  %38 = concat(%35, %37) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %39 = v_lshrrev_b64 %30, %38
  %40 = slice %39[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %41 = v_and_b32_src0_inline %40, 1
  %42 = v_mov_b32 0
  %43 = v_cmp_ne_i32 %41, %42
  %valid = s_and_b64 %43, %32
  %45 = v_lshlrev_b32_src0_inline %30, 2
  %shuffled = ds_bpermute_b32 %45, %value
  %47, %48 = s_and_saveexec_b64 %valid
  low.cond_br %48, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %49 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %49, %shuffled, %output_view
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %47
  return
}

