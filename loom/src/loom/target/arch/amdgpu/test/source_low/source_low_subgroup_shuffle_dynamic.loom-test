  %28 = v_lshlrev_b32_src0_inline %lane, 2
  %value = global_load_b32_saddr %28, %input_view
  %30 = v_xor_b32 %lane, %source_lane_i32
  %31 = v_lshlrev_b32_src0_inline %30, 2
  %shuffled = ds_bpermute_b32 %31, %value
  %33 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %33, %shuffled, %output_view
