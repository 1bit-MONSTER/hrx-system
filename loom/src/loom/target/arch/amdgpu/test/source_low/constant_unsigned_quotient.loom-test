// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_quotients(%value: i32) -> (i32, i32, i32) {
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %high_divisor = scalar.constant -2147483647 : i32
  %third = scalar.divui %value, %c3 : i32
  %seventh = scalar.divui %value, %c7 : i32
  %high = scalar.divui %value, %high_divisor : i32
  func.return %third, %seventh, %high : i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_quotients(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %high_divisor = s_mov_b32 2147483649
  %15 = s_mov_b32 2863311531
  %16 = s_mul_hi_u32 %value, %15
  %17 = s_mov_b32 1
  %third = s_lshr_b32 %16, %17
  %19 = s_mov_b32 613566757
  %20 = s_mul_hi_u32 %value, %19
  %21 = s_sub_u32 %value, %20
  %23 = s_lshr_b32 %21, %17
  %24 = s_add_u32 %23, %20
  %25 = s_mov_b32 2
  %seventh = s_lshr_b32 %24, %25
  %27 = s_cmp_ge_u32 %value, %high_divisor
  %28 = s_mov_b32 0
  %high = s_cselect_b32 %17, %28, %27
  return %third, %seventh, %high
}

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @varying_quotients(%values: vector<2xi32>) -> (i32, i32, i32) {
  %value = vector.extract %values[0] : vector<2xi32> -> i32
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %high_divisor = scalar.constant -2147483647 : i32
  %third = scalar.divui %value, %c3 : i32
  %seventh = scalar.divui %value, %c7 : i32
  %high = scalar.divui %value, %high_divisor : i32
  func.return %third, %seventh, %high : i32, i32, i32
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_quotients(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = v_mov_b32 2863311531
  %18 = v_mul_hi_u32 %value, %17
  %third = v_lshrrev_b32_src0_inline %18, 1
  %20 = v_mov_b32 613566757
  %21 = v_mul_hi_u32 %value, %20
  %22 = v_sub_u32 %value, %21
  %23 = v_lshrrev_b32_src0_inline %22, 1
  %24 = v_add_u32 %23, %21
  %seventh = v_lshrrev_b32_src0_inline %24, 2
  %26 = v_mov_b32 2147483649
  %27 = v_cmp_ge_u32 %value, %26
  %28 = v_mov_b32 0
  %29 = v_mov_b32 1
  %high = v_cndmask_b32 %28, %29, %27
  return %third, %seventh, %high
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @narrow_quotients(%byte: i8, %halfword: i16) -> (i8, i16) {
  %byte_divisor = scalar.constant 3 : i8
  %halfword_divisor = scalar.constant 7 : i16
  %byte_quotient = scalar.divui %byte, %byte_divisor : i8
  %halfword_quotient = scalar.divui %halfword, %halfword_divisor : i16
  func.return %byte_quotient, %halfword_quotient : i8, i16
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_quotients(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %22 = v_and_b32_lit %byte, 255
  %23 = v_mov_b32 2863311531
  %24 = v_mul_hi_u32 %22, %23
  %byte_quotient = v_lshrrev_b32_src0_inline %24, 1
  %26 = v_and_b32_lit %halfword, 65535
  %27 = v_mov_b32 613566757
  %28 = v_mul_hi_u32 %26, %27
  %29 = v_sub_nc_u32 %26, %28
  %30 = v_lshrrev_b32_src0_inline %29, 1
  %31 = v_add_u32 %30, %28
  %halfword_quotient = v_lshrrev_b32_src0_inline %31, 2
  return %byte_quotient, %halfword_quotient
}
