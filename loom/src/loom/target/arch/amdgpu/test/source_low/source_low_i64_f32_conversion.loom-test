amdgpu.target<gfx942> @target

func.def target(@target) @convert_i64_f32(%signed: i64, %unsigned: i64, %signed2: vector<2xi64>, %unsigned2: vector<2xi64>) -> (f32, f32, vector<2xf32>, vector<2xf32>) {
  %signed_result = scalar.sitofp %signed : i64 to f32
  %unsigned_result = scalar.uitofp %unsigned : i64 to f32
  %signed2_result = vector.sitofp %signed2 : vector<2xi64> to vector<2xf32>
  %unsigned2_result = vector.uitofp %unsigned2 : vector<2xi64> to vector<2xf32>
  func.return %signed_result, %unsigned_result, %signed2_result, %unsigned2_result : f32, f32, vector<2xf32>, vector<2xf32>
}

