  %seed = s_load_dwordx2 %seed_view, %25
  %31 = copy %lhs : reg<amdgpu.sgpr x2> -> reg<amdgpu.vgpr x2>
  %32 = copy %rhs : reg<amdgpu.sgpr x2> -> reg<amdgpu.vgpr x2>
  %33 = copy %seed : reg<amdgpu.sgpr x2> -> reg<amdgpu.vgpr x2>
  %34 = v_mov_b32 16843009
  %35 = v_mov_b32 0
  %36 = slice %31[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %37 = v_xor_b32_lit %36, 2155905152
  %38 = slice %32[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %39 = v_dot4_i32_i8 %34, %38, %35
  %40 = v_lshlrev_b32_lit %39, 7
  %41 = slice %33[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %42 = v_add_u32 %41, %40
  %44 = v_dot4_i32_i8 %37, %38, %42
  %45 = slice %31[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = v_xor_b32_lit %45, 2155905152
  %47 = slice %32[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %48 = v_dot4_i32_i8 %34, %47, %35
  %49 = v_lshlrev_b32_lit %48, 7
  %50 = slice %33[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %51 = v_add_u32 %50, %49
