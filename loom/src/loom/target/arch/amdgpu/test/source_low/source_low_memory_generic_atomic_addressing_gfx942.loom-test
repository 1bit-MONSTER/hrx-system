low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "position"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @generic_atomic_uniform_i64(%index: reg<amdgpu.sgpr>) asm {
  %words = resource<hal_binding> {extent = 80, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %28 = s_mov_b32 0
  %29 = concat(%index, %28) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %30 = s_mov_b32 3
  %31 = s_lshl_b64 %29, %30
  %32 = slice %words[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = slice %words[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %31[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %31[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36, %37 = s_add_co_u32 %32, %34
  %38, %39 = s_addc_u32 %33, %35, %37
  %43 = v_mov_b32_copy %36
  %44 = v_mov_b32_copy %38
  %45 = concat(%43, %44) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %46 = v_mov_b32 0
  %47 = v_mov_b32 1
  %48 = concat(%46, %47) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_atomic_add_x2 %45, %48 {offset = 16}
  %50 = concat(%index, %28) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %52 = s_lshl_b64 %50, %30
  %55 = slice %52[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56 = slice %52[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %57, %58 = s_add_co_u32 %32, %55
  %59, %60 = s_addc_u32 %33, %56, %58
  %64 = v_mov_b32_copy %57
  %65 = v_mov_b32_copy %59
  %66 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %69 = concat(%46, %47) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old_add = flat_atomic_add_x2_rtn %66, %69 {offset = 16} : reg<amdgpu.vgpr x2>
  %72 = concat(%index, %28) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %74 = s_lshl_b64 %72, %30
  %77 = slice %74[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %78 = slice %74[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %79, %80 = s_add_co_u32 %32, %77
  %81, %82 = s_addc_u32 %33, %78, %80
  %86 = v_mov_b32_copy %79
  %87 = v_mov_b32_copy %81
  %88 = concat(%86, %87) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %89 = v_mov_b32 10
  %90 = v_mov_b32 2
  %91 = concat(%89, %90) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %92 = v_mov_b32 99
  %94 = concat(%92, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %95 = concat(%94, %91) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %old_cas = flat_atomic_cmpswap_x2_rtn %88, %95 {offset = 16} : reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %46, %old_add, %results
  global_store_dwordx2_saddr %46, %old_cas, %results {offset = 8}
  return
}

// ====

// Static origins and varying strides preserve bits above the low address word.
kernel.def @generic_atomic_wide_address() {
  %unit = index.constant 1 : index
  %width = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer) {
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %origin = index.constant 4294967312 : offset
  %stride = index.constant 4294967296 : offset
  %result_origin = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %relative = index.scale %lane, %stride : index, offset -> offset
  %address = index.add %origin, %relative : offset
  %word = buffer.view %generic[%address] : buffer -> view<1xi64>
  %results = buffer.view %output[%result_origin] : buffer -> view<2xi64>
  %increment = scalar.constant 4294967297 : i64
  %old = view.atomic.rmw<addi> %increment, %word[0] {ordering = relaxed, scope = device} : i64, view<1xi64> -> i64
  view.store %old, %results[%lane] : i64, view<2xi64>
  kernel.return
}

