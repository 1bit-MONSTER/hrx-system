// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_generic_atomic_addressing.loom-test
// RUN: emit source-low target=amdgpu:gfx942 output=low

// Uniform and lane-varying terms both contribute to the full flat pointer.
kernel.def @generic_atomic_indexed_i32() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer, %start: i32) {
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %origin = index.constant 65536 : offset
  %result_origin = index.constant 0 : offset
  %words = buffer.view %generic[%origin] : buffer -> view<66xi32>
  %results = buffer.view %output[%result_origin] : buffer -> view<128xi32>
  %uniform_input = index.cast %start : i32 to index
  %uniform = index.assume %uniform_input [range(%uniform_input, 0, 2)] : index
  %lane = kernel.workitem.id<x> : index
  %position = index.add %uniform, %lane : index
  %half = index.constant 64 : index
  %second = index.add %lane, %half : index
  %contribution = scalar.constant 3 : i32
  %increment = scalar.constant 5 : i32
  %expected = scalar.constant 18 : i32
  %replacement = scalar.constant 21 : i32
  view.atomic.reduce<addi> %contribution, %words[%position] {ordering = relaxed, scope = workgroup} : i32, view<66xi32>
  %old_add = view.atomic.rmw<addi> %increment, %words[%position] {ordering = relaxed, scope = workgroup} : i32, view<66xi32> -> i32
  %old_cas = view.atomic.cmpxchg %expected, %replacement, %words[%position] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : i32, view<66xi32> -> i32
  view.store %old_add, %results[%lane] : i32, view<128xi32>
  view.store %old_cas, %results[%second] : i32, view<128xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "start"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @generic_atomic_indexed_i32(%uniform: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %words = resource<hal_binding> {extent = 65800, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %30 = s_mov_b32 65536
  %31 = s_mov_b32 0
  %33 = slice %words[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %words[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37, %38 = s_add_co_u32 %33, %30
  %39, %40 = s_addc_u32 %34, %31, %38
  %43 = concat(%uniform, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %44 = s_mov_b32 2
  %45 = s_lshl_b64 %43, %44
  %48 = slice %45[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %49 = slice %45[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %50, %51 = s_add_co_u32 %37, %48
  %52, %53 = s_addc_u32 %39, %49, %51
  %55 = v_lshlrev_b32_src0_inline %lane, 2
  %56 = v_lshrrev_b32_src0_inline %lane, 30
  %59, %60 = v_add_co_u32 %50, %55
  %61 = v_mov_b32_copy %52
  %62, %63 = v_addc_co_u32 %61, %56, %60
  %64 = concat(%59, %62) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %65 = v_mov_b32 3
  flat_atomic_add %64, %65
  %73, %74 = s_add_co_u32 %33, %30
  %75, %76 = s_addc_u32 %34, %31, %74
  %79 = concat(%uniform, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %81 = s_lshl_b64 %79, %44
  %84 = slice %81[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %85 = slice %81[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %86, %87 = s_add_co_u32 %73, %84
  %88, %89 = s_addc_u32 %75, %85, %87
  %95, %96 = v_add_co_u32 %86, %55
  %97 = v_mov_b32_copy %88
  %98, %99 = v_addc_co_u32 %97, %56, %96
  %100 = concat(%95, %98) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %101 = v_mov_b32 5
  %old_add = flat_atomic_add_rtn %100, %101 : reg<amdgpu.vgpr>
  %110, %111 = s_add_co_u32 %33, %30
  %112, %113 = s_addc_u32 %34, %31, %111
  %116 = concat(%uniform, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %118 = s_lshl_b64 %116, %44
  %121 = slice %118[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %122 = slice %118[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %123, %124 = s_add_co_u32 %110, %121
  %125, %126 = s_addc_u32 %112, %122, %124
  %132, %133 = v_add_co_u32 %123, %55
  %134 = v_mov_b32_copy %125
  %135, %136 = v_addc_co_u32 %134, %56, %133
  %137 = concat(%132, %135) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %138 = v_mov_b32 18
  %139 = v_mov_b32 21
  %140 = concat(%139, %138) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old_cas = flat_atomic_cmpswap_b32_rtn %137, %140 : reg<amdgpu.vgpr>
  global_store_dword_saddr %55, %old_add, %results
  global_store_dword_saddr %55, %old_cas, %results {offset = 256}
  return
}

// ====

// A uniform dynamic term still reaches VADDR; flat packets have no SOFFSET.
kernel.def @generic_atomic_uniform_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer, %position: i32) {
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %origin = index.constant 16 : offset
  %result_origin = index.constant 0 : offset
  %words = buffer.view %generic[%origin] : buffer -> view<8xi64>
  %results = buffer.view %output[%result_origin] : buffer -> view<2xi64>
  %index_input = index.cast %position : i32 to index
  %index = index.assume %index_input [range(%index_input, 0, 7)] : index
  %increment = scalar.constant 4294967296 : i64
  %expected = scalar.constant 8589934602 : i64
  %replacement = scalar.constant 99 : i64
  view.atomic.reduce<addi> %increment, %words[%index] {ordering = relaxed, scope = device} : i64, view<8xi64>
  %old_add = view.atomic.rmw<addi> %increment, %words[%index] {ordering = relaxed, scope = device} : i64, view<8xi64> -> i64
  %old_cas = view.atomic.cmpxchg %expected, %replacement, %words[%index] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<8xi64> -> i64
  view.store %old_add, %results[0] : i64, view<2xi64>
  view.store %old_cas, %results[1] : i64, view<2xi64>
  kernel.return
}

