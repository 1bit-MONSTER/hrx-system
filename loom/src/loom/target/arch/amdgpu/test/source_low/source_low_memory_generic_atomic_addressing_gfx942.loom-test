low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(2, 1, 1) workgroup_count(1, 1, 1) @generic_atomic_wide_address() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %word = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %59 = s_mov_b32 16
  %60 = s_mov_b32 1
  %62 = slice %word[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63 = slice %word[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %66, %67 = s_add_co_u32 %62, %59
  %68, %69 = s_addc_u32 %63, %60, %67
  %71 = v_mov_b32 0
  %72 = concat(%lane, %71) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %73 = v_mov_b32 32
  %74 = v_lshlrev_b64 %73, %72
  %75 = slice %74[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %76 = slice %74[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %79, %80 = v_add_co_u32 %66, %75
  %81 = v_mov_b32_copy %68
  %82, %83 = v_addc_co_u32 %81, %76, %80
  %84 = concat(%79, %82) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %85 = v_mov_b32 1
  %87 = concat(%85, %85) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old = flat_atomic_add_x2_rtn %84, %87 : reg<amdgpu.vgpr x2>
  %89 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_dwordx2_saddr %89, %old, %results
  return
}
