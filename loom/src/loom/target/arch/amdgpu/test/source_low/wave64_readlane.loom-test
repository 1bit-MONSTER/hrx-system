// RUN: emit amdgpu-assembly @readlane_reuses_lane_index_gfx1100_64 strategy=source

amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @readlane_reuses_lane_index_gfx1100_64(%value: reg<amdgpu.vgpr>, %lane: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %result = v_readlane_b32_src1_sgpr %value, %lane
  return %result
}

// ----
  v_readlane_b32_src1_sgpr s0, v0, s0
  s_endpgm

