// ====

// RUN: with-checks emit source-low target=amdgpu:gfx1250 output=low
func.def @brain_vector_system(%input: buffer, %update: vector<2xbf16>) -> (vector<2xbf16>) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<2xbf16>
  %first = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %first step %stride : vector<2xindex>
  %old = vector.atomic.rmw<addf, noftz> %update, %view[0][%offsets] {ordering = acq_rel, scope = system} : vector<2xbf16>, view<2xbf16>, vector<2xindex>
  func.return %old : vector<2xbf16>
}

// ----
CHECK: low.func.def *
CHECK-NOT: *vector.atomic.*
CHECK-NOT: *low.op<*
CHECK: * = flat_atomic_cmpswap_b32_rtn *
CHECK: *low.cond_br *
CHECK: * = v_cmp_ne_i32 *
