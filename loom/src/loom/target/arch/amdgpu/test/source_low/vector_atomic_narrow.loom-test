// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_vector_atomic_narrow.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1100 output=low

kernel.def @half_vector_four() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: vector<4xf16>) {
  %first = index.constant 0 : index
  %unit = index.constant 1 : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xf16>
  %offsets = vector.iota %first step %unit : vector<4xindex>
  vector.atomic.reduce<addf> %value, %scratch_view[0][%offsets] {ordering = relaxed, scope = workgroup} : vector<4xf16>, view<32xf16>, vector<4xindex>
  kernel.return
}

// ----
CHECK: low.kernel.def *
CHECK-NOT: *vector.atomic.*
CHECK-NOT: *low.op<*
CHECK: * = ds_cmpst_rtn_b32 *
CHECK: *low.cond_br *
CHECK: * = v_cmp_ne_i32 *

// ====

