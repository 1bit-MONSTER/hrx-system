// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_workgroup_fences.loom-test
// RUN: emit source-low target=amdgpu:gfx1200 output=low

// Publication releases preceding accesses through both global and local roots.
kernel.def @publish_workgroup_fence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %signal: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %local_bytes = index.constant 4 : offset
  %local_storage = buffer.alloca<workgroup> align(4) %local_bytes : buffer
  %local = buffer.view %local_storage[%base] : buffer -> view<1xi32>
  %data = buffer.view %payload[%base] : buffer -> view<1xi32>
  %word = buffer.view %signal[%base] : buffer -> view<1xi32>
  %marker = scalar.constant 7 : i32
  view.store %value, %data[0] : i32, view<1xi32>
  view.store %marker, %local[0] : i32, view<1xi32>
  buffer.fence scope(workgroup) ordering(release)
  view.atomic.store %value, %word[0] {ordering = relaxed, scope = workgroup} : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @publish_workgroup_fence(%value: reg<amdgpu.sgpr>) asm {
  %data = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %word = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %17 = v_mov_b32_copy %value
  %18 = v_mov_b32 0
  global_store_b32_saddr %18, %17, %data
  %19 = v_mov_b32 7
  ds_write_b32 %18, %19
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  global_store_b32_saddr<volatile> %18, %17, %word {scope = 1}
  return
}

// ====

// The fence completes no-return atomics before making payload reads visible.
kernel.def @acquire_workgroup_fence_after_reduce() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %word = buffer.view %signal[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi64>
  %result = buffer.view %output[%origin] : buffer -> view<1xi64>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %word[0] {ordering = relaxed, scope = workgroup} : i32, view<1xi32>
  buffer.fence scope(workgroup) ordering(acquire)
  %value = view.load %data[0] : view<1xi64> -> i64
  view.store %value, %result[0] : i64, view<1xi64>
  kernel.return
}

