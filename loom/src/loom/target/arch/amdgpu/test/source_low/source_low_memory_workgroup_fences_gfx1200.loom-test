low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @acquire_workgroup_fence_after_reduce() asm {
  %word = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %data = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 8, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_mov_b32 0
  %15 = v_mov_b32 1
  global_atomic_add_u32_saddr %14, %15, %word {scope = 1}
  s_wait_dscnt {dscnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 1}
  %value = global_load_b64_saddr %14, %data
  global_store_b64_saddr %14, %value, %result
  return
}

// ====

// Coherent payload reads replace invalidation while the fence keeps completion.
kernel.def @coherent_workgroup_fence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %word = buffer.view %signal[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  buffer.fence scope(workgroup) ordering(acquire)
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
  kernel.return
}

