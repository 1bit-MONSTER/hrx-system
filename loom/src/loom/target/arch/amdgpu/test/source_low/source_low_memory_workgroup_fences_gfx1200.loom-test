  %15 = v_mov_b32 0
  global_store_b32_saddr %15, %14, %data
  %observed = global_load_b32_saddr<volatile> %15, %word {scope = 1}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 1}
  global_store_b32_saddr %15, %observed, %result
  return
}
