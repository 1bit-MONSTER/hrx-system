low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @coherent_workgroup_fence() asm {
  %word = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %data = resource<hal_binding> {extent = 4096, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %unused = global_load_b32_saddr<volatile> %13, %word {scope = 1}
  s_wait_dscnt {dscnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  %value = global_load_b32_saddr %13, %data {scope = 1}
  global_store_b32_saddr %13, %value, %result
  return
}

// ====

// A relaxed LDS observation pairs with the fence before a global payload read.
kernel.def @acquire_workgroup_fence_after_lds() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %results = buffer.view %output[%origin] : buffer -> view<1xi32>
  %initial = scalar.constant 0 : i32
  view.atomic.store %initial, %flag[0] {ordering = relaxed, scope = workgroup} : i32, view<1xi32>
  %observed = view.atomic.load %flag[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  buffer.fence scope(workgroup) ordering(acquire)
  %value = view.load %data[0] : view<1xi32> -> i32
  view.store %value, %results[0] : i32, view<1xi32>
  kernel.return
}

