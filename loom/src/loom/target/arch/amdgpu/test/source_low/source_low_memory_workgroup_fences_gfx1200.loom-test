low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @acquire_workgroup_fence_after_lds() asm {
  %data = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %17 = v_mov_b32 0
  ds_write_b32<volatile> %17, %17
  %observed = ds_read_b32<volatile> %17
  s_wait_dscnt {dscnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 1}
  %value = global_load_b32_saddr %17, %data
  global_store_b32_saddr %17, %value, %results
  return
}

// ====

// A fence completes both possible address domains of a generic atomic.
kernel.def @acq_rel_workgroup_fence_after_generic() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer, %payload: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %word = buffer.view %generic[%base] : buffer -> view<1xi32>
  %data = buffer.view %payload[%base] : buffer -> view<1xi64>
  %result = buffer.view %output[%base] : buffer -> view<1xi64>
  %expected = scalar.constant 7 : i32
  %replacement = scalar.constant 9 : i32
  %observed = view.atomic.cmpxchg %expected, %replacement, %word[0] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : i32, view<1xi32> -> i32
  buffer.fence scope(workgroup) ordering(acq_rel)
  %acquired = view.load %data[0] : view<1xi64> -> i64
  view.store %acquired, %result[0] : i64, view<1xi64>
  kernel.return
}

