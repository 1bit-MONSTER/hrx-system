low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @acq_rel_workgroup_fence_after_generic() asm {
  %word = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %data = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 8, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = slice %word[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %word[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %18
  %21 = v_mov_b32_copy %19
  %22 = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %23 = v_mov_b32 7
  %24 = v_mov_b32 9
  %25 = concat(%24, %23) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %observed = flat_atomic_cmpswap_b32_rtn %22, %25 {scope = 1}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 1}
  %27 = v_mov_b32 0
  %acquired = global_load_b64_saddr %27, %data
  global_store_b64_saddr %27, %acquired, %result
  return
}

// ====

kernel.def @sequential_workgroup_fence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %signal: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %data = buffer.view %payload[%base] : buffer -> view<1xi32>
  %word = buffer.view %signal[%base] : buffer -> view<1xi32>
  %result = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %value, %data[0] : i32, view<1xi32>
  %observed = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  buffer.fence scope(workgroup) ordering(seq_cst)
  view.store %observed, %result[0] : i32, view<1xi32>
  kernel.return
}

