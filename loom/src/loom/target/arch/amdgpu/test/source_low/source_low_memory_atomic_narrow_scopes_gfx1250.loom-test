low.kernel.def target<amdgpu.rdna4.gfx125x.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @thread_atomic_sequence() asm {
  %generic_word = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 32, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = storage {byte_alignment = 8, byte_length = 8} : low.storage<workgroup>
  %local = storage_address %20 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %28 = v_mov_b32 1
  %30 = concat(%28, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31 = v_mov_b32 0
  global_store_b64_saddr<volatile> %31, %30, %generic_word {th = 1}
  %discarded = global_load_b64_saddr<volatile> %31, %generic_word {th = 1}
  %observed = global_load_b64_saddr<volatile> %31, %generic_word {th = 1}
  %36 = slice %generic_word[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37 = slice %generic_word[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %36
  %39 = v_mov_b32_copy %37
  %40 = concat(%38, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %43 = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old = flat_atomic_add_u64_rtn %40, %43
  %48 = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_atomic_add_u64_saddr %31, %48, %generic_word
  %51 = concat(%28, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  ds_write_b64<volatile> %31, %51
  %55 = concat(%28, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %58 = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %exchanged = ds_cmpst_rtn_b64 %local, %55, %58
  low.schedule.fence
  %64 = concat(%38, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %final = flat_load_dwordx2<volatile> %64 {th = 1}
  global_store_b64_saddr %31, %observed, %results
  global_store_b64_saddr %31, %old, %results {offset = 8}
  global_store_b64_saddr %31, %exchanged, %results {offset = 16}
  global_store_b64_saddr %31, %final, %results {offset = 24}
  return
}

// ====

// Broader authored scopes on LDS retain workgroup publication and acquisition,
// including payloads in global memory and acquisition on a failed compare.
kernel.def @lds_broad_scope() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %flag = buffer.view %scratch[%origin] : buffer -> view<1xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  %unpublished = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %value = scalar.constant 65537 : i32
  view.store %value, %data[0] : i32, view<1xi32>
  view.atomic.store %increment, %flag[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = release, scope = system} : i32, view<1xi32>
  %observed = view.atomic.load %flag[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = acquire, scope = device} : view<1xi32> -> i32
  %failed = view.atomic.cmpxchg %unpublished, %unpublished, %flag[0] {cache_scope = cu, cache_temporal = non_temporal, failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %acquired = view.load %data[0] : view<1xi32> -> i32
  view.atomic.reduce<addi> %increment, %flag[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = release, scope = device} : i32, view<1xi32>
  %old = view.atomic.rmw<addi> %increment, %flag[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = seq_cst, scope = system} : i32, view<1xi32> -> i32
  view.store %observed, %results[0] : i32, view<4xi32>
  view.store %failed, %results[1] : i32, view<4xi32>
  view.store %old, %results[2] : i32, view<4xi32>
  view.store %acquired, %results[3] : i32, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.gfx125x.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_broad_scope() asm {
  %data = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %flag = storage_address %18 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %23 = v_mov_b32 65537
  %24 = v_mov_b32 0
  global_store_b32_saddr %24, %23, %data
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %25 = v_mov_b32 1
  ds_write_b32<volatile> %24, %25
  %observed = ds_read_b32<volatile> %24
  s_wait_dscnt {dscnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %failed = ds_cmpst_rtn_b32 %flag, %24, %24
  s_wait_dscnt {dscnt = 0}
  %acquired = global_load_b32_saddr %24, %data
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  ds_add_u32 %flag, %25
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  s_wait_dscnt {dscnt = 0}
  %old = ds_add_rtn_u32 %flag, %25
  s_wait_dscnt {dscnt = 0}
  global_store_b32_saddr %24, %observed, %results
  global_store_b32_saddr %24, %failed, %results {offset = 4}
  global_store_b32_saddr %24, %old, %results {offset = 8}
  global_store_b32_saddr %24, %acquired, %results {offset = 12}
  return
}
