// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_narrow_scopes.loom
// RUN: emit source-low target=amdgpu:gfx1250 output=low

// Advisory CU cache hints cannot narrow the authored atomic coherence scope.
// Each lane publishes to its neighbor in one converged subgroup. Global and
// LDS payloads are independent of the atomic flags and their returned values.
kernel.def @subgroup_atomic_handoff() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<2x32xi32>
  %flag = buffer.view %signal[%origin] : buffer -> view<32xi32>
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %generic_flag = buffer.view %generic[%origin] : buffer -> view<32xi32>
  %data = buffer.view %payload[%origin] : buffer -> view<32xi32>
  %results = buffer.view %output[%origin] : buffer -> view<6x32xi32>
  %lane = kernel.workitem.id<x> : index
  %step = index.constant 1 : index
  %neighbor = index.xori %lane, %step : index
  %ordinal = index.cast %lane : index to i32
  %bias = scalar.constant 65536 : i32
  %value = scalar.addi %ordinal, %bias : i32
  %unpublished = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  view.store %value, %data[%lane] : i32, view<32xi32>
  view.store %value, %local[0, %lane] : i32, view<2x32xi32>
  view.atomic.store %increment, %flag[%lane] {cache_scope = cu, cache_temporal = non_temporal, ordering = release, scope = subgroup} : i32, view<32xi32>
  %observed = view.atomic.load %flag[%neighbor] {cache_scope = cu, cache_temporal = non_temporal, ordering = acquire, scope = subgroup} : view<32xi32> -> i32
  %failed = view.atomic.cmpxchg %unpublished, %unpublished, %generic_flag[%neighbor] {cache_scope = cu, cache_temporal = non_temporal, failure_ordering = acquire, scope = subgroup, success_ordering = acq_rel} : i32, view<32xi32> -> i32
  view.atomic.store %unpublished, %local[1, %lane] {cache_scope = cu, cache_temporal = non_temporal, ordering = relaxed, scope = subgroup} : i32, view<2x32xi32>
  %old = view.atomic.rmw<addi> %increment, %local[1, %lane] {cache_scope = cu, cache_temporal = non_temporal, ordering = acq_rel, scope = subgroup} : i32, view<2x32xi32> -> i32
  view.atomic.reduce<addi> %increment, %local[1, %lane] {cache_scope = cu, cache_temporal = non_temporal, ordering = release, scope = subgroup} : i32, view<2x32xi32>
  buffer.fence scope(subgroup) ordering(release)
  %local_flag = view.atomic.load %local[1, %neighbor] {cache_scope = cu, cache_temporal = non_temporal, ordering = relaxed, scope = subgroup} : view<2x32xi32> -> i32
  buffer.fence scope(subgroup) ordering(acquire)
  %global_value = view.load %data[%neighbor] : view<32xi32> -> i32
  %local_value = view.load %local[0, %neighbor] : view<2x32xi32> -> i32
  view.store %global_value, %results[0, %neighbor] : i32, view<6x32xi32>
  view.store %local_value, %results[1, %neighbor] : i32, view<6x32xi32>
  view.store %observed, %results[2, %lane] : i32, view<6x32xi32>
  view.store %failed, %results[3, %lane] : i32, view<6x32xi32>
  view.store %old, %results[4, %lane] : i32, view<6x32xi32>
  view.store %local_flag, %results[5, %lane] : i32, view<6x32xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.gfx125x.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @subgroup_atomic_handoff() asm {
  %ordinal = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %generic_flag = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %data = resource<hal_binding> {extent = 128, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 768, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %45 = storage {byte_alignment = 4, byte_length = 256} : low.storage<workgroup>
  %local = storage_address %45 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %step = s_mov_b32 1
  %neighbor = v_xor_b32 %step, %ordinal
  %50 = v_mov_b32 65536
  %value = v_add_u32 %ordinal, %50
  %54 = v_lshlrev_b32_src0_inline %ordinal, 2
  global_store_b32_saddr %54, %value, %data
  ds_write_b32 %54, %value
  %56 = v_mov_b32 1
  global_store_b32_saddr<volatile> %54, %56, %generic_flag {th = 1}
  %58 = v_lshlrev_b32_src0_inline %neighbor, 2
  %observed = global_load_b32_saddr<volatile> %58, %generic_flag {th = 1}
  %61 = v_lshrrev_b32_src0_inline %neighbor, 30
  %62 = slice %generic_flag[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63 = slice %generic_flag[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64, %65 = v_add_co_u32 %62, %58
  %66 = v_mov_b32_copy %63
  %67, %68 = v_add_co_ci_u32 %66, %61, %65
  %69 = concat(%64, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %70 = v_mov_b32 0
  %72 = concat(%70, %70) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %failed = flat_atomic_cmpswap_b32_rtn %69, %72
  ds_write_b32<volatile> %54, %70 {offset = 128}
  %77 = v_add_u32 %local, %54
  %old = ds_add_rtn_u32 %77, %56 {offset = 128}
  ds_add_u32 %77, %56 {offset = 128}
  low.schedule.fence
  %local_flag = ds_read_b32<volatile> %58 {offset = 128}
  low.schedule.fence
  %global_value = global_load_b32_saddr %58, %data
  %local_value = ds_read_b32 %58
  global_store_b32_saddr %58, %global_value, %results
  global_store_b32_saddr %58, %local_value, %results {offset = 128}
  global_store_b32_saddr %54, %observed, %results {offset = 256}
  global_store_b32_saddr %54, %failed, %results {offset = 384}
  global_store_b32_saddr %54, %old, %results {offset = 512}
  global_store_b32_saddr %54, %local_flag, %results {offset = 640}
  return
}

// ====

// Thread scope retains every observation and the full 64-bit old value.
kernel.def @thread_atomic_sequence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xi64>
  %word = buffer.view %signal[%origin] : buffer -> view<1xi64>
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %generic_word = buffer.view %generic[%origin] : buffer -> view<1xi64>
  %results = buffer.view %output[%origin] : buffer -> view<4xi64>
  %initial = scalar.constant 4294967297 : i64
  %increment = scalar.constant 1 : i64
  view.atomic.store %initial, %word[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = seq_cst, scope = thread} : i64, view<1xi64>
  %discarded = view.atomic.load %word[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = relaxed, scope = thread} : view<1xi64> -> i64
  %observed = view.atomic.load %word[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = seq_cst, scope = thread} : view<1xi64> -> i64
  %old = view.atomic.rmw<addi> %increment, %generic_word[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = acq_rel, scope = thread} : i64, view<1xi64> -> i64
  view.atomic.reduce<addi> %increment, %word[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = release, scope = thread} : i64, view<1xi64>
  view.atomic.store %initial, %local[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = release, scope = thread} : i64, view<1xi64>
  %exchanged = view.atomic.cmpxchg %initial, %increment, %local[0] {cache_scope = cu, cache_temporal = non_temporal, failure_ordering = acquire, scope = thread, success_ordering = seq_cst} : i64, view<1xi64> -> i64
  buffer.fence scope(thread) ordering(seq_cst)
  %final = view.atomic.load %generic_word[0] {cache_scope = cu, cache_temporal = non_temporal, ordering = acquire, scope = thread} : view<1xi64> -> i64
  view.store %observed, %results[0] : i64, view<4xi64>
  view.store %old, %results[1] : i64, view<4xi64>
  view.store %exchanged, %results[2] : i64, view<4xi64>
  view.store %final, %results[3] : i64, view<4xi64>
  kernel.return
}

