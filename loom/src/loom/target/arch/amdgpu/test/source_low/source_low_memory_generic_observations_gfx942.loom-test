  %33 = concat(%31, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %unused = flat_load_dwordx2<volatile> %33 {sc0 = 1} : reg<amdgpu.vgpr x2>
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  %35 = slice %data[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
