low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @generic_release_f64(%value: reg<amdgpu.sgpr x2>) asm {
  %word = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %data = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = storage {byte_alignment = 8, byte_length = 8} : low.storage<workgroup>
  %16 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = v_mov_b32_copy %16
  %18 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = concat(%17, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %21 = v_mov_b32 0
  global_store_dwordx2_saddr %21, %20, %data
  %26 = concat(%17, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  ds_write_b64 %21, %26
  s_waitcnt {lgkmcnt = 0}
  %32 = concat(%17, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %33 = slice %word[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %word[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = v_mov_b32_copy %33
  %36 = v_mov_b32_copy %34
  %37 = concat(%35, %36) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_dwordx2<volatile> %37, %32 {sc0 = 1}
  return
}

// ====

// An unused acquire completes both possible domains before independent reads.
// A wide mutable payload requires eager cache acquisition.
kernel.def @generic_acquire_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %generic_signal = buffer.assume.memory_space<generic> %signal : buffer
  %generic_payload = buffer.assume.memory_space<generic> %payload : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xi64>
  %word = buffer.view %generic_signal[%origin] : buffer -> view<1xi64>
  %data = buffer.view %generic_payload[%origin] : buffer -> view<1xi64>
  %result = buffer.view %output[%origin] : buffer -> view<2xi64>
  %marker = scalar.constant 4294967299 : i64
  view.store %marker, %local[0] : i64, view<1xi64>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xi64> -> i64
  %value = view.load %data[0] : view<1xi64> -> i64
  %local_value = view.load %local[0] : view<1xi64> -> i64
  view.store %value, %result[0] : i64, view<2xi64>
  view.store %local_value, %result[1] : i64, view<2xi64>
  kernel.return
}

