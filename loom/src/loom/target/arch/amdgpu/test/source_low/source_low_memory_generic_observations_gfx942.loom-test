  %data = buffer.view %generic_payload[%origin] : buffer -> view<1024xi32>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %unused = view.atomic.load %word[0] {ordering = acquire, scope = workgroup} : view<1xi32> -> i32
  %value = view.load %data[0] : view<1024xi32> -> i32
  view.store %value, %result[0] : i32, view<1xi32>
