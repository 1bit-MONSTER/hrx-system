// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_generic_observations.loom-test
// RUN: emit source-low target=amdgpu:gfx942 output=low

// Repeated and unused observations remain distinct memory packets.
kernel.def @generic_relaxed_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %generic = buffer.assume.memory_space<generic> %input : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic[%origin] : buffer -> view<1xi32>
  %result = buffer.view %output[%origin] : buffer -> view<2xi32>
  %first = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  %second = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  %unused = view.atomic.load %word[0] {ordering = relaxed, scope = workgroup} : view<1xi32> -> i32
  view.store %first, %result[0] : i32, view<2xi32>
  view.store %second, %result[1] : i32, view<2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @generic_relaxed_i32() asm {
  %word = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = slice %word[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = slice %word[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %12
  %15 = v_mov_b32_copy %13
  %16 = concat(%14, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %first = flat_load_dword<volatile> %16 {sc0 = 1} : reg<amdgpu.vgpr>
  %22 = concat(%14, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %second = flat_load_dword<volatile> %22 {sc0 = 1} : reg<amdgpu.vgpr>
  %28 = concat(%14, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %unused = flat_load_dword<volatile> %28 {sc0 = 1} : reg<amdgpu.vgpr>
  %30 = v_mov_b32 0
  global_store_dword_saddr %30, %first, %result
  global_store_dword_saddr %30, %second, %result {offset = 4}
  return
}

// ====

// A flat publication releases prior global and LDS payloads.
kernel.def @generic_release_f64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %value: f64) {
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %local = buffer.view %scratch[%origin] : buffer -> view<1xf64>
  %word = buffer.view %generic[%origin] : buffer -> view<1xf64>
  %data = buffer.view %payload[%origin] : buffer -> view<1xf64>
  view.store %value, %data[0] : f64, view<1xf64>
  view.store %value, %local[0] : f64, view<1xf64>
  view.atomic.store %value, %word[0] {ordering = release, scope = workgroup} : f64, view<1xf64>
  kernel.return
}

