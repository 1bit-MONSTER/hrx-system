// ====

// Sequential observations order both sides of the load and preserve wide bits.
kernel.def @generic_sequential_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %output: buffer, %value: i64) {
  %generic = buffer.assume.memory_space<generic> %signal : buffer
  %origin = index.constant 0 : offset
  %word = buffer.view %generic[%origin] : buffer -> view<1xi64>
  %result = buffer.view %output[%origin] : buffer -> view<1xi64>
  view.atomic.store %value, %word[0] {ordering = seq_cst, scope = system} : i64, view<1xi64>
  %observed = view.atomic.load %word[0] {ordering = seq_cst, scope = system} : view<1xi64> -> i64
  view.store %observed, %result[0] : i64, view<1xi64>
  kernel.return
}

