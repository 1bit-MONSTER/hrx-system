// RUN: pass specialize-target-callgraph,project-boundary-representations

// Every AMDGPU vector storage family projects an unsupported callable carrier
// into the largest admitted physical packets plus its exact irregular tail.
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_callable_family(%i1_value: vector<33xi1>, %i8_value: vector<129xi8>, %i16_value: vector<65xi16>, %i32_value: vector<33xi32>, %i64_value: vector<17xi64>, %f8e4m3_value: vector<129xf8E4M3>, %f8e5m2_value: vector<129xf8E5M2>, %f16_value: vector<65xf16>, %bf16_value: vector<65xbf16>, %f32_value: vector<33xf32>, %f64_value: vector<17xf64>) -> (vector<33xi1>, vector<129xi8>, vector<65xi16>, vector<33xi32>, vector<17xi64>, vector<129xf8E4M3>, vector<129xf8E5M2>, vector<65xf16>, vector<65xbf16>, vector<33xf32>, vector<17xf64>) {
  func.return %i1_value, %i8_value, %i16_value, %i32_value, %i64_value, %f8e4m3_value, %f8e5m2_value, %f16_value, %bf16_value, %f32_value, %f64_value : vector<33xi1>, vector<129xi8>, vector<65xi16>, vector<33xi32>, vector<17xi64>, vector<129xf8E4M3>, vector<129xf8E5M2>, vector<65xf16>, vector<65xbf16>, vector<33xf32>, vector<17xf64>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_callable_family(%48: vector<32xi1>, %49: vector<1xi1>, %50: vector<64xi8>, %51: vector<64xi8>, %52: vector<1xi8>, %53: vector<32xi16>, %54: vector<32xi16>, %55: vector<1xi16>, %56: vector<32xi32>, %57: vector<1xi32>, %58: vector<16xi64>, %59: vector<1xi64>, %60: vector<64xf8E4M3>, %61: vector<64xf8E4M3>, %62: vector<1xf8E4M3>, %63: vector<64xf8E5M2>, %64: vector<64xf8E5M2>, %65: vector<1xf8E5M2>, %66: vector<64xf16>, %67: vector<1xf16>, %68: vector<64xbf16>, %69: vector<1xbf16>, %70: vector<32xf32>, %71: vector<1xf32>, %72: vector<16xf64>, %73: vector<1xf64>) -> (vector<32xi1>, vector<1xi1>, vector<64xi8>, vector<64xi8>, vector<1xi8>, vector<32xi16>, vector<32xi16>, vector<1xi16>, vector<32xi32>, vector<1xi32>, vector<16xi64>, vector<1xi64>, vector<64xf8E4M3>, vector<64xf8E4M3>, vector<1xf8E4M3>, vector<64xf8E5M2>, vector<64xf8E5M2>, vector<1xf8E5M2>, vector<64xf16>, vector<1xf16>, vector<64xbf16>, vector<1xbf16>, vector<32xf32>, vector<1xf32>, vector<16xf64>, vector<1xf64>) {
  cfg.br ^_bb1(%48: vector<32xi1>, %49: vector<1xi1>, %50: vector<64xi8>, %51: vector<64xi8>, %52: vector<1xi8>, %53: vector<32xi16>, %54: vector<32xi16>, %55: vector<1xi16>, %56: vector<32xi32>, %57: vector<1xi32>, %58: vector<16xi64>, %59: vector<1xi64>, %60: vector<64xf8E4M3>, %61: vector<64xf8E4M3>, %62: vector<1xf8E4M3>, %63: vector<64xf8E5M2>, %64: vector<64xf8E5M2>, %65: vector<1xf8E5M2>, %66: vector<64xf16>, %67: vector<1xf16>, %68: vector<64xbf16>, %69: vector<1xbf16>, %70: vector<32xf32>, %71: vector<1xf32>, %72: vector<16xf64>, %73: vector<1xf64>)
^_bb1(%22: vector<32xi1>, %0: vector<1xi1>, %24: vector<64xi8>, %25: vector<64xi8>, %1: vector<1xi8>, %27: vector<32xi16>, %28: vector<32xi16>, %2: vector<1xi16>, %30: vector<32xi32>, %3: vector<1xi32>, %32: vector<16xi64>, %4: vector<1xi64>, %34: vector<64xf8E4M3>, %35: vector<64xf8E4M3>, %5: vector<1xf8E4M3>, %37: vector<64xf8E5M2>, %38: vector<64xf8E5M2>, %6: vector<1xf8E5M2>, %40: vector<64xf16>, %7: vector<1xf16>, %42: vector<64xbf16>, %8: vector<1xbf16>, %44: vector<32xf32>, %9: vector<1xf32>, %46: vector<16xf64>, %10: vector<1xf64>):
  %i1_value = vector.concat<0> %22, %0 : vector<32xi1>, vector<1xi1> -> vector<33xi1>
  %i8_value = vector.concat<0> %24, %25, %1 : vector<64xi8>, vector<64xi8>, vector<1xi8> -> vector<129xi8>
  %i16_value = vector.concat<0> %27, %28, %2 : vector<32xi16>, vector<32xi16>, vector<1xi16> -> vector<65xi16>
  %i32_value = vector.concat<0> %30, %3 : vector<32xi32>, vector<1xi32> -> vector<33xi32>
  %i64_value = vector.concat<0> %32, %4 : vector<16xi64>, vector<1xi64> -> vector<17xi64>
  %f8e4m3_value = vector.concat<0> %34, %35, %5 : vector<64xf8E4M3>, vector<64xf8E4M3>, vector<1xf8E4M3> -> vector<129xf8E4M3>
  %f8e5m2_value = vector.concat<0> %37, %38, %6 : vector<64xf8E5M2>, vector<64xf8E5M2>, vector<1xf8E5M2> -> vector<129xf8E5M2>
  %f16_value = vector.concat<0> %40, %7 : vector<64xf16>, vector<1xf16> -> vector<65xf16>
  %bf16_value = vector.concat<0> %42, %8 : vector<64xbf16>, vector<1xbf16> -> vector<65xbf16>
  %f32_value = vector.concat<0> %44, %9 : vector<32xf32>, vector<1xf32> -> vector<33xf32>
  %f64_value = vector.concat<0> %46, %10 : vector<16xf64>, vector<1xf64> -> vector<17xf64>
  func.return %22, %0, %24, %25, %1, %27, %28, %2, %30, %3, %32, %4, %34, %35, %5, %37, %38, %6, %40, %7, %42, %8, %44, %9, %46, %10 : vector<32xi1>, vector<1xi1>, vector<64xi8>, vector<64xi8>, vector<1xi8>, vector<32xi16>, vector<32xi16>, vector<1xi16>, vector<32xi32>, vector<1xi32>, vector<16xi64>, vector<1xi64>, vector<64xf8E4M3>, vector<64xf8E4M3>, vector<1xf8E4M3>, vector<64xf8E5M2>, vector<64xf8E5M2>, vector<1xf8E5M2>, vector<64xf16>, vector<1xf16>, vector<64xbf16>, vector<1xbf16>, vector<32xf32>, vector<1xf32>, vector<16xf64>, vector<1xf64>
}

// ====

// Retained calls transport the same packet schema through caller operands,
// callee arguments, call results, and both function result boundaries.
// RUN: pass specialize-target-callgraph,project-boundary-representations,canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def noinline target(@target) @wide_identity(%value: vector<36xf32>) -> (vector<36xf32>) {
  func.return %value : vector<36xf32>
}

func.def public target(@target) @wide_call(%value: vector<36xf32>) -> (vector<36xf32>) {
  %result = func.call noinline @wide_identity(%value) : (vector<36xf32>) -> (vector<36xf32>)
  func.return %result : vector<36xf32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def noinline target(@target) @wide_identity(%12: vector<32xf32>, %13: vector<4xf32>) -> (vector<32xf32>, vector<4xf32>) {
  cfg.br ^_bb1(%12: vector<32xf32>, %13: vector<4xf32>)
^_bb1(%7: vector<32xf32>, %0: vector<4xf32>):
  func.return %7, %0 : vector<32xf32>, vector<4xf32>
}

func.def public target(@target) @wide_call(%16: vector<32xf32>, %17: vector<4xf32>) -> (vector<32xf32>, vector<4xf32>) {
  cfg.br ^_bb1(%16: vector<32xf32>, %17: vector<4xf32>)
^_bb1(%9: vector<32xf32>, %2: vector<4xf32>):
  %5, %6 = func.call pure noinline @wide_identity(%9, %2) : (vector<32xf32>, vector<4xf32>) -> (vector<32xf32>, vector<4xf32>)
  func.return %5, %6 : vector<32xf32>, vector<4xf32>
}

// ====

// Projected function and CFG carriers feed the shared component planner
// directly. Arithmetic keeps the 32-lane packet and four-lane tail rather
// than reconstructing a 36-lane carrier at either branch edge.
// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_cfg_arithmetic(%lhs: vector<36xf32>, %rhs: vector<36xf32>, %condition: i1) -> (vector<36xf32>) {
  cfg.cond_br %condition, ^add, ^subtract
^add:
  %sum = vector.addf %lhs, %rhs : vector<36xf32>
  cfg.br ^join(%sum: vector<36xf32>)
^subtract:
  %difference = vector.subf %lhs, %rhs : vector<36xf32>
  cfg.br ^join(%difference: vector<36xf32>)
^join(%result: vector<36xf32>):
  func.return %result : vector<36xf32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_cfg_arithmetic(%17: vector<32xf32>, %18: vector<4xf32>, %19: vector<32xf32>, %20: vector<4xf32>, %condition: i1) -> (vector<32xf32>, vector<4xf32>) {
  cfg.br ^_bb1(%17: vector<32xf32>, %18: vector<4xf32>, %19: vector<32xf32>, %20: vector<4xf32>, %condition: i1)
^_bb1(%7: vector<32xf32>, %0: vector<4xf32>, %9: vector<32xf32>, %1: vector<4xf32>, %2: i1):
  cfg.cond_br %2, ^_bb2, ^_bb3
^_bb2:
  %24 = vector.addf %7, %9 : vector<32xf32>
  %25 = vector.addf %0, %1 : vector<4xf32>
  cfg.br ^_bb4(%24: vector<32xf32>, %25: vector<4xf32>)
^_bb3:
  %27 = vector.subf %7, %9 : vector<32xf32>
  %28 = vector.subf %0, %1 : vector<4xf32>
  cfg.br ^_bb4(%27: vector<32xf32>, %28: vector<4xf32>)
^_bb4(%11: vector<32xf32>, %6: vector<4xf32>):
  func.return %11, %6 : vector<32xf32>, vector<4xf32>
}

// ====

// Equal-width bitcasts owned by AMDGPU's storage-alias planner packetize with
// the carrier boundary. The wide alias and the reconstruction slices disappear
// together instead of surviving until final Low legality.
// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitcast(%input: vector<64xf32>) -> (vector<64xi32>) {
  %bits = vector.bitcast %input : vector<64xf32> to vector<64xi32>
  func.return %bits : vector<64xi32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitcast(%7: vector<32xf32>, %8: vector<32xf32>) -> (vector<32xi32>, vector<32xi32>) {
  cfg.br ^_bb1(%7: vector<32xf32>, %8: vector<32xf32>)
^_bb1(%3: vector<32xf32>, %0: vector<32xf32>):
  %12 = vector.bitcast %3 : vector<32xf32> to vector<32xi32>
  %14 = vector.bitcast %0 : vector<32xf32> to vector<32xi32>
  func.return %12, %14 : vector<32xi32>, vector<32xi32>
}

// ====

// Packed conversions project both their logical-lane and packed-storage
// widths. Unsigned and signed unpacking retain exact tails, while packing a
// wide logical input produces target-native packed fragments.
// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitunpacku(%packed: vector<65xi8>) -> (vector<65xi32>) {
  %unpacked = vector.bitunpacku<8> %packed : vector<65xi8> -> vector<65xi32>
  func.return %unpacked : vector<65xi32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitunpacku(%8: vector<64xi8>, %9: vector<1xi8>) -> (vector<32xi32>, vector<32xi32>, vector<1xi32>) {
  cfg.br ^_bb1(%8: vector<64xi8>, %9: vector<1xi8>)
^_bb1(%3: vector<64xi8>, %0: vector<1xi8>):
  %21 = vector.slice %3[0] : vector<64xi8> -> vector<32xi8>
  %14 = vector.bitunpacku<8> %21 : vector<32xi8> -> vector<32xi32>
  %20 = vector.slice %3[32] : vector<64xi8> -> vector<32xi8>
  %16 = vector.bitunpacku<8> %20 : vector<32xi8> -> vector<32xi32>
  %18 = vector.bitunpacku<8> %0 : vector<1xi8> -> vector<1xi32>
  func.return %14, %16, %18 : vector<32xi32>, vector<32xi32>, vector<1xi32>
}

// ====

// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitunpacks_tail(%packed: vector<17xi8>) -> (vector<34xi32>) {
  %unpacked = vector.bitunpacks<4> %packed : vector<17xi8> -> vector<34xi32>
  func.return %unpacked : vector<34xi32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitunpacks_tail(%packed: vector<17xi8>) -> (vector<32xi32>, vector<2xi32>) {
  cfg.br ^_bb1(%packed: vector<17xi8>)
^_bb1(%0: vector<17xi8>):
  %8 = vector.slice %0[0] : vector<17xi8> -> vector<16xi8>
  %9 = vector.bitunpacks<4> %8 : vector<16xi8> -> vector<32xi32>
  %10 = vector.slice %0[16] : vector<17xi8> -> vector<1xi8>
  %11 = vector.bitunpacks<4> %10 : vector<1xi8> -> vector<2xi32>
  func.return %9, %11 : vector<32xi32>, vector<2xi32>
}

// ====

// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitpack(%values: vector<64xi32>) -> (vector<32xi8>) {
  %packed = vector.bitpack<4> %values : vector<64xi32> -> vector<32xi8>
  func.return %packed : vector<32xi8>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_bitpack(%5: vector<32xi32>, %6: vector<32xi32>) -> (vector<32xi8>) {
  cfg.br ^_bb1(%5: vector<32xi32>, %6: vector<32xi32>)
^_bb1(%3: vector<32xi32>, %0: vector<32xi32>):
  %9 = vector.bitpack<4> %3 : vector<32xi32> -> vector<16xi8>
  %11 = vector.bitpack<4> %0 : vector<32xi32> -> vector<16xi8>
  %packed = vector.concat<0> %9, %11 : vector<16xi8>, vector<16xi8> -> vector<32xi8>
  func.return %packed : vector<32xi8>
}

// ====

// The complete source pipeline projects nested loop and conditional carriers,
// packetizes the wide read before arithmetic replay, and lets the final store
// consume the transported packet tuple without private staging.
// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @wide_nested_accumulation(%input: buffer, %output: buffer, %iteration_count: index, %scale: f32, %enabled: i1) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<36xf32>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<36xf32>
  %c0 = scalar.constant 0.0 : f32
  %initial = vector.splat %c0 : vector<36xf32>
  %result = scf.for %iteration = [%begin to %iteration_count step %step](%accumulator = %initial : vector<36xf32>) -> (vector<36xf32>) {
    %next = scf.if %enabled -> (vector<36xf32>) {
      %values = vector.load %input_view[0] : view<36xf32> -> vector<36xf32>
      %scales = vector.splat %scale : vector<36xf32>
      %updated = vector.fmaf %values, %scales, %accumulator : vector<36xf32>
      scf.yield %updated : vector<36xf32>
    } else {
      scf.yield %accumulator : vector<36xf32>
    }
    scf.yield %next : vector<36xf32>
  }
  vector.store %result, %output_view[0] : vector<36xf32>, view<36xf32>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_nested_accumulation(%iteration_count: reg<amdgpu.sgpr>, %scale: reg<amdgpu.vgpr>, %enabled: reg<amdgpu.sgpr>) asm {
  %input_view = resource<hal_binding> {extent = 144, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 144, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %93 = v_mov_b32 0
  %125 = concat(%93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93, %93) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x32>
  %130 = concat(%93, %93, %93, %93) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %125: reg<amdgpu.vgpr x32>, %130: reg<amdgpu.vgpr x4>)
^_bb1(%iteration: reg<amdgpu.sgpr>, %85: reg<amdgpu.vgpr x32>, %86: reg<amdgpu.vgpr x4>):
  %131 = s_cmp_lt_i32 %iteration, %iteration_count
  low.cond_br %131, ^_bb2, ^_bb6 : reg<amdgpu.scc>
^_bb2:
  %133 = s_cmp_lg_i32 %enabled, %begin
  low.cond_br %133, ^_bb3, ^_bb4 : reg<amdgpu.scc>
^_bb3:
  %135 = global_load_b128_saddr %93, %input_view
  %137 = global_load_b128_saddr %93, %input_view {offset = 16}
  %139 = global_load_b128_saddr %93, %input_view {offset = 32}
  %141 = global_load_b128_saddr %93, %input_view {offset = 48}
  %143 = global_load_b128_saddr %93, %input_view {offset = 64}
  %145 = global_load_b128_saddr %93, %input_view {offset = 80}
  %147 = global_load_b128_saddr %93, %input_view {offset = 96}
  %149 = global_load_b128_saddr %93, %input_view {offset = 112}
  %151 = concat(%135, %137) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %152 = concat(%139, %141) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %153 = concat(%143, %145) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %154 = concat(%147, %149) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %155 = concat(%151, %152) : (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) -> reg<amdgpu.vgpr x16>
  %156 = concat(%153, %154) : (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) -> reg<amdgpu.vgpr x16>
  %157 = concat(%155, %156) : (reg<amdgpu.vgpr x16>, reg<amdgpu.vgpr x16>) -> reg<amdgpu.vgpr x32>
  %158 = slice %157[0] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %160 = slice %85[0] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %161 = v_fma_f32 %158, %scale, %160
  %162 = slice %157[1] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %164 = slice %85[1] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %165 = v_fma_f32 %162, %scale, %164
