  %185 = v_fma_f32 %182, %scale, %184
  %186 = slice %157[7] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %188 = slice %85[7] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %189 = v_fma_f32 %186, %scale, %188
  %190 = slice %157[8] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %192 = slice %85[8] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %193 = v_fma_f32 %190, %scale, %192
  %194 = slice %157[9] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %196 = slice %85[9] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %197 = v_fma_f32 %194, %scale, %196
  %198 = slice %157[10] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
