func.def @convert_float_to_wide_integer(%half: f16, %halves: vector<2xf16>) -> (i64, i64, vector<2xi64>, vector<2xi64>) {
  %signed = scalar.fptosi %half : f16 to i64
  %unsigned = scalar.fptoui %half : f16 to i64
  %signed_vector = vector.fptosi %halves : vector<2xf16> to vector<2xi64>
  %unsigned_vector = vector.fptoui %halves : vector<2xf16> to vector<2xi64>
  func.return %signed, %unsigned, %signed_vector, %unsigned_vector : i64, i64, vector<2xi64>, vector<2xi64>
}

