  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%buffer_base] : buffer -> view<64xf32>
  %limit = scalar.constant 1.0 : f32
  view.atomic.reduce<minnumf> %limit, %view[%tid] {ordering = relaxed, scope = device} : f32, view<64xf32>
  view.atomic.reduce<maxnumf> %limit, %view[%tid] {ordering = relaxed, scope = device} : f32, view<64xf32>
  %old_min = view.atomic.rmw<minnumf> %limit, %view[%tid] {ordering = relaxed, scope = device} : f32, view<64xf32> -> f32
  %old_max = view.atomic.rmw<maxnumf> %limit, %view[%tid] {ordering = relaxed, scope = device} : f32, view<64xf32> -> f32
  kernel.return
}

