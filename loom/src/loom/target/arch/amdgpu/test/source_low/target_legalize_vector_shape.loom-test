// RUN: pass target-legalize{mode=final,policy=require-native}

amdgpu.target<gfx11-generic> @target

func.def target(@target) @singleton_axis_broadcast(%column: vector<2x1xi32>) -> (vector<2x2xi32>) {
  %tile = vector.broadcast %column : vector<2x1xi32> -> vector<2x2xi32>
  func.return %tile : vector<2x2xi32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def target(@target) @singleton_axis_broadcast(%column: vector<2x1xi32>) -> (vector<2x2xi32>) {
  %3 = vector.bitcast %column : vector<2x1xi32> to vector<2xi32>
  %4 = vector.extract %3[0] : vector<2xi32> -> i32
  %5 = vector.splat %4 : vector<2xi32>
  %6 = vector.extract %3[1] : vector<2xi32> -> i32
  %7 = vector.splat %6 : vector<2xi32>
  %8 = vector.concat<0> %5, %7 : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %tile = vector.bitcast %8 : vector<4xi32> to vector<2x2xi32>
  func.return %tile : vector<2x2xi32>
}

