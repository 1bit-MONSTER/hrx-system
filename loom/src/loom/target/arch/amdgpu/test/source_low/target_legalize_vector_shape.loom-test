// RUN: pass target-legalize{mode=final,policy=require-native},canonicalize,cse

amdgpu.target<gfx11-generic> @target

// Rank-three rectangular decomposition preserves row-major coordinates across
// both outer dimensions, including independently dynamic origins.
func.def target(@target) @strided_rank_three(%source: view<4x5x16xi16>, %plane0: index, %row0: index, %column: index) -> (vector<2x3x4xi16>) {
  %plane = index.assume %plane0 [range(%plane0, 0, 2)] : index
  %row = index.assume %row0 [range(%row0, 0, 2)] : index
  %value = vector.load %source[%plane, %row, %column] : view<4x5x16xi16> -> vector<2x3x4xi16>
  func.return %value : vector<2x3x4xi16>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def target(@target) @strided_rank_three(%source: view<4x5x16xi16>, %plane0: index, %row0: index, %column: index) -> (vector<2x3x4xi16>) {
  %plane = index.assume %plane0 [range(%plane0, 0, 2)] : index
  %row = index.assume %row0 [range(%row0, 0, 2)] : index
  %8 = vector.load %source[%plane, %row, %column] : view<4x5x16xi16> -> vector<4xi16>
  %9 = index.constant 1 : index
  %10 = index.add %row, %9 : index
  %11 = vector.load %source[%plane, %10, %column] : view<4x5x16xi16> -> vector<4xi16>
  %12 = index.constant 2 : index
  %13 = index.add %row, %12 : index
  %14 = vector.load %source[%plane, %13, %column] : view<4x5x16xi16> -> vector<4xi16>
  %16 = index.add %plane, %9 : index
  %17 = vector.load %source[%16, %row, %column] : view<4x5x16xi16> -> vector<4xi16>
  %22 = vector.load %source[%16, %10, %column] : view<4x5x16xi16> -> vector<4xi16>
  %27 = vector.load %source[%16, %13, %column] : view<4x5x16xi16> -> vector<4xi16>
  %30 = vector.concat<0> %8, %11 : vector<4xi16>, vector<4xi16> -> vector<8xi16>
  %31 = vector.concat<0> %14, %17 : vector<4xi16>, vector<4xi16> -> vector<8xi16>
  %32 = vector.concat<0> %22, %27 : vector<4xi16>, vector<4xi16> -> vector<8xi16>
  %33 = vector.concat<0> %30, %31 : vector<8xi16>, vector<8xi16> -> vector<16xi16>
  %34 = vector.concat<0> %33, %32 : vector<16xi16>, vector<8xi16> -> vector<24xi16>
  %value = vector.bitcast %34 : vector<24xi16> to vector<2x3x4xi16>
  func.return %value : vector<2x3x4xi16>
}

