// RUN: pass target-legalize{mode=eager,policy=require-native}

amdgpu.target<gfx11-generic> @target

// Dynamic coordinate arithmetic counts toward the shared expansion bound. A
// high-rank rectangular footprint remains intact when row legalization would
// exceed that bound.
func.def target(@target) @bounded_strided_expansion(%source: view<4x4x4x8xi16>, %batch: index, %plane: index, %row: index, %column: index) -> (vector<3x3x3x2xi16>) {
  %value = vector.load %source[%batch, %plane, %row, %column] : view<4x4x4x8xi16> -> vector<3x3x3x2xi16>
  func.return %value : vector<3x3x3x2xi16>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def target(@target) @bounded_strided_expansion(%source: view<4x4x4x8xi16>, %batch: index, %plane: index, %row: index, %column: index) -> (vector<3x3x3x2xi16>) {
  %value = vector.load %source[%batch, %plane, %row, %column] : view<4x4x4x8xi16> -> vector<3x3x3x2xi16>
  func.return %value : vector<3x3x3x2xi16>
}
