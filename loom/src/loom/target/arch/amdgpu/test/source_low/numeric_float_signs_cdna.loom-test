func.def @vector_f32_4_signs(%magnitude: vector<4xf32>, %sign: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %absolute = vector.absf %magnitude : vector<4xf32>
  %negated = vector.negf %magnitude : vector<4xf32>
  %copied = vector.copysignf %magnitude, %sign : vector<4xf32>
  func.return %absolute, %negated, %copied : vector<4xf32>, vector<4xf32>, vector<4xf32>
}

