// RUN: emit source-low target=amdgpu:gfx9-4-generic output=low

func.def @scalar_f32_signs(%magnitude: f32, %sign: f32) -> (f32, f32, f32) {
  %absolute = scalar.absf %magnitude : f32
  %negated = scalar.negf %magnitude : f32
  %copied = scalar.copysignf %magnitude, %sign : f32
  func.return %absolute, %negated, %copied : f32, f32, f32
}

// ----
low.func.def target<amdgpu.gfx9_4.generic.core> abi(hal_kernel) @scalar_f32_signs(%magnitude: reg<amdgpu.vgpr>, %sign: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %absolute = v_and_b32_lit %magnitude, 2147483647
  %negated = v_xor_b32_lit %magnitude, 2147483648
  %15 = s_mov_b32 2147483647
  %copied = v_bfi_b32 %15, %magnitude, %sign
  return %absolute, %negated, %copied
}

