// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Exercise the first lane beyond each operation-family storage limit for every
// scalar element type with an AMDGPU vector register representation.

func.def @i1_boundary(%body: vector<32xi1>, %tail: vector<1xi1>) -> (vector<33xi1>) {
  %result = vector.concat<0> %body, %tail : vector<32xi1>, vector<1xi1> -> vector<33xi1>
  func.return %result : vector<33xi1>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i1_boundary(%body: reg<amdgpu.sgpr x64>, %tail: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x66>) asm {
  %result = concat(%body, %tail) : (reg<amdgpu.sgpr x64>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x66>
  return %result
}

