low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @not_nan_e5_to_bfloat() asm {
  %source = resource<hal_binding> {extent = 1, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %not_nan = global_load_i8_saddr %13, %source
  %15 = v_and_b32_lit %not_nan, 255
  %16 = v_and_b32_lit %15, 128
  %17 = v_lshlrev_b32_src0_inline %16, 8
  %18 = v_and_b32_lit %15, 127
  %19 = v_lshl_add_u32_shift_imm_src2_lit %18 {shift = 5, imm32 = 14336}
  %20 = v_lshlrev_b32_src0_inline %18, 1
  %21 = v_add_u32_src0_inline %20, 1
  %22 = v_lshl_add_u32_shift_imm %21, %20, 8
  %23 = s_mov_b32 931135488
  %24 = s_mov_b32 943732736
  %25 = v_perm_b32 %24, %23, %22
  %26 = v_and_b32_lit %25, 65535
  %27 = v_cmp_lt_u32_src1_inline %18 {rhs = 4}
  %28 = v_cndmask_b32 %19, %26, %27
  %29 = v_or_b32 %17, %28
  %30 = v_or_b32_lit %17, 32640
  %31 = v_mov_b32 124
  %32 = v_cmp_eq_i32 %18, %31
  %33 = v_cndmask_b32 %29, %30, %32
  %34 = v_and_b32_lit %33, 65535
  %36 = v_lshlrev_b32_src0_inline %34, 16
  %converted = v_or_b32 %34, %36
  global_store_b32_saddr %13, %converted, %result
  return
}

