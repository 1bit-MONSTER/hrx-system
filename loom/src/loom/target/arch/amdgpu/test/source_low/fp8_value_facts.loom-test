  %17 = v_lshl_add_u32_shift_imm_src2_lit %16 {shift = 5, imm32 = 14336}
  %18 = v_lshlrev_b32_src0_inline %16, 1
  %19 = v_add_u32_src0_inline %18, 1
  %20 = v_lshl_add_u32_shift_imm %19, %18, 8
  %21 = s_mov_b32 931135488
  %22 = s_mov_b32 943732736
  %23 = v_perm_b32 %22, %21, %20
  %24 = v_and_b32_lit %23, 65535
  %25 = v_cmp_lt_u32_src1_inline %16 {rhs = 4}
  %26 = v_cndmask_b32 %17, %24, %25
  %27 = v_lshlrev_b32_src0_inline %15, 8
  %28 = v_bfi_b32_src0_lit %27, %26, 32768
  %29 = v_and_b32_lit %28, 65535
  %31 = v_lshlrev_b32_src0_inline %29, 16
  %converted = v_or_b32 %29, %31
