func.def @not_nan_e5_to_bfloat(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xf8E5M2>
  %result = buffer.view %output[%base] : buffer -> view<2xbf16>
  %raw = view.load %source[0] : view<1xf8E5M2> -> f8E5M2
  %not_nan = scalar.assume %raw [not_nan(%raw)] : f8E5M2
  %packed = vector.splat %not_nan : vector<2xf8E5M2>
  %converted = vector.extf %packed : vector<2xf8E5M2> to vector<2xbf16>
  vector.store %converted, %result[0] : vector<2xbf16>, view<2xbf16>
  func.return
}

