  %17 = v_mov_b32_copy %lhs
  %18 = v_mov_b32_copy %rhs
  %condition = v_cmp_lt_i32 %17, %18
  %selected = v_cndmask_b32 %false_value, %true_value, %condition
  %21 = v_and_b32_lit %selected, 2139062143
  %22 = v_and_b32_lit %bias, 2139062143
  %23 = v_add_u32 %21, %22
  %24 = v_xor_b32 %selected, %bias
  %25 = v_and_b32_lit %24, 2155905152
  %result = v_xor_b32 %23, %25
  return %result
}

