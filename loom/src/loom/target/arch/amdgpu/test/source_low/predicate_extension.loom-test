// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_extension_i32(%condition: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %14 = s_mov_b32 4294967295
  %15 = s_mov_b32 0
  %16 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %signed = s_cselect_b32 %14, %15, %16
  %18 = s_mov_b32 1
  %19 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %unsigned = s_cselect_b32 %18, %15, %19
  return %signed, %unsigned
}

