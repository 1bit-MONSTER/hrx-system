// TEMPLATE: loom/src/loom/test/corpus/source_low/predicate_extension.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @predicate_extension_i8(%condition: i1) -> (i8, i8) {
  %signed = scalar.extsi %condition : i1 to i8
  %unsigned = scalar.extui %condition : i1 to i8
  func.return %signed, %unsigned : i8, i8
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_extension_i8(%condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %14 = v_mov_b32 4294967295
  %15 = v_mov_b32 0
  %signed = v_cndmask_b32 %15, %14, %condition
  %17 = v_mov_b32 1
  %unsigned = v_cndmask_b32 %15, %17, %condition
  return %signed, %unsigned
}

// ====

