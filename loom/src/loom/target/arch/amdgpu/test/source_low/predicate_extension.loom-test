  %signed = scalar.extsi %condition : i1 to i64
  %unsigned = scalar.extui %condition : i1 to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_extension_i64(%condition: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %14 = s_mov_b32 4294967295
  %17 = s_mov_b32 0
  %20 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %23 = s_cselect_b32 %14, %17, %20
  %signed = concat(%23, %23) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %28 = s_mov_b32 1
  %31 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %34 = s_cselect_b32 %28, %17, %31
  %37 = s_cselect_b32 %17, %17, %31
  %unsigned = concat(%34, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %signed, %unsigned
}
