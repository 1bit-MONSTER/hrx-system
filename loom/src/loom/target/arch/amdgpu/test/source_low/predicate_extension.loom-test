low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_extension_i16(%condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
