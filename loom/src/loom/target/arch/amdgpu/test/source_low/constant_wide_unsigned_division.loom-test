// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_remainder(%value: i64) -> (i64) {
  %divisor = scalar.constant 7 : i64
  %result = scalar.remui %value, %divisor : i64
  func.return %result : i64
}

