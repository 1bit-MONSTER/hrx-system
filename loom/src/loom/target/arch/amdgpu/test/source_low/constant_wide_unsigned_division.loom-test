low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_remainder(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %6 = s_mov_b32 2454267027
  %7 = s_mov_b32 613566756
  %9 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = s_mov_b32 0
  %14 = s_mul_hi_u32 %9, %6
  %15 = s_mul_i32 %11, %6
  %16 = s_mul_hi_u32 %11, %6
  %23, %24 = s_add_co_u32 %15, %14
  %25, %26 = s_addc_u32 %16, %13, %24
  %30 = s_mul_i32 %9, %7
  %31 = s_mul_hi_u32 %9, %7
  %38, %39 = s_add_co_u32 %30, %23
  %40, %41 = s_addc_u32 %31, %13, %39
  %45 = s_mul_i32 %11, %7
  %46 = s_mul_hi_u32 %11, %7
  %53, %54 = s_add_co_u32 %45, %25
  %55, %56 = s_addc_u32 %46, %13, %54
  %63, %64 = s_add_co_u32 %53, %40
  %65, %66 = s_addc_u32 %55, %13, %64
  %72, %73 = s_sub_co_u32 %9, %63
  %74, %75 = s_subb_u32 %11, %65, %73
  %76 = concat(%72, %74) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %77 = s_mov_b32 1
  %78 = s_lshr_b64 %76, %77
  %79 = slice %78[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %80 = slice %78[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %83, %84 = s_add_co_u32 %79, %63
  %85, %86 = s_addc_u32 %80, %65, %84
  %87 = concat(%83, %85) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %88 = s_mov_b32 2
  %89 = s_lshr_b64 %87, %88
  %90 = s_mov_b32 7
  %93 = slice %89[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %94 = slice %89[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %97 = s_mul_i32 %93, %90
  %98 = s_mul_hi_u32 %93, %90
  %99 = s_mul_i32 %93, %13
  %100 = s_mul_i32 %94, %90
  %101 = s_add_u32 %98, %99
  %102 = s_add_u32 %101, %100
  %108, %109 = s_sub_co_u32 %9, %97
  %110, %111 = s_subb_u32 %11, %102, %109
  %result = concat(%108, %110) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @varying_quotient(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %divisor = scalar.constant 3 : i64
  %result = scalar.divui %value, %divisor : i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_quotient(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %8 = v_mov_b32 2863311531
  %9 = v_mov_b32 2863311530
  %73 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %72 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_mov_b32 0
  %16 = v_mul_hi_u32 %73, %8
  %17 = v_mul_lo_u32 %72, %8
  %18 = v_mul_hi_u32 %72, %8
  %25, %26 = v_add_co_u32 %17, %16
  %27, %28 = v_addc_co_u32 %18, %15, %26
  %32 = v_mul_lo_u32 %73, %9
  %33 = v_mul_hi_u32 %73, %9
  %40, %41 = v_add_co_u32 %32, %25
  %42, %43 = v_addc_co_u32 %33, %15, %41
  %47 = v_mul_lo_u32 %72, %9
  %48 = v_mul_hi_u32 %72, %9
  %55, %56 = v_add_co_u32 %47, %27
  %57, %58 = v_addc_co_u32 %48, %15, %56
  %65, %66 = v_add_co_u32 %55, %42
  %67, %68 = v_addc_co_u32 %57, %15, %66
  %69 = concat(%65, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %70 = v_mov_b32 1
  %result = v_lshrrev_b64 %70, %69
  return %result
}
