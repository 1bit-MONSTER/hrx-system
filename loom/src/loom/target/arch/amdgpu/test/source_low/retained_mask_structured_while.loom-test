// A body read survives to the before-region write on the next iteration.
// RUN: emit low-allocation-json @condition_retains_mask fixed=%mask:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @condition_retains_mask(%condition: reg<amdgpu.scc>, %value: reg<amdgpu.vgpr>) asm {
  low.scf.while {
    %scratch = s_mov_b32 1
    low.scf.condition %condition : reg<amdgpu.scc>
  } do {
    %mask = v_cmp_eq_i32 %value, %value
    %selected = v_cndmask_b32 %value, %value, %mask
    low.scf.yield
  }
  return
}

