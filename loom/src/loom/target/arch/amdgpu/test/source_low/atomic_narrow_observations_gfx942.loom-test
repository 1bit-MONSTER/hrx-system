// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_narrow_observations.loom-test
// RUN: emit source-low target=amdgpu:gfx942 output=low

// Exact-width observations share the memory-ordering contract of wider cells.
func.def @narrow_atomic_observations(%storage: buffer, %byte: i8, %half: i16, %float: f16, %brain: bf16) -> (i32, i32, f16, bf16) {
  %base = index.constant 1 : offset
  %aligned_base = index.constant 2 : offset
  %bytes = index.constant 4 : offset
  %global = buffer.assume.memory_space<global> %storage : buffer
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %scratch = buffer.alloca<workgroup> align(2) %bytes : buffer
  %byte_view = buffer.view %global[%base] : buffer -> view<1xi8>
  %half_view = buffer.view %scratch[%aligned_base] : buffer -> view<1xi16>
  %float_view = buffer.view %generic[%aligned_base] : buffer -> view<1xf16>
  %brain_view = buffer.view %global[%aligned_base] : buffer -> view<1xbf16>
  view.atomic.store %byte, %byte_view[0] {ordering = release, scope = system} : i8, view<1xi8>
  %old_byte = view.atomic.load %byte_view[0] {ordering = acquire, scope = system} : view<1xi8> -> i8
  view.atomic.store %half, %half_view[0] {ordering = relaxed, scope = workgroup} : i16, view<1xi16>
  %old_half = view.atomic.load %half_view[0] {ordering = relaxed, scope = workgroup} : view<1xi16> -> i16
  view.atomic.store %float, %float_view[0] {ordering = seq_cst, scope = system} : f16, view<1xf16>
  %old_float = view.atomic.load %float_view[0] {ordering = seq_cst, scope = system} : view<1xf16> -> f16
  view.atomic.store %brain, %brain_view[0] {ordering = relaxed, scope = device} : bf16, view<1xbf16>
  %old_brain = view.atomic.load %brain_view[0] {ordering = relaxed, scope = device} : view<1xbf16> -> bf16
  %signed_byte = scalar.extsi %old_byte : i8 to i32
  %unsigned_half = scalar.extui %old_half : i16 to i32
  func.return %signed_byte, %unsigned_half, %old_float, %old_brain : i32, i32, f16, bf16
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @narrow_atomic_observations(%byte: reg<amdgpu.vgpr>, %half: reg<amdgpu.vgpr>, %float: reg<amdgpu.vgpr>, %brain: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %brain_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %34 = storage {byte_alignment = 2, byte_length = 4} : low.storage<workgroup>
  s_waitcnt {lgkmcnt = 0}
  buffer_wbl2 {sc0 = 1, sc1 = 1}
  s_waitcnt {vmcnt = 0}
  %36 = v_mov_b32 0
  global_store_b8_saddr<volatile> %36, %byte, %brain_view {offset = 1, sc0 = 1, sc1 = 1}
  %signed_byte = global_load_sbyte_saddr<volatile> %36, %brain_view {offset = 1, sc0 = 1, sc1 = 1}
  s_waitcnt {vmcnt = 0}
  buffer_inv {sc0 = 1, sc1 = 1}
  ds_write_b16<volatile> %36, %half {offset = 2}
  %41 = ds_read_u16<volatile> %36 {offset = 2}
  %old_half = v_bfe_i32_offset_width_inline %41 {offset = 0, width = 16}
  s_waitcnt {lgkmcnt = 0}
  buffer_wbl2 {sc0 = 1, sc1 = 1}
  s_waitcnt {vmcnt = 0}
  %43 = slice %brain_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %44 = slice %brain_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = v_mov_b32_copy %43
  %46 = v_mov_b32_copy %44
  %47 = concat(%45, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_short<volatile> %47, %float {offset = 2, sc0 = 1, sc1 = 1}
  s_waitcnt {lgkmcnt = 0}
  buffer_wbl2 {sc0 = 1, sc1 = 1}
  s_waitcnt {vmcnt = 0}
  %52 = concat(%45, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old_float = flat_load_ushort<volatile> %52 {offset = 2, sc0 = 1, sc1 = 1} : reg<amdgpu.vgpr>
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  buffer_inv {sc0 = 1, sc1 = 1}
  global_store_short_saddr<volatile> %36, %brain, %brain_view {offset = 2, sc1 = 1}
  %old_brain = global_load_ushort_saddr<volatile> %36, %brain_view {offset = 2, sc1 = 1}
  %unsigned_half = v_and_b32_lit %old_half, 65535
  return %signed_byte, %unsigned_half, %old_float, %old_brain
}
