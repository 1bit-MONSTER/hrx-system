// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @trunci_i16x31_i8x31(%input: vector<31xi16>) -> (vector<31xi8>) {
  %result = vector.trunci %input : vector<31xi16> to vector<31xi8>
  func.return %result : vector<31xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @trunci_i16x31_i8x31(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  set.saturation 0
  set.pack-size 1
  %5 = vpack.w.trunc %input
  %6 = slice %input[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %result = concat(%5, %6) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %result
}

