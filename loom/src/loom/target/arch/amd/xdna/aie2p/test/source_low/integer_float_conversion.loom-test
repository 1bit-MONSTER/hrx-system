// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @sitofp_i8_bf16_4(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<4xi8>
  %target = buffer.view %output[%base] : buffer -> view<4xbf16>
  %value = vector.load %source[0] : view<4xi8> -> vector<4xi8>
  %converted = vector.sitofp %value : vector<4xi8> to vector<4xbf16>
  vector.store %converted, %target[0] : vector<4xbf16>, view<4xbf16>
  func.return
}

// ----
CHECK: *convert.signed.i32.to.f32*
CHECK: *st.s16 *, *, 6

// ====

func.def @uitofp_i8_f16_3(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %target = buffer.view %output[%base] : buffer -> view<3xf16>
  %value = vector.load %source[0] : view<3xi8> -> vector<3xi8>
  %converted = vector.uitofp %value : vector<3xi8> to vector<3xf16>
  vector.store %converted, %target[0] : vector<3xf16>, view<3xf16>
  func.return
}

// ----
CHECK: *convert.signed.i32.to.f32*
CHECK: *st.s16 *, *, 4

