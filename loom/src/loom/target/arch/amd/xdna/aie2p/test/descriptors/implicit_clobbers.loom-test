// RUN: with-checks emit low-allocation-json @predicate_across_max

// A predicate live across the fused maximum occupies storage outside its fixed
// comparison output, including aliases through the scalar register file.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @predicate_across_max(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %predicate = vlt.s8x64 %left, %right
  %maximum = max.s8x64 %left, %right
  %selected = vsel.8 %maximum, %right, %predicate
  return %selected
}

// ----
CHECK: *"spill_count":0,*"name":"predicate"*"location":{"kind":"physical_register","base":180,"count":1}*

// ====

// RUN: with-checks emit low-allocation-json @predicate_before_max

// The predicate dies at the select, so the following maximum may overwrite its
// physical register without reducing the available predicate inventory.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @predicate_before_max(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %predicate = vlt.s8x64 %left, %right
  %selected = vsel.8 %left, %right, %predicate
  %maximum = max.s8x64 %selected, %right
  return %maximum
}

// ----
CHECK: *"spill_count":0,*"name":"predicate"*"location":{"kind":"physical_register","base":179,"count":1}*

// ====

// RUN: with-checks emit low-allocation-json @predicate_after_max

// Predicate storage is reusable after the fixed comparison write.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @predicate_after_max(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %maximum = max.s8x64 %left, %right
  %predicate = vlt.s8x64 %maximum, %right
  %selected = vsel.8 %maximum, %right, %predicate
  return %selected
}

// ----
CHECK: *"spill_count":0,*"name":"predicate"*"location":{"kind":"physical_register","base":179,"count":1}*

// ====

// RUN: with-checks emit low-allocation-json @partial_predicate_clobber

// A 32-bit implicit comparison output also conflicts with its 64-bit predicate
// alias while that predicate remains live.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @partial_predicate_clobber(%predicate: reg<aie2p.elpredicate>, %left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %maximum = max.s16x32 %left, %right
  %selected = vsel.8 %maximum, %right, %predicate
  return %selected
}

// ----
CHECK: *"spill_count":0,*"name":"predicate"*"location":{"kind":"physical_register","base":180,"count":1}*

// ====

// RUN: with-checks emit low-allocation-json @predicate_in_disjoint_branch

// A write in a mutually exclusive branch does not occupy storage in the live
// predicate branch; sparse liveness permits the fixed register to be reused.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @predicate_in_disjoint_branch(%condition: reg<aie2p.er>, %left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %predicate = vlt.s8x64 %left, %right
  low.cond_br %condition, ^maximum_path, ^selection_path : reg<aie2p.er>
^maximum_path:
  %maximum = max.s8x64 %left, %right
  return %maximum
^selection_path:
  %selected = vsel.8 %left, %right, %predicate
  return %selected
}

// ----
CHECK: *"spill_count":0,*"name":"predicate"*"location":{"kind":"physical_register","base":179,"count":1}*
