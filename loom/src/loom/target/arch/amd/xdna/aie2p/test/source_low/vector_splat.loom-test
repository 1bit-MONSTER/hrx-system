// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @wide_i8_splat(%value: i8) -> (vector<128xi8>) {
  %result = vector.splat %value : vector<128xi8>
  func.return %result : vector<128xi8>
}

// ----
CHECK: * = vbcst.8 %value
CHECK: %result = concat(*, *) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
CHECK: return %result
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

func.def @shaped_partial_f32_splat(%value: f32) -> (vector<2x15xf32>) {
  %result = vector.splat %value : vector<2x15xf32>
  func.return %result : vector<2x15xf32>
}

// ----
CHECK: * = vbcst.32 %value
CHECK: %result = concat(*, *) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
CHECK: return %result
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

func.def @wide_i64_splat(%value: i64) -> (vector<16xi64>) {
  %result = vector.splat %value : vector<16xi64>
  func.return %result : vector<16xi64>
}

// ----
CHECK: * = vbcst.64 %value
CHECK: %result = concat(*, *) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
CHECK: return %result
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*
