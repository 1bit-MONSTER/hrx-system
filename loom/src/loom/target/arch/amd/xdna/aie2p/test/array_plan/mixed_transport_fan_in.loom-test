// RUN: with-checks emit aie2p-array-plan @fan_in

// The reducer reads one ring directly through its south memory window and
// another through DMA into local memory. Only the latter needs two rings.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @fan_in() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %three = constant.u32 3 : reg<aie2p.array.scalar : index>
  %four = constant.u32 4 : reg<aie2p.array.scalar : index>
  %producers = group %two
  %reducers = group %one
  %near = worker %producers, %zero, @produce
  %far = worker %producers, %one, @produce
  %reducer = worker %reducers, %zero, @reduce
  %output = binding 0, "write"

  %near_output = sender %near, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %far_output = sender %far, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %near_input = receiver %reducer, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %far_input = receiver %reducer, 1 : reg<aie2p.array.receiver : tile<1xi32>>
  %sum = sender %reducer, 2 : reg<aie2p.array.sender : tile<1xi32>>
  %result = receiver %output, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %near_channel = channel %near_output, %near_input, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  %far_channel = channel %far_output, %far_input, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  %output_channel = channel %sum, %result, %two, %one : reg<aie2p.array.channel : tile<1xi32>>

  constrain.location %near, %zero, %two
  constrain.location %reducer, %zero, %three
  constrain.location %far, %one, %four
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @produce() asm {
  %output = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = mov.short 7
  st %value, %output, 0
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @reduce() asm {
  %near = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %far = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %lhs = lda %near, 0
  %rhs = lda %far, 0
  %sum = add.rr %lhs, %rhs
  st %sum, %output, 0
  return
}

// ----
CHECK: channel index=0 transport=neighbor-memory record-bytes=4 capacity=2 records=1 sender=worker[0]:0 receiver=worker[2]:0
CHECK: channel index=1 transport=routed-dma record-bytes=4 capacity=2 records=1 sender=worker[1]:0 receiver=worker[2]:1
CHECK: slot channel=0 index=0 owner=(0,2) offset=0x00000 bytes=4 sender=0x70000 receiver=0x40000
CHECK: slot channel=0 index=1 owner=(0,2) offset=0x04000 bytes=4 sender=0x74000 receiver=0x44000
CHECK: slot channel=1 index=0 bytes=4 sender-owner=(1,4) * receiver-owner=(0,3) *
CHECK: slot channel=1 index=1 bytes=4 sender-owner=(1,4) * receiver-owner=(0,3) *
CHECK: dma channel=1 tile=(1,4) side=compute direction=memory-to-stream *
CHECK: dma channel=1 tile=(0,3) side=compute direction=stream-to-memory *
CHECK-NOT: dma channel=0 *
