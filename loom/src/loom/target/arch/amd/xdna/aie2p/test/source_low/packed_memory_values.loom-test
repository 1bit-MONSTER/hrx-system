// TEMPLATE-EXCLUDE: @uniform_f16 The target math policy does not admit FP16 vector addition.
// TEMPLATE-EXCLUDE: @uniform_f8E4M3 FP8 packet widening is covered by focused conversion and memory owner tests.
// TEMPLATE-EXCLUDE: @uniform_f8E5M2 FP8 packet widening is covered by focused conversion and memory owner tests.
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Indexed vector elements preserve byte codes through integer promotion.
func.def @uniform_table(%input: buffer, %codebook: buffer, %output: buffer, %position: index) {
  %aligned = buffer.assume.alignment %codebook {minimum_alignment = 64} : buffer
  %source, %table_source, %destination = buffer.assume.noalias %input, %aligned, %output : buffer, buffer, buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<32x4xi8>
  %input_values = vector.load %source_view[%position, 0] : view<32x4xi8> -> vector<4xi8>
  %mask = vector.constant 15 : vector<4xi8>
  %indices = vector.andi %input_values, %mask : vector<4xi8>
  %table_view = buffer.view %table_source[%c0] : buffer -> view<16xi8>
  %table = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  %output_view = buffer.view %destination[%c0] : buffer -> view<32x4xi8>
  vector.store %values, %output_view[%position, 0] : vector<4xi8>, view<32x4xi8>
  func.return
}

