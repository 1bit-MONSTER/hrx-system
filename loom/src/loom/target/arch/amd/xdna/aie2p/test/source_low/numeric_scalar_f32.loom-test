// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @scalar_f32_sign_bits(%input: f32) -> (f32, f32) {
  %negated = scalar.negf %input : f32
  %absolute = scalar.absf %input : f32
  func.return %negated, %absolute : f32, f32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_f32_sign_bits(%input: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %8 = mov.i32 -2147483648
  %negated = xor %input, %8
  %10 = mov.i32 2147483647
  %absolute = and %input, %10
  return %negated, %absolute
}

// ====

func.def @vector_f32_sign_bits(%input: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %negated = vector.negf %input : vector<4xf32>
  %absolute = vector.absf %input : vector<4xf32>
  func.return %negated, %absolute : vector<4xf32>, vector<4xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @vector_f32_sign_bits(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %8 = mov.i32 -2147483648
  %9 = vbcst.32 %8
  %10 = vbor %input, %9
  %11 = vband %input, %9
  %negated = vsub.32 %10, %11
  %13 = mov.i32 2147483647
  %14 = vbcst.32 %13
  %absolute = vband %input, %14
  return %negated, %absolute
}
