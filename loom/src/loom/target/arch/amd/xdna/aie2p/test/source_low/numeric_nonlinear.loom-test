func.def @nonlinear_selection(%scalar: f32, %vector: vector<4xf32>) -> (f32, vector<4xf32>, f32, vector<4xf32>, f32, vector<4xf32>, f32, f32, f32, f32, f32, f32) {
  %scalar_exp = scalar.expf<afn> %scalar : f32
  %vector_exp = vector.expf<afn> %vector : vector<4xf32>
  %scalar_exp2 = scalar.exp2f<afn> %scalar : f32
  %vector_exp2 = vector.exp2f<afn> %vector : vector<4xf32>
  %scalar_tanh = scalar.tanhf<afn> %scalar : f32
  %vector_tanh = vector.tanhf<afn> %vector : vector<4xf32>
  %sqrt = scalar.sqrtf<afn> %scalar : f32
  %rsqrt = scalar.rsqrtf<afn> %scalar : f32
  %sin = scalar.sinf<afn> %scalar : f32
  %cos = scalar.cosf<afn> %scalar : f32
  %sin_turns = scalar.sinturnsf<afn> %scalar : f32
  %cos_turns = scalar.costurnsf<afn> %scalar : f32
  func.return %scalar_exp, %vector_exp, %scalar_exp2, %vector_exp2, %scalar_tanh, %vector_tanh, %sqrt, %rsqrt, %sin, %cos, %sin_turns, %cos_turns : f32, vector<4xf32>, f32, vector<4xf32>, f32, vector<4xf32>, f32, f32, f32, f32, f32, f32
}

