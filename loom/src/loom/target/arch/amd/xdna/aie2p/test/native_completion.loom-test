// Terminal destinations have no reader whose completion could retire their DMA.

aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @terminal_distribution() run(%input_arg: buffer) {
  %input = buffer.assume.alignment %input_arg {minimum_alignment = 4} : buffer
  %source_memory = pipeline.memory<workgroup>[0, 1] : pool
  %left_memory = pipeline.memory<workgroup>[0, 3] : pool
  %right_memory = pipeline.memory<workgroup>[0, 4] : pool
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %source_storage = buffer.alloca<workgroup> pool(%source_memory) align(4) %bytes : buffer
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<1x1xi32>
  %source = channel.bind<fifo> %source_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %left_storage = buffer.alloca<workgroup> pool(%left_memory) align(4) %bytes : buffer
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x1xi32>
  %left = channel.bind<fifo> %left_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %right_storage = buffer.alloca<workgroup> pool(%right_memory) align(4) %bytes : buffer
  %right_slots = buffer.view %right_storage[%origin] : buffer -> view<1x1xi32>
  %right = channel.bind<fifo> %right_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external = buffer.view %input[%origin] : buffer -> view<1xi32>
    %write, %payload = channel.reserve %source : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %read, %payload = channel.acquire %source : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %left_read, %right_read = channel.fanout %read : read<tile<1xi32>> -> (read<tile<1xi32>>, read<tile<1xi32>>)
    %left_write, %left_payload = channel.reserve %left : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %right_write, %right_payload = channel.reserve %right : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    channel.copy %left_read -> %left_write : read<tile<1xi32>>, write<tile<1xi32>>
    channel.copy %right_read -> %right_write : read<tile<1xi32>>, write<tile<1xi32>>
  }
}

