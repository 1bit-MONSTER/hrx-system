  %53 = vbcst.32 %42
  %54 = mov.short 1
  %55 = copy %54 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %56 = vinsert.32.reg %53, %55, %47
  %57 = mov.short 2
  %58 = copy %57 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %result = vinsert.32.reg %56, %58, %52
