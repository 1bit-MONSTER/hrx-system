  %64 = copy %63 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %65 = sel.nez %47, %sentinel, %64
  %66 = ltu.select %61, %65
  %67 = sel.nez %61, %65, %66
  %68 = vextract.32.imm %values, 3
