func.def @i64x16_insert_static(%values: vector<16xi64>, %value: i64) -> (vector<16xi64>) {
  %result = vector.insert %value into %values[1] : i64, vector<16xi64>
  func.return %result : vector<16xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x16_insert_static(%values: reg<aie2p.vec256 x4>, %value: reg<aie2p.er x2>) -> (reg<aie2p.vec256 x4>) asm {
  %11 = slice %values[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %12 = mov.short 1
  %13 = copy %12 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %14 = vinsert.64.reg %11, %13, %value
  %15 = slice %values[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %result = concat(%14, %15) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %result
}

