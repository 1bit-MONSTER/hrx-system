func.def @i64x16_insert_dynamic(%values: vector<16xi64>, %value: i64, %position: index) -> (vector<16xi64>) {
  %result = vector.insert %value into %values[%position] : i64, vector<16xi64>
  func.return %result : vector<16xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x16_insert_dynamic(%values: reg<aie2p.vec256 x4>, %value: reg<aie2p.er x2>, %position: reg<aie2p.er>) -> (reg<aie2p.vec256 x4>) asm {
  %19 = mov.short 8
  %20 = ltu %position, %19
  %21 = slice %values[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %22 = copy %position : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %23 = vinsert.64.reg %21, %22, %value
  %24 = select.mask %20, -1
  %25 = vsel.32 %23, %21, %24
  %26 = slice %values[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %27 = sub %position, %19
  %28 = copy %27 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %29 = vinsert.64.reg %26, %28, %value
  %30 = select.mask %20, -1
  %31 = vsel.32 %26, %29, %30
  %result = concat(%25, %31) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %result
}

