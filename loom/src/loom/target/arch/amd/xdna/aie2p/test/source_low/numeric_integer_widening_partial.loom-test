}

// ----
CHECK: low.func.def * @extui_i8x17_i32x17(*) *
CHECK: * = vups.4x.w-to-c.unsigned *
CHECK: %result = concat(*)*
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*
CHECK-NOT: *vshift*

