// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// A logical packet below 256 bits is padded into one physical dot4i packet.
func.def @dot4i_u8s8_low_packet(%lhs: vector<16xi8>, %rhs: vector<16xi8>, %acc: vector<4xi32>) -> (vector<4xi32>) {
  %dot = vector.dot4i<u8s8> %lhs, %rhs, %acc : vector<16xi8>, vector<16xi8>, vector<4xi32>
  func.return %dot : vector<4xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @dot4i_u8s8_low_packet(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>, %acc: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %9 = mova.i32 0
  %10 = vbcst.8 %9
  %11 = slice %10[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %12 = mova.i32 46
  %13 = mova.i32 10
  %14 = mova.i32 584
  %15 = slice %lhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %16 = concat(%15, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %17 = vshuffle %16, %10, %12
  %18 = slice %rhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %19 = concat(%18, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %20 = vshuffle %19, %10, %12
  %21 = slice %17[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %22 = concat(%21, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %23 = vshuffle %20, %20, %13
  %24 = vmov.512 %23
  %25 = concat(%23, %24) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %26 = dot4i.i8x64 %25, %22, %14
  %27 = slice %26[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %28 = vmov.accumulator512.to.vector512 %27
  %29 = slice %28[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %30 = concat(%29, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %dot = vadd.32 %30, %acc
  return %dot
}

// ====

// The widest logical dot4i shape uses both physical input chunks.
func.def @dot4i_u8s8_wide_packet(%lhs: vector<64xi8>, %rhs: vector<64xi8>, %acc: vector<16xi32>) -> (vector<16xi32>) {
  %dot = vector.dot4i<u8s8> %lhs, %rhs, %acc : vector<64xi8>, vector<64xi8>, vector<16xi32>
  func.return %dot : vector<16xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @dot4i_u8s8_wide_packet(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>, %acc: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %9 = mova.i32 0
  %10 = vbcst.8 %9
  %11 = slice %10[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %12 = mova.i32 46
  %13 = mova.i32 10
  %14 = mova.i32 584
  %15 = slice %lhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %16 = concat(%15, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %17 = vshuffle %16, %10, %12
  %18 = slice %rhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %19 = concat(%18, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %20 = vshuffle %19, %10, %12
  %21 = slice %17[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %22 = concat(%21, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %23 = vshuffle %20, %20, %13
  %24 = vmov.512 %23
  %25 = concat(%23, %24) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %26 = dot4i.i8x64 %25, %22, %14
  %27 = slice %26[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %28 = vmov.accumulator512.to.vector512 %27
  %29 = slice %28[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %30 = slice %lhs[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %31 = concat(%30, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %32 = vshuffle %31, %10, %12
  %33 = slice %rhs[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %34 = concat(%33, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %35 = vshuffle %34, %10, %12
  %36 = slice %32[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %37 = concat(%36, %11) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %38 = vshuffle %35, %35, %13
  %39 = vmov.512 %38
  %40 = concat(%38, %39) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %41 = dot4i.i8x64 %40, %37, %14
  %42 = slice %41[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %43 = vmov.accumulator512.to.vector512 %42
  %44 = slice %43[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %45 = concat(%29, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %dot = vadd.32 %45, %acc
  return %dot
}

// ====

// AIE2P has no native dot8i4 instruction. This mixed-signedness case keeps the
// complete scalar extraction, sign extension, and accumulation fallback exact.
func.def @dot8i4_s4u4_fallback(%lhs: vector<1xi32>, %rhs: vector<1xi32>, %acc: vector<1xi32>) -> (vector<1xi32>) {
  %dot = vector.dot8i4<s4u4> %lhs, %rhs, %acc : vector<1xi32>
  func.return %dot : vector<1xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @dot8i4_s4u4_fallback(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>, %acc: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %76 = vextract.32.imm %lhs, 0
  %77 = vextract.32.imm %rhs, 0
  %78 = vextract.32.imm %acc, 0
  %79 = mov.short 15
  %80 = mov.short 28
  %81 = and %76, %79
  %82 = lshl %81, %80
  %83 = mov.short -28
  %84 = ashl %82, %83
  %85 = and %77, %79
  %86 = copy %78 : reg<aie2p.er> -> reg<aie2p.er>
  %87 = mac %86, %84, %85
  %88 = mov.short -4
  %89 = lshl %76, %88
  %90 = and %89, %79
  %91 = lshl %90, %80
  %93 = ashl %91, %83
  %95 = lshl %77, %88
  %96 = and %95, %79
  %97 = copy %87 : reg<aie2p.er> -> reg<aie2p.er>
  %98 = mac %97, %93, %96
  %99 = mov.short -8
  %100 = lshl %76, %99
  %101 = and %100, %79
  %102 = lshl %101, %80
  %104 = ashl %102, %83
  %106 = lshl %77, %99
  %107 = and %106, %79
  %108 = copy %98 : reg<aie2p.er> -> reg<aie2p.er>
  %109 = mac %108, %104, %107
  %110 = mov.short -12
  %111 = lshl %76, %110
  %112 = and %111, %79
  %113 = lshl %112, %80
  %115 = ashl %113, %83
  %117 = lshl %77, %110
  %118 = and %117, %79
  %119 = copy %109 : reg<aie2p.er> -> reg<aie2p.er>
  %120 = mac %119, %115, %118
  %121 = mov.short -16
  %122 = lshl %76, %121
  %123 = and %122, %79
  %124 = lshl %123, %80
  %126 = ashl %124, %83
  %128 = lshl %77, %121
  %129 = and %128, %79
  %130 = copy %120 : reg<aie2p.er> -> reg<aie2p.er>
  %131 = mac %130, %126, %129
  %132 = mov.short -20
  %133 = lshl %76, %132
  %134 = and %133, %79
  %135 = lshl %134, %80
  %137 = ashl %135, %83
  %139 = lshl %77, %132
  %140 = and %139, %79
  %141 = copy %131 : reg<aie2p.er> -> reg<aie2p.er>
  %142 = mac %141, %137, %140
  %143 = mov.short -24
  %144 = lshl %76, %143
  %145 = and %144, %79
  %146 = lshl %145, %80
  %148 = ashl %146, %83
  %150 = lshl %77, %143
  %151 = and %150, %79
  %152 = copy %142 : reg<aie2p.er> -> reg<aie2p.er>
  %153 = mac %152, %148, %151
  %155 = lshl %76, %83
  %156 = lshl %155, %80
  %158 = ashl %156, %83
  %160 = lshl %77, %83
  %161 = copy %153 : reg<aie2p.er> -> reg<aie2p.er>
  %162 = mac %161, %158, %160
  %dot = vbcst.32 %162
  return %dot
}
