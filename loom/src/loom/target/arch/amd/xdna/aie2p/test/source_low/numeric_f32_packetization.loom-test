  %114 = slice %113[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %115 = vmov.accumulator512.to.vector512 %114
  %116 = mova.i32 5
  %117 = vshuffle.to.accumulator512 %115, %115, %116
  %118 = copy %117 : reg<aie2p.mbmsm> -> reg<aie2p.mbms>
  %119 = concat(%118, %89, %90, %91) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %120 = vadd.f32x64 %113, %119, %78
  %121 = slice %120[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %122 = vmov.accumulator512.to.vector512 %121
  %result = vextract.32.imm %122, 0
  return %result
}
