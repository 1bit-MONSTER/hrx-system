  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %captured = scf.for %position = [%begin to %count step %step](%carried = %values : vector<32xf32>) -> (vector<32xf32>) {
    %next = vector.maxnumf<nnan|ninf|nsz> %carried, %values : vector<32xf32>
    scf.yield %next : vector<32xf32>
  }
  %initial = scalar.constant -32768.0 : f32
  %result = vector.reduce<maxnumf, reassoc|nnan|ninf|nsz> %captured, %initial : vector<32xf32>, f32
  func.return %result : f32
}

