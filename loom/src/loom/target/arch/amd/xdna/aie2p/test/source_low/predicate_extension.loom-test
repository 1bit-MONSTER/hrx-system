// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @predicate_extension_i64(%condition: reg<aie2p.er>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %14 = mov.i32 -1
  %17 = mov.i32 0
  %24 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %25 = sel.nez %14, %17, %24
  %26 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %27 = sel.nez %14, %17, %26
  %signed = concat(%25, %27) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %29 = mov.i32 1
  %36 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %37 = sel.nez %29, %17, %36
  %38 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %39 = sel.nez %17, %17, %38
  %unsigned = concat(%37, %39) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %signed, %unsigned
}
