// TEMPLATE: loom/src/loom/test/corpus/source_low/predicate_extension.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @predicate_extension_i8(%condition: i1) -> (i8, i8) {
  %signed = scalar.extsi %condition : i1 to i8
  %unsigned = scalar.extui %condition : i1 to i8
  func.return %signed, %unsigned : i8, i8
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @predicate_extension_i8(%condition: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %14 = mov.short -1
  %15 = mov.short 0
  %16 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %signed = sel.nez %14, %15, %16
  %18 = mov.short 1
  %19 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %unsigned = sel.nez %18, %15, %19
  return %signed, %unsigned
}

// ====

