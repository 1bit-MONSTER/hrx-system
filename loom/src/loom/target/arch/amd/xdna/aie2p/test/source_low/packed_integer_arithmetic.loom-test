// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i8x8_bitwise_storage_tuple(%lhs: vector<8xi8>, %rhs: vector<8xi8>) -> (vector<8xi8>, vector<8xi8>, vector<8xi8>) {
  %and = vector.andi %lhs, %rhs : vector<8xi8>
  %or = vector.ori %lhs, %rhs : vector<8xi8>
  %xor = vector.xori %lhs, %rhs : vector<8xi8>
  func.return %and, %or, %xor : vector<8xi8>, vector<8xi8>, vector<8xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x8_bitwise_storage_tuple(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %and = vband %lhs, %rhs
  %or = vbor %lhs, %rhs
  %xor = vsub.8 %or, %and
  return %and, %or, %xor
}

// ====

func.def @i16x4_bitwise_storage_tuple(%lhs: vector<4xi16>, %rhs: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>, vector<4xi16>) {
  %and = vector.andi %lhs, %rhs : vector<4xi16>
  %or = vector.ori %lhs, %rhs : vector<4xi16>
  %xor = vector.xori %lhs, %rhs : vector<4xi16>
  func.return %and, %or, %xor : vector<4xi16>, vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_bitwise_storage_tuple(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %and = vband %lhs, %rhs
  %or = vbor %lhs, %rhs
  %xor = vsub.16 %or, %and
  return %and, %or, %xor
}

// ====

func.def @i16x4_add_sub_storage_tuple(%lhs: vector<4xi16>, %rhs: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>) {
  %sum = vector.addi %lhs, %rhs : vector<4xi16>
  %diff = vector.subi %lhs, %rhs : vector<4xi16>
  func.return %sum, %diff : vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_add_sub_storage_tuple(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %sum = vadd.16 %lhs, %rhs
  %diff = vsub.16 %lhs, %rhs
  return %sum, %diff
}

// ====

func.def @i16x4_mul_minmax_storage_tuple(%lhs: vector<4xi16>, %rhs: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<4xi16>) {
  %product = vector.muli %lhs, %rhs : vector<4xi16>
  %smin = vector.minsi %lhs, %rhs : vector<4xi16>
  %smax = vector.maxsi %lhs, %rhs : vector<4xi16>
  %umin = vector.minui %lhs, %rhs : vector<4xi16>
  %umax = vector.maxui %lhs, %rhs : vector<4xi16>
  func.return %product, %smin, %smax, %umin, %umax : vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_mul_minmax_storage_tuple(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %19 = mova.i32 858
  %20 = mov.shift 0
  %21 = vmul.i16x32 %lhs, %rhs, %19
  set.rounding 0
  set.srs-mode 1
  set.saturation 0
  %product = vsrs.trunc.s16x32 %21, %20
  %smin = min.s16x32 %lhs, %rhs
  %smax = max.s16x32 %lhs, %rhs
  %umin = min.u16x32 %lhs, %rhs
  %umax = max.u16x32 %lhs, %rhs
  return %product, %smin, %smax, %umin, %umax
}

// ====

func.def @i16x4_shift_storage_tuple(%value: vector<4xi16>, %shift: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>, vector<4xi16>) {
  %left = vector.shli %value, %shift : vector<4xi16>
  %signed_right = vector.shrsi %value, %shift : vector<4xi16>
  %unsigned_right = vector.shrui %value, %shift : vector<4xi16>
  func.return %left, %signed_right, %unsigned_right : vector<4xi16>, vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_shift_storage_tuple(%value: reg<aie2p.vec256 x2>, %shift: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %13 = mov.short 1
  %14 = vbcst.16 %13
  set.saturation 0
  set.ups-mode 0
  set.srs-mode 0
  set.rounding 0
  %15 = mov.shift 1
  %16 = vups.2x.x-to-c.unsigned %value, %15
  %17 = mov.shift 0
  %18 = vsrs.2x.c-to-x.unsigned %16, %17
  %19 = vband %shift, %14
  %20 = veqz.16.el.low32 %19
  %21 = predicate.complete.zero.high32 %20, 0
  %22 = vsel.16.mask64 %18, %value, %21
  %23 = vadd.16 %14, %14
  %24 = mov.shift 2
  %25 = vups.2x.x-to-c.unsigned %22, %24
  %26 = vsrs.2x.c-to-x.unsigned %25, %17
  %27 = vband %shift, %23
  %28 = veqz.16.el.low32 %27
  %29 = predicate.complete.zero.high32 %28, 0
  %30 = vsel.16.mask64 %26, %22, %29
  %31 = vadd.16 %23, %23
  %32 = mov.shift 4
  %33 = vups.2x.x-to-c.unsigned %30, %32
  %34 = vsrs.2x.c-to-x.unsigned %33, %17
  %35 = vband %shift, %31
  %36 = veqz.16.el.low32 %35
  %37 = predicate.complete.zero.high32 %36, 0
  %38 = vsel.16.mask64 %34, %30, %37
  %39 = vadd.16 %31, %31
  %40 = mov.shift 8
  %41 = vups.2x.x-to-c.unsigned %38, %40
  %42 = vsrs.2x.c-to-x.unsigned %41, %17
  %43 = vband %shift, %39
  %44 = veqz.16.el.low32 %43
  %45 = predicate.complete.zero.high32 %44, 0
  %left = vsel.16.mask64 %42, %38, %45
  %50 = vups.2x.x-to-c.signed %value, %17
  %52 = vsrs.2x.c-to-x.signed %50, %15
  %54 = veqz.16.el.low32 %19
  %55 = predicate.complete.zero.high32 %54, 0
  %56 = vsel.16.mask64 %52, %value, %55
  %58 = vups.2x.x-to-c.signed %56, %17
  %60 = vsrs.2x.c-to-x.signed %58, %24
  %62 = veqz.16.el.low32 %27
  %63 = predicate.complete.zero.high32 %62, 0
  %64 = vsel.16.mask64 %60, %56, %63
  %66 = vups.2x.x-to-c.signed %64, %17
  %68 = vsrs.2x.c-to-x.signed %66, %32
  %70 = veqz.16.el.low32 %35
  %71 = predicate.complete.zero.high32 %70, 0
  %72 = vsel.16.mask64 %68, %64, %71
  %74 = vups.2x.x-to-c.signed %72, %17
  %76 = vsrs.2x.c-to-x.signed %74, %40
  %78 = veqz.16.el.low32 %43
  %79 = predicate.complete.zero.high32 %78, 0
  %signed_right = vsel.16.mask64 %76, %72, %79
  %84 = vups.2x.x-to-c.unsigned %value, %17
  %86 = vsrs.2x.c-to-x.unsigned %84, %15
  %88 = veqz.16.el.low32 %19
  %89 = predicate.complete.zero.high32 %88, 0
  %90 = vsel.16.mask64 %86, %value, %89
  %92 = vups.2x.x-to-c.unsigned %90, %17
  %94 = vsrs.2x.c-to-x.unsigned %92, %24
  %96 = veqz.16.el.low32 %27
  %97 = predicate.complete.zero.high32 %96, 0
  %98 = vsel.16.mask64 %94, %90, %97
  %100 = vups.2x.x-to-c.unsigned %98, %17
  %102 = vsrs.2x.c-to-x.unsigned %100, %32
  %104 = veqz.16.el.low32 %35
  %105 = predicate.complete.zero.high32 %104, 0
  %106 = vsel.16.mask64 %102, %98, %105
  %108 = vups.2x.x-to-c.unsigned %106, %17
  %110 = vsrs.2x.c-to-x.unsigned %108, %40
  %112 = veqz.16.el.low32 %43
  %113 = predicate.complete.zero.high32 %112, 0
  %unsigned_right = vsel.16.mask64 %110, %106, %113
  return %left, %signed_right, %unsigned_right
}

// ====

func.def @i16x4_bitcast_mul_maxui_chain(%packed: vector<2xi32>, %scale: vector<4xi16>, %limit: vector<4xi16>) -> (vector<4xi16>) {
  %lanes = vector.bitcast %packed : vector<2xi32> to vector<4xi16>
  %product = vector.muli %lanes, %scale : vector<4xi16>
  %result = vector.maxui %product, %limit : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_bitcast_mul_maxui_chain(%lanes: reg<aie2p.vec256 x2>, %scale: reg<aie2p.vec256 x2>, %limit: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %11 = mova.i32 858
  %12 = mov.shift 0
  %13 = vmul.i16x32 %lanes, %scale, %11
  set.rounding 0
  set.srs-mode 1
  set.saturation 0
  %product = vsrs.trunc.s16x32 %13, %12
  %result = max.u16x32 %product, %limit
  return %result
}

// ====

func.def @i16x4_select_xori(%lhs: i32, %rhs: i32, %true_value: vector<4xi16>, %false_value: vector<4xi16>, %mask: vector<4xi16>) -> (vector<4xi16>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %predicate = vector.splat %condition : vector<4xi1>
  %selected = vector.select %predicate, %true_value, %false_value : vector<4xi16>
  %result = vector.xori %selected, %mask : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_select_xori(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec256 x2>, %false_value: reg<aie2p.vec256 x2>, %mask: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %condition = lt %lhs, %rhs
  %18 = select.mask %condition, -1
  %selected = vsel.32 %true_value, %false_value, %18
  %20 = vbor %selected, %mask
  %21 = vband %selected, %mask
  %result = vsub.16 %20, %21
  return %result
}

// ====

func.def @i16x4_cfg_arg_andi(%lhs: i32, %rhs: i32, %true_value: vector<4xi16>, %false_value: vector<4xi16>, %mask: vector<4xi16>) -> (vector<4xi16>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^join(%true_value: vector<4xi16>)
^else:
  cfg.br ^join(%false_value: vector<4xi16>)
^join(%selected: vector<4xi16>):
  %result = vector.andi %selected, %mask : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x4_cfg_arg_andi(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec256 x2>, %false_value: reg<aie2p.vec256 x2>, %mask: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %condition = lt %lhs, %rhs
  low.cond_br %condition, ^then, ^else : reg<aie2p.er>
^then:
  low.br ^join(%true_value: reg<aie2p.vec256 x2>)
^else:
  low.br ^join(%false_value: reg<aie2p.vec256 x2>)
^join(%selected: reg<aie2p.vec256 x2>):
  %result = vband %selected, %mask
  return %result
}
