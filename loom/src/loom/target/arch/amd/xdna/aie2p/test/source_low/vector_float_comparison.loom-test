CHECK-NOT: * = vinsert.*

// ====

func.def @f16_le(%lhs: vector<32xf16>, %rhs: vector<32xf16>) -> (vector<32xi1>, vector<32xi1>) {
  %ordered = vector.cmpf ole, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  %unordered = vector.cmpf ule, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
