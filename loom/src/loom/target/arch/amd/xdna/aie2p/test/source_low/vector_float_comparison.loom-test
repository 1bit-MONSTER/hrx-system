// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

// Ordered predicates clear NaN lanes; their unordered partners set them. Each
// pair below also exercises one numeric relation over a full F16 carrier.
func.def @f16_eq(%lhs: vector<32xf16>, %rhs: vector<32xf16>) -> (vector<32xi1>, vector<32xi1>) {
  %ordered = vector.cmpf oeq, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  %unordered = vector.cmpf ueq, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  func.return %ordered, %unordered : vector<32xi1>, vector<32xi1>
}

// ----
CHECK: low.func.def * @f16_eq(*) *
CHECK: * = mov.i32 31744
CHECK: * = veqz.16*
CHECK: %ordered = predicate.xor.high32.rhs_tied *
CHECK: %unordered = predicate.or.high32.rhs_tied *
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

func.def @f16_gt(%lhs: vector<32xf16>, %rhs: vector<32xf16>) -> (vector<32xi1>, vector<32xi1>) {
  %ordered = vector.cmpf ogt, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  %unordered = vector.cmpf ugt, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  func.return %ordered, %unordered : vector<32xi1>, vector<32xi1>
}

// ----
CHECK: low.func.def * @f16_gt(*) *
CHECK: * = vlt.u16x32* *, *
CHECK: %ordered = predicate.xor.high32.rhs_tied *
CHECK: %unordered = predicate.or.high32.rhs_tied *
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

func.def @f16_ge(%lhs: vector<32xf16>, %rhs: vector<32xf16>) -> (vector<32xi1>, vector<32xi1>) {
  %ordered = vector.cmpf oge, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  %unordered = vector.cmpf uge, %lhs, %rhs : vector<32xf16> -> vector<32xi1>
  func.return %ordered, %unordered : vector<32xi1>, vector<32xi1>
}

// ----
CHECK: low.func.def * @f16_ge(*) *
CHECK: * = vge.u16x32* *, *
CHECK: %ordered = predicate.xor.high32.rhs_tied *
CHECK: %unordered = predicate.or.high32.rhs_tied *
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

