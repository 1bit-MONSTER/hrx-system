  %246 = mov.short 0
  %247 = mov.short 1
  %payload = mov.local-address 458752
  %width = mov.short 2
  low.br ^_bb1(%246: reg<aie2p.er>)
^_bb1(%record: reg<aie2p.er>):
  %251 = lt %record, %245
