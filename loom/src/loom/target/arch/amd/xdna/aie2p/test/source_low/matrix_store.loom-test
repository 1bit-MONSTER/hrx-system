  %43 = mov.address-index %42
  vst.acc.index %41, %view, %43
  %44 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %45 = mov.static-byte-offset 576
  %46 = mov.address-index %45
  vst.acc.index %44, %view, %46
  %47 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %48 = mov.static-byte-offset 640
  %49 = mov.address-index %48
  vst.acc.index %47, %view, %49
  %50 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %51 = mov.static-byte-offset 704
  %52 = mov.address-index %51
  vst.acc.index %50, %view, %52
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @store_dynamic(%value: reg<aie2p.mbms x4>, %base: reg<aie2p.er>) asm {
