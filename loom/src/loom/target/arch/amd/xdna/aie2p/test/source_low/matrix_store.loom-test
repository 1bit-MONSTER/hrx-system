  %57 = mov.address-index %base
  vst.acc.index %56, %view, %57
  %58 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %59 = add.address-index.immediate %base, 64
  vst.acc.index %58, %view, %59
  %60 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %61 = mov.static-byte-offset 128
  %62 = add.address-index %base, %61
  vst.acc.index %60, %view, %62
  %63 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %64 = mov.static-byte-offset 192
