// RUN: with-checks emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @cmp_i8_matrix(%lhs: vector<64xi8>, %rhs: vector<64xi8>) -> (vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>) {
  %eq = vector.cmpi eq, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %ne = vector.cmpi ne, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %slt = vector.cmpi slt, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %sle = vector.cmpi sle, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %sgt = vector.cmpi sgt, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %sge = vector.cmpi sge, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %ult = vector.cmpi ult, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %ule = vector.cmpi ule, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %ugt = vector.cmpi ugt, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %uge = vector.cmpi uge, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>, vector<64xi1>
}

// ----
CHECK: low.func.def * @cmp_i8_matrix(*) *
CHECK: %eq = veqz.8 *
CHECK: %ne = predicate.or.high32.rhs_tied *
CHECK: %slt = vlt.s8x64 %lhs, %rhs
CHECK: %sle = vge.s8x64 %rhs, %lhs
CHECK: %sgt = vlt.s8x64 %rhs, %lhs
CHECK: %sge = vge.s8x64 %lhs, %rhs
CHECK: * = vlt.u8x64 %lhs, %rhs
CHECK: %ule = vge.u8x64 %rhs, %lhs
CHECK: * = vlt.u8x64 %rhs, %lhs
CHECK: %uge = vge.u8x64 %lhs, %rhs
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

