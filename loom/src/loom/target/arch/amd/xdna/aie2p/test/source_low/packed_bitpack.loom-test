// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i32x4_to_i8x4_bitpack(%codes: vector<4xi32>) -> (vector<4xi8>) {
  %packed = vector.bitpack<8> %codes : vector<4xi32> -> vector<4xi8>
  func.return %packed : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32x4_to_i8x4_bitpack(%codes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %12 = mova.i32 2
  %13 = vshuffle %codes, %codes, %12
  %14 = mova.i32 0
  %15 = vshuffle %13, %13, %14
  %16 = vextract.32.imm %15, 0
  %packed = vbcst.32 %16
  return %packed
}

