  %33 = lshl %30, %21
  %34 = add.rr %32, %33
  %35 = mov.short 1
  %36 = mov.short 0
  %37 = sub %36, %35
  %38 = lshl %34, %37
  %39 = mul %38, %divisor
  %remainder = sub %value, %39
  %mask = mov.i32 2147483647
  %position = and %value, %mask
  %44 = mov.i32 1431655766
  %47 = and %position, %20
  %48 = lshl %position, %21
  %49 = and %44, %20
  %50 = lshl %44, %21
  %51 = mul %47, %49
  %52 = lshl %51, %21
  %53 = mac %52, %48, %49
  %54 = and %53, %20
  %55 = mac %54, %47, %50
  %56 = lshl %53, %21
  %57 = mac %56, %48, %50
  %58 = lshl %55, %21
  %59 = add.rr %57, %58
  %60 = mul %59, %divisor
  %index_remainder = sub %position, %60
  return %remainder, %index_remainder
}

