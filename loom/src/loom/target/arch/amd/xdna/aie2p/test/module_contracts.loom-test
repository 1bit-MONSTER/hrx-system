// RUN: verify

aie2p.target<array> @array_target

low.func.def target<amd.xdna.aie2p.array>(@array_target) @wrong_entry() asm {
  return
}

low.func.def target<amd.xdna.aie2p.array>(@array_target) @bad_fold_entry() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %one
  // ERROR@+1: TARGET/079 {function_name="bad_fold_entry", descriptor_key="amd.xdna.aie2p.array.worker.fold", immediate_name="entry", symbol_name="wrong_entry", actual_contract="amd.xdna.aie2p.array", expected_contract="amd.xdna.aie2p.core"}
  %worker = worker.fold %workers, %zero, %one, @wrong_entry, 0, 1, "addf", 0
  return
}

