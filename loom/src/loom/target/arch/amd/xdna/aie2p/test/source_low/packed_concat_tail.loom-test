// TEMPLATE: loom/src/loom/test/corpus/source_low/packed_concat_tail.loom-test
// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @i8_terminal_tail(%body: vector<32xi8>, %tail: vector<1xi8>) -> (vector<33xi8>) {
  %result = vector.concat<0> %body, %tail : vector<32xi8>, vector<1xi8> -> vector<33xi8>
  func.return %result : vector<33xi8>
}

// ----
CHECK: %result = concat(*)* -> reg<aie2p.vec256 x2>
CHECK: return %result
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

