CHECK: array @worker_branch_first family=amd.xdna.npu2 groups=2 workers=2 bindings=2 channels=3 slots=6 locks=6 dma=5 routes=11
CHECK: dma channel=0 tile=(0,4) side=compute direction=memory-to-stream engine-channel=0 bd-start=0 bd-count=2
CHECK: dma channel=0 tile=(0,2) side=compute direction=stream-to-memory engine-channel=0 bd-start=0 bd-count=2
CHECK: dma channel=2 tile=(0,2) side=compute direction=memory-to-stream engine-channel=0 bd-start=2 bd-count=2
CHECK: route channel=0 tile=(0,4) kind=switch source=dma[0] destination=south[0]
CHECK: route channel=0 tile=(0,3) kind=switch source=north[0] destination=south[0]
CHECK: route channel=0 tile=(0,2) kind=switch source=north[0] destination=dma[0]
CHECK: route channel=1 tile=(0,2) kind=switch source=north[0] destination=south[0]
CHECK: route channel=1 tile=(0,1) kind=switch source=north[0] destination=south[0]
CHECK: route channel=1 tile=(0,0) kind=switch source=north[0] destination=south[2]
CHECK: route channel=1 tile=(0,0) kind=shim-mux source=north[2] destination=dma[0]
CHECK: route channel=2 tile=(0,2) kind=switch source=dma[0] destination=south[1]
CHECK: route channel=2 tile=(0,1) kind=switch source=north[1] destination=south[1]
CHECK: route channel=2 tile=(0,0) kind=switch source=north[1] destination=south[3]
