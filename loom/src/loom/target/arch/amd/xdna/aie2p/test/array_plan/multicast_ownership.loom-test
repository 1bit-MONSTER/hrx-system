// RUN: with-checks emit aie2p-array-plan @worker_branch_first

// One worker's physical stream feeds an external binding and another worker.
// The worker branch establishes the source; both share the downward prefix.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @worker_branch_first() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 3 : reg<aie2p.array.scalar : index>
  %writer_row = constant.u32 4 : reg<aie2p.array.scalar : index>
  %reader_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %writers = group %one
  %readers = group %one
  %writer = worker %writers, %zero, @write_value
  %reader = worker %readers, %zero, @copy_value
  %direct_output = binding 0, "write"
  %copied_output = binding 1, "write"
  %source = sender %writer, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %direct_sink = receiver %direct_output, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %reader_input = receiver %reader, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %reader_output = sender %reader, 1 : reg<aie2p.array.sender : tile<1xi32>>
  %copied_sink = receiver %copied_output, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %worker_channel = channel %source, %reader_input, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  %external_channel = channel %source, %direct_sink, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  %copied_channel = channel %reader_output, %copied_sink, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %writer, %zero, %writer_row
  constrain.location %reader, %zero, %reader_row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @write_value() asm {
  %output = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = mov.short 7
  st %value, %output, 0
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @copy_value() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %value = lda %input, 0
  st %value, %output, 0
  return
}

