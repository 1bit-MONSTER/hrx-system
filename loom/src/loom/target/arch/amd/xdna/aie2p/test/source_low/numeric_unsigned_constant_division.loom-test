  %16 = lshl %10, %12
  %17 = mul %13, %15
  %18 = lshl %17, %12
  %19 = mac %18, %14, %15
  %20 = and %19, %11
  %21 = mac %20, %13, %16
  %22 = lshl %19, %12
  %23 = mac %22, %14, %16
  %24 = lshl %21, %12
  %25 = add.rr %23, %24
  %26 = mov.short 4
  %27 = mov.short 0
  %28 = sub %27, %26
  %quotient = lshl %25, %28
  %38 = lshl %17, %12
  %39 = mac %38, %14, %15
  %40 = and %39, %11
  %41 = mac %40, %13, %16
  %42 = lshl %39, %12
  %43 = mac %42, %14, %16
  %44 = lshl %41, %12
  %45 = add.rr %43, %44
  %48 = sub %27, %26
  %49 = lshl %45, %48
  %50 = mul %49, %divisor
  %remainder = sub %input, %50
  return %quotient, %remainder
}

