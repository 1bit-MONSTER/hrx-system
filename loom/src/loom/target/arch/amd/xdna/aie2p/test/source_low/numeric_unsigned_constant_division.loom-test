// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @pair_by_twenty(%input: i32) -> (i32, i32) {
  %divisor = scalar.constant 20 : i32
  %quotient = scalar.divui %input, %divisor : i32
  %remainder = scalar.remui %input, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @pair_by_twenty(%input: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %divisor = mov.short 20
  %16 = mov.i32 -858993459
  %17 = mov.i32 65535
  %18 = mov.short -16
  %19 = and %input, %17
  %20 = lshl %input, %18
  %21 = and %16, %17
  %22 = lshl %16, %18
  %23 = mul %19, %21
  %24 = lshl %23, %18
  %25 = mac %24, %20, %21
  %26 = and %25, %17
  %27 = mac %26, %19, %22
  %28 = lshl %25, %18
  %29 = mac %28, %20, %22
  %30 = lshl %27, %18
  %31 = add.rr %29, %30
  %32 = mov.short 4
  %33 = mov.short 0
  %34 = sub %33, %32
  %quotient = lshl %31, %34
  %36 = mul %quotient, %divisor
  %remainder = sub %input, %36
  return %quotient, %remainder
}

