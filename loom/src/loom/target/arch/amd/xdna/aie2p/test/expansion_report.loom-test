// RUN: compile-report target=amd.xdna.aie2p:core source-to-low

// Source flags permit fast math but do not imply that the selected rule is
// compact. Retain the emitted count alongside a native addition control.
func.def @multiply_add(%lhs: f32, %rhs: f32, %bias: f32, %value: i32, %increment: i32) -> (f32, i32) {
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %lhs, %rhs : f32
  %result = scalar.addf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %product, %bias : f32
  %next = scalar.addi %value, %increment : i32
  func.return %result, %next : f32, i32
}

