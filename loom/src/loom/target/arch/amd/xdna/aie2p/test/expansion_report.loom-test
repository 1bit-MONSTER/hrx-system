// RUN: compile-report target=amd.xdna.aie2p:core source-to-low

// Source flags permit fast math but do not imply that the selected rule is
// compact. Retain the emitted counts alongside native addition and subtraction
// controls.
func.def @scalar_arithmetic_expansion(%lhs: f32, %rhs: f32, %bias: f32, %value: i32, %increment: i32) -> (f32, i32) {
  %sum = scalar.addf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %lhs, %rhs : f32
  %difference = scalar.subf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %sum, %bias : f32
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %difference, %rhs : f32
  %result = scalar.fmaf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %product, %rhs, %bias : f32
  %next = scalar.addi %value, %increment : i32
  func.return %result, %next : f32, i32
}

