// RUN: pass target=amd.xdna.aie2p:core entry=@proves_index_arithmetic_conditions licm

// AIE2P selects a 32-bit index carrier. Shift counts through 31 are valid,
// while a count of 32 and mathematical results outside the signed carrier
// remain guarded.
func.def @proves_index_arithmetic_conditions(%n: index, %value: index, %fit_input: index, %overflow_input: index, %small_input: index, %count_input: index, %wide_count_input: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.assume %count_input [range(%count_input, 0, 3)] : index
  %wide_count = index.assume %wide_count_input [range(%wide_count_input, 32, 32)] : index
  %fit = index.assume %fit_input [range(%fit_input, -268435456, 268435455)] : index
  %overflow = index.assume %overflow_input [range(%overflow_input, -1073741825, 268435455)] : index
  %small = index.assume %small_input [range(%small_input, -1024, 1024)] : index
  scf.for %iv = [%begin to %n step %step] {
    %left = index.shli %fit, %count : index
    %left_overflow = index.shli %overflow, %count : index
    %arithmetic = index.shrsi %value, %count : index
    %logical = index.shrui %value, %count : index
    %wide = index.shrui %value, %wide_count : index
    %addition = index.add %fit, %fit : index
    %addition_overflow = index.add %overflow, %overflow : index
    %subtraction = index.sub %fit, %fit : index
    %multiplication = index.mul %small, %small : index
    %multiply_add = index.madd %small, %small, %small : index
    test.use %left, %left_overflow, %arithmetic, %logical, %wide, %addition, %addition_overflow, %subtraction, %multiplication, %multiply_add : index, index, index, index, index, index, index, index, index, index
  }
  func.return
}

// ----
func.def @proves_index_arithmetic_conditions(%n: index, %value: index, %fit_input: index, %overflow_input: index, %small_input: index, %count_input: index, %wide_count_input: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.assume %count_input [range(%count_input, 0, 3)] : index
  %wide_count = index.assume %wide_count_input [range(%wide_count_input, 32, 32)] : index
  %fit = index.assume %fit_input [range(%fit_input, -268435456, 268435455)] : index
  %overflow = index.assume %overflow_input [range(%overflow_input, -1073741825, 268435455)] : index
  %small = index.assume %small_input [range(%small_input, -1024, 1024)] : index
  %left = index.shli %fit, %count : index
  %arithmetic = index.shrsi %value, %count : index
  %logical = index.shrui %value, %count : index
  %addition = index.add %fit, %fit : index
  %subtraction = index.sub %fit, %fit : index
  %multiplication = index.mul %small, %small : index
  %multiply_add = index.madd %small, %small, %small : index
  scf.for %iv = [%begin to %n step %step] {
    %left_overflow = index.shli %overflow, %count : index
    %wide = index.shrui %value, %wide_count : index
    %addition_overflow = index.add %overflow, %overflow : index
    test.use %left, %left_overflow, %arithmetic, %logical, %wide, %addition, %addition_overflow, %subtraction, %multiplication, %multiply_add : index, index, index, index, index, index, index, index, index, index
  }
  func.return
}
