// TEMPLATE: loom/src/loom/test/corpus/source_low/layout_predicate_extract.loom-test
// TEMPLATE-EXCLUDE: @predicate_tail_slice XDNA predicate extraction requires a scalar result.
// TEMPLATE-EXCLUDE: @multidimensional_predicate_element XDNA predicate extraction requires a rank-one source.
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// A singleton predicate vector and its only element share the same mask.
func.def @single_predicate(%input: vector<1xi1>) -> (i1) {
  %result = vector.extract %input[0] : vector<1xi1> -> i1
  func.return %result : i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @single_predicate(%input: reg<aie2p.elpredicate>) -> (reg<aie2p.er>) asm {
  %5 = mov.short 1
  %6 = vbcst.8 %5
  %7 = vsub.8 %6, %6
  %8 = vsel.8 %7, %6, %input
  %result = vextract.8.imm %8, 0
  return %result
}

// ====

func.def @predicate_lanes(%input: vector<4xi1>) -> (i1, i1) {
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  func.return %first, %last : i1, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @predicate_lanes(%input: reg<aie2p.elpredicate>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %8 = mov.short 1
  %9 = vbcst.8 %8
  %10 = vsub.8 %9, %9
  %11 = vsel.8 %10, %9, %input
  %first = vextract.8.imm %11, 0
  %last = vextract.8.imm %11, 3
  return %first, %last
}

// ====

// Both consumers use the original comparison results.
func.def @comparison_lane(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi1>, i1) {
  %mask = vector.cmpi slt, %lhs, %rhs : vector<4xi32> -> vector<4xi1>
  %last = vector.extract %mask[3] : vector<4xi1> -> i1
  func.return %mask, %last : vector<4xi1>, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @comparison_lane(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.elpredicate>, reg<aie2p.er>) asm {
  %10 = vlt.s32x16.el.low32 %lhs, %rhs
  %mask = predicate.complete.zero.high32 %10, 0
  %12 = mov.short 1
  %13 = vbcst.8 %12
  %14 = vsub.8 %13, %13
  %15 = vsel.8 %14, %13, %mask
  %last = vextract.8.imm %15, 3
  return %mask, %last
}

// ====

func.def @select_lane(%input: vector<4xi1>, %lhs: i32, %rhs: i32) -> (i32) {
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  %selected = scf.select %last, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @select_lane(%input: reg<aie2p.elpredicate>, %lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %10 = mov.short 1
  %11 = vbcst.8 %10
  %12 = vsub.8 %11, %11
  %13 = vsel.8 %12, %11, %input
  %last = vextract.8.imm %13, 3
  %15 = copy %last : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected = sel.nez %lhs, %rhs, %15
  return %selected
}

// ====

// A CFG merge preserves every work item's predicate before the final select.
func.def @merged_predicate(%input: vector<4xi1>, %choose_first: i1, %lhs: i32, %rhs: i32) -> (i32) {
  cfg.cond_br %choose_first, ^first, ^last
^first:
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  cfg.br ^merge(%first: i1)
^last:
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  cfg.br ^merge(%last: i1)
^merge(%condition: i1):
  %selected = scf.select %condition, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @merged_predicate(%input: reg<aie2p.elpredicate>, %choose_first: reg<aie2p.er>, %lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  low.cond_br %choose_first, ^first, ^last : reg<aie2p.er>
^first:
  %15 = mov.short 1
  %16 = vbcst.8 %15
  %17 = vsub.8 %16, %16
  %18 = vsel.8 %17, %16, %input
  %first = vextract.8.imm %18, 0
  low.br ^merge(%first: reg<aie2p.er>)
^last:
  %20 = mov.short 1
  %21 = vbcst.8 %20
  %22 = vsub.8 %21, %21
  %23 = vsel.8 %22, %21, %input
  %last = vextract.8.imm %23, 3
  low.br ^merge(%last: reg<aie2p.er>)
^merge(%condition: reg<aie2p.er>):
  %25 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected = sel.nez %lhs, %rhs, %25
  return %selected
}

// ====

func.def @extracted_predicate_integer(%mask: vector<4xi1>) -> (i32, i32) {
  %condition = vector.extract %mask[1] : vector<4xi1> -> i1
  %unsigned = scalar.extui %condition : i1 to i32
  %signed = scalar.extsi %condition : i1 to i32
  func.return %unsigned, %signed : i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @extracted_predicate_integer(%mask: reg<aie2p.elpredicate>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %15 = mov.short 1
  %16 = vbcst.8 %15
  %17 = vsub.8 %16, %16
  %18 = vsel.8 %17, %16, %mask
  %condition = vextract.8.imm %18, 1
  %21 = mov.short 0
  %22 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %unsigned = sel.nez %15, %21, %22
  %24 = mov.short -1
  %25 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %signed = sel.nez %24, %21, %25
  return %unsigned, %signed
}

// ====

func.def @dynamic_predicate_element(%mask: vector<4xi1>, %position: index) -> (i1) {
  %lane = index.assume %position [range(%position, 0, 3)] : index
  %selected = vector.extract %mask[%lane] : vector<4xi1> -> i1
  func.return %selected : i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @dynamic_predicate_element(%mask: reg<aie2p.elpredicate>, %lane: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %8 = mov.short 1
  %9 = vbcst.8 %8
  %10 = vsub.8 %9, %9
  %11 = vsel.8 %10, %9, %mask
  %selected = vextract.8.reg %11, %lane
  return %selected
}
