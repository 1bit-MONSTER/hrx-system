// RUN: emit aie2p-array-plan @two_byte_external

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @two_byte_external() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @consume_i16
  %input = binding 0, "read"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1xi16>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi16>>
  // ERROR@+1: XDNA/017 {channel="0", record_bytes="2", minimum_bytes="4", maximum_bytes="65532", granularity_bytes="4"}
  %channel = channel %input_sender, %worker_input, %two, %two : reg<aie2p.array.channel : tile<1xi16>>
  constrain.location %worker, %zero, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume_i16() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  return
}

