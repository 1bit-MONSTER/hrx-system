// RUN: emit aie2p-array-plan @two_byte_multicast

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @two_byte_multicast() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %three = constant.u32 3 : reg<aie2p.array.scalar : index>
  %four = constant.u32 4 : reg<aie2p.array.scalar : index>
  %group = group %three
  %producer = worker %group, %zero, @produce_i16
  %near_consumer = worker %group, %one, @consume_i16
  %far_consumer = worker %group, %two, @consume_i16
  %sender = sender %producer, 0 : reg<aie2p.array.sender : tile<1xi16>>
  %near_receiver = receiver %near_consumer, 0 : reg<aie2p.array.receiver : tile<1xi16>>
  %far_receiver = receiver %far_consumer, 0 : reg<aie2p.array.receiver : tile<1xi16>>
  // ERROR@+1: XDNA/017 {channel="0", record_bytes="2", minimum_bytes="4", maximum_bytes="65532", granularity_bytes="4"}
  %near_channel = channel %sender, %near_receiver, %one, %one : reg<aie2p.array.channel : tile<1xi16>>
  %far_channel = channel %sender, %far_receiver, %one, %one : reg<aie2p.array.channel : tile<1xi16>>
  constrain.location %producer, %zero, %two
  constrain.location %near_consumer, %zero, %three
  constrain.location %far_consumer, %zero, %four
  return
}

