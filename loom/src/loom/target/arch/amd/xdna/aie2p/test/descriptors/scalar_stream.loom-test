// ====

// Scalar issue timing does not relax memory retirement, lock boundaries, or
// cascade consumption. Those effects keep their independent timing contracts.
// RUN: emit low-schedule-query @protocol_boundaries strategy=source order=* issue=* edge=effect:0:1,effect:1:2,effect:2:3,effect:3:4,effect:4:5

low.func.def target<amd.xdna.aie2p.core> @protocol_boundaries(%pointer: reg<aie2p.ep>, %word: reg<aie2p.er>) asm {
  st %word, %pointer, 0
  mov.ms %word
  rel %word, 5
  %reply = mov.ss
  %cascade = vmov.scd
  mov.ms.last %word
  return
}

