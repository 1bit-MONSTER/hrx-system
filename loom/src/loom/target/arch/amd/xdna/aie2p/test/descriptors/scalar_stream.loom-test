edge ssa 1 -> 2: separation=7 source=event-pair quality=exact producer-event=amd.xdna.aie2p.operand.write.c7.none consumer-event=amd.xdna.aie2p.operand.read.c1.none

// ====

// Status reads observe each individual nonblocking attempt. Their true
// read-after-write edges wait three cycles for writes and eight for reads.
// RUN: emit low-schedule-query @attempt_status strategy=source order=* issue=* edge=effect:0:2,state:0:1,state:1:2,state:2:3,effect:4:6,state:4:5,state:5:6,state:6:7

low.func.def target<amd.xdna.aie2p.core> @attempt_status(%word: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  mov.ms.nb %word
  %sent_first = mov.ms.status
  mov.ms.nb.last %word
  %sent_last = mov.ms.status
  %first = mov.ss.nb
  %received_first = mov.ss.status
  %second = mov.ss.nb
  %received_last = mov.ss.status
  return %sent_first, %sent_last, %received_first, %received_last
}

