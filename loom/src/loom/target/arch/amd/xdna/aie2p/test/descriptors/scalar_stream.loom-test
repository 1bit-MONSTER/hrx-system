// ====

// Packet headers and address-register payloads participate in the same
// one-word-per-cycle stream, including register-supplied termination.
// RUN: emit low-schedule-query @mixed_packet_words strategy=source order=* issue=*

low.func.def target<amd.xdna.aie2p.core> @mixed_packet_words(%id: reg<aie2p.er>, %address: reg<aie2p.em>, %last: reg<aie2p.mr28_tlast>, %pointer: reg<aie2p.ep>, %count: reg<aie2p.edc>, %index: reg<aie2p.edj>, %size: reg<aie2p.edn>) asm {
  mov.ph %id, 3
  mov.cph %address, %id, 2, 1
  mov.ms.ep %pointer
  mov.ms.edc %count
  mov.ms.edj %index
  mov.ms.edn %size
  mov.ms.last.reg %id, %last
  return
}

