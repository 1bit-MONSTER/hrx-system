// ====

// Scalar reads consume distinct words each cycle, while consumers of their
// payloads still wait for the load pipeline.
// RUN: emit low-schedule-query @consecutive_reads strategy=resource-stall order=* issue=* edge=effect:0:1,ssa:0:2,ssa:1:2

low.func.def target<amd.xdna.aie2p.core> @consecutive_reads() -> (reg<aie2p.er>) asm {
  %first = mov.ss
  %second = mov.ss
  %sum = add.rr %first, %second
  return %sum
}

