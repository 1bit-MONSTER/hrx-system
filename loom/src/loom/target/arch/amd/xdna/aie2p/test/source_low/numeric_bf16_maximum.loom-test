// Native BF16 maximum uses the existing fixed-mask descriptor only when the
// source permits unordered and signed-zero behavior.
// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @maximum_bf16x16(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>) -> (vector<16xbf16>) {
  %result = vector.maxnumf<nnan|nsz> %lhs, %rhs : vector<16xbf16>
  func.return %result : vector<16xbf16>
}

// ----
CHECK: %result, %* = vmax_lt.bf16 %lhs, %rhs
CHECK: return %result
CHECK-NOT: * = vextract.*

// ====

func.def @maximum_bf16x32(%lhs: vector<32xbf16>, %rhs: vector<32xbf16>) -> (vector<32xbf16>) {
  %result = vector.maximumf<nnan|nsz> %lhs, %rhs : vector<32xbf16>
  func.return %result : vector<32xbf16>
}

// ----
CHECK: %result, %* = vmax_lt.bf16 %lhs, %rhs
CHECK: return %result
CHECK-NOT: * = vextract.*

// ====

func.def @maximum_bf16_scalar(%lhs: bf16, %rhs: bf16) -> (bf16) {
  %result = scalar.maxnumf<nnan|nsz> %lhs, %rhs : bf16
  func.return %result : bf16
}

// ----
CHECK: %* = vbcst.16 %lhs
CHECK: %* = vbcst.16 %rhs
CHECK: %*, %* = vmax_lt.bf16 %*, %*
CHECK: %result = vextract.16.imm %*, 0
CHECK: return %result

// ====

func.def @maximum_bf16_reduction(%input: vector<16xbf16>, %initial: bf16) -> (bf16) {
  %result = vector.reduce<maxnumf, reassoc|nnan|nsz> %input, %initial : vector<16xbf16>, bf16
  func.return %result : bf16
}

// ----
CHECK: %* = vextract.16.imm %input, 0
CHECK: %* = vextract.16.imm %input, 15
CHECK: %*, %* = vmax_lt.bf16 %*, %*
CHECK: %result = vextract.16.imm %*, 0
CHECK: return %result

// ====

// A rounded BF16 dot producer stays vector-valued through its maximum consumer.
func.def @maximum_bf16_product(%lhs: vector<32xbf16>, %rhs: vector<32xbf16>, %maximum: vector<16xbf16>) -> (vector<16xbf16>) {
  %initial = vector.constant 0.0 : vector<16xf32>
  %product = vector.dot2f %lhs, %rhs, %initial : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %rounded = vector.fptrunc %product : vector<16xf32> to vector<16xbf16>
  %result = vector.maxnumf<nnan|nsz> %maximum, %rounded : vector<16xbf16>
  func.return %result : vector<16xbf16>
}

// ----
CHECK: %* = vmac.bf16x32 %*, %*, %*, %*
CHECK: %result, %* = vmax_lt.bf16 %maximum, %rounded
CHECK: return %result
CHECK-NOT: * = vextract.*
