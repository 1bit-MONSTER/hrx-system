low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bf16_origin_scale() -> (reg<aie2p.vec256 x2>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %11 = mov.short 0
  %12 = vbcst.16 %11
  %13 = slice %12[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %14 = vlda.256.bf16x16 %input_view, 0
  %narrow = concat(%14, %13) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %16 = mov.i32 16313
  %17 = vbcst.16 %16
  %18 = mova.i32 60
  %19 = vmul.bf16x32 %narrow, %17, %18
  %20 = slice %19[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %21 = vmov.accumulator512.to.vector512 %20
  %22 = mov.i32 32767
  %23 = vbcst.16 %22
  %24 = vband %narrow, %23
  %25 = mov.i32 47360
  %26 = vbcst.16 %25
  %27 = mova.i32 90
  %28 = vmul.i16x32 %24, %26, %27
  %29 = mov.shift 0
  %30 = mov.shift 15
  set.rounding 0
  set.srs-mode 1
  set.saturation 0
  %31 = vsrs.trunc.s16x32 %28, %29
  %32 = vsrs.trunc.s16x32 %28, %30
  %33 = vadd.16 %31, %31
  %34 = mov.i32 32768
  %35 = vbcst.16 %34
  %36 = vband %narrow, %35
  %37 = vbor %32, %36
  %38 = mova.i32 18
  %39 = vshuffle %33, %37, %38
  %40 = mov.short 89
  %41 = vbcst.16 %40
  %42 = vlt.u16x32.el.low32 %24, %41
  %product = vsel.32.mask64 %21, %39, %42
  return %product
}

