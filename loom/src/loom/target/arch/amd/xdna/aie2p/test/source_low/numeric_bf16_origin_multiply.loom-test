// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @bf16_origin_scale(%input: buffer) -> (vector<16xf32>) {
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 32} : buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<16xbf16>
  %narrow = vector.load %input_view[0] : view<16xbf16> -> vector<16xbf16>
  %wide = vector.extf %narrow : vector<16xbf16> to vector<16xf32>
  %scale = vector.constant 1.4453125 : vector<16xf32>
  %product = vector.mulf<nnan> %wide, %scale : vector<16xf32>
  func.return %product : vector<16xf32>
}

