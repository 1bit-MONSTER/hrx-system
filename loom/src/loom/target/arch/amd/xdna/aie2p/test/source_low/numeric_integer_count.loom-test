  %13 = mov.short 32
  %14 = copy %5 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %15 = sel.eqz %13, %12, %14
  %17 = xor %6, %8
  %18 = add %6, -1
  %19 = and %17, %18
  %20 = popcount %19
  %22 = copy %6 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %23 = sel.eqz %13, %20, %22
  %24 = add %23, 32
  %25 = copy %5 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %26 = sel.eqz %24, %15, %25
  %result = concat(%26, %7) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

