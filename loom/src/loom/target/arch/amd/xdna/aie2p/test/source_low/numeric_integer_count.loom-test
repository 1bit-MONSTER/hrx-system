// RUN: with-checks compile-report target=amd.xdna.aie2p:core target-legalize{mode=final},source-to-low,low-dce

func.def @wide_integer_counts(%i1: vector<65xi1>, %i8: vector<65xi8>, %i16: vector<33xi16>, %i32: vector<17xi32>, %i64: vector<9xi64>) -> (vector<65xi1>, vector<65xi8>, vector<33xi16>, vector<17xi32>, vector<9xi64>) {
  %r1 = vector.ctlzi %i1 : vector<65xi1>
  %r8 = vector.ctpopi %i8 : vector<65xi8>
  %r16 = vector.ctlzi %i16 : vector<33xi16>
  %r32 = vector.cttzi %i32 : vector<17xi32>
  %r64 = vector.ctpopi %i64 : vector<9xi64>
  func.return %r1, %r8, %r16, %r32, %r64 : vector<65xi1>, vector<65xi8>, vector<33xi16>, vector<17xi32>, vector<9xi64>
}

