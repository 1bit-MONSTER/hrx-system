// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @leading_scalar_predicate(%input: i1) -> (i1, i1) {
  %leading = scalar.ctlzi %input : i1
  %population = scalar.ctpopi %input : i1
  func.return %leading, %population : i1, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @leading_scalar_predicate(%population: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %8 = mov.short 1
  %leading = xor %population, %8
  return %leading, %population
}

