func.def @shaped_i64_comparison(%lhs: vector<3x3xi64>, %rhs: vector<3x3xi64>) -> (vector<3x3xi1>) {
  %result = vector.cmpi sle, %lhs, %rhs : vector<3x3xi64> -> vector<3x3xi1>
  func.return %result : vector<3x3xi1>
