// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i64x9_comparison(%lhs: vector<9xi64>, %rhs: vector<9xi64>) -> (vector<9xi1>) {
  %result = vector.cmpi ugt, %lhs, %rhs : vector<9xi64> -> vector<9xi1>
  func.return %result : vector<9xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x9_comparison(%lhs: reg<aie2p.vec256 x4>, %rhs: reg<aie2p.vec256 x4>) -> (reg<aie2p.elpredicate>) asm {
  %14 = slice %lhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %15 = slice %rhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %16 = mova.i32 4
  %17 = mova.i32 5
  %18 = vshuffle %14, %14, %16
  %19 = vshuffle %14, %14, %17
  %20 = vshuffle %15, %15, %16
  %21 = vshuffle %15, %15, %17
  %22 = vsub.32 %21, %19
  %23 = veqz.32.el.low32 %22
  %24 = vlt.u32x16.el.low32 %21, %19
  %25 = vlt.u32x16.el.low32 %20, %18
  %26 = predicate.and.low32 %23, %25
  %27 = predicate.or.low32 %24, %26
  %28 = predicate.complete.zero.high32 %27, 0
  %29 = slice %lhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %30 = slice %rhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %33 = vshuffle %29, %29, %16
  %34 = vshuffle %29, %29, %17
  %35 = vshuffle %30, %30, %16
  %36 = vshuffle %30, %30, %17
  %37 = vsub.32 %36, %34
  %38 = veqz.32.el.low32 %37
  %39 = vlt.u32x16.el.low32 %36, %34
  %40 = vlt.u32x16.el.low32 %35, %33
  %41 = predicate.and.low32 %38, %40
  %42 = predicate.or.low32 %39, %41
  %43 = predicate.complete.zero.high32 %42, 0
  %44 = mov.short 8
  %45 = mova.i32 255
  %46 = predicate.mask.low32.to.low32 %28, %45
  %47 = predicate.shift.low32 %43, %44
  %48 = predicate.or.low32.rhs_tied %46, %47
  %result = predicate.complete.zero.high32 %48, 0
  return %result
}

