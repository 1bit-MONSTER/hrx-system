// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i8x65_comparison(%lhs: vector<65xi8>, %rhs: vector<65xi8>) -> (vector<65xi1>) {
  %result = vector.cmpi sge, %lhs, %rhs : vector<65xi8> -> vector<65xi1>
  func.return %result : vector<65xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x65_comparison(%lhs: reg<aie2p.vec256 x4>, %rhs: reg<aie2p.vec256 x4>) -> (reg<aie2p.elpredicate x2>) asm {
  %14 = slice %lhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %15 = slice %rhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %16 = vge.s8x64 %14, %15
  %17 = slice %lhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %18 = slice %rhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %19 = vge.s8x64 %17, %18
  %result = concat(%16, %19) : (reg<aie2p.elpredicate>, reg<aie2p.elpredicate>) -> reg<aie2p.elpredicate x2>
  return %result
}

