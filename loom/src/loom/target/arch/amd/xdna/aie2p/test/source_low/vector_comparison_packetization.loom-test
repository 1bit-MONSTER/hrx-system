// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i16x33_comparison(%lhs: vector<33xi16>, %rhs: vector<33xi16>) -> (vector<33xi1>) {
  %result = vector.cmpi slt, %lhs, %rhs : vector<33xi16> -> vector<33xi1>
  func.return %result : vector<33xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x33_comparison(%lhs: reg<aie2p.vec256 x4>, %rhs: reg<aie2p.vec256 x4>) -> (reg<aie2p.elpredicate>) asm {
  %14 = slice %lhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %15 = slice %rhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %16 = vlt.s16x32.el.low32 %14, %15
  %17 = predicate.complete.zero.high32 %16, 0
  %18 = slice %lhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %19 = slice %rhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %20 = vlt.s16x32.el.low32 %18, %19
  %21 = predicate.complete.zero.high32 %20, 0
  %22 = mov.short 0
  %result = predicate.shift.low32.to.high32 %21, %22, %17
  return %result
}

