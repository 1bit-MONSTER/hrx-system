// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @shaped_i64_comparison(%lhs: reg<aie2p.vec256 x4>, %rhs: reg<aie2p.vec256 x4>) -> (reg<aie2p.elpredicate>) asm {
  %17 = slice %lhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %18 = slice %rhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %19 = mova.i32 4
  %20 = mova.i32 5
  %21 = vshuffle %17, %17, %19
  %22 = vshuffle %17, %17, %20
  %23 = vshuffle %18, %18, %19
  %24 = vshuffle %18, %18, %20
  %25 = vsub.32 %22, %24
  %26 = veqz.32.el.low32 %25
  %27 = vlt.s32x16.el.low32 %22, %24
  %28 = vge.u32x16.el.low32 %23, %21
  %29 = predicate.and.low32 %26, %28
  %30 = predicate.or.low32 %27, %29
  %31 = predicate.complete.zero.high32 %30, 0
  %32 = slice %lhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %33 = slice %rhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %36 = vshuffle %32, %32, %19
  %37 = vshuffle %32, %32, %20
  %38 = vshuffle %33, %33, %19
  %39 = vshuffle %33, %33, %20
  %40 = vsub.32 %37, %39
  %41 = veqz.32.el.low32 %40
  %42 = vlt.s32x16.el.low32 %37, %39
  %43 = vge.u32x16.el.low32 %38, %36
  %44 = predicate.and.low32 %41, %43
  %45 = predicate.or.low32 %42, %44
  %46 = predicate.complete.zero.high32 %45, 0
  %47 = mov.short 8
  %48 = mova.i32 255
  %49 = predicate.mask.low32.to.low32 %31, %48
  %50 = predicate.shift.low32 %46, %47
  %51 = predicate.or.low32.rhs_tied %49, %50
  %result = predicate.complete.zero.high32 %51, 0
  return %result
}
