// The first composite is constructed before the later private record fails.
// ERROR@+1: XDNA/011 {group="1", flow="3", tile_type="tile<1xi1>"}
pipeline.def<kernel> target(@array_target) @late_private_record_rejection() launch(%input: buffer, %output: buffer) {
  %lane_count = index.constant 1 : index
  %base = index.constant 0 : offset
  %first_workers = group.create %lane_count : index -> group
  %later_workers = group.create %lane_count : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %source = pipeline.read %input_view on %first_workers : view<1xi32>, group -> pipeline.flow<tile<1xi32>>
  %first_intermediate = pipeline.stage @copy_record on %first_workers(%source) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %first_result = pipeline.stage @copy_record on %first_workers(%first_intermediate) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %later_intermediate = pipeline.stage @produce_private on %later_workers(%first_result) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi1>>)
  %result = pipeline.stage @consume_private on %later_workers(%later_intermediate) : (group, pipeline.flow<tile<1xi1>>) -> (pipeline.flow<tile<1xi32>>)
  pipeline.write %result to %output_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.return
}
