// Equal target attributes do not replace the exact target identity contract.
// ERROR@+1: XDNA/010 {group="0", entry="second_copy", actual_target="second_core", expected_target="first_core"}
pipeline.def<kernel> target(@array_target) @different_stage_targets() launch(%input: buffer, %output: buffer) {
  %lane_count = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %lane_count : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %source = pipeline.read %input_view on %workers : view<1xi32>, group -> pipeline.flow<tile<1xi32>>
  %intermediate = pipeline.stage @first_copy on %workers(%source) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %result = pipeline.stage @second_copy on %workers(%intermediate) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  pipeline.write %result to %output_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.return
}

