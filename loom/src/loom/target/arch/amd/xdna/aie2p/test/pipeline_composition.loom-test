// ERROR@+1: XDNA/003 {group="0"}
pipeline.def<kernel> public retain target(@array_target) @mixed_outputs() launch(%input: buffer, %records_output: buffer, %sum_output: buffer) {
  %lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %lanes : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<2x1xf32>
  %records_view = buffer.view %records_output[%base] : buffer -> view<2x1xf32>
  %sum_view = buffer.view %sum_output[%base] : buffer -> view<1xf32>
  %input_flow = pipeline.read %input_view on %workers : view<2x1xf32>, group -> pipeline.flow<tile<1xf32>>
  %left = pipeline.stage @copy on %workers(%input_flow) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  %right = pipeline.stage @copy on %workers(%input_flow) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  %sum = pipeline.fold<addf> %right : pipeline.flow<tile<1xf32>>
  pipeline.write %left to %records_view : pipeline.flow<tile<1xf32>>, view<2x1xf32>
  pipeline.write %sum to %sum_view : pipeline.flow<tile<1xf32>>, view<1xf32>
  pipeline.return
}

