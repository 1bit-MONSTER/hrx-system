// RUN: pass aie2p-lower-pipeline

aie2p.target<array> @array_target

aie2p.target<core> @core_target

// ERROR@+1: XDNA/004 {group="0", flow="2", capacity="2"}
pipeline.def<kernel> public retain target(@array_target) @buffered_composite_array() launch(%input: buffer, %output: buffer) {
  %lane_count = index.constant 1 : index
  %ring_capacity = index.constant 2 : index
  %base = index.constant 0 : offset
  %workers = group.create %lane_count : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<2x16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<2x16xi32>
  %input_flow = pipeline.read %input_view on %workers : view<2x16xi32>, group -> pipeline.flow<tile<16xi32>>
  %intermediate_flow = pipeline.stage @copy_i32x16 on %workers(%input_flow) : (group, pipeline.flow<tile<16xi32>>) -> (pipeline.flow<tile<16xi32>>)
  %buffered_flow = pipeline.buffer %intermediate_flow capacity %ring_capacity : (pipeline.flow<tile<16xi32>>, index) -> pipeline.flow<tile<16xi32>>
  %output_flow = pipeline.stage @copy_i32x16 on %workers(%buffered_flow) : (group, pipeline.flow<tile<16xi32>>) -> (pipeline.flow<tile<16xi32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<16xi32>>, view<2x16xi32>
  pipeline.return
}

func.def target(@core_target) @copy_i32x16(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16xi32>
  %value = vector.load %input_view[0] : view<16xi32> -> vector<16xi32>
  vector.store %value, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

