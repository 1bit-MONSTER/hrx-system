  %lower = vbcst.8 %12
  %14 = mov.short 7
  %upper = vbcst.8 %14
  %first = max.s8x64 %values, %lower
  %other = min.s8x64 %values, %upper
  %clamped = min.s8x64 %first, %upper
  set.saturation 0
  set.pack-size 0
  %19 = vpack.w.trunc %clamped
  %20 = slice %clamped[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %packed = concat(%19, %20) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %packed, %other
}

