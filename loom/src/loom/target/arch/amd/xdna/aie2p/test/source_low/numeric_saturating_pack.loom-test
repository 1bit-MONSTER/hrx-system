func.def @retain_intervening_64(%values: vector<64xi8>) -> (vector<32xi8>, vector<64xi8>) {
  %lower = vector.constant -8 : vector<64xi8>
  %upper = vector.constant 7 : vector<64xi8>
  %first = vector.maxsi %values, %lower : vector<64xi8>
  %other = vector.minsi %values, %upper : vector<64xi8>
  %clamped = vector.minsi %first, %upper : vector<64xi8>
  %packed = vector.bitpack<4> %clamped : vector<64xi8> -> vector<32xi8>
  func.return %packed, %other : vector<32xi8>, vector<64xi8>
}

