// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @saturate_s4_64_min_max_lhs_lhs(%values: vector<64xi8>) -> (vector<32xi8>) {
  %lower = vector.constant -8 : vector<64xi8>
  %upper = vector.constant 7 : vector<64xi8>
  %first = vector.maxsi %values, %lower : vector<64xi8>
  %clamped = vector.minsi %first, %upper : vector<64xi8>
  %packed = vector.bitpack<4> %clamped : vector<64xi8> -> vector<32xi8>
  func.return %packed : vector<32xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @saturate_s4_64_min_max_lhs_lhs(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  set.saturation 1
  set.pack-size 0
  %9 = vpack.w.signed %values
  %10 = slice %values[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %packed = concat(%9, %10) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %packed
}

