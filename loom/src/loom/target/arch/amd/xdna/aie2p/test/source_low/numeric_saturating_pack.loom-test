func.def @retain_lower_bound_64(%values: vector<64xi8>) -> (vector<32xi8>) {
  %lower = vector.constant -7 : vector<64xi8>
  %upper = vector.constant 7 : vector<64xi8>
  %first = vector.maxsi %values, %lower : vector<64xi8>
  %clamped = vector.minsi %first, %upper : vector<64xi8>
  %packed = vector.bitpack<4> %clamped : vector<64xi8> -> vector<32xi8>
  func.return %packed : vector<32xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @retain_lower_bound_64(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %9 = mov.short -7
  %lower = vbcst.8 %9
  %11 = mov.short 7
  %upper = vbcst.8 %11
  %first = max.s8x64 %values, %lower
  %clamped = min.s8x64 %first, %upper
  set.saturation 0
  set.pack-size 0
  %15 = vpack.w.trunc %clamped
  %16 = slice %clamped[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %packed = concat(%15, %16) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %packed
}

