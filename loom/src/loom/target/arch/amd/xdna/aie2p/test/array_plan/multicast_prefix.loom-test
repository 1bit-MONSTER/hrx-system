  %activation_input5 = receiver %worker5, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input5 = receiver %worker5, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output5 = sender %worker5, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink5 = partition.receiver %output_sink, %offset, %lane5, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane6 = constant.u32 6 : reg<aie2p.array.scalar : index>
  %worker6 = worker %workers, %lane6, @join_records
  constrain.location %worker6, %column3, %lower_row
  %activation_input6 = receiver %worker6, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input6 = receiver %worker6, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output6 = sender %worker6, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink6 = partition.receiver %output_sink, %offset, %lane6, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane7 = constant.u32 7 : reg<aie2p.array.scalar : index>
  %worker7 = worker %workers, %lane7, @join_records
  constrain.location %worker7, %column3, %upper_row
  %activation_input7 = receiver %worker7, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input7 = receiver %worker7, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output7 = sender %worker7, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink7 = partition.receiver %output_sink, %offset, %lane7, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane8 = constant.u32 8 : reg<aie2p.array.scalar : index>
  %worker8 = worker %workers, %lane8, @join_records
  constrain.location %worker8, %column4, %lower_row
  %activation_input8 = receiver %worker8, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input8 = receiver %worker8, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output8 = sender %worker8, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink8 = partition.receiver %output_sink, %offset, %lane8, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane9 = constant.u32 9 : reg<aie2p.array.scalar : index>
  %worker9 = worker %workers, %lane9, @join_records
  constrain.location %worker9, %column4, %upper_row
  %activation_input9 = receiver %worker9, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input9 = receiver %worker9, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output9 = sender %worker9, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink9 = partition.receiver %output_sink, %offset, %lane9, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane10 = constant.u32 10 : reg<aie2p.array.scalar : index>
  %worker10 = worker %workers, %lane10, @join_records
  constrain.location %worker10, %column5, %lower_row
  %activation_input10 = receiver %worker10, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input10 = receiver %worker10, 1 : reg<aie2p.array.receiver : tile<16xi32>>
