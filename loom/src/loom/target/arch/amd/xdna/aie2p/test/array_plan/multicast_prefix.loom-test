// RUN: with-checks emit aie2p-array-plan @multicast_grid

// Eight activation sources each feed two workers; two weight sources each
// feed all eight columns. Shared horizontal and vertical prefixes preserve
// source isolation and same-index pass-through on the memory-tile row.

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @multicast_grid() asm {
  %worker_count = constant.u32 16 : reg<aie2p.array.scalar : index>
  %column_count = constant.u32 8 : reg<aie2p.array.scalar : index>
  %weight_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 3 : reg<aie2p.array.scalar : index>
  %lower_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %upper_row = constant.u32 3 : reg<aie2p.array.scalar : index>
  %offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %workers = group %worker_count
  %activations = binding 0, "read"
  %weights = binding 1, "read"
  %outputs = binding 2, "write"
  %activation_source = sender %activations, 0 : reg<aie2p.array.sender : tile<8x3x16xi32>>
  %weight_source = sender %weights, 0 : reg<aie2p.array.sender : tile<2x3x16xi32, #encoding.layout.strided<strides=[16, 0, 1]>>>
  %output_sink = receiver %outputs, 0 : reg<aie2p.array.receiver : tile<16x3x16xi32>>
  %column0 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %activation0 = partition.sender %activation_source, %offset, %column0, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column1 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %activation1 = partition.sender %activation_source, %offset, %column1, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column2 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %activation2 = partition.sender %activation_source, %offset, %column2, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column3 = constant.u32 3 : reg<aie2p.array.scalar : index>
  %activation3 = partition.sender %activation_source, %offset, %column3, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column4 = constant.u32 4 : reg<aie2p.array.scalar : index>
  %activation4 = partition.sender %activation_source, %offset, %column4, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column5 = constant.u32 5 : reg<aie2p.array.scalar : index>
  %activation5 = partition.sender %activation_source, %offset, %column5, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column6 = constant.u32 6 : reg<aie2p.array.scalar : index>
  %activation6 = partition.sender %activation_source, %offset, %column6, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %column7 = constant.u32 7 : reg<aie2p.array.scalar : index>
  %activation7 = partition.sender %activation_source, %offset, %column7, %column_count : reg<aie2p.array.sender : tile<16xi32>>
  %weight_lane0 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %weight0 = partition.sender %weight_source, %offset, %weight_lane0, %weight_count : reg<aie2p.array.sender : tile<16xi32>>
  %weight_lane1 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %weight1 = partition.sender %weight_source, %offset, %weight_lane1, %weight_count : reg<aie2p.array.sender : tile<16xi32>>
  %lane0 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker0 = worker %workers, %lane0, @join_records
  constrain.location %worker0, %column0, %lower_row
  %activation_input0 = receiver %worker0, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input0 = receiver %worker0, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output0 = sender %worker0, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink0 = partition.receiver %output_sink, %offset, %lane0, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane1 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %worker1 = worker %workers, %lane1, @join_records
  constrain.location %worker1, %column0, %upper_row
  %activation_input1 = receiver %worker1, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input1 = receiver %worker1, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output1 = sender %worker1, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink1 = partition.receiver %output_sink, %offset, %lane1, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane2 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker2 = worker %workers, %lane2, @join_records
  constrain.location %worker2, %column1, %lower_row
  %activation_input2 = receiver %worker2, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input2 = receiver %worker2, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output2 = sender %worker2, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink2 = partition.receiver %output_sink, %offset, %lane2, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane3 = constant.u32 3 : reg<aie2p.array.scalar : index>
  %worker3 = worker %workers, %lane3, @join_records
  constrain.location %worker3, %column1, %upper_row
  %activation_input3 = receiver %worker3, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input3 = receiver %worker3, 1 : reg<aie2p.array.receiver : tile<16xi32>>
