  %output_channel0 = channel %output0, %sink0, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %output_channel1 = channel %output1, %sink1, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
