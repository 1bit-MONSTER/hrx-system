  %sink3 = partition.receiver %output_sink, %offset, %lane3, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane4 = constant.u32 4 : reg<aie2p.array.scalar : index>
  %worker4 = worker %workers, %lane4, @join_records
  constrain.location %worker4, %column2, %lower_row
  %activation_input4 = receiver %worker4, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input4 = receiver %worker4, 1 : reg<aie2p.array.receiver : tile<16xi32>>
