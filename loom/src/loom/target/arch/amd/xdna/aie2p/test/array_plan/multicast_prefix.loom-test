  %weight_channel10 = channel %weight0, %weight_input10, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel12 = channel %weight0, %weight_input12, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel14 = channel %weight0, %weight_input14, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel1 = channel %weight1, %weight_input1, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel3 = channel %weight1, %weight_input3, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel5 = channel %weight1, %weight_input5, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel7 = channel %weight1, %weight_input7, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel9 = channel %weight1, %weight_input9, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
