low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @join_records() asm {
  %activations = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %weights = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %zero = mov.short 0
  %word_bytes = mov.short 4
  %record_bytes = mov.short 64
  low.br ^write(%zero: reg<aie2p.er>)
^write(%position: reg<aie2p.er>):
  %remaining = lt %position, %record_bytes
  low.cond_br %remaining, ^write_word, ^done : reg<aie2p.er>
^write_word:
  %index = mov.address-index %position
  %activation = lda.i32.index %activations, %index
  %weight = lda.i32.index %weights, %index
  %sum = add.rr %activation, %weight
  st.i32.index %sum, %output, %index
  %next_position = add.rr %position, %word_bytes
  low.br ^write(%next_position: reg<aie2p.er>)
^done:
  return
}

// ----
CHECK: array @multicast_grid family=amd.xdna.npu2 groups=1 workers=16 bindings=3 channels=48 slots=96 locks=96 dma=74 routes=192
CHECK: route channel=17 tile=(0,0) kind=switch source=south[7] destination=east[0]
CHECK: route channel=24 tile=(1,0) kind=switch source=south[7] destination=west[0]
CHECK: route channel=26 tile=(1,0) kind=switch source=south[7] destination=east[1]
CHECK-NOT: route * tile=(0,0) kind=switch * destination=east[1]
CHECK-NOT: route * kind=switch * destination=east[2]
CHECK-NOT: route * kind=switch * destination=west[1]
CHECK: binding-patch ordinal=0 channel=0 shim=(0,0) direction=memory-to-stream dma-channel=0 partition=0/8 offset=0 span=192 transfer=192 repeat=1
CHECK: route channel=0 tile=(0,1) kind=switch source=south[0] destination=north[0]
CHECK: route channel=0 tile=(0,2) kind=switch source=south[0] destination=dma[0]
CHECK: route channel=1 tile=(0,2) kind=switch source=south[0] destination=north[0]
CHECK: route channel=1 tile=(0,3) kind=switch source=south[0] destination=dma[0]
CHECK: route channel=16 tile=(0,1) kind=switch source=south[1] destination=north[1]
CHECK: route channel=16 tile=(0,2) kind=switch source=south[1] destination=dma[1]
CHECK: route channel=24 tile=(0,1) kind=switch source=south[2] destination=north[2]
CHECK: route channel=24 tile=(0,2) kind=switch source=south[2] destination=north[1]
CHECK: route channel=24 tile=(0,3) kind=switch source=south[1] destination=dma[1]
CHECK: route channel=32 tile=(0,1) kind=switch source=north[0] destination=south[0]
CHECK: route channel=33 tile=(0,1) kind=switch source=north[1] destination=south[1]
CHECK: binding-patch ordinal=2 channel=32 shim=(0,0) direction=stream-to-memory dma-channel=0 partition=0/16 offset=0 span=192 transfer=192 repeat=1 completion-route=0
CHECK: binding-patch ordinal=2 channel=33 shim=(0,0) direction=stream-to-memory dma-channel=1 partition=1/16 offset=192 span=192 transfer=192 repeat=1 completion-route=0
CHECK: binding-patch ordinal=0 channel=2 shim=(1,0) direction=memory-to-stream dma-channel=0 partition=1/8 offset=192 span=192 transfer=192 repeat=1
CHECK: route channel=2 tile=(1,1) kind=switch source=south[0] destination=north[0]
CHECK: route channel=2 tile=(1,2) kind=switch source=south[0] destination=dma[0]
CHECK: route channel=3 tile=(1,2) kind=switch source=south[0] destination=north[0]
CHECK: route channel=3 tile=(1,3) kind=switch source=south[0] destination=dma[0]
CHECK: route channel=17 tile=(1,1) kind=switch source=south[1] destination=north[1]
CHECK: route channel=17 tile=(1,2) kind=switch source=south[1] destination=dma[1]
CHECK: route channel=25 tile=(1,1) kind=switch source=south[2] destination=north[2]
CHECK: route channel=25 tile=(1,2) kind=switch source=south[2] destination=north[1]
CHECK: route channel=25 tile=(1,3) kind=switch source=south[1] destination=dma[1]
CHECK: route channel=34 tile=(1,1) kind=switch source=north[0] destination=south[0]
