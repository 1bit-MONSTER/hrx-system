  %sink13 = partition.receiver %output_sink, %offset, %lane13, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane14 = constant.u32 14 : reg<aie2p.array.scalar : index>
  %worker14 = worker %workers, %lane14, @join_records
  constrain.location %worker14, %column7, %lower_row
  %activation_input14 = receiver %worker14, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input14 = receiver %worker14, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output14 = sender %worker14, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink14 = partition.receiver %output_sink, %offset, %lane14, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %lane15 = constant.u32 15 : reg<aie2p.array.scalar : index>
  %worker15 = worker %workers, %lane15, @join_records
  constrain.location %worker15, %column7, %upper_row
  %activation_input15 = receiver %worker15, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %weight_input15 = receiver %worker15, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output15 = sender %worker15, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %sink15 = partition.receiver %output_sink, %offset, %lane15, %worker_count : reg<aie2p.array.receiver : tile<16xi32>>
  %activation_channel0 = channel %activation0, %activation_input0, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel1 = channel %activation0, %activation_input1, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel2 = channel %activation1, %activation_input2, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel3 = channel %activation1, %activation_input3, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel4 = channel %activation2, %activation_input4, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel5 = channel %activation2, %activation_input5, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel6 = channel %activation3, %activation_input6, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel7 = channel %activation3, %activation_input7, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel8 = channel %activation4, %activation_input8, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel9 = channel %activation4, %activation_input9, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel10 = channel %activation5, %activation_input10, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel11 = channel %activation5, %activation_input11, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel12 = channel %activation6, %activation_input12, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel13 = channel %activation6, %activation_input13, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel14 = channel %activation7, %activation_input14, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %activation_channel15 = channel %activation7, %activation_input15, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  %weight_channel0 = channel %weight0, %weight_input0, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
