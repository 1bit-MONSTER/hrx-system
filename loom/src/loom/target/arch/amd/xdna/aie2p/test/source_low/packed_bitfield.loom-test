}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_extracts(%value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %10 = mov.short 24
  %11 = lshl %value, %10
  %12 = mov.short -28
  %13 = ashl %11, %12
  return %13
}

