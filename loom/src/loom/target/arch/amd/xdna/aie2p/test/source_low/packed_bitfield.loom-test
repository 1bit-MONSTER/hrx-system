// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_insert_offset0(%field_value: reg<aie2p.er>, %base_value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %21 = mov.short 15
  %22 = and %field_value, %21
  %23 = mov.short -16
  %24 = and %base_value, %23
  %25 = or %24, %22
  return %25
}

// ====

func.def @i32_bitfield_insert_full_width_alias(%field_value: i32, %base_value: i32) -> (i32) {
  %field = vector.from_elements %field_value : vector<1xi32>
