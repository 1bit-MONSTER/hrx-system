// ====

func.def @i32_bitfield_insert(%field_value: i32, %base_value: i32) -> (i32) {
  %field = vector.from_elements %field_value : vector<1xi32>
  %base = vector.from_elements %base_value : vector<1xi32>
  %inserted = vector.bitfield.insert %field into %base {offset = 8, width = 4} : vector<1xi32>, vector<1xi32>
  %result = vector.extract %inserted[0] : vector<1xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_insert(%field_value: reg<aie2p.er>, %base_value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %23 = mov.short 15
  %24 = and %field_value, %23
  %25 = mov.short 8
  %26 = lshl %24, %25
  %27 = mov.i32 -3841
  %28 = and %base_value, %27
  %29 = or %28, %26
  return %29
}

// ====

