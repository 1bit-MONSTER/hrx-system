// ====

func.def @i32_bitfield_b128_shape(%loaded: vector<4xi32>) -> (vector<4xi32>) {
  %low = vector.bitfield.extractu %loaded {offset = 0, width = 4} : vector<4xi32> -> vector<4xi32>
  %high = vector.bitfield.extractu %loaded {offset = 4, width = 2} : vector<4xi32> -> vector<4xi32>
  %merged = vector.bitfield.insert %high into %low {offset = 4, width = 2} : vector<4xi32>, vector<4xi32>
  %bias = vector.constant 32 : vector<4xi32>
  %result = vector.subi %merged, %bias : vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_b128_shape(%loaded: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %74 = vextract.32.imm %loaded, 0
  %75 = mov.short 26
  %76 = lshl %74, %75
  %77 = mov.short -30
  %78 = lshl %76, %77
  %79 = mov.short 15
  %80 = and %74, %79
  %81 = mov.short 4
  %82 = lshl %78, %81
  %83 = mov.short -49
  %84 = and %80, %83
  %85 = or %84, %82
  %86 = vextract.32.imm %loaded, 1
  %88 = lshl %86, %75
  %90 = lshl %88, %77
  %91 = and %86, %79
  %92 = lshl %90, %81
  %93 = and %91, %83
  %94 = or %93, %92
  %95 = vextract.32.imm %loaded, 2
  %97 = lshl %95, %75
  %99 = lshl %97, %77
  %100 = and %95, %79
  %101 = lshl %99, %81
  %102 = and %100, %83
  %103 = or %102, %101
  %104 = vextract.32.imm %loaded, 3
  %106 = lshl %104, %75
  %108 = lshl %106, %77
  %109 = and %104, %79
  %110 = lshl %108, %81
  %111 = and %109, %83
  %112 = or %111, %110
  %113 = vbcst.32 %112
  %114 = vpush.lo.32 %103, %113
  %115 = vpush.lo.32 %94, %114
  %merged = vpush.lo.32 %85, %115
  %117 = mov.short 32
  %bias = vbcst.32 %117
  %result = vsub.32 %merged, %bias
  return %result
}
