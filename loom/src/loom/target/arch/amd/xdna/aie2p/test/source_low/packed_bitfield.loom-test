low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_extractu() asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %14 = lda %input_view, 0
  %15 = mov.short 24
  %16 = lshl %14, %15
  %17 = mov.short -28
  %18 = lshl %16, %17
  st %18, %output_view, 0
  return
}

