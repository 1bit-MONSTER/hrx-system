// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_insert_full_width_alias(%field_value: reg<aie2p.er>, %base_value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  return %field_value
