CHECK-NOT: *vinsert*

// ====

func.def @partial_accumulator_bitcast(%words: vector<34xi32>) -> (vector<17xi64>) {
  %double_words = vector.bitcast %words : vector<34xi32> to vector<17xi64>
  func.return %double_words : vector<17xi64>
}

// ----
CHECK: low.func.def * @partial_accumulator_bitcast(%double_words: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x4>) *
CHECK: return %double_words
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

// ====

func.def @slice_i64_partial_accumulator_tail(%source: vector<17xi64>) -> (vector<1xi64>) {
  %result = vector.slice %source[16] : vector<17xi64> -> vector<1xi64>
  func.return %result : vector<1xi64>
}

// ----
CHECK: low.func.def * @slice_i64_partial_accumulator_tail(%source: reg<aie2p.mbms x4>) -> (reg<aie2p.vec256 x2>) *
CHECK: * = slice %source[2] *
CHECK: %result = vmov.accumulator512.to.vector512 *
CHECK: return %result
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*
