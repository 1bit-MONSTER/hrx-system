// ----
CHECK: low.func.def * @concat_f32_four_unit_boundary(%left: reg<aie2p.mbms x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.mbms x4>) *
CHECK: * = slice %left[0] *
CHECK: * = slice %left[1] *
CHECK: * = vmov.vector512.to.accumulator512 %right
CHECK: %result = concat(*
