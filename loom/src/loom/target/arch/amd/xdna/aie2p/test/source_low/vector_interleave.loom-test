func.def target(@target) @interleave_i16x32(%even: vector<32xi16>, %odd: vector<32xi16>) -> (vector<64xi16>) {
  %result = vector.interleave<0> %even, %odd : vector<32xi16>, vector<32xi16> -> vector<64xi16>
  func.return %result : vector<64xi16>
}

