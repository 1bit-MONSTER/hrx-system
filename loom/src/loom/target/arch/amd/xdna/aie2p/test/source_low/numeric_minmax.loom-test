func.def @index_minmax_sgpr(%lhs0: index, %rhs0: index) -> (index) {
  %lhs = index.assume %lhs0 [range(%lhs0, -1024, 1024)] : index
  %rhs = index.assume %rhs0 [range(%rhs0, -1024, 1024)] : index
  %min = index.min %lhs, %rhs : index
  %max = index.max %lhs, %rhs : index
  %sum = index.add %min, %max : index
  func.return %sum : index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @index_minmax_sgpr(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %11 = lt.select %lhs, %rhs
  %min = sel.nez %lhs, %rhs, %11
  %13 = lt.select %rhs, %lhs
  %max = sel.nez %lhs, %rhs, %13
  %sum = add.rr %min, %max
  return %sum
}

