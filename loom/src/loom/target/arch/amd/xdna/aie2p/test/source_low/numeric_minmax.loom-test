low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scf_select_i1_scc_condition(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %alt: reg<aie2p.er>, %true_value: reg<aie2p.er>, %false_value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %condition = lt %lhs, %rhs
  %lhs_nonzero = nez %lhs
  %alt_nonzero = nez %alt
  %21 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected_condition = sel.nez %lhs_nonzero, %alt_nonzero, %21
  %23 = copy %selected_condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %result = sel.nez %true_value, %false_value, %23
  return %result
}

