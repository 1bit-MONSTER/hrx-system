func.def @scf_select_sgpr(%lhs: i32, %rhs: i32, %a: i32, %b: i32) -> (i32) {
  %cond = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.select %cond, %a, %b : i32
  func.return %selected : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scf_select_sgpr(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %a: reg<aie2p.er>, %b: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %cond = lt %lhs, %rhs
  %13 = copy %cond : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected = sel.nez %a, %b, %13
  return %selected
}

