low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scf_select_q6_nibble_i8(%code: reg<aie2p.er>, %use_high: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %mask = mov.short 15
