load("//loom/build_tools/bazel:build_defs.bzl", "loom_generated_cc_library")

package(
    default_visibility = [
        "//loom/src/loom/target/arch/vm:__pkg__",
        "//loom/src/loom/target/emit/vm:__pkg__",
    ],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_generated_cc_library(
    name = "ops",
    srcs = ["registry.c"],
    hdrs = [
        "ops.h",
        "registry.h",
    ],
    args = ["--dialect=vm"],
    extra_output_flags = ["--ops-include"],
    extra_outputs = ["ops.inc"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_vm_generator",
    textual_hdrs = ["ops.inc"],
    deps = [
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/vm:records",
        "//runtime/src/iree/base",
    ],
)
