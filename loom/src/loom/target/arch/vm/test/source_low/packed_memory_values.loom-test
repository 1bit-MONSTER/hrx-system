  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<4xi16>
  %value = vector.load %source_view[0] : view<4xi16> -> vector<4xi16>
  %result = vector.addi %value, %value : vector<4xi16>
  %output_view = buffer.view %destination[%c0] : buffer -> view<4xi16>
  vector.store %result, %output_view[0] : vector<4xi16>, view<4xi16>
  func.return
}

