// TEMPLATE: loom/src/loom/test/corpus/source_low/scalar_float_conversion.loom-test
// TEMPLATE-EXCLUDE: @floating_arguments VM functions do not use the GPU launch ABI.
// RUN: emit source-low target=vm:core output=low

func.def @convert_scalar_f64(%single: f32, %double: f64) -> (f64, f32) {
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  func.return %wide, %narrow : f64, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @convert_scalar_f64(%single: reg<vm.value : f32>, %double: reg<vm.value : f64>) -> (reg<vm.value : f64>, reg<vm.value : f32>) asm {
  %wide = conversion.float.width %single, "f32.to.f64" : reg<vm.value : f64>
  %narrow = conversion.float.width %double, "f64.to.f32" : reg<vm.value : f32>
  return %wide, %narrow
}

// ====

func.def @widen_narrow_to_f64(%e4: f8E4M3, %e5: f8E5M2, %half: f16, %brain: bf16) -> (f64, f64, f64, f64) {
  %double_e4 = scalar.extf %e4 : f8E4M3 to f64
  %double_e5 = scalar.extf %e5 : f8E5M2 to f64
  %double_half = scalar.extf %half : f16 to f64
  %double_brain = scalar.extf %brain : bf16 to f64
  func.return %double_e4, %double_e5, %double_half, %double_brain : f64, f64, f64, f64
}

// ----
low.func.def target<vm.core> abi(vm_function) @widen_narrow_to_f64(%e4: reg<vm.value : f8E4M3>, %e5: reg<vm.value : f8E5M2>, %half: reg<vm.value : f16>, %brain: reg<vm.value : bf16>) -> (reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>) asm {
  %20 = conversion.float.extend %e4, "f8e4m3.to.f32" : reg<vm.value : f32>
  %double_e4 = conversion.float.width %20, "f32.to.f64" : reg<vm.value : f64>
  %22 = conversion.float.extend %e5, "f8e5m2.to.f32" : reg<vm.value : f32>
  %double_e5 = conversion.float.width %22, "f32.to.f64" : reg<vm.value : f64>
  %24 = conversion.float.extend %half, "f16.to.f32" : reg<vm.value : f32>
  %double_half = conversion.float.width %24, "f32.to.f64" : reg<vm.value : f64>
  %26 = conversion.float.extend %brain, "bf16.to.f32" : reg<vm.value : f32>
  %double_brain = conversion.float.width %26, "f32.to.f64" : reg<vm.value : f64>
  return %double_e4, %double_e5, %double_half, %double_brain
}

// ====

func.def @widen_float8_chain(%input: f8E4M3) -> (f64) {
  %single = scalar.extf %input : f8E4M3 to f32
  %double = scalar.extf %single : f32 to f64
  func.return %double : f64
}

// ----
low.func.def target<vm.core> abi(vm_function) @widen_float8_chain(%input: reg<vm.value : f8E4M3>) -> (reg<vm.value : f64>) asm {
  %7 = conversion.float.extend %input, "f8e4m3.to.f32" : reg<vm.value : f32>
  %double = conversion.float.width %7, "f32.to.f64" : reg<vm.value : f64>
  return %double
}
