// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_conversion_float8.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @scalar_extf_f8e4m3_to_f32(%input: f8E4M3) -> (f32) {
  %converted = scalar.extf %input : f8E4M3 to f32
  func.return %converted : f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_extf_f8e4m3_to_f32(%input: reg<vm.value : f8E4M3>) -> (reg<vm.value : f32>) asm {
  %converted = conversion.float.extend %input, "f8e4m3.to.f32" : reg<vm.value : f32>
  return %converted
}

// ====

func.def @scalar_extf_f8e5m2_to_f32(%input: f8E5M2) -> (f32) {
  %converted = scalar.extf %input : f8E5M2 to f32
  func.return %converted : f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_extf_f8e5m2_to_f32(%input: reg<vm.value : f8E5M2>) -> (reg<vm.value : f32>) asm {
  %converted = conversion.float.extend %input, "f8e5m2.to.f32" : reg<vm.value : f32>
  return %converted
}

// ====

func.def @vector_extf_f8e4m3x3_to_bf16x3(%first: f8E4M3, %second: f8E4M3, %third: f8E4M3) -> (bf16, bf16, bf16) {
  %input = vector.from_elements %first, %second, %third : vector<3xf8E4M3>
  %converted = vector.extf %input : vector<3xf8E4M3> to vector<3xbf16>
  %first_result = vector.extract %converted[0] : vector<3xbf16> -> bf16
  %second_result = vector.extract %converted[1] : vector<3xbf16> -> bf16
  %third_result = vector.extract %converted[2] : vector<3xbf16> -> bf16
  func.return %first_result, %second_result, %third_result : bf16, bf16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @vector_extf_f8e4m3x3_to_bf16x3(%first: reg<vm.value : f8E4M3>, %second: reg<vm.value : f8E4M3>, %third: reg<vm.value : f8E4M3>) -> (reg<vm.value : bf16>, reg<vm.value : bf16>, reg<vm.value : bf16>) asm {
  %23 = conversion.float.extend %first, "f8e4m3.to.f32" : reg<vm.value : f32>
  %first_result = conversion.float.truncate %23, "f32.to.bf16" : reg<vm.value : bf16>
  %25 = conversion.float.extend %second, "f8e4m3.to.f32" : reg<vm.value : f32>
  %second_result = conversion.float.truncate %25, "f32.to.bf16" : reg<vm.value : bf16>
  %27 = conversion.float.extend %third, "f8e4m3.to.f32" : reg<vm.value : f32>
  %third_result = conversion.float.truncate %27, "f32.to.bf16" : reg<vm.value : bf16>
  return %first_result, %second_result, %third_result
}

// ====

func.def @vector_extf_f8e5m2x3_to_f16x3(%first: f8E5M2, %second: f8E5M2, %third: f8E5M2) -> (f16, f16, f16) {
  %input = vector.from_elements %first, %second, %third : vector<3xf8E5M2>
  %converted = vector.extf %input : vector<3xf8E5M2> to vector<3xf16>
  %first_result = vector.extract %converted[0] : vector<3xf16> -> f16
  %second_result = vector.extract %converted[1] : vector<3xf16> -> f16
  %third_result = vector.extract %converted[2] : vector<3xf16> -> f16
  func.return %first_result, %second_result, %third_result : f16, f16, f16
}

// ----
low.func.def target<vm.core> abi(vm_function) @vector_extf_f8e5m2x3_to_f16x3(%first: reg<vm.value : f8E5M2>, %second: reg<vm.value : f8E5M2>, %third: reg<vm.value : f8E5M2>) -> (reg<vm.value : f16>, reg<vm.value : f16>, reg<vm.value : f16>) asm {
  %23 = conversion.float.extend %first, "f8e5m2.to.f32" : reg<vm.value : f32>
  %first_result = conversion.float.truncate %23, "f32.to.f16" : reg<vm.value : f16>
  %25 = conversion.float.extend %second, "f8e5m2.to.f32" : reg<vm.value : f32>
  %second_result = conversion.float.truncate %25, "f32.to.f16" : reg<vm.value : f16>
  %27 = conversion.float.extend %third, "f8e5m2.to.f32" : reg<vm.value : f32>
  %third_result = conversion.float.truncate %27, "f32.to.f16" : reg<vm.value : f16>
  return %first_result, %second_result, %third_result
}

