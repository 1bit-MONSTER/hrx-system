// ====

func.def @vector_fptrunc_f32x3_to_f8e4m3x3(%first: f32, %second: f32, %third: f32) -> (f8E4M3, f8E4M3, f8E4M3) {
  %input = vector.from_elements %first, %second, %third : vector<3xf32>
  %converted = vector.fptrunc %input : vector<3xf32> to vector<3xf8E4M3>
  %first_result = vector.extract %converted[0] : vector<3xf8E4M3> -> f8E4M3
  %second_result = vector.extract %converted[1] : vector<3xf8E4M3> -> f8E4M3
  %third_result = vector.extract %converted[2] : vector<3xf8E4M3> -> f8E4M3
  func.return %first_result, %second_result, %third_result : f8E4M3, f8E4M3, f8E4M3
}

// ----
low.func.def target<vm.core> abi(vm_function) @vector_fptrunc_f32x3_to_f8e4m3x3(%first: reg<vm.value : f32>, %second: reg<vm.value : f32>, %third: reg<vm.value : f32>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E4M3>, reg<vm.value : f8E4M3>) asm {
  %first_result = conversion.float.truncate %first, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %second_result = conversion.float.truncate %second, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %third_result = conversion.float.truncate %third, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  return %first_result, %second_result, %third_result
}

// ====

func.def @vector_fptrunc_f16x3_to_f8e5m2x3(%first: f16, %second: f16, %third: f16) -> (f8E5M2, f8E5M2, f8E5M2) {
  %input = vector.from_elements %first, %second, %third : vector<3xf16>
  %converted = vector.fptrunc %input : vector<3xf16> to vector<3xf8E5M2>
  %first_result = vector.extract %converted[0] : vector<3xf8E5M2> -> f8E5M2
  %second_result = vector.extract %converted[1] : vector<3xf8E5M2> -> f8E5M2
  %third_result = vector.extract %converted[2] : vector<3xf8E5M2> -> f8E5M2
  func.return %first_result, %second_result, %third_result : f8E5M2, f8E5M2, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @vector_fptrunc_f16x3_to_f8e5m2x3(%first: reg<vm.value : f16>, %second: reg<vm.value : f16>, %third: reg<vm.value : f16>) -> (reg<vm.value : f8E5M2>, reg<vm.value : f8E5M2>, reg<vm.value : f8E5M2>) asm {
  %23 = conversion.float.extend %first, "f16.to.f32" : reg<vm.value : f32>
  %first_result = conversion.float.truncate %23, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %25 = conversion.float.extend %second, "f16.to.f32" : reg<vm.value : f32>
  %second_result = conversion.float.truncate %25, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %27 = conversion.float.extend %third, "f16.to.f32" : reg<vm.value : f32>
  %third_result = conversion.float.truncate %27, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  return %first_result, %second_result, %third_result
}
