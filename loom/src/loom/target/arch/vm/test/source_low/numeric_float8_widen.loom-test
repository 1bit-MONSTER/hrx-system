// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float8_widen.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @float8_to_half(%e4m3: f8E4M3, %e5m2: f8E5M2) -> (f16, f16) {
  %half_e4m3 = scalar.extf %e4m3 : f8E4M3 to f16
  %half_e5m2 = scalar.extf %e5m2 : f8E5M2 to f16
  func.return %half_e4m3, %half_e5m2 : f16, f16
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_to_half(%e4m3: reg<vm.value : f8E4M3>, %e5m2: reg<vm.value : f8E5M2>) -> (reg<vm.value : f16>, reg<vm.value : f16>) asm {
  %10 = conversion.float.extend %e4m3, "f8e4m3.to.f32" : reg<vm.value : f32>
  %half_e4m3 = conversion.float.truncate %10, "f32.to.f16" : reg<vm.value : f16>
  %12 = conversion.float.extend %e5m2, "f8e5m2.to.f32" : reg<vm.value : f32>
  %half_e5m2 = conversion.float.truncate %12, "f32.to.f16" : reg<vm.value : f16>
  return %half_e4m3, %half_e5m2
}

// ====

func.def @float8_to_bfloat(%e4m3: f8E4M3, %e5m2: f8E5M2) -> (bf16, bf16) {
  %bfloat_e4m3 = scalar.extf %e4m3 : f8E4M3 to bf16
  %bfloat_e5m2 = scalar.extf %e5m2 : f8E5M2 to bf16
  func.return %bfloat_e4m3, %bfloat_e5m2 : bf16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_to_bfloat(%e4m3: reg<vm.value : f8E4M3>, %e5m2: reg<vm.value : f8E5M2>) -> (reg<vm.value : bf16>, reg<vm.value : bf16>) asm {
  %10 = conversion.float.extend %e4m3, "f8e4m3.to.f32" : reg<vm.value : f32>
  %bfloat_e4m3 = conversion.float.truncate %10, "f32.to.bf16" : reg<vm.value : bf16>
  %12 = conversion.float.extend %e5m2, "f8e5m2.to.f32" : reg<vm.value : f32>
  %bfloat_e5m2 = conversion.float.truncate %12, "f32.to.bf16" : reg<vm.value : bf16>
  return %bfloat_e4m3, %bfloat_e5m2
}
