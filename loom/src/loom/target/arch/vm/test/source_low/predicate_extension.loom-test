// TEMPLATE: loom/src/loom/test/corpus/source_low/predicate_extension.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @predicate_extension_i8(%condition: i1) -> (i8, i8) {
  %signed = scalar.extsi %condition : i1 to i8
  %unsigned = scalar.extui %condition : i1 to i8
  func.return %signed, %unsigned : i8, i8
}

// ----
low.func.def target<vm.core> abi(vm_function) @predicate_extension_i8(%condition: reg<vm.value : i1>) -> (reg<vm.value : i8>, reg<vm.value : i8>) asm {
  %signed = conversion.integer %condition, "s1.to.i8" : reg<vm.value : i8>
  %unsigned = conversion.integer %condition, "u1.to.i8" : reg<vm.value : i8>
  return %signed, %unsigned
}

