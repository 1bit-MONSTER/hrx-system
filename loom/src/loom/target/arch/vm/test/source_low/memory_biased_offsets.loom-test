// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_biased_offsets.loom
// RUN: emit source-low target=vm:core output=low

func.def @exchange_biased_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %signed_position = index.assume %position [range(%position, -4, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @exchange_biased_word(%view: reg<vm.ref : buffer>, %signed_position: reg<vm.value : i64>, %replacement: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %14 = constant.i64 16
  %15 = constant.i64 2 : reg<vm.value>
  %16 = integer.shift.left.i64 %signed_position, %15
  %17 = integer.add.i64 %16, %14
  %previous = buffer.load %view, %17, %17, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %view, %17, %17, %replacement, 0, "i32.x1"
  return %previous
}

// ====

func.def @exchange_nonnegative_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %bounded_position = index.assume %position [range(%position, 0, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %bounded_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @exchange_nonnegative_word(%view: reg<vm.ref : buffer>, %bounded_position: reg<vm.value : i64>, %replacement: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %14 = constant.i64 16
  %15 = constant.i64 2 : reg<vm.value>
  %16 = integer.shift.left.i64 %bounded_position, %15
  %17 = integer.add.i64 %16, %14
  %previous = buffer.load %view, %17, %17, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %view, %17, %17, %replacement, 0, "i32.x1"
  return %previous
}

// ====

func.def @copy_biased_vector(%source: buffer, %destination: buffer, %position: index) {
  %signed_position = index.assume %position [range(%position, -4, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<12xi32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<12xi32>
  %values = vector.load %source_view[%element] : view<12xi32> -> vector<4xi32>
  vector.store %values, %destination_view[%element] : vector<4xi32>, view<12xi32>
  func.return
}

// ----
low.func.def target<vm.core> abi(vm_function) @copy_biased_vector(%source_view: reg<vm.ref : buffer>, %destination_view: reg<vm.ref : buffer>, %signed_position: reg<vm.value : i64>) asm {
  %50 = constant.i64 16
  %51 = constant.i64 2 : reg<vm.value>
  %52 = integer.shift.left.i64 %signed_position, %51
  %53 = integer.add.i64 %52, %50
  %54 = buffer.load %source_view, %53, %53, 0, "i32.x1" : reg<vm.value : i32>
  %55 = constant.i64 20
  %58 = integer.add.i64 %52, %55
  %59 = buffer.load %source_view, %58, %58, 0, "i32.x1" : reg<vm.value : i32>
  %60 = constant.i64 24
  %63 = integer.add.i64 %52, %60
  %64 = buffer.load %source_view, %63, %63, 0, "i32.x1" : reg<vm.value : i32>
  %65 = constant.i64 28
  %68 = integer.add.i64 %52, %65
  %69 = buffer.load %source_view, %68, %68, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %destination_view, %53, %53, %54, 0, "i32.x1"
  buffer.store %destination_view, %58, %58, %59, 0, "i32.x1"
  buffer.store %destination_view, %63, %63, %64, 0, "i32.x1"
  buffer.store %destination_view, %68, %68, %69, 0, "i32.x1"
  return
}

// ====

// The static contribution fits U32 but has its sign bit set in an i32 carrier.
func.def @exchange_large_bias_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %signed_position = index.assume %position [range(%position, -1073741820, -1073741812)] : index
  %center = index.constant 1073741820 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @exchange_large_bias_word(%view: reg<vm.ref : buffer>, %signed_position: reg<vm.value : i64>, %replacement: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %14 = constant.i64 4294967280
  %15 = constant.i64 2 : reg<vm.value>
  %16 = integer.shift.left.i64 %signed_position, %15
  %17 = integer.add.i64 %16, %14
  %previous = buffer.load %view, %17, %17, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %view, %17, %17, %replacement, 0, "i32.x1"
  return %previous
}
