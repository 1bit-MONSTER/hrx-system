// RUN: with-checks emit source-low target=vm:core output=low

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
CHECK: %7 = constant.i64 0
CHECK: %first = buffer.load<volatile> %source, %7, %7, 0, "i32.x1" : reg<vm.value : i32>
CHECK: %9 = constant.i64 4
CHECK: %second = buffer.load<volatile> %source, %9, %9, 0, "i32.x1" : reg<vm.value : i32>
CHECK: return
CHECK-NOT: * = buffer.load %*

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

// ----
CHECK: %109 = constant.i64 0
CHECK: %110 = buffer.load<volatile> %source, %109, %109, 0, "i32.x1" : reg<vm.value : i32>
CHECK: %139 = constant.i64 60
CHECK: %140 = buffer.load<volatile> %source, %139, %139, 0, "i32.x1" : reg<vm.value : i32>
CHECK: %142 = buffer.load<volatile> %source, %109, %109, 0, "i32.x1" : reg<vm.value : i32>
CHECK: %172 = buffer.load<volatile> %source, %139, %139, 0, "i32.x1" : reg<vm.value : i32>
CHECK: buffer.store<volatile> %destination, %109, %109, %110, 0, "i32.x1"
CHECK: buffer.store<volatile> %destination, %139, %139, %140, 0, "i32.x1"
CHECK: %189 = constant.i64 64
CHECK: buffer.store<volatile> %destination, %189, %189, %142, 0, "i32.x1"
CHECK: %204 = constant.i64 124
CHECK: buffer.store<volatile> %destination, %204, %204, %172, 0, "i32.x1"
CHECK-NOT: * = buffer.load %*
CHECK-NOT: buffer.store %*

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
CHECK: %9 = constant.i64 0
CHECK: %first = buffer.load<volatile> %source, %9, %9, 0, "i8.x1" : reg<vm.value : i8>
CHECK: %second = buffer.load<volatile> %source, %9, %9, 0, "i8.x1" : reg<vm.value : i8>
CHECK: buffer.store<volatile> %destination, %9, %9, %first, 0, "i8.x1"
CHECK: %14 = constant.i64 1
CHECK: buffer.store<volatile> %destination, %14, %14, %second, 0, "i8.x1"
CHECK-NOT: * = buffer.load %*
CHECK-NOT: buffer.store %*

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), multiple_of(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
CHECK: %first = buffer.load<volatile> %source, %base, %base, 0, "i32.x1" : reg<vm.value : i32>
CHECK: %14 = constant.i64 4
CHECK: %15 = integer.add.i64 %base, %14
CHECK: %second = buffer.load<volatile> %source, %15, %15, 0, "i32.x1" : reg<vm.value : i32>
CHECK: return %first, %second
CHECK-NOT: * = buffer.load %*
