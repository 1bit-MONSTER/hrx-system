// RUN: emit source-low target=x86:avx512 output=low

func.def @join_i8(%low: vector<1xi8>, %high: vector<1xi8>) -> (vector<2xi8>) {
  %result = vector.concat<0> %low, %high : vector<1xi8>, vector<1xi8> -> vector<2xi8>
  func.return %result : vector<2xi8>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<1xi8>, vector<1xi8>) -> (vector<2xi8>)}) @join_i8(%low: reg<x86.xmm>, %high: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = vpunpcklbw.xmm %low, %high
  return %result
}

// ====

func.def @join_i16(%low: vector<1xi16>, %high: vector<1xi16>) -> (vector<2xi16>) {
  %result = vector.concat<0> %low, %high : vector<1xi16>, vector<1xi16> -> vector<2xi16>
  func.return %result : vector<2xi16>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<1xi16>, vector<1xi16>) -> (vector<2xi16>)}) @join_i16(%low: reg<x86.xmm>, %high: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = vpunpcklwd.xmm %low, %high
  return %result
}

// ====

func.def @join_i32(%low: vector<1xi32>, %high: vector<1xi32>) -> (vector<2xi32>) {
  %result = vector.concat<0> %low, %high : vector<1xi32>, vector<1xi32> -> vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<1xi32>, vector<1xi32>) -> (vector<2xi32>)}) @join_i32(%low: reg<x86.xmm>, %high: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = vpunpckldq.xmm %low, %high
  return %result
}

// ====

func.def @join_i64(%low: vector<1xi64>, %high: vector<1xi64>) -> (vector<2xi64>) {
  %result = vector.concat<0> %low, %high : vector<1xi64>, vector<1xi64> -> vector<2xi64>
  func.return %result : vector<2xi64>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<1xi64>, vector<1xi64>) -> (vector<2xi64>)}) @join_i64(%low: reg<x86.xmm>, %high: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = vpunpcklqdq.xmm %low, %high
  return %result
}

// ====

func.def @join_f16(%low: vector<8xf16>, %high: vector<8xf16>) -> (vector<16xf16>) {
  %result = vector.concat<0> %low, %high : vector<8xf16>, vector<8xf16> -> vector<16xf16>
  func.return %result : vector<16xf16>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<8xf16>, vector<8xf16>) -> (vector<16xf16>)}) @join_f16(%low: reg<x86.xmm>, %high: reg<x86.xmm>) -> (reg<x86.ymm>) asm {
  %7 = vxorps.zero.ymm
  %8 = vinsertf128.ymm.xmm %7, %low, 0
  %result = vinsertf128.ymm.xmm %8, %high, 1
  return %result
}

// ====

func.def @join_bf16(%low: vector<16xbf16>, %high: vector<16xbf16>) -> (vector<32xbf16>) {
  %result = vector.concat<0> %low, %high : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  func.return %result : vector<32xbf16>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<16xbf16>, vector<16xbf16>) -> (vector<32xbf16>)}) @join_bf16(%low: reg<x86.ymm>, %high: reg<x86.ymm>) -> (reg<x86.zmm>) asm {
  %7 = vxorps.zero
  %8 = vinserti64x4.zmm.ymm %7, %low, 0
  %result = vinserti64x4.zmm.ymm %8, %high, 1
  return %result
}
