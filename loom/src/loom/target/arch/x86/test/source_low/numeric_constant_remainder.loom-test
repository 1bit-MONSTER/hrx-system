// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_constant_remainder.loom-test
// RUN: emit source-low target=x86:avx2 output=low

func.def @constant_remainder_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @constant_remainder_uniform(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %6 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %7 = movzx.gpr64.gpr32 %6
  %8 = mov.imm64 2863311531
  %9 = imul.gpr64 %7, %8
  %10 = shr.imm.gpr64 %9 {shift = 33}
  %11 = lea.add_scale.gpr32 %10, %10 {disp32 = 0, scale = 2}
  %remainder = sub.gpr32 %6, %11
  return %remainder
}

// ====

func.def @constant_remainder_loaded(%input: buffer) -> (i32, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %value, %mask : i32
  %position = index.cast %nonnegative : i32 to index
  %index_divisor = index.constant 3 : index
  %index_remainder = index.rem %position, %index_divisor : index
  func.return %remainder, %index_remainder : i32, index
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @constant_remainder_loaded(%aligned_input: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr64>) asm {
  %value = mov.load.gpr32 %aligned_input {disp32 = 0}
  %18 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %19 = movzx.gpr64.gpr32 %18
  %20 = mov.imm64 2863311531
  %21 = imul.gpr64 %19, %20
  %22 = shr.imm.gpr64 %21 {shift = 33}
  %23 = lea.add_scale.gpr32 %22, %22 {disp32 = 0, scale = 2}
  %remainder = sub.gpr32 %18, %23
  %25 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %nonnegative = and.imm.gpr32 %25 {imm32 = 2147483647}
  %position = movzx.gpr64.gpr32 %nonnegative
  %28 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %30 = copy %28 : reg<x86.gpr64> -> reg<x86.gpr64>
  %31 = imul.gpr64 %30, %20
  %32 = shr.imm.gpr64 %31 {shift = 33}
  %33 = lea.add_scale %32, %32 {disp32 = 0, scale = 2}
  %index_remainder = sub.gpr64 %28, %33
  return %remainder, %index_remainder
}

// ====

func.def @constant_remainder_factors(%word: i32, %position: index) -> (i32, i32, index, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %c5 = scalar.constant 5 : i32
  %c9 = scalar.constant 9 : i32
  %c5_index = index.constant 5 : index
  %c9_index = index.constant 9 : index
  %word_five = scalar.remui %word, %c5 : i32
  %word_nine = scalar.remui %word, %c9 : i32
  %position_five = index.rem %bounded, %c5_index : index
  %position_nine = index.rem %bounded, %c9_index : index
  func.return %word_five, %word_nine, %position_five, %position_nine : i32, i32, index, index
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @constant_remainder_factors(%word: reg<x86.gpr32>, %bounded: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %21 = copy %word : reg<x86.gpr32> -> reg<x86.gpr32>
  %22 = movzx.gpr64.gpr32 %21
  %23 = mov.imm64 3435973837
  %24 = imul.gpr64 %22, %23
  %25 = shr.imm.gpr64 %24 {shift = 34}
  %26 = lea.add_scale.gpr32 %25, %25 {disp32 = 0, scale = 4}
  %word_five = sub.gpr32 %21, %26
  %28 = copy %word : reg<x86.gpr32> -> reg<x86.gpr32>
  %29 = movzx.gpr64.gpr32 %28
  %30 = mov.imm64 954437177
  %31 = imul.gpr64 %29, %30
  %32 = shr.imm.gpr64 %31 {shift = 33}
  %33 = lea.add_scale.gpr32 %32, %32 {disp32 = 0, scale = 8}
  %word_nine = sub.gpr32 %28, %33
  %35 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %37 = copy %35 : reg<x86.gpr64> -> reg<x86.gpr64>
  %38 = imul.gpr64 %37, %23
  %39 = shr.imm.gpr64 %38 {shift = 34}
  %40 = lea.add_scale %39, %39 {disp32 = 0, scale = 4}
  %position_five = sub.gpr64 %35, %40
  %42 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %44 = copy %42 : reg<x86.gpr64> -> reg<x86.gpr64>
  %45 = imul.gpr64 %44, %30
  %46 = shr.imm.gpr64 %45 {shift = 33}
  %47 = lea.add_scale %46, %46 {disp32 = 0, scale = 8}
  %position_nine = sub.gpr64 %42, %47
  return %word_five, %word_nine, %position_five, %position_nine
}

// ====

func.def @constant_remainder_by_seven(%word: i32, %position: index) -> (i32, index, i32, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %word_divisor = scalar.constant 7 : i32
  %index_divisor = index.constant 7 : index
  %word_remainder = scalar.remui %word, %word_divisor : i32
  %index_remainder = index.rem %bounded, %index_divisor : index
  func.return %word_remainder, %index_remainder, %word, %bounded : i32, index, i32, index
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @constant_remainder_by_seven(%word: reg<x86.gpr32>, %bounded: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr64>) asm {
  %17 = movzx.gpr64.gpr32 %word
  %18 = mov.imm64 2635249153387078803
  %19 = imul.gpr64 %17, %18
  %20 = mov.imm64 7
  %21 = copy %19 : reg<x86.gpr64> -> reg<x86.rax>
  %22 = mul.high.gpr64 %21, %20
  %23 = copy %22 : reg<x86.rdx> -> reg<x86.gpr64>
  %word_remainder = mov.trunc.gpr32.gpr64 %23
  %26 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %27 = imul.gpr64 %26, %18
  %29 = copy %27 : reg<x86.gpr64> -> reg<x86.rax>
  %30 = mul.high.gpr64 %29, %20
  %index_remainder = copy %30 : reg<x86.rdx> -> reg<x86.gpr64>
  return %word_remainder, %index_remainder, %word, %bounded
}
