// RUN: emit source-low target=x86:avx2 output=low

func.def @offset_scale_unbounded(%element: index) -> (offset) {
  %stride = index.constant 4 : offset
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_unbounded(%element: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %bytes = lea.scale %element {disp32 = 0, scale = 4}
  return %bytes
}

// ====

func.def @offset_scale_unsigned_wrap(%base: i32, %increment: i32) -> (offset) {
  %wrapped = scalar.addi %base, %increment : i32
  %unsigned = index.cast %wrapped : i32 to offset
  %element = index.cast %unsigned : offset to index
  %stride = index.constant 4 : offset
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_unsigned_wrap(%base: reg<x86.gpr32>, %increment: reg<x86.gpr32>) -> (reg<x86.gpr64>) asm {
  %11 = copy %base : reg<x86.gpr32> -> reg<x86.gpr32>
  %wrapped = add.gpr32 %11, %increment
  %element = movzx.gpr64.gpr32 %wrapped
  %bytes = lea.scale %element {disp32 = 0, scale = 4}
  return %bytes
}

// ====

func.def @offset_scale_large_stride(%element: index) -> (offset) {
  %stride = index.constant 4294967296 : offset
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_large_stride(%element: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %stride = mov.imm64 4294967296
  %7 = copy %element : reg<x86.gpr64> -> reg<x86.gpr64>
  %bytes = imul.gpr64 %7, %stride
  return %bytes
}

// ====

func.def @offset_scale_dynamic_stride(%element: index, %stride: offset) -> (offset) {
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_dynamic_stride(%element: reg<x86.gpr64>, %stride: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %7 = copy %element : reg<x86.gpr64> -> reg<x86.gpr64>
  %bytes = imul.gpr64 %7, %stride
  return %bytes
}

// ====

func.def @offset_scale_lane(%elements: vector<4xi32>, %stride: offset) -> (offset) {
  %raw = vector.extract %elements[0] : vector<4xi32> -> i32
  %unsigned = index.cast %raw : i32 to offset
  %element = index.cast %unsigned : offset to index
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, offset) -> (offset)}) @offset_scale_lane(%elements: reg<x86.xmm>, %stride: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %raw = vpextrd.xmm %elements, 0
  %element = movzx.gpr64.gpr32 %raw
  %12 = copy %element : reg<x86.gpr64> -> reg<x86.gpr64>
  %bytes = imul.gpr64 %12, %stride
  return %bytes
}

// ====

func.def @offset_scale_bounded(%element: index) -> (offset) {
  %bounded = index.assume %element [range(%element, 0, 1023)] : index
  %stride = index.constant 4 : offset
  %bytes = index.scale %bounded, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_bounded(%bounded: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %bytes = lea.scale %bounded {disp32 = 0, scale = 4}
  return %bytes
}

// ====

func.def @offset_scale_nonnegative(%element_input: index, %stride: offset) -> (offset) {
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_nonnegative(%element: reg<x86.gpr64>, %stride: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %8 = copy %element : reg<x86.gpr64> -> reg<x86.gpr64>
  %bytes = imul.gpr64 %8, %stride
  return %bytes
}

// ====

func.def @offset_scale_join(%element_input: index, %choice: i32) -> (offset) {
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %stride = index.constant 4 : offset
  %bytes = index.scale %element, %stride : index, offset -> offset
  %inactive = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %inactive : i32
  %result = scf.if %condition -> (offset) {
    scf.yield %bytes : offset
  } else {
    scf.yield %stride : offset
  }
  func.return %result : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_join(%element: reg<x86.gpr64>, %choice: reg<x86.gpr32>) -> (reg<x86.gpr64>) asm {
  %stride = mov.imm64 4
  %bytes = lea.scale %element {disp32 = 0, scale = 4}
  %15 = copy %stride : reg<x86.gpr64> -> reg<x86.gpr64>
  %result = cmp.select.imm.gpr32.gpr64 %choice, %bytes, %15, 0, "ne"
  return %result
}

// ====

func.def @offset_scale_loop(%element_input: index, %stride: offset, %count: index) -> (offset) {
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %bytes = index.scale %element, %stride : index, offset -> offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %count step %step](%current = %bytes : offset) -> (offset) {
    %next = index.add %current, %stride : offset
    scf.yield %next : offset
  }
  %previous = index.sub %result, %stride : offset
  func.return %previous : offset
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @offset_scale_loop(%element: reg<x86.gpr64>, %stride: reg<x86.gpr64>, %count: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %25 = copy %element : reg<x86.gpr64> -> reg<x86.gpr64>
  %bytes = imul.gpr64 %25, %stride
  %begin = mov.imm64 0
  low.br ^_bb1(%begin: reg<x86.gpr64>, %bytes: reg<x86.gpr64>)
^_bb1(%iteration: reg<x86.gpr64>, %current: reg<x86.gpr64>):
  low.op.cond_br<x86.scalar.cmp.branch.gpr64>(%iteration, %count) {predicate = 12}, ^_bb2, ^_bb3 : (reg<x86.gpr64>, reg<x86.gpr64>)
^_bb2:
  %next = lea %current, %stride
  %29 = lea.disp %iteration {disp32 = 1}
  low.br ^_bb1(%29: reg<x86.gpr64>, %next: reg<x86.gpr64>)
^_bb3:
  %30 = copy %current : reg<x86.gpr64> -> reg<x86.gpr64>
  %previous = sub.gpr64 %30, %stride
  return %previous
}
