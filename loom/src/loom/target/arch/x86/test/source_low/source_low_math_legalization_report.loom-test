// RUN: with-checks compile-report target=x86:avx2 legalize-math

// The report distinguishes strict composition, accuracy-restoring refinement,
// and the additional permission needed to select the raw native estimate.
func.def @avx2_rsqrt_policy(%strict: f32, %approximate: f32, %raw: f32) -> (f32, f32, f32) {
  %strict_result = scalar.rsqrtf %strict : f32
  %approximate_result = scalar.rsqrtf<afn> %approximate : f32
  %raw_result = scalar.rsqrtf<arcp|afn> %raw : f32
  func.return %strict_result, %approximate_result, %raw_result : f32, f32, f32
}

// ----
CHECK: COMPILE-REPORT: math_legalization[*] function=avx2_rsqrt_policy source_op=scalar.rsqrtf action=rewritten policy=x86-math math_op=rsqrtf domain=scalar element=f32 recipe=rsqrt-sqrt-div constraint=math.recipe.rsqrt_sqrt_div * source_fastmath=0x00 recipe_fastmath=0x00 * native_required_fastmath=0x50
CHECK: COMPILE-REPORT: math_legalization[*] function=avx2_rsqrt_policy source_op=scalar.rsqrtf action=rewritten policy=x86-math math_op=rsqrtf domain=scalar element=f32 recipe=rsqrt-newton-one constraint=math.recipe.rsqrt_newton_one * source_fastmath=0x40 recipe_fastmath=0x50 * native_required_fastmath=0x50
CHECK-NOT: COMPILE-REPORT: math_legalization[*] * source_fastmath=0x50 *

// ====
// RUN: with-checks compile-report target=x86:avx512 legalize-math

// AVX-512 reports the precision-selected refinement count without duplicating
// the target policy table in the test.
func.def @avx512_rsqrt_refinement(%f32_value: f32, %f64_value: f64) -> (f32, f64) {
  %f32_result = scalar.rsqrtf<afn> %f32_value : f32
  %f64_result = scalar.rsqrtf<afn> %f64_value : f64
  func.return %f32_result, %f64_result : f32, f64
}

// ----
CHECK: COMPILE-REPORT: math_legalization[*] function=avx512_rsqrt_refinement source_op=scalar.rsqrtf action=rewritten policy=x86-math math_op=rsqrtf domain=scalar element=f32 recipe=rsqrt-newton-one constraint=math.recipe.rsqrt_newton_one * source_fastmath=0x40 recipe_fastmath=0x50 * native_required_fastmath=0x50
CHECK: COMPILE-REPORT: math_legalization[*] function=avx512_rsqrt_refinement source_op=scalar.rsqrtf action=rewritten policy=x86-math math_op=rsqrtf domain=scalar element=f64 recipe=rsqrt-newton-two constraint=math.recipe.rsqrt_newton_two * source_fastmath=0x40 recipe_fastmath=0x50 * native_required_fastmath=0x50
