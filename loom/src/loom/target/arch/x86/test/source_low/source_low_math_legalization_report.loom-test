// ====

// AVX-512 FP16 extends the same policy to scalar and packed F16 operations.
// RUN: compile-report legalize-math

x86.target<avx512_packed_dot> @target {contract_feature_bits = 130, contract_set_key = "x86.avx512_features.core"}

func.def target(@target) @avx512_fp16_strict_rsqrt(%scalar: f16, %vector: vector<32xf16>) -> (f16, vector<32xf16>) {
  %scalar_result = scalar.rsqrtf %scalar : f16
  %vector_result = vector.rsqrtf %vector : vector<32xf16>
  func.return %scalar_result, %vector_result : f16, vector<32xf16>
}

