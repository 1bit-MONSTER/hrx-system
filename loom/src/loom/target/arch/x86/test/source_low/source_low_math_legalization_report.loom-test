// ====

// AVX-512 has native approximate reciprocal-root forms for both F32 and F64.
// RUN: compile-report target=x86:avx512 legalize-math

func.def @avx512_strict_rsqrt(%scalar_f32: f32, %scalar_f64: f64, %vector_f32: vector<16xf32>, %vector_f64: vector<8xf64>) -> (f32, f64, vector<16xf32>, vector<8xf64>) {
  %scalar_f32_result = scalar.rsqrtf %scalar_f32 : f32
  %scalar_f64_result = scalar.rsqrtf %scalar_f64 : f64
  %vector_f32_result = vector.rsqrtf %vector_f32 : vector<16xf32>
  %vector_f64_result = vector.rsqrtf %vector_f64 : vector<8xf64>
  func.return %scalar_f32_result, %scalar_f64_result, %vector_f32_result, %vector_f64_result : f32, f64, vector<16xf32>, vector<8xf64>
}

