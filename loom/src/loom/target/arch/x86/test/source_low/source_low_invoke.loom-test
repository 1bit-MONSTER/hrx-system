// RUN: emit source-low output=low

// Source invocation preserves the native callable boundary after translating
// semantic operands to the callee's Low register representation.
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @identity(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

func.def target(@target) @caller(%value: i32) -> (i32) {
  %result = low.invoke @identity(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
low.func.def target<x86.scalar.core>(@target) @identity(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

low.func.def target<x86.scalar.core>(@target) abi(object_function) @caller(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %result = low.func.call @identity(%value) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  return %result
}

// ====

// An authored noinline boundary survives source normalization unchanged.
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @identity(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

func.def target(@target) @noinline_caller(%value: i32) -> (i32) {
  %result = low.invoke noinline @identity(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
low.func.def target<x86.scalar.core>(@target) @identity(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

low.func.def target<x86.scalar.core>(@target) abi(object_function) @noinline_caller(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %result = low.func.call noinline @identity(%value) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  return %result
}
