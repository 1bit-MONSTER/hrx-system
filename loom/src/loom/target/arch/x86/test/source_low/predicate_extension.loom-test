// RUN: emit source-low target=x86:avx2 output=low

func.def @predicate_extension_i8(%condition: i1) -> (i8, i8) {
  %signed = scalar.extsi %condition : i1 to i8
  %unsigned = scalar.extui %condition : i1 to i8
  func.return %signed, %unsigned : i8, i8
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i1) -> (i8, i8)}) @predicate_extension_i8(%unsigned: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %8 = copy %unsigned : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed = neg.gpr32 %8
  return %signed, %unsigned
}

// ====

func.def @predicate_extension_i16(%condition: i1) -> (i16, i16) {
  %signed = scalar.extsi %condition : i1 to i16
  %unsigned = scalar.extui %condition : i1 to i16
  func.return %signed, %unsigned : i16, i16
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i1) -> (i16, i16)}) @predicate_extension_i16(%unsigned: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %8 = copy %unsigned : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed = neg.gpr32 %8
  return %signed, %unsigned
}

// ====

func.def @predicate_extension_i32(%condition: i1) -> (i32, i32) {
  %signed = scalar.extsi %condition : i1 to i32
  %unsigned = scalar.extui %condition : i1 to i32
  func.return %signed, %unsigned : i32, i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i1) -> (i32, i32)}) @predicate_extension_i32(%unsigned: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %8 = copy %unsigned : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed = neg.gpr32 %8
  return %signed, %unsigned
}

// ====

func.def @predicate_extension_i64(%condition: i1) -> (i64, i64) {
  %signed = scalar.extsi %condition : i1 to i64
  %unsigned = scalar.extui %condition : i1 to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i1) -> (i64, i64)}) @predicate_extension_i64(%condition: reg<x86.gpr32>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %8 = movzx.gpr64.gpr32 %condition
  %signed = neg.gpr64 %8
  %unsigned = movzx.gpr64.gpr32 %condition
  return %signed, %unsigned
}
