x86.target<avx2> @target

func.def target(@target) @scalar_tanhf_rejected_by_math_policy(%input: f32) -> (f32) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.tanhf", phase_name="legalize-math", policy_name="x86-math", math_op="tanhf", lane_domain="scalar", element_type="f32", constraint_key="math.op.supported"}
