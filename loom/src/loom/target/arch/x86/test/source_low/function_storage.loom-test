// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<16xi32>) -> (vector<16xi32>)}) @local_vector(%input: reg<x86.zmm>) -> (reg<x86.zmm>) asm {
  %9 = storage {byte_alignment = 64, byte_length = 64} : low.storage<private>
