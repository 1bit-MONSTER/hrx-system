low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (vector<16xi32>) -> (vector<16xi32>)}) @local_vector(%input: reg<x86.zmm>) -> (reg<x86.zmm>) asm {
