// ====

func.def @convert_f32_f16_1(%input: f32) -> (f16) {
  %result = scalar.fptrunc %input : f32 to f16
  func.return %result : f16
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (f32) -> (f16)}) @convert_f32_f16_1(%input: reg<x86.xmm>) -> (reg<x86.gpr32>) asm {
  %5 = avx512.vcvtps2ph.xmm.xmm %input, 0
  %result = vmovd.gpr32.xmm %5
  return %result
}

