// RUN: emit source-low target=x86:avx512 output=low

func.def @convert_f16_f32_1(%input: f16) -> (f32) {
  %result = scalar.extf %input : f16 to f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (f16) -> (f32)}) @convert_f16_f32_1(%input: reg<x86.gpr32>) -> (reg<x86.xmm>) asm {
  %5 = vmovd.xmm.gpr32 %input
  %result = avx512.vcvtph2ps.xmm.xmm %5
  return %result
}

// ====

func.def @convert_f16_f32_2(%input: vector<2xf16>) -> (vector<2xf32>) {
  %result = vector.extf %input : vector<2xf16> to vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<2xf16>) -> (vector<2xf32>)}) @convert_f16_f32_2(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = avx512.vcvtph2ps.xmm.xmm %input
  return %result
}

