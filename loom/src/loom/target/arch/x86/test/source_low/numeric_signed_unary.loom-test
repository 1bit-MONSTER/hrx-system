// RUN: emit source-low target=x86:scalar output=low

func.def @signed_unary_i1(%input: i1) -> (i1, i1) {
  %negative = scalar.negi %input : i1
  %absolute = scalar.absi %input : i1
  func.return %negative, %absolute : i1, i1
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (i1) -> (i1, i1)}) @signed_unary_i1(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  return %input, %input
}

// ====

func.def @signed_unary_i8(%input: i8) -> (i8, i8) {
  %negative = scalar.negi %input : i8
  %absolute = scalar.absi %input : i8
  func.return %negative, %absolute : i8, i8
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (i8) -> (i8, i8)}) @signed_unary_i8(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %18 = movsx.i8.gpr32 %input
  %19 = mov.imm32 0
  %20 = copy %19 : reg<x86.gpr32> -> reg<x86.gpr32>
  %negative = sub.gpr32 %20, %18
  %22 = copy %18 : reg<x86.gpr32> -> reg<x86.gpr32>
  %23 = sar.imm.gpr32 %22 {shift = 31}
  %24 = copy %18 : reg<x86.gpr32> -> reg<x86.gpr32>
  %25 = xor.gpr32 %24, %23
  %26 = copy %25 : reg<x86.gpr32> -> reg<x86.gpr32>
  %absolute = sub.gpr32 %26, %23
  return %negative, %absolute
}

