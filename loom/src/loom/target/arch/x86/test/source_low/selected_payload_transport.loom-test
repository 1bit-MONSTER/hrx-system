// RUN: pass target=x86:avx2 source-to-low

func.def public @selected_truncated(%input: vector<4xi32>, %left: i64, %right: i64) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, i64, i64) -> (i32)}) @selected_truncated(%input: reg<x86.xmm>, %left: reg<x86.gpr64>, %right: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %value = vpextrd.xmm %input, 0
  %16 = copy %right : reg<x86.gpr64> -> reg<x86.gpr64>
  %selected = cmp.select.imm.gpr32.gpr64 %value, %left, %16, 0, "sgt"
  %payload = mov.trunc.gpr32.gpr64 %selected
  low.br ^forward(%payload: reg<x86.gpr32>)
^forward(%carried: reg<x86.gpr32>):
  return %carried
}

// ====

func.def public @selected_coordinate(%input: vector<4xi32>, %left: i32, %right: i32) -> (index) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload = index.cast %selected : i32 to index
  cfg.br ^forward(%payload: index)
^forward(%carried: index):
  func.return %carried : index
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, i32, i32) -> (index)}) @selected_coordinate(%input: reg<x86.xmm>, %left: reg<x86.gpr32>, %right: reg<x86.gpr32>) -> (reg<x86.gpr64>) asm {
  %value = vpextrd.xmm %input, 0
  %16 = copy %right : reg<x86.gpr32> -> reg<x86.gpr32>
  %selected = cmp.select.imm.gpr32.gpr32 %value, %left, %16, 0, "sgt"
  %payload = movsxd.gpr64.gpr32 %selected
  low.br ^forward(%payload: reg<x86.gpr64>)
^forward(%carried: reg<x86.gpr64>):
  return %carried
}

