// ====

func.def public @selected_converted_offset(%choice: i32, %narrow: i32, %fallback: offset) -> (offset) {
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %threshold : i32
  %converted = index.cast %narrow : i32 to offset
  %selected = scf.select %condition, %converted, %fallback : offset
  cfg.br ^forward(%selected: offset)
^forward(%carried: offset):
  func.return %carried : offset
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) @selected_converted_offset(%choice: reg<x86.gpr32>, %narrow: reg<x86.gpr32>, %fallback: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %converted = movzx.gpr64.gpr32 %narrow
  %15 = copy %fallback : reg<x86.gpr64> -> reg<x86.gpr64>
  %selected = cmp.select.imm.gpr32.gpr64 %choice, %converted, %15, 0, "ne"
  low.br ^forward(%selected: reg<x86.gpr64>)
^forward(%carried: reg<x86.gpr64>):
  return %carried
}

// ====

func.def public @selected_extended_truncation(%input: vector<4xi32>, %left: i64, %right: i64) -> (i64) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %narrowed = scalar.trunci %selected : i64 to i32
  %payload = scalar.extsi %narrowed : i32 to i64
  cfg.br ^forward(%payload: i64)
^forward(%carried: i64):
  func.return %carried : i64
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, i64, i64) -> (i64)}) @selected_extended_truncation(%input: reg<x86.xmm>, %left: reg<x86.gpr64>, %right: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %value = vpextrd.xmm %input, 0
  %17 = copy %right : reg<x86.gpr64> -> reg<x86.gpr64>
  %selected = cmp.select.imm.gpr32.gpr64 %value, %left, %17, 0, "sgt"
  %narrowed = mov.trunc.gpr32.gpr64 %selected
  %payload = movsxd.gpr64.gpr32 %narrowed
  low.br ^forward(%payload: reg<x86.gpr64>)
^forward(%carried: reg<x86.gpr64>):
  return %carried
}

// ====

func.def public @selected_assumption_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload, %bounded = scalar.assume %scalar, %selected [range(%selected, 0, 42)] : i32, i32
  cfg.br ^forward(%bounded: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, i32, i32, i32) -> (i32)}) @selected_assumption_payload(%input: reg<x86.xmm>, %left: reg<x86.gpr32>, %right: reg<x86.gpr32>, %payload: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value = vpextrd.xmm %input, 0
  %19 = copy %right : reg<x86.gpr32> -> reg<x86.gpr32>
  %bounded = cmp.select.imm.gpr32.gpr32 %value, %left, %19, 0, "sgt"
  low.br ^forward(%bounded: reg<x86.gpr32>)
^forward(%carried: reg<x86.gpr32>):
  return %carried
}

// ====

func.def public @independent_predicate_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload = scalar.assume %scalar [lt(%scalar, %selected)] : i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, i32, i32, i32) -> (i32)}) @independent_predicate_payload(%input: reg<x86.xmm>, %left: reg<x86.gpr32>, %right: reg<x86.gpr32>, %payload: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  low.br ^forward(%payload: reg<x86.gpr32>)
^forward(%carried: reg<x86.gpr32>):
  return %carried
}
