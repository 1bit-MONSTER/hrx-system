// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi32>, i32, i32) -> (offset)}) @selected_offset(%input: reg<x86.xmm>, %left: reg<x86.gpr32>, %right: reg<x86.gpr32>) -> (reg<x86.gpr64>) asm {
  %value = vpextrd.xmm %input, 0
  %16 = copy %right : reg<x86.gpr32> -> reg<x86.gpr32>
  %selected = cmp.select.imm.gpr32.gpr32 %value, %left, %16, 0, "sgt"
  %payload = movzx.gpr64.gpr32 %selected
