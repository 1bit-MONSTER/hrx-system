func.def @runtime_i64_division(%lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  %signed_quotient = scalar.divsi %lhs, %rhs : i64
  %signed_remainder = scalar.remsi %lhs, %rhs : i64
  %unsigned_quotient = scalar.divui %lhs, %rhs : i64
  %unsigned_remainder = scalar.remui %lhs, %rhs : i64
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

