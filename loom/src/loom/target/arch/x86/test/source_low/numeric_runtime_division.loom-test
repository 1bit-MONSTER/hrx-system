// RUN: emit source-low target=x86:avx2 output=low

func.def @runtime_i32_division(%lhs: i32, %rhs: i32) -> (i32, i32, i32, i32) {
  %signed_quotient = scalar.divsi %lhs, %rhs : i32
  %signed_remainder = scalar.remsi %lhs, %rhs : i32
  %unsigned_quotient = scalar.divui %lhs, %rhs : i32
  %unsigned_remainder = scalar.remui %lhs, %rhs : i32
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @runtime_i32_division(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %16 = mov.dividend.low.gpr32 %lhs
  %17 = sign.extend.dividend.gpr32 %16
  %18 = divs.quotient.gpr32 %16, %17, %rhs
  %signed_quotient = copy %18 : reg<x86.eax> -> reg<x86.gpr32>
  %20 = cmp.eq.imm.gpr32 %rhs, -1
  %21 = mov.imm32 1
  %22 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %23 = select.gpr32 %20, %21, %22
  %24 = mov.dividend.low.gpr32 %lhs
  %25 = sign.extend.dividend.gpr32 %24
  %26 = divs.remainder.gpr32 %24, %25, %23
  %signed_remainder = copy %26 : reg<x86.edx> -> reg<x86.gpr32>
  %28 = mov.dividend.low.gpr32 %lhs
  %29 = zero.dividend.high.gpr32
  %30 = divu.quotient.gpr32 %28, %29, %rhs
  %unsigned_quotient = copy %30 : reg<x86.eax> -> reg<x86.gpr32>
  %32 = mov.dividend.low.gpr32 %lhs
  %33 = zero.dividend.high.gpr32
  %34 = divu.remainder.gpr32 %32, %33, %rhs
  %unsigned_remainder = copy %34 : reg<x86.edx> -> reg<x86.gpr32>
  return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder
}

// ====

func.def @proven_signed_remainders(%lhs: i32, %positive_input: i32, %negative_input: i32) -> (i32, i32) {
  %positive = scalar.assume %positive_input [range(%positive_input, 1, 2147483647)] : i32
  %negative = scalar.assume %negative_input [range(%negative_input, -2147483648, -2)] : i32
  %positive_remainder = scalar.remsi %lhs, %positive : i32
  %negative_remainder = scalar.remsi %lhs, %negative : i32
  func.return %positive_remainder, %negative_remainder : i32, i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @proven_signed_remainders(%lhs: reg<x86.gpr32>, %positive: reg<x86.gpr32>, %negative: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %14 = mov.dividend.low.gpr32 %lhs
  %15 = sign.extend.dividend.gpr32 %14
  %16 = divs.remainder.gpr32 %14, %15, %positive
  %positive_remainder = copy %16 : reg<x86.edx> -> reg<x86.gpr32>
  %18 = mov.dividend.low.gpr32 %lhs
  %19 = sign.extend.dividend.gpr32 %18
  %20 = divs.remainder.gpr32 %18, %19, %negative
  %negative_remainder = copy %20 : reg<x86.edx> -> reg<x86.gpr32>
  return %positive_remainder, %negative_remainder
}

