func.def @copy_byte_tail_17(%input: buffer, %output: buffer) {
  %origin_integer = index.constant 1 : offset
  %source_integer = buffer.view %input[%origin_integer] : buffer -> view<17xi8>
  %target_integer = buffer.view %output[%origin_integer] : buffer -> view<17xi8>
  %value_integer = vector.load %source_integer[0] : view<17xi8> -> vector<17xi8>
  vector.store %value_integer, %target_integer[0] : vector<17xi8>, view<17xi8>
  func.return
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @copy_byte_tail_17(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %11 = vmovdqu32.load.xmm %input {disp32 = 1}
  %12 = movzx.load.u8.gpr32 %input {disp32 = 17}
  vmovdqu32.store.xmm %11, %output {disp32 = 1}
  mov.store.u8.gpr32 %12, %output {disp32 = 17}
  return
}

