// ====

// Captured bytes survive an aliasing write and a second volatile observation.
func.def @capture_byte_tail(%input: buffer, %output: buffer, %replacement_input: buffer) {
  %base = index.constant 0 : offset
  %next = index.constant 3 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %before = buffer.view %output[%base] : buffer -> view<3xi8>
  %after = buffer.view %output[%next] : buffer -> view<3xi8>
  %captured = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  %replacement_view = buffer.view %replacement_input[%base] : buffer -> view<3xi8>
  %replacement = vector.load %replacement_view[0] : view<3xi8> -> vector<3xi8>
  vector.store<volatile> %replacement, %source[0] : vector<3xi8>, view<3xi8>
  %reloaded = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  vector.store %captured, %before[0] : vector<3xi8>, view<3xi8>
  vector.store %reloaded, %after[0] : vector<3xi8>, view<3xi8>
  func.return
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @capture_byte_tail(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %replacement_input: reg<x86.gpr64>) asm {
  %45 = movzx.load.u8.gpr32<volatile> %input {disp32 = 0}
  %46 = movzx.load.u8.gpr32<volatile> %input {disp32 = 1}
  %47 = movzx.load.u8.gpr32<volatile> %input {disp32 = 2}
  %48 = movzx.load.u8.gpr32 %replacement_input {disp32 = 0}
  %49 = movzx.load.u8.gpr32 %replacement_input {disp32 = 1}
  %50 = movzx.load.u8.gpr32 %replacement_input {disp32 = 2}
  mov.store.u8.gpr32<volatile> %48, %input {disp32 = 0}
  mov.store.u8.gpr32<volatile> %49, %input {disp32 = 1}
  mov.store.u8.gpr32<volatile> %50, %input {disp32 = 2}
  %51 = movzx.load.u8.gpr32<volatile> %input {disp32 = 0}
  %52 = movzx.load.u8.gpr32<volatile> %input {disp32 = 1}
  %53 = movzx.load.u8.gpr32<volatile> %input {disp32 = 2}
  mov.store.u8.gpr32 %45, %output {disp32 = 0}
  mov.store.u8.gpr32 %46, %output {disp32 = 1}
  mov.store.u8.gpr32 %47, %output {disp32 = 2}
  mov.store.u8.gpr32 %51, %output {disp32 = 3}
  mov.store.u8.gpr32 %52, %output {disp32 = 4}
  mov.store.u8.gpr32 %53, %output {disp32 = 5}
  return
}
