// RUN: emit source-low target=x86:scalar output=low

func.def @integer_extrema_i32(%lhs: i32, %rhs: i32) -> (i32, i32, i32, i32) {
  %signed_min = scalar.minsi %lhs, %rhs : i32
  %signed_max = scalar.maxsi %lhs, %rhs : i32
  %unsigned_min = scalar.minui %lhs, %rhs : i32
  %unsigned_max = scalar.maxui %lhs, %rhs : i32
  func.return %signed_min, %signed_max, %unsigned_min, %unsigned_max : i32, i32, i32, i32
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @integer_extrema_i32(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %24 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed_min = cmp.select.gpr32.gpr32 %lhs, %rhs, %lhs, %24, "slt"
  %26 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed_max = cmp.select.gpr32.gpr32 %lhs, %rhs, %lhs, %26, "sgt"
  %28 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %unsigned_min = cmp.select.gpr32.gpr32 %lhs, %rhs, %lhs, %28, "ult"
  %30 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %unsigned_max = cmp.select.gpr32.gpr32 %lhs, %rhs, %lhs, %30, "ugt"
  return %signed_min, %signed_max, %unsigned_min, %unsigned_max
}

// ====

func.def @integer_extrema_i64(%lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  %signed_min = scalar.minsi %lhs, %rhs : i64
  %signed_max = scalar.maxsi %lhs, %rhs : i64
  %unsigned_min = scalar.minui %lhs, %rhs : i64
  %unsigned_max = scalar.maxui %lhs, %rhs : i64
  func.return %signed_min, %signed_max, %unsigned_min, %unsigned_max : i64, i64, i64, i64
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @integer_extrema_i64(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %24 = copy %rhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %signed_min = cmp.select.gpr64.gpr64 %lhs, %rhs, %lhs, %24, "slt"
  %26 = copy %rhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %signed_max = cmp.select.gpr64.gpr64 %lhs, %rhs, %lhs, %26, "sgt"
  %28 = copy %rhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %unsigned_min = cmp.select.gpr64.gpr64 %lhs, %rhs, %lhs, %28, "ult"
  %30 = copy %rhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %unsigned_max = cmp.select.gpr64.gpr64 %lhs, %rhs, %lhs, %30, "ugt"
  return %signed_min, %signed_max, %unsigned_min, %unsigned_max
}

// ====

func.def @index_extrema(%lhs: index, %rhs: index) -> (index, index) {
  %minimum = index.min %lhs, %rhs : index
  %maximum = index.max %lhs, %rhs : index
  func.return %minimum, %maximum : index, index
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @index_extrema(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %14 = copy %rhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %minimum = cmp.select.gpr64.gpr64 %lhs, %rhs, %lhs, %14, "slt"
  %16 = copy %rhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %maximum = cmp.select.gpr64.gpr64 %lhs, %rhs, %lhs, %16, "sgt"
  return %minimum, %maximum
}
