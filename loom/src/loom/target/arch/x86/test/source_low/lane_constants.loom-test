// Exact nonuniform lanes become one immutable load at every physical vector
// width. Module interning shares equal payloads across functions while uniform
// and mixed lanes retain their specialized construction paths.
// RUN: emit source-low output=module

x86.target<avx512> @target

func.def target(@target) @construct_exact_lanes() -> (vector<16xi8>, vector<8xi16>, vector<8xf32>, vector<8xi64>) {
  %i8_low = scalar.constant 1 : i8
  %i8_high = scalar.constant -2 : i8
  %xmm_bytes = vector.from_elements %i8_low, %i8_high, %i8_low, %i8_high, %i8_low, %i8_high, %i8_low, %i8_high, %i8_low, %i8_high, %i8_low, %i8_high, %i8_low, %i8_high, %i8_low, %i8_high : vector<16xi8>
  %i16_low = scalar.constant 258 : i16
  %i16_high = scalar.constant -3 : i16
  %xmm_words = vector.from_elements %i16_low, %i16_high, %i16_low, %i16_high, %i16_low, %i16_high, %i16_low, %i16_high : vector<8xi16>
  %f32_low = scalar.constant 1.5 : f32
  %f32_high = scalar.constant -2.25 : f32
  %ymm_dwords = vector.from_elements %f32_low, %f32_high, %f32_low, %f32_high, %f32_low, %f32_high, %f32_low, %f32_high : vector<8xf32>
  %i64_low = scalar.constant 81985529216486895 : i64
  %i64_high = scalar.constant -2 : i64
  %zmm_qwords = vector.from_elements %i64_low, %i64_high, %i64_low, %i64_high, %i64_low, %i64_high, %i64_low, %i64_high : vector<8xi64>
  func.return %xmm_bytes, %xmm_words, %ymm_dwords, %zmm_qwords : vector<16xi8>, vector<8xi16>, vector<8xf32>, vector<8xi64>
}

func.def target(@target) @reuse_exact_lanes() -> (vector<16xi8>) {
  %low = scalar.constant 1 : i8
  %high = scalar.constant -2 : i8
  %result = vector.from_elements %low, %high, %low, %high, %low, %high, %low, %high, %low, %high, %low, %high, %low, %high, %low, %high : vector<16xi8>
  func.return %result : vector<16xi8>
}

func.def target(@target) @construct_uniform_lanes() -> (vector<8xi16>) {
  %left = scalar.constant 7 : i16
  %right = scalar.constant 7 : i16
  %result = vector.from_elements %left, %right, %left, %right, %left, %right, %left, %right : vector<8xi16>
  func.return %result : vector<8xi16>
}

func.def target(@target) @construct_mixed_lanes(%dynamic: i32) -> (vector<4xi32>) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %result = vector.from_elements %dynamic, %c1, %c2, %c3 : vector<4xi32>
  func.return %result : vector<4xi32>
}

func.def target(@target) @construct_exact_storage_lanes() -> (vector<16xf8E4M3>, vector<16xf8E5M2>, vector<8xf16>, vector<8xbf16>, vector<4xi32>, vector<2xf64>) {
  %e4_low = scalar.constant 1.5 : f8E4M3
  %e4_high = scalar.constant -1.5 : f8E4M3
  %e4 = vector.from_elements %e4_low, %e4_high, %e4_low, %e4_high, %e4_low, %e4_high, %e4_low, %e4_high, %e4_low, %e4_high, %e4_low, %e4_high, %e4_low, %e4_high, %e4_low, %e4_high : vector<16xf8E4M3>
  %e5_low = scalar.constant 1.5 : f8E5M2
  %e5_high = scalar.constant -1.5 : f8E5M2
  %e5 = vector.from_elements %e5_low, %e5_high, %e5_low, %e5_high, %e5_low, %e5_high, %e5_low, %e5_high, %e5_low, %e5_high, %e5_low, %e5_high, %e5_low, %e5_high, %e5_low, %e5_high : vector<16xf8E5M2>
  %f16_low = scalar.constant 1.5 : f16
  %f16_high = scalar.constant -2.0 : f16
  %f16 = vector.from_elements %f16_low, %f16_high, %f16_low, %f16_high, %f16_low, %f16_high, %f16_low, %f16_high : vector<8xf16>
  %bf16_low = scalar.constant 1.5 : bf16
  %bf16_high = scalar.constant -2.0 : bf16
  %bf16 = vector.from_elements %bf16_low, %bf16_high, %bf16_low, %bf16_high, %bf16_low, %bf16_high, %bf16_low, %bf16_high : vector<8xbf16>
  %i32_low = scalar.constant 305419896 : i32
  %i32_high = scalar.constant -2 : i32
  %i32 = vector.from_elements %i32_low, %i32_high, %i32_low, %i32_high : vector<4xi32>
  %f64_low = scalar.constant 1.5 : f64
  %f64_high = scalar.constant -2.25 : f64
  %f64 = vector.from_elements %f64_low, %f64_high : vector<2xf64>
  func.return %e4, %e5, %f16, %bf16, %i32, %f64 : vector<16xf8E4M3>, vector<16xf8E5M2>, vector<8xf16>, vector<8xbf16>, vector<4xi32>, vector<2xf64>
}

// ----
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = () -> (vector<16xi8>, vector<8xi16>, vector<8xf32>, vector<8xi64>)}) @construct_exact_lanes() -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.ymm>, reg<x86.zmm>) asm {
  %xmm_bytes = avx2.vmovdqu.rodata.xmm @__low_rodata_c4c062ff
  %xmm_words = avx2.vmovdqu.rodata.xmm @__low_rodata_4a75d4f7
  %ymm_dwords = avx2.vmovdqu.rodata.ymm @__low_rodata_d73f477f
  %zmm_qwords = avx512.vmovdqu64.rodata.zmm @__low_rodata_f14fa1bf
  return %xmm_bytes, %xmm_words, %ymm_dwords, %zmm_qwords
}

low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = () -> (vector<16xi8>)}) @reuse_exact_lanes() -> (reg<x86.xmm>) asm {
  %result = avx2.vmovdqu.rodata.xmm @__low_rodata_c4c062ff
  return %result
}

low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = () -> (vector<8xi16>)}) @construct_uniform_lanes() -> (reg<x86.xmm>) asm {
  %11 = mov.imm32 7
  %result = avx512.vpbroadcastw.xmm %11
  return %result
}

low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = (i32) -> (vector<4xi32>)}) @construct_mixed_lanes(%dynamic: reg<x86.gpr32>) -> (reg<x86.xmm>) asm {
  %c1 = mov.imm32 1
  %c2 = mov.imm32 2
  %c3 = mov.imm32 3
  %18 = vmovd.xmm.gpr32 %dynamic
  %19 = vpinsrd.xmm %18, %c1, 1
  %20 = vpinsrd.xmm %19, %c2, 2
  %result = vpinsrd.xmm %20, %c3, 3
  return %result
}

low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = () -> (vector<16xf8E4M3>, vector<16xf8E5M2>, vector<8xf16>, vector<8xbf16>, vector<4xi32>, vector<2xf64>)}) @construct_exact_storage_lanes() -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %e4 = avx2.vmovdqu.rodata.xmm @__low_rodata_5626d74f
  %e5 = avx2.vmovdqu.rodata.xmm @__low_rodata_5362c38f
  %f16 = avx2.vmovdqu.rodata.xmm @__low_rodata_3597da8f
  %bf16 = avx2.vmovdqu.rodata.xmm @__low_rodata_184f736f
  %i32 = avx2.vmovdqu.rodata.xmm @__low_rodata_9bdcd267
  %f64 = avx2.vmovdqu.rodata.xmm @__low_rodata_f5738314
  return %e4, %e5, %f16, %bf16, %i32, %f64
}

