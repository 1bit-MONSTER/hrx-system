// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def inline schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// Partial unrolling preserves independent scopes in the loop and its tail.
func.def public target(@target) @partial_unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 5 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll(%factor) {
    %left_input = scalar.addi %lhs, %sum : i32
    %right_input = scalar.addi %rhs, %sum : i32
    %left = low.invoke @scoped_double(%left_input) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%right_input) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def public target<x86.scalar.core>(@target) abi(object_function) @partial_unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %begin = mov.imm64 0
  %initial = mov.imm32 0
  low.br ^_bb1(%begin: reg<x86.gpr64>, %initial: reg<x86.gpr32>)
^_bb1(%i: reg<x86.gpr64>, %sum: reg<x86.gpr32>):
  low.op.cond_br<x86.scalar.cmp.branch.imm.gpr64>(%i) {imm32 = 5, predicate = 12}, ^_bb2, ^_bb6 : (reg<x86.gpr64>)
^_bb2:
  %58 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_input = add.gpr32 %58, %sum
  %60 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %right_input = add.gpr32 %60, %sum
  low.schedule.begin
  %value_copy$88 = copy %left_input : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$89 = add.gpr32 %value_copy$88, %left_input
  low.schedule.phase
  %first_copy$90 = copy %first$89 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$91 = add.gpr32 %first_copy$90, %first$89
  low.schedule.end
  low.schedule.begin
  %value_copy$84 = copy %right_input : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$85 = add.gpr32 %value_copy$84, %right_input
  low.schedule.phase
  %first_copy$86 = copy %first$85 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$87 = add.gpr32 %first_copy$86, %first$85
  low.schedule.end
  %64 = copy %second$91 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %64, %second$87
  %66 = copy %sum : reg<x86.gpr32> -> reg<x86.gpr32>
  %next = add.gpr32 %66, %pair
  %i_1 = lea.disp %i {disp32 = 1}
  low.op.cond_br<x86.scalar.cmp.branch.imm.gpr64>(%i_1) {imm32 = 5, predicate = 12}, ^_bb3, ^_bb4 : (reg<x86.gpr64>)
^_bb3:
  %69 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_input_1 = add.gpr32 %69, %next
  %71 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %right_input_1 = add.gpr32 %71, %next
  low.schedule.begin
  %value_copy$80 = copy %left_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$81 = add.gpr32 %value_copy$80, %left_input_1
  low.schedule.phase
  %first_copy$82 = copy %first$81 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$83 = add.gpr32 %first_copy$82, %first$81
  low.schedule.end
  low.schedule.begin
  %value_copy$2 = copy %right_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$3 = add.gpr32 %value_copy$2, %right_input_1
  low.schedule.phase
  %first_copy$4 = copy %first$3 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$5 = add.gpr32 %first_copy$4, %first$3
  low.schedule.end
  %75 = copy %second$83 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %75, %second$5
  %77 = copy %next : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %77, %pair_1
  low.br ^_bb5(%next_1: reg<x86.gpr32>)
^_bb4:
  low.br ^_bb5(%next: reg<x86.gpr32>)
^_bb5(%55: reg<x86.gpr32>):
  %79 = lea.disp %i {disp32 = 2}
  low.br ^_bb1(%79: reg<x86.gpr64>, %55: reg<x86.gpr32>)
^_bb6:
  return %sum
}
