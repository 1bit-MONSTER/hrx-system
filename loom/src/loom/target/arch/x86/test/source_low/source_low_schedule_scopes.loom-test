// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def inline schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// Loop-carried inputs keep each helper invocation distinct after unrolling;
// each inlined occurrence owns an independent scheduling scope.
func.def public target(@target) @unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll {
    %left_input = scalar.addi %lhs, %sum : i32
    %right_input = scalar.addi %rhs, %sum : i32
    %left = low.invoke @scoped_double(%left_input) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%right_input) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def public target<x86.scalar.core>(@target) abi(object_function) @unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  low.schedule.begin
  %value_copy$59 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$60 = add.gpr32 %value_copy$59, %lhs
  low.schedule.phase
  %first_copy$61 = copy %first$60 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$62 = add.gpr32 %first_copy$61, %first$60
  low.schedule.end
  low.schedule.begin
  %value_copy$55 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$56 = add.gpr32 %value_copy$55, %rhs
  low.schedule.phase
  %first_copy$57 = copy %first$56 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$58 = add.gpr32 %first_copy$57, %first$56
  low.schedule.end
  %39 = copy %second$62 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %39, %second$58
  %41 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_input_1 = add.gpr32 %41, %pair
  %43 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %right_input_1 = add.gpr32 %43, %pair
  low.schedule.begin
  %value_copy$51 = copy %left_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$52 = add.gpr32 %value_copy$51, %left_input_1
  low.schedule.phase
  %first_copy$53 = copy %first$52 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$54 = add.gpr32 %first_copy$53, %first$52
  low.schedule.end
  low.schedule.begin
  %value_copy$2 = copy %right_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$3 = add.gpr32 %value_copy$2, %right_input_1
  low.schedule.phase
  %first_copy$4 = copy %first$3 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$5 = add.gpr32 %first_copy$4, %first$3
  low.schedule.end
  %47 = copy %second$54 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %47, %second$5
  %49 = copy %pair : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %49, %pair_1
  return %next_1
}

// ====

// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def inline schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// Partial unrolling preserves independent scopes in the loop and its tail.
func.def public target(@target) @partial_unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 5 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll(%factor) {
    %left_input = scalar.addi %lhs, %sum : i32
    %right_input = scalar.addi %rhs, %sum : i32
    %left = low.invoke @scoped_double(%left_input) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%right_input) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def public target<x86.scalar.core>(@target) abi(object_function) @partial_unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %begin = mov.imm64 0
  %initial = mov.imm32 0
  low.br ^_bb1(%begin: reg<x86.gpr64>, %initial: reg<x86.gpr32>)
^_bb1(%i: reg<x86.gpr64>, %sum: reg<x86.gpr32>):
  %58 = cmp.slt.imm.gpr64 %i, 5
  low.cond_br %58, ^_bb2, ^_bb6 : reg<x86.gpr32>
^_bb2:
  %59 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_input = add.gpr32 %59, %sum
  %61 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %right_input = add.gpr32 %61, %sum
  low.schedule.begin
  %value_copy$90 = copy %left_input : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$91 = add.gpr32 %value_copy$90, %left_input
  low.schedule.phase
  %first_copy$92 = copy %first$91 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$93 = add.gpr32 %first_copy$92, %first$91
  low.schedule.end
  low.schedule.begin
  %value_copy$86 = copy %right_input : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$87 = add.gpr32 %value_copy$86, %right_input
  low.schedule.phase
  %first_copy$88 = copy %first$87 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$89 = add.gpr32 %first_copy$88, %first$87
  low.schedule.end
  %65 = copy %second$93 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %65, %second$89
  %67 = copy %sum : reg<x86.gpr32> -> reg<x86.gpr32>
  %next = add.gpr32 %67, %pair
  %i_1 = lea.disp %i {disp32 = 1}
  %70 = cmp.slt.imm.gpr64 %i_1, 5
  low.cond_br %70, ^_bb3, ^_bb4 : reg<x86.gpr32>
^_bb3:
  %71 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_input_1 = add.gpr32 %71, %next
  %73 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %right_input_1 = add.gpr32 %73, %next
  low.schedule.begin
  %value_copy$82 = copy %left_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$83 = add.gpr32 %value_copy$82, %left_input_1
  low.schedule.phase
  %first_copy$84 = copy %first$83 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$85 = add.gpr32 %first_copy$84, %first$83
  low.schedule.end
  low.schedule.begin
  %value_copy$2 = copy %right_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$3 = add.gpr32 %value_copy$2, %right_input_1
  low.schedule.phase
  %first_copy$4 = copy %first$3 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$5 = add.gpr32 %first_copy$4, %first$3
  low.schedule.end
  %77 = copy %second$85 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %77, %second$5
  %79 = copy %next : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %79, %pair_1
  low.br ^_bb5(%next_1: reg<x86.gpr32>)
^_bb4:
  low.br ^_bb5(%next: reg<x86.gpr32>)
^_bb5(%55: reg<x86.gpr32>):
  %81 = lea.disp %i {disp32 = 2}
  low.br ^_bb1(%81: reg<x86.gpr64>, %55: reg<x86.gpr32>)
^_bb6:
  return %sum
}
