// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def inline schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// Loop-carried inputs keep each helper invocation distinct after unrolling;
// each inlined occurrence owns an independent scheduling scope.
func.def public target(@target) @unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll {
    %left_input = scalar.addi %lhs, %sum : i32
    %right_input = scalar.addi %rhs, %sum : i32
    %left = low.invoke @scoped_double(%left_input) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%right_input) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def public target<x86.scalar.core>(@target) abi(object_function) @unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  low.schedule.begin
  %value_copy$59 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$60 = add.gpr32 %value_copy$59, %lhs
  low.schedule.phase
  %first_copy$61 = copy %first$60 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$62 = add.gpr32 %first_copy$61, %first$60
  low.schedule.end
  low.schedule.begin
  %value_copy$55 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$56 = add.gpr32 %value_copy$55, %rhs
  low.schedule.phase
  %first_copy$57 = copy %first$56 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$58 = add.gpr32 %first_copy$57, %first$56
  low.schedule.end
  %39 = copy %second$62 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %39, %second$58
  %41 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_input_1 = add.gpr32 %41, %pair
  %43 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %right_input_1 = add.gpr32 %43, %pair
  low.schedule.begin
  %value_copy$51 = copy %left_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$52 = add.gpr32 %value_copy$51, %left_input_1
  low.schedule.phase
  %first_copy$53 = copy %first$52 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$54 = add.gpr32 %first_copy$53, %first$52
  low.schedule.end
  low.schedule.begin
  %value_copy$2 = copy %right_input_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$3 = add.gpr32 %value_copy$2, %right_input_1
  low.schedule.phase
  %first_copy$4 = copy %first$3 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$5 = add.gpr32 %first_copy$4, %first$3
  low.schedule.end
  %47 = copy %second$54 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %47, %second$5
  %49 = copy %pair : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %49, %pair_1
  return %next_1
}

