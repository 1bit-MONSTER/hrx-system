// TEMPLATE: loom/src/loom/test/corpus/source_low/scalar_float_conversion.loom-test
// TEMPLATE-EXCLUDE: @floating_arguments Wasm functions do not use the GPU launch ABI.
// TEMPLATE-EXCLUDE: @widen_narrow_to_f64 Narrow-float widening is a separate conversion family.
// TEMPLATE-EXCLUDE: @widen_float8_chain Narrow-float widening is a separate conversion family.
// RUN: emit source-low target=wasm:simd128 output=low

func.def @convert_scalar_f64(%single: f32, %double: f64) -> (f64, f32) {
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  func.return %wide, %narrow : f64, f32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @convert_scalar_f64(%single: reg<wasm.f32>, %double: reg<wasm.f64>) -> (reg<wasm.f64>, reg<wasm.f32>) asm {
  %wide = f64.promote_f32 %single
  %narrow = f32.demote_f64 %double
  return %wide, %narrow
}
