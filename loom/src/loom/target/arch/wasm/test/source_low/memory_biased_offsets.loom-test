// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_biased_offsets.loom
// RUN: emit source-low target=wasm:simd128 output=low

func.def @exchange_biased_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %signed_position = index.assume %position [range(%position, -4, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @exchange_biased_word(%view: reg<wasm.i32>, %signed_position: reg<wasm.i32>, %replacement: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %14 = i32.const 16
  %15 = i32.const 4
  %16 = i32.mul %signed_position, %15
  %17 = i32.add %16, %14
  %18 = i32.add %view, %17
  %previous = i32.load %18
  i32.store %18, %replacement
  return %previous
}

// ====

func.def @exchange_nonnegative_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %bounded_position = index.assume %position [range(%position, 0, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %bounded_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @exchange_nonnegative_word(%view: reg<wasm.i32>, %bounded_position: reg<wasm.i32>, %replacement: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %14 = i32.const 4
  %15 = i32.mul %bounded_position, %14
  %16 = i32.add %view, %15
  %previous = i32.load %16 {offset = 16}
  i32.store %16, %replacement {offset = 16}
  return %previous
}

// ====

func.def @copy_biased_vector(%source: buffer, %destination: buffer, %position: index) {
  %signed_position = index.assume %position [range(%position, -4, 4)] : index
  %center = index.constant 4 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<12xi32>
  %destination_view = buffer.view %destination[%base] : buffer -> view<12xi32>
  %values = vector.load %source_view[%element] : view<12xi32> -> vector<4xi32>
  vector.store %values, %destination_view[%element] : vector<4xi32>, view<12xi32>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_biased_vector(%source_view: reg<wasm.i32>, %destination_view: reg<wasm.i32>, %signed_position: reg<wasm.i32>) asm {
  %13 = i32.const 16
  %14 = i32.const 4
  %15 = i32.mul %signed_position, %14
  %16 = i32.add %15, %13
  %17 = i32.add %source_view, %16
  %values = v128.load %17
  %23 = i32.add %destination_view, %16
  v128.store %23, %values
  return
}

// ====

// The static contribution fits U32 but has its sign bit set in an i32 carrier.
func.def @exchange_large_bias_word(%buffer: buffer, %position: index, %replacement: i32) -> (i32) {
  %signed_position = index.assume %position [range(%position, -1073741820, -1073741812)] : index
  %center = index.constant 1073741820 : index
  %element = index.add %signed_position, %center : index
  %base = index.constant 0 : offset
  %view = buffer.view %buffer[%base] : buffer -> view<9xi32>
  %previous = view.load %view[%element] : view<9xi32> -> i32
  view.store %replacement, %view[%element] : i32, view<9xi32>
  func.return %previous : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @exchange_large_bias_word(%view: reg<wasm.i32>, %signed_position: reg<wasm.i32>, %replacement: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %14 = i32.const 4294967280
  %15 = i32.const 4
  %16 = i32.mul %signed_position, %15
  %17 = i32.add %16, %14
  %18 = i32.add %view, %17
  %previous = i32.load %18
  i32.store %18, %replacement
  return %previous
}
