low.func.def target<wasm.core.simd128> abi(wasm_function) @materialized_i64_window(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>, %offset: reg<wasm.i32>) -> (reg<wasm.v128>) asm {
  %12 = i32.const 8
