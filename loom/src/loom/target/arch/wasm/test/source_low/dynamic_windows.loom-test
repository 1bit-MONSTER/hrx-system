  %19 = v128.const 1157442765409226768, 1157442765409226768
  %20 = i8x16.sub %18, %19
  %21 = v128.const 0, 0
  %22 = i32.const 0
  %23 = i32.const 16
  %24 = i32.ge_u %13, %23
  %25 = i32.sub %22, %24
  %26 = i8x16.splat %25
  %29 = v128.bitselect %rhs, %lhs, %26
  %30 = v128.bitselect %21, %rhs, %26
