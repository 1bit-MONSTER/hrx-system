// RUN: emit source-low target=wasm:simd128 output=low

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @observe_unused(%aligned: reg<wasm.i32>) asm {
  %first = i32.load<volatile> %aligned
  %second = i32.load<volatile> %aligned {offset = 4}
  return
}

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @observe_vector(%source_aligned: reg<wasm.i32>, %destination_aligned: reg<wasm.i32>) asm {
  %21 = v128.load<volatile> %source_aligned
  %22 = v128.load<volatile> %source_aligned {offset = 16}
  %23 = v128.load<volatile> %source_aligned {offset = 32}
  %24 = v128.load<volatile> %source_aligned {offset = 48}
  %25 = v128.load<volatile> %source_aligned
  %26 = v128.load<volatile> %source_aligned {offset = 16}
  %27 = v128.load<volatile> %source_aligned {offset = 32}
  %28 = v128.load<volatile> %source_aligned {offset = 48}
  v128.store<volatile> %destination_aligned, %21
  v128.store<volatile> %destination_aligned, %22 {offset = 16}
  v128.store<volatile> %destination_aligned, %23 {offset = 32}
  v128.store<volatile> %destination_aligned, %24 {offset = 48}
  v128.store<volatile> %destination_aligned, %25 {offset = 64}
  v128.store<volatile> %destination_aligned, %26 {offset = 80}
  v128.store<volatile> %destination_aligned, %27 {offset = 96}
  v128.store<volatile> %destination_aligned, %28 {offset = 112}
  return
}

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @observe_byte(%input: reg<wasm.i32>, %output: reg<wasm.i32>) asm {
  %first = i32.load8_u<volatile> %input
  %second = i32.load8_u<volatile> %input
  i32.store8<volatile> %output, %first
  i32.store8<volatile> %output, %second {offset = 1}
  return
}

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), multiple_of(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @observe_dynamic_address(%aligned: reg<wasm.i32>, %base: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %13 = i32.add %aligned, %base
  %first = i32.load<volatile> %13
  %second = i32.load<volatile> %13 {offset = 4}
  return %first, %second
}
