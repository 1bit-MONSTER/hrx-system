// RUN: with-checks pass target-legalize{mode=final,policy=prefer-native}

// Linked target providers may decline their opted-in rewrites of legal ops.
// Native acceptance still excludes ordinary reference fallbacks.
wasm.target<simd128> @target

func.def target(@target) @prefer_native_store(%output: buffer, %value: vector<4xi32>) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<4xi32>
  vector.store %value, %view[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
CHECK: *vector.store %value, %view[0] : vector<4xi32>, view<4xi32>
CHECK-NOT: *vector.extract*
CHECK-NOT: *view.store*

// ====
// RUN: with-checks pass target-legalize{mode=final,policy=require-native}

wasm.target<simd128> @target

func.def target(@target) @require_native_store(%output: buffer, %value: vector<4xi32>) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<4xi32>
  vector.store %value, %view[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
CHECK: *vector.store %value, %view[0] : vector<4xi32>, view<4xi32>
CHECK-NOT: *vector.extract*
CHECK-NOT: *view.store*

// ====
// RUN: with-checks pass target-legalize{mode=final,policy=reference-only}

wasm.target<simd128> @target

func.def target(@target) @reference_store(%output: buffer, %value: vector<4xi32>) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<4xi32>
  vector.store %value, %view[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
CHECK-NOT: *vector.store*
CHECK: *vector.extract %value[0] : vector<4xi32> -> i32
CHECK: *vector.extract %value[1] : vector<4xi32> -> i32
CHECK: *vector.extract %value[2] : vector<4xi32> -> i32
CHECK: *vector.extract %value[3] : vector<4xi32> -> i32
CHECK: *view.store *%view[0] : i32, view<4xi32>
CHECK: *view.store *%view[1] : i32, view<4xi32>
CHECK: *view.store *%view[2] : i32, view<4xi32>
CHECK: *view.store *%view[3] : i32, view<4xi32>

// ====
// RUN: pass target=wasm:simd128 target-legalize{mode=complete,policy=reference-only}

wasm.target<simd128> @target

// A consumer cannot use reference fallback to expand a producer whose target
// contract owns a terminal structured rejection.
func.def target(@target) @preserve_terminal_window_rejection(%packet: vector<16xi8>, %offset0: index, %output: buffer) {
  %offset = index.assume %offset0 [range(%offset0, 0, 80)] : index
  %source = vector.concat<0> %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet : vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8> -> vector<208xi8>
  %window = vector.slice %source[%offset] : vector<208xi8> -> vector<128xi8>
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<128xi8>
  vector.store %window, %results[0] : vector<128xi8>, view<128xi8>
  func.return
}

// ----
wasm.target<simd128> @target

func.def target(@target) @preserve_terminal_window_rejection(%packet: vector<16xi8>, %offset0: index, %output: buffer) {
  %offset = index.assume %offset0 [range(%offset0, 0, 80)] : index
  %source = vector.concat<0> %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet : vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8> -> vector<208xi8>
  %window = vector.slice %source[%offset] : vector<208xi8> -> vector<128xi8>
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<128xi8>
  vector.store %window, %results[0] : vector<128xi8>, view<128xi8>
  func.return
}
