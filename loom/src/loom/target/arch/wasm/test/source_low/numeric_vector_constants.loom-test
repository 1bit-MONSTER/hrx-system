// RUN: emit source-low target=wasm:simd128 output=low

// Runtime and literal i32 splats use the scalar-to-vector instruction path.
func.def @i32_splat_forms(%dynamic: i32) -> (vector<4xi32>) {
  %literal = vector.constant -19088743 : vector<4xi32>
  %splat = vector.splat %dynamic : vector<4xi32>
  %result = vector.addi %literal, %splat : vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @i32_splat_forms(%dynamic: reg<wasm.i32>) -> (reg<wasm.v128>) asm {
  %7 = i32.const -19088743
  %literal = i32x4.splat %7
  %splat = i32x4.splat %dynamic
  %result = i32x4.add %literal, %splat
  return %result
}

// ====

// Full-width i64 literals use the native vector constant form.
func.def @i64_vector_constant() -> (vector<2xi64>) {
  %result = vector.constant -9223372036854775807 : vector<2xi64>
  func.return %result : vector<2xi64>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @i64_vector_constant() -> (reg<wasm.v128>) asm {
  %result = v128.const -9223372036854775807, -9223372036854775807
  return %result
}

// ====

// Runtime and literal f32 splats use the scalar-to-vector instruction path.
func.def @f32_splat_forms(%dynamic: f32) -> (vector<4xf32>) {
  %literal = vector.constant -1.1000000000000001 : vector<4xf32>
  %splat = vector.splat %dynamic : vector<4xf32>
  %result = vector.addf %literal, %splat : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @f32_splat_forms(%dynamic: reg<wasm.f32>) -> (reg<wasm.v128>) asm {
  %7 = f32.const 3213675725
  %literal = f32x4.splat %7
  %splat = f32x4.splat %dynamic
  %result = f32x4.add %literal, %splat
  return %result
}

// ====

// Full-width f64 literals use the native vector constant form.
func.def @f64_vector_constant() -> (vector<2xf64>) {
  %result = vector.constant -0.0 : vector<2xf64>
  func.return %result : vector<2xf64>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @f64_vector_constant() -> (reg<wasm.v128>) asm {
  %result = v128.const -9223372036854775808, -9223372036854775808
  return %result
}

// ====

// Predicate constants remain full-lane masks through vector selection.
func.def @predicate_constant_masks(%condition: i1, %true_value: vector<4xi32>, %false_value: vector<4xi32>) -> (vector<4xi32>) {
  %off = vector.constant false : vector<4xi1>
  %scalar = scalar.constant true : i1
  %on = vector.splat %scalar : vector<4xi1>
  %mask = scf.select %condition, %on, %off : vector<4xi1>
  %result = vector.select %mask, %true_value, %false_value : vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @predicate_constant_masks(%condition: reg<wasm.i32>, %true_value: reg<wasm.v128>, %false_value: reg<wasm.v128>) -> (reg<wasm.v128>) asm {
  %off = v128.const 0, 0
  %on = v128.const -1, -1
  %mask = v128.select %on, %off, %condition
  %result = v128.bitselect %true_value, %false_value, %mask
  return %result
}
