// RUN: emit source-low target=wasm:simd128 output=low

// Two addresses retain their common scalar origin through the generic source
// memory materializer. The second load uses a static instruction offset after
// the shared origin and first coordinate have been materialized once.
func.def @shared_scalar_component(%input: buffer, %row: index, %lane: index) {
  %bounded_row = index.assume %row [range(%row, 0, 7)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 63)] : index
  %row_stride = index.constant 128 : index
  %row_origin = index.mul %bounded_row, %row_stride : index
  %first_index = index.add %row_origin, %bounded_lane : index
  %distance = index.constant 64 : index
  %later_lane = index.add %bounded_lane, %distance : index
  %second_index = index.add %row_origin, %later_lane : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<1024xi32>
  %first = view.load<volatile> %data[%first_index] : view<1024xi32> -> i32
  %second = view.load<volatile> %data[%second_index] : view<1024xi32> -> i32
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @shared_scalar_component(%input: reg<wasm.i32>, %bounded_row: reg<wasm.i32>, %bounded_lane: reg<wasm.i32>) asm {
  %20 = i32.const 7
  %row_origin = i32.shl %bounded_row, %20
  %22 = i32.const 4
  %23 = i32.mul %row_origin, %22
  %25 = i32.mul %bounded_lane, %22
  %26 = i32.add %23, %25
  %27 = i32.add %input, %26
  %first = i32.load<volatile> %27
  %second = i32.load<volatile> %27 {offset = 256}
  return
}
