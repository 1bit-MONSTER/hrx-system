func.def @widen_narrow_float_packets(%e4_buffer: buffer, %e5_buffer: buffer, %f16_buffer: buffer, %bf16_buffer: buffer) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %base = index.constant 0 : offset
  %e4_view = buffer.view %e4_buffer[%base] : buffer -> view<4xf8E4M3>
  %e5_view = buffer.view %e5_buffer[%base] : buffer -> view<4xf8E5M2>
  %f16_view = buffer.view %f16_buffer[%base] : buffer -> view<4xf16>
  %bf16_view = buffer.view %bf16_buffer[%base] : buffer -> view<4xbf16>
  %e4 = vector.load %e4_view[0] : view<4xf8E4M3> -> vector<4xf8E4M3>
  %e5 = vector.load %e5_view[0] : view<4xf8E5M2> -> vector<4xf8E5M2>
  %f16 = vector.load %f16_view[0] : view<4xf16> -> vector<4xf16>
  %bf16 = vector.load %bf16_view[0] : view<4xbf16> -> vector<4xbf16>
  %e4_wide = vector.extf %e4 : vector<4xf8E4M3> to vector<4xf32>
  %e5_wide = vector.extf %e5 : vector<4xf8E5M2> to vector<4xf32>
  %f16_wide = vector.extf %f16 : vector<4xf16> to vector<4xf32>
  %bf16_wide = vector.extf %bf16 : vector<4xbf16> to vector<4xf32>
  func.return %e4_wide, %e5_wide, %f16_wide, %bf16_wide : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
}

