func.def @packetized_float8_widening(%input_buffer: buffer) -> (vector<4xf32>, vector<4xf32>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<8xf8E4M3>
  %input = vector.load %input_view[0] : view<8xf8E4M3> -> vector<8xf8E4M3>
  %extended = vector.extf %input : vector<8xf8E4M3> to vector<8xf32>
  %extended0 = vector.slice %extended[0] : vector<8xf32> -> vector<4xf32>
  %extended1 = vector.slice %extended[4] : vector<8xf32> -> vector<4xf32>
  func.return %extended0, %extended1 : vector<4xf32>, vector<4xf32>
}

