// RUN: pass target=wasm:simd128 target-legalize{mode=final}

func.def @scalar_f32_reference_extrema(%value: f32, %lhs: f32, %rhs: f32) -> (f32, f32, f32, f32, f32) {
  %minnum = scalar.minnumf %lhs, %rhs : f32
  %maxnum = scalar.maxnumf %lhs, %rhs : f32
  %ordered = scalar.clampf<ordered> %value, %lhs, %rhs : f32
  %number = scalar.clampf<number> %value, %lhs, %rhs : f32
  %ieee = scalar.clampf<ieee> %value, %lhs, %rhs : f32
  func.return %minnum, %maxnum, %ordered, %number, %ieee : f32, f32, f32, f32, f32
}

// ----
func.def @scalar_f32_reference_extrema(%value: f32, %lhs: f32, %rhs: f32) -> (f32, f32, f32, f32, f32) {
  %55 = scalar.bitcast %lhs : f32 to i32
  %56 = scalar.bitcast %rhs : f32 to i32
  %57 = scalar.ori %55, %56 : i32
  %58 = scalar.bitcast %57 : i32 to f32
  %59 = scalar.cmpf olt, %lhs, %rhs : f32
  %60 = scalar.cmpf olt, %rhs, %lhs : f32
  %61 = scf.select %60, %rhs, %58 : f32
  %62 = scf.select %59, %lhs, %61 : f32
  %63 = scalar.cmpf une, %lhs, %lhs : f32
  %64 = scalar.cmpf une, %rhs, %rhs : f32
  %65 = scf.select %64, %lhs, %62 : f32
  %minnum = scf.select %63, %rhs, %65 : f32
  %43 = scalar.bitcast %lhs : f32 to i32
  %44 = scalar.bitcast %rhs : f32 to i32
  %45 = scalar.andi %43, %44 : i32
  %46 = scalar.bitcast %45 : i32 to f32
  %47 = scalar.cmpf ogt, %lhs, %rhs : f32
  %48 = scalar.cmpf ogt, %rhs, %lhs : f32
  %49 = scf.select %48, %rhs, %46 : f32
  %50 = scf.select %47, %lhs, %49 : f32
  %51 = scalar.cmpf une, %lhs, %lhs : f32
  %52 = scalar.cmpf une, %rhs, %rhs : f32
  %53 = scf.select %52, %lhs, %50 : f32
  %maxnum = scf.select %51, %rhs, %53 : f32
  %39 = scalar.cmpf olt, %value, %lhs : f32
  %40 = scf.select %39, %lhs, %value : f32
  %41 = scalar.cmpf ogt, %40, %rhs : f32
  %ordered = scf.select %41, %rhs, %40 : f32
  %15 = scalar.bitcast %value : f32 to i32
  %16 = scalar.bitcast %lhs : f32 to i32
  %17 = scalar.andi %15, %16 : i32
  %18 = scalar.bitcast %17 : i32 to f32
  %19 = scalar.cmpf ogt, %value, %lhs : f32
  %20 = scalar.cmpf ogt, %lhs, %value : f32
  %21 = scf.select %20, %lhs, %18 : f32
  %22 = scf.select %19, %value, %21 : f32
  %23 = scalar.cmpf une, %value, %value : f32
  %24 = scalar.cmpf une, %lhs, %lhs : f32
  %25 = scf.select %24, %value, %22 : f32
  %26 = scf.select %23, %lhs, %25 : f32
  %27 = scalar.bitcast %26 : f32 to i32
  %28 = scalar.bitcast %rhs : f32 to i32
  %29 = scalar.ori %27, %28 : i32
  %30 = scalar.bitcast %29 : i32 to f32
  %31 = scalar.cmpf olt, %26, %rhs : f32
  %32 = scalar.cmpf olt, %rhs, %26 : f32
  %33 = scf.select %32, %rhs, %30 : f32
  %34 = scf.select %31, %26, %33 : f32
  %35 = scalar.cmpf une, %26, %26 : f32
  %36 = scalar.cmpf une, %rhs, %rhs : f32
  %37 = scf.select %36, %26, %34 : f32
  %number = scf.select %35, %rhs, %37 : f32
  %13 = scalar.maximumf %value, %lhs : f32
  %ieee = scalar.minimumf %13, %rhs : f32
  func.return %minnum, %maxnum, %ordered, %number, %ieee : f32, f32, f32, f32, f32
}

