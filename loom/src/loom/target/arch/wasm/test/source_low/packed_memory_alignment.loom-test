// ====

// A halfword origin preserves two-byte alignment within a wider payload.
kernel.def @halfword_origin() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %start = index.constant 2 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%start] : buffer -> view<16xi16>
  %value = vector.load %source_view[0] : view<16xi16> -> vector<16xi16>
  %destination_view = buffer.view %destination[%c0] : buffer -> view<16xi16>
  vector.store %value, %destination_view[0] : vector<16xi16>, view<16xi16>
  kernel.return
}

// ----
low.kernel.def target<wasm.core.simd128> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @halfword_origin(%source_view: reg<wasm.i32>, %destination_view: reg<wasm.i32>) asm {
  %62 = i32.load16_u %source_view {offset = 2}
  %63 = i32.load16_u %source_view {offset = 4}
  %64 = i32.load16_u %source_view {offset = 6}
  %65 = i32.load16_u %source_view {offset = 8}
  %66 = i32.load16_u %source_view {offset = 10}
  %67 = i32.load16_u %source_view {offset = 12}
  %68 = i32.load16_u %source_view {offset = 14}
  %69 = i32.load16_u %source_view {offset = 16}
  %70 = i32.load16_u %source_view {offset = 18}
  %71 = i32.load16_u %source_view {offset = 20}
  %72 = i32.load16_u %source_view {offset = 22}
  %73 = i32.load16_u %source_view {offset = 24}
  %74 = i32.load16_u %source_view {offset = 26}
  %75 = i32.load16_u %source_view {offset = 28}
  %76 = i32.load16_u %source_view {offset = 30}
  %77 = i32.load16_u %source_view {offset = 32}
  i32.store16 %destination_view, %62
  i32.store16 %destination_view, %63 {offset = 2}
  i32.store16 %destination_view, %64 {offset = 4}
  i32.store16 %destination_view, %65 {offset = 6}
  i32.store16 %destination_view, %66 {offset = 8}
  i32.store16 %destination_view, %67 {offset = 10}
  i32.store16 %destination_view, %68 {offset = 12}
  i32.store16 %destination_view, %69 {offset = 14}
  i32.store16 %destination_view, %70 {offset = 16}
  i32.store16 %destination_view, %71 {offset = 18}
  i32.store16 %destination_view, %72 {offset = 20}
  i32.store16 %destination_view, %73 {offset = 22}
  i32.store16 %destination_view, %74 {offset = 24}
  i32.store16 %destination_view, %75 {offset = 26}
  i32.store16 %destination_view, %76 {offset = 28}
  i32.store16 %destination_view, %77 {offset = 30}
  return
}

