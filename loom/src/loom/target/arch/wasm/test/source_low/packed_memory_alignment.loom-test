  i32.store8 %destination_view, %119 {offset = 9}
  i32.store8 %destination_view, %120 {offset = 10}
  i32.store8 %destination_view, %121 {offset = 11}
  i32.store8 %destination_view, %122 {offset = 12}
  i32.store8 %destination_view, %123 {offset = 13}
  i32.store8 %destination_view, %124 {offset = 14}
  i32.store8 %destination_view, %125 {offset = 15}
  i32.store8 %destination_view, %126 {offset = 16}
  i32.store8 %destination_view, %127 {offset = 17}
  i32.store8 %destination_view, %128 {offset = 18}
  i32.store8 %destination_view, %129 {offset = 19}
  i32.store8 %destination_view, %130 {offset = 20}
  i32.store8 %destination_view, %131 {offset = 21}
  i32.store8 %destination_view, %132 {offset = 22}
  i32.store8 %destination_view, %133 {offset = 23}
  i32.store8 %destination_view, %134 {offset = 24}
  i32.store8 %destination_view, %135 {offset = 25}
  i32.store8 %destination_view, %136 {offset = 26}
  i32.store8 %destination_view, %137 {offset = 27}
