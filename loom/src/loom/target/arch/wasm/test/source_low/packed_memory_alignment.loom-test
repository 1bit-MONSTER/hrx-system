  %122 = i32.load8_u %source_view {offset = 13}
  %123 = i32.load8_u %source_view {offset = 14}
  %124 = i32.load8_u %source_view {offset = 15}
  %125 = i32.load8_u %source_view {offset = 16}
  %126 = i32.load8_u %source_view {offset = 17}
  %127 = i32.load8_u %source_view {offset = 18}
  %128 = i32.load8_u %source_view {offset = 19}
  %129 = i32.load8_u %source_view {offset = 20}
  %130 = i32.load8_u %source_view {offset = 21}
  %131 = i32.load8_u %source_view {offset = 22}
  %132 = i32.load8_u %source_view {offset = 23}
  %133 = i32.load8_u %source_view {offset = 24}
  %134 = i32.load8_u %source_view {offset = 25}
  %135 = i32.load8_u %source_view {offset = 26}
  %136 = i32.load8_u %source_view {offset = 27}
  %137 = i32.load8_u %source_view {offset = 28}
  %138 = i32.load8_u %source_view {offset = 29}
  %139 = i32.load8_u %source_view {offset = 30}
  %140 = i32.load8_u %source_view {offset = 31}
  %141 = i32.load8_u %source_view {offset = 32}
  i32.store8 %destination_view, %110
  i32.store8 %destination_view, %111 {offset = 1}
  i32.store8 %destination_view, %112 {offset = 2}
  i32.store8 %destination_view, %113 {offset = 3}
  i32.store8 %destination_view, %114 {offset = 4}
  i32.store8 %destination_view, %115 {offset = 5}
