// TEMPLATE: loom/src/loom/test/corpus/source_low/layout_predicate_extract.loom-test
// TEMPLATE-EXCLUDE: @dynamic_predicate_element Wasm SIMD extraction requires a static element index.
// TEMPLATE-EXCLUDE: @predicate_tail_slice Wasm SIMD predicate storage has four 32-bit lanes.
// TEMPLATE-EXCLUDE: @multidimensional_predicate_element Wasm SIMD predicate storage has four 32-bit lanes.
// TEMPLATE-EXCLUDE: @single_predicate Wasm SIMD predicate storage has four 32-bit lanes.
// TEMPLATE-EXCLUDE: @merged_predicate Wasm requires structured control flow.
// RUN: emit source-low target=wasm:simd128 output=low control-flow=structured-low

func.def @predicate_lanes(%input: vector<4xi1>) -> (i1, i1) {
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  func.return %first, %last : i1, i1
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @predicate_lanes(%input: reg<wasm.v128>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %8 = i32x4.extract_lane %input, 0
  %9 = i32.const 1
  %first = i32.and %8, %9
  %11 = i32x4.extract_lane %input, 3
  %last = i32.and %11, %9
  return %first, %last
}

// ====

// Both consumers use the original comparison results.
func.def @comparison_lane(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi1>, i1) {
  %mask = vector.cmpi slt, %lhs, %rhs : vector<4xi32> -> vector<4xi1>
  %last = vector.extract %mask[3] : vector<4xi1> -> i1
  func.return %mask, %last : vector<4xi1>, i1
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @comparison_lane(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>) -> (reg<wasm.v128>, reg<wasm.i32>) asm {
  %mask = i32x4.lt_s %lhs, %rhs
  %11 = i32x4.extract_lane %mask, 3
  %12 = i32.const 1
  %last = i32.and %11, %12
  return %mask, %last
}

// ====

func.def @select_lane(%input: vector<4xi1>, %lhs: i32, %rhs: i32) -> (i32) {
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  %selected = scf.select %last, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @select_lane(%input: reg<wasm.v128>, %lhs: reg<wasm.i32>, %rhs: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %10 = i32x4.extract_lane %input, 3
  %11 = i32.const 1
  %last = i32.and %10, %11
  %selected = i32.select %lhs, %rhs, %last
  return %selected
}

// ====

func.def @extracted_predicate_integer(%mask: vector<4xi1>) -> (i32, i32) {
  %condition = vector.extract %mask[1] : vector<4xi1> -> i1
  %unsigned = scalar.extui %condition : i1 to i32
  %signed = scalar.extsi %condition : i1 to i32
  func.return %unsigned, %signed : i32, i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @extracted_predicate_integer(%mask: reg<wasm.v128>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %12 = i32x4.extract_lane %mask, 1
  %13 = i32.const 1
  %unsigned = i32.and %12, %13
  %15 = i32.const -1
  %16 = i32.const 0
  %signed = i32.select %15, %16, %unsigned
  return %unsigned, %signed
}
