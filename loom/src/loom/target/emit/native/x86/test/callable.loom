// The platform ABI comes from the compile target. No target-specific source
// annotation, register name, or runtime calling convention is required.
func.def public @mix(%input: i64, %delta: i64) -> (i64) {
  %sum = scalar.addi %input, %delta : i64
  %result = scalar.xori %sum, %input : i64
  func.return %result : i64
}

// Both exits return through the same native preservation envelope.
func.def public @choose_mix(%input: i64, %delta: i64, %limit: i64) -> (i64) {
  %condition = scalar.cmpi ult, %input, %limit : i64
  cfg.cond_br %condition, ^less, ^greater
^less:
  %sum = scalar.addi %input, %delta : i64
  %result = scalar.xori %sum, %input : i64
  func.return %result : i64
^greater:
  %product = scalar.muli %input, %delta : i64
  %other = scalar.xori %product, %limit : i64
  func.return %other : i64
}

// Live inputs cross destructive arithmetic; the shared allocator decides
// transport and register use before native frame preservation is prepared.
func.def public @preserve(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64) -> (i64) {
  %x = scalar.addi %a, %b : i64
  %y = scalar.addi %c, %d : i64
  %z = scalar.addi %e, %f : i64
  %v = scalar.muli %x, %y : i64
  %w = scalar.muli %z, %a : i64
  %k = scalar.xori %b, %c : i64
  %sum = scalar.addi %v, %w : i64
  %result = scalar.xori %sum, %k : i64
  func.return %result : i64
}

// The input enters in RCX and stays live while another argument supplies CL.
// Entry transport must preserve it before the shift count overwrites RCX.
func.def public @shift_mix(%unused_first: i64, %count: i64, %unused_third: i64, %input: i64) -> (i64) {
  %mask = scalar.constant 63 : i64
  %bounded_count = scalar.andi %count, %mask : i64
  %shifted = scalar.shrui %input, %bounded_count : i64
  %result = scalar.xori %shifted, %input : i64
  func.return %result : i64
}

// An unused argument still consumes its ABI position. The next two arguments
// are a borrowed host pointer and an element index into its six-word extent.
// The C caller guarantees the index is in [0, 6).
func.def public @load_word(%unused: i64, %input: buffer, %index: index) -> (i64) {
  %base = index.constant 0 : offset
  %bounded_index = index.assume %index [range(%index, 0, 5)] : index
  %input_view = buffer.view %input[%base] : buffer -> view<6xi64>
  %value = view.load %input_view[%bounded_index] : view<6xi64> -> i64
  func.return %value : i64
}

// Widening must define the upper half of the destination register even when
// the two physical register views share a location.
func.def public @add_word(%word: i32, %bias: i64) -> (i64) {
  %wide = scalar.extui %word : i32 to i64
  %result = scalar.addi %wide, %bias : i64
  func.return %result : i64
}

// Quotient and remainder use the implicit RAX/RDX register pair. The original
// word arrives in EDX and must survive both high multiplies.
func.def public @divide_mix(%unused_first: i64, %unused_second: i64, %word: i32) -> (i32) {
  %divisor = scalar.constant 7 : i32
  %quotient = scalar.divui %word, %divisor : i32
  %remainder = scalar.remui %word, %divisor : i32
  %sum = scalar.addi %quotient, %remainder : i32
  %result = scalar.xori %sum, %word : i32
  func.return %result : i32
}

// Authored Low uses the same entry boundary. The third input must survive the
// implicit RDX write without an author-provided copy shortening its lifetime.
low.func.def public target<x86.scalar.core> abi(object_function) @high_mix(%unused: reg<x86.gpr64>, %factor: reg<x86.gpr64>, %word: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %accumulator = copy %word : reg<x86.gpr64> -> reg<x86.rax>
  %high = mul.high.gpr64 %accumulator, %factor
  %high_word = copy %high : reg<x86.rdx> -> reg<x86.gpr64>
  %result = xor.gpr64 %word, %high_word
  return %result
}

// Indexed byte and halfword stores truncate independently and leave neighboring
// elements intact. The return packs both previous values after zero extension.
// The C caller guarantees the index is in [0, 6).
func.def public @replace_narrow(%bytes: buffer, %words: buffer, %index: index, %replacement: i32) -> (i32) {
  %base = index.constant 0 : offset
  %position = index.assume %index [range(%index, 0, 5)] : index
  %byte_view = buffer.view %bytes[%base] : buffer -> view<6xi8>
  %word_view = buffer.view %words[%base] : buffer -> view<6xi16>
  %byte = view.load %byte_view[%position] : view<6xi8> -> i8
  %word = view.load %word_view[%position] : view<6xi16> -> i16
  %replacement_byte = scalar.trunci %replacement : i32 to i8
  %replacement_word = scalar.trunci %replacement : i32 to i16
  view.store %replacement_byte, %byte_view[%position] : i8, view<6xi8>
  view.store %replacement_word, %word_view[%position] : i16, view<6xi16>
  %wide_byte = scalar.extui %byte : i8 to i32
  %wide_word = scalar.extui %word : i16 to i32
  %shift = scalar.constant 8 : i32
  %shifted_word = scalar.shli %wide_word, %shift : i32
  %result = scalar.ori %wide_byte, %shifted_word : i32
  func.return %result : i32
}

// Loop-carried values cross both the forward exit and the backward edge.
// Their simultaneous transport belongs to the shared allocator's move plan.
func.def public @recurrence(%first: i64, %second: i64, %iterations: i64) -> (i64) {
  %begin = scalar.constant 0 : i64
  %step = scalar.constant 1 : i64
  cfg.br ^header(%first: i64, %second: i64, %begin: i64)
^header(%a: i64, %b: i64, %position: i64):
  %more = scalar.cmpi ult, %position, %iterations : i64
  cfg.cond_br %more, ^body, ^exit
^body:
  %sum = scalar.addi %a, %b : i64
  %next = scalar.addi %position, %step : i64
  cfg.br ^header(%b: i64, %sum: i64, %next: i64)
^exit:
  func.return %a : i64
}

// All loads precede their reductions so the shared allocator must spill real
// live values. The two widths share physical GPRs but transfer different bytes.
low.func.def public target<x86.scalar.core> abi(object_function) @pressure64(%input: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %word0 = mov.load.gpr64 %input {disp32 = 0}
  %word1 = mov.load.gpr64 %input {disp32 = 8}
  %word2 = mov.load.gpr64 %input {disp32 = 16}
  %word3 = mov.load.gpr64 %input {disp32 = 24}
  %word4 = mov.load.gpr64 %input {disp32 = 32}
  %word5 = mov.load.gpr64 %input {disp32 = 40}
  %word6 = mov.load.gpr64 %input {disp32 = 48}
  %word7 = mov.load.gpr64 %input {disp32 = 56}
  %word8 = mov.load.gpr64 %input {disp32 = 64}
  %word9 = mov.load.gpr64 %input {disp32 = 72}
  %word10 = mov.load.gpr64 %input {disp32 = 80}
  %word11 = mov.load.gpr64 %input {disp32 = 88}
  %word12 = mov.load.gpr64 %input {disp32 = 96}
  %word13 = mov.load.gpr64 %input {disp32 = 104}
  %word14 = mov.load.gpr64 %input {disp32 = 112}
  %word15 = mov.load.gpr64 %input {disp32 = 120}
  %word16 = mov.load.gpr64 %input {disp32 = 128}
  %word17 = mov.load.gpr64 %input {disp32 = 136}
  %word18 = mov.load.gpr64 %input {disp32 = 144}
  %word19 = mov.load.gpr64 %input {disp32 = 152}
  %sum1 = add.gpr64 %word0, %word1
  %sum2 = add.gpr64 %sum1, %word2
  %sum3 = add.gpr64 %sum2, %word3
  %sum4 = add.gpr64 %sum3, %word4
  %sum5 = add.gpr64 %sum4, %word5
  %sum6 = add.gpr64 %sum5, %word6
  %sum7 = add.gpr64 %sum6, %word7
  %sum8 = add.gpr64 %sum7, %word8
  %sum9 = add.gpr64 %sum8, %word9
  %sum10 = add.gpr64 %sum9, %word10
  %sum11 = add.gpr64 %sum10, %word11
  %sum12 = add.gpr64 %sum11, %word12
  %sum13 = add.gpr64 %sum12, %word13
  %sum14 = add.gpr64 %sum13, %word14
  %sum15 = add.gpr64 %sum14, %word15
  %sum16 = add.gpr64 %sum15, %word16
  %sum17 = add.gpr64 %sum16, %word17
  %sum18 = add.gpr64 %sum17, %word18
  %sum19 = add.gpr64 %sum18, %word19
  return %sum19
}

low.func.def public target<x86.scalar.core> abi(object_function) @pressure32(%input: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %word0 = mov.load.gpr32 %input {disp32 = 0}
  %word1 = mov.load.gpr32 %input {disp32 = 4}
  %word2 = mov.load.gpr32 %input {disp32 = 8}
  %word3 = mov.load.gpr32 %input {disp32 = 12}
  %word4 = mov.load.gpr32 %input {disp32 = 16}
  %word5 = mov.load.gpr32 %input {disp32 = 20}
  %word6 = mov.load.gpr32 %input {disp32 = 24}
  %word7 = mov.load.gpr32 %input {disp32 = 28}
  %word8 = mov.load.gpr32 %input {disp32 = 32}
  %word9 = mov.load.gpr32 %input {disp32 = 36}
  %word10 = mov.load.gpr32 %input {disp32 = 40}
  %word11 = mov.load.gpr32 %input {disp32 = 44}
  %word12 = mov.load.gpr32 %input {disp32 = 48}
  %word13 = mov.load.gpr32 %input {disp32 = 52}
  %word14 = mov.load.gpr32 %input {disp32 = 56}
  %word15 = mov.load.gpr32 %input {disp32 = 60}
  %word16 = mov.load.gpr32 %input {disp32 = 64}
  %word17 = mov.load.gpr32 %input {disp32 = 68}
  %word18 = mov.load.gpr32 %input {disp32 = 72}
  %word19 = mov.load.gpr32 %input {disp32 = 76}
  %sum1 = add.gpr32 %word0, %word1
  %sum2 = add.gpr32 %sum1, %word2
  %sum3 = add.gpr32 %sum2, %word3
  %sum4 = add.gpr32 %sum3, %word4
  %sum5 = add.gpr32 %sum4, %word5
  %sum6 = add.gpr32 %sum5, %word6
  %sum7 = add.gpr32 %sum6, %word7
  %sum8 = add.gpr32 %sum7, %word8
  %sum9 = add.gpr32 %sum8, %word9
  %sum10 = add.gpr32 %sum9, %word10
  %sum11 = add.gpr32 %sum10, %word11
  %sum12 = add.gpr32 %sum11, %word12
  %sum13 = add.gpr32 %sum12, %word13
  %sum14 = add.gpr32 %sum13, %word14
  %sum15 = add.gpr32 %sum14, %word15
  %sum16 = add.gpr32 %sum15, %word16
  %sum17 = add.gpr32 %sum16, %word17
  %sum18 = add.gpr32 %sum17, %word18
  %sum19 = add.gpr32 %sum18, %word19
  return %sum19
}

// Distinct generic spaces must remain disjoint after projection onto the stack.
// Nested views, a fixed-register alias, and an aligned storage address all feed
// the result so a misplaced or truncated transfer changes the observed value.
low.func.def public target<x86.scalar.core> abi(object_function) @storage_spaces(%input: reg<x86.gpr64>, %word: reg<x86.gpr32>) -> (reg<x86.gpr64>) asm {
  %stack = storage {byte_alignment = 64, byte_length = 32} : low.storage<stack>
  %scratch = storage {byte_alignment = 8, byte_length = 8} : low.storage<scratch>
  %private = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
  %tail = storage_view %stack {byte_length = 24, offset = 8} : low.storage<stack> -> low.storage<stack>
  %nested = storage_view %tail {byte_length = 16, offset = 8} : low.storage<stack> -> low.storage<stack>
  low.spill %input, %nested {offset = 8} : reg<x86.gpr64>, low.storage<stack>
  %bias = mov.imm64 258
  %scratch_value = add.gpr64 %input, %bias
  low.spill %scratch_value, %scratch : reg<x86.gpr64>, low.storage<scratch>
  low.spill %word, %private {offset = 4} : reg<x86.gpr32>, low.storage<private>
  %loaded = low.reload %nested {offset = 8} : low.storage<stack> -> reg<x86.rdx>
  %value = copy %loaded : reg<x86.rdx> -> reg<x86.gpr64>
  %other = low.reload %scratch : low.storage<scratch> -> reg<x86.gpr64>
  %narrow = low.reload %private {offset = 4} : low.storage<private> -> reg<x86.gpr32>
  %wide = movzx.gpr64.gpr32 %narrow
  %address = storage_address %stack : low.storage<stack> -> reg<x86.gpr64>
  %mask = mov.imm64 63
  %misalignment = and.gpr64 %address, %mask
  %difference = xor.gpr64 %value, %other
  %mixed = xor.gpr64 %difference, %wide
  %result = xor.gpr64 %mixed, %misalignment
  return %result
}

// Runtime indexing keeps this source-level local array addressable. Its native
// frame must honor an alignment stronger than the SysV stack-entry guarantee.
func.def public @local_pair(%first: i64, %second: i64, %index: index) -> (i64) {
  %length = index.constant 16 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(64) %length : buffer
  %values = buffer.view %storage[%base] : buffer -> view<2xi64>
  view.store %first, %values[0] : i64, view<2xi64>
  view.store %second, %values[1] : i64, view<2xi64>
  %position = index.assume %index [range(%index, 0, 1)] : index
  %result = view.load %values[%position] : view<2xi64> -> i64
  func.return %result : i64
}

// The previous allocation dies before recreation. Volatile accesses keep the
// addressable loop storage observable through the ordinary native function ABI.
func.def public @sum_previous_instances(%limit: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %initial_storage = buffer.alloca<private> align(4) %bytes : buffer
  %initial_view = buffer.view %initial_storage[%origin] : buffer -> view<1xi32>
  view.store<volatile> %seed, %initial_view[0] : i32, view<1xi32>
  %sum, %value, %last = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32, %previous_value = %seed : i32, %previous = %initial_view : view<1xi32>) -> (i32, i32, view<1xi32>) {
    %old_value = view.load<volatile> %previous[0] : view<1xi32> -> i32
    %storage = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %next_value = scalar.addi %previous_value, %increment : i32
    view.store<volatile> %next_value, %slot[0] : i32, view<1xi32>
    %next_sum = scalar.addi %accumulator, %old_value : i32
    scf.yield %next_sum, %next_value, %slot : i32, i32, view<1xi32>
  }
  func.return %sum : i32
}

func.def noinline @draw_arguments(%local: buffer, %a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %last: i64) -> (i64) {
  %c0 = index.constant 0 : offset
  %values = buffer.view %local[%c0] : buffer -> view<2xi64>
  %stored = view.load %values[1] : view<2xi64> -> i64
  %c3 = scalar.constant 3 : i64
  %c5 = scalar.constant 5 : i64
  %c7 = scalar.constant 7 : i64
  %c11 = scalar.constant 11 : i64
  %c13 = scalar.constant 13 : i64
  %c17 = scalar.constant 17 : i64
  %c19 = scalar.constant 19 : i64
  %pa = scalar.muli %a, %c3 : i64
  %pb = scalar.muli %b, %c5 : i64
  %pc = scalar.muli %c, %c7 : i64
  %pd = scalar.muli %d, %c11 : i64
  %pe = scalar.muli %e, %c13 : i64
  %pf = scalar.muli %f, %c17 : i64
  %pg = scalar.muli %last, %c19 : i64
  %ab = scalar.addi %pa, %pb : i64
  %cd = scalar.addi %pc, %pd : i64
  %ef = scalar.addi %pe, %pf : i64
  %sg = scalar.addi %stored, %pg : i64
  %abcd = scalar.addi %ab, %cd : i64
  %efsg = scalar.addi %ef, %sg : i64
  %result = scalar.addi %abcd, %efsg : i64
  func.return %result : i64
}

// Two complete calls own the 5 and 9 overflow values independently. The first
// result, the local pointer, and both inputs remain live across another call.
func.def public @call_pair(%x: i64, %y: i64) -> (i64) {
  %length = index.constant 16 : offset
  %c0 = index.constant 0 : offset
  %local = buffer.alloca<private> align(64) %length : buffer
  %values = buffer.view %local[%c0] : buffer -> view<2xi64>
  view.store %x, %values[0] : i64, view<2xi64>
  view.store %y, %values[1] : i64, view<2xi64>
  %c5 = scalar.constant 5 : i64
  %c9 = scalar.constant 9 : i64
  %first = func.call @draw_arguments(%local, %x, %y, %x, %y, %x, %y, %c5) : (buffer, i64, i64, i64, i64, i64, i64, i64) -> (i64)
  %second = func.call @draw_arguments(%local, %y, %x, %y, %x, %y, %x, %c9) : (buffer, i64, i64, i64, i64, i64, i64, i64) -> (i64)
  %both = scalar.addi %first, %second : i64
  %live = scalar.xori %x, %y : i64
  %result = scalar.addi %both, %live : i64
  func.return %result : i64
}

func.def public @incoming_eight(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64) -> (i64) {
  %ab = scalar.addi %a, %b : i64
  %cd = scalar.xori %c, %d : i64
  %ef = scalar.muli %e, %f : i64
  %gh = scalar.muli %g, %h : i64
  %first = scalar.addi %ab, %cd : i64
  %second = scalar.addi %ef, %gh : i64
  %result = scalar.xori %first, %second : i64
  func.return %result : i64
}

func.def public noinline @recursive_sum(%n: i64) -> (i64) {
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %done = scalar.cmpi eq, %n, %c0 : i64
  cfg.cond_br %done, ^exit, ^recurse
^exit:
  func.return %c0 : i64
^recurse:
  %previous = scalar.subi %n, %c1 : i64
  %tail = func.call @recursive_sum(%previous) : (i64) -> (i64)
  %result = scalar.addi %tail, %n : i64
  func.return %result : i64
}

// Ordinary unresolved C linkage is resolved by the artifact's linker.
func.decl @native_host_mix(%x: i64, %y: i64) -> (i64)

func.def public @call_host(%x: i64, %y: i64) -> (i64) {
  %value = func.call @native_host_mix(%y, %x) : (i64, i64) -> (i64)
  %result = scalar.xori %value, %x : i64
  func.return %result : i64
}

// Mixed register/stack widths and a void call use the ordinary C boundary.
func.decl @native_host_store(%output: buffer, %a: i32, %b: i64, %c: i32, %d: i64, %e: i32, %f: i64, %g: i32)

func.def public @call_store(%output: buffer, %word: i32, %wide: i64) -> (i64) {
  func.call @native_host_store(%output, %word, %wide, %word, %wide, %word, %wide, %word) : (buffer, i32, i64, i32, i64, i32, i64, i32)
  %c0 = index.constant 0 : offset
  %result_view = buffer.view %output[%c0] : buffer -> view<1xi64>
  %result = view.load %result_view[0] : view<1xi64> -> i64
  func.return %result : i64
}

// Dying inputs can occupy the ABI prefix. Reversing them requires a genuine
// parallel permutation, including sources that also feed stack arguments.
func.def public @reverse_eight(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64) -> (i64) {
  %result = func.call @incoming_eight(%h, %g, %f, %e, %d, %c, %b, %a) : (i64, i64, i64, i64, i64, i64, i64, i64) -> (i64)
  func.return %result : i64
}

func.decl @native_host_alignment(%pointer: buffer) -> (i64)

// Incoming stack arguments remain relative to the caller's stack even when
// this function realigns its own frame and reserves another outgoing packet.
func.def public @incoming_aligned(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64) -> (i64) {
  %length = index.constant 16 : offset
  %c0 = index.constant 0 : offset
  %local = buffer.alloca<private> align(64) %length : buffer
  %values = buffer.view %local[%c0] : buffer -> view<2xi64>
  view.store %g, %values[0] : i64, view<2xi64>
  view.store %h, %values[1] : i64, view<2xi64>
  %weighted = func.call @draw_arguments(%local, %a, %b, %c, %d, %e, %f, %g) : (buffer, i64, i64, i64, i64, i64, i64, i64) -> (i64)
  %alignment = func.call @native_host_alignment(%local) : (buffer) -> (i64)
  %result = scalar.addi %weighted, %alignment : i64
  func.return %result : i64
}

func.decl @native_host_fifteen(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64, %i: i64, %j: i64, %k: i64, %l: i64, %m: i64, %n: i64, %o: i64) -> (i64)

// The operands fill all allocatable GPRs. Register-cycle scratch becomes
// available after the call has copied its overflow operands onto the stack.
func.def public @call_fifteen(%seed: i64) -> (i64) {
  %a = scalar.addi %seed, %seed : i64
  %b = scalar.addi %a, %seed : i64
  %c = scalar.addi %b, %seed : i64
  %d = scalar.addi %c, %seed : i64
  %e = scalar.addi %d, %seed : i64
  %f = scalar.addi %e, %seed : i64
  %g = scalar.addi %f, %seed : i64
  %h = scalar.addi %g, %seed : i64
  %i = scalar.addi %h, %seed : i64
  %j = scalar.addi %i, %seed : i64
  %k = scalar.addi %j, %seed : i64
  %l = scalar.addi %k, %seed : i64
  %m = scalar.addi %l, %seed : i64
  %n = scalar.addi %m, %seed : i64
  %o = scalar.addi %n, %seed : i64
  %result = func.call @native_host_fifteen(%a, %b, %c, %d, %e, %f, %g, %h, %i, %j, %k, %l, %m, %n, %o) : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64)
  func.return %result : i64
}

// The induction state and accumulated result both survive each external call.
func.def public @call_loop(%seed: i64, %count: index) -> (i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %result, %last = scf.for %i = [%begin to %count step %step](%sum = %c0 : i64, %value = %seed : i64) -> (i64, i64) {
    %mixed = func.call @native_host_mix(%value, %sum) : (i64, i64) -> (i64)
    %next_sum = scalar.addi %sum, %mixed : i64
    %next_value = scalar.addi %value, %c1 : i64
    scf.yield %next_sum, %next_value : i64, i64
  }
  func.return %result : i64
}

// Fourteen loop-carried words and a counter occupy every allocatable GPR.
// Swapping each pair requires invocation-owned cycle storage: no register can
// be reserved for transport without spilling an actual program value.
low.func.def public target<x86.scalar.core> abi(object_function) @saturated_permutation(%word0: reg<x86.gpr64>, %word1: reg<x86.gpr64>, %word2: reg<x86.gpr64>, %word3: reg<x86.gpr64>, %word4: reg<x86.gpr64>, %word5: reg<x86.gpr64>, %word6: reg<x86.gpr64>, %word7: reg<x86.gpr64>, %word8: reg<x86.gpr64>, %word9: reg<x86.gpr64>, %word10: reg<x86.gpr64>, %word11: reg<x86.gpr64>, %word12: reg<x86.gpr64>, %word13: reg<x86.gpr64>, %iterations: reg<x86.gpr32>) -> (reg<x86.gpr64>) asm {
  low.br ^header(%word0: reg<x86.gpr64>, %word1: reg<x86.gpr64>, %word2: reg<x86.gpr64>, %word3: reg<x86.gpr64>, %word4: reg<x86.gpr64>, %word5: reg<x86.gpr64>, %word6: reg<x86.gpr64>, %word7: reg<x86.gpr64>, %word8: reg<x86.gpr64>, %word9: reg<x86.gpr64>, %word10: reg<x86.gpr64>, %word11: reg<x86.gpr64>, %word12: reg<x86.gpr64>, %word13: reg<x86.gpr64>, %iterations: reg<x86.gpr32>)
^header(%lane0: reg<x86.gpr64>, %lane1: reg<x86.gpr64>, %lane2: reg<x86.gpr64>, %lane3: reg<x86.gpr64>, %lane4: reg<x86.gpr64>, %lane5: reg<x86.gpr64>, %lane6: reg<x86.gpr64>, %lane7: reg<x86.gpr64>, %lane8: reg<x86.gpr64>, %lane9: reg<x86.gpr64>, %lane10: reg<x86.gpr64>, %lane11: reg<x86.gpr64>, %lane12: reg<x86.gpr64>, %lane13: reg<x86.gpr64>, %remaining: reg<x86.gpr32>):
  low.cond_br %remaining, ^body, ^exit : reg<x86.gpr32>
^body:
  %next = sub.imm.gpr32 %remaining {imm32 = 1}
  low.br ^header(%lane1: reg<x86.gpr64>, %lane0: reg<x86.gpr64>, %lane3: reg<x86.gpr64>, %lane2: reg<x86.gpr64>, %lane5: reg<x86.gpr64>, %lane4: reg<x86.gpr64>, %lane7: reg<x86.gpr64>, %lane6: reg<x86.gpr64>, %lane9: reg<x86.gpr64>, %lane8: reg<x86.gpr64>, %lane11: reg<x86.gpr64>, %lane10: reg<x86.gpr64>, %lane13: reg<x86.gpr64>, %lane12: reg<x86.gpr64>, %next: reg<x86.gpr32>)
^exit:
  %difference0 = sub.gpr64 %lane0, %lane1
  %difference1 = sub.gpr64 %lane2, %lane3
  %difference2 = sub.gpr64 %lane4, %lane5
  %difference3 = sub.gpr64 %lane6, %lane7
  %difference4 = sub.gpr64 %lane8, %lane9
  %difference5 = sub.gpr64 %lane10, %lane11
  %difference6 = sub.gpr64 %lane12, %lane13
  %sum1 = add.gpr64 %difference0, %difference1
  %sum2 = add.gpr64 %sum1, %difference2
  %sum3 = add.gpr64 %sum2, %difference3
  %sum4 = add.gpr64 %sum3, %difference4
  %sum5 = add.gpr64 %sum4, %difference5
  %sum6 = add.gpr64 %sum5, %difference6
  return %sum6
}
