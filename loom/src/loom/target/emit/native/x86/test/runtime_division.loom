// Native runtime division exercises the complete scalar carrier family and
// vector scalarization through the ordinary SysV object-function boundary.

func.def public @runtime_division_i1(%lhs: i1, %rhs: i1, %output: buffer) {
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  %signed_quotient = scalar.divsi %lhs, %rhs : i1
  %signed_remainder = scalar.remsi %lhs, %rhs : i1
  %unsigned_quotient = scalar.divui %lhs, %rhs : i1
  %unsigned_remainder = scalar.remui %lhs, %rhs : i1
  %signed_quotient_bits = scalar.extui %signed_quotient : i1 to i32
  %signed_remainder_bits = scalar.extui %signed_remainder : i1 to i32
  %unsigned_quotient_bits = scalar.extui %unsigned_quotient : i1 to i32
  %unsigned_remainder_bits = scalar.extui %unsigned_remainder : i1 to i32
  view.store %signed_quotient_bits, %results[0] : i32, view<4xi32>
  view.store %signed_remainder_bits, %results[1] : i32, view<4xi32>
  view.store %unsigned_quotient_bits, %results[2] : i32, view<4xi32>
  view.store %unsigned_remainder_bits, %results[3] : i32, view<4xi32>
  func.return
}

func.def public @runtime_unsigned_division_i1(%lhs: i1, %rhs: i1, %output: buffer) {
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi32>
  %quotient = scalar.divui %lhs, %rhs : i1
  %remainder = scalar.remui %lhs, %rhs : i1
  %quotient_bits = scalar.extui %quotient : i1 to i32
  %remainder_bits = scalar.extui %remainder : i1 to i32
  view.store %quotient_bits, %results[0] : i32, view<2xi32>
  view.store %remainder_bits, %results[1] : i32, view<2xi32>
  func.return
}

func.def public @signed_remainder_i1(%lhs: i1, %rhs: i1) -> (i1) {
  %result = scalar.remsi %lhs, %rhs : i1
  func.return %result : i1
}

