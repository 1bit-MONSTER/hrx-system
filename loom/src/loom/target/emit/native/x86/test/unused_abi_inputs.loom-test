code: c5 fc 10 44 24 08 c3

// ====

// The old frame base is ordinary allocatable state. Saving RBP shifts caller
// stack offsets but does not conflict with a live vector stack input.
// RUN: emit x86-native-bytes @allocated_rbp_with_vector_stack fixed=%output:physical_register:5:1 fixed=%v8:physical_register:0:1
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) abi_layout({signature = (buffer, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) -> ()}) @allocated_rbp_with_vector_stack(%output: reg<x86.gpr64>, %v0: reg<x86.ymm>, %v1: reg<x86.ymm>, %v2: reg<x86.ymm>, %v3: reg<x86.ymm>, %v4: reg<x86.ymm>, %v5: reg<x86.ymm>, %v6: reg<x86.ymm>, %v7: reg<x86.ymm>, %v8: reg<x86.ymm>) asm {
  vmovdqu32.store.ymm %v8, %output {disp32 = 0}
  return
}

