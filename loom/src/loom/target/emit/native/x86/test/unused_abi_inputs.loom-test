// ====

// A live ninth vector also loads directly from caller RSP when no local
// storage requires stronger alignment.
// RUN: emit x86-native-bytes @live_vector_stack
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) abi_layout({signature = (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) -> (vector<8xi32>)}) @live_vector_stack(%v0: reg<x86.ymm>, %v1: reg<x86.ymm>, %v2: reg<x86.ymm>, %v3: reg<x86.ymm>, %v4: reg<x86.ymm>, %v5: reg<x86.ymm>, %v6: reg<x86.ymm>, %v7: reg<x86.ymm>, %v8: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  return %v8
}

