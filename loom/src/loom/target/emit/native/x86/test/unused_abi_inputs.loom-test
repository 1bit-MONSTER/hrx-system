// ====

// A call still receives valid caller-owned overflow storage when every result
// is dead, but the caller does not reload or normalize the indirect i16 row.
// RUN: emit x86-native-bytes @unused_indirect_result
x86.target<avx2> @target

low.func.def noinline target<x86.avx2.core>(@target) abi_layout({signature = (buffer) -> (i64, i64, i16)}) @return_indirect_i16(%sink: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr32>) asm {
  %r0 = mov.imm64 1
  %r1 = mov.imm64 2
  %r2 = mov.imm32 3
  mov.store.gpr64 %r0, %sink {disp32 = 0}
  return %r0, %r1, %r2
}

low.func.def target<x86.avx2.core>(@target) @unused_indirect_result(%sink: reg<x86.gpr64>) asm {
  %unused0, %unused1, %unused2 = low.func.call @return_indirect_i16(%sink) : (reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr32>)
  return
}

