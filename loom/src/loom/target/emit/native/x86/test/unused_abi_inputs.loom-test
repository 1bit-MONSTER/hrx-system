// ====

// Calls write their ABI result registers even when the SSA definitions have
// zero-length live intervals. Those dead writes need no later normalization.
// RUN: emit x86-native-bytes @unused_narrow_call_results
x86.target<avx2> @target

low.func.decl target<x86.avx2.core>(@target) abi_layout({signature = () -> (i1)}) @return_i1() -> (reg<x86.gpr32>)

low.func.decl target<x86.avx2.core>(@target) abi_layout({signature = () -> (i8)}) @return_i8() -> (reg<x86.gpr32>)

low.func.decl target<x86.avx2.core>(@target) abi_layout({signature = () -> (f8E4M3)}) @return_f8e4m3() -> (reg<x86.gpr32>)

low.func.decl target<x86.avx2.core>(@target) abi_layout({signature = () -> (f8E5M2)}) @return_f8e5m2() -> (reg<x86.gpr32>)

low.func.decl target<x86.avx2.core>(@target) abi_layout({signature = () -> (i16)}) @return_i16() -> (reg<x86.gpr32>)

low.func.def target<x86.avx2.core>(@target) @unused_narrow_call_results() asm {
  %unused_i1 = low.func.call @return_i1() : () -> (reg<x86.gpr32>)
  %unused_i8 = low.func.call @return_i8() : () -> (reg<x86.gpr32>)
  %unused_f8e4m3 = low.func.call @return_f8e4m3() : () -> (reg<x86.gpr32>)
  %unused_f8e5m2 = low.func.call @return_f8e5m2() : () -> (reg<x86.gpr32>)
  %unused_i16 = low.func.call @return_i16() : () -> (reg<x86.gpr32>)
  return
}

