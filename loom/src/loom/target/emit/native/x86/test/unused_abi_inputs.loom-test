// ====

// A dead ninth vector occupies ABI stack space without forcing a frame. The
// live seventh integer loads directly from its independent stack-bank offset.
// RUN: emit x86-native-bytes @dead_vector_stack_live_scalar_stack
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) abi_layout({signature = (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, i64, i64, i64, i64, i64, i64, i64) -> (i64)}) @dead_vector_stack_live_scalar_stack(%v0: reg<x86.ymm>, %v1: reg<x86.ymm>, %v2: reg<x86.ymm>, %v3: reg<x86.ymm>, %v4: reg<x86.ymm>, %v5: reg<x86.ymm>, %v6: reg<x86.ymm>, %v7: reg<x86.ymm>, %v8: reg<x86.ymm>, %g0: reg<x86.gpr64>, %g1: reg<x86.gpr64>, %g2: reg<x86.gpr64>, %g3: reg<x86.gpr64>, %g4: reg<x86.gpr64>, %g5: reg<x86.gpr64>, %g6: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  return %g6
}

