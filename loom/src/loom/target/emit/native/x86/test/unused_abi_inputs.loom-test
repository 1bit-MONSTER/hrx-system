// Only the live i32 needs entry transport. The complete narrow action family
// remains in the public signature without emitting normalization instructions.
// RUN: emit x86-native-bytes @unused_narrow_inputs
x86.target<avx2> @target

low.func.def public target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (i32, i1, i8, f8E4M3, f8E5M2, i16) -> (i32)}) @unused_narrow_inputs(%value: reg<x86.gpr32>, %unused_i1: reg<x86.gpr32>, %unused_i8: reg<x86.gpr32>, %unused_f8e4m3: reg<x86.gpr32>, %unused_f8e5m2: reg<x86.gpr32>, %unused_i16: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

// ----
code: 8b c7 c3

// ====

// The same family still normalizes every live input before Low operations can
// observe the carrier registers.
// RUN: emit x86-native-bytes @live_narrow_inputs
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) abi_layout({signature = (i1, i8, f8E4M3, f8E5M2, i16) -> (i32)}) @live_narrow_inputs(%i1_value: reg<x86.gpr32>, %i8_value: reg<x86.gpr32>, %f8e4m3_value: reg<x86.gpr32>, %f8e5m2_value: reg<x86.gpr32>, %i16_value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %sum0 = add.gpr32 %i1_value, %i8_value
  %sum1 = add.gpr32 %sum0, %f8e4m3_value
  %sum2 = add.gpr32 %sum1, %f8e5m2_value
  %sum3 = add.gpr32 %sum2, %i16_value
  return %sum3
}

