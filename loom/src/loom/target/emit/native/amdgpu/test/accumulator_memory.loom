// Accumulator payloads cross global, private and descriptor-backed memory without
// staging through VGPRs. Distinct lane data detects indexing or bank aliasing.
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @memory_roundtrip(%lane: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %source_offset = v_lshlrev_b32_src0_inline %lane, 4
  %target_offset = v_lshlrev_b32_src0_inline %lane, 5
  // Untyped buffer records contain a 48-bit base, byte extent and control word.
  %address_mask = s_mov_b32 65535
  %control = s_mov_b32 159744
  %source_low = slice %input[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %source_high = slice %input[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %source_base_high = s_and_b32 %source_high, %address_mask
  %source_extent = s_mov_b32 1024
  %source_resource = concat(%source_low, %source_base_high, %source_extent, %control) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %target_low = slice %output[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %target_high = slice %output[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %target_base_high = s_and_b32 %target_high, %address_mask
  %target_extent = s_mov_b32 2048
  %target_resource = concat(%target_low, %target_base_high, %target_extent, %control) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  %private_offset = storage_address %storage : low.storage<private> -> reg<amdgpu.vgpr>
  %loaded = global_load_dwordx4_saddr %source_offset, %input : reg<amdgpu.agpr x4>
  scratch_store_dwordx4_vaddr %private_offset, %loaded
  %reloaded = scratch_load_dwordx4_vaddr %private_offset : reg<amdgpu.agpr x4>
  buffer_store_dwordx4_vaddr_offset %reloaded, %target_resource, %target_offset
  %buffered = buffer_load_dwordx4_vaddr_offset %source_resource, %source_offset : reg<amdgpu.agpr x4>
  global_store_dwordx4_saddr %target_offset, %buffered, %output {offset = 16}
  %half = global_load_d16_b16_saddr %source_offset, %input : reg<amdgpu.agpr>
  buffer_store_short_vaddr_offset %half, %target_resource, %target_offset
  return
}

kernel.def target(@target) @accumulator_memory() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane_index = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane_index : index to i32
  %lane = vector.splat %lane_i32 : vector<1xi32>
  low.invoke @memory_roundtrip(%lane, %input, %output) : (vector<1xi32>, buffer, buffer)
  kernel.return
}

func.def @accumulator_memory_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<64x4xi32>
  %target = buffer.view %output[%base] : buffer -> view<64x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %width = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    scf.for %word = [%begin to %width step %step] {
      %value = view.load %source[%lane, %word] : view<64x4xi32> -> i32
      %second = index.add %word, %width : index
      view.store %value, %target[%lane, %word] : i32, view<64x8xi32>
      view.store %value, %target[%lane, %second] : i32, view<64x8xi32>
    }
  }
  func.return
}

check.scenario @accumulator_memory_paths {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna2.core"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(305397760) step(37) : tensor<64x4xi32>
    %output = check.generate.fill value(-1) : tensor<64x8xi32>
    check.compare<@accumulator_memory, @accumulator_memory_oracle>(%input, %output) : (tensor<64x4xi32>, tensor<64x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64x8xi32>
    }
  }
  check.return
}

// Authored spills use native accumulator packets for aligned and misaligned
// storage views. A masked overwrite must retain the other lanes' first values.
low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @spill_roundtrip(%lane: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %replacement: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %source_offset = v_lshlrev_b32_src0_inline %lane, 4
  %target_offset = v_lshlrev_b32_src0_inline %lane, 5
  %storage = storage {byte_alignment = 16, byte_length = 8224} : low.storage<private>
  %view = storage_view %storage {byte_length = 16, offset = 8196} : low.storage<private> -> low.storage<private>
  %original = global_load_dwordx4_saddr %source_offset, %input : reg<amdgpu.agpr x4>
  %updated = global_load_dwordx4_saddr %source_offset, %replacement : reg<amdgpu.agpr x4>
  low.spill %original, %storage : reg<amdgpu.agpr x4>, low.storage<private>
  low.spill %original, %view : reg<amdgpu.agpr x4>, low.storage<private>
  %limit = v_mov_b32 32
  %active = v_cmp_lt_u32 %lane, %limit
  %saved, %any = s_and_saveexec_b64 %active
  low.spill %updated, %view : reg<amdgpu.agpr x4>, low.storage<private>
  s_mov_b64_exec %saved
  %aligned = low.reload %storage : low.storage<private> -> reg<amdgpu.agpr x4>
  %masked = low.reload %view : low.storage<private> -> reg<amdgpu.agpr x4>
  global_store_dwordx4_saddr %target_offset, %aligned, %output
  global_store_dwordx4_saddr %target_offset, %masked, %output {offset = 16}
  return
}

kernel.def target(@target) @accumulator_spills() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %replacement: buffer, %output: buffer) {
  %lane_index = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane_index : index to i32
  %lane = vector.splat %lane_i32 : vector<1xi32>
  low.invoke @spill_roundtrip(%lane, %input, %replacement, %output) : (vector<1xi32>, buffer, buffer, buffer)
  kernel.return
}

func.def @accumulator_spills_oracle(%input: buffer, %replacement: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<64x4xi32>
  %update = buffer.view %replacement[%base] : buffer -> view<64x4xi32>
  %target = buffer.view %output[%base] : buffer -> view<64x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %limit = index.constant 32 : index
  %width = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %active = index.cmp ult, %lane, %limit : index
    scf.for %word = [%begin to %width step %step] {
      %original = view.load %source[%lane, %word] : view<64x4xi32> -> i32
      %replacement_value = view.load %update[%lane, %word] : view<64x4xi32> -> i32
      %masked = scf.select %active, %replacement_value, %original : i32
      %second = index.add %word, %width : index
      view.store %original, %target[%lane, %word] : i32, view<64x8xi32>
      view.store %masked, %target[%lane, %second] : i32, view<64x8xi32>
    }
  }
  func.return
}

check.scenario @accumulator_spill_lanes {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna2.core"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(17) step(37) : tensor<64x4xi32>
    %replacement = check.generate.iota offset(-4096) step(13) : tensor<64x4xi32>
    %output = check.generate.fill value(-1) : tensor<64x8xi32>
    check.compare<@accumulator_spills, @accumulator_spills_oracle>(%input, %replacement, %output) : (tensor<64x4xi32>, tensor<64x4xi32>, tensor<64x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64x8xi32>
    }
  }
  check.return
}
