// ====

// Untyped buffer atomics ignore FORMAT. Loom clears it; LLVM sets it to one.
// RUN: emit amdgpu-native-words @float64_buffer strategy=source waits=none fixed=%address:physical_register:2:1 fixed=%value:physical_register:4:2 fixed=%resource:physical_register:0:4 fixed=%soffset:physical_register:4:1 fixed=%add:physical_register:4:2 fixed=%min_num:physical_register:4:2 fixed=%max_num:physical_register:4:2
amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @float64_buffer(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %resource: reg<amdgpu.sgpr x4>, %soffset: reg<amdgpu.sgpr>) asm {
  buffer_atomic_add_f64 %value, %resource, %address, %soffset {offset = 16}
  %add = buffer_atomic_add_f64_rtn %value, %resource, %address, %soffset {offset = 16}
  buffer_atomic_min_num_f64 %add, %resource, %address, %soffset {offset = 16}
  %min_num = buffer_atomic_min_num_f64_rtn %add, %resource, %address, %soffset {offset = 16}
  buffer_atomic_max_num_f64 %min_num, %resource, %address, %soffset {offset = 16}
  %max_num = buffer_atomic_max_num_f64_rtn %min_num, %resource, %address, %soffset {offset = 16}
  return
}

