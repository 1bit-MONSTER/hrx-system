// RUN: with-checks emit amdgpu-kernel-assembly

// Matrix instruction preferences and scheduled scalar pairs share one register
// file. Final numbering must retain both dual-issue packets and the compact
// footprint while translating concat moves and matrix operands together.
amdgpu.target<gfx1151> @target

low.kernel.def target<amdgpu.rdna3_5.core>(@target) workgroup_size(32, 1, 1) @numbered_packets() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %one = v_mov_b32 1
  %two = v_mov_b32 2
  %lhs = concat(%lane, %lane, %lane, %lane, %lane, %lane, %lane, %lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %rhs = concat(%one, %one, %one, %one, %one, %one, %one, %one) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %acc = concat(%two, %two, %two, %two, %two, %two, %two, %two) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %dot = v_wmma_f32_16x16x16_bf16 %lhs, %rhs, %acc
  %first = slice %dot[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %second = slice %dot[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product = v_mul_f32 %first, %one
  %sum = v_add_f32 %second, %two
  return
}

// ----
CHECK: v_dual_mov_b32 * :: v_dual_mov_b32 *
CHECK: v_wmma_f32_16x16x16_bf16 *
CHECK: v_dual_mul_f32 * :: v_dual_add_f32 *
CHECK: .amdhsa_next_free_vgpr 32
CHECK: .amdhsa_private_segment_fixed_size 0
