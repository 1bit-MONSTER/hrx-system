amdgpu.target<gfx1100> @target

low.func.def schedule(locked) target<amdgpu.rdna3.core>(@target) @calculate(%lane: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %input_offset = v_mul_lo_u32_src0_inline %lane, 12
  %output_offset = v_lshlrev_b32_src0_inline %lane, 3
  %seed = global_load_b32_saddr %input_offset, %input
  %lhs = global_load_b32_saddr %input_offset, %input {offset = 4}
  %rhs = global_load_b32_saddr %input_offset, %input {offset = 8}
  %result = v_fmac_f32 %seed, %lhs, %rhs : reg<amdgpu.vgpr>
  global_store_b32_saddr %output_offset, %seed, %output
  global_store_b32_saddr %output_offset, %result, %output {offset = 4}
  return
}

kernel.def target(@target) @independent_result() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane_index = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane_index : index to i32
  %lane = vector.splat %lane_i32 : vector<1xi32>
  low.invoke @calculate(%lane, %input, %output) : (vector<1xi32>, buffer, buffer)
  kernel.return
}

func.def @independent_result_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<64x3xf32>
  %target = buffer.view %output[%base] : buffer -> view<64x2xf32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %rhs_column = index.constant 2 : index
  scf.for %lane = [%begin to %end step %step] {
    %seed = view.load %source[%lane, %begin] : view<64x3xf32> -> f32
    %lhs = view.load %source[%lane, %step] : view<64x3xf32> -> f32
    %rhs = view.load %source[%lane, %rhs_column] : view<64x3xf32> -> f32
    %result = scalar.fmaf %lhs, %rhs, %seed : f32
    view.store %seed, %target[%lane, %begin] : f32, view<64x2xf32>
    view.store %result, %target[%lane, %step] : f32, view<64x2xf32>
  }
  func.return
}

check.scenario @independent_accumulator_result {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.rdna3.core"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<64x3xf32>
    %output = check.generate.fill value(-1.0) : tensor<64x2xf32>
    check.compare<@independent_result, @independent_result_oracle>(%input, %output) : (tensor<64x3xf32>, tensor<64x2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64x2xf32>
    }
  }
  check.return
}
