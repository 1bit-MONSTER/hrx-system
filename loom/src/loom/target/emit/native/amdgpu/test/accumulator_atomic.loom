// Each lane updates a distinct address and observes the returned old value.
// Both the update and returned value remain in the accumulator register bank.
low.func.def schedule(locked) target<amdgpu.cdna3.core> @returning_atomic(%lane: reg<amdgpu.vgpr>, %storage: reg<amdgpu.sgpr x2>, %increments: reg<amdgpu.sgpr x2>, %prior: reg<amdgpu.sgpr x2>) asm {
  %offset = v_lshlrev_b32_src0_inline %lane, 2
  %increment = global_load_dword_saddr %offset, %increments : reg<amdgpu.agpr>
  %old = global_atomic_add_f32_rtn_saddr %offset, %increment, %storage : reg<amdgpu.agpr>
  global_store_dword_saddr %offset, %old, %prior
  return
}

kernel.def @accumulator_atomic() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%storage: buffer, %increments: buffer, %prior: buffer) {
  %lane_index = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane_index : index to i32
  %lane = vector.splat %lane_i32 : vector<1xi32>
  low.invoke @returning_atomic(%lane, %storage, %increments, %prior) : (vector<1xi32>, buffer, buffer, buffer)
  kernel.return
}

func.def @accumulator_atomic_oracle(%storage: buffer, %increments: buffer, %prior: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %storage[%base] : buffer -> view<64xf32>
  %addends = buffer.view %increments[%base] : buffer -> view<64xf32>
  %observed = buffer.view %prior[%base] : buffer -> view<64xf32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %old = view.load %values[%lane] : view<64xf32> -> f32
    %increment = view.load %addends[%lane] : view<64xf32> -> f32
    %updated = scalar.addf %old, %increment : f32
    view.store %old, %observed[%lane] : f32, view<64xf32>
    view.store %updated, %values[%lane] : f32, view<64xf32>
  }
  func.return
}

check.scenario @accumulator_atomic_return {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna3.core"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.iota offset(1.0) step(1.0) : tensor<64xf32>
    %increments = check.generate.iota offset(0.25) step(0.5) : tensor<64xf32>
    %prior = check.generate.fill value(-1.0) : tensor<64xf32>
    check.compare<@accumulator_atomic, @accumulator_atomic_oracle>(%storage, %increments, %prior) : (tensor<64xf32>, tensor<64xf32>, tensor<64xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<64xf32>
      check.expect.bitwise actual(%prior) expected(%prior) : tensor<64xf32>
    }
  }
  check.return
}
