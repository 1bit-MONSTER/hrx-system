// ----
  s_waitcnt vmcnt(63) lgkmcnt(0)
  global_load_dword v0, v[0:1], off offset:0
  s_nop 0
  global_load_dword v2, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Scalar and vector instructions terminate one another's replay clauses.
// RUN: emit amdgpu-assembly @mixed_memory_classes strategy=source fixed=%left:physical_register:0:2 fixed=%scalar:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%first:physical_register:0:1 fixed=%middle:physical_register:2:1 fixed=%second:physical_register:2:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @mixed_memory_classes(%left: reg<amdgpu.vgpr x2>, %scalar: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %middle = s_load_dword_offset_only %scalar
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %middle, %second
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_load_dword s2, s[0:1], 0
  global_load_dword v2, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  s_endpgm

// ====

// A store after a load definition starts a fresh replayable clause.
// RUN: emit amdgpu-assembly @load_then_store strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%value:physical_register:4:1 fixed=%loaded:physical_register:5:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @load_then_store(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  global_store_dword_vaddr %right, %value
  return %loaded
}

// ----
  global_load_dword v5, v[0:1], off offset:0
  s_nop 0
  global_store_dword v[2:3], v4, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// A clause containing only stores has no register definitions to preserve.
// RUN: emit amdgpu-assembly @store_then_load strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%value:physical_register:4:1 fixed=%loaded:physical_register:2:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @store_then_load(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dword_vaddr %left, %value
  %loaded = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %loaded
}

// ----
  global_store_dword v[0:1], v4, off offset:0
  global_load_dword v2, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// A returning atomic consumes store data and defines a load result.
// RUN: emit amdgpu-assembly @returning_atomic_clause strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%value:physical_register:4:1 fixed=%loaded:physical_register:5:1 fixed=%old:physical_register:6:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @returning_atomic_clause(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %loaded = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %old = flat_atomic_add_rtn %right, %value : reg<amdgpu.vgpr>
  return %loaded, %old
}

// ----
  global_load_dword v5, v[0:1], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  flat_atomic_add v6, v[2:3], v4 offset:0 glc
  s_waitcnt vmcnt(0) lgkmcnt(0)
  s_endpgm

// ====

// Descriptor-backed loads protect the vector offset used by an earlier load.
// RUN: emit amdgpu-assembly @buffer_address_overlap strategy=source fixed=%left:physical_register:0:1 fixed=%right:physical_register:1:1 fixed=%resource:physical_register:0:4 fixed=%first:physical_register:2:1 fixed=%second:physical_register:0:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @buffer_address_overlap(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>, %resource: reg<amdgpu.sgpr x4>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = buffer_load_dword_vaddr_offset %resource, %left : reg<amdgpu.vgpr>
  %second = buffer_load_dword_vaddr_offset %resource, %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  buffer_load_dword v2, v0, s[0:3], 0 offen offset:0
  s_nop 0
  buffer_load_dword v0, v1, s[0:3], 0 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Branch instructions end the physical clause on both taken and untaken paths.
// RUN: emit amdgpu-assembly @branch_break strategy=source fixed=%choose:physical_register:0:1 fixed=%left:physical_register:0:2 fixed=%middle:physical_register:2:2 fixed=%right:physical_register:4:2 fixed=%first:physical_register:0:1 fixed=%second:physical_register:2:1 fixed=%third:physical_register:4:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @branch_break(%choose: reg<amdgpu.scc>, %left: reg<amdgpu.vgpr x2>, %middle: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  low.cond_br %choose, ^left, ^right : reg<amdgpu.scc>
^left:
  %second = global_load_dword_vaddr %middle : reg<amdgpu.vgpr>
  low.br ^exit
^right:
  %third = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  low.br ^exit
^exit:
  return
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  global_load_dword v2, v[2:3], off offset:0
  s_branch .Lbb3
.Lbb2:
  global_load_dword v4, v[4:5], off offset:0
.Lbb3:
  s_endpgm

// ====

// A coalesced slice has no instruction to separate the two scalar loads.
// RUN: emit amdgpu-assembly @scalar_slice strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%first:physical_register:4:2 fixed=%second:physical_register:0:2
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scalar_slice(%left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) asm {
  %first = s_load_dwordx2_offset_only %left
  %view = slice %first[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = s_load_dwordx2_offset_only %right
  return %view, %second
}

// ----
  s_load_dwordx2 s[4:5], s[0:1], 0
  s_nop 0
  s_load_dwordx2 s[0:1], s[2:3], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Scalar stores have the same load/store clause boundary as vector stores.
// RUN: emit amdgpu-assembly @scalar_load_store strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%value:physical_register:4:1 fixed=%loaded:physical_register:6:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scalar_load_store(%left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = s_load_dword_offset_only %left
  s_store_dword_offset_only %value, %right
  return %loaded
}

// ----
  s_load_dword s6, s[0:1], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_store_dword s4, s[2:3], 0
  s_endpgm

// ====

// Private-memory instructions retain the entire preceding VMEM clause.
// RUN: emit amdgpu-assembly @scratch_address_overlap strategy=source fixed=%left:physical_register:0:1 fixed=%right:physical_register:1:1 fixed=%first:physical_register:2:1 fixed=%second:physical_register:0:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scratch_address_overlap(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = scratch_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %second = scratch_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  scratch_load_dword v2, v0, off offset:0
  s_nop 0
  scratch_load_dword v0, v1, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Native words consume the same replay insertion as assembly.
// RUN: emit amdgpu-native-words @gfx90a_sgpr_any strategy=source fixed=%first_address:physical_register:0:2 fixed=%second_address:physical_register:2:2 fixed=%first:physical_register:4:1 fixed=%second:physical_register:0:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @gfx90a_sgpr_any(%first_address: reg<amdgpu.sgpr x2>, %second_address: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first = s_load_dword_offset_only %first_address
  low.br ^next
^next:
  %second = s_load_dword_offset_only %second_address
  return %first, %second
}

