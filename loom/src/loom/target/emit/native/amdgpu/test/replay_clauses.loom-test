// Replayable clauses retain physical register uses across zero-instruction
// block edges. Scalar loads overwrite an earlier address; vector loads reuse
// their own address. Explicit XNACK OFF disables both protections, while
// gfx1250 always requires scalar protection and has no VMEM clause hazard.

// RUN: emit amdgpu-assembly @gfx90a_sgpr_any strategy=source fixed=%first_address:physical_register:0:2 fixed=%second_address:physical_register:2:2 fixed=%first:physical_register:4:1 fixed=%second:physical_register:0:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @gfx90a_sgpr_any(%first_address: reg<amdgpu.sgpr x2>, %second_address: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first = s_load_dword_offset_only %first_address
  low.br ^next
^next:
  %second = s_load_dword_offset_only %second_address
  return %first, %second
}

// ----
  s_load_dword s4, s[0:1], 0
.Lbb1:
  s_nop 0
  s_load_dword s0, s[2:3], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @gfx90a_vgpr_any strategy=source fixed=%first_address:physical_register:0:2 fixed=%second_address:physical_register:2:2 fixed=%first:physical_register:0:1 fixed=%second:physical_register:2:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @gfx90a_vgpr_any(%first_address: reg<amdgpu.vgpr x2>, %second_address: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %first_address : reg<amdgpu.vgpr>
  low.br ^next
^next:
  %second = global_load_dword_vaddr %second_address : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  global_load_dword v0, v[0:1], off offset:0
.Lbb1:
  s_nop 0
  global_load_dword v2, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @gfx90a_sgpr_on strategy=source fixed=%first_address:physical_register:0:2 fixed=%second_address:physical_register:2:2 fixed=%first:physical_register:4:1 fixed=%second:physical_register:0:1
amdgpu.target<gfx90a> @target {features = [xnack]}

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @gfx90a_sgpr_on(%first_address: reg<amdgpu.sgpr x2>, %second_address: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first = s_load_dword_offset_only %first_address
  low.br ^next
^next:
  %second = s_load_dword_offset_only %second_address
  return %first, %second
}

// ----
  s_load_dword s4, s[0:1], 0
.Lbb1:
  s_nop 0
  s_load_dword s0, s[2:3], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @gfx90a_vgpr_on strategy=source fixed=%first_address:physical_register:0:2 fixed=%second_address:physical_register:2:2 fixed=%first:physical_register:0:1 fixed=%second:physical_register:2:1
amdgpu.target<gfx90a> @target {features = [xnack]}

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @gfx90a_vgpr_on(%first_address: reg<amdgpu.vgpr x2>, %second_address: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
