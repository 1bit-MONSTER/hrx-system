// ====

// The third load overwrites an address used before the immediately prior load.
// RUN: emit amdgpu-assembly @scalar_clause_history strategy=source fixed=%left:physical_register:0:2 fixed=%middle:physical_register:2:2 fixed=%right:physical_register:4:2 fixed=%first:physical_register:8:1 fixed=%second:physical_register:9:1 fixed=%third:physical_register:0:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scalar_clause_history(%left: reg<amdgpu.sgpr x2>, %middle: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first = s_load_dword_offset_only %left
  %second = s_load_dword_offset_only %middle
  %third = s_load_dword_offset_only %right
  return %first, %second, %third
}

// ----
  s_load_dword s8, s[0:1], 0
  s_load_dword s9, s[2:3], 0
  s_nop 0
  s_load_dword s0, s[4:5], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Independent loads remain in one clause.
// RUN: emit amdgpu-assembly @scalar_independent strategy=source fixed=%base:physical_register:0:2 fixed=%first:physical_register:4:1 fixed=%second:physical_register:5:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scalar_independent(%base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first = s_load_dword_offset_only %base
  %second = s_load_dword_offset_only %base {offset = 4}
  return %first, %second
}

// ----
  s_load_dword s4, s[0:1], 0
  s_load_dword s5, s[0:1], 4
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// A wide result overlaps an earlier address near a bit-plane word boundary.
// RUN: emit amdgpu-assembly @vector_wide_overlap strategy=source fixed=%left:physical_register:62:2 fixed=%right:physical_register:66:2 fixed=%first:physical_register:68:4 fixed=%second:physical_register:60:4
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vector_wide_overlap(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %first = global_load_dwordx4_vaddr %left : reg<amdgpu.vgpr x4>
  %second = global_load_dwordx4_vaddr %right : reg<amdgpu.vgpr x4>
  return %first, %second
}

// ----
  global_load_dwordx4 v[68:71], v[62:63], off offset:0
  s_nop 0
  global_load_dwordx4 v[60:63], v[66:67], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// A later load can make an otherwise independent clause unsafe.
// RUN: emit amdgpu-assembly @vector_second_self_alias strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%first:physical_register:4:1 fixed=%second:physical_register:2:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vector_second_self_alias(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  global_load_dword v4, v[0:1], off offset:0
  s_nop 0
  global_load_dword v2, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Equal register numbers in scalar, vector and accumulator banks do not alias.
// RUN: emit amdgpu-assembly @vgpr_distinct_banks strategy=source fixed=%offset:physical_register:4:1 fixed=%base:physical_register:0:2 fixed=%first:physical_register:0:1 fixed=%second:physical_register:1:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vgpr_distinct_banks(%offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_saddr %offset, %base : reg<amdgpu.vgpr>
  %second = global_load_dword_saddr %offset, %base {offset = 4} : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  global_load_dword v0, v4, s[0:1] offset:0
  global_load_dword v1, v4, s[0:1] offset:4
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Equal register numbers in scalar, vector and accumulator banks do not alias.
// RUN: emit amdgpu-assembly @agpr_distinct_banks strategy=source fixed=%offset:physical_register:0:1 fixed=%base:physical_register:0:2 fixed=%first:physical_register:0:1 fixed=%second:physical_register:1:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @agpr_distinct_banks(%offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.agpr>, reg<amdgpu.agpr>) asm {
  %first = global_load_dword_saddr %offset, %base : reg<amdgpu.agpr>
  %second = global_load_dword_saddr %offset, %base {offset = 4} : reg<amdgpu.agpr>
  return %first, %second
}

// ----
  global_load_dword acc0, v0, s[0:1] offset:0
  global_load_dword acc1, v0, s[0:1] offset:4
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Only a concrete non-memory instruction separates a replayable clause.
// RUN: emit amdgpu-assembly @vector_alu_separator strategy=source fixed=%left:physical_register:0:2 fixed=%right:physical_register:2:2 fixed=%first:physical_register:0:1 fixed=%second:physical_register:2:1
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vector_alu_separator(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %separator = s_mov_b32 7
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_mov_b32 s0, 7
  global_load_dword v2, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Only a concrete non-memory instruction separates a replayable clause.
