// Both banks share one hardware allocation, but the accumulator offset depends
// only on the architectural bank. Loading accumulators bypasses VGPR copies.
// RUN: emit amdgpu-kernel-assembly
amdgpu.target<gfx90a> @target

low.kernel.def schedule(locked) target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @matrix_accumulators() asm {
  %pointer = live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %offset = v_lshlrev_b32_src0_inline %lane, 4
  %buffer = s_load_dwordx2_offset_only %pointer
  %base_low = slice %buffer[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_high = slice %buffer[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %address_low, %carry = v_add_co_u32 %base_low, %offset
  %high = v_mov_b32_copy %base_high
  %zero = v_mov_b32 0
  %address_high, %unused = v_addc_co_u32 %high, %zero, %carry
  %address = concat(%address_low, %address_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %accumulator = flat_load_dwordx4 %address : reg<amdgpu.agpr x4>
  %lhs = v_mov_b32 1067450368
  %rhs = v_mov_b32 1075838976
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %accumulator
  flat_store_dwordx4 %address, %result
  return
}

