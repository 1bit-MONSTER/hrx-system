// The wide-shift operand needs the next VGPR to be allocated. The accumulator
// partition follows that physical floor even though no SSA value names it.
// RUN: emit amdgpu-kernel-assembly
amdgpu.target<gfx90a> @target

low.kernel.def schedule(locked) target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @shift_accumulator_partition() asm {
  %a0 = v_mov_b32 1
  %a1 = v_mov_b32 2
  %b0 = v_mov_b32 3
  %b1 = v_mov_b32 4
  %c0 = v_mov_b32 5
  %c1 = v_mov_b32 6
  %extra = v_mov_b32 7
  %count = v_mov_b32 31
  %left = concat(%a0, %a1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %right = concat(%b0, %b1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %signed = concat(%c0, %c1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %accumulator = flat_load_dword %left : reg<amdgpu.agpr>
  %shifted_left = v_lshlrev_b64 %count, %left
  %shifted_right = v_lshrrev_b64 %count, %right
  %shifted_signed = v_ashrrev_i64 %count, %signed
  %used = v_xor_b32 %extra, %count
  flat_store_dword %shifted_left, %accumulator
  return
}

