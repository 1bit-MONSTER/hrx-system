// FLAT has no scalar-base operand. Its bank, width and cache flags all survive
// native printing, including the fixed return bit of compare/exchange.
// RUN: emit amdgpu-assembly @flat_banks strategy=source waits=none
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @flat_banks(%address: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.agpr x2>, %wide_pair: reg<amdgpu.agpr x4>) asm {
  %byte = flat_load_ubyte %address {offset = 1, glc = 1} : reg<amdgpu.agpr>
  %wide = flat_load_dwordx4 %address {offset = 16, slc = 1} : reg<amdgpu.agpr x4>
  flat_store_byte %address, %byte {offset = 32, glc = 1}
  flat_store_dwordx4 %address, %wide {offset = 48, slc = 1}
  %old = flat_atomic_cmpswap_rtn %address, %pair {slc = 1} : reg<amdgpu.agpr>
  %old_wide = flat_atomic_cmpswap_x2_rtn %address, %wide_pair : reg<amdgpu.agpr x2>
  return
}
// ----
  flat_load_ubyte acc2, v[0:1] offset:1 glc
  flat_load_dwordx4 acc[8:11], v[0:1] offset:16 slc
  flat_store_byte v[0:1], acc2 offset:32 glc
  flat_store_dwordx4 v[0:1], acc[8:11] offset:48 slc
  flat_atomic_cmpswap acc0, v[0:1], acc[0:1] offset:0 glc slc
  flat_atomic_cmpswap_x2 acc[0:1], v[0:1], acc[4:7] offset:0 glc
  s_endpgm

// ====

// CDNA's return control is independent of the programmable cache scope.
// RUN: emit amdgpu-assembly @atomic_return_flags strategy=source waits=none
amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @atomic_return_flags(%address: reg<amdgpu.vgpr x2>, %offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.vgpr>, %pair: reg<amdgpu.vgpr x2>, %wide_pair: reg<amdgpu.vgpr x4>) asm {
  %loaded = flat_load_dword %address {nt = 1, sc0 = 1, sc1 = 1} : reg<amdgpu.vgpr>
  flat_atomic_add %address, %value {sc1 = 1}
  %old = flat_atomic_add_rtn %address, %value {sc1 = 1} : reg<amdgpu.vgpr>
  global_atomic_add_saddr %offset, %value, %base
  %global_old = global_atomic_add_rtn_saddr %offset, %value, %base {sc1 = 1}
  %compared = global_atomic_cmpswap_rtn_saddr %offset, %pair, %base
  %wide_compared = global_atomic_cmpswap_x2_rtn_saddr %offset, %wide_pair, %base
  return
}
// ----
  flat_load_dword v6, v[0:1] offset:0 nt sc0 sc1
  flat_atomic_add v[0:1], v2 offset:0 sc1
  flat_atomic_add v0, v[0:1], v2 offset:0 sc0 sc1
  global_atomic_add v3, v2, s[0:1] offset:0
  global_atomic_add v0, v3, v2, s[0:1] offset:0 sc0 sc1
  global_atomic_cmpswap v0, v3, v[4:5], s[0:1] offset:0 sc0
  global_atomic_cmpswap_x2 v[0:1], v3, v[8:11], s[0:1] offset:0 sc0
  s_endpgm

// ====

// Buffer atomics have one read/write data operand, followed by vector address,
// resource and scalar offset. Their return mode is a native flag.
// RUN: emit amdgpu-assembly @buffer_operands strategy=source waits=none
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @buffer_operands(%resource: reg<amdgpu.sgpr x4>, %offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>, %pair: reg<amdgpu.vgpr x2>, %wide_pair: reg<amdgpu.vgpr x4>) asm {
  buffer_atomic_add_u32 %value, %resource, %offset, %base {offset = 4}
  %old = buffer_atomic_add_u32_rtn %value, %resource, %offset, %base {offset = 8}
  %compared = buffer_atomic_cmpswap_b32_rtn %pair, %resource, %offset, %base
  %wide_compared = buffer_atomic_cmpswap_b64_rtn %wide_pair, %resource, %offset, %base
  return
}
// ----
  buffer_atomic_add_u32 v0, v1, s[0:3], s4 offen offset:4
  buffer_atomic_add_u32 v0, v1, s[0:3], s4 offen offset:8 glc
  buffer_atomic_cmpswap_b32 v[2:3], v1, s[0:3], s4 offen offset:0 glc
  buffer_atomic_cmpswap_b64 v[4:7], v1, s[0:3], s4 offen offset:0 glc
  s_endpgm

// ====

// RDNA4 temporal hints have distinct load/store/atomic spellings. Encoding
// three changes its load/store meaning at system scope.
// RUN: emit amdgpu-assembly @temporal_hints strategy=source waits=none
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @temporal_hints(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) asm {
  %regular = flat_load_dword %address
  %non_temporal = flat_load_dword %address {th = 1}
  %high_temporal = flat_load_dword %address {scope = 1, th = 2}
  %last_use = flat_load_dword %address {scope = 2, th = 3}
  %non_temporal_regular = flat_load_dword %address {th = 4}
  %regular_non_temporal = flat_load_dword %address {th = 5}
  %non_temporal_high_temporal = flat_load_dword %address {th = 6}
  %bypass = flat_load_dword %address {scope = 3, th = 3}
  flat_store_b32 %address, %value
  flat_store_b32 %address, %value {th = 1}
  flat_store_b32 %address, %value {scope = 1, th = 2}
  flat_store_b32 %address, %value {scope = 2, th = 3}
  flat_store_b32 %address, %value {th = 4}
  flat_store_b32 %address, %value {th = 5}
  flat_store_b32 %address, %value {th = 6}
  flat_store_b32 %address, %value {th = 7}
  flat_store_b32 %address, %value {scope = 3, th = 3}
  flat_atomic_add_u32 %address, %value
  flat_atomic_add_u32 %address, %value {th = 2}
  flat_atomic_add_u32 %address, %value {th = 4}
  flat_atomic_add_u32 %address, %value {th = 6}
  %old = flat_atomic_add_u32_rtn %address, %value
  %old_non_temporal = flat_atomic_add_u32_rtn %address, %value {scope = 2, th = 3}
  return
}
// ----
  flat_load_dword v3, v[0:1] offset:0
  flat_load_dword v3, v[0:1] offset:0 th:TH_LOAD_NT
  flat_load_dword v3, v[0:1] offset:0 scope:SCOPE_SE th:TH_LOAD_HT
  flat_load_dword v3, v[0:1] offset:0 scope:SCOPE_DEV th:TH_LOAD_LU
  flat_load_dword v3, v[0:1] offset:0 th:TH_LOAD_NT_RT
  flat_load_dword v3, v[0:1] offset:0 th:TH_LOAD_RT_NT
  flat_load_dword v3, v[0:1] offset:0 th:TH_LOAD_NT_HT
  flat_load_dword v3, v[0:1] offset:0 scope:SCOPE_SYS th:TH_LOAD_BYPASS
  flat_store_b32 v[0:1], v2 offset:0
  flat_store_b32 v[0:1], v2 offset:0 th:TH_STORE_NT
  flat_store_b32 v[0:1], v2 offset:0 scope:SCOPE_SE th:TH_STORE_HT
  flat_store_b32 v[0:1], v2 offset:0 scope:SCOPE_DEV th:TH_STORE_WB
  flat_store_b32 v[0:1], v2 offset:0 th:TH_STORE_NT_RT
  flat_store_b32 v[0:1], v2 offset:0 th:TH_STORE_RT_NT
  flat_store_b32 v[0:1], v2 offset:0 th:TH_STORE_NT_HT
  flat_store_b32 v[0:1], v2 offset:0 th:TH_STORE_NT_WB
  flat_store_b32 v[0:1], v2 offset:0 scope:SCOPE_SYS th:TH_STORE_BYPASS
  flat_atomic_add_u32 v[0:1], v2 offset:0
  flat_atomic_add_u32 v[0:1], v2 offset:0 th:TH_ATOMIC_NT
  flat_atomic_add_u32 v[0:1], v2 offset:0 th:TH_ATOMIC_CASCADE_RT
  flat_atomic_add_u32 v[0:1], v2 offset:0 th:TH_ATOMIC_CASCADE_NT
  flat_atomic_add_u32 v3, v[0:1], v2 offset:0 th:TH_ATOMIC_RETURN
  flat_atomic_add_u32 v0, v[0:1], v2 offset:0 scope:SCOPE_DEV th:TH_ATOMIC_NT_RETURN
  s_endpgm

// ====

// The scalar offset can be a register or an encoded inline zero. LDS transfers
// keep their implicit m0 read in Low without printing it as a memory operand.
// RUN: emit amdgpu-assembly @buffer_address_forms strategy=source waits=none
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @buffer_address_forms(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %m0: reg<amdgpu.m0>) asm {
  %full = buffer_load_dword %resource, %address, %offset {offset = 4, glc = 1}
  %vector = buffer_load_u8_vaddr_offset %resource, %address {offset = 8, slc = 1}
  %scalar = buffer_load_dword_off_zero %resource {glc = 1, slc = 1}
  buffer_store_dword %full, %resource, %address, %offset {glc = 1}
  buffer_store_b8_vaddr_offset %vector, %resource, %address {slc = 1}
  buffer_store_dword_off_zero %scalar, %resource {glc = 1, slc = 1}
  buffer_load_lds_dword %resource, %address, %offset, %m0 {glc = 1}
  buffer_load_lds_dword_vaddr_offset %resource, %address, %m0 {slc = 1}
  buffer_load_lds_dword_off_zero %resource, %m0 {glc = 1, slc = 1}
  return
}
// ----
  buffer_load_dword v1, v0, s[4:7], s0 offen offset:4 glc
  buffer_load_ubyte v2, v0, s[4:7], 0 offen offset:8 slc
  buffer_load_dword v3, off, s[4:7], 0 offset:0 glc slc
  buffer_store_dword v1, v0, s[4:7], s0 offen offset:0 glc
  buffer_store_byte v2, v0, s[4:7], 0 offen offset:0 slc
  buffer_store_dword v3, off, s[4:7], 0 offset:0 glc slc
  buffer_load_dword v0, s[4:7], s0 offen offset:0 glc lds
  buffer_load_dword v0, s[4:7], 0 offen offset:0 slc lds
  buffer_load_dword off, s[4:7], 0 offset:0 glc slc lds
  s_endpgm

// ====

// A high-half write preserves the low half through an explicit Low operand,
// while native memory syntax contains just the shared physical destination.
// RUN: emit amdgpu-assembly @partial_loads strategy=source waits=none
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @partial_loads(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr x2>, %pointer: reg<amdgpu.vgpr x2>) asm {
  %buffer_low = buffer_load_d16_b16 %resource, %address, %offset {glc = 1}
  %buffer_full = buffer_load_d16_hi_b16 %buffer_low, %resource, %address, %offset {offset = 2, dlc = 1}
  %buffer_vector_low = buffer_load_d16_b16_vaddr_offset %resource, %address {slc = 1}
  %buffer_vector_full = buffer_load_d16_hi_b16_vaddr_offset %buffer_vector_low, %resource, %address {offset = 2, glc = 1}
  %global_low = global_load_d16_b16_saddr %address, %base {glc = 1}
  %global_full = global_load_d16_hi_b16_saddr %global_low, %address, %base {offset = 2, dlc = 1}
  %pointer_low = global_load_d16_b16_vaddr %pointer {slc = 1}
  %pointer_full = global_load_d16_hi_b16_vaddr %pointer_low, %pointer {offset = 2, glc = 1}
  return
}
// ----
  buffer_load_short_d16 v1, v0, s[4:7], s0 offen offset:0 glc
  buffer_load_short_d16_hi v1, v0, s[4:7], s0 offen offset:2 dlc
  buffer_load_short_d16 v1, v0, s[4:7], 0 offen offset:0 slc
  buffer_load_short_d16_hi v1, v0, s[4:7], 0 offen offset:2 glc
  global_load_short_d16 v1, v0, s[2:3] offset:0 glc
  global_load_short_d16_hi v1, v0, s[2:3] offset:2 dlc
  global_load_short_d16 v0, v[2:3], off offset:0 slc
  global_load_short_d16_hi v0, v[2:3], off offset:2 glc
  s_endpgm

// ====

// RDNA4 uses scope and temporal controls for ordinary buffer/global accesses,
// including the null scalar-offset form used after address legalization.
// RUN: emit amdgpu-assembly @scoped_address_forms strategy=source waits=none
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @scoped_address_forms(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr x2>, %pointer: reg<amdgpu.vgpr x2>) asm {
  %buffer_full = buffer_load_dword %resource, %address, %offset {scope = 2, th = 1}
  %buffer_vector = buffer_load_dword_vaddr_offset %resource, %address {offset = 4096, scope = 3, th = 3}
  buffer_store_dword %buffer_full, %resource, %address, %offset {scope = 2, th = 7}
  buffer_store_dword_vaddr_offset %buffer_vector, %resource, %address {offset = 4096, scope = 3, th = 3}
  %global_scalar = global_load_b32_saddr %address, %base {scope = 2, th = 3}
  %global_vector = global_load_b32_vaddr %pointer {scope = 3, th = 3}
  global_store_b32_saddr %address, %global_scalar, %base {scope = 2, th = 3}
  global_store_b32_vaddr %pointer, %global_vector {scope = 3, th = 3}
  return
}
// ----
  buffer_load_dword v1, v0, s[4:7], s0 offen offset:0 scope:SCOPE_DEV th:TH_LOAD_NT
  buffer_load_dword v4, v0, s[4:7], null offen offset:4096 scope:SCOPE_SYS th:TH_LOAD_BYPASS
  buffer_store_dword v1, v0, s[4:7], s0 offen offset:0 scope:SCOPE_DEV th:TH_STORE_NT_WB
  buffer_store_dword v4, v0, s[4:7], null offen offset:4096 scope:SCOPE_SYS th:TH_STORE_BYPASS
  global_load_b32 v1, v0, s[2:3] offset:0 scope:SCOPE_DEV th:TH_LOAD_LU
  global_load_b32 v4, v[2:3], off offset:0 scope:SCOPE_SYS th:TH_LOAD_BYPASS
  global_store_b32 v0, v1, s[2:3] offset:0 scope:SCOPE_DEV th:TH_STORE_WB
  global_store_b32 v[2:3], v4, off offset:0 scope:SCOPE_SYS th:TH_STORE_BYPASS
  s_endpgm
