// A long MFMA forwards through a short MFMA before the accumulator reaches an
// ordinary read on the loop backedge. Every lane supplies the same matrix data.
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @loop_windows(%lane: reg<amdgpu.vgpr>, %history: reg<amdgpu.sgpr x2>, %final: reg<amdgpu.sgpr x2>, %limit: reg<amdgpu.sgpr>) asm {
  %history_offset = v_lshlrev_b32_src0_inline %lane, 2
  %final_offset = v_lshlrev_b32_src0_inline %lane, 4
  %zero = v_mov_b32 0
  %lhs = v_mov_b32 1065353216
  %rhs = v_mov_b32 1073741824
  %initial = v_mov_b32 1077936128
  %stride = v_mov_b32 256
  %accumulator = concat(%initial, %initial, %initial, %initial) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %start = s_mov_b32 0
  %one = s_mov_b32 1
  low.br ^header(%accumulator: reg<amdgpu.vgpr x4>, %history_offset: reg<amdgpu.vgpr>, %start: reg<amdgpu.sgpr>)
^header(%carried: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %iteration: reg<amdgpu.sgpr>):
  %first = slice %carried[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %observed = v_add_f32 %first, %zero
  global_store_dword_saddr %address, %observed, %history
  %next_address = v_add_u32 %address, %stride
  %next_iteration = s_add_u32 %iteration, %one
  %again = s_cmp_lt_u32 %next_iteration, %limit
  %long = v_mfma_f32_16x16x4f32 %lhs, %rhs, %carried
  %short = v_mfma_f32_4x4x1f32 %lhs, %rhs, %long
  low.cond_br %again, ^backedge, ^done : reg<amdgpu.scc>
^backedge:
  low.br ^header(%short: reg<amdgpu.vgpr x4>, %next_address: reg<amdgpu.vgpr>, %next_iteration: reg<amdgpu.sgpr>)
^done:
  global_store_dwordx4_saddr %final_offset, %short, %final
  return
}

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @double_memory_window(%lane: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %offset = v_lshlrev_b32_src0_inline %lane, 3
  %zero = v_mov_b32 0
  %one_high = v_mov_b32 1072693248
  %two_high = v_mov_b32 1073741824
  %three_high = v_mov_b32 1074266112
  %lhs = concat(%zero, %one_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %rhs = concat(%zero, %two_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %accumulator = concat(%zero, %three_high, %zero, %three_high, %zero, %three_high, %zero, %three_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %result = v_mfma_f64_16x16x4f64 %lhs, %rhs, %accumulator
  %first = slice %result[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %offset, %first, %output
  return
}

kernel.def target(@target) @matrix_windows() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%history: buffer, %final: buffer, %double: buffer) {
  %lane_index = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane_index : index to i32
  %lane = vector.splat %lane_i32 : vector<1xi32>
  %iterations = scalar.constant 8 : i32
  low.invoke @loop_windows(%lane, %history, %final, %iterations) : (vector<1xi32>, buffer, buffer, i32)
  low.invoke @double_memory_window(%lane, %double) : (vector<1xi32>, buffer)
  kernel.return
}

func.def @matrix_windows_oracle(%history: buffer, %final: buffer, %double: buffer) {
  %base = index.constant 0 : offset
  %history_view = buffer.view %history[%base] : buffer -> view<8x64xf32>
  %final_view = buffer.view %final[%base] : buffer -> view<64x4xf32>
  %double_view = buffer.view %double[%base] : buffer -> view<64xf64>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 3.0 : f32
  %increment = scalar.constant 10.0 : f32
  %iterations = index.constant 8 : index
  %expected_double = scalar.constant 11.0 : f64
  %expected_final = scf.for %iteration = [%begin to %iterations step %step](%value = %initial : f32) -> (f32) {
    scf.for %lane = [%begin to %end step %step] {
      view.store %value, %history_view[%iteration, %lane] : f32, view<8x64xf32>
    }
    %next = scalar.addf %value, %increment : f32
    scf.yield %next : f32
  }
  scf.for %lane = [%begin to %end step %step] {
    view.store %expected_final, %final_view[%lane, 0] : f32, view<64x4xf32>
    view.store %expected_final, %final_view[%lane, 1] : f32, view<64x4xf32>
    view.store %expected_final, %final_view[%lane, 2] : f32, view<64x4xf32>
    view.store %expected_final, %final_view[%lane, 3] : f32, view<64x4xf32>
    view.store %expected_double, %double_view[%lane] : f64, view<64xf64>
  }
  func.return
}

check.scenario @physical_matrix_windows {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna2.core"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %history = check.generate.fill value(0.0) : tensor<8x64xf32>
    %final = check.generate.fill value(0.0) : tensor<64x4xf32>
    %double = check.generate.fill value(0.0) : tensor<64xf64>
    check.compare<@matrix_windows, @matrix_windows_oracle>(%history, %final, %double) : (tensor<8x64xf32>, tensor<64x4xf32>, tensor<64xf64>) -> () {
      check.expect.bitwise actual(%history) expected(%history) : tensor<8x64xf32>
      check.expect.bitwise actual(%final) expected(%final) : tensor<64x4xf32>
      check.expect.bitwise actual(%double) expected(%double) : tensor<64xf64>
    }
  }
  check.return
}
