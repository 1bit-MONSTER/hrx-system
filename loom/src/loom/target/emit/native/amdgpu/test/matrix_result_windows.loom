// A long MFMA forwards through a short MFMA before the accumulator reaches an
// ordinary read on the loop backedge. Every lane supplies the same matrix data.
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @loop_windows(%lane: reg<amdgpu.vgpr>, %history: reg<amdgpu.sgpr x2>, %final: reg<amdgpu.sgpr x2>, %limit: reg<amdgpu.sgpr>) asm {
  %history_offset = v_lshlrev_b32_src0_inline %lane, 2
  %final_offset = v_lshlrev_b32_src0_inline %lane, 4
  %zero = v_mov_b32 0
  %lhs = v_mov_b32 1065353216
  %rhs = v_mov_b32 1073741824
  %initial = v_mov_b32 1077936128
  %stride = v_mov_b32 256
  %accumulator = concat(%initial, %initial, %initial, %initial) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %start = s_mov_b32 0
  %one = s_mov_b32 1
  low.br ^header(%accumulator: reg<amdgpu.vgpr x4>, %history_offset: reg<amdgpu.vgpr>, %start: reg<amdgpu.sgpr>)
^header(%carried: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %iteration: reg<amdgpu.sgpr>):
  %first = slice %carried[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %observed = v_add_f32 %first, %zero
  global_store_dword_saddr %address, %observed, %history
  %next_address = v_add_u32 %address, %stride
  %next_iteration = s_add_u32 %iteration, %one
  %again = s_cmp_lt_u32 %next_iteration, %limit
  %long = v_mfma_f32_16x16x4f32 %lhs, %rhs, %carried
  %short = v_mfma_f32_4x4x1f32 %lhs, %rhs, %long
  low.cond_br %again, ^backedge, ^done : reg<amdgpu.scc>
^backedge:
  low.br ^header(%short: reg<amdgpu.vgpr x4>, %next_address: reg<amdgpu.vgpr>, %next_iteration: reg<amdgpu.sgpr>)
^done:
  global_store_dwordx4_saddr %final_offset, %short, %final
  return
}

// Independent FMA64 and VALU-to-memory dependencies exercise the DGEMM
// pipeline, while both matrix shapes retain their own result windows.
low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @double_pipeline_windows(%lane: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %offset = v_lshlrev_b32_src0_inline %lane, 5
  %zero = v_mov_b32 0
  %one_high = v_mov_b32 1072693248
  %two_high = v_mov_b32 1073741824
  %three_high = v_mov_b32 1074266112
  %lhs = concat(%zero, %one_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %rhs = concat(%zero, %two_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %accumulator = concat(%zero, %three_high, %zero, %three_high, %zero, %three_high, %zero, %three_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %result = v_mfma_f64_16x16x4f64 %lhs, %rhs, %accumulator
  %fma = v_fma_f64 %lhs, %rhs, %lhs
  global_store_dwordx2_saddr %offset, %fma, %output {offset = 8}
  %short_accumulator = copy %lhs : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr x2>
  %payload = v_add_f64 %lhs, %rhs
  %short = v_mfma_f64_4x4x4f64 %lhs, %rhs, %short_accumulator
  global_store_dwordx2_saddr %offset, %payload, %output {offset = 16}
  %first = slice %result[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %offset, %first, %output
  global_store_dwordx2_saddr %offset, %short, %output {offset = 24}
  return
}

// Direct memory access keeps the matrix accumulator in the AGPR bank across
// load, MFMA and store. Its partition must include the VGPR address and inputs.
low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @accumulator_storage(%lane: reg<amdgpu.vgpr>, %buffer: reg<amdgpu.sgpr x2>) asm {
  %offset = v_lshlrev_b32_src0_inline %lane, 4
  %base_low = slice %buffer[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_high = slice %buffer[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %address_low, %carry = v_add_co_u32 %base_low, %offset
  %high = v_mov_b32_copy %base_high
  %zero = v_mov_b32 0
  %address_high, %unused = v_addc_co_u32 %high, %zero, %carry
  %address = concat(%address_low, %address_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %accumulator = flat_load_dwordx4 %address : reg<amdgpu.agpr x4>
  %lhs = v_mov_b32 1067450368
  %rhs = v_mov_b32 1075838976
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %accumulator
  flat_store_dwordx4 %address, %result
  return
}

// Independent matrix results preserve their source accumulator. Ordinary
// writes may then reuse the dead source storage in either register bank.
low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @independent_accumulators(%lane: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %offset = v_lshlrev_b32_src0_inline %lane, 6
  %lhs = v_mov_b32 1065353216
  %rhs = v_mov_b32 1073741824
  %initial = v_mov_b32 1077936128
  %seed = concat(%initial, %initial, %initial, %initial) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  %first = slice %seed[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %observed = v_add_f32 %first, %rhs
  global_store_dword_saddr %offset, %observed, %output {offset = 16}
  global_store_dwordx4_saddr %offset, %result, %output
  %accumulator_initial_value = v_mov_b32 1077936128
  %accumulator_initial = v_accvgpr_write_b32 %accumulator_initial_value
  %accumulator_seed = concat(%accumulator_initial, %accumulator_initial, %accumulator_initial, %accumulator_initial) : (reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.agpr>) -> reg<amdgpu.agpr x4>
  %accumulator_result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %accumulator_seed : reg<amdgpu.agpr x4>
  %accumulator_first = slice %accumulator_seed[0] : reg<amdgpu.agpr x4> -> reg<amdgpu.agpr>
  %accumulator_observed = v_accvgpr_read_b32 %accumulator_first
  %replacement = v_accvgpr_write_b32_inline_i32 42
  %replacement_observed = v_accvgpr_read_b32 %replacement
  global_store_dword_saddr %offset, %accumulator_observed, %output {offset = 48}
  global_store_dword_saddr %offset, %replacement_observed, %output {offset = 52}
  global_store_dwordx4_saddr %offset, %accumulator_result, %output {offset = 32}
  return
}

kernel.def target(@target) @matrix_windows() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%history: buffer, %final: buffer, %double: buffer, %accumulator: buffer, %independent: buffer) {
  %lane_index = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane_index : index to i32
  %lane = vector.splat %lane_i32 : vector<1xi32>
  %iterations = scalar.constant 8 : i32
  low.invoke @loop_windows(%lane, %history, %final, %iterations) : (vector<1xi32>, buffer, buffer, i32)
  low.invoke @double_pipeline_windows(%lane, %double) : (vector<1xi32>, buffer)
  low.invoke @accumulator_storage(%lane, %accumulator) : (vector<1xi32>, buffer)
  low.invoke @independent_accumulators(%lane, %independent) : (vector<1xi32>, buffer)
  kernel.return
}

func.def @matrix_windows_oracle(%history: buffer, %final: buffer, %double: buffer, %accumulator: buffer, %independent: buffer) {
  %base = index.constant 0 : offset
  %history_view = buffer.view %history[%base] : buffer -> view<8x64xf32>
  %final_view = buffer.view %final[%base] : buffer -> view<64x4xf32>
  %double_view = buffer.view %double[%base] : buffer -> view<64x4xf64>
  %accumulator_view = buffer.view %accumulator[%base] : buffer -> view<64x4xf32>
  %independent_view = buffer.view %independent[%base] : buffer -> view<64x16xi32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 3.0 : f32
  %increment = scalar.constant 10.0 : f32
  %iterations = index.constant 8 : index
  %expected_double = scalar.constant 11.0 : f64
  %expected_fma = scalar.constant 3.0 : f64
  %expected_payload = scalar.constant 3.0 : f64
  %expected_short = scalar.constant 9.0 : f64
  %expected_accumulator = scalar.constant 15.5 : f32
  // Float bit patterns for 4 * (1 * 2) + 3, the observed seed plus 2, and 3.
  %expected_independent = scalar.constant 1093664768 : i32
  %expected_observed = scalar.constant 1084227584 : i32
  %expected_seed = scalar.constant 1077936128 : i32
  %expected_replacement = scalar.constant 42 : i32
  %expected_final = scf.for %iteration = [%begin to %iterations step %step](%value = %initial : f32) -> (f32) {
    scf.for %lane = [%begin to %end step %step] {
      view.store %value, %history_view[%iteration, %lane] : f32, view<8x64xf32>
    }
    %next = scalar.addf %value, %increment : f32
    scf.yield %next : f32
  }
  scf.for %lane = [%begin to %end step %step] {
    view.store %expected_final, %final_view[%lane, 0] : f32, view<64x4xf32>
    view.store %expected_final, %final_view[%lane, 1] : f32, view<64x4xf32>
    view.store %expected_final, %final_view[%lane, 2] : f32, view<64x4xf32>
    view.store %expected_final, %final_view[%lane, 3] : f32, view<64x4xf32>
    view.store %expected_double, %double_view[%lane, 0] : f64, view<64x4xf64>
    view.store %expected_fma, %double_view[%lane, 1] : f64, view<64x4xf64>
    view.store %expected_payload, %double_view[%lane, 2] : f64, view<64x4xf64>
    view.store %expected_short, %double_view[%lane, 3] : f64, view<64x4xf64>
    view.store %expected_accumulator, %accumulator_view[%lane, 0] : f32, view<64x4xf32>
    view.store %expected_accumulator, %accumulator_view[%lane, 1] : f32, view<64x4xf32>
    view.store %expected_accumulator, %accumulator_view[%lane, 2] : f32, view<64x4xf32>
    view.store %expected_accumulator, %accumulator_view[%lane, 3] : f32, view<64x4xf32>
    view.store %expected_independent, %independent_view[%lane, 0] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 1] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 2] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 3] : i32, view<64x16xi32>
    view.store %expected_observed, %independent_view[%lane, 4] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 8] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 9] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 10] : i32, view<64x16xi32>
    view.store %expected_independent, %independent_view[%lane, 11] : i32, view<64x16xi32>
    view.store %expected_seed, %independent_view[%lane, 12] : i32, view<64x16xi32>
    view.store %expected_replacement, %independent_view[%lane, 13] : i32, view<64x16xi32>
  }
  func.return
}

check.scenario @physical_matrix_windows {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna2.core"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %history = check.generate.fill value(0.0) : tensor<8x64xf32>
    %final = check.generate.fill value(0.0) : tensor<64x4xf32>
    %double = check.generate.fill value(0.0) : tensor<64x4xf64>
    %accumulator = check.generate.fill value(3.0) : tensor<64x4xf32>
    %independent = check.generate.fill value(0) : tensor<64x16xi32>
    check.compare<@matrix_windows, @matrix_windows_oracle>(%history, %final, %double, %accumulator, %independent) : (tensor<8x64xf32>, tensor<64x4xf32>, tensor<64x4xf64>, tensor<64x4xf32>, tensor<64x16xi32>) -> () {
      check.expect.bitwise actual(%history) expected(%history) : tensor<8x64xf32>
      check.expect.bitwise actual(%final) expected(%final) : tensor<64x4xf32>
      check.expect.bitwise actual(%double) expected(%double) : tensor<64x4xf64>
      check.expect.bitwise actual(%accumulator) expected(%accumulator) : tensor<64x4xf32>
      check.expect.bitwise actual(%independent) expected(%independent) : tensor<64x16xi32>
    }
  }
  check.return
}
