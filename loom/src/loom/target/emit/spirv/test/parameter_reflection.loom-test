// RUN: with-checks emit spirv-dis target=spirv:vulkan1.3+bda+extended-types input=source-low validate
// REQUIRES: spirv-dis, spirv-val

// Logical source order survives the split physical constant and binding tables.
kernel.def @mixed_parameter_reflection() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %flag: i1, %i8: i8, %i16: i16, %i32: i32, %f8e4: f8E4M3, %f8e5: f8E5M2, %f16: f16, %bf16: bf16, %f32: f32, %scratch: buffer, %i64: i64, %f64: f64, %index: index, %offset: offset, %output: buffer) {
  kernel.return
}

// ----
CHECK: OpModuleProcessed "iree.vulkan.bda.v1[mixed_parameter_reflection].constant_length=64"
CHECK: OpModuleProcessed "iree.vulkan.bda.v1[mixed_parameter_reflection].bindings=3"
CHECK: OpModuleProcessed "iree.vulkan.bda.parameters.v1[mixed_parameter_reflection]=b0;c0,1;c4,1;c8,2;c12,4;c16,1;c20,1;c24,2;c28,2;c32,4;b1;c36,8;c44,8;c52,4;c56,8;b2"

// ====

kernel.def @empty_parameter_reflection() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  kernel.return
}

// ----
CHECK: OpModuleProcessed "iree.vulkan.bda.v1[empty_parameter_reflection].constant_length=0"
CHECK: OpModuleProcessed "iree.vulkan.bda.v1[empty_parameter_reflection].bindings=0"
CHECK: OpModuleProcessed "iree.vulkan.bda.parameters.v1[empty_parameter_reflection]="
