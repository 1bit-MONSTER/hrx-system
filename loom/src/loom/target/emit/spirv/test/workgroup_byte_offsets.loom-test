// RUN: emit spirv-dis input=source-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target

func.def target(@target) @workgroup_byte_offset_i32(%value: i32, %byte_offset0: offset) -> (i32) {
  %byte_length = index.constant 128 : offset
  %byte_offset = index.assume %byte_offset0 [range(%byte_offset0, 0, 124), mul(%byte_offset0, 4)] : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%byte_offset] : buffer -> view<1xi32>
  view.store %value, %scratch_view[0] : i32, view<1xi32>
  %loaded = view.load %scratch_view[0] : view<1xi32> -> i32
  func.return %loaded : i32
}

// ----
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpExtension "SPV_KHR_vulkan_memory_model"
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpMemoryModel PhysicalStorageBuffer64 Vulkan
               OpEntryPoint GLCompute %workgroup_byte_offset_i32 "workgroup_byte_offset_i32"
               OpExecutionMode %workgroup_byte_offset_i32 LocalSize 1 1 1
               OpName %workgroup_byte_offset_i32 "workgroup_byte_offset_i32"
               OpName %value "value"
               OpName %byte_offset "byte_offset"
               OpName %scratch_view "scratch_view"
               OpName %loaded "loaded"
               OpMemberDecorate %_struct_5 0 Offset 0
               OpDecorate %_struct_5 Block
               OpDecorate %4 DescriptorSet 0
               OpDecorate %4 Binding 0
               OpMemberDecorate %_struct_10 0 Offset 0
               OpDecorate %_struct_10 Block
               OpDecorate %8 DescriptorSet 0
               OpDecorate %8 Binding 1
               OpDecorate %13 DescriptorSet 0
               OpDecorate %13 Binding 2
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
  %_struct_5 = OpTypeStruct %int
%_ptr_StorageBuffer__struct_5 = OpTypePointer StorageBuffer %_struct_5
%_ptr_StorageBuffer_int = OpTypePointer StorageBuffer %int
          %4 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
      %ulong = OpTypeInt 64 0
 %_struct_10 = OpTypeStruct %ulong
%_ptr_StorageBuffer__struct_10 = OpTypePointer StorageBuffer %_struct_10
%_ptr_StorageBuffer_ulong = OpTypePointer StorageBuffer %ulong
          %8 = OpVariable %_ptr_StorageBuffer__struct_10 StorageBuffer
         %13 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
       %void = OpTypeVoid
         %15 = OpTypeFunction %void
       %uint = OpTypeInt 32 0
    %uint_32 = OpConstant %uint 32
%_arr_int_uint_32 = OpTypeArray %int %uint_32
%_ptr_Workgroup__arr_int_uint_32 = OpTypePointer Workgroup %_arr_int_uint_32
%scratch_view = OpVariable %_ptr_Workgroup__arr_int_uint_32 Workgroup
    %ulong_2 = OpConstant %ulong 2
%_ptr_Workgroup_int = OpTypePointer Workgroup %int
%workgroup_byte_offset_i32 = OpFunction %void None %15
         %16 = OpLabel
         %17 = OpAccessChain %_ptr_StorageBuffer_int %4 %int_0
      %value = OpLoad %int %17 Aligned 4
         %19 = OpAccessChain %_ptr_StorageBuffer_ulong %8 %int_0
%byte_offset = OpLoad %ulong %19 Aligned 8
         %27 = OpShiftRightLogical %ulong %byte_offset %ulong_2
         %29 = OpAccessChain %_ptr_Workgroup_int %scratch_view %27
               OpStore %29 %value Aligned 4
     %loaded = OpLoad %int %29 Aligned 4
         %31 = OpAccessChain %_ptr_StorageBuffer_int %13 %int_0
               OpStore %31 %loaded Aligned 4
               OpReturn
               OpFunctionEnd

