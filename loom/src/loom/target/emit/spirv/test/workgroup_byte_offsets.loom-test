spirv.target<vulkan1_3> @target

func.def target(@target) @workgroup_byte_offset_i64(%value: i64, %byte_offset0: offset) -> (i64) {
  %byte_length = index.constant 256 : offset
  %byte_offset = index.assume %byte_offset0 [range(%byte_offset0, 0, 248), mul(%byte_offset0, 8)] : offset
  %scratch = buffer.alloca<workgroup> align(8) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%byte_offset] : buffer -> view<1xi64>
  view.store %value, %scratch_view[0] : i64, view<1xi64>
  %loaded = view.load %scratch_view[0] : view<1xi64> -> i64
  func.return %loaded : i64
}

