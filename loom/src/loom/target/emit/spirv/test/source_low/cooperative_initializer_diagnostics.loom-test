// RUN: emit spirv-dis input=source-low control-flow=structured-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,COOPERATIVE_MATRIX_KHR validate
// REQUIRES: spirv-dis, spirv-val

kernel.def @varying_initializer() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %size = index.constant 16 : index
  %unit = index.constant 1 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xf32>
  %a_values = vector.constant -2.0 : vector<4xf16>
  %b_values = vector.constant 3.0 : vector<4xf16>
  %lhs = vector.fragment<lhs> %a_values shape [%size, %size] : vector<4xf16>
  %rhs = vector.fragment<rhs> %b_values shape [%size, %size] : vector<4xf16>
  %lane = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane : index to i32
  %scalar = scalar.sitofp %lane_i32 : i32 to f32
  %values = vector.splat %scalar : vector<4xf32>
  %init = vector.fragment<init> %values shape [%size, %size] : vector<4xf32>
  // ERROR@+1: SPIRV/013 {function_name="varying_initializer", descriptor_key="spirv.op_cooperative_matrix_mul_add_khr.f16.m16n16k16.f32.subgroup", field_kind="operand", field_index="2", value_name="init", expected_value_type="cooperative_matrix", actual_value_type="v4f32"}
  %result = vector.mma %lhs, %rhs, %init : vector<4xf16>, vector<4xf16>, vector<4xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%size, %size] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

// ====

// RUN: emit spirv-dis input=source-low control-flow=structured-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,COOPERATIVE_MATRIX_KHR validate
// REQUIRES: spirv-dis, spirv-val

kernel.def @divergent_initializer() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %offset = index.constant 0 : offset
  %size = index.constant 16 : index
  %first_lane = index.constant 0 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %view = buffer.view %aligned[%offset] : buffer -> view<16x16xf32>
  %a_values = vector.constant -2.0 : vector<4xf16>
  %b_values = vector.constant 3.0 : vector<4xf16>
  %lhs = vector.fragment<lhs> %a_values shape [%size, %size] : vector<4xf16>
  %rhs = vector.fragment<rhs> %b_values shape [%size, %size] : vector<4xf16>
  %thread = kernel.workitem.id<x> : index
  %writer = index.cmp eq, %thread, %first_lane : index
  %value = scf.if %writer -> (vector<4xf32>) {
    %then_values = vector.constant 1.0 : vector<4xf32>
    %fragment = vector.fragment<init> %then_values shape [%size, %size] : vector<4xf32>
    scf.yield %fragment : vector<4xf32>
  } else {
    %else_values = vector.constant 2.0 : vector<4xf32>
    %fragment = vector.fragment<init> %else_values shape [%size, %size] : vector<4xf32>
    scf.yield %fragment : vector<4xf32>
  }
  // ERROR@+1: SPIRV/013 {function_name="divergent_initializer", descriptor_key="spirv.op_cooperative_matrix_mul_add_khr.f16.m16n16k16.f32.subgroup", field_kind="operand", field_index="2", value_name="value", expected_value_type="cooperative_matrix", actual_value_type="v4f32"}
  %result = vector.mma %lhs, %rhs, %value : vector<4xf16>, vector<4xf16>, vector<4xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%size, %size] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

