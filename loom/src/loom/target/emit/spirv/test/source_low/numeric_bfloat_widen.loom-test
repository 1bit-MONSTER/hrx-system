// RUN: emit spirv-dis input=source-low target=spirv:vulkan1.3+bda+extended-types validate
// REQUIRES: spirv-dis, spirv-val

// Conversion consumes the captured value, even when its source is overwritten.
func.def @replace_bfloat(%input: buffer, %replacement: bf16) -> (f32, f32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xbf16>
  %before = view.load %source[0] : view<1xbf16> -> bf16
  view.store %replacement, %source[0] : bf16, view<1xbf16>
  %after = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  %before_wide = scalar.extf %before : bf16 to f32
  %after_wide = scalar.extf %after : bf16 to f32
  func.return %before_wide, %after_wide : f32, f32
}

// ----
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpCapability Float16
               OpCapability Float64
               OpCapability Int8
               OpCapability Int16
               OpCapability StorageBuffer8BitAccess
               OpCapability StorageBuffer16BitAccess
               OpCapability BFloat16TypeKHR
               OpCapability DenormPreserve
               OpExtension "SPV_KHR_vulkan_memory_model"
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpExtension "SPV_KHR_8bit_storage"
               OpExtension "SPV_KHR_16bit_storage"
               OpExtension "SPV_KHR_bfloat16"
               OpExtension "SPV_KHR_float_controls"
               OpMemoryModel PhysicalStorageBuffer64 Vulkan
               OpEntryPoint GLCompute %replace_bfloat "replace_bfloat"
               OpExecutionMode %replace_bfloat LocalSize 1 1 1
               OpExecutionMode %replace_bfloat DenormPreserve 32
               OpName %replace_bfloat "replace_bfloat"
               OpName %input "input"
               OpName %replacement "replacement"
               OpName %before "before"
               OpName %after "after"
               OpName %before_wide "before_wide"
               OpName %after_wide "after_wide"
               OpMemberDecorate %_struct_6 0 Offset 0
               OpDecorate %_struct_6 Block
               OpDecorate %4 DescriptorSet 0
               OpDecorate %4 Binding 0
               OpMemberDecorate %_struct_11 0 Offset 0
               OpDecorate %_struct_11 Block
               OpDecorate %9 DescriptorSet 0
               OpDecorate %9 Binding 1
               OpMemberDecorate %_struct_16 0 Offset 0
               OpDecorate %_struct_16 Block
               OpDecorate %14 DescriptorSet 0
               OpDecorate %14 Binding 2
               OpDecorate %19 DescriptorSet 0
               OpDecorate %19 Binding 3
               OpDecorate %_ptr_PhysicalStorageBuffer_bfloat16 ArrayStride 2
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
      %ulong = OpTypeInt 64 0
  %_struct_6 = OpTypeStruct %ulong
%_ptr_StorageBuffer__struct_6 = OpTypePointer StorageBuffer %_struct_6
%_ptr_StorageBuffer_ulong = OpTypePointer StorageBuffer %ulong
          %4 = OpVariable %_ptr_StorageBuffer__struct_6 StorageBuffer
   %bfloat16 = OpTypeFloat 16 BFloat16KHR
 %_struct_11 = OpTypeStruct %bfloat16
%_ptr_StorageBuffer__struct_11 = OpTypePointer StorageBuffer %_struct_11
%_ptr_StorageBuffer_bfloat16 = OpTypePointer StorageBuffer %bfloat16
          %9 = OpVariable %_ptr_StorageBuffer__struct_11 StorageBuffer
      %float = OpTypeFloat 32
 %_struct_16 = OpTypeStruct %float
%_ptr_StorageBuffer__struct_16 = OpTypePointer StorageBuffer %_struct_16
%_ptr_StorageBuffer_float = OpTypePointer StorageBuffer %float
         %14 = OpVariable %_ptr_StorageBuffer__struct_16 StorageBuffer
         %19 = OpVariable %_ptr_StorageBuffer__struct_16 StorageBuffer
       %void = OpTypeVoid
         %21 = OpTypeFunction %void
    %ulong_0 = OpConstant %ulong 0
%_ptr_PhysicalStorageBuffer_bfloat16 = OpTypePointer PhysicalStorageBuffer %bfloat16
%replace_bfloat = OpFunction %void None %21
         %22 = OpLabel
         %23 = OpAccessChain %_ptr_StorageBuffer_ulong %4 %int_0
      %input = OpLoad %ulong %23 Aligned 8
         %25 = OpAccessChain %_ptr_StorageBuffer_bfloat16 %9 %int_0
%replacement = OpLoad %bfloat16 %25 Aligned 2
         %28 = OpIAdd %ulong %input %ulong_0
         %30 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_bfloat16 %28
     %before = OpLoad %bfloat16 %30 Aligned 2
               OpStore %30 %replacement Aligned 2
      %after = OpLoad %bfloat16 %30 Volatile|Aligned 2
%before_wide = OpFConvert %float %before
 %after_wide = OpFConvert %float %after
         %35 = OpAccessChain %_ptr_StorageBuffer_float %14 %int_0
               OpStore %35 %before_wide Aligned 4
         %36 = OpAccessChain %_ptr_StorageBuffer_float %19 %int_0
               OpStore %36 %after_wide Aligned 4
               OpReturn
               OpFunctionEnd
