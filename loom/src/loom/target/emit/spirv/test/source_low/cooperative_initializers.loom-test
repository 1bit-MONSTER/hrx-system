  %result = vector.mma %lhs, %rhs, %init : vector<1xf16>, vector<1xf16>, vector<1xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<1xf32>, view<16x16xf32>
  kernel.return
}

