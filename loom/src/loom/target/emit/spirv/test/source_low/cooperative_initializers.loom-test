  %acc_schema = encoding.define #encoding.operand<element_format=u32, payload_elements=8, payload_registers=8> : encoding<schema>
  %output_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=u32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xi32, %output_storage>
  %a_values = vector.splat %a : vector<8xi8>
  %b_values = vector.splat %b : vector<8xi8>
  %c_values = vector.splat %c : vector<8xi32>
  %lhs = vector.fragment<lhs> %a_values shape [blocks(%unit), %m, %k] using {schema = %input_schema : encoding<schema>} : vector<8xi8>
  %rhs = vector.fragment<rhs> %b_values shape [blocks(%unit), %k, %m] using {schema = %input_schema : encoding<schema>} : vector<8xi8>
  %init = vector.fragment<init> %c_values shape [blocks(%unit), %m, %m] using {schema = %acc_schema : encoding<schema>} : vector<8xi32>
  %result = vector.mma %lhs, %rhs, %init : vector<8xi8>, vector<8xi8>, vector<8xi32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<8xi32>, view<16x16xi32, %output_storage>
  kernel.return
}

