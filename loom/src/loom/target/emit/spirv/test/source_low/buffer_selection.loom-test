// TEMPLATE: loom/src/loom/test/corpus/source_low/buffer_selection.loom-test
// RUN: emit spirv-dis input=source-low target=spirv:vulkan1.3+bda+extended-types control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

// A selected reference retains the ordinary buffer result ABI.
// ERROR@+1: SPIRV/016 {function_name="choose_buffer", value_name="<unnamed>", actual_value_type="storage_buffer_address"}
func.def @choose_buffer(%first: buffer, %second: buffer, %choose_first: i1) -> (buffer) {
  %selected = scf.select %choose_first, %first, %second : buffer
  func.return %selected : buffer
}

// ====

// A selected reference remains a buffer for both reads and writes.
func.def @exchange_selected_byte(%first: buffer, %second: buffer, %choose_first: i1, %position_input: offset, %replacement: i32) -> (i32) {
  %position = index.assume %position_input [range(%position_input, 0, 1024)] : offset
  %selected = scf.select %choose_first, %first, %second : buffer
  %previous = buffer.load.i8.u %selected[%position]
  buffer.store.i8 %replacement, %selected[%position]
  func.return %previous : i32
}

