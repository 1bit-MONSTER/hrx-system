// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// The used value keeps its signature ordinal when unused parameters surround
// it and require different Wasm carrier classes.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @sparse_parameters(%unused: reg<wasm.i64>, %used: reg<wasm.i32>, %trailing: reg<wasm.f64>) -> (reg<wasm.i32>) asm {
  return %used
}

