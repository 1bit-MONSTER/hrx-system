// ====

// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// Parallel moves must preserve both final results on the zero-trip path and
// every ordinary backedge. Wasm multi-value returns expose the pair directly.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @for_swap(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %left: reg<wasm.i32>, %right: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %result_left, %result_right = low.scf.for signed [%lower to %upper step %step] iter_args(%left: reg<wasm.i32>, %right: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) do(%iv: reg<wasm.i32>, %a: reg<wasm.i32>, %b: reg<wasm.i32>) {
    low.scf.yield %b, %a : reg<wasm.i32>, reg<wasm.i32>
  }
  return %result_left, %result_right
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @while_swap(%condition: reg<wasm.i32>, %left: reg<wasm.i32>, %right: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %false = i32.const 0
  %ignored_condition, %result_left, %result_right = low.scf.while(%before_condition = %condition : reg<wasm.i32>, %before_left = %left : reg<wasm.i32>, %before_right = %right : reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) {
    low.scf.condition %before_condition, %before_condition, %before_left, %before_right : reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>
  } do(%body_condition: reg<wasm.i32>, %body_left: reg<wasm.i32>, %body_right: reg<wasm.i32>) {
    low.scf.yield %false, %body_right, %body_left : reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>
  }
  return %result_left, %result_right
}

