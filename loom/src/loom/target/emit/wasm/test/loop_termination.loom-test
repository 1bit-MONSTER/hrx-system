// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// The emitter computes a wrap-safe terminal threshold for both signed and
// unsigned loop domains. Ordered hashes expose a wrong induction value, an
// extra iteration, or a lost final carried value.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @signed_hash(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %multiplier = i32.const 33
  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%seed: reg<wasm.i32>) -> (reg<wasm.i32>) do(%iv: reg<wasm.i32>, %hash: reg<wasm.i32>) {
    %scaled = i32.mul %hash, %multiplier
    %next = i32.add %scaled, %iv
    low.scf.yield %next : reg<wasm.i32>
  }
  return %result
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @unsigned_hash(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %multiplier = i32.const 33
  %result = low.scf.for unsigned [%lower to %upper step %step] iter_args(%seed: reg<wasm.i32>) -> (reg<wasm.i32>) do(%iv: reg<wasm.i32>, %hash: reg<wasm.i32>) {
    %scaled = i32.mul %hash, %multiplier
    %next = i32.add %scaled, %iv
    low.scf.yield %next : reg<wasm.i32>
  }
  return %result
}

