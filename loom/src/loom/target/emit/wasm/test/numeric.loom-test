// RUN: with-checks emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @remainder32(%lhs: reg<wasm.i32>, %rhs: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %remainder = i32.rem_u %lhs, %rhs
  return %remainder
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @remainder64(%lhs: reg<wasm.i64>, %rhs: reg<wasm.i64>) -> (reg<wasm.i64>) asm {
  %remainder = i64.rem_u %lhs, %rhs
  return %remainder
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @division32(%lhs: reg<wasm.i32>, %rhs: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) asm {
  %signed_quotient = i32.div_s %lhs, %rhs
  %unsigned_quotient = i32.div_u %lhs, %rhs
  %signed_remainder = i32.rem_s %lhs, %rhs
  %unsigned_remainder = i32.rem_u %lhs, %rhs
  return %signed_quotient, %unsigned_quotient, %signed_remainder, %unsigned_remainder
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @division64(%lhs: reg<wasm.i64>, %rhs: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>) asm {
  %signed_quotient = i64.div_s %lhs, %rhs
  %unsigned_quotient = i64.div_u %lhs, %rhs
  %signed_remainder = i64.rem_s %lhs, %rhs
  %unsigned_remainder = i64.rem_u %lhs, %rhs
  return %signed_quotient, %unsigned_quotient, %signed_remainder, %unsigned_remainder
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @arithmetic32(%lhs: reg<wasm.i32>, %rhs: reg<wasm.i32>, %count: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) asm {
  %add = i32.add %lhs, %rhs
  %sub = i32.sub %lhs, %rhs
  %mul = i32.mul %lhs, %rhs
  %and = i32.and %lhs, %rhs
  %or = i32.or %lhs, %rhs
  %xor = i32.xor %lhs, %rhs
  %shl = i32.shl %lhs, %count
  %shr_s = i32.shr_s %lhs, %count
  %shr_u = i32.shr_u %lhs, %count
  return %add, %sub, %mul, %and, %or, %xor, %shl, %shr_s, %shr_u
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @compare32(%lhs: reg<wasm.i32>, %rhs: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) asm {
  %eq = i32.eq %lhs, %rhs
  %ne = i32.ne %lhs, %rhs
  %lt_s = i32.lt_s %lhs, %rhs
  %lt_u = i32.lt_u %lhs, %rhs
  %gt_s = i32.gt_s %lhs, %rhs
  %gt_u = i32.gt_u %lhs, %rhs
  %le_s = i32.le_s %lhs, %rhs
  %le_u = i32.le_u %lhs, %rhs
  %ge_s = i32.ge_s %lhs, %rhs
  %ge_u = i32.ge_u %lhs, %rhs
  return %eq, %ne, %lt_s, %lt_u, %gt_s, %gt_u, %le_s, %le_u, %ge_s, %ge_u
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @arithmetic64(%lhs: reg<wasm.i64>, %rhs: reg<wasm.i64>, %count: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>) asm {
