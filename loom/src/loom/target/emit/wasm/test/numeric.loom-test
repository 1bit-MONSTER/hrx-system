low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @arithmetic_f32(%lhs: reg<wasm.f32>, %rhs: reg<wasm.f32>) -> (reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>) asm {
  %add = f32.add %lhs, %rhs
  %sub = f32.sub %lhs, %rhs
  %mul = f32.mul %lhs, %rhs
  %div = f32.div %lhs, %rhs
  %min = f32.min %lhs, %rhs
  %max = f32.max %lhs, %rhs
  %copysign = f32.copysign %lhs, %rhs
  return %add, %sub, %mul, %div, %min, %max, %copysign
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @unary_f32(%input: reg<wasm.f32>) -> (reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>) asm {
  %abs = f32.abs %input
  %neg = f32.neg %input
  %ceil = f32.ceil %input
  %floor = f32.floor %input
  %trunc = f32.trunc %input
  %nearest = f32.nearest %input
  %sqrt = f32.sqrt %input
  return %abs, %neg, %ceil, %floor, %trunc, %nearest, %sqrt
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @compare_f32(%lhs: reg<wasm.f32>, %rhs: reg<wasm.f32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) asm {
