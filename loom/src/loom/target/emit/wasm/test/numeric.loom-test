low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @unary_f32x4(%input: reg<wasm.v128>) -> (reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>) asm {
