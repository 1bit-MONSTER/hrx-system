low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @lanes_i32(%first: reg<wasm.i32>, %last: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %splat = i32x4.splat %first
  %inserted = i32x4.replace_lane %splat, %last, 3
  %low = i32x4.extract_lane %inserted, 0
  %high = i32x4.extract_lane %inserted, 3
  return %low, %high
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @select_i32(%condition: reg<wasm.i32>, %yes: reg<wasm.i32>, %no: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %result = i32.select %yes, %no, %condition
  return %result
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @lanes_i64(%first: reg<wasm.i64>, %last: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>) asm {
  %splat = i64x2.splat %first
  %inserted = i64x2.replace_lane %splat, %last, 1
  %low = i64x2.extract_lane %inserted, 0
  %high = i64x2.extract_lane %inserted, 1
  return %low, %high
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @select_i64(%condition: reg<wasm.i32>, %yes: reg<wasm.i64>, %no: reg<wasm.i64>) -> (reg<wasm.i64>) asm {
  %result = i64.select %yes, %no, %condition
  return %result
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @lanes_f32(%first: reg<wasm.f32>, %last: reg<wasm.f32>) -> (reg<wasm.f32>, reg<wasm.f32>) asm {
  %splat = f32x4.splat %first
  %inserted = f32x4.replace_lane %splat, %last, 3
  %low = f32x4.extract_lane %inserted, 0
  %high = f32x4.extract_lane %inserted, 3
  return %low, %high
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @select_f32(%condition: reg<wasm.i32>, %yes: reg<wasm.f32>, %no: reg<wasm.f32>) -> (reg<wasm.f32>) asm {
  %result = f32.select %yes, %no, %condition
  return %result
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @lanes_f64(%first: reg<wasm.f64>, %last: reg<wasm.f64>) -> (reg<wasm.f64>, reg<wasm.f64>) asm {
  %splat = f64x2.splat %first
  %inserted = f64x2.replace_lane %splat, %last, 1
  %low = f64x2.extract_lane %inserted, 0
  %high = f64x2.extract_lane %inserted, 1
