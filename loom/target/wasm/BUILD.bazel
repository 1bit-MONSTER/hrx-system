load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_target_profile",
    "loom_target_set",
)

package(default_visibility = ["//visibility:public"])

_WASM_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:wasm_artifacts",
])

loom_target_profile(
    name = "simd128",
    family = "wasm",
    selector = "simd128",
    target_compatible_with = _WASM_ARTIFACTS_COMPATIBLE_WITH,
)

loom_target_set(
    name = "all",
    allow_empty = True,
    targets = select({
        "//loom/config/target:wasm_artifacts": [":simd128"],
        "//conditions:default": [],
    }),
)
