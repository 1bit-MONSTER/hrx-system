load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load(
    "//loom/target/amdgpu:execution_profiles.bzl",
    "AMDGPU_ACCESS_PROFILE",
    "AMDGPU_HARDWARE_PROFILE",
)

package(default_visibility = ["//visibility:public"])

loom_test(
    name = "pipelined_address_domains_test",
    srcs = ["//loom/src/loom/test/corpus/control:pipelined_address_domains.loom"],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "word_test",
    srcs = ["//loom/src/loom/test/corpus/memory:word.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)
