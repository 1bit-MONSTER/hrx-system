    execution_profiles = [SPIRV_VULKAN_HARDWARE_PROFILE],
)

loom_test(
    name = "predicate_truncation_test",
    srcs = ["//loom/src/loom/test/corpus/numeric:predicate/truncation.loom"],
    execution_profiles = [SPIRV_VULKAN_HARDWARE_PROFILE],
)

loom_test(
    name = "subgroup_ballot_test",
    srcs = ["//loom/src/loom/test/corpus/kernel:subgroup/ballot.loom"],
    compile_targets = ["//loom/target/spirv:vulkan1.3+bda+subgroup32+ballot+hal"],
