load("//loom/build_tools/bazel:defs.bzl", "loom_corpus_build", "loom_corpus_test")
load("//loom/src/loom/test/corpus:catalog.bzl", "LOOM_CORPUS")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(default_visibility = ["//visibility:public"])

_KERNEL_SOURCES = [
    "control/branch/cfg.loom",
    "control/branch/effects.loom",
    "control/branch/guards.loom",
    "control/branch/results.loom",
    "control/branch/uniform_predicate.loom",
    "control/loop/callable.loom",
    "control/loop/carried_lane_liveness.loom",
    "control/loop/condition.loom",
    "control/loop/count.loom",
    "control/loop/rotation/offsets.loom",
    "control/loop/rotation/values.loom",
    "control/loop/rotation/views.loom",
    "control/loop/sequential_slices.loom",
    "control/loop/termination.loom",
    "control/loop/wide_index_recurrence.loom",
    "control/schedule/ordered_read_ahead.loom",
    "control/schedule/unroll_scope.loom",
    "kernel/subgroup/active_predicate.loom",
    "kernel/subgroup/ballot.loom",
    "kernel/subgroup/shuffle_dynamic.loom",
    "kernel/subgroup/shuffle_participation.loom",
    "kernel/subgroup/transport.loom",
    "kernel/subgroup/transport_carrier.loom",
    "kernel/workgroup/loop_state.loom",
    "kernel/workgroup/reduce_partial.loom",
    "kernel/workgroup/reduce_tree.loom",
]

_NO_KERNEL_ARTIFACT_EXCLUDES = {
    source: "VM has no kernel artifact format."
    for source in _KERNEL_SOURCES
}

loom_corpus_build(
    name = "all",
    catalog = LOOM_CORPUS,
    excludes = {"//loom/target/vm:all": _NO_KERNEL_ARTIFACT_EXCLUDES},
    profiles = ["//loom/target/vm:all"],
)

loom_corpus_test(
    name = "execution",
    catalog = LOOM_CORPUS,
    excludes = _NO_KERNEL_ARTIFACT_EXCLUDES,
    execution_profiles = [VM_REFERENCE_PROFILE],
)
