load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//loom/build_tools/bazel:defs.bzl", "loom_target_set")

package(default_visibility = ["//visibility:public"])

exports_files(["execution_profiles.bzl"])

loom_target_set(
    name = "all",
    allow_empty = True,
    targets = [
        "//loom/target/amdgpu:all",
        "//loom/target/spirv:all",
        "//loom/target/vm:all",
        "//loom/target/wasm:all",
    ],
)

iree_cmake_extra_content(
    content = """
set(IREE_PACKAGE_ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
set(IREE_PACKAGE_ROOT_PREFIX "loom/target")
""",
)
