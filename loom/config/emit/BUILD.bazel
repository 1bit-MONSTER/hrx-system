load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")

package(default_visibility = ["//visibility:public"])

# Advanced artifact-family slices. Public //loom/config/target values imply the
# emitters required for that target.
DEFAULT_ENABLED = []

SUPPORTED_VALUES = [
    "amdgpu",
    "spirv",
    "wasm",
    "xdna",
    "x86",
]

iree_string_list_flag(
    name = "enable",
    build_setting_default = DEFAULT_ENABLED,
    values = SUPPORTED_VALUES,
)

[
    config_setting(
        name = "explicit_" + value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in SUPPORTED_VALUES
]

[
    selects.config_setting_group(
        name = value,
        match_any = [
            "//loom/config/target:" + value,
            ":explicit_" + value,
        ],
    )
    for value in [
        "amdgpu",
        "spirv",
        "wasm",
        "xdna",
        "x86",
    ]
]
