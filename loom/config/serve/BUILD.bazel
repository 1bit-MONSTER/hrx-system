# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "image_input",
    build_setting_default = True,
)

iree_string_list_flag(
    name = "image_codecs",
    build_setting_default = [
        "png",
        "jpeg",
        "gif",
        "webp",
    ],
    values = [
        "png",
        "jpeg",
        "gif",
        "webp",
    ],
)

config_setting(
    name = "image_input_requested",
    flag_values = {":image_input": "true"},
)

[
    config_setting(
        name = "media_host_" + os,
        constraint_values = ["@platforms//os:" + os],
    )
    for os in [
        "linux",
        "osx",
        "windows",
    ]
]

selects.config_setting_group(
    name = "media_host",
    match_any = [
        ":media_host_linux",
        ":media_host_osx",
        ":media_host_windows",
    ],
)

selects.config_setting_group(
    name = "image_input_enabled",
    match_all = [
        ":image_input_requested",
        ":media_host",
        "//loom/config/target/arch:vm",
    ],
)

[
    config_setting(
        name = codec + "_requested",
        flag_values = {":image_codecs": codec},
    )
    for codec in [
        "png",
        "jpeg",
        "gif",
        "webp",
    ]
]

[
    selects.config_setting_group(
        name = codec,
        match_all = [
            ":image_input_enabled",
            ":" + codec + "_requested",
        ],
    )
    for codec in [
        "png",
        "jpeg",
        "gif",
        "webp",
    ]
]

# Encoded audio is optional; raw PCM input has no codec dependency.
iree_string_list_flag(
    name = "audio_codecs",
    build_setting_default = [
        "wav",
        "mp3",
        "flac",
    ],
    values = [
        "wav",
        "mp3",
        "flac",
    ],
)

[
    config_setting(
        name = codec + "_requested",
        flag_values = {":audio_codecs": codec},
    )
    for codec in [
        "wav",
        "mp3",
        "flac",
    ]
]

[
    selects.config_setting_group(
        name = codec,
        match_all = [
            ":media_host",
            "//loom/config/target/arch:vm",
            ":" + codec + "_requested",
        ],
    )
    for codec in [
        "wav",
        "mp3",
        "flac",
    ]
]

selects.config_setting_group(
    name = "audio_decoding",
    match_any = [
        ":wav",
        ":mp3",
        ":flac",
    ],
)
