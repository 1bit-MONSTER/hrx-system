# bazel-to-cmake: skip

load("//build_tools/bazel:python.bzl", "iree_py_test")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(
    ["requirements.lock.txt"],
    visibility = ["//build_tools/devtools:__pkg__"],
)

filegroup(
    name = "source_pages",
    srcs = glob(["src/**/*.md"]),
    tags = ["skip-bazel_to_cmake"],
    visibility = ["//loom/py/loom/gen/docs:__pkg__"],
)

iree_py_test(
    name = "site_test",
    srcs = ["site_test.py"],
    data = ["src/stylesheets/extra.css"],
    tags = ["skip-bazel_to_cmake"],
)

iree_py_test(
    name = "prepare_test",
    srcs = [
        "hooks/prepare.py",
        "hooks/prepare_test.py",
    ],
    imports = ["hooks"],
    main = "hooks/prepare_test.py",
    tags = ["skip-bazel_to_cmake"],
    deps = ["//loom/py/loom/gen/docs:reference"],
)
