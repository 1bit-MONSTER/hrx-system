# bazel-to-cmake: skip

load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":checks.bzl", "loom_template_freshness")

package(default_visibility = ["//visibility:public"])

exports_files(["source_inventory.py"])

py_binary(
    name = "check",
    srcs = ["check.py"],
    python_version = "PY3",
    deps = ["//build_tools/devtools:command_line"],
)

py_test(
    name = "source_inventory_test",
    size = "small",
    srcs = [
        "source_inventory.py",
        "source_inventory_test.py",
    ],
    imports = ["."],
    tags = ["manual"],
)

py_test(
    name = "check_test",
    size = "small",
    srcs = ["check_test.py"],
    args = [
        "$(rlocationpath :check)",
        "$(rlocationpath //loom/src/loom/tools/loom-check:loom-check-test)",
    ],
    data = [
        ":check",
        "//loom/src/loom/tools/loom-check:loom-check-test",
    ],
    tags = ["manual"],
    deps = ["@rules_python//python/runfiles"],
)

test_suite(
    name = "presubmit_tests",
    tags = ["manual"],
    tests = [
        ":check_test",
        ":source_inventory_test",
    ],
)

loom_template_freshness(
    name = "template_freshness",
    testonly = True,
    srcs = ["@loom_hygiene_sources//:sources"],
    manifest = "@loom_hygiene_sources//:sources.json",
    tags = ["manual"],
)
