func.def @supported() -> (i32) {
  %value = scalar.constant 42 : i32
  func.return %value : i32
}

func.def @unsupported() -> (i32) {
  %value = scalar.constant 72 : i32
  func.return %value : i32
}

check.case @fixture_cases {
  %supported = func.call @supported() : () -> (i32)
  %supported_expected = check.literal value(42) : i32
  check.expect.equal actual(%supported) expected(%supported_expected) : i32
  %unsupported = func.call @unsupported() : () -> (i32)
  %unsupported_expected = check.literal value(72) : i32
  check.expect.equal actual(%unsupported) expected(%unsupported_expected) : i32
  check.return
}
