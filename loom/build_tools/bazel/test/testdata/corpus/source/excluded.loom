func.def @excluded() -> (i32) {
  %value = scalar.constant 0 : i32
  func.return %value : i32
}

check.scenario @excluded_scenario {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.compare<@excluded>() : () -> [actual(%actual: i32), expected(%expected: i32)] {
      check.expect.equal actual(%actual) expected(%expected) : i32
    }
  }
  check.return
}
