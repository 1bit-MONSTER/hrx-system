load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:x86",
])

loom_cc_library(
    name = "x86",
    srcs = ["x86.c"],
    hdrs = ["//loom/binding/c:include/loomc/target/x86.h"],
    linkstatic = True,
    target_compatible_with = _X86_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/target/arch/x86:compiler_provider",
    ],
    alwayslink = True,
)

iree_assert_dependency_boundary(
    name = "x86_has_no_tooling_target_dependencies",
    forbidden_subtrees = ["//loom/src/loom/tooling/target/..."],
    message = "The LoomC x86 target package must compose compiler-owned target emission without tooling target adapters",
    target = ":x86",
)

loom_cc_test(
    name = "x86_test",
    srcs = ["x86_test.cc"],
    target_compatible_with = _X86_COMPATIBLE_WITH,
    deps = [
        ":x86",
        "//loom/binding/c:loomc",
        "//loom/src/loom/target/arch/x86:compiler_provider",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
