load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/import/cxx:embed_includes_enabled",
    "//loom/config/emit:amdgpu",
])

iree_c_embed_data(
    name = "kernels",
    testonly = True,
    srcs = [
        "//loom/src/loom/import/cxx/test:aiter_swiglu_f16.cxx",
        "//loom/src/loom/import/cxx/test:flash_attention.cxx",
        "//loom/src/loom/import/cxx/test:llama_rms_norm.cxx",
        "//loom/src/loom/import/cxx/test:mxfp_group_dot.cxx",
    ],
    c_file_output = "kernels.c",
    flatten = True,
    h_file_output = "kernels.h",
    identifier = "loomc_cxx_benchmark_kernels",
    target_compatible_with = _COMPATIBLE_WITH,
)

loom_cc_benchmark(
    name = "source_to_hsaco_benchmark",
    srcs = ["source_to_hsaco_benchmark.cc"],
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [
        ":kernels",
        "//loom/binding/c:loomc",
        "//loom/binding/c/benchmark:compile_throughput_benchmark_harness",
        "//loom/binding/c/import/cxx",
        "//loom/binding/c/target/amdgpu",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

loom_cc_benchmark(
    name = "source_to_module_benchmark",
    srcs = ["source_to_module_benchmark.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/import/cxx:embed_includes_enabled",
    ]),
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/benchmark:compile_throughput_benchmark_harness",
        "//loom/binding/c/import/cxx",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
