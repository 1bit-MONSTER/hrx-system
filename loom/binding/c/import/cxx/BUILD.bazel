load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "cxx",
    srcs = ["cxx.c"],
    hdrs = ["//loom/binding/c:include/loomc/import/cxx.h"],
    linkstatic = True,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/import/cxx",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
    alwayslink = True,
)

loom_cc_test(
    name = "cxx_test",
    srcs = ["cxx_test.cc"],
    deps = [
        ":cxx",
        "//loom/binding/c:loomc",
        "//loom/binding/c/test:test_util",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
