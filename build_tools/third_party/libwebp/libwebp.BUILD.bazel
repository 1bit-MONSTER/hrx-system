load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

# Match upstream's webpdecoder source ownership in src/{dec,dsp,utils}/Makefile.am.
# The dispatch code is compiled at the platform baseline. ISA-specific objects
# carry only their own required features; WEBP_HAVE_* advertises compiled
# implementations to upstream's CPU detection without changing the baseline.
write_file(
    name = "config",
    out = "src/webp/config.h",
    content = ["#define WEBP_USE_THREAD 1"] + select({
        "@platforms//cpu:x86_64": [
            "#define WEBP_HAVE_SSE2 1",
            "#define WEBP_HAVE_SSE41 1",
            "#define WEBP_HAVE_AVX2 1",
        ],
        "@platforms//cpu:aarch64": ["#define WEBP_HAVE_NEON 1"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "headers",
    hdrs = glob(["src/**/*.h"]) + [":config"],
    includes = ["src"],
    textual_hdrs = ["src/dsp/cpu.c"],
)

config_setting(
    name = "windows_clang_cl",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@hrx//build_tools/windows:compiler": "clang-cl"},
)

cc_library(
    name = "sse2",
    srcs = ["src/dsp/" + name + "_sse2.c" for name in [
        "alpha_processing", "dec", "filters", "lossless", "rescaler",
        "upsampling", "yuv",
    ]],
    local_defines = ["HAVE_CONFIG_H"] + select({
        "@platforms//os:windows": ["WEBP_MSC_SSE2"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [":headers"],
)

cc_library(
    name = "sse41",
    srcs = ["src/dsp/" + name + "_sse41.c" for name in [
        "alpha_processing", "dec", "lossless", "upsampling", "yuv",
    ]],
    copts = select({
        ":windows_clang_cl": ["/clang:-msse4.1"],
        "@platforms//os:windows": [],
        "//conditions:default": ["-msse4.1"],
    }),
    local_defines = ["HAVE_CONFIG_H"] + select({
        "@platforms//os:windows": ["WEBP_MSC_SSE41"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [":headers"],
)

cc_library(
    name = "avx2",
    srcs = ["src/dsp/lossless_avx2.c"],
    copts = select({
        "@platforms//os:windows": ["/arch:AVX2"],
        "//conditions:default": ["-mavx2"],
    }),
    local_defines = ["HAVE_CONFIG_H"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [":headers"],
)

cc_library(
    name = "neon",
    srcs = ["src/dsp/" + name + "_neon.c" for name in [
        "alpha_processing", "dec", "filters", "lossless", "rescaler",
        "upsampling", "yuv",
    ]],
    local_defines = ["HAVE_CONFIG_H"],
    target_compatible_with = ["@platforms//cpu:aarch64"],
    deps = [":headers"],
)

cc_library(
    name = "webpdecoder",
    hdrs = ["src/webp/decode.h", "src/webp/types.h"],
    srcs = glob(["src/dec/*.c"]) + [
        "src/dsp/alpha_processing.c",
        "src/dsp/cpu.c",
        "src/dsp/dec.c",
        "src/dsp/dec_clip_tables.c",
        "src/dsp/filters.c",
        "src/dsp/lossless.c",
        "src/dsp/rescaler.c",
        "src/dsp/upsampling.c",
        "src/dsp/yuv.c",
        "src/utils/bit_reader_utils.c",
        "src/utils/color_cache_utils.c",
        "src/utils/filters_utils.c",
        "src/utils/huffman_utils.c",
        "src/utils/palette.c",
        "src/utils/quant_levels_dec_utils.c",
        "src/utils/rescaler_utils.c",
        "src/utils/random_utils.c",
        "src/utils/thread_utils.c",
        "src/utils/utils.c",
    ],
    local_defines = ["HAVE_CONFIG_H"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":headers"] + select({
        "@platforms//cpu:x86_64": [":sse2", ":sse41", ":avx2"],
        "@platforms//cpu:aarch64": [":neon"],
        "//conditions:default": [],
    }),
)
