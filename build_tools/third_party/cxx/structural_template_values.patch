+auto compare_constant_values(const ConstValue& lhs, const ConstValue& rhs)
+    -> bool {
+  return std::visit(
+      [&rhs](const auto& left) -> bool {
+        using T = std::decay_t<decltype(left)>;
+        auto right = std::get_if<T>(&rhs);
+        if (!right) return false;
+        if constexpr (std::is_same_v<T, std::shared_ptr<ConstObject>> ||
+                      std::is_same_v<T, std::shared_ptr<InitializerList>> ||
+                      std::is_same_v<T, std::shared_ptr<ConstAddress>> ||
+                      std::is_same_v<T, std::shared_ptr<ConstComplex>>) {
+          if (left == *right) return true;
+          if (!left || !*right) return false;
+          if constexpr (std::is_same_v<T, std::shared_ptr<ConstObject>>) {
+            return *left == **right;
+          } else if constexpr (std::is_same_v<
+                                   T, std::shared_ptr<InitializerList>>) {
+            if (left->elements.size() != (*right)->elements.size())
+              return false;
+            for (std::size_t i = 0; i < left->elements.size(); ++i) {
+              const auto& [leftValue, leftType] = left->elements[i];
+              const auto& [rightValue, rightType] = (*right)->elements[i];
+              if (leftType != rightType ||
+                  !compare_constant_values(leftValue, rightValue))
+                return false;
+            }
+            return true;
+          } else if constexpr (std::is_same_v<T,
+                                              std::shared_ptr<ConstComplex>>) {
+            return compare_constant_values(left->real(), (*right)->real()) &&
+                   compare_constant_values(left->imag(), (*right)->imag());
+          } else {
+            return left->sameTarget(**right) &&
+                   left->offset() == (*right)->offset();
+          }
+        } else if constexpr (std::is_floating_point_v<T>) {
+          // Total ordering distinguishes signed zeros and NaN payloads without
+          // comparing padding in host long double representations.
+          return std::strong_order(left, *right) == 0;
+        } else {
+          return left == *right;
+        }
+      },
+      lhs);
+}

