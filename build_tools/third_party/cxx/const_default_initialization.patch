+auto TypeTraits::is_const_default_constructible(const Type* type) -> bool {
+  auto classType = unqualified_cast<ClassType>(remove_all_extents(type));
+  if (!classType) return false;
+  auto cls = classType->definition();
+  requireCompleteClass(cls);
+  if (!cls || !cls->isComplete()) return false;
+  cls = cls->resolvedDefinition();
+  auto constructor = cls->defaultConstructor();
+  if (!constructor || constructor->isDeleted()) return false;
+  if (isUserProvided(constructor)) return true;
+
+  for (auto base : cls->baseClasses()) {
+    auto baseClass = symbol_cast<ClassSymbol>(base->symbol());
+    if (!baseClass || !is_const_default_constructible(baseClass->type()))
+      return false;
+  }
+
+  bool hasFields = false;
+  for (auto field : cls->members() | views::non_static_fields) {
+    if (field->isBitField() && !field->name()) continue;
+    hasFields = true;
+    if (field->initializer()) {
+      if (cls->isUnion()) return true;
+      continue;
+    }
+    if (!cls->isUnion() && !is_const_default_constructible(field->type()))
+      return false;
+  }
+  return !cls->isUnion() || !hasFields;
+}
