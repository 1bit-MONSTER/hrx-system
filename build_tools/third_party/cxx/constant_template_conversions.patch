diff --git a/tests/unit_tests/sema/constant_template_conversions_01.cc b/tests/unit_tests/sema/constant_template_conversions_01.cc
new file mode 100644
--- /dev/null
+++ b/tests/unit_tests/sema/constant_template_conversions_01.cc
@@ -0,0 +1,86 @@
+// RUN: %cxx -verify -fsyntax-only %s
+
+template <class T>
+struct Scalar {
+  T value;
+  constexpr operator T() const { return value; }
+};
+constexpr Scalar<unsigned> count{5};
+template <unsigned N>
+constexpr unsigned choose() {
+  return N;
+}
+static_assert(choose<count>() == 5);
+template <unsigned N = count>
+constexpr unsigned defaulted() {
+  return N;
+}
+static_assert(defaulted<>() == 5);
+template <unsigned... N>
+constexpr unsigned sum() {
+  return (N + ...);
+}
+static_assert(sum<count, 7>() == 12);
+template <class T, T N>
+constexpr T dependent() {
+  return N;
+}
+static_assert(dependent<unsigned, count>() == 5);
+constexpr Scalar<int> bias{-3};
+static_assert(dependent<int, bias>() == -3);
+template <auto N>
+constexpr auto deduced() {
+  return N;
+}
+static_assert(deduced<5u>() == 5u);
+static_assert(__is_same(decltype(deduced<5u>()), unsigned));
+static_assert(dependent<bool, 1>());
+static_assert(!dependent<bool, 0>());
+
+struct Runtime {
+  operator unsigned() const { return 5; }
+};
+template <class T>
+concept Accepted = requires { choose<T{}>(); };
+static_assert(!Accepted<Runtime>);
+
+template <auto N>
+concept FitsByte = requires { dependent<unsigned char, N>(); };
+static_assert(FitsByte<255>);
+static_assert(!FitsByte<256>);
+static_assert(!FitsByte<-1>);
+template <auto N>
+concept FitsBool = requires { dependent<bool, N>(); };
+static_assert(FitsBool<0>);
+static_assert(FitsBool<1>);
+static_assert(!FitsBool<2>);
+static_assert(!FitsBool<1.0f>);
+static_assert(dependent<signed char, -128>() == -128);
+static_assert(dependent<long long, 0x7fffffffffffffffULL>() ==
+              0x7fffffffffffffffLL);
+
+struct Wide {
+  constexpr operator unsigned() const { return 256; }
+};
+template <class T>
+concept FitsConvertedByte = requires { dependent<unsigned char, T{}>(); };
+static_assert(!FitsConvertedByte<Wide>);
+struct Explicit {
+  explicit constexpr operator unsigned() const { return 5; }
+};
+static_assert(!Accepted<Explicit>);
+struct Deleted {
+  constexpr operator unsigned() const = delete;
+};
+static_assert(!Accepted<Deleted>);
+
+struct Floating {
+  constexpr operator float() const { return 1.5f; }
+};
+constexpr Floating floating{};
+static_assert(dependent<float, floating>() == 1.5f);
+static_assert(dependent<float, 1.5>() == 1.5f);
+template <auto N>
+concept FitsFloat = requires { dependent<float, N>(); };
+static_assert(!FitsFloat<0.1>);
+static_assert(!FitsFloat<1>);
