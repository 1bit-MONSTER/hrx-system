diff --git a/tests/unit_tests/sema/aggregate_initialization_failures_01.cc b/tests/unit_tests/sema/aggregate_initialization_failures_01.cc
new file mode 100644
--- /dev/null
+++ b/tests/unit_tests/sema/aggregate_initialization_failures_01.cc
@@ -0,0 +1,35 @@
+// RUN: %cxx -verify -fsyntax-only %s
+
+namespace temporary_receiver {
+struct Descriptor {
+  unsigned divisor;
+  // expected-warning@+1 {{invalid binary expression}}
+  unsigned quotient = 32 / divisor;
+  constexpr unsigned read(unsigned value) const {
+    return Descriptor{value}.quotient;
+  }
+};
+constexpr Descriptor outer{8};
+static_assert(outer.read(16) == 2);
+// expected-error@+1 {{static assertion expression is not an integral constant expression}}
+static_assert(outer.read(0) == 4);
+}  // namespace temporary_receiver
+
+namespace nonconstant_default {
+unsigned runtime_value();
+struct Descriptor {
+  unsigned value = runtime_value();
+};
+// expected-error@+1 {{constexpr variable must be initialized}}
+constexpr Descriptor invalid = Descriptor();
+}  // namespace nonconstant_default
+
+namespace zero_divisor {
+struct Descriptor {
+  unsigned divisor;
+  // expected-warning@+1 {{invalid binary expression}}
+  unsigned quotient = 32 / divisor;
+};
+// expected-error@+1 {{constexpr variable must be initialized}}
+constexpr Descriptor invalid = Descriptor();
+}  // namespace zero_divisor
