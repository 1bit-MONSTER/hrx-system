+auto compare_constant_values(const ConstValue& lhs, const ConstValue& rhs)
+    -> bool {
+  auto leftAddress = std::get_if<std::shared_ptr<ConstAddress>>(&lhs);
+  if (!leftAddress) {
+    return lhs == rhs;
+  }
+  auto rightAddress = std::get_if<std::shared_ptr<ConstAddress>>(&rhs);
+  if (!rightAddress) {
+    return false;
+  }
+  if (!*leftAddress || !*rightAddress) {
+    return *leftAddress == *rightAddress;
+  }
+  return (*leftAddress)->sameTarget(**rightAddress) &&
+         (*leftAddress)->offset() == (*rightAddress)->offset();
+}
