# Wasm toolchain and JavaScript bundling rules have no CMake surface.
# bazel-to-cmake: skip

load("@rules_python//python:defs.bzl", "py_binary", "py_test")

exports_files(
    [
        "wasi_sdk_repo.bzl",
        "wasi_sdk_version.bzl",
        "wasi_toolchain.bzl",
        "wasm_node_test_runner.sh",
        "wasm_test_main.mjs",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "wasm32_wasi",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "wasm_binary_bundler",
    srcs = ["wasm_binary_bundler.py"],
    main = "wasm_binary_bundler.py",
    visibility = ["//visibility:public"],
)

py_test(
    name = "wasm_binary_bundler_test",
    srcs = [
        "wasm_binary_bundler.py",
        "wasm_binary_bundler_test.py",
    ],
    imports = ["."],
    main = "wasm_binary_bundler_test.py",
)
