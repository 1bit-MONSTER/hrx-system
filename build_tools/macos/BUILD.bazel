# Bazel toolchain configuration has no CMake target surface.
# bazel-to-cmake: skip

load("//build_tools/bazel:python.bzl", "iree_py_test")
load(":toolchain.bzl", "macos_toolchains")

package(default_visibility = ["//visibility:public"])

macos_toolchains()

exports_files([
    "sdk_metadata.py",
    "toolchain.bzl",
])

iree_py_test(
    name = "sdk_metadata_test",
    size = "small",
    srcs = [
        "sdk_metadata.py",
        "sdk_metadata_test.py",
    ],
    main = "sdk_metadata_test.py",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
