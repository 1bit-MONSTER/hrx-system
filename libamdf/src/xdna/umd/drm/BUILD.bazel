load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

DRM_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

amdf_cc_library(
    name = "buffer",
    srcs = ["buffer.c"],
    hdrs = ["buffer.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        "//libamdf/src/platform/linux:file",
        "//third_party:linux_drm_uapi",
        "//third_party:linux_xdna_uapi",
    ],
)

amdf_cc_test(
    name = "buffer_test",
    srcs = ["buffer_test.cc"],
    linkopts = ["-Wl,--wrap=ioctl"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        "//third_party:google_test",
        "//third_party:google_test_main",
        "//third_party:linux_drm_uapi",
        "//third_party:linux_xdna_uapi",
    ],
)

amdf_cc_library(
