template.decl @completed_tick() -> (i32)

amdgpu.target<gfx1150> @clock_gfx1150
amdgpu.target<gfx1151> @clock_gfx1151
amdgpu.target<gfx1152> @clock_gfx1152
amdgpu.target<gfx1153> @clock_gfx1153

low.func.def target<amdgpu.rdna3_5.core> @clock_rdna3_5() -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

template.def<@completed_tick> target(@clock_gfx1150) @tick_gfx1150() -> (i32) {
  %tick = low.invoke @clock_rdna3_5() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1151) @tick_gfx1151() -> (i32) {
  %tick = low.invoke @clock_rdna3_5() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1152) @tick_gfx1152() -> (i32) {
  %tick = low.invoke @clock_rdna3_5() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1153) @tick_gfx1153() -> (i32) {
  %tick = low.invoke @clock_rdna3_5() : () -> (i32)
  template.return %tick : i32
}
