template.decl @completed_tick() -> (i32)

amdgpu.target<gfx1100> @clock_gfx1100
amdgpu.target<gfx1101> @clock_gfx1101
amdgpu.target<gfx1102> @clock_gfx1102
amdgpu.target<gfx1103> @clock_gfx1103

low.func.def target<amdgpu.rdna3.core> @clock_rdna3() -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

template.def<@completed_tick> target(@clock_gfx1100) @tick_gfx1100() -> (i32) {
  %tick = low.invoke @clock_rdna3() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1101) @tick_gfx1101() -> (i32) {
  %tick = low.invoke @clock_rdna3() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1102) @tick_gfx1102() -> (i32) {
  %tick = low.invoke @clock_rdna3() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1103) @tick_gfx1103() -> (i32) {
  %tick = low.invoke @clock_rdna3() : () -> (i32)
  template.return %tick : i32
}
