template.decl @completed_tick() -> (i32)

amdgpu.target<gfx1200> @clock_gfx1200
amdgpu.target<gfx1201> @clock_gfx1201

low.func.def target<amdgpu.rdna4.core> @clock_rdna4() -> (reg<amdgpu.sgpr>) asm {
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_wait_kmcnt {kmcnt = 0}
  return %tick
}

template.def<@completed_tick> target(@clock_gfx1200) @tick_gfx1200() -> (i32) {
  %tick = low.invoke @clock_rdna4() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1201) @tick_gfx1201() -> (i32) {
  %tick = low.invoke @clock_rdna4() : () -> (i32)
  template.return %tick : i32
}
