// One invocation owns both GPU request/response channels. Channel H completes
// generation 1, the other channel completes generations 1 through K, then H
// completes generation 2. Every request after the first uses the preceding
// actual response[0] as its cause. Arithmetic is modulo 2^32.
//
// The caller owns disjoint, 64-byte-aligned request and response allocations,
// each containing two channel records; separate startup; control (512 bytes);
// and result records. Channel generations occupy word 0; W payload words begin
// at word P. W is in [1, 1024], P is in [1, 16], and the channel byte stride is
// round_up(4 * (P + W), 64). H is 0 or 1. K is in [1, UINT32_MAX - 2], so the
// K + 2 chronological record count does not wrap. The caller provides that
// complete transcript extent and retains every owner through native retirement.
//
// Startup DWORD 0 is host WAIT 0, RUN 1, or ABORT 2. The host publishes one
// immutable decision after submission acceptance. Its separate allocation
// isolates host cache maintenance from every device-owned payload/control range.
// All generation, startup and terminal cells initially contain zero.
//
// The GPU writes requests; each NPU worker writes its response channel. Each
// worker has one application credit. H's generation 2 remains unpublished until
// the other channel's final response has been consumed. Final ACKs at control
// bytes 192 and 448 release COMPLETE 1 only after all GPU response reads and
// transcript stores. Prestart ABORT writes ABORTED 2 to both ACKs without any
// request, response or transcript access. All other control bytes are guards.
//
// Each record occupies 4 * (W + 5) bytes: channel, local generation, cause,
// start tick, end tick, then every response word. NPU response[i] equals
// 3 * request[i] + local_generation modulo 2^32. Raw 32-bit clock subtraction
// does not represent an unbounded duration.

template.decl @completed_tick() -> (i32)

kernel.def export("resident_channels") @resident_channels() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%request: buffer, %response: buffer, %startup: buffer, %control: buffer, %records: buffer, %peer_round_count: i32, %seed: i32, %payload_word_count: i32, %payload_word_offset: i32, %held_channel: i32, %channel_byte_stride: i32) {
  %request_aligned = buffer.assume.alignment %request {minimum_alignment = 64} : buffer
  %response_aligned = buffer.assume.alignment %response {minimum_alignment = 64} : buffer
  %startup_aligned = buffer.assume.alignment %startup {minimum_alignment = 64} : buffer
  %control_aligned = buffer.assume.alignment %control {minimum_alignment = 64} : buffer
  %records_aligned = buffer.assume.alignment %records {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %word_bytes = index.constant 4 : offset
  %peer_count_input = index.cast %peer_round_count : i32 to offset
  %peer_count = index.assume %peer_count_input [range(%peer_count_input, 1, 4294967293)] : offset
  %peer_count_word = index.cast %peer_count : offset to i32
  %element_limit_input = index.cast %payload_word_count : i32 to index
  %element_limit = index.assume %element_limit_input [range(%element_limit_input, 1, 1024)] : index
  %payload_offset_input = index.cast %payload_word_offset : i32 to index
  %payload_offset_words = index.assume %payload_offset_input [range(%payload_offset_input, 1, 16)] : index
  %payload_offset = index.scale %payload_offset_words, %word_bytes : index, offset -> offset
  %held_channel_input = index.cast %held_channel : i32 to index
  %held_channel_index = index.assume %held_channel_input [range(%held_channel_input, 0, 1)] : index
  %held_channel_word = index.cast %held_channel_index : index to i32
  %channel_stride_input = index.cast %channel_byte_stride : i32 to offset
  %channel_stride = index.assume %channel_stride_input [range(%channel_stride_input, 64, 4160), mul(%channel_stride_input, 64)] : offset
  %startup_word = buffer.view %startup_aligned[%origin] : buffer -> view<1xi32>
  %control_words = buffer.view %control_aligned[%origin] : buffer -> view<128xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %generation_scale = scalar.constant 257 : i32
  %element_scale = scalar.constant 17 : i32
  %peer_channel = scalar.xori %held_channel_word, %c1 : i32
  %last_row = scalar.addi %peer_count_word, %c1 : i32
  %row_count = scalar.addi %last_row, %c1 : i32
  %first_element = index.constant 0 : index
  %second_element = index.constant 1 : index
  %element_step = index.constant 1 : index
  %record_header_words = index.constant 5 : index
  %record_word_count = index.add %element_limit, %record_header_words : index
  %record_byte_stride = index.scale %record_word_count, %word_bytes : index, offset -> offset

  %start = scf.while(%state = %c0 : i32) -> (i32) {
    %waiting_state = scalar.cmpi eq, %state, %c0 : i32
    scf.condition %waiting_state, %state : i1, i32
  } do(%state: i32) {
    %observed = view.atomic.load %startup_word[0] {ordering = relaxed, scope = system} : view<1xi32> -> i32
    scf.yield %observed : i32
  }
  buffer.fence scope(system) ordering(acquire)
  %running_state = scalar.cmpi eq, %start, %c1 : i32

  %completed_rows, %final_cause = scf.while(%row = %c0 : i32, %cause = %seed : i32) -> (i32, i32) {
    %remaining = scalar.cmpi ult, %row, %row_count : i32
    %continue_rows = scalar.andi %remaining, %running_state : i1
    scf.condition %continue_rows, %row, %cause : i1, i32, i32
  } do(%row: i32, %cause: i32) {
    %is_first_row = scalar.cmpi eq, %row, %c0 : i32
    %is_last_row = scalar.cmpi eq, %row, %last_row : i32
    %uses_held_channel = scalar.ori %is_first_row, %is_last_row : i1
    %channel = scf.select %uses_held_channel, %held_channel_word, %peer_channel : i32
    %first_channel = scalar.cmpi eq, %channel, %c0 : i32
    %channel_offset = scf.select %first_channel, %origin, %channel_stride : offset
    %channel_payload_offset = index.add %channel_offset, %payload_offset : offset
    %ordinary_generation = scf.select %is_first_row, %c1, %row : i32
    %generation = scf.select %is_last_row, %c2, %ordinary_generation : i32
    %request_ready = buffer.view %request_aligned[%channel_offset] : buffer -> view<1xi32>
    %response_ready = buffer.view %response_aligned[%channel_offset] : buffer -> view<1xi32>
    %request_words = buffer.view %request_aligned[%channel_payload_offset] : buffer -> view<[%element_limit]xi32>
    %response_words = buffer.view %response_aligned[%channel_payload_offset] : buffer -> view<[%element_limit]xi32>

    %generation_term = scalar.muli %generation, %generation_scale : i32
    %request_base = scalar.addi %cause, %generation_term : i32
    scf.for %element = [%first_element to %element_limit step %element_step] {
      %element_word = index.cast %element : index to i32
      %element_term = scalar.muli %element_word, %element_scale : i32
      %value = scalar.addi %request_base, %element_term : i32
      view.store %value, %request_words[%element] : i32, view<[%element_limit]xi32>
    }
    %start_tick = template.apply<@completed_tick>() : () -> (i32)
    view.atomic.store %generation, %request_ready[0] {ordering = release, scope = system} : i32, view<1xi32>
    %response_generation = scf.while(%seen = %c0 : i32) -> (i32) {
      %pending = scalar.cmpi ne, %seen, %generation : i32
      scf.condition %pending, %seen : i1, i32
    } do(%seen: i32) {
      %observed_generation = view.atomic.load %response_ready[0] {ordering = relaxed, scope = system} : view<1xi32> -> i32
      scf.yield %observed_generation : i32
    }
    buffer.fence scope(system) ordering(acquire)
    %unsigned_row = index.cast %row : i32 to offset
    %row_index = index.cast %unsigned_row : offset to index
    %record_offset = index.scale %row_index, %record_byte_stride : index, offset -> offset
    %record = buffer.view %records_aligned[%record_offset] : buffer -> view<[%record_word_count]xi32>
    %causal_result = view.load %response_words[0] : view<[%element_limit]xi32> -> i32
    view.store %causal_result, %record[5] : i32, view<[%record_word_count]xi32>
    scf.for %element = [%second_element to %element_limit step %element_step] {
      %value = view.load %response_words[%element] : view<[%element_limit]xi32> -> i32
      %record_element = index.add %element, %record_header_words : index
      view.store %value, %record[%record_element] : i32, view<[%record_word_count]xi32>
    }
    view.store %channel, %record[0] : i32, view<[%record_word_count]xi32>
    view.store %generation, %record[1] : i32, view<[%record_word_count]xi32>
    view.store %cause, %record[2] : i32, view<[%record_word_count]xi32>
    view.store %start_tick, %record[3] : i32, view<[%record_word_count]xi32>
    %end_tick = template.apply<@completed_tick>() : () -> (i32)
    view.store %end_tick, %record[4] : i32, view<[%record_word_count]xi32>
    %next_row = scalar.addi %row, %c1 : i32
    scf.yield %next_row, %causal_result : i32, i32
  }
  %terminal = scf.select %running_state, %c1, %c2 : i32
  view.atomic.store %terminal, %control_words[48] {ordering = release, scope = system} : i32, view<128xi32>
  view.atomic.store %terminal, %control_words[112] {ordering = release, scope = system} : i32, view<128xi32>
  kernel.return
}
