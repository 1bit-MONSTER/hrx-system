// Grid-strided packed 16-byte copies followed by an exact byte tail. Source
// and target spans are disjoint; their addresses need only byte alignment.
// The device geometry arguments describe the actual complete dispatch grid.
kernel.def export("byte_copy_unaligned") @byte_copy_unaligned(%groups_x: index, %groups_y: index) {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%source: buffer, %target: buffer, %byte_length: i64, %grid_size_x: i32, %grid_size_y: i32, %workgroup_size_x: i32) {
  %input, %output = buffer.assume.noalias %source, %target : buffer, buffer
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %four = scalar.constant 4 : i64
  %fifteen = scalar.constant 15 : i64
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %vector_bytes = index.constant 16 : offset
  %full_element_count = scalar.shrui %byte_length, %four : i64
  %element_count = index.cast %full_element_count : i64 to index
  %tail_offset = index.scale %element_count, %vector_bytes : index, offset -> offset
  %tail_byte_count = scalar.andi %byte_length, %fifteen : i64
  %tail_length = index.cast %tail_byte_count : i64 to index
  %source_tail = buffer.view %input[%tail_offset] : buffer -> view<[%tail_length]xi8>
  %target_tail = buffer.view %output[%tail_offset] : buffer -> view<[%tail_length]xi8>

  %group_x = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %lane_x = kernel.workitem.id<x> : index
  %group_x_wide = index.cast %group_x : index to i64
  %group_y_wide = index.cast %group_y : index to i64
  %lane_x_wide = index.cast %lane_x : index to i64
  %grid_x = scalar.extui %grid_size_x : i32 to i64
  %grid_y = scalar.extui %grid_size_y : i32 to i64
  %width = scalar.extui %workgroup_size_x : i32 to i64
  %group_begin = scalar.muli %group_x_wide, %width : i64
  %id_x = scalar.addi %group_begin, %lane_x_wide : i64
  %row_begin = scalar.muli %group_y_wide, %grid_x : i64
  %first_block = scalar.addi %row_begin, %id_x : i64
  %block_stride = scalar.muli %grid_x, %grid_y : i64

  %tail_only = scalar.cmpi eq, %full_element_count, %zero : i64
  scf.if %tail_only {
    %first_lane = scalar.cmpi eq, %first_block, %zero : i64
    scf.if %first_lane {
      scf.for %byte = [%begin to %tail_length step %step] {
        %value = view.load %source_tail[%byte] : view<[%tail_length]xi8> -> i8
        view.store %value, %target_tail[%byte] : i8, view<[%tail_length]xi8>
      }
    }
  } else {
    %finished_block = scf.while(%next_block = %first_block : i64) -> (i64) {
      %in_bounds = scalar.cmpi ult, %next_block, %full_element_count : i64
      scf.condition %in_bounds, %next_block : i1, i64
    } do(%block: i64) {
      %element = index.cast %block : i64 to index
      %element_offset = index.scale %element, %vector_bytes : index, offset -> offset
      // Each packed object occupies exactly the guarded 16-byte element.
      %source_element = buffer.view %input[%element_offset] : buffer -> view<2xi64, align(1)>
      %target_element = buffer.view %output[%element_offset] : buffer -> view<2xi64, align(1)>
      %value = vector.load %source_element[%begin] : view<2xi64, align(1)> -> vector<2xi64>
      vector.store %value, %target_element[%begin] : vector<2xi64>, view<2xi64, align(1)>
      %following_block = scalar.addi %block, %one : i64
      %last_block = scalar.cmpi eq, %following_block, %full_element_count : i64
      scf.if %last_block {
        scf.for %byte = [%begin to %tail_length step %step] {
          %tail_value = view.load %source_tail[%byte] : view<[%tail_length]xi8> -> i8
          view.store %tail_value, %target_tail[%byte] : i8, view<[%tail_length]xi8>
        }
      }
      // A wrapped grid stride terminates instead of revisiting earlier data.
      %advanced = scalar.addi %block, %block_stride : i64
      %wrapped = scalar.cmpi ult, %advanced, %block : i64
      %next = scf.select %wrapped, %full_element_count, %advanced : i64
      scf.yield %next : i64
    }
  }
  kernel.return
}
