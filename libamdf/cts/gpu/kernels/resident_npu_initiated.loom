// The NPU authors Q1; the GPU consumes every Q word and returns
// Rg[i] = 3 * Qg[i] + g for generations 1 through N, modulo 2^32. The NPU
// produces Q(g+1) from each actual Rg word. The GPU records closing Q(N+1)
// without producing another R, exposing every final NPU consumption.
//
// The caller owns disjoint, 64-byte-aligned request (R), response (Q), startup,
// control (256 bytes), and transcript allocations. Each payload slot has a
// generation at word 0 and W words at word P. W is in [1, 1024]; P is 1 or 16.
// The complete slot extent is round_up(4 * (P + W), 64). N is in
// [0, UINT32_MAX - 1], so a positive N has N + 1 nonzero Q generations.
// All owners remain live through both participants' native retirement.
//
// Startup word 0 is host WAIT 0, RUN 1, or ABORT 2. Its separate allocation
// isolates the one host publication from device-owned payload/control ranges.
// Generation, startup, and terminal cells initially contain zero. Control word
// 48 is the GPU final ACK; all other control bytes are guards. RUN completes
// with ACK 1 after every Q read and transcript store. Prestart ABORT writes ACK
// 2 without any payload or transcript access. N = 0 also accesses no payload
// or transcript and takes no clock samples.
//
// Each transcript row occupies 4 * (W + 4) bytes: Q generation, R generation
// (zero for the closing row), start tick, end tick, then every Q word. The end
// sample drains Q reads, transcript stores, and ordinary-row R stores. That
// sample is the next row's start, preceding R's ready release. The end tick's
// own transcript store is drained by that release or the final ACK. Positive N
// has one cold row, N - 1 steady rows, and one closing row without R production.
// Ticks are raw 32-bit values; modular subtraction is not an unbounded duration.

template.decl @completed_tick() -> (i32)

kernel.def export("resident_npu_initiated") @resident_npu_initiated() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%request: buffer, %response: buffer, %startup: buffer, %control: buffer, %records: buffer, %round_count: i32, %payload_word_count: i32, %payload_word_offset: i32) {
  %request_aligned = buffer.assume.alignment %request {minimum_alignment = 64} : buffer
  %response_aligned = buffer.assume.alignment %response {minimum_alignment = 64} : buffer
  %startup_aligned = buffer.assume.alignment %startup {minimum_alignment = 64} : buffer
  %control_aligned = buffer.assume.alignment %control {minimum_alignment = 64} : buffer
  %records_aligned = buffer.assume.alignment %records {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %word_bytes = index.constant 4 : offset
  %return_count_input = index.cast %round_count : i32 to offset
  %return_count = index.assume %return_count_input [range(%return_count_input, 0, 4294967294)] : offset
  %return_count_word = index.cast %return_count : offset to i32
  %element_count_input = index.cast %payload_word_count : i32 to offset
  %element_count = index.assume %element_count_input [range(%element_count_input, 1, 1024)] : offset
  %element_limit = index.cast %element_count : offset to index
  %payload_offset_input = index.cast %payload_word_offset : i32 to offset
  %payload_offset_count = index.assume %payload_offset_input [range(%payload_offset_input, 1, 16)] : offset
  %payload_offset_words = index.cast %payload_offset_count : offset to index
  %payload_offset = index.scale %payload_offset_words, %word_bytes : index, offset -> offset
  %request_ready = buffer.view %request_aligned[%origin] : buffer -> view<1xi32>
  %response_ready = buffer.view %response_aligned[%origin] : buffer -> view<1xi32>
  %request_words = buffer.view %request_aligned[%payload_offset] : buffer -> view<[%element_limit]xi32>
  %response_words = buffer.view %response_aligned[%payload_offset] : buffer -> view<[%element_limit]xi32>
  %startup_word = buffer.view %startup_aligned[%origin] : buffer -> view<1xi32>
  %control_words = buffer.view %control_aligned[%origin] : buffer -> view<64xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %aborted_state = scalar.constant 2 : i32
  %return_scale = scalar.constant 3 : i32
  %first_element = index.constant 0 : index
  %element_step = index.constant 1 : index
  %record_header_words = index.constant 4 : index
  %record_word_count = index.add %element_limit, %record_header_words : index
  %record_byte_stride = index.scale %record_word_count, %word_bytes : index, offset -> offset

  %start = scf.while(%state = %c0 : i32) -> (i32) {
    %waiting_state = scalar.cmpi eq, %state, %c0 : i32
    scf.condition %waiting_state, %state : i1, i32
  } do(%state: i32) {
    %observed = view.atomic.load %startup_word[0] {ordering = relaxed, scope = system} : view<1xi32> -> i32
    scf.yield %observed : i32
  }
  buffer.fence scope(system) ordering(acquire)
  %running_state = scalar.cmpi eq, %start, %c1 : i32
  %has_returns = scalar.cmpi ne, %return_count_word, %c0 : i32
  %has_rows = scalar.andi %running_state, %has_returns : i1
  %positive_row_count = scalar.addi %return_count_word, %c1 : i32
  %row_count = scf.select %has_rows, %positive_row_count, %c0 : i32
  %cold_tick = scf.if %has_rows -> (i32) {
    %tick = template.apply<@completed_tick>() : () -> (i32)
    scf.yield %tick : i32
  } else {
    scf.yield %c0 : i32
  }

  %completed_rows, %final_tick = scf.while(%row = %c0 : i32, %start_tick = %cold_tick : i32) -> (i32, i32) {
    %remaining = scalar.cmpi ult, %row, %row_count : i32
    scf.condition %remaining, %row, %start_tick : i1, i32, i32
  } do(%row: i32, %start_tick: i32) {
    %generation = scalar.addi %row, %c1 : i32
    %produces_return = scalar.cmpi ult, %row, %return_count_word : i32
    %return_generation = scf.select %produces_return, %generation, %c0 : i32
    %response_generation = scf.while(%seen = %c0 : i32) -> (i32) {
      %pending = scalar.cmpi ne, %seen, %generation : i32
      scf.condition %pending, %seen : i1, i32
    } do(%seen: i32) {
      %observed_generation = view.atomic.load %response_ready[0] {ordering = relaxed, scope = system} : view<1xi32> -> i32
      scf.yield %observed_generation : i32
    }
    buffer.fence scope(system) ordering(acquire)
    %unsigned_row = index.cast %row : i32 to offset
    %row_index = index.cast %unsigned_row : offset to index
    %record_offset = index.scale %row_index, %record_byte_stride : index, offset -> offset
    %record = buffer.view %records_aligned[%record_offset] : buffer -> view<[%record_word_count]xi32>
    scf.for %element = [%first_element to %element_limit step %element_step] {
      %value = view.load %response_words[%element] : view<[%element_limit]xi32> -> i32
      %record_element = index.add %element, %record_header_words : index
      view.store %value, %record[%record_element] : i32, view<[%record_word_count]xi32>
      scf.if %produces_return {
        %scaled_value = scalar.muli %value, %return_scale : i32
        %return_value = scalar.addi %scaled_value, %generation : i32
        view.store %return_value, %request_words[%element] : i32, view<[%element_limit]xi32>
      }
    }
    view.store %generation, %record[0] : i32, view<[%record_word_count]xi32>
    view.store %return_generation, %record[1] : i32, view<[%record_word_count]xi32>
    view.store %start_tick, %record[2] : i32, view<[%record_word_count]xi32>
    %end_tick = template.apply<@completed_tick>() : () -> (i32)
    view.store %end_tick, %record[3] : i32, view<[%record_word_count]xi32>
    scf.if %produces_return {
      view.atomic.store %generation, %request_ready[0] {ordering = release, scope = system} : i32, view<1xi32>
    }
    // The last row advances to the exclusive count; its generation is never
    // incremented, including when that generation is UINT32_MAX.
    %next_row = scalar.addi %row, %c1 : i32
    scf.yield %next_row, %end_tick : i32, i32
  }
  %terminal = scf.select %running_state, %c1, %aborted_state : i32
  view.atomic.store %terminal, %control_words[48] {ordering = release, scope = system} : i32, view<64xi32>
  kernel.return
}
