load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts_gpu_kernel.bzl", "amdf_cts_gpu_kernel")
load("//libamdf/requirements:package_policy.bzl", "apply_amdf_target_policy")
load("//loom/build_tools/bazel:defs.bzl", "loom_target_profile")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    licenses = ["notice"],
)

exports_files([
    "README.md",
    "byte_copy_unaligned.c",
    "byte_copy_unaligned_gfx942.json",
    "generate.py",
    "geometry_ids.c",
    "geometry_ids_gfx942.json",
    "lds_exchange.c",
    "lds_exchange_gfx1151.json",
    "lds_exchange_gfx942.json",
    "pattern_fill_unaligned.c",
    "pattern_fill_unaligned_gfx942.json",
    "private_roundtrip.c",
    "private_roundtrip_gfx942.json",
    "transform.loom",
    "transform_alternate.loom",
])

py_binary(
    name = "embed",
    testonly = True,
    srcs = ["embed.py"],
    visibility = ["//libamdf:__subpackages__"],
)

loom_target_profile(
    name = "gfx942",
    family = "amdgpu",
    selector = "gfx942",
    visibility = ["//visibility:private"],
)

loom_target_profile(
    name = "gfx1151",
    family = "amdgpu",
    selector = "gfx1151",
    visibility = ["//visibility:private"],
)

amdf_cc_library(
    name = "image",
    testonly = True,
    hdrs = ["image.h"],
)

amdf_cc_library(
    name = "transform",
    testonly = True,
    hdrs = ["transform.h"],
)

amdf_cc_library(
    name = "byte_copy_unaligned",
    testonly = True,
    hdrs = ["byte_copy_unaligned.h"],
)

amdf_cc_library(
    name = "byte_copy_unaligned_gfx942",
    testonly = True,
    hdrs = ["byte_copy_unaligned_gfx942.h"],
    deps = [":image"],
)

amdf_cc_library(
    name = "pattern_fill_unaligned",
    testonly = True,
    hdrs = ["pattern_fill_unaligned.h"],
)

amdf_cc_library(
    name = "pattern_fill_unaligned_gfx942",
    testonly = True,
    hdrs = ["pattern_fill_unaligned_gfx942.h"],
    deps = [":image"],
)

amdf_cts_gpu_kernel(
    name = "transform_gfx942",
    src = "transform.loom",
    entry_point = "aql_transform",
    namespace = "kernels::gfx942_transform",
    target = ":gfx942",
)

amdf_cts_gpu_kernel(
    name = "transform_alternate_gfx942",
    src = "transform_alternate.loom",
    entry_point = "aql_transform",
    namespace = "kernels::gfx942_transform_alternate",
    target = ":gfx942",
)

amdf_cts_gpu_kernel(
    name = "transform_gfx1151",
    src = "transform.loom",
    entry_point = "aql_transform",
    namespace = "kernels::gfx1151_transform",
    target = ":gfx1151",
)

amdf_cc_library(
    name = "geometry_ids_gfx942",
    testonly = True,
    hdrs = ["geometry_ids_gfx942.h"],
    deps = [":image"],
)

amdf_cc_library(
    name = "lds_exchange",
    testonly = True,
    hdrs = ["lds_exchange.h"],
)

amdf_cc_library(
    name = "lds_exchange_gfx1151",
    testonly = True,
    hdrs = ["lds_exchange_gfx1151.h"],
    deps = [":image"],
)

amdf_cc_library(
    name = "lds_exchange_gfx942",
    testonly = True,
    hdrs = ["lds_exchange_gfx942.h"],
    deps = [":image"],
)

amdf_cc_library(
    name = "private_roundtrip",
    testonly = True,
    hdrs = ["private_roundtrip.h"],
)

amdf_cc_library(
    name = "private_roundtrip_gfx942",
    testonly = True,
    hdrs = ["private_roundtrip_gfx942.h"],
    deps = [":image"],
)

_KERNEL_POLICY = apply_amdf_target_policy({})

py_test(
    name = "embed_test",
    size = "small",
    srcs = [
        "embed.py",
        "embed_test.py",
    ],
    args = [
        "--gfx942=$(rootpath :transform_gfx942_hsaco)",
        "--gfx1151=$(rootpath :transform_gfx1151_hsaco)",
    ],
    data = [
        ":transform_gfx1151_hsaco",
        ":transform_gfx942_hsaco",
    ],
    main = "embed_test.py",
    tags = _KERNEL_POLICY["tags"],
    target_compatible_with = _KERNEL_POLICY["target_compatible_with"],
)
