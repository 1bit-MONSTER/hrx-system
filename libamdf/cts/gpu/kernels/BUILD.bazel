load("//libamdf/requirements:package_policy.bzl", "apply_amdf_target_policy")
load("//loom/build_tools/amdgpu:target_config.bzl", "LOOM_AMDGPU_SUPPORTED_TARGETS")
load("//loom/build_tools/bazel:defs.bzl", "loom_target_profile")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    licenses = ["notice"],
)

exports_files([
    "README.md",
    "byte_copy_unaligned.loom",
    "geometry_ids.loom",
    "lds_exchange.loom",
    "pattern_fill_unaligned.loom",
    "private_roundtrip.loom",
    "resident_channels.loom",
    "resident_exchange.loom",
    "resident_npu_initiated.loom",
    "transform.loom",
    "transform_alternate.loom",
])

py_binary(
    name = "embed",
    testonly = True,
    srcs = ["embed.py"],
    visibility = ["//libamdf:__subpackages__"],
)

# Every exact physical selector, including encoding overlays, shares the same
# authored kernels. Generic code-object processors are not physical endpoints.
_KERNEL_TARGETS = sorted([
    target
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
    if not target.endswith("-generic")
])

[
    loom_target_profile(
        name = target,
        family = "amdgpu",
        selector = target,
        visibility = ["//visibility:private"],
    )
    for target in _KERNEL_TARGETS
]

amdf_cc_library(
    name = "kernel",
    testonly = True,
    srcs = ["kernel.cc"],
    hdrs = ["kernel.h"],
    deps = [":image"],
)

amdf_cc_library(
    name = "image",
    testonly = True,
    hdrs = ["image.h"],
)

