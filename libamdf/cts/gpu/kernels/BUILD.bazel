_KERNEL_POLICY = apply_amdf_target_policy({})

py_test(
    name = "embed_test",
    size = "small",
    srcs = [
        "embed.py",
        "embed_test.py",
    ],
    args = [
        "--variant=%s=$(rootpath :transform_kernels_%s)" % (target, target)
        for target in _KERNEL_TARGETS
    ],
    data = [
        ":transform_kernels_" + target
        for target in _KERNEL_TARGETS
    ],
    main = "embed_test.py",
    tags = _KERNEL_POLICY["tags"],
    target_compatible_with = _KERNEL_POLICY["target_compatible_with"],
)

amdf_cc_library(
