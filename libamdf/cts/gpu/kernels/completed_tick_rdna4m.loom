template.decl @completed_tick() -> (i32)

amdgpu.target<gfx1170> @clock_gfx1170
amdgpu.target<gfx1171> @clock_gfx1171
amdgpu.target<gfx1172> @clock_gfx1172

low.func.def target<amdgpu.rdna4m.core> @clock_rdna4m() -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

template.def<@completed_tick> target(@clock_gfx1170) @tick_gfx1170() -> (i32) {
  %tick = low.invoke @clock_rdna4m() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1171) @tick_gfx1171() -> (i32) {
  %tick = low.invoke @clock_rdna4m() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1172) @tick_gfx1172() -> (i32) {
  %tick = low.invoke @clock_rdna4m() : () -> (i32)
  template.return %tick : i32
}
