load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "memory_commands",
    testonly = True,
    srcs = ["memory_commands.cc"],
    hdrs = ["memory_commands.h"],
)

amdf_cc_library(
    name = "profile",
    testonly = True,
    srcs = ["profile.cc"],
    hdrs = ["profile.h"],
)

amdf_cc_library(
    name = "commands",
    testonly = True,
    srcs = ["commands.cc"],
    hdrs = ["commands.h"],
    deps = [
        ":memory_commands",
        ":profile",
    ],
)

amdf_cc_test(
    name = "commands_test",
    srcs = [
        "commands_test.cc",
        "profile_test.cc",
    ],
    deps = [
        ":commands",
        ":memory_commands",
        ":profile",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
