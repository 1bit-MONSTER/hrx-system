// One immutable 64-byte configuration record drives one complete service.
// Configuration words 0 and 1 are the unsigned generation count and positive
// payload word count. The remaining words are reserved and initialized by the
// caller. Terminal words 0..5 hold state, completed rounds, payload word count,
// and the final response's first word, last word, and sum modulo 2^32. All other
// terminal words remain zero; the three response summaries are zero when no
// round ran. The worker publishes this 64-byte record after custom traffic ends.
//
// Cold native setup assigns shim DMA channel 1 BDs 10..15 to startup, request
// generation, request payload, response payload, response ready, and final ACK.
// Startup is a separate allocation. Request and response generation words are
// at their respective slot bases; payloads begin at a caller-selected word
// offset. Each payload descriptor transfers exactly the configured word count.
// The final ACK remains at byte offset 192 in the shared control allocation.
// BDs 13 -> 14 form a same-channel payload/ready chain: BD 13 releases shim
// lock 0 by one; BD 14 acquires one. Incoming DMA words reach Core0 without
// packet headers. Outgoing packet ID 7 reaches shim TileControl; ID 9 reaches
// S2MM1 with its header dropped.
//
// Queue writes carry the native odd-parity control header for one word:
// MM2S1 queue 0x1d21c -> 0x8001d21c; S2MM1 queue 0x1d20c -> 0x0001d20c.
// ID 7 has header 7; ID 9 has odd-parity header 0x80000009. Every outgoing control
// or data packet marks its final word with TLAST.
//
// The entire protocol stays inside this firing. Returning publishes terminal
// output through the normal worker locks and S2MM0 task. The wrapper then parks
// on its exhausted configuration input; the native command suffix owns custom
// DMA drain and placement quiescence before controller completion.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @resident_service_array() asm {
  %c1 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %c0 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %c2 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %c1
  %worker = worker %group, %c0, @resident_service
  %configuration = binding 0, "read"
  %terminal = binding 1, "write"
  %configuration_sender = sender %configuration, 0 : reg<aie2p.array.sender : tile<16xi32>>
  %worker_configuration = receiver %worker, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %worker_terminal = sender %worker, 1 : reg<aie2p.array.sender : tile<16xi32>>
  %terminal_receiver = receiver %terminal, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %configuration_channel = channel %configuration_sender, %worker_configuration, %c2, %c1 : reg<aie2p.array.channel : tile<16xi32>>
  %terminal_channel = channel %worker_terminal, %terminal_receiver, %c2, %c1 : reg<aie2p.array.channel : tile<16xi32>>
  constrain.location %worker, %c0, %c2
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @resident_service() asm {
  %configuration = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %terminal = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %terminal_copy = copy %terminal : reg<aie2p.ep> -> reg<aie2p.ep>
  %terminal_end = padda %terminal_copy, 64
  %round_count = lda %configuration, 0
  %word_count = lda %configuration, 4
  %c0 = mov.short 0
  %c1 = mov.short 1
  %abort_state = mov.short 2
  %c3 = mov.short 3
  %control_route = mov.short 7
  %data_route = mov.i32 -2147483639
  %input_queue_header = mov.i32 -2147364324
  %output_queue_header = mov.i32 119308
  %startup_descriptor = mov.short 10
  %request_generation_descriptor = mov.short 11
  %request_payload_descriptor = mov.short 12
  %response_chain_descriptor = mov.short 13
  %complete_descriptor = mov.short 15

  // The normal wrapper owns terminal output credit before entering this body.
  // Initialization also defines the terminal payload for ABORT and zero rounds.
  st %c0, %terminal, 0
  st %c0, %terminal, 4
  st %c0, %terminal, 8
  st %c0, %terminal, 12
  st %c0, %terminal, 16
  st %c0, %terminal, 20
  st %c0, %terminal, 24
  st %c0, %terminal, 28
  st %c0, %terminal_end, -32
  st %c0, %terminal_end, -28
  st %c0, %terminal_end, -24
  st %c0, %terminal_end, -20
  st %c0, %terminal_end, -16
  st %c0, %terminal_end, -12
  st %c0, %terminal_end, -8
  st %c0, %terminal_end, -4
  st %word_count, %terminal, 8
  low.br ^poll_startup

^poll_startup:
  mov.ms %control_route
  mov.ms %input_queue_header
  mov.ms.last %startup_descriptor
  %startup = mov.ss
  %run = eq %startup, %c1
  low.cond_br %run, ^begin_run, ^check_abort : reg<aie2p.er>

^check_abort:
  %abort = eq %startup, %abort_state
  low.cond_br %abort, ^aborted, ^poll_startup : reg<aie2p.er>

^aborted:
  // Prestart ABORT never waits on GPU request, response, or final ACK traffic.
  st %abort_state, %terminal, 0
  return

^begin_run:
  %has_rounds = nez %round_count
  low.cond_br %has_rounds, ^first_round, ^poll_complete : reg<aie2p.er>

^first_round:
  low.br ^poll_request(%c1: reg<aie2p.er>)

^poll_request(%generation: reg<aie2p.er>):
  mov.ms %control_route
  mov.ms %input_queue_header
  mov.ms.last %request_generation_descriptor
  %request_generation = mov.ss
  %request_ready = eq %request_generation, %generation
  low.cond_br %request_ready, ^transfer, ^retry_request : reg<aie2p.er>

^retry_request:
  low.br ^poll_request(%generation: reg<aie2p.er>)

^transfer:
  // The fresh generation observation precedes this independent payload DMA.
  mov.ms %control_route
  mov.ms %input_queue_header
  mov.ms.last %request_payload_descriptor
  mov.ms %control_route
  mov.ms %output_queue_header
  mov.ms.last %response_chain_descriptor
  mov.ms %data_route

  // Peel one word so a one-word response has exactly one final stream write.
  %first_request = mov.ss
  %first_scaled = mul %first_request, %c3
  %first_response = add.rr %first_scaled, %generation
  st %first_response, %terminal, 12
  %remaining_words = sub %word_count, %c1
  %has_more_words = nez %remaining_words
  low.cond_br %has_more_words, ^send_first, ^send_single : reg<aie2p.er>

^send_single:
  mov.ms.last %first_response
  low.br ^payload_complete(%first_response: reg<aie2p.er>, %first_response: reg<aie2p.er>)

^send_first:
  mov.ms %first_response
  low.br ^stream_words(%remaining_words: reg<aie2p.er>, %first_response: reg<aie2p.er>)

^stream_words(%remaining: reg<aie2p.er>, %response_sum: reg<aie2p.er>):
  %request_word = mov.ss
  %scaled_word = mul %request_word, %c3
  %response_word = add.rr %scaled_word, %generation
  %next_response_sum = add.rr %response_sum, %response_word
  %next_remaining = sub %remaining, %c1
  %has_next_word = nez %next_remaining
  low.cond_br %has_next_word, ^send_word, ^send_last : reg<aie2p.er>

^send_word:
  mov.ms %response_word
  low.br ^stream_words(%next_remaining: reg<aie2p.er>, %next_response_sum: reg<aie2p.er>)

^send_last:
  mov.ms.last %response_word
  low.br ^payload_complete(%response_word: reg<aie2p.er>, %next_response_sum: reg<aie2p.er>)

^payload_complete(%last_response: reg<aie2p.er>, %final_response_sum: reg<aie2p.er>):
  st %last_response, %terminal, 16
  st %final_response_sum, %terminal, 20

  // A separate complete packet supplies the chained four-byte ready BD.
  mov.ms %data_route
  mov.ms.last %generation
  %more_rounds = ltu %generation, %round_count
  low.cond_br %more_rounds, ^next_round, ^poll_complete : reg<aie2p.er>

^next_round:
  %next_generation = add %generation, 1
  low.br ^poll_request(%next_generation: reg<aie2p.er>)

^poll_complete:
  // COMPLETE=1 is released only after the GPU's final response reads and log.
  mov.ms %control_route
  mov.ms %input_queue_header
  mov.ms.last %complete_descriptor
  %complete = mov.ss
  %acknowledged = eq %complete, %c1
  low.cond_br %acknowledged, ^completed, ^poll_complete : reg<aie2p.er>

^completed:
  st %c1, %terminal, 0
  st %round_count, %terminal, 4
  return
}
