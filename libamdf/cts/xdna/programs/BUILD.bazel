    name = "mul_i32",
    testonly = True,
    srcs = [
        ":mul_i32_npu4",
        ":mul_i32_npu5",
    ],
    c_file_output = "mul_i32.c",
    flatten = True,
    h_file_output = "mul_i32.h",
    identifier = "amdf_cts_xdna_mul_i32",
    tags = _PROGRAM_POLICY["tags"],
