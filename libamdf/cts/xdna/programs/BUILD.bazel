load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//libamdf/requirements:package_policy.bzl", "apply_amdf_target_policy")
load("//loom/build_tools/bazel:defs.bzl", "loom_kernel_binary", "loom_target_profile")

package(
    default_visibility = [
        "//libamdf/cts/interop/gpu/xdna:__subpackages__",
        "//libamdf/cts/xdna:__subpackages__",
    ],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files([
    "README.md",
    "mul_i32.loom",
    "resident_exchange.loom",
    "resident_npu_initiated.loom",
])

_PROGRAM_POLICY = apply_amdf_target_policy({})

loom_target_profile(
    name = "npu4",
    family = "amd.xdna.aie2p",
    selector = "amd.xdna.strix.17f0_10",
    visibility = ["//visibility:private"],
)

loom_target_profile(
    name = "npu5",
    family = "amd.xdna.aie2p",
    selector = "amd.xdna.strix_halo.17f0_11",
    visibility = ["//visibility:private"],
)

loom_kernel_binary(
    name = "mul_i32_npu4",
    testonly = True,
    srcs = ["mul_i32.loom"],
    out = "mul_i32_npu4.xdna",
    roots = ["@mul_i32"],
    tags = _PROGRAM_POLICY["tags"],
    target = ":npu4",
    target_compatible_with = _PROGRAM_POLICY["target_compatible_with"],
)

loom_kernel_binary(
    name = "mul_i32_npu5",
    testonly = True,
    srcs = ["mul_i32.loom"],
